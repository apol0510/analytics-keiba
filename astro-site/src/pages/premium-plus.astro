  <!-- 送信完了画面の共通処理（旧版はこの読み込みが無く、送信成功時に何も表示されなかった） -->
  <script is:inline src="/js/submission-result.js"></script>

  <script is:inline>
    // ── 実績画像・実績数値（Netlify Blobs / premium-plus-media）─────────────
    // 数値はサーバ側 computeStats() の結果をそのまま出す。ページ側で計算しないこと。
    const yen = (n) => '¥' + Number(n || 0).toLocaleString('ja-JP');

    async function loadShowcase() {
      const gallery = document.getElementById('gallery');
      const stats = document.getElementById('stats');
      const note = document.getElementById('statsNote');

      try {
        const response = await fetch('/.netlify/functions/premium-plus-media?limit=5');
        if (!response.ok) throw new Error('failed');
        const data = await response.json();

        const rate = data.stats.rate;
        const payout = data.stats.payout;

        const tiles = [];
        if (rate.available) {
          tiles.push(`<div class="stat"><b>${rate.hitRate}%</b><span>的中率（直近 ${rate.races} 鞍）</span></div>`);
          tiles.push(`<div class="stat"><b>${rate.roi}%</b><span>回収率（直近 ${rate.races} 鞍）</span></div>`);
        }
        if (payout.available) {
          tiles.push(`<div class="stat"><b>${yen(payout.max)}</b><span>最高払戻</span></div>`);
          tiles.push(`<div class="stat"><b>${yen(payout.avg)}</b><span>的中時の平均払戻</span></div>`);
        }

        stats.innerHTML = tiles.join('');
        stats.style.display = tiles.length ? 'grid' : 'none';

        // 的中率が未公開（サンプル不足）のときに、平均払戻だけを見て
        // 「毎回これだけ返ってくる」と誤読されないよう明示する
        note.textContent = rate.available
          ? `※ 的中率・回収率は不的中を含む直近 ${rate.races} 鞍の実データです。`
          : '※ 的中率は不的中を含む記録が 10 鞍たまり次第、このページに自動掲載します。上記は的中した回の払戻実績です。';

        if (!data.entries.length) {
          gallery.innerHTML = '<p class="gallery-empty">実績画像を準備中です。</p>';
          return;
        }

        gallery.innerHTML = data.entries.map((entry) => {
          const race = `${entry.venue || ''}${entry.raceNumber ? entry.raceNumber + 'R' : ''}`;
          const badge = entry.isHit
            ? `<span class="result-badge hit">的中 ${yen(entry.payout)}</span>`
            : '<span class="result-badge miss">不的中</span>';
          return `
            <figure class="shot">
              <img src="${entry.imageUrl}" alt="${entry.date} ${race} の投票控え" loading="lazy">
              <figcaption class="shot-meta">
                <span>
                  <span class="shot-date">${entry.date.slice(5).replace('-', '/')}</span>
                  <span class="shot-race">${race}</span>
                </span>
                ${badge}
              </figcaption>
            </figure>`;
        }).join('');
      } catch (error) {
        console.error('[premium-plus] showcase load failed:', error);
        stats.style.display = 'none';
        gallery.innerHTML = '<p class="gallery-empty">実績画像を読み込めませんでした。時間をおいて再度お試しください。</p>';
      }
    }

    loadShowcase();

    // ── モーダル ───────────────────────────────────────────────
    function openBankModal() {
      prefillContactFields();
      document.getElementById('bankModal').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeBankModal() {
      document.getElementById('bankModal').classList.remove('active');
      document.body.style.overflow = 'auto';
    }

    function openContactModal() {
      prefillContactFields();
      document.getElementById('contactModal').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeContactModal() {
      document.getElementById('contactModal').classList.remove('active');
      document.body.style.overflow = 'auto';
    }

    function copyToClipboard(text, event) {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();

      try {
        const successful = document.execCommand('copy');
        document.body.removeChild(textarea);
        if (successful && event) {
          const button = event.target;
          const original = button.textContent;
          button.textContent = 'コピー完了';
          setTimeout(() => { button.textContent = original; }, 2000);
        }
      } catch (error) {
        document.body.removeChild(textarea);
        alert('コピーに失敗しました。手動でコピーしてください。');
      }
    }

    // 🔑 ログイン済みユーザーの氏名・メールを user-plan から取り出す（入力補助のみ）。
    //    正本ロジック: src/lib/contact-autofill.js（is:inline のため同一ロジックを複製）。
    //    改ざん可能な値なので初期入力にのみ使用し、本人確認済み情報として扱わない。
    function getLoggedInContact() {
      try {
        const raw = localStorage.getItem('user-plan');
        if (typeof raw !== 'string' || !raw) return { name: '', email: '' };
        const data = JSON.parse(raw);
        if (!data || typeof data !== 'object' || Array.isArray(data)) return { name: '', email: '' };
        // 'お客様' は dashboard が既定値として user-plan に書いていた表示用プレースホルダ（実名ではない）。
        // 自動入力すると管理者宛メールが「お名前: お客様」で届き返信できないため空として扱う。
        // 正本: src/lib/contact-autofill.js の normalizeContactName / PLACEHOLDER_NAMES と同一挙動。
        const rawName = typeof data.name === 'string' ? data.name.trim() : '';
        return {
          name: rawName === 'お客様' ? '' : rawName,
          email: typeof data.email === 'string' ? data.email.trim() : '',
        };
      } catch (error) {
        return { name: '', email: '' };
      }
    }

    // 空欄のときだけ初期値を入れる（ユーザーが入力済みの値は上書きしない）。
    function prefillContactFields() {
      const contact = getLoggedInContact();
      [['fullName', 'email'], ['contactName', 'contactEmail']].forEach(([nameId, emailId]) => {
        const nameEl = document.getElementById(nameId);
        const emailEl = document.getElementById(emailId);
        if (nameEl && !nameEl.value && contact.name) nameEl.value = contact.name;
        if (emailEl && !emailEl.value && contact.email) emailEl.value = contact.email;
      });
    }

    document.addEventListener('click', (event) => {
      if (event.target === document.getElementById('bankModal')) closeBankModal();
      if (event.target === document.getElementById('contactModal')) closeContactModal();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { closeBankModal(); closeContactModal(); }
    });

    // ── 銀行振込フォーム ────────────────────────────────────────
    document.getElementById('bankTransferForm').addEventListener('submit', async (event) => {
      event.preventDefault();
        const paymentCompletedCheckbox = document.getElementById('paymentCompletedConfirm');
        if (!paymentCompletedCheckbox || !paymentCompletedCheckbox.checked) {
          const fm = document.getElementById('formMessage');
          if (fm) { fm.textContent = '⚠️ 銀行振込完了後にチェックを入れてから送信してください。'; fm.className = 'form-message error'; fm.style.display = 'block'; }
          return;
        }

      const form = event.currentTarget;
      const submitButton = document.getElementById('submitButton');
      const submitText = submitButton.querySelector('.submit-text');
      const submitLoading = submitButton.querySelector('.submit-loading');
      const formMessage = document.getElementById('formMessage');

      submitButton.disabled = true;
      submitText.style.display = 'none';
      submitLoading.style.display = 'inline';
      formMessage.style.display = 'none';

      const formData = {
        fullName: document.getElementById('fullName').value,
        email: document.getElementById('email').value,
        transferDate: document.getElementById('transferDate').value,
        transferTime: '00:00',
        transferAmount: document.getElementById('transferAmount').value,
        transferName: document.getElementById('fullName').value,
        remarks: document.getElementById('remarks').value,
        productName: 'Premium Plus (¥68,000)',
          paymentCompletedConfirm: document.getElementById('paymentCompletedConfirm').checked,
        timestamp: new Date().toISOString(),
      };

      try {
        const response = await fetch('/.netlify/functions/bank-transfer-application', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || '送信に失敗しました');

        form.reset();
        window.SubmissionResult && window.SubmissionResult.showSuccessScreen({
          formEl: form,
          messageEl: formMessage,
          options: {
            title: 'お申し込みを受け付けました',
            message: `${formData.productName} のお申し込みを受け付けました。`,
            subMessage: '確認メールをお送りしましたのでご確認ください。マイページから申請状況も確認できます。',
          },
          history: {
            type: 'bank-transfer',
            label: `銀行振込お申し込み: ${formData.productName}`,
            status: 'pending',
            details: {
              email: formData.email,
              transferAmount: formData.transferAmount,
              transferDate: formData.transferDate,
              productName: formData.productName,
            },
          },
        });
      } catch (error) {
        console.error('Form submission error:', error);
        formMessage.textContent = '❌ 送信に失敗しました。もう一度お試しいただくか、nankan-analytics@keiba.link までご連絡ください。';
        formMessage.className = 'form-message error';
        formMessage.style.display = 'block';
        submitButton.disabled = false;
        submitText.style.display = 'inline';
        submitLoading.style.display = 'none';
      }
    });

    // ── お問い合わせフォーム ────────────────────────────────────
    document.getElementById('contactForm').addEventListener('submit', async (event) => {
      event.preventDefault();

      const form = event.currentTarget;
      const submitButton = document.getElementById('contactSubmitButton');
      const submitText = submitButton.querySelector('.submit-text');
      const submitLoading = submitButton.querySelector('.submit-loading');
      const formMessage = document.getElementById('contactFormMessage');

      submitButton.disabled = true;
      submitText.style.display = 'none';
      submitLoading.style.display = 'inline';
      formMessage.style.display = 'none';

      const formData = {
        name: document.getElementById('contactName').value,
        email: document.getElementById('contactEmail').value,
        subject: document.getElementById('contactSubject').value,
        message: document.getElementById('contactMessage').value,
        formType: 'premium-plus-contact',
        timestamp: new Date().toISOString(),
      };

      try {
        const response = await fetch('/.netlify/functions/premium-plus-contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || '送信に失敗しました');

        form.reset();
        window.SubmissionResult && window.SubmissionResult.showSuccessScreen({
          formEl: form,
          messageEl: formMessage,
          options: {
            title: 'お問い合わせを受け付けました',
            message: 'Premium Plus サポートへのお問い合わせを受け付けました。',
            subMessage: '確認メールをお送りしましたのでご確認ください。マイページから送信履歴も確認できます。',
          },
          history: {
            type: 'premium-plus-contact',
            label: 'Premium Plus お問い合わせ',
            status: 'sent',
            details: { email: formData.email, subject: formData.subject },
          },
        });
      } catch (error) {
        console.error('Contact form submission error:', error);
        formMessage.textContent = '❌ 送信に失敗しました。もう一度お試しいただくか、support@keiba.link までご連絡ください。';
        formMessage.className = 'form-message error';
        formMessage.style.display = 'block';
        submitButton.disabled = false;
        submitText.style.display = 'inline';
        submitLoading.style.display = 'none';
      }
    });
  </script>
</body>
</html>
