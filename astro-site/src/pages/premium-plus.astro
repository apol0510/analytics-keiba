---
export const prerender = false;
/**
 * Premium Plus — 1 日 1 鞍・三連単フォーメーションの単品商品
 *
 * 前提（変更禁止）:
 * - 単品商品（サブスクではない）
 * - Premium Sanrenpuku 会員にのみ見せる。Premium / Light には存在も知らせない
 * - 超精密 AI が厳選した 1 鞍のみを提供する
 *
 * 認可（Phase 2 / SSR サーバー側・存在秘匿）:
 * - prerender=false（SSR）。ak_session（HttpOnly 署名 Cookie）をサーバーで検証する。
 * - verifyPlanAccess が OK（premium-sanrenpuku / premium-combo）のときだけ HTML を返す。
 * - 未ログイン / free / light / premium / 期限切れ / Cookie 破損 / 鍵未設定 は
 *   すべて 404 を返し、商品名・価格・口座番号を一切出さず存在を秘匿する（fail closed）。
 * - localStorage / クライアント AccessControl は認可の根拠にしない（下の <AccessControl>
 *   は多層防御として残すのみ。真実源はこの SSR ゲート）。
 * - 会員別 HTML なので CDN 共有を禁止（Cache-Control: private, no-store / Vary: Cookie）。
 *
 * 実績画像・実績数値:
 * - 画像は Netlify Blobs（/admin/premium-plus-images から日次アップロード。ビルド不要で反映）
 * - 数値は src/lib/premiumPlusShowcase.js が自動集計した値のみを使う。
 *   ページに実績数値を**手書きしないこと**（旧版の「的中率78% / 平均配当¥281,340 /
 *   満足度4.9 / 継続率94%」は根拠のない固定値で、更新も止まっていた）
 */
import AccessControl from '../components/AccessControl.astro';
import { verifyPlanAccess } from '../lib/auth/index.js';

// --- SSR プラン認可（真実源） ---
const access = await verifyPlanAccess({
  cookieHeader: Astro.request.headers.get('cookie') || '',
  secret: process.env.SESSION_SIGNING_SECRET,
  now: Date.now(),
});
if (!access.ok) {
  // 非会員には存在すら知らせない → 401/403 ではなく 404。商品情報は一切描画しない。
  return new Response('Not Found', {
    status: 404,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'Cache-Control': 'private, no-store',
    },
  });
}
// 会員別レスポンス。CDN に共有キャッシュさせない。
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie');

const PRICE = 68000;
const LIST_PRICE = 98000;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Premium Plus | KEIBA Analytics</title>
  <meta name="description" content="Premium Sanrenpuku 会員限定。1日1鞍・三連単フォーメーション。">
  <!-- 会員限定の非公開商品。検索結果に出さない（robots.txt でも Disallow） -->
  <meta name="robots" content="noindex, nofollow">
  <style>
    :root {
      --bg: #0b1120;
      --panel: #111c33;
      --panel-2: #0d1729;
      --line: rgba(148, 163, 184, 0.16);
      --text: #e6edf7;
      --muted: #93a4bd;
      --gold: #f5c451;
      --gold-deep: #d99b1f;
      --green: #34d399;
      --red: #f87171;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background:
        radial-gradient(1200px 600px at 50% -10%, rgba(245, 196, 81, 0.10), transparent 60%),
        radial-gradient(900px 500px at 10% 20%, rgba(52, 211, 153, 0.05), transparent 55%),
        var(--bg);
      color: var(--text);
      font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
      padding-bottom: 5rem;
    }

    .container { max-width: 960px; margin: 0 auto; padding: 0 1.25rem; }

    /* ── 見出し系 ───────────────────────── */
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--gold);
      background: rgba(245, 196, 81, 0.08);
      border: 1px solid rgba(245, 196, 81, 0.28);
      border-radius: 999px;
      padding: 6px 14px;
    }

    .section { padding: 3.5rem 0; border-top: 1px solid var(--line); }
    .section:first-of-type { border-top: none; }

    .section-head { margin-bottom: 2rem; }

    .section-title {
      font-size: clamp(1.35rem, 3.4vw, 1.9rem);
      font-weight: 800;
      letter-spacing: 0.01em;
      line-height: 1.4;
    }

    .section-lead { color: var(--muted); font-size: 0.95rem; margin-top: 0.6rem; }

    /* 見出しの改行はデスクトップのみ（モバイルは自然折返しに任せる） */
    .sp-br { display: none; }
    @media (min-width: 768px) { .sp-br { display: inline; } }

    .accent { color: var(--gold); }

    /* ── ヒーロー ───────────────────────── */
    .hero { padding: 4rem 0 3rem; text-align: center; }

    .hero h1 {
      font-size: clamp(1.9rem, 6vw, 3.1rem);
      font-weight: 900;
      line-height: 1.3;
      margin: 1.5rem 0 1.25rem;
      letter-spacing: 0.01em;
    }

    .hero h1 .line2 {
      display: block;
      background: linear-gradient(100deg, var(--gold) 10%, #fff3d0 50%, var(--gold-deep) 90%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: var(--muted);
      font-size: clamp(0.95rem, 2.3vw, 1.1rem);
      max-width: 620px;
      margin: 0 auto;
    }

    .hero strong { color: var(--text); font-weight: 700; }

    /* ── 実績スタッツ ───────────────────── */
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem;
      margin-top: 2.5rem;
    }

    .stat {
      background: linear-gradient(180deg, var(--panel), var(--panel-2));
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1.25rem 1rem;
    }

    .stat b {
      display: block;
      font-size: clamp(1.4rem, 4.5vw, 1.9rem);
      font-weight: 900;
      color: var(--gold);
      letter-spacing: 0.01em;
      font-variant-numeric: tabular-nums;
    }

    .stat span { display: block; font-size: 0.78rem; color: var(--muted); margin-top: 4px; }

    .stats-note { font-size: 0.75rem; color: var(--muted); margin-top: 1rem; text-align: center; }

    /* ── 課題 → 解決 ───────────────────── */
    .problems { display: grid; gap: 0.9rem; }

    .problem {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-left: 3px solid rgba(248, 113, 113, 0.55);
      border-radius: 12px;
      padding: 1.15rem 1.25rem;
    }

    .problem h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; }
    .problem p { font-size: 0.9rem; color: var(--muted); }
    .problem .mark { color: var(--red); font-size: 1.05rem; line-height: 1.8; }

    .answer {
      margin-top: 1.75rem;
      background: linear-gradient(135deg, rgba(52, 211, 153, 0.10), rgba(245, 196, 81, 0.08));
      border: 1px solid rgba(52, 211, 153, 0.35);
      border-radius: 16px;
      padding: 2rem 1.5rem;
      text-align: center;
    }

    .answer h3 { font-size: clamp(1.1rem, 3.2vw, 1.4rem); font-weight: 800; margin-bottom: 0.75rem; }
    .answer p { color: var(--muted); font-size: 0.95rem; }
    .answer strong { color: var(--green); }

    /* ── 実績ギャラリー ─────────────────── */
    .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; }

    .shot {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .shot img { width: 100%; height: auto; display: block; border-bottom: 1px solid var(--line); }

    .shot-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 0.7rem 0.85rem;
      font-size: 0.82rem;
    }

    .shot-date { font-weight: 700; }
    .shot-race { color: var(--muted); font-size: 0.78rem; }

    .result-badge { font-size: 0.75rem; font-weight: 800; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
    .result-badge.hit { background: rgba(52, 211, 153, 0.14); color: var(--green); }
    .result-badge.miss { background: rgba(148, 163, 184, 0.14); color: var(--muted); }

    .gallery-empty, .gallery-loading { color: var(--muted); font-size: 0.9rem; text-align: center; padding: 2rem 0; }

    /* ── 届くもの（3ステップ） ─────────── */
    .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; }

    .step {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1.5rem 1.25rem;
    }

    .step-no {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: rgba(245, 196, 81, 0.12);
      border: 1px solid rgba(245, 196, 81, 0.3);
      color: var(--gold);
      font-weight: 800;
      font-size: 0.85rem;
      margin-bottom: 0.9rem;
    }

    .step h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.4rem; }
    .step p { font-size: 0.88rem; color: var(--muted); }

    /* ── 比較表 ─────────────────────────── */
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

    table { width: 100%; border-collapse: collapse; min-width: 560px; font-size: 0.9rem; }

    th, td { padding: 0.95rem 1rem; text-align: left; border-bottom: 1px solid var(--line); }

    thead th { font-size: 0.8rem; color: var(--muted); font-weight: 700; white-space: nowrap; }

    thead th.plus { color: var(--gold); }

    tbody th { font-weight: 600; color: var(--muted); font-size: 0.85rem; white-space: nowrap; }

    td.plus { background: rgba(245, 196, 81, 0.05); color: var(--text); font-weight: 700; }

    tbody tr:last-child th, tbody tr:last-child td { border-bottom: none; }

    /* ── 価格・CTA ──────────────────────── */
    .offer {
      background: linear-gradient(180deg, var(--panel), var(--panel-2));
      border: 1px solid rgba(245, 196, 81, 0.35);
      border-radius: 20px;
      padding: 2.5rem 1.5rem;
      text-align: center;
    }

    .price-row { display: flex; align-items: baseline; justify-content: center; gap: 12px; flex-wrap: wrap; margin: 1rem 0 0.25rem; }

    .price-was { color: var(--muted); text-decoration: line-through; font-size: 1.1rem; }

    .price-now {
      font-size: clamp(2.4rem, 8vw, 3.4rem);
      font-weight: 900;
      color: var(--gold);
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.01em;
    }

    .price-note { color: var(--muted); font-size: 0.88rem; }

    .cta-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      max-width: 420px;
      margin: 1.75rem auto 0;
      background: linear-gradient(135deg, var(--gold), var(--gold-deep));
      color: #1a1205;
      padding: 1.15rem 2rem;
      font-size: 1.1rem;
      font-weight: 900;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 12px 32px rgba(245, 196, 81, 0.22);
      font-family: inherit;
    }

    .cta-button:hover { transform: translateY(-2px); box-shadow: 0 16px 40px rgba(245, 196, 81, 0.32); }

    .cta-sub { font-size: 0.8rem; color: var(--muted); margin-top: 1rem; }

    /* ── 声 ─────────────────────────────── */
    .voices { display: grid; gap: 1rem; }

    .voice {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-left: 3px solid var(--gold);
      border-radius: 12px;
      padding: 1.35rem 1.5rem;
    }

    .voice p { font-size: 0.94rem; color: #cfdaea; }
    .voice .who { display: block; margin-top: 0.8rem; font-size: 0.8rem; color: var(--muted); text-align: right; }

    /* ── FAQ ────────────────────────────── */
    .faq { display: grid; gap: 0.75rem; }

    .faq details {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 0 1.25rem;
    }

    .faq summary {
      cursor: pointer;
      list-style: none;
      padding: 1.15rem 0;
      font-weight: 700;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .faq summary::-webkit-details-marker { display: none; }

    .faq summary::before {
      content: 'Q';
      flex-shrink: 0;
      width: 22px;
      height: 22px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      background: rgba(245, 196, 81, 0.14);
      color: var(--gold);
      font-size: 0.72rem;
      font-weight: 800;
    }

    .faq details[open] summary { border-bottom: 1px solid var(--line); }

    .faq .answer-body { padding: 1.1rem 0 1.35rem 32px; font-size: 0.9rem; color: var(--muted); }
    .faq .answer-body strong { color: var(--text); }

    /* ── 免責 ───────────────────────────── */
    .disclaimer {
      margin-top: 2.5rem;
      font-size: 0.78rem;
      color: var(--muted);
      background: rgba(148, 163, 184, 0.06);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.25rem;
    }

    .back-link { text-align: center; padding: 2.5rem 0 1rem; }
    .back-link a { color: var(--muted); text-decoration: none; font-size: 0.88rem; }
    .back-link a:hover { color: var(--text); }

    /* ── モバイル固定 CTA ───────────────── */
    .sticky-cta {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 90;
      background: rgba(11, 17, 32, 0.94);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--line);
      padding: 0.75rem 1rem;
      display: none;
      align-items: center;
      gap: 1rem;
    }

    .sticky-cta .p { font-size: 0.95rem; font-weight: 900; color: var(--gold); white-space: nowrap; }

    .sticky-cta button {
      flex: 1;
      background: linear-gradient(135deg, var(--gold), var(--gold-deep));
      color: #1a1205;
      border: none;
      border-radius: 10px;
      padding: 0.85rem;
      font-weight: 900;
      font-size: 0.95rem;
      cursor: pointer;
      font-family: inherit;
    }

    @media (max-width: 768px) { .sticky-cta { display: flex; } }

    /* ── 銀行振込 / お問い合わせ モーダル ── */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 16, 0.85);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .modal.active { display: flex; }

    .modal-content {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 2.25rem 1.75rem;
      max-width: 600px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
    }

    .modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(148, 163, 184, 0.1);
      border: 1px solid var(--line);
      color: var(--muted);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      font-size: 1.2rem;
      cursor: pointer;
    }

    .modal-title { font-size: 1.3rem; font-weight: 800; margin-bottom: 1.5rem; text-align: center; }

    .bank-box { background: var(--panel-2); border: 1px solid var(--line); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; }

    .bank-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding: 0.7rem 0;
      border-bottom: 1px solid var(--line);
      font-size: 0.9rem;
    }

    .bank-item:last-child { border-bottom: none; }
    .bank-item .k { color: var(--muted); font-size: 0.82rem; white-space: nowrap; }
    .bank-item .v { font-weight: 700; text-align: right; }
    .bank-item.amount .v { color: var(--gold); font-size: 1.2rem; }

    .copy-button {
      background: rgba(148, 163, 184, 0.12);
      border: 1px solid var(--line);
      color: var(--muted);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.72rem;
      cursor: pointer;
      margin-left: 8px;
      font-family: inherit;
    }

    .copy-button:hover { color: var(--text); }

    .steps-box { background: rgba(52, 211, 153, 0.06); border: 1px solid rgba(52, 211, 153, 0.25); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; }
    .steps-box h4 { font-size: 0.95rem; color: var(--green); margin-bottom: 0.75rem; }
    .steps-box ol { margin: 0; padding-left: 1.2rem; color: var(--muted); font-size: 0.88rem; }
    .steps-box li { margin-bottom: 0.4rem; }

    .form { display: flex; flex-direction: column; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-label { font-size: 0.85rem; font-weight: 600; }
    .required { color: var(--red); margin-left: 3px; }

    .form-input, .form-textarea, select.form-input {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 11px 14px;
      color: var(--text);
      font-size: 1rem;
      font-family: inherit;
    }

    .form-input:focus, .form-textarea:focus { outline: none; border-color: var(--gold); }
    .form-textarea { resize: vertical; min-height: 80px; }

    .form-submit-button {
      background: linear-gradient(135deg, var(--green), #10b981);
      color: #04231a;
      border: none;
      border-radius: 8px;
      padding: 14px;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      font-family: inherit;
    }

    .form-submit-button:disabled { opacity: 0.6; cursor: not-allowed; }

    .form-message { padding: 12px; border-radius: 8px; font-size: 0.9rem; text-align: center; }
    .form-message.success { background: rgba(52, 211, 153, 0.1); border: 1px solid rgba(52, 211, 153, 0.3); color: var(--green); }
    .form-message.error { background: rgba(248, 113, 113, 0.1); border: 1px solid rgba(248, 113, 113, 0.3); color: var(--red); }

    .warning-box { background: rgba(245, 196, 81, 0.07); border: 1px solid rgba(245, 196, 81, 0.25); border-radius: 12px; padding: 1.25rem; font-size: 0.82rem; color: var(--muted); }
    .warning-box h4 { color: var(--gold); font-size: 0.9rem; margin-bottom: 0.6rem; }

    .link-button {
      background: none;
      border: 1px solid var(--line);
      color: var(--muted);
      padding: 10px 22px;
      border-radius: 8px;
      font-size: 0.88rem;
      cursor: pointer;
      font-family: inherit;
    }

    .link-button:hover { color: var(--text); border-color: var(--gold); }
  </style>
</head>
<body>
  <AccessControl requiredPlan="Premium Sanrenpuku" showUpgrade={false}>
  <div class="container">

    <!-- ══ ヒーロー ══ -->
    <header class="hero">
      <span class="eyebrow">◆ Premium Sanrenpuku 会員限定・非公開</span>

      <h1>
        今日、1鞍だけ。
        <span class="line2">配当の上限を、外す。</span>
      </h1>

      <p>
        超精密 AI が、その日の全開催（中央・南関）から<strong>最も獲れる 1 鞍</strong>だけを選び、
        <strong>三連単フォーメーション</strong>の買い目を確定してお渡しします。
        選ぶのも、迷うのも、こちらの仕事です。
      </p>

      <!-- 実績数値は premiumPlusShowcase.js の自動集計値のみ。手書き禁止。 -->
      <div class="stats" id="stats">
        <div class="stat"><b>—</b><span>読み込み中</span></div>
      </div>
      <p class="stats-note" id="statsNote"></p>
    </header>

    <!-- ══ なぜ三連複会員にだけ案内するのか ══ -->
    <section class="section">
      <div class="section-head">
        <h2 class="section-title">三連複で「当たる」を手にした人の、<br class="sp-br">次の壁。</h2>
        <p class="section-lead">
          Premium Sanrenpuku をお使いのあなたなら、心当たりがあるはずです。
        </p>
      </div>

      <div class="problems">
        <div class="problem">
          <span class="mark">✕</span>
          <div>
            <h3>当たっているのに、手元に残らない</h3>
            <p>三連複は的中しやすい。けれど人気どころで決まった日の配当は、投資額を引くとほとんど残らない。</p>
          </div>
        </div>
        <div class="problem">
          <span class="mark">✕</span>
