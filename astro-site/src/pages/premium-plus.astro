---
export const prerender = false;
/**
 * Premium Plus — 1 日 1 鞍・三連単フォーメーションの単品商品
 *
 * 前提（変更禁止）:
 * - 単品商品（サブスクではない）
 * - Premium Sanrenpuku 会員にのみ見せる。Premium / Light には存在も知らせない
 * - 超精密 AI が厳選した 1 鞍のみを提供する
 *
 * 認可（Phase 2 / SSR サーバー側・存在秘匿）:
 * - prerender=false（SSR）。ak_session（HttpOnly 署名 Cookie）をサーバーで検証する。
 * - verifyPlanAccess が OK（premium-sanrenpuku / premium-combo）のときだけ HTML を返す。
 * - 未ログイン / free / light / premium / 期限切れ / Cookie 破損 / 鍵未設定 は
 *   すべて 404 を返し、商品名・価格・口座番号を一切出さず存在を秘匿する（fail closed）。
 * - localStorage / クライアント AccessControl は認可の根拠にしない（下の <AccessControl>
 *   は多層防御として残すのみ。真実源はこの SSR ゲート）。
 * - 会員別 HTML なので CDN 共有を禁止（Cache-Control: private, no-store / Vary: Cookie）。
 *
 * 実績画像・実績数値:
 * - 画像は Netlify Blobs（/admin/premium-plus-images から日次アップロード。ビルド不要で反映）
 * - 数値は src/lib/premiumPlusShowcase.js が自動集計した値のみを使う。
 *   ページに実績数値を**手書きしないこと**（旧版の「的中率78% / 平均配当¥281,340 /
 *   満足度4.9 / 継続率94%」は根拠のない固定値で、更新も止まっていた）
 */
import AccessControl from '../components/AccessControl.astro';
import SessionKeepAlive from '../components/SessionKeepAlive.astro';
import { verifyPlanAccess, PREMIUM_PLUS_CANDIDATE_PLANS } from '../lib/auth/index.js';
import ppResultsRaw from '../data/premiumPlusResults.json';
import { computeStats, latestCards, sortResults, formatYen, formatYenShort } from '../lib/premiumPlusResults.js';
import { PP_RELEASE_COPY, intakeCopy } from '../lib/premiumPlus/premiumPlusRelease.js';
// 「いま売っているのは何日分か」の単一源。表示・注文はここだけを使う
import { resolveSaleTarget, buildSaleProductName } from '../lib/premiumPlus/premiumPlusSaleDate.js';
import { shapeRaceCalendar } from '../lib/premiumPlus/premiumPlusRaceCalendar.js';
import ppRaceCalendar from '../data/premiumPlusRaceCalendar.json';
import { resolveUpsellForCustomer, UPSELL_CHANNEL } from '../lib/upsell/upsellTarget.js';
// 受付休止ページ（停止中に直 URL で来たお客様を 404 で追い返さない）
import {
  readReopenCoupon, describeCouponForMember, isReopenCouponEnabled,
  PP_REOPEN_COUPON_SOURCE,
} from '../lib/premiumPlus/premiumPlusReopenCoupon.js';
import { renderPauseNoticeHtml } from '../lib/premiumPlus/premiumPlusPauseNoticePage.js';
// 再募集の開始日時（`reopenStartsAt`）の単一源。**全ての面がここから読む**。
// ⚠️ ここで言う期限はクーポンの利用期限（開始 + 14 日）。会員権の期限とは無関係で、
//    このページは会員判定を一切再実装しない（正本は resolveEntitlements）。
import { loadReopenStart } from '../lib/premiumPlus/premiumPlusReopenStartStore.js';
import { withReopenStart } from '../lib/premiumPlus/premiumPlusReopenStart.js';
// 「取得できるか」の単一源（**販売停止フラグでは決めない**）
import { resolveCouponAccess } from '../lib/premiumPlus/premiumPlusCouponAccess.js';
// 申込モーダル内のクーポン適用 UI（金額はサーバーの単一源から取る）
import PremiumPlusCouponApply from '../components/PremiumPlusCouponApply.astro';
import { lookupCustomerFields } from '../lib/premiumPlus/purchaseAnchorLookup.js';
import { recordPlusPageView, readPlusSourceFromUrl } from '../lib/premiumPlus/premiumPlusFunnelServer.js';

// --- SSR プラン認可（真実源） ---
const access = await verifyPlanAccess({
  cookieHeader: Astro.request.headers.get('cookie') || '',
  secret: process.env.SESSION_SIGNING_SECRET,
  now: Date.now(),
  // ROUTE B（通常 Premium 会員）も入口に通す。実際の可否は下の販売資格 + phase が決める。
  allowedPlans: PREMIUM_PLUS_CANDIDATE_PLANS,
});
if (!access.ok) {
  // 非会員には存在すら知らせない → 401/403 ではなく 404。商品情報は一切描画しない。
  return new Response('Not Found', {
    status: 404,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'Cache-Control': 'private, no-store',
    },
  });
}
// --- 段階公開（PHASE 1〜4）---
// 旧経路のこのページからも段階公開を迂回できないよう、v2 と同じ判定を必ず通す。
// 判定は premiumPlusRelease.js（純粋）に集約。購入確定日時が不明なら PHASE 1 = 404（fail closed）。
const ppNow = Date.now();
const ppFields = await lookupCustomerFields({
  recordId: access.payload?.sub || null,
  env: process.env,
  now: ppNow,
});
// 会員状態は既存の権限正本（resolveEntitlements）を再利用する。Plus 専用の権限判定は作らない。
// 販売導線の選択（UpsellTarget）も同じ単一源で評価する。
// sanrenpuku / none 指定の会員は商品ページ自体を開けない（2 商品を並べない・存在秘匿）。
// 販売の一時停止（PremiumPlusSalePaused）は member → release の単一源が読む。
// 停止中は showProductPage が false になり、下の判定でこのページは 404 になる。
const ppUpsell = resolveUpsellForCustomer({
  fields: ppFields,
  nowMs: ppNow,
  fallbackAnchor: process.env.PREMIUM_PLUS_FUNNEL_ANCHOR,
});
const ppRelease = ppUpsell.plusRelease;
if (ppUpsell.channel !== UPSELL_CHANNEL.PLUS || !ppRelease.showProductPage) {
  // ── 販売を一時停止している対象会員だけは 404 にしない ──────────────
  // 以前この URL を保存されたお客様を「ページが消えた」扱いで追い返さないため、
  // 受付休止のご案内と、募集再開時の優待クーポン取得だけを出す。
  // ⚠️ 購入 CTA・価格・申込経路は 1 つも出さない（販売停止は維持したまま）。
  //    誰に出すかの判定は単一源 `pauseNotice`（停止を外したら商品ページを
  //    見られたはずの人だけ）。それ以外は従来どおり 404 のまま。
  if (ppUpsell.pauseNotice?.showPauseNotice === true) {
    const ppCoupon = readReopenCoupon(ppFields);
    // ⚠️ 再募集の開始は**会員ごと**。必ず**この会員の** recordId で読む
    //    （サイト全体で 1 個の開始日時は存在しない）。
    const ppReopen = await loadReopenStart({
      recordId: access.payload?.sub || null, env: process.env,
    });
    // ⚠️ 取得できるかは**停止中かどうかではない**。その会員の再募集が開始済みで期限内か。
    //    未開始の会員には取得 CTA を出さない（「募集再開のご案内をお待ちください」になる）。
    const ppCouponAccess = resolveCouponAccess({
      audience: ppUpsell.plusAudience?.isPlusAudience === true,
      // ここは販売停止中の会員に出す受付休止ページ。配る相手はまさに「買えない人」
      salePaused: ppRelease.salePaused === true,
      reopen: ppReopen,
      fields: ppFields,
      nowMs: ppNow,
      storageReady: isReopenCouponEnabled(process.env),
    });
    const ppCouponView = describeCouponForMember({
      coupon: ppCoupon,
      paused: true,
      claimable: ppCouponAccess.canClaim,
      storageReady: isReopenCouponEnabled(process.env),
      def: withReopenStart(ppReopen.startsAtIso),
    });
    return new Response(
      renderPauseNoticeHtml({
        coupon: ppCouponView,
        source: PP_REOPEN_COUPON_SOURCE.PAUSE_NOTICE,
      }),
      {
        status: 200,
        headers: {
          'Content-Type': 'text/html; charset=utf-8',
          'Cache-Control': 'private, no-store',
          'X-Robots-Tag': 'noindex, nofollow',
          Vary: 'Cookie',
        },
      },
    );
  }
  return new Response('Not Found', {
    status: 404,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'Cache-Control': 'private, no-store',
    },
  });
}
const ppIntake = intakeCopy(ppRelease.intake);
// 対象日（16:30 以降は翌日分）。**購入ボタンの近くに必ず出す**
// 対象日（16:30 以降は翌暦日）。例外日だけ次の販売日へ送る
const ppSale = resolveSaleTarget(ppNow, { calendar: shapeRaceCalendar(ppRaceCalendar) });

// --- 実閲覧の記録（商品ページ到達）---
// ここまで来た時点で SSR 認可を通っており recordId が確定している。クライアント JS に任せると
// JS 無効・広告ブロック・即離脱で落ちるため、サーバー側で数える。
// Redis へ recordId だけ書き、Airtable へは 1 バイトも書かない。
// 失敗・未設定・遅延は「未確認」のまま（0 回とは記録しない）で、ページは通常どおり返す。
await recordPlusPageView({
  recordId: access.payload?.sub || null,
  env: process.env,
  userAgent: Astro.request.headers.get('user-agent') || '',
  nowMs: ppNow,
  // どのリンクから来たか（`?from=dashboard` / `?from=sanrenpuku`）。
  // ⚠️ URL は自由に付けられるので、allow-list を通した値だけを記録する。
  //    該当しなければ null（合計にだけ数える。推測で振り分けない）。
  source: readPlusSourceFromUrl(Astro.url),
});

// 会員別レスポンス。CDN に共有キャッシュさせない。
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'Cookie');

const PRICE = 68000;
const LIST_PRICE = 98000;

// SSR 関数キャッシュ bust 用テンプレート版。
// Netlify の functions cache が古い premium-plus SSR バンドルを再利用し、投票内容照会カードが
// 旧版（受付値なし・投票金額列なし）のまま残る drift への恒久対策。SPAT4/JRA カード描画
// （recv 受付表 / 3列投票表 / (各◯円) / 的中額）を更新したら必ずこの文字列を bump して
// SSR 関数の内容ハッシュを変え、確実にキャッシュミス＝関数再ビルドさせること（CLI deploy は使わない）。
const PP_TEMPLATE_VERSION = 'staged-release-phase-gate-20260728-1';

// --- 実績台帳（git コミット / 管理画面 premium-plus-results から入力）---
// 数値は computeStats() の自動集計のみ（手書き禁止）。10 鞍未満は非表示。
const ppStats = computeStats(ppResultsRaw);
const PP_WD = ['日', '月', '火', '水', '木', '金', '土'];
const ppFmtDate = (d) => {
  const [y, m, day] = String(d).split('-').map(Number);
  const wd = PP_WD[new Date(Date.UTC(y, m - 1, day)).getUTCDay()];
  return {
    full: `${y}年 ${m}月${day}日(${wd})`,
    spat: `${y}年${String(m).padStart(2, '0')}月${String(day).padStart(2, '0')}日`,
    short: `${m}/${day}`,
    wd,
  };
};
// 受付日時の表示整形: 「YYYY年MM月DD日 HH:MM」へ正規化（手入力の 20260723 / YYYY-MM-DD 等も救済）。
// 既に年月日表記ならそのまま。空なら開催日（spat 表記）にフォールバック。
const ppFmtReceiptAt = (raw, fallbackSpat) => {
  const s = String(raw || '').trim();
  if (!s) return fallbackSpat;
  if (/年.*月.*日/.test(s)) return s;
  const m = s.match(/^(\d{4})[-/.]?(\d{2})[-/.]?(\d{2})(?:[ T]+(\d{1,2}:\d{2}))?/);
  return m ? `${m[1]}年${m[2]}月${m[3]}日${m[4] ? ' ' + m[4] : ''}` : s;
};
const ppCards = latestCards(ppResultsRaw, { limit: 8 }).map((c) => {
  const w = String(c.winnerCombo || '').split(/[^0-9]+/).map((x) => parseInt(x, 10)).filter(Number.isFinite);
  // 三連単の的中組合せは「1着→2着→3着」の順序付き。台帳は "7-1-9" で保存するが表示は矢印区切り。
  // JRA 投票内容照会の「払戻単価」は 2 桁ゼロ埋め（06→01→04）なので vref jra 側は wDispPad を使う。
  const wDisp = w.length >= 2 ? w.join('→') : String(c.winnerCombo || '');
  const wDispPad = w.length >= 2 ? w.map((n) => (n < 10 ? `0${n}` : `${n}`)).join('→') : String(c.winnerCombo || '');
  return { ...c, w1: w[0], w2: w[1], w3: w[2], wDisp, wDispPad, jd: ppFmtDate(c.date) };
});

// --- 本日の1鞍ティザー（購入導線・買い目はロック） ---
// 会場サーキットは曜日から導出（平日=南関/SPAT4 ・ 土日=中央/JRA）。特定会場は伏せる（推測で会場名を書かない）。
const ppJstNow = new Date(Date.now() + 9 * 60 * 60 * 1000);
const ppTodayIsChuo = ppJstNow.getUTCDay() === 0 || ppJstNow.getUTCDay() === 6;
const ppToday = {
  y: ppJstNow.getUTCFullYear(),
  m: ppJstNow.getUTCMonth() + 1,
  d: ppJstNow.getUTCDate(),
  wd: PP_WD[ppJstNow.getUTCDay()],
  isChuo: ppTodayIsChuo,
};

// --- ティザーは**販売対象日**に合わせる（16:30 以降は翌日分）-------------
// ⚠️ ここを ppToday（今日）のままにすると、16:30 以降に同じ画面へ
//    「本日の 1 鞍 8/14」と購入ブロックの「8月15日分」が並び、
//    どちらを買うのか分からなくなる。見出し・日付・開催区分・ボタン文言は
//    すべて **ppSale（単一源）** から作る。
const ppTodayStr = `${ppToday.y}-${String(ppToday.m).padStart(2, '0')}-${String(ppToday.d).padStart(2, '0')}`;
const ppTeaser = (() => {
  // 売れないとき（例外日が連続する異常時のみ）は従来どおり本日を出す
  if (!ppSale.sellable || !ppSale.date) {
    return {
      y: ppToday.y, m: ppToday.m, d: ppToday.d, wd: ppToday.wd,
      isChuo: ppToday.isChuo,
      circuitLabel: ppToday.isChuo ? '基本：中央' : '基本：南関',
      isToday: true,
    };
  }
  const [y, m, d] = ppSale.date.split('-').map(Number);
  return {
    y, m, d,
    // UTC 正午基準で曜日だけを取る（タイムゾーンの影響を受けない）
    wd: PP_WD[new Date(Date.UTC(y, m - 1, d, 12)).getUTCDay()],
    isChuo: ppSale.circuit === 'chuo',
    circuitLabel: ppSale.circuitLabel,
    isToday: ppSale.date === ppTodayStr,
  };
})();
// 対象日が今日なら従来どおり「本日」。今日でないときだけ日付で言い切る
const ppTeaserEyebrow = ppTeaser.isToday ? '本日の 1 鞍' : `${ppTeaser.m}月${ppTeaser.d}日の 1 鞍`;
const ppTeaserCta = ppTeaser.isToday ? '🔓 本日の1鞍を抽出する' : `🔓 ${ppTeaser.m}月${ppTeaser.d}日の1鞍を抽出する`;

// --- 連勝レジャー帯（台帳の全件を最新順で・すべて掲載）---
// 数値は台帳の実データのみ（手書き禁止）。payout は formatYenShort で短縮表示。
const ppLedger = sortResults(ppResultsRaw).slice(0, 14).map((e) => ({
  short: ppFmtDate(e.date).short,
  isHit: !!e.isHit,
  payoutShort: e.isHit ? formatYenShort(e.payout) : '—',
  isChuo: e.circuit === 'chuo',
  hasImage: !!e.imageFile,
}));
import BankApplicationEmailLock from '../components/BankApplicationEmailLock.astro';
---

<!DOCTYPE html>
<html lang="ja" data-pp-phase={String(ppRelease.phase)} data-pp-purchase={ppRelease.purchaseEnabled ? '1' : '0'}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Premium Plus | KEIBA Analytics</title>
  <meta name="description" content="Premium Sanrenpuku 会員限定。1日1鞍・三連単フォーメーション。">
  <!-- 会員限定の非公開商品。検索結果に出さない（robots.txt でも Disallow） -->
  <meta name="robots" content="noindex, nofollow">
  <meta name="pp-template-version" content={PP_TEMPLATE_VERSION}>
  <style>
    :root {
      --bg: #0b1120;
      --panel: #111c33;
      --panel-2: #0d1729;
      --line: rgba(148, 163, 184, 0.16);
      --text: #e6edf7;
      --muted: #93a4bd;
      --gold: #f5c451;
      --gold-deep: #d99b1f;
      --green: #34d399;
      --red: #f87171;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background:
        radial-gradient(1200px 600px at 50% -10%, rgba(245, 196, 81, 0.10), transparent 60%),
        radial-gradient(900px 500px at 10% 20%, rgba(52, 211, 153, 0.05), transparent 55%),
        var(--bg);
      color: var(--text);
      font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
      padding-bottom: 5rem;
    }

    .container { max-width: 960px; margin: 0 auto; padding: 0 1.25rem; }

    /* ── 見出し系 ───────────────────────── */
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--gold);
      background: rgba(245, 196, 81, 0.08);
      border: 1px solid rgba(245, 196, 81, 0.28);
      border-radius: 999px;
      padding: 6px 14px;
    }

    .section { padding: 3.5rem 0; border-top: 1px solid var(--line); }
    .section:first-of-type { border-top: none; }

    .section-head { margin-bottom: 2rem; }

    .section-title {
      font-size: clamp(1.35rem, 3.4vw, 1.9rem);
      font-weight: 800;
      letter-spacing: 0.01em;
      line-height: 1.4;
    }

    .section-lead { color: var(--muted); font-size: 0.95rem; margin-top: 0.6rem; }

    /* 見出しの改行はデスクトップのみ（モバイルは自然折返しに任せる） */
    .sp-br { display: none; }
    @media (min-width: 768px) { .sp-br { display: inline; } }

    .accent { color: var(--gold); }

    /* ── ヒーロー ───────────────────────── */
    .hero { padding: 4rem 0 3rem; text-align: center; }

    .hero h1 {
      font-size: clamp(1.9rem, 6vw, 3.1rem);
      font-weight: 900;
      line-height: 1.3;
      margin: 1.5rem 0 1.25rem;
      letter-spacing: 0.01em;
    }

    .hero h1 .line2 {
      display: block;
      background: linear-gradient(100deg, var(--gold) 10%, #fff3d0 50%, var(--gold-deep) 90%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: var(--muted);
      font-size: clamp(0.95rem, 2.3vw, 1.1rem);
      max-width: 620px;
      margin: 0 auto;
    }

    .hero strong { color: var(--text); font-weight: 700; }

    /* ── 実績スタッツ ───────────────────── */
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem;
      margin-top: 2.5rem;
    }

    .stat {
      background: linear-gradient(180deg, var(--panel), var(--panel-2));
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1.25rem 1rem;
    }

    .stat b {
      display: block;
      font-size: clamp(1.4rem, 4.5vw, 1.9rem);
      font-weight: 900;
      color: var(--gold);
      letter-spacing: 0.01em;
      font-variant-numeric: tabular-nums;
    }

    .stat span { display: block; font-size: 0.78rem; color: var(--muted); margin-top: 4px; }

    .stats-note { font-size: 0.75rem; color: var(--muted); margin-top: 1rem; text-align: center; }

    /* ── 課題 → 解決 ───────────────────── */
    .problems { display: grid; gap: 0.9rem; }

    .problem {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-left: 3px solid rgba(248, 113, 113, 0.55);
      border-radius: 12px;
      padding: 1.15rem 1.25rem;
    }

    .problem h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; }
    .problem p { font-size: 0.9rem; color: var(--muted); }
    .problem .mark { color: var(--red); font-size: 1.05rem; line-height: 1.8; }

    .answer {
      margin-top: 1.75rem;
      background: linear-gradient(135deg, rgba(52, 211, 153, 0.10), rgba(245, 196, 81, 0.08));
      border: 1px solid rgba(52, 211, 153, 0.35);
      border-radius: 16px;
      padding: 2rem 1.5rem;
      text-align: center;
    }

    .answer h3 { font-size: clamp(1.1rem, 3.2vw, 1.4rem); font-weight: 800; margin-bottom: 0.75rem; }
    .answer p { color: var(--muted); font-size: 0.95rem; }
    .answer strong { color: var(--green); }

    /* ── 実績ギャラリー ─────────────────── */
    .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1rem; }

    .shot {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .shot img { width: 100%; height: auto; display: block; border-bottom: 1px solid var(--line); }

    .shot-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 0.7rem 0.85rem;
      font-size: 0.82rem;
    }

    .shot-date { font-weight: 700; }
    .shot-race { color: var(--muted); font-size: 0.78rem; }

    .result-badge { font-size: 0.75rem; font-weight: 800; padding: 3px 9px; border-radius: 999px; white-space: nowrap; }
    .result-badge.hit { background: rgba(52, 211, 153, 0.14); color: var(--green); }
    .result-badge.miss { background: rgba(148, 163, 184, 0.14); color: var(--muted); }

    .gallery-empty, .gallery-loading { color: var(--muted); font-size: 0.9rem; text-align: center; padding: 2rem 0; }

    /* ===== 実績: 投票内容照会 実再現カード（台帳からサーバー描画） ===== */
    .pp-cards { display: flex; flex-direction: column; gap: 20px; }
    .pp-evi { background: linear-gradient(180deg, rgba(23,36,64,.9), rgba(14,24,48,1)); border: 1px solid rgba(148,163,184,.28); border-radius: 18px; overflow: hidden; }
    .pp-evi-head { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .9rem; padding: 14px 18px; border-bottom: 1px solid var(--line); background: rgba(245,196,81,.03); }
    .pp-date { font-weight: 700; }
    .pp-race { color: var(--text); font-weight: 700; }
    .pp-rname { color: var(--muted); font-size: .9rem; }
    .pp-spacer { flex: 1; }
    .pp-circuit { font-size: .66rem; font-weight: 700; padding: .2em .6em; border-radius: 6px; }
    .pp-circuit.nk { color: #38bdf8; border: 1px solid rgba(56,189,248,.4); background: rgba(56,189,248,.08); }
    .pp-circuit.ch { color: #c084fc; border: 1px solid rgba(192,132,252,.4); background: rgba(192,132,252,.08); }
    .pp-badge { font-size: .72rem; padding: .35em .8em; border-radius: 999px; font-weight: 700; white-space: nowrap; }
    .pp-badge.bet { color: #cbd5e1; border: 1px solid rgba(148,163,184,.28); background: rgba(148,163,184,.08); }
    .pp-badge.hit { color: #06301f; background: linear-gradient(180deg, #4ade80, #0f9d6b); }
    .pp-badge.miss { color: #e6edf7; border: 1px solid rgba(248,113,113,.4); background: rgba(248,113,113,.12); }
    .pp-evi-body { display: grid; grid-template-columns: 1fr; gap: 0; }
    @media (min-width: 860px) { .pp-evi-body { grid-template-columns: minmax(0,1fr) auto; } }
    .pp-left { padding: 20px; display: flex; flex-direction: column; gap: 18px; border-bottom: 1px solid var(--line); }
    @media (min-width: 860px) { .pp-left { border-bottom: 0; border-right: 1px solid var(--line); } }
    .pp-flabel { font-size: .72rem; color: var(--muted); letter-spacing: .14em; margin-bottom: .9em; }
    .pp-form { display: grid; grid-template-columns: auto auto 1fr; gap: .5rem .7rem; align-items: start; }
    .pp-fcol { display: flex; flex-direction: column; gap: .5rem; }
    .pp-ch { font-size: .64rem; color: #6f819c; text-align: center; }
    .pp-chips { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
    .pp-arrow { align-self: center; color: var(--gold); font-size: 1.1rem; padding-top: 1.1rem; }
    .pp-num { width: 2.5em; height: 2.5em; display: grid; place-items: center; border-radius: 11px; font-weight: 700; font-size: 1.02rem; background: #111c33; border: 1px solid rgba(148,163,184,.28); color: var(--text); }
    .pp-num.axis { background: linear-gradient(180deg, var(--gold), #d99b1f); color: #3a2a05; border-color: transparent; }
    .pp-num.win { outline: 2px solid #34d399; outline-offset: 1px; }
    .pp-meta { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; padding-top: .2rem; border-top: 1px dashed var(--line); font-size: .86rem; }
    .pp-mi { display: flex; flex-direction: column; gap: .1em; }
    .pp-mi span { color: #6f819c; font-size: .7rem; }
    .pp-mi b { font-weight: 700; }
    .pp-mi b.pay { color: var(--gold); font-size: 1.1rem; }
    .pp-right { padding: 20px; display: flex; align-items: center; justify-content: center; background: repeating-linear-gradient(135deg, rgba(255,255,255,.012) 0 8px, transparent 8px 16px), rgba(6,11,22,.5); }

    /* vref: 投票内容照会 実再現（上部クロムは実スクショ実ピクセル / 表は実CSS値） */
    .vref { width: 375px; max-width: 100%; overflow: hidden; box-shadow: 0 16px 40px -20px rgba(0,0,0,.95); text-align: left; font-family: "ヒラギノ角ゴ Pro W3","Hiragino Kaku Gothic Pro","Hiragino Sans","メイリオ",Meiryo,sans-serif; color: #222; line-height: 1.4; }
    .vref .chrome { width: 375px; max-width: 100%; background-repeat: no-repeat; background-position: 0 0; }
    .vref.jra { background: #000; }
    .vref.jra .chrome { height: 52px; background-image: url('/premium-plus-proof/jra-head.png'); background-size: 375px auto; }
    .vref.jra .r2 { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 10px 5px; background: linear-gradient(to bottom, #1c1c1c, #232323); }
    .vref.jra .r2 .nav { width: 34px; height: 30px; border: 1px solid #444; border-radius: 5px; background: linear-gradient(to bottom, #2a2a2a, #111); color: #eee; text-align: center; line-height: 28px; font-size: 12px; }
    .vref.jra .r2 .c { flex: 1; text-align: center; color: #fff; }
    .vref.jra .r2 .c .d { font-size: 13px; font-weight: bold; }
    .vref.jra .r2 .c .n { font-size: 20px; font-weight: bold; }
    .vref.jra .hl { padding: 8px 10px 10px; background: linear-gradient(to bottom, #1c1c1c, #232323); }
    .vref.jra .hlcard { background: #fff; border-radius: 6px; padding: 2px 14px; }
    .vref.jra .hlrow { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; font-size: 19px; font-weight: bold; color: #424242; }
    .vref.jra .hlrow + .hlrow { border-top: 1px solid #ddd; }
    .vref.jra .hlrow.back { color: #b70000; }
    .vref.jra .close { height: 40px; line-height: 40px; background: #555; color: #fff; font-size: 16px; font-weight: bold; text-align: center; border-bottom: 1px solid #fff; position: relative; }
    .vref.jra .close .acc { position: absolute; right: 8px; top: 6px; width: 28px; height: 26px; border: 1px solid #666; border-radius: 4px; background: linear-gradient(to bottom, #3a3a3a, #1a1a1a); line-height: 26px; font-size: 11px; color: #ccc; }
    .vref.jra .vh { background: #d0d0d0; color: #424242; font-size: 12px; font-weight: bold; line-height: 1.5; padding: 6px 6px; }
    .vref.jra .vh .l2 { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin-top: 4px; font-size: 11px; }
    .vref.jra .vh .hit { background: #b70000; color: #fff; padding: 1px 6px; }
    .vref.jra .vh .pay { color: #b70000; }
    .vref.jra .dt { background: #fff; color: #222; font-size: 14px; }
    .vref.jra .dt .row { display: grid; grid-template-columns: 33% 1fr; border-top: 1px solid #ccc; }
    .vref.jra .dt .row:first-child { border-top: 0; }
    .vref.jra .dt .lc { padding: 9px 8px; border-right: 1px solid #ccc; display: flex; align-items: center; font-weight: bold; }
    .vref.jra .dt .rc { padding: 9px 12px; text-align: right; font-weight: bold; }
    .vref.jra .dt .rc.split { display: flex; justify-content: space-between; gap: 10px; text-align: left; }
    .vref.jra .dt .uma > div { display: flex; justify-content: space-between; gap: 10px; padding: 1px 0; }
    .vref.jra .dt .uma .pf { font-weight: bold; }
    .vref.jra .dt .rc.red { color: #b70000; }
    .vref.jra .foot { background: #333; color: #fff; font-size: 10px; text-align: right; padding: 8px 10px; }
    .vref.spat { background: #fff; border: 1px solid #cfcfcf; }
    .vref.spat .chrome { height: 86px; background-image: url('/premium-plus-proof/spat4-head.png'); background-size: 375px auto; }
    .vref.spat table { width: 100%; border-collapse: collapse; }
    .vref.spat .recv td { border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; padding: 5px 8px; font-size: 14px; height: 28px; }
    .vref.spat .recv tr:nth-child(odd) { background: #F1F8F8; }
    .vref.spat .recv td:first-child { text-align: left; width: 40%; color: #000; }
    .vref.spat .recv td:last-child { text-align: right; padding-right: 8px; }
    .vref.spat .bet th { height: 22px; font-size: 13px; color: #fff; text-shadow: #2D3642 0 -1px 0; text-align: center; font-weight: bold; border: 1px solid #999; border-top: none; background: linear-gradient(to bottom, #333 0%, #595959 12%, #7c7c7c 100%); }
    .vref.spat .bet td { border: 1px solid #ccc; font-size: 13px; padding: 5px 6px; vertical-align: top; }
    .vref.spat .bet .c1 { width: 40%; white-space: nowrap; text-align: left; }
    .vref.spat .bet .c2 { width: 30%; text-align: left; }
    .vref.spat .bet .c3 { width: 30%; white-space: nowrap; text-align: right; padding-right: 7px; vertical-align: middle; }
    .vref.spat .bet .race { font-size: 20px; color: #1560d0; text-decoration: underline; }
    .vref.spat .bet .c2 b { font-weight: bold; }
    .vref.spat .bet .hit { color: #e60000; }
    .vref.spat .notes { border-top: 7px solid #999; padding: 8px 8px 10px; font-size: 14px; color: #111; }
    .vref.spat .notes p { margin: 0 0 5px; }

    /* ===== 本日の1鞍（ティザー・購入導線） ===== */
    .today { position: relative; border: 1px solid rgba(245,196,81,.3); border-radius: 22px; overflow: hidden; margin: 2.5rem 0 0.5rem; background: linear-gradient(180deg, rgba(40,32,10,.55), rgba(14,24,48,.9)); box-shadow: 0 30px 80px -44px rgba(245,196,81,.35); }
    .today .today-top { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; padding: 20px 22px 0; }
    .today .ey { font-size: .72rem; letter-spacing: .2em; color: var(--gold); font-weight: 700; }
    .today .today-spacer { flex: 1; }
    .today .when { font-weight: 700; font-variant-numeric: tabular-nums; }
    .today .today-circuit { font-size: .66rem; font-weight: 700; letter-spacing: .08em; padding: .2em .6em; border-radius: 6px; }
    .today .today-circuit.nk { color: #38bdf8; border: 1px solid rgba(56,189,248,.4); background: rgba(56,189,248,.08); }
    .today .today-circuit.ch { color: #c084fc; border: 1px solid rgba(192,132,252,.4); background: rgba(192,132,252,.08); }
    .today .today-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
    @media (min-width: 720px) { .today .today-grid { grid-template-columns: 1.15fr .85fr; } }
    .today .today-l { padding: 18px 22px 22px; }
    .today .venue-line { display: flex; align-items: baseline; flex-wrap: wrap; gap: .5rem; margin: .2rem 0 1rem; }
    .today .venue-line .v { font-size: clamp(1.35rem, 4.5vw, 1.9rem); font-weight: 800; }
    .today .venue-line .sub { color: var(--muted); font-size: .86rem; }
    .today .locked { border: 1px dashed rgba(148,163,184,.28); border-radius: 14px; padding: 14px 16px; background: rgba(6,11,22,.4); display: flex; flex-direction: column; gap: .7rem; }
    .today .lrow { display: flex; align-items: center; gap: .7rem; font-size: .9rem; }
    .today .lk { color: #6f819c; width: 5.5em; font-size: .78rem; }
    .today .blur { filter: blur(7px); user-select: none; letter-spacing: .1em; color: var(--text); font-weight: 700; }
    .today .lock-ico { margin-left: auto; color: var(--gold); }
    .today .today-r { padding: 18px 22px 24px; display: flex; flex-direction: column; justify-content: center; gap: .7rem; border-top: 1px solid var(--line); }
    @media (min-width: 720px) { .today .today-r { border-top: 0; border-left: 1px solid var(--line); } }
    .today .price { display: flex; align-items: baseline; gap: .5rem; }
    .today .price .now { font-size: clamp(1.7rem, 5vw, 2.3rem); font-weight: 800; color: var(--gold); font-variant-numeric: tabular-nums; }
    .today .price .was { color: #6f819c; text-decoration: line-through; }
    .today .tax { color: #6f819c; font-size: .72rem; }
    .today .extract { appearance: none; cursor: pointer; border: 0; width: 100%; padding: 1rem 1.2rem; border-radius: 13px; font-family: inherit; font-weight: 800; font-size: 1.02rem; color: #3a2a05; background: linear-gradient(180deg, #ffe08a, var(--gold) 55%, var(--gold-deep)); box-shadow: 0 14px 30px -12px rgba(245,196,81,.6); }
    .today .extract:hover { transform: translateY(-1px); }
    .today .today-rule { margin: 0; padding: 14px 22px 20px; color: #6f819c; font-size: .76rem; display: flex; gap: .5em; border-top: 1px solid var(--line); }
    .today .today-rule b { color: var(--muted); }

    /* ===== なぜ1鞍（全レースより、この一鞍） ===== */
    .why { border: 1px solid var(--line); border-radius: 22px; background: linear-gradient(180deg, var(--panel), var(--panel-2)); padding: clamp(22px,4vw,34px); }
    .why-title { font-size: clamp(1.5rem,4.4vw,2.15rem); line-height: 1.25; margin: 0 0 .35em; font-weight: 800; }
    .why-title .accent { color: var(--gold); }
    .why-sub { margin: 0 0 clamp(16px,2.6vw,20px); font-weight: 700; font-size: clamp(1rem,2.7vw,1.18rem); color: var(--text); }
    .why-lead { color: var(--muted); font-size: 1rem; margin: 0 0 clamp(20px,3vw,26px); max-width: 62ch; line-height: 1.85; }
    .why-lead b { color: var(--gold); font-weight: 700; }
    .focus-viz { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: clamp(8px,3vw,26px); padding: clamp(16px,3vw,24px); border: 1px solid var(--line); border-radius: 16px; background: rgba(6,11,22,.4); margin-bottom: clamp(22px,3vw,28px); }
    .fv-dots { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; max-width: 172px; margin: 0 auto; }
    .fv-dots span { aspect-ratio: 1; border-radius: 50%; background: rgba(148,163,184,.2); border: 1px solid var(--line); }
    .fv-arrow { color: var(--gold); font-size: clamp(1.3rem,4vw,1.7rem); text-align: center; }
    .fv-one { width: clamp(54px,14vw,68px); aspect-ratio: 1; margin: 0 auto; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: clamp(1.5rem,5vw,2rem); color: #3a2a05; background: radial-gradient(circle at 40% 35%, #ffe9a8, var(--gold) 55%, var(--gold-deep)); box-shadow: 0 0 0 6px rgba(245,196,81,.14); }
    .fv-cap { display: block; text-align: center; font-size: .72rem; color: #6f819c; margin-top: 12px; line-height: 1.5; }
    .fv-cap.g { color: var(--gold); }
    .why-cols { display: grid; grid-template-columns: 1fr; gap: 1rem 2.2rem; margin-bottom: clamp(20px,3vw,26px); }
    @media (min-width: 680px) { .why-cols { grid-template-columns: 1fr 1fr; } }
    .why-cols p { margin: 0; color: var(--text); font-size: .92rem; line-height: 1.85; }
    .why-cols b { color: #fff; font-weight: 700; }
    .why-punch { margin: 0; font-size: clamp(1.02rem,2.7vw,1.2rem); line-height: 1.75; font-weight: 700; border-left: 3px solid var(--gold); padding-left: 1.1rem; }
    .why-punch .accent { color: var(--gold); }

    /* ===== 連勝レジャー帯（直近の1鞍・すべて掲載） ===== */
    .ledger-h { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin: clamp(24px,4vw,32px) 0 14px; }
    .ledger-h h3 { margin: 0; font-size: 1.02rem; font-weight: 700; }
    .ledger-sub { color: #6f819c; font-size: .76rem; }
    .ledger { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px,1fr)); gap: 8px; }
    .ledger .day { border: 1px solid var(--line); border-radius: 12px; padding: 10px 8px 9px; text-align: center; background: var(--panel-2); position: relative; }
    .ledger .day.h { border-color: rgba(52,211,153,.34); background: linear-gradient(180deg, rgba(52,211,153,.09), var(--panel-2)); }
    .ledger .day .d { font-size: .74rem; color: var(--muted); font-variant-numeric: tabular-nums; }
    .ledger .day .cam { position: absolute; top: 5px; right: 6px; font-size: .6rem; opacity: .5; }
    .ledger .day .ic { font-size: 1.05rem; line-height: 1.3; margin: .05em 0; }
    .ledger .day.h .ic { color: var(--green); }
    .ledger .day.m .ic { color: #6f819c; }
    .ledger .day .p { font-size: .72rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .ledger .day.h .p { color: var(--gold); }
    .ledger .day.m .p { color: #6f819c; }
    .ledger .day .cc { display: inline-block; margin-top: 3px; font-size: .58rem; font-weight: 700; padding: .05em .4em; border-radius: 5px; }
    .ledger .day .cc.nk { color: #38bdf8; background: rgba(56,189,248,.1); }
    .ledger .day .cc.ch { color: #c084fc; background: rgba(192,132,252,.1); }

    /* ── 届くもの（3ステップ） ─────────── */
    .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem; }

    .step {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1.5rem 1.25rem;
    }

    .step-no {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: rgba(245, 196, 81, 0.12);
      border: 1px solid rgba(245, 196, 81, 0.3);
      color: var(--gold);
      font-weight: 800;
      font-size: 0.85rem;
      margin-bottom: 0.9rem;
    }

    .step h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.4rem; }
    .step p { font-size: 0.88rem; color: var(--muted); }

    /* ── 比較表 ─────────────────────────── */
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

    table { width: 100%; border-collapse: collapse; min-width: 560px; font-size: 0.9rem; }

    th, td { padding: 0.95rem 1rem; text-align: left; border-bottom: 1px solid var(--line); }

    thead th { font-size: 0.8rem; color: var(--muted); font-weight: 700; white-space: nowrap; }

    thead th.plus { color: var(--gold); }

    tbody th { font-weight: 600; color: var(--muted); font-size: 0.85rem; white-space: nowrap; }

    td.plus { background: rgba(245, 196, 81, 0.05); color: var(--text); font-weight: 700; }

    tbody tr:last-child th, tbody tr:last-child td { border-bottom: none; }

    /* ── 価格・CTA ──────────────────────── */
    .offer {
      background: linear-gradient(180deg, var(--panel), var(--panel-2));
      border: 1px solid rgba(245, 196, 81, 0.35);
      border-radius: 20px;
      padding: 2.5rem 1.5rem;
      text-align: center;
    }

    .price-row { display: flex; align-items: baseline; justify-content: center; gap: 12px; flex-wrap: wrap; margin: 1rem 0 0.25rem; }

    .price-was { color: var(--muted); text-decoration: line-through; font-size: 1.1rem; }

    .price-now {
      font-size: clamp(2.4rem, 8vw, 3.4rem);
      font-weight: 900;
      color: var(--gold);
      font-variant-numeric: tabular-nums;
      letter-spacing: -0.01em;
    }

    .price-note { color: var(--muted); font-size: 0.88rem; }

    .cta-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      max-width: 420px;
      margin: 1.75rem auto 0;
      background: linear-gradient(135deg, var(--gold), var(--gold-deep));
      color: #1a1205;
      padding: 1.15rem 2rem;
      font-size: 1.1rem;
      font-weight: 900;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 12px 32px rgba(245, 196, 81, 0.22);
      font-family: inherit;
    }

    .cta-button:hover { transform: translateY(-2px); box-shadow: 0 16px 40px rgba(245, 196, 81, 0.32); }

    .cta-sub { font-size: 0.8rem; color: var(--muted); margin-top: 1rem; }

    /* ── 段階公開: 受付準備中 / 本日の受付ステータス ── */
    .pp-preparing {
      border: 1px dashed rgba(148, 163, 184, 0.38);
      border-radius: 14px;
      padding: 1.4rem 1.2rem;
      text-align: center;
      background: rgba(11, 17, 32, 0.5);
    }
    .pp-preparing-title { font-size: 1rem; font-weight: 800; color: var(--gold); margin: 0 0 0.5rem; }
    .pp-preparing-body { font-size: 0.86rem; color: var(--muted); margin: 0; line-height: 1.8; }

    .pp-intake {
      margin: 0 auto 1.2rem;
      max-width: 480px;
      border-radius: 12px;
      padding: 0.9rem 1rem;
      border: 1px solid var(--line);
      background: rgba(11, 17, 32, 0.55);
    }
    .pp-intake-title { font-size: 0.82rem; font-weight: 700; color: var(--muted); margin: 0 0 0.35rem; }
    .pp-intake-status { font-size: 1rem; font-weight: 900; margin: 0; }
    /* 何日分を買うのか。購入ボタンのすぐ上に置く */
    .pp-delivery-note { margin-top: .5rem; font-size: .8rem; line-height: 1.8; color: #cbd5e6; }
    .pp-sale-target { margin: 0 0 .6rem; font-size: 1.02rem; font-weight: 900; color: var(--gold); }
    .pp-sale-target-badge {
      display: inline-block; margin-left: .5rem; font-size: .68rem; font-weight: 800;
      padding: .12rem .5rem; border-radius: 999px; vertical-align: middle;
      background-color: rgba(245,196,81,.12); color: var(--gold); border: 1px solid rgba(245,196,81,.45);
    }
    .pp-intake-note { font-size: 0.74rem; color: var(--muted); margin: 0.45rem 0 0; line-height: 1.7; }
    .pp-intake.open { border-color: rgba(52, 211, 153, 0.4); }
    .pp-intake.open .pp-intake-status { color: var(--green); }
    .pp-intake.limited { border-color: rgba(245, 196, 81, 0.35); }
    .pp-intake.limited .pp-intake-status { color: var(--gold); }
    .pp-intake.closing { border-color: rgba(245, 196, 81, 0.45); }
    .pp-intake.closing .pp-intake-status { color: var(--gold); }
    .pp-intake.closed { border-color: rgba(248, 113, 113, 0.4); }
    .pp-intake.closed .pp-intake-title { color: var(--red); font-size: 1rem; font-weight: 900; }

    .cta-button:disabled,
    .today .extract:disabled,
    .sticky-cta button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
      filter: grayscale(0.6);
    }

    /* ── 声 ─────────────────────────────── */
    .voices { display: grid; gap: 1rem; }

    .voice {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-left: 3px solid var(--gold);
      border-radius: 12px;
      padding: 1.35rem 1.5rem;
    }

    .voice p { font-size: 0.94rem; color: #cfdaea; }
    .voice .who { display: block; margin-top: 0.8rem; font-size: 0.8rem; color: var(--muted); text-align: right; }

    /* ── FAQ ────────────────────────────── */
    .faq { display: grid; gap: 0.75rem; }

    .faq details {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 0 1.25rem;
    }

    .faq summary {
      cursor: pointer;
      list-style: none;
      padding: 1.15rem 0;
      font-weight: 700;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .faq summary::-webkit-details-marker { display: none; }

    .faq summary::before {
      content: 'Q';
      flex-shrink: 0;
      width: 22px;
      height: 22px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      background: rgba(245, 196, 81, 0.14);
      color: var(--gold);
      font-size: 0.72rem;
      font-weight: 800;
    }

    .faq details[open] summary { border-bottom: 1px solid var(--line); }

    .faq .answer-body { padding: 1.1rem 0 1.35rem 32px; font-size: 0.9rem; color: var(--muted); }
    .faq .answer-body strong { color: var(--text); }

    /* ── 免責 ───────────────────────────── */
    .disclaimer {
      margin-top: 2.5rem;
      font-size: 0.78rem;
      color: var(--muted);
      background: rgba(148, 163, 184, 0.06);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.25rem;
    }

    .back-link { text-align: center; padding: 2.5rem 0 1rem; }
    .back-link a { color: var(--muted); text-decoration: none; font-size: 0.88rem; }
    .back-link a:hover { color: var(--text); }

    /* ── モバイル固定 CTA ───────────────── */
    .sticky-cta {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 90;
      background: rgba(11, 17, 32, 0.94);
      backdrop-filter: blur(10px);
      border-top: 1px solid var(--line);
      padding: 0.75rem 1rem;
      display: none;
      align-items: center;
      gap: 1rem;
    }

    .sticky-cta .p { font-size: 0.95rem; font-weight: 900; color: var(--gold); white-space: nowrap; }

    .sticky-cta button {
      flex: 1;
      background: linear-gradient(135deg, var(--gold), var(--gold-deep));
      color: #1a1205;
      border: none;
      border-radius: 10px;
      padding: 0.85rem;
      font-weight: 900;
      font-size: 0.95rem;
      cursor: pointer;
      font-family: inherit;
    }

    @media (max-width: 768px) { .sticky-cta { display: flex; } }

    /* ── 銀行振込 / お問い合わせ モーダル ── */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 16, 0.85);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .modal.active { display: flex; }

    .modal-content {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 2.25rem 1.75rem;
      max-width: 600px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
    }

    .modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(148, 163, 184, 0.1);
      border: 1px solid var(--line);
      color: var(--muted);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      font-size: 1.2rem;
      cursor: pointer;
    }

    .modal-title { font-size: 1.3rem; font-weight: 800; margin-bottom: 1.5rem; text-align: center; }

    .bank-box { background: var(--panel-2); border: 1px solid var(--line); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; }

    .bank-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding: 0.7rem 0;
      border-bottom: 1px solid var(--line);
      font-size: 0.9rem;
    }

    .bank-item:last-child { border-bottom: none; }
    .bank-item .k { color: var(--muted); font-size: 0.82rem; white-space: nowrap; }
    .bank-item .v { font-weight: 700; text-align: right; }
    .bank-item.amount .v { color: var(--gold); font-size: 1.2rem; }

    .copy-button {
      background: rgba(148, 163, 184, 0.12);
      border: 1px solid var(--line);
      color: var(--muted);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.72rem;
      cursor: pointer;
      margin-left: 8px;
      font-family: inherit;
    }

    .copy-button:hover { color: var(--text); }

    .steps-box { background: rgba(52, 211, 153, 0.06); border: 1px solid rgba(52, 211, 153, 0.25); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.5rem; }
    .steps-box h4 { font-size: 0.95rem; color: var(--green); margin-bottom: 0.75rem; }
    .steps-box ol { margin: 0; padding-left: 1.2rem; color: var(--muted); font-size: 0.88rem; }
    .steps-box li { margin-bottom: 0.4rem; }

    .form { display: flex; flex-direction: column; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-label { font-size: 0.85rem; font-weight: 600; }
    .required { color: var(--red); margin-left: 3px; }

    .form-input, .form-textarea, select.form-input {
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 11px 14px;
      color: var(--text);
      font-size: 1rem;
      font-family: inherit;
    }

    .form-input:focus, .form-textarea:focus { outline: none; border-color: var(--gold); }
    .form-textarea { resize: vertical; min-height: 80px; }

    .form-submit-button {
      background: linear-gradient(135deg, var(--green), #10b981);
      color: #04231a;
      border: none;
      border-radius: 8px;
      padding: 14px;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      font-family: inherit;
    }

    .form-submit-button:disabled { opacity: 0.6; cursor: not-allowed; }

    .form-message { padding: 12px; border-radius: 8px; font-size: 0.9rem; text-align: center; }
    .form-message.success { background: rgba(52, 211, 153, 0.1); border: 1px solid rgba(52, 211, 153, 0.3); color: var(--green); }
    .form-message.error { background: rgba(248, 113, 113, 0.1); border: 1px solid rgba(248, 113, 113, 0.3); color: var(--red); }

    .warning-box { background: rgba(245, 196, 81, 0.07); border: 1px solid rgba(245, 196, 81, 0.25); border-radius: 12px; padding: 1.25rem; font-size: 0.82rem; color: var(--muted); }
    .warning-box h4 { color: var(--gold); font-size: 0.9rem; margin-bottom: 0.6rem; }

    .link-button {
      background: none;
      border: 1px solid var(--line);
      color: var(--muted);
      padding: 10px 22px;
      border-radius: 8px;
      font-size: 0.88rem;
      cursor: pointer;
      font-family: inherit;
    }

    .link-button:hover { color: var(--text); border-color: var(--gold); }
  </style>
</head>
<body>
  <AccessControl requiredPlan="Premium Sanrenpuku" showUpgrade={false}>
  <div class="container">

    <!-- ══ ヒーロー ══ -->
    <header class="hero">
      <span class="eyebrow">◆ Premium Sanrenpuku 会員限定・非公開</span>

      <h1>
        今日、1鞍だけ。
        <span class="line2">配当の上限を、外す。</span>
      </h1>

      <p>
        超精密 AI が、その日の全開催（中央・南関）から<strong>最も獲れる 1 鞍</strong>だけを選び、
        <strong>三連単フォーメーション</strong>の買い目を確定してお渡しします。
        選ぶのも、迷うのも、こちらの仕事です。
      </p>

      <!-- 実績数値は computeStats() の自動集計のみ（手書き禁止・10鞍未満は非表示） -->
      {(ppStats.rate.available || ppStats.payout.available) && (
        <div class="stats">
          {ppStats.rate.available && (
            <div class="stat"><b>{ppStats.rate.hitRate}%</b><span>的中率（直近 {ppStats.rate.races} 鞍）</span></div>
          )}
          {ppStats.rate.available && (
            <div class="stat"><b>{ppStats.rate.roi}%</b><span>回収率（直近 {ppStats.rate.races} 鞍）</span></div>
          )}
          {ppStats.payout.available && (
            <div class="stat"><b>{formatYen(ppStats.payout.max)}</b><span>最高払戻</span></div>
          )}
          {ppStats.payout.available && (
            <div class="stat"><b>{formatYen(ppStats.payout.avg)}</b><span>的中時の平均払戻</span></div>
          )}
        </div>
      )}
      {ppStats.payout.available && !ppStats.rate.available && (
        <p class="stats-note">※ 的中率・回収率は不的中を含む記録が 10 鞍たまり次第、自動掲載します。上記は的中した回の払戻実績です。</p>
      )}
    </header>

    <!-- ══ 本日の1鞍（ティザー・購入導線） ══ -->
    <div class="today">
      <div class="today-top">
        <span class="ey">{ppTeaserEyebrow}</span><span class="today-spacer"></span>
        <span class="when">{ppTeaser.y}/{ppTeaser.m}/{ppTeaser.d}（{ppTeaser.wd}）</span>
        <span class={ppTeaser.isChuo ? 'today-circuit ch' : 'today-circuit nk'}>{ppTeaser.circuitLabel}</span>
      </div>
      <div class="today-grid">
        <div class="today-l">
          <div class="venue-line"><span class="v">全開催</span><span class="sub">から AI が本日の 1 鞍を抽出</span></div>
          <div class="locked">
            <div class="lrow"><span class="lk">レース</span><span class="blur">11R</span><span class="lock-ico">🔒</span></div>
            <div class="lrow"><span class="lk">式別</span><span>三連単フォーメーション</span></div>
            <div class="lrow"><span class="lk">買い目</span><span class="blur">◯ → ◯◯ → ◯◯◯◯</span><span class="lock-ico">🔒</span></div>
          </div>
        </div>
        <div class="today-r">
          {ppRelease.showPurchaseCta ? (
            <>
              <div class="price"><span class="now">¥{PRICE.toLocaleString('ja-JP')}</span><span class="was">¥{LIST_PRICE.toLocaleString('ja-JP')}</span></div>
              <span class="tax">買い切り・追加課金なし</span>
              <button class="extract" type="button" onclick="openBankModal()" disabled={!ppRelease.purchaseEnabled}>{ppTeaserCta}</button>
            </>
          ) : (
            <div class="pp-preparing">
              <p class="pp-preparing-title">{PP_RELEASE_COPY.preparing.title}</p>
              <p class="pp-preparing-body">{PP_RELEASE_COPY.preparing.body}</p>
            </div>
          )}
        </div>
      </div>
      <p class="today-rule">🗓️ <span><b>基本：平日は南関、土日は中央（JRA）。</b>実際の開催場はその日の開催によります。中央と南関の開催が重なる日も、AI が全開催を横断して<b>ただ 1 鞍</b>だけを選びます。</span></p>
    </div>

    <!-- ══ なぜ三連複会員にだけ案内するのか ══ -->
    <section class="section">
      <div class="section-head">
        <h2 class="section-title">三連複で「当たる」を手にした人の、<br class="sp-br">次の壁。</h2>
        <p class="section-lead">
          Premium Sanrenpuku をお使いのあなたなら、心当たりがあるはずです。
        </p>
      </div>

      <div class="problems">
        <div class="problem">
          <span class="mark">✕</span>
          <div>
            <h3>当たっているのに、手元に残らない</h3>
            <p>三連複は的中しやすい。けれど人気どころで決まった日の配当は、投資額を引くとほとんど残らない。</p>
          </div>
        </div>
        <div class="problem">
          <span class="mark">✕</span>
          <div>
            <h3>「どのレースで勝負するか」は、結局自分で決めている</h3>
            <p>全レース分の買い目は届く。でも、資金をどこに集中させるかという一番難しい判断は、いつもあなたに残されている。</p>
          </div>
        </div>
        <div class="problem">
          <span class="mark">✕</span>
          <div>
            <h3>広く薄く買って、利益が薄まる</h3>
            <p>外したくないから何鞍も買う。当たった配当が、外した分の回収で消えていく。</p>
          </div>
        </div>
      </div>

      <div class="answer">
        <h3>Premium Plus は、その 1 鞍を<span class="accent">こちらが決める</span>商品です。</h3>
        <p>
          全開催を AI が精査し、<strong>資金を集中させる価値がある 1 鞍</strong>だけを抽出。
          式別は三連単フォーメーション — 当たったときの上限を、意図的に外しています。
        </p>
      </div>
    </section>

    <!-- ══ なぜ1鞍（全レースより、この一鞍） ══ -->
    <section class="section">
      <div class="why">
        <h2 class="why-title">全レースより、<span class="accent">この一鞍。</span>それが AI の真価。</h2>
        <p class="why-sub">手を広げない。研ぎ澄ました一鞍に、AI の全力を。</p>
        <p class="why-lead">資金が増えない。それは買い方の問題ではなく、勝負するレースを<b>「絞れていなかった」</b>だけかもしれません。</p>
        <div class="focus-viz">
          <div>
            <div class="fv-dots"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <span class="fv-cap">全レースに分散<br>— 狙いが薄まる</span>
          </div>
          <div class="fv-arrow">→</div>
          <div>
            <div class="fv-one">1</div>
            <span class="fv-cap g">1 鞍に集中<br>— 狙いが鋭くなる</span>
          </div>
        </div>
        <div class="why-cols">
          <p>馬単も、三連複も、買い目は毎日ちゃんと届いていた。それでも全レースをカバーする商品は、宿命的に「広く薄く」なります。獲れる日も、そうでない日も、同じ熱量で買う。勝ちが負けに平均化されていく——それは<b>商品の役割</b>であって、あなたの責任ではありません。</p>
          <p>AI は、全 12 レースに力を分散させるより、<b>いちばん確度の高い 1 鞍</b>にすべてを注いだほうが、狙いは格段に鋭くなります。精度とは、当てにいく場面を<b>「選ぶ」</b>ことでもある。</p>
        </div>
        <p class="why-punch">Premium Plus は、その平均化を捨てた商品です。今日いちばん獲れる 1 鞍だけを抽出し、三連単で上限を外す。<span class="accent">これまでの悔しさを回収するのは、ここから。今度は、三連単に期待していい。</span></p>
      </div>
    </section>

    <!-- ══ 実際の投票内容照会（配信した1鞍を投票内容照会の形で公開） ══ -->
    <section class="section">
      <div class="section-head">
        <h2 class="section-title">配信した 1 鞍を、<span class="accent">投票内容照会</span>で公開。</h2>
        <p class="section-lead">
          買い目は締切前に確定・公開。的中も、不的中も、配信した買い目のまま正直に出します。
        </p>
      </div>

      {ppCards.length === 0 ? (
        <p class="gallery-empty">配信実績を準備中です。近日公開します。</p>
      ) : (
        <div class="pp-cards">
          {ppCards.map((c) => (
            <div class="pp-evi">
              <div class="pp-evi-head">
                <span class="pp-date">{c.jd.short}（{c.jd.wd}）</span>
                <span class={c.circuit === 'chuo' ? 'pp-circuit ch' : 'pp-circuit nk'}>{c.circuit === 'chuo' ? '中央' : '南関'}</span>
                <span class="pp-race">{c.raceLabel}</span>
                {c.raceName && <span class="pp-rname">{c.raceName}</span>}
                <span class="pp-spacer"></span>
                <span class="pp-badge bet">三連単F・{c.points}点</span>
                {c.isHit
                  ? <span class="pp-badge hit">✅ 的中 {formatYen(c.payout)}</span>
                  : <span class="pp-badge miss">× 不的中</span>}
              </div>
              <div class="pp-evi-body">
                <div class="pp-left">
                  <div>
                    <div class="pp-flabel">配信した買い目</div>
                    <div class="pp-form">
                      <div class="pp-fcol"><div class="pp-ch">1着</div><div class="pp-chips"><span class={c.isHit ? 'pp-num axis win' : 'pp-num axis'}>{c.first[0]}</span></div></div>
                      <div class="pp-arrow">→</div>
                      <div class="pp-fcol">
                        <div class="pp-ch">2着</div>
                        <div class="pp-chips">{c.second.map((n) => <span class={c.isHit && n === c.w2 ? 'pp-num win' : 'pp-num'}>{n}</span>)}</div>
                        <div class="pp-ch" style="margin-top:.5rem">3着</div>
                        <div class="pp-chips">{c.third.map((n) => <span class={c.isHit && n === c.w3 ? 'pp-num win' : 'pp-num'}>{n}</span>)}</div>
                      </div>
                    </div>
                  </div>
                  <div class="pp-meta">
                    <div class="pp-mi"><span>投票額</span><b>{formatYen(c.stake)}</b></div>
                    <div class="pp-mi"><span>結果</span><b>{c.isHit ? c.wDisp : '—'}</b></div>
                    <div class="pp-mi"><span>払戻</span><b class={c.isHit ? 'pay' : ''}>{c.isHit ? formatYen(c.payout) : '—'}</b></div>
                  </div>
                </div>
                <div class="pp-right">
                  {c.service === 'spat4' ? (
                    <div class="vref spat">
                      <div class="chrome"></div>
                      <table class="recv"><tbody>
                        {c.receiptNo && <tr><td>受付番号</td><td>{c.receiptNo}</td></tr>}
                        <tr><td>受付日時</td><td>{ppFmtReceiptAt(c.receiptAt, c.jd.spat)}</td></tr>
                        <tr><td>購入件数</td><td>1件</td></tr>
                      </tbody></table>
                      <table class="bet"><tbody>
                        <tr><th>レース/式別</th><th>馬/組番</th><th>投票金額</th></tr>
                        <tr>
                          <td class="c1">{c.jd.spat}<br><span class="race">{c.raceLabel}</span><br>三連単<br>フォーメーション</td>
                          <td class="c2"><b>1着:</b>{c.first.join(', ')}<br><b>2着:</b>{c.second.join(', ')}<br><b>3着:</b>{c.third.join(', ')}</td>
                          {/* 投票内容照会の複製に否定表現は出さない（実物に無い）。的中時だけ 3 行目を足す。
                              判定・文言は PremiumPlusReceiptCardV2.astro / premiumPlusReceiptCardView.js と同一。 */}
                          <td class="c3">(各{c.unitStake.toLocaleString()}円)<br>{c.stake.toLocaleString()}円{c.isHit && <Fragment><br><span class="hit">的中 {c.payout.toLocaleString()}円</span></Fragment>}</td>
                        </tr>
                      </tbody></table>
