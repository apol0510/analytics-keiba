---
export const prerender = false;
/**
 * Premium Plus 旧 URL（/premium-plus/）— 認可付きリダイレクトのみ
 *
 * 経緯（2026-09-08 / MK 判断で v2 へ一本化）:
 * - このページはかつて premium-plus-v2.astro とほぼ同一の商品ページ本体だった。
 *   v2 は「Netlify の functions cache が古い SSR バンドルを再利用し、投票内容照会カードが
 *   旧版のまま残る」drift を避けるために別パス名で作り直したもので、以後 2 枚を
 *   二重管理していた（全ての修正を毎回両方へ当てる必要があり、実際に食い違いも起きた）。
 * - 顧客導線（PremiumPlusCta / dashboard / /api/premium-plus-stage.json の PRODUCT_HREF）は
 *   すべて /premium-plus-v2/ を指しており、この URL を指すリンクは残っていない。
 * - ただし配信済みのキャンペーンメール（campaignCatalog の premium-plus-offer）が
 *   この URL を CTA にしていたため、**削除せずリダイレクトで生かす**。
 *
 * 商品ページ本体は src/pages/premium-plus-v2.astro が唯一の正本。ここに商品の
 * マークアップ・価格・実績・申込導線を**復活させないこと**（二重管理へ逆戻りする）。
 *
 * 存在秘匿（この形にしている理由・変更禁止）:
 * - netlify.toml の静的 301 にはしない。静的リダイレクトは誰にでも 301 を返すため、
 *   「Premium Plus という商品がある」ことを非会員に漏らす（今は 404 で秘匿している）。
 * - よって SSR のまま verifyPlanAccess を通し、**Premium Sanrenpuku 会員のときだけ 301**。
 *   未ログイン / free / light / premium / 期限切れ / Cookie 破損 / 鍵未設定 は
 *   従来どおり 404（fail closed）で、リダイレクト先の存在も知らせない。
 * - 段階公開（PHASE）・販売停止・受付休止の判定はここでは再実装しない。
 *   リダイレクト先の v2 が同じ判定を必ず通すので、結果は従来と同じになる。
 * - 会員かどうかで応答が変わるので CDN 共有は禁止（private, no-store / Vary: Cookie）。
 */
import { verifyPlanAccess, PREMIUM_PLUS_CANDIDATE_PLANS } from '../lib/auth/index.js';

const DENY_HEADERS = {
  'Content-Type': 'text/plain; charset=utf-8',
  'Cache-Control': 'private, no-store',
  'Vary': 'Cookie',
};

const access = await verifyPlanAccess({
  cookieHeader: Astro.request.headers.get('cookie') || '',
  secret: process.env.SESSION_SIGNING_SECRET,
  now: Date.now(),
  allowedPlans: PREMIUM_PLUS_CANDIDATE_PLANS,
});
if (!access.ok) {
  return new Response('Not Found', { status: 404, headers: DENY_HEADERS });
}

// 流入計測（?src=）を落とさずに引き継ぐ。計測の記録自体はリダイレクト先で行う。
const search = Astro.url.search || '';
return new Response(null, {
  status: 301,
  headers: {
    ...DENY_HEADERS,
    Location: `/premium-plus-v2/${search}`,
  },
});
---
