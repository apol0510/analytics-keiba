---
/**
 * `/results` — 南関の月別アーカイブ最新月へ送る。
 *
 * ⚠️ 2026-08-31 まで **404 へ飛ばしていた**（`/archive/2026/08/` は存在しない。
 *    実ページは `/archive/nankan/2026/08/`）。飛び先の決定は
 *    `src/lib/archiveRedirect.mjs` に集約し、`archiveRedirect.test.mjs` が固定する。
 * ⚠️ 当日を表示するページではないため SSR のままでよいが、
 *    リダイレクト先は archive の内容で変わるので prerender にはしない。
 */
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { resolveArchiveRedirect } from '../lib/archiveRedirect.mjs';

let archive = null;
try {
  const archivePath = join(process.cwd(), 'src', 'data', 'archiveResults.json');
  if (existsSync(archivePath)) archive = JSON.parse(readFileSync(archivePath, 'utf-8'));
} catch {
  // 読めない/壊れている場合は archive=null のままにし、索引へ落とす（存在しない月を作らない）
  archive = null;
}

return Astro.redirect(resolveArchiveRedirect(archive, 'nankan'));
---
