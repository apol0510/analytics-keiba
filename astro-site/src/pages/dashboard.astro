        /* VIPステータスカード */
        /* 取得済みクーポン（マイページ内のカード。既存カードと同じ角丸・余白・淡い枠に合わせる） */
        .coupon-section { margin: 1.5rem 0 0; }
        .coupon-card {
            background: linear-gradient(135deg, rgba(45, 212, 191, 0.10) 0%, rgba(59, 130, 246, 0.10) 100%);
            border: 1px solid rgba(45, 212, 191, 0.30);
            border-radius: 1rem;
            padding: 1.5rem;
        }
        .coupon-header { display: flex; align-items: center; gap: .6rem; margin-bottom: .9rem; flex-wrap: wrap; }
        .coupon-icon { font-size: 1.4rem; line-height: 1; }
        .coupon-title { font-size: 1.05rem; font-weight: 700; color: #f8fafc; }
        .coupon-badge {
            font-size: .78rem; font-weight: 700; padding: .25rem .7rem; border-radius: 999px;
            background: rgba(16, 185, 129, .18); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, .5);
        }
        .coupon-name { font-size: 1rem; font-weight: 700; color: #e2e8f0; margin: 0 0 .35rem; }
        .coupon-benefit { font-size: 1.45rem; font-weight: 800; color: #6ee7b7; margin: 0 0 .15rem; }
        .coupon-price { font-size: .95rem; color: #cbd5e1; margin: 0 0 1rem; }
        .coupon-kv { display: grid; grid-template-columns: auto 1fr; gap: .45rem 1rem; margin: 0; font-size: .92rem; }
        .coupon-kv dt { color: #94a3b8; font-size: .82rem; white-space: nowrap; }
        .coupon-kv dd { margin: 0; color: #e2e8f0; }
        .coupon-cta {
            display: block; margin-top: 1.1rem; padding: .9rem 1.2rem; border-radius: .7rem;
            background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
            color: #fff; text-decoration: none; font-size: 1rem; font-weight: 800; text-align: center;
        }
        .coupon-cta:hover { filter: brightness(1.1); }
        /*
         * ⚠️ `hidden` を必ず効かせる。
         * `.coupon-cta` は `display: block` を指定しているため、**作者スタイルが
         * UA の `[hidden] { display: none }` を上書きしてしまい**、JS で
         * `el.hidden = true` にしても**空の青いボタンが帯として残る**（2026-08-22 本番で発生）。
         * カード内の要素は hidden なら必ず消す。
         */
        .coupon-card [hidden] { display: none !important; }
        .coupon-wait {
            margin: 1.1rem 0 0; padding: .8rem 1rem; border-radius: .7rem;
            background: rgba(148,163,184,.12); border: 1px solid rgba(148,163,184,.35);
            color: #cbd5e1; font-size: .92rem; font-weight: 700; text-align: center;
        }
        .coupon-note { margin: .5rem 0 0; color: #94a3b8; font-size: .82rem; }
        /* 補助導線（詳細）は主 CTA より控えめに */
        .coupon-link {
            display: inline-block; margin-top: .7rem; padding: .5rem .9rem; border-radius: .6rem;
            background: transparent; border: 1px solid rgba(148, 163, 184, .35);
            color: #cbd5e1; text-decoration: none; font-size: .84rem; font-weight: 600;
        }
        .coupon-link:hover { background: rgba(59, 130, 246, .3); }
        @media (max-width: 768px) {
            .coupon-card { padding: 1.2rem; }
            .coupon-kv { grid-template-columns: 1fr; gap: .2rem; }
            .coupon-kv dt { margin-top: .5rem; }
            .coupon-link { display: block; text-align: center; }
        }

