                    ` + segmentHTML;
                }
            } else {
                // 全目標達成
                segmentHTML = `
                    <div class="segment-item completed-all">
                        <div class="segment-header">
                            <span class="segment-emoji">🎉</span>
                            <span class="segment-title">全目標達成！</span>
