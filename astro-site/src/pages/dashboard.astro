    <!-- 申請・送信履歴の描画 -->
    <script is:inline>
        (function () {
            var TYPE_LABELS = {
                'bank-transfer': '銀行振込',
                'contact': 'お問い合わせ',
                'premium-plus-contact': 'Premium Plus 問合せ',
                'magic-link': 'ログイン',
                'withdrawal': '退会申請',
                'submission': '送信'
            };
            var STATUS_LABELS = {
                'pending': '確認待ち',
                'sent': '送信済み',
                'completed': '完了',
                'failed': '失敗'
            };

            function escapeHtml(str) {
                return String(str == null ? '' : str).replace(/[&<>"']/g, function (c) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
                });
            }

            function formatTimestamp(iso) {
                try {
                    var d = new Date(iso);
                    if (isNaN(d.getTime())) return '';
                    var y = d.getFullYear();
                    var m = String(d.getMonth() + 1).padStart(2, '0');
                    var day = String(d.getDate()).padStart(2, '0');
                    var hh = String(d.getHours()).padStart(2, '0');
                    var mm = String(d.getMinutes()).padStart(2, '0');
                    return y + '/' + m + '/' + day + ' ' + hh + ':' + mm;
                } catch (e) { return ''; }
            }

            function render() {
                var listEl = document.getElementById('submission-history-list');
                if (!listEl) return;
                var SR = window.SubmissionResult;
                var history = SR ? SR.getSubmissionHistory() : [];

                if (!history.length) {
                    listEl.innerHTML = '<div class="submission-history-empty">まだ申請・送信はありません。フォームから送信すると、ここに履歴が表示されます。</div>';
                    return;
                }

                listEl.innerHTML = history.map(function (item) {
                    var typeLabel = TYPE_LABELS[item.type] || item.type || '送信';
                    var statusLabel = STATUS_LABELS[item.status] || item.status || '';
                    var timestamp = formatTimestamp(item.timestamp);
                    return (
                        '<div class="submission-history-item">' +
                            '<span class="submission-history-badge type-' + escapeHtml(item.type || 'submission') + '">' + escapeHtml(typeLabel) + '</span>' +
                            '<div class="submission-history-main">' +
                                '<div class="submission-history-label">' + escapeHtml(item.label || '送信') + '</div>' +
                                '<div class="submission-history-meta">' + escapeHtml(timestamp) + '</div>' +
                            '</div>' +
                            '<span class="submission-history-status status-' + escapeHtml(item.status || 'pending') + '">' + escapeHtml(statusLabel) + '</span>' +
                        '</div>'
                    );
                }).join('');
            }

            function bindClear() {
                var btn = document.getElementById('submission-history-clear');
                if (!btn) return;
                btn.addEventListener('click', function () {
                    if (!confirm('申請・送信履歴をすべて削除しますか？\nサーバーには影響しません（このブラウザの表示のみクリアします）。')) return;
                    if (window.SubmissionResult) window.SubmissionResult.clearSubmissionHistory();
                    render();
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                render();
                bindClear();
                window.addEventListener('storage', function (e) {
                    if (e.key === 'submission-history') render();
                });
            });
        })();
    </script>

    <!-- ポイント交換確認モーダル -->
    <div id="exchangeModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.8); z-index: 10000; align-items: center; justify-content: center;">
        <div style="background: #1e293b; border-radius: 16px; padding: 2rem; max-width: 500px; width: 90%; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);">
            <h3 style="color: #fbbf24; margin-bottom: 1rem; font-size: 1.3rem;">🎁 ポイント交換確認</h3>

            <div style="background: rgba(59, 130, 246, 0.1); border-left: 4px solid #3b82f6; padding: 1rem; margin: 1rem 0; border-radius: 8px;">
                <p style="color: #cbd5e1; margin: 0.5rem 0;"><strong>交換特典:</strong> <span id="modal-reward-name"></span></p>
                <p style="color: #cbd5e1; margin: 0.5rem 0;"><strong>必要ポイント:</strong> <span id="modal-required-points"></span>pt</p>
                <p style="color: #cbd5e1; margin: 0.5rem 0;"><strong>現在のポイント:</strong> <span id="modal-current-points"></span>pt</p>
                <p style="color: #fbbf24; margin: 0.5rem 0; font-weight: 600;"><strong>交換後:</strong> <span id="modal-after-points"></span>pt</p>
            </div>

            <p style="color: #94a3b8; font-size: 0.9rem; line-height: 1.6; margin: 1rem 0;">
                交換申請後、1営業日以内にメールで特典をお送りします。<br>
                ポイントは特典送付時に自動的に減算されます。
