---
export const prerender = true; // 静的サイト生成用に戻す
import BaseLayout from '../layouts/BaseLayout.astro';
import PremiumContactModal from '../components/PremiumContactModal.astro';
---

<BaseLayout title="マイページ">
    <!-- ログイン済みユーザーが「マイページ」を開いたとき、login form が一瞬見えるのを防ぐため、
         インライン script で localStorage を即時判定して loading / login の初期表示を切替える -->
    <script is:inline>
      (function() {
        try {
          var keys = ['user-plan', 'isLoggedIn', 'userPlan', 'user_plan', 'user_email'];
          var loggedIn = keys.some(function(k) {
            var v = localStorage.getItem(k);
            return v && v !== 'false';
          });
          // CSS で初期表示を決めるためのフラグ class を root に付与
          document.documentElement.classList.add(loggedIn ? 'auth-likely-in' : 'auth-likely-out');
        } catch (_) {}
      })();
    </script>

    <div class="dashboard-container">
        <!-- ヘッダー -->
        <div class="dashboard-header">
            <h1>🔑 会員ログイン</h1>
            <p class="subtitle">ご登録済みの会員様専用 - KEIBA Analytics</p>
        </div>

        <!-- 認証中インジケータ（ログイン済みっぽい時に表示） -->
        <div id="auth-loading-section" class="auth-loading-section">
            <div class="auth-loading-card">
                <div class="auth-spinner" aria-hidden="true"></div>
                <h2>認証中...</h2>
                <p>会員情報を読み込んでいます。少々お待ちください。</p>
            </div>
        </div>

        <!-- ログインフォーム（初期表示） -->
        <div id="login-section" class="login-section">
            <div class="login-card">
                <h2>🔐 会員様ログイン</h2>
                <p>ご登録済みのメールアドレスでマイページにアクセスしてください</p>
                <form id="magic-link-form">
                    <input 
                        type="email" 
                        id="email-input" 
                        placeholder="example@email.com"
                        required
                        class="email-input"
                    />
                    <button type="submit" class="submit-btn" id="magic-link-btn">
                        ログイン
                    </button>
                </form>
                <div id="success-message" class="success-message" style="display: none;"></div>
                <div id="error-message" class="error-message" style="display: none;"></div>

                <!-- 新規ユーザー向け案内 -->
                <div class="new-user-notice">
                    <p>🆕 <strong>初めてご利用の方</strong></p>
                    <p>まずは<a href="/free-signup/" class="link">こちらから無料で始める</a>で会員登録をお済ませください。</p>
                </div>
            </div>
        </div>

        <!-- ダッシュボード（ログイン後表示） -->
        <div id="dashboard-section" style="display: none;">
            <!-- 期限切れ警告（期限切れユーザーのみ表示） -->
            <div id="expiry-warning-section" class="expiry-warning-section" style="display: none;">
                <div class="expiry-warning-card">
                    <div class="expiry-warning-icon">⚠️</div>
                    <div class="expiry-warning-content">
                        <h3>プランの有効期限が切れています</h3>
                        <div class="expiry-details">
                            <p>お客様の<strong id="expired-plan-name">プレミアム</strong>プランは、<strong id="expiry-date-display">2025-10-01</strong>に有効期限を迎えました。</p>
                            <p>現在は<strong>無料会員</strong>としてご利用いただけます。</p>
                        </div>
                        <div class="expiry-actions">
                            <div class="expiry-action-card">
                                <h4>🔄 継続をご希望の場合</h4>
                                <p>クレジットカード登録で自動更新（おすすめ）</p>
                                <a href="/pricing/" class="expiry-btn renew">今すぐプランを更新</a>
                            </div>
                            <!-- 🚨 銀行振込のみのため退会ボタン非表示
                            <div class="expiry-action-card secondary">
                                <h4>🚪 退会をご希望の場合</h4>
                                <p>退会処理後も有効期限内はご利用可能</p>
                                <button id="withdrawal-btn-expired" class="expiry-btn withdraw">退会処理へ進む</button>
                            </div>
                            -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- 今回のログイン情報 -->
            <div id="login-info-section" class="login-info-section" style="display: none;">
                <div class="login-info-card">
                    <div class="login-info-icon">🎉</div>
                    <div class="login-info-content">
                        <h3 id="login-info-title">ログイン成功</h3>
                        <div id="login-info-message" class="login-info-message"></div>
                    </div>
                    <button id="login-info-close" class="close-btn">×</button>
                </div>
            </div>

            <!-- 穴馬ページリンク -->
            <div class="dark-horse-link-section">
                <a href="/dark-horse-picks/" class="dark-horse-link-btn">
                    <span class="dark-horse-icon">🐎</span>
                    <div class="dark-horse-text">
                        <span class="dark-horse-title">本日の穴馬抽出ツール</span>
                        <span class="dark-horse-subtitle">AI予想から狙い目の穴馬を自動抽出</span>
                    </div>
                    <span class="dark-horse-arrow">→</span>
                </a>
            </div>

            <!-- 会員ステータス -->
            <div class="status-section">
                <div class="status-grid">
                    <!-- メインステータスカード -->
                    <div class="status-card main-status">
                        <div class="status-header">
                            <div class="status-icon" id="main-status-icon">👤</div>
                            <div class="status-badge" id="status-badge">読み込み中</div>
                        </div>
                        <div class="status-info">
                            <h3>会員ステータス</h3>
                            <div id="membership-status" class="status-value">読み込み中...</div>
                            <div id="membership-details" class="status-details"></div>
                            <!-- 有料会員のアカウント操作（ログアウト）: 会員情報の下・右寄せ・控えめ -->
                            <div id="logout-section-paid" class="account-actions" style="display: none;">
                                <button id="logout-btn-paid" class="account-logout-btn" type="button">ログアウト</button>
                            </div>
                        </div>
                        <!-- 三連複追加ボタン -->
                        <div class="plan-change-section" id="plan-change-section" style="display: none;">
                            <button class="plan-change-btn" id="plan-change-btn">
                                <span class="btn-icon">➕</span>
                                <span class="btn-text">三連複を追加</span>
                            </button>
                        </div>
                        <!-- Premium Plus 導線（UpsellTarget=plus / auto かつ Plus 販売対象のときだけ）。
                             三連複ブロックとは排他。商品名・価格は書かない（存在秘匿は SSR 側が担当）。 -->
                        <div class="plan-change-section" id="plus-upsell-section" style="display: none;">
                            <a class="plan-change-btn" id="plus-upsell-btn" href="/premium-plus-v2/">
                                <span class="btn-icon">✨</span>
                                <span class="btn-text">会員限定のご案内を見る</span>
                            </a>
                        </div>
                    </div>



                    <!-- VIP情報カード（Premiumのみ） -->
                    <div class="vip-status-card" id="vip-status-card" style="display: none;">
                        <div class="vip-header">
                            <div class="vip-icon">👑</div>
                            <div class="vip-title">PREMIUM会員特典</div>
                        </div>
                        <div class="vip-benefits" id="vip-benefits">
                            <div class="vip-benefit">✨ 優先サポート</div>
                            <div class="vip-benefit">🏆 限定コンテンツ</div>
                            <div class="vip-benefit" style="display: none;">💰 ボーナスポイント</div>
                        </div>
                    </div>
                    
                    <!-- プラン特典カード（Standard/Free用） -->
                    <div class="plan-benefits-card" id="plan-benefits-card" style="display: none;">
                        <div class="plan-header">
                            <div class="plan-icon" id="plan-icon">🎁</div>
                            <div class="plan-title" id="plan-title">プラン特典</div>
                        </div>
                        <div class="plan-benefits" id="plan-benefits">
                            <div class="plan-benefit">🏇 メインレース馬単買い目</div>
                        </div>
                    </div>
                    
                </div>
            </div>

            <!-- 取得済みクーポン（本人が取得済みのときだけ表示）。
                 判定・文言・条件はサーバーの単一源（/api/upsell.json → premiumPlusReopenCoupon.js）が返す。
                 ⚠️ dashboard 側で条件文・価格・割引率を組み立てないこと。
                 未取得ならこのカードごと出さない（既定 display:none）。 -->
            <div class="coupon-section" id="reopen-coupon-section" style="display: none;">
                <div class="coupon-card">
                    <div class="coupon-header">
                        <div class="coupon-icon">🎟</div>
                        <div class="coupon-title">取得済みクーポン</div>
                        <div class="coupon-badge">取得済み</div>
                    </div>
                    <div class="coupon-name" id="reopen-coupon-name"></div>
                    <div class="coupon-benefit" id="reopen-coupon-discount"></div>
                    <div class="coupon-price" id="reopen-coupon-price"></div>
                    <dl class="coupon-kv">
                        <dt>取得日時</dt><dd id="reopen-coupon-claimed-at"></dd>
                        <dt>ご利用時期</dt><dd id="reopen-coupon-usable"></dd>
                        <dt>有効期限</dt><dd id="reopen-coupon-expiry"></dd>
                    </dl>
                    <!-- 主 CTA = 申込導線。販売停止中は押せるリンクにせず、状態表示だけにする -->
                    <!-- ⚠️ href="#" を初期値にしない。BaseLayout が読み込み時に
                         a[href^="#"] へスムーススクロール（preventDefault）を仕込むため、
                         あとから href を差し替えても**クリックで遷移しなくなる**。
                         href は表示時に JS で設定する。 -->
                    <a class="coupon-cta" id="reopen-coupon-cta" hidden></a>
                    <p class="coupon-wait" id="reopen-coupon-wait" hidden></p>
                    <p class="coupon-note" id="reopen-coupon-note" hidden></p>
                    <!-- 補助導線 -->
                    <a class="coupon-link" id="reopen-coupon-link" href="/premium-plus-coupon/">クーポン詳細を確認</a>
                </div>
            </div>

            <!-- 今日の予想 -->
            <div class="predictions-section">
                <h2>🏇 今日の予想</h2>
                <div class="predictions-grid">

                    <!-- 無料予想（南関） -->
                    <div id="free-predictions" class="prediction-card free">
                        <div class="card-header">
                            <h3>🎁 無料予想 <span class="method-badge">南関</span></h3>
                        </div>
                        <div class="race-info">
                            <div class="race-title race-title-sm">全レース（無料）</div>
                            <div class="confidence">AI分析完了！</div>
                        </div>
                        <a href="/free-prediction/nankan/" class="view-btn">予想を見る</a>
                    </div>

                    <!-- 無料予想（中央／JRA） -->
                    <div id="free-predictions-jra" class="prediction-card free">
                        <div class="card-header">
                            <h3>🎁 無料予想 <span class="method-badge">中央</span></h3>
                        </div>
                        <div class="race-info">
                            <div class="race-title race-title-sm">JRA 全レース（無料）</div>
                            <div class="confidence">AI分析完了！</div>
                        </div>
                        <a href="/free-prediction/jra/" class="view-btn">予想を見る</a>
                    </div>

                    <!-- Light予想（南関） -->
                    <div id="standard-predictions" class="prediction-card standard" style="display: none;">
                        <div class="card-header">
                            <h3>⚡ Light予想 <span class="method-badge">南関</span></h3>
                        </div>
                        <div class="race-info">
                            <div class="race-title race-title-sm">メインレース馬単買い目</div>
                            <div class="confidence">AI分析完了！</div>
                        </div>
                        <a href="/light-predictions/" class="view-btn">予想を見る</a>
                    </div>

                    <!-- Light予想（中央／JRA） -->
                    <div id="standard-predictions-jra" class="prediction-card standard" style="display: none;">
                        <div class="card-header">
                            <h3>⚡ Light予想 <span class="method-badge">中央</span></h3>
                        </div>
                        <div class="race-info">
                            <div class="race-title race-title-sm">JRA メインレース馬単買い目</div>
                            <div class="confidence">AI分析完了！</div>
                        </div>
                        <a href="/light-predictions-jra/" class="view-btn">予想を見る</a>
                    </div>

                    <!-- Premium馬単予想（中央・南関）統合カード -->
                    <div id="premium-predictions" class="prediction-card premium" style="display: none;">
                        <div class="card-header">
                            <h3>💎 Premium馬単予想 <span class="method-badge">中央・南関対応</span></h3>
                        </div>
                        <div class="race-info">
                            <div class="race-title race-title-sm">全レース（1R-12R）</div>
                            <div class="confidence">AI分析完了！</div>
                        </div>
                        <div class="sanrenpuku-view-buttons">
                            <a href="/premium-prediction/nankan/" class="view-btn">南関 馬単を見る</a>
                            <a href="/premium-prediction/jra/" class="view-btn">中央 馬単を見る</a>
                        </div>
                    </div>

                    <!-- Premium予想（契約期間終了）: 期限切れ時に上のカードの代わりに表示。予想リンクは出さない。 -->
                    <div id="premium-predictions-expired" class="prediction-card premium" style="display: none;">
                        <div class="card-header">
                            <h3>💎 Premium予想</h3>
                        </div>
                        <div class="race-info">
                            <div class="race-title race-title-sm">契約期間が終了しました</div>
                            <div class="confidence">再契約後、Premium予想をご利用いただけます</div>
                        </div>
                        <div class="sanrenpuku-view-buttons">
                            <a href="/pricing/" class="view-btn">再契約はこちら</a>
                        </div>
                    </div>

                    <!-- Premium Sanrenpuku予想（Premium Sanrenpuku/Combo会員専用・中央/南関セット利用導線） -->
                    <div id="sanrenpuku-predictions" class="prediction-card sanrenpuku" style="display: none;">
                        <div class="card-header">
                            <h3>💎 Premium三連複予想 <span class="method-badge">中央・南関対応 AI絞り込み</span></h3>
                        </div>
                        <div class="race-info">
                            <div class="race-title race-title-sm">全レース（1R-12R）</div>
                            <div class="confidence">AI分析完了！</div>
                        </div>
                        <div class="sanrenpuku-view-buttons">
                            <a href="/premium-sanrenpuku/" class="view-btn primary">南関 三連複を見る</a>
                            <a href="/premium-sanrenpuku-jra/" class="view-btn primary">中央 三連複を見る</a>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ポイントカード -->
            <div class="points-section" style="display: none;">
                <div class="points-card">
                    <div class="points-header">
                        <h2>💰 保有ポイント</h2>
                        <div class="points-value">
                            <span id="current-points">0</span>
                            <span class="points-unit">pt</span>
                        </div>
                    </div>
                    <div class="points-progress">
                        <!-- 🎯 シンプルプログレス表示（復活防止対策） -->
                        <div class="simple-progress-container">
                            <div id="simple-progress-display">
                                <div class="progress-info-row">
                                    <span class="progress-current">💰 使用可能: <span id="current-points-simple">0</span>pt</span>
                                    <span class="progress-target">🎯 次の目標: <span id="target-points-simple">1000</span>pt</span>
                                </div>
                                <div class="progress-remaining">
                                    あと<span id="remaining-points-simple">1000</span>ptで次の目標達成！
                                </div>
                                <div class="simple-progress-bar">
                                    <div class="simple-progress-fill" id="simple-progress-fill" style="width: 0%;"></div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- ポイント交換メニュー -->
            <div class="exchange-section" style="display: none;">
                <div class="exchange-card">
                    <div class="exchange-header">
                        <h2>🎁 ポイント交換</h2>
                        <p class="exchange-subtitle">ポイントを特典と交換できます</p>
                    </div>
                    
                    <div class="exchange-grid">
                        <!-- 1000pt特典 -->
                        <div class="exchange-option clickable-card" data-points="1000" data-reward="AI解析による隠れ上昇馬情報">
                            <div class="exchange-cost">1000pt</div>
                            <div class="exchange-reward">AI解析による隠れ上昇馬情報</div>
                            <div class="exchange-action">交換申請する →</div>
                        </div>

                        <!-- 2000pt特典 -->
                        <div class="exchange-option premium-option clickable-card" data-points="2000" data-reward="AI解析による急上昇 激走穴馬情報">
                            <div class="exchange-cost">2000pt</div>
                            <div class="exchange-reward">AI解析による急上昇 激走穴馬情報</div>
                            <div class="exchange-action">交換申請する →</div>
                        </div>

                        <!-- 3000pt特典 -->
                        <div class="exchange-option orange-option clickable-card" data-points="3000" data-reward="厩舎の発射タイミング予測による激走穴馬情報">
                            <div class="exchange-cost">3000pt</div>
                            <div class="exchange-reward">厩舎の発射タイミング予測による激走穴馬情報</div>
                            <div class="exchange-action">交換申請する →</div>
                        </div>

                    </div>
                    
                    <div class="exchange-note">
                        <small>※ 交換申請後、管理者が確認後に特典を提供いたします。</small>
                    </div>
                </div>
            </div>

            <!-- プラン管理（無料会員のみ表示） -->
            <div id="plan-section" class="plan-section" style="display: none;">
                <h2>📋 プラン管理</h2>
                <div class="plan-actions">
                    <a href="/pricing/" class="action-btn upgrade">プランをアップグレード</a>
                    <button id="logout-btn-free" class="action-btn logout">ログアウト</button>
                </div>
            </div>

            <!-- アップグレード促進（無料・Standard会員のみ表示） -->
            <div id="upgrade-promotion" class="upgrade-section" style="display: none;">
                <div class="upgrade-card">
                    <h3>🚀 さらなる投資効率を目指しませんか？</h3>
                    <p>上位プランで全レースの詳細予想と高精度分析データによる買い目にアクセスできます</p>
                    <a href="/pricing/" class="upgrade-btn">今すぐアップグレード</a>
                </div>
            </div>

            <!-- 有料会員お問い合わせ（初期非表示・有料会員のときだけ JS で表示。無料会員は /contact/ を使用） -->
            <PremiumContactModal hidden={true} />
        </div>

        <!-- 申請・送信履歴（ログイン状態に関わらず表示） -->
        <div id="submission-history-section" class="submission-history-section">
            <div class="submission-history-card">
                <div class="submission-history-header">
                    <h2>📜 申請・送信履歴</h2>
                    <p class="submission-history-subtitle">このブラウザから送信した申請・お問い合わせの記録です（最大50件・端末ごとに保存されます）</p>
                </div>
                <div id="submission-history-list" class="submission-history-list">
                    <!-- JS で描画 -->
                </div>
                <div class="submission-history-actions">
                    <button id="submission-history-clear" class="submission-history-clear" type="button">履歴をクリア</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 簡略化された認証システム -->
    <script>
        // 権限判定の単一源（共通 resolver）。カード/CTA の表示可否は必ずこれ経由で決める。
        import { resolveClientView, persistLifetimeForUser, persistNameForUser } from '../lib/entitlements/resolveEntitlements.js';

        // localStorage の user-plan + 補助フラグから、共通 resolver で表示可否を得る。
        // 同じ判定式を dashboard 内へ再実装しないための唯一の入口。
        function getClientView() {
            return resolveClientView(
                localStorage.getItem('user-plan'),
                {
                    isExpired: localStorage.getItem('isExpired'),
                    validUntil: localStorage.getItem('validUntil'),
                    isWithdrawalRequested: localStorage.getItem('isWithdrawalRequested'),
                },
            );
        }

        // ログアウト/強制ログアウトで消すべき localStorage キーの単一源。
        // 前ユーザーの権限・期限・三連複永久権が次ユーザーへ残らないよう、両経路でこれを使う（削除漏れ防止）。
        const AUTH_LOCALSTORAGE_KEYS = [
            'user-plan', 'user_plan', 'isLoggedIn', 'userPlan', 'userData', 'userEmail',
            'hasClaimedReward', 'validUntil', 'isExpired', 'isWithdrawalRequested',
            'originalPlan', 'expiryDate', 'loginInfo',
        ];
        function clearAuthLocalStorage() {
            AUTH_LOCALSTORAGE_KEYS.forEach((k) => localStorage.removeItem(k));
        }

        // 簡略化されたセッション管理
        function isAuthenticated() {
            const userPlanData = localStorage.getItem('user-plan');
            const isLoggedIn = localStorage.getItem('isLoggedIn') === 'true';
            const userPlan = localStorage.getItem('userPlan');
            const userPlanUnderscore = localStorage.getItem('user_plan'); // アンダースコア版追加
            const userEmail = localStorage.getItem('user_email'); // メールアドレスチェック追加

            return !!(userPlanData || isLoggedIn || userPlan || userPlanUnderscore || userEmail);
        }
        
        async function getCustomerData() {
            console.log('🔍 getCustomerData 開始');

            // 新しい決済システムのデータを最優先
            const userPlanData = localStorage.getItem('user-plan');
            console.log('📦 user-plan データ:', userPlanData);

