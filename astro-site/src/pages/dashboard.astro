            const button = document.getElementById('magic-link-btn');
            
            button.disabled = true;
            button.innerHTML = '<span class="inline-spinner" aria-hidden="true"></span>認証中...';
            
            try {
                // Netlify Functions経由でAirtableから正確なプラン情報を取得（エラーハンドリング強化）
                let response;
                let data;
                
                try {
                    // 開発環境では直接Functions サーバーを呼び出す
                    const functionsUrl = window.location.hostname === 'localhost' 
                        ? 'http://localhost:8888/.netlify/functions/auth-user'
                        : '/.netlify/functions/auth-user';
                    
                    response = await fetch(functionsUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ email: email })
                    });
                    
                    if (!response.ok) {
                        // レスポンステキストを取得してログ出力
                        const errorText = await response.text();
                        console.error('🚨 Response error text:', errorText);

                        // 🔧 2026-03-02追加: 401エラー（未登録ユーザー）の場合は /free-signup/ にリダイレクト
                        if (response.status === 401) {
                            try {
                                const errorData = JSON.parse(errorText);
                                if (errorData.redirectTo) {
                                    showError((errorData.error || '') + '\n' + (errorData.message || ''));
                                    setTimeout(() => {
                                        window.location.href = errorData.redirectTo;
                                    }, 3000);
                                    return;
                                }
                            } catch (e) {
                                // JSON解析失敗時はそのままエラーを投げる
                            }
                        }

                        // 🔒 PR-B: 403（退会/停止/期限切れ/判定不能）は即時ログインさせない
                        if (response.status === 403) {
                            try {
                                const denyData = JSON.parse(errorText);
                                showError(denyData.message || 'このアカウントではログインできません。');
                            } catch (e) {
                                showError('このアカウントではログインできません。');
                            }
                            return;
                        }

                        throw new Error(`Functions error: ${response.status} - ${errorText}`);
                    }

                    data = await response.json();
                } catch (fetchError) {
                    console.error('Functions呼び出しエラー:', fetchError);
                    console.error('エラー詳細:', {
                        message: fetchError.message,
                        stack: fetchError.stack,
                        response: response ? {
                            status: response.status,
                            statusText: response.statusText,
                            url: response.url
                        } : null
                    });
                    
                    // 具体的なエラーメッセージを表示
                    throw new Error(`認証API接続エラー: ${fetchError.message}`);
                }
                
                // 🚨 2026-02-28追加: 強制ログアウトチェック
                if (data.forceLogout) {
                    console.log('🚨 強制ログアウト検出');
                    // LocalStorage を全キー削除（権限・期限・三連複永久権の残存を防ぐ・logout と同一）
                    clearAuthLocalStorage();

                    showError('プランが更新されました。再度ログインしてください。');
                    return;
                }

                // 🔒 PR-B: 有料会員は即時ログイン不可 → マジックリンクを送信
                // 送信失敗（HTTP 5xx / 通信断 / SendGrid 失敗）は成功表示せず、必ずエラーを出す。
                if (data.requiresMagicLink) {
                    let sendRes;
                    try {
                        const sendUrl = window.location.hostname === 'localhost'
                            ? 'http://localhost:8888/.netlify/functions/send-magic-link'
                            : '/.netlify/functions/send-magic-link';
