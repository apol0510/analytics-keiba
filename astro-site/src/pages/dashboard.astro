    <script is:inline>
        // 退会セクション表示（ダッシュボード表示時に自動表示）
        const observer = new MutationObserver(function() {
            const dashboardSection = document.getElementById('dashboard-section');
            const withdrawalSection = document.getElementById('withdrawal-section');

            if (dashboardSection && withdrawalSection) {
                const dashboardVisible = dashboardSection.style.display !== 'none';
                if (dashboardVisible) {
                    withdrawalSection.style.display = 'block';
                }
            }
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['style']
        });

        // 初回チェック
        setTimeout(function() {
            const dashboardSection = document.getElementById('dashboard-section');
            const withdrawalSection = document.getElementById('withdrawal-section');
            if (dashboardSection && withdrawalSection && dashboardSection.style.display !== 'none') {
                withdrawalSection.style.display = 'block';
            }
        }, 500);
    </script>

    <script is:inline>
        // 退会モーダル制御
        const modal = document.getElementById('withdrawalModal');
        const withdrawalBtn = document.getElementById('withdrawal-btn');
        const confirmBtn = document.getElementById('confirmWithdrawal');
        const cancelBtn = document.getElementById('cancelWithdrawal');
        const reasonTextarea = document.getElementById('withdrawalReason');

        // 退会ボタンクリック（プラン判定付き）
        if (withdrawalBtn) {
            withdrawalBtn.addEventListener('click', function() {
                const userPlan = localStorage.getItem('userPlan') || '';

                // 無料会員はモーダル表示、有料会員はwithdrawal-upsellへ遷移
                if (userPlan.toLowerCase() === 'free') {
                    modal.style.display = 'flex';
                } else {
                    window.location.href = '/withdrawal-upsell/';
                }
            });
        }

        // キャンセルボタンでモーダルを閉じる
        cancelBtn.addEventListener('click', function() {
            modal.style.display = 'none';
        });

        // 退会確定処理
        confirmBtn.addEventListener('click', async function() {
            const reason = reasonTextarea.value || '理由未記入';
            const email = localStorage.getItem('userEmail') || '';

            if (!email) {
                alert('メールアドレスが取得できませんでした。再度ログインしてください。');
                return;
            }

            // ボタンを無効化
            confirmBtn.disabled = true;
            confirmBtn.textContent = '処理中...';

            try {
                // 退会処理APIを呼び出し
                const response = await fetch('/.netlify/functions/process-withdrawal', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        email: email,
                        reason: reason
                    })
                });

                const result = await response.json();

                if (response.ok) {
                    // 成功時: 完了メッセージ表示後トップページへ
                    alert('退会申請を受け付けました。確認メールをお送りしましたのでご確認ください。');
                    window.location.href = '/';
                } else {
                    throw new Error(result.error || '退会申請の送信に失敗しました');
                }
            } catch (error) {
                alert(`エラーが発生しました: ${error.message}\n\nお手数ですが、お問い合わせフォームからご連絡ください。`);
                confirmBtn.disabled = false;
                confirmBtn.textContent = '退会する';
            }
        });

        // モーダル外クリックで閉じる
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                modal.style.display = 'none';
            }
        });
    </script>

    <script is:inline>
        // ポイント交換申請システム（2025-10-22更新）
        let currentExchangeData = null;

        // ページ読み込み時にイベントリスナー設定
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🔧 ポイント交換システム初期化開始');

            const exchangeModal = document.getElementById('exchangeModal');
            const cancelBtn = document.getElementById('exchange-cancel-btn');
            const confirmBtn = document.getElementById('exchange-confirm-btn');

            // 全てのポイント交換カードにイベントリスナーを追加
            const exchangeCards = document.querySelectorAll('.exchange-option.clickable-card');
            console.log(`✅ 交換カード検出: ${exchangeCards.length}個`);

            exchangeCards.forEach((card, index) => {
                card.addEventListener('click', async function() {
                    console.log(`🎯 カード${index + 1}クリック検出`);

                    const requiredPoints = parseInt(card.dataset.points);
                    const rewardName = card.dataset.reward;

                    console.log(`📊 必要ポイント: ${requiredPoints}pt, 特典: ${rewardName}`);

                    try {
                        // 既存のgetCustomerData()関数を使用（グローバルスコープから）
                        const userData = await window.getCustomerData();

                        if (!userData || !userData.email) {
                            alert('ログインが必要です。再度ログインしてください。');
                            window.location.href = '/';
                            return;
                        }

                        const currentPoints = userData.points || 0;
                        console.log(`💰 現在のポイント: ${currentPoints}pt`);

                        // ポイント不足チェック
                        if (currentPoints < requiredPoints) {
                            alert(`ポイントが不足しています。\n\n必要: ${requiredPoints}pt\n現在: ${currentPoints}pt\n不足: ${requiredPoints - currentPoints}pt`);
                            return;
                        }

                        // 交換データ保存
                        currentExchangeData = {
                            userEmail: userData.email,
                            userName: userData.name || '',
                            userPlan: userData.plan || 'Free',
                            currentPoints: currentPoints,
                            requiredPoints: requiredPoints,
                            rewardName: rewardName
                        };

                        // モーダルに情報表示
                        document.getElementById('modal-reward-name').textContent = rewardName;
                        document.getElementById('modal-required-points').textContent = requiredPoints;
                        document.getElementById('modal-current-points').textContent = currentPoints;
                        document.getElementById('modal-after-points').textContent = currentPoints - requiredPoints;

                        // モーダル表示
                        console.log('📋 モーダル表示');
                        exchangeModal.style.display = 'flex';
                    } catch (error) {
                        console.error('❌ エラー:', error);
                        alert('エラーが発生しました。再度お試しください。');
                    }
                });
            });

            // キャンセルボタン
            cancelBtn.addEventListener('click', function() {
                exchangeModal.style.display = 'none';
                currentExchangeData = null;
            });

            // 交換申請ボタン
            confirmBtn.addEventListener('click', async function() {
                if (!currentExchangeData) return;

                // ボタン無効化
                confirmBtn.disabled = true;
                confirmBtn.textContent = '申請中...';

                try {
                    // Netlify Functionに送信
                    const response = await fetch('/.netlify/functions/point-exchange', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(currentExchangeData)
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        // 成功時
                        exchangeModal.style.display = 'none';
                        alert(`✅ ${result.message}\n\n特典情報はメールでお送りしますので、しばらくお待ちください。`);

                        // ページリロード（ポイント表示更新のため）
                        setTimeout(() => {
                            location.reload();
                        }, 1000);
                    } else {
                        throw new Error(result.error || result.message || '申請に失敗しました');
                    }
                } catch (error) {
                    console.error('❌ ポイント交換エラー:', error);
                    alert(`エラーが発生しました: ${error.message}\n\nお手数ですが、お問い合わせフォームからご連絡ください。`);
                    confirmBtn.disabled = false;
                    confirmBtn.textContent = '交換申請する';
                }
            });

            // モーダル外クリックで閉じる
            exchangeModal.addEventListener('click', function(e) {
                if (e.target === exchangeModal) {
                    exchangeModal.style.display = 'none';
                    currentExchangeData = null;
                }
            });
        });
    </script>

