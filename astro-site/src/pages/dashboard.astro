        <!-- 銀行振込申し込みフォーム -->
        <div class="bank-form-section">
          <div class="bank-form-title">💳 銀行振込完了フォーム</div>

          <form id="bankTransferForm" class="bank-form">
            <div class="form-group">
              <label for="fullName" class="form-label">お名前 <span class="required">*</span></label>
              <input type="text" id="fullName" name="fullName" class="form-input" required placeholder="山田 太郎">
            </div>

            <div class="form-group">
              <label for="email" class="form-label">メールアドレス <span class="required">*</span></label>
              <input type="email" id="email" name="email" class="form-input" required placeholder="example@email.com">
            </div>

            
            <div class="form-group">
                <label for="transferDate" class="form-label">振込完了日 <span class="required">*</span></label>
                <input type="date" id="transferDate" name="transferDate" class="form-input" required>
              </div>


            <div class="form-group">
              <label for="transferAmount" class="form-label">振込金額 <span class="required">*</span></label>
              <input type="number" id="transferAmount" name="transferAmount" class="form-input" required readonly>
            </div>

            <div class="form-group">

            <div class="form-group">
              <label for="remarks" class="form-label">備考・ご要望</label>
              <textarea id="remarks" name="remarks" class="form-input" rows="3" placeholder="何かご要望がありましたらご記入ください（任意）"></textarea>
            </div>

            <div class="form-group" style="margin: 16px 0;">
              <label style="display:flex; align-items:flex-start; gap:8px; cursor:pointer; font-size:0.9rem; line-height:1.5; text-align:left;">
                <input type="checkbox" id="paymentCompletedConfirm" name="paymentCompletedConfirm" required style="margin-top:3px; flex-shrink:0;">
                <span>銀行振込を完了済みです。このフォームは入金後の報告専用であることを確認しました。<span style="color:#ef4444;">*</span></span>
              </label>
            </div>

            <button type="submit" class="form-submit-button" id="submitButton">
              <span class="submit-text">📨 申し込みを送信</span>
              <span class="submit-loading" style="display: none;">送信中...</span>
            </button>

            <div class="form-message" id="formMessage" style="display: none;"></div>
          </form>
        </div>

        <div class="bank-warning">
          <div class="bank-warning-title">⚠️ ご注意事項</div>
          <div class="bank-warning-text">
            ・振込手数料はお客様負担となります<br>
            ・土日祝日の場合、確認が翌営業日となる場合がございます<br>
            ・<strong>お名前と同じ名義で振込をお願いします</strong><br>
            ・名義が異なる場合は、備考欄にその旨をご記入ください<br>
            ・購入後のキャンセル・返金は承っておりません
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      let currentPlan = '';
      let currentAmount = 0;
      let currentPlanType = 'monthly';

      function openBankModal(planName, amount, planType = 'monthly') {
        // プラン選択モーダルを閉じる
        const premiumModal = document.getElementById('premiumPlanModal');
        const standardModal = document.getElementById('standardPlanModal');
        if (premiumModal) premiumModal.style.display = 'none';
        if (standardModal) standardModal.style.display = 'none';

        currentPlan = planName;
        currentAmount = amount;
        currentPlanType = planType;

        let periodText = '';
        if (planType === 'lifetime') {
          periodText = '（永久アクセス）';
        } else if (planType === 'annual') {
          periodText = '/年';
        } else {
          periodText = '/月';
        }

        document.getElementById('modalPlanInfo').textContent = `プラン: ${planName} (¥${amount.toLocaleString()}${periodText})`;
        document.getElementById('modalAmount').textContent = `¥${amount.toLocaleString()}`;
        document.getElementById('transferAmount').value = amount;
        document.getElementById('bankModal').classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeBankModal() {
        document.getElementById('bankModal').classList.remove('active');
        document.body.style.overflow = 'auto';
      }

      function copyToClipboard(text) {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();

        try {
          document.execCommand('copy');
          alert('コピーしました: ' + text);
        } catch (err) {
          console.error('コピーに失敗しました:', err);
        }

        document.body.removeChild(textarea);
      }

      // DOMContentLoaded後にフォーム処理を登録
      document.addEventListener('DOMContentLoaded', () => {
        // モーダル外クリックで閉じる
        document.addEventListener('click', (e) => {
          const bankModal = document.getElementById('bankModal');
          if (e.target === bankModal) {
            closeBankModal();
          }
        });

        // Escapeキーで閉じる
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeBankModal();
          }
        });

        // 銀行振込フォーム送信処理
        const bankTransferForm = document.getElementById('bankTransferForm');
        if (bankTransferForm) {
          bankTransferForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            const paymentCompletedCheckbox = document.getElementById('paymentCompletedConfirm');
            if (!paymentCompletedCheckbox || !paymentCompletedCheckbox.checked) {
              const fm = document.getElementById('formMessage');
              if (fm) { fm.textContent = '⚠️ 銀行振込完了後にチェックを入れてから送信してください。'; fm.className = 'form-message error'; fm.style.display = 'block'; }
              return;
            }

            const submitButton = document.getElementById('submitButton');
            const submitText = submitButton.querySelector('.submit-text');
            const submitLoading = submitButton.querySelector('.submit-loading');
            const formMessage = document.getElementById('formMessage');

            submitButton.disabled = true;
            submitText.style.display = 'none';
            submitLoading.style.display = 'inline';
            formMessage.style.display = 'none';

            let periodText = '';
            if (currentPlanType === 'lifetime') {
              periodText = '（永久アクセス）';
            } else if (currentPlanType === 'annual') {
              periodText = '/年';
            } else {
              periodText = '/月';
            }

            const formData = {
              fullName: document.getElementById('fullName').value,
              email: document.getElementById('email').value,
              transferDate: document.getElementById('transferDate').value,
              transferTime: "00:00",  // デフォルト値
              transferAmount: document.getElementById('transferAmount').value,
              transferName: document.getElementById('fullName').value,  // お名前と同じ
              remarks: document.getElementById('remarks').value,
              productName: `${currentPlan} (¥${currentAmount.toLocaleString()}${periodText})`,
              paymentCompletedConfirm: document.getElementById('paymentCompletedConfirm').checked,
              timestamp: new Date().toISOString()
            };

            try {
              const response = await fetch('/.netlify/functions/bank-transfer-application', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
              });

              const result = await response.json();

              if (result.success) {
                formMessage.textContent = '✅ お申し込みを受け付けました。確認メールをお送りしましたのでご確認ください。';
                formMessage.className = 'form-message success';
                formMessage.style.display = 'block';

                document.getElementById('bankTransferForm').reset();

                setTimeout(() => {
                  closeBankModal();
                  formMessage.style.display = 'none';
                }, 3000);
              } else {
                throw new Error(result.error || '送信に失敗しました');
              }
            } catch (error) {
              console.error('送信エラー:', error);
              formMessage.textContent = '❌ 送信に失敗しました。時間をおいて再度お試しください。';
              formMessage.className = 'form-message error';
              formMessage.style.display = 'block';
            } finally {
              submitButton.disabled = false;
              submitText.style.display = 'inline';
              submitLoading.style.display = 'none';
            }
          });
        }
      });
    </script>

    <!-- 販売導線（三連複 / Premium Plus / なし）の取得。判定はサーバー側の単一源。
         取得できないとき（未ログイン・API 不在）は 'unknown' のままで従来動作を維持する。 -->
    <script>
      import { getUpsellDecision, getReopenCoupon } from '../lib/upsell/upsellClient.js';
      import { installPlusFunnel } from '../lib/premiumPlus/premiumPlusFunnelClient.js';
      // 実閲覧の送信本体。導線が出る前に install しておく（先に積まれても取りこぼさない）
      installPlusFunnel(window);
      (async () => {
        const d = await getUpsellDecision();
        window.__akUpsellChannel = d.channel;
        // 会員データ描画より後に確定することがあるので、取得後にもう一度出し分ける
        if (typeof window.applyUpsellSections === 'function') window.applyUpsellSections();
        renderReopenCoupon(await getReopenCoupon());
      })();

      /**
       * 取得済みクーポンのカードを出す（**本人が取得済みのときだけ**）。
       *
       * 判定も文言もサーバーの単一源が返した値をそのまま使う。
       * ここで条件文・価格・割引率を作らない（条件が確定したら単一源だけが変わる）。
       * 未取得・取得失敗・未ログインでは**カードごと出さない**（fail closed）。
       */
      function renderReopenCoupon(c) {
        const sec = document.getElementById('reopen-coupon-section');
        if (!sec) return;
        // 取得済み、または**いま取得できる**ならカードを出す。
        // ⚠️ 取得できるかはサーバーの単一源が決める（販売停止中かどうかでは決めない）。
        if (!c || (c.claimed !== true && c.canClaim !== true)) { sec.style.display = 'none'; return; }
        const canClaim = c.claimed !== true && c.canClaim === true;
        const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v || ''; };
        set('reopen-coupon-name', c.name);
        // 割引・価格・期限は**サーバーの単一源が作った文字列**をそのまま出す
        set('reopen-coupon-discount', c.discountText);
        set('reopen-coupon-price', c.priceText);
        set('reopen-coupon-claimed-at', c.claimedAtText);
        set('reopen-coupon-usable', c.usableNote);
        set('reopen-coupon-expiry', c.expiryText);
        const link = document.getElementById('reopen-coupon-link');
        if (link && c.detailHref) link.setAttribute('href', c.detailHref);

        // 未取得（取得可）のときは見出し・バッジ・取得日時の行を切り替える
        const titleEl = document.querySelector('#reopen-coupon-section .coupon-title');
        const badgeEl = document.querySelector('#reopen-coupon-section .coupon-badge');
        const claimedDt = document.querySelector('#reopen-coupon-section .coupon-kv dt');
        if (titleEl) titleEl.textContent = canClaim ? '受け取れるクーポン' : '取得済みクーポン';
        if (badgeEl) badgeEl.textContent = canClaim ? '未取得' : '取得済み';
        if (claimedDt) claimedDt.textContent = canClaim ? '取得' : '取得日時';
        set('reopen-coupon-claimed-at', canClaim ? 'まだ受け取っていません' : c.claimedAtText);
        if (link) link.textContent = canClaim ? '🎟 クーポンを受け取る' : 'クーポン詳細を確認';
        if (link && canClaim && c.claimHref) link.setAttribute('href', c.claimHref);

        // 主 CTA（申込導線）。**購入できないときはリンクにしない**（押せる CTA を偽装しない）。
        // 文言・遷移先はサーバーの単一源が返した値をそのまま使う。
        const cta = c.cta || {};
        const ctaEl = document.getElementById('reopen-coupon-cta');
        const waitEl = document.getElementById('reopen-coupon-wait');
        const noteEl = document.getElementById('reopen-coupon-note');
        if (ctaEl && waitEl && noteEl) {
            ctaEl.hidden = true; waitEl.hidden = true; noteEl.hidden = true;
            if (canClaim) {
                // 未取得のうちは申込 CTA を出さない（先に受け取ってもらう）
                waitEl.textContent = 'クーポンを受け取ると、お申し込み時に割引が適用されます。';
                waitEl.hidden = false;
            } else if (cta.show === true && cta.purchasable === true && cta.href) {
                ctaEl.textContent = cta.label;
                ctaEl.setAttribute('href', cta.href);
                ctaEl.hidden = false;
            } else if (cta.show === true) {
                waitEl.textContent = cta.label;
                waitEl.hidden = false;
                if (cta.note) { noteEl.textContent = cta.note; noteEl.hidden = false; }
            }
        }
        sec.style.display = '';
      }
    </script>
</BaseLayout>
