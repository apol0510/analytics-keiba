        /**
         * 販売導線の出し分け（三連複 / Premium Plus / なし は排他）。
         * window.__akUpsellChannel は /api/upsell.json の結果（未取得なら 'unknown'）。
         * unknown のときは従来どおり三連複側の既存判定に従う（この機能の障害で導線を止めない）。
         */
        /**
         * Premium Plus 導線の**実閲覧**を積む（送るかどうかは premiumPlusFunnelClient.js が決める）。
         * 判定で「出す」と決めたことと、実際に画面に入って見えたことは別物なので、
         * 要素を渡して「画面に入ったときだけ」表示として数える。
         */
        function recordPlusCtaShown(section) {
            if (!section || section.__akFunnelBound) return;
            section.__akFunnelBound = true;
            const q = (window.__akPpFunnelQueue = window.__akPpFunnelQueue || []);
            // 導線（クリック元）を添える。**値の採否はサーバーの allow-list**が決める。
            // ここはダッシュボードの「会員限定のご案内を見る」なので 'dashboard'。
            q.push({ event: 'cta_view', el: section, source: 'dashboard' });
            const btn = document.getElementById('plus-upsell-btn');
            if (btn) {
                // 商品ページ到達側でも導線が分かるようにする（サーバーが allow-list で検証する）
                const href = btn.getAttribute('href') || '';
                if (href && href.indexOf('from=') < 0) {
                    btn.setAttribute('href', href + (href.indexOf('?') >= 0 ? '&' : '?') + 'from=dashboard');
                }
                btn.addEventListener('click', () => {
                    window.__akPpFunnelQueue.push({ event: 'cta_click', source: 'dashboard' });
                });
            }
        }

        window.applyUpsellSections = applyUpsellSections;
