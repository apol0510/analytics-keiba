        /* ポイント交換メニュー */
        .exchange-section {
            margin-top: 30px;
        }
        
        .exchange-card {
            background: linear-gradient(135deg, #1a202c 0%, #2d3748 100%);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
