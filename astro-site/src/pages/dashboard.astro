        // URLパラメータのトークン処理
        // 🔒 PR-B: メールアドレス文字列からプランを推定する旧ロジックは廃止（危険・禁止）。
        // 有料の本人確認は必ずマジックリンク検証（/auth/verify → verify-magic-link）で行い、
        // 署名済み HttpOnly Cookie ak_session をサーバーが発行する。ここでは token があれば
        // 正規の検証ページへ委譲するだけで、クライアント側で権限を決めない。
        async function handleTokenAuth() {
            const urlParams = new URLSearchParams(window.location.search);
            const token = urlParams.get('token');
            if (token) {
                // 正規のマジックリンク検証ページへ委譲（プラン推定は行わない）
                window.location.replace(`/auth/verify?token=${encodeURIComponent(token)}`);
            }
        }

        // ダッシュボード表示
        function showDashboard(customerData) {
            console.log('🎨 showDashboard 開始, customerData:', customerData);

            // 🔴 LocalStorageにユーザープランデータを保存（プラン変更ボタン用）
            // ⚠️ 三連複永久権(lifetimeSanrenpuku)は「別アカウントへ継承しない」。
            //    現在ユーザーの権威値（customerData = サーバーレスポンス由来）を採用し、未指定のときのみ
            //    同一ユーザー(email一致)の直近値を引き継ぐ。別ユーザー/不明は false（fail closed）。
            //    → サーバーでの true→false 訂正が反映され、A→B 切替で A の権限が B に残らない。
            let _existingUserPlan = {};
            try { _existingUserPlan = JSON.parse(localStorage.getItem('user-plan') || '{}') || {}; } catch (e) {}
            const _toSave = Object.assign({}, customerData);
            _toSave.lifetimeSanrenpuku = persistLifetimeForUser(customerData, _existingUserPlan);
            // ⚠️ 氏名も同じ原則で保存する。customerData.name は表示用の既定値でしかないため、
            //    マジックリンク検証（verify-magic-link）が入れた実名を潰さない。
            //    同一ユーザー(email一致)のときだけ直近値を引き継ぎ、別ユーザー/不明は空にする。
            _toSave.name = persistNameForUser(customerData, _existingUserPlan);
            localStorage.setItem('user-plan', JSON.stringify(_toSave));
            console.log('💾 LocalStorageにuser-planデータ保存完了:', _toSave);

            // 🔧 2025-11-10追加: 有効期限をLocalStorageに保存
            if (customerData.validUntil) {
                localStorage.setItem('validUntil', customerData.validUntil);
                console.log('📅 有効期限保存:', customerData.validUntil);
