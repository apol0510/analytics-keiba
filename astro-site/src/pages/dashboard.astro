            } else if (rankKey === 'ゴールド') {
                progressElement.classList.add('progress-gold');
            } else if (rankKey === 'シルバー') {
                progressElement.classList.add('progress-silver');
            } else {
                progressElement.classList.add('progress-bronze');
            }
        }

        // プラン別コンテンツ表示
        function showPlanContent(plan) {
            console.log('showPlanContent 呼び出し:', plan);

            const planLower = (plan || '').toLowerCase();

            // 無料予想の表示制御（南関 + 中央）
            const freeJraCard = document.getElementById('free-predictions-jra');
            if (planLower === 'free' || planLower === '' || !planLower) {
                console.log('無料予想を表示（Free会員 / 南関 + 中央）');
                document.getElementById('free-predictions').style.display = 'block';
                if (freeJraCard) freeJraCard.style.display = 'block';
            } else {
                console.log('無料予想を非表示（有料会員）');
                document.getElementById('free-predictions').style.display = 'none';
                if (freeJraCard) freeJraCard.style.display = 'none';
            }

            // Light（旧 Standard）予想の表示制御（南関 + 中央）
            if (planLower === 'light' || planLower === 'standard' || planLower === 'ライト') {
                console.log('Light予想を表示（南関 / 中央 メインのみ）');
                document.getElementById('standard-predictions').style.display = 'block';
                const jraCard = document.getElementById('standard-predictions-jra');
                if (jraCard) jraCard.style.display = 'block';
            } else {
                console.log('Light予想を非表示');
                document.getElementById('standard-predictions').style.display = 'none';
                const jraCard = document.getElementById('standard-predictions-jra');
                if (jraCard) jraCard.style.display = 'none';
            }

            // Premium予想の表示制御（プラン別）
            // 馬単は中央・南関を1枚に統合した #premium-predictions（中央/南関の2ボタン）で表示。
            // 全 Premium 系（premium / premium plus / premium sanrenpuku / premium combo）に共通表示。
            // Premium/三連複カードは共通 resolver（resolveClientView）の結果で制御する。判定式を dashboard に再実装しない。
            const _view = getClientView();
            // Premium 有効 → 通常の馬単カード（中央/南関 予想リンクあり）
            if (_view.showPremiumActiveCard) {
                console.log('Premium予想（有効）を表示');
                document.getElementById('premium-predictions').style.display = 'block';
            }
            // Premium 期限切れ → 契約期間終了カード（予想リンクは出さない・再契約導線のみ）。馬単ページは canViewPremium で別途拒否。
            if (_view.showPremiumExpiredCard) {
                console.log('Premium予想（契約期間終了）を表示');
                document.getElementById('premium-predictions-expired').style.display = 'block';
            }
            // 三連複: canViewSanrenpuku（LifetimeSanrenpuku フラグなら Premium 期限切れ後も表示）
            if (_view.showSanrenpukuCard) {
                console.log('Premium三連複予想（中央・南関）を表示');
                document.getElementById('sanrenpuku-predictions').style.display = 'block';
            }

            // 有料会員お問い合わせの表示制御（無料会員は /contact/ を使うため非表示のまま）
            const premiumContactSection = document.querySelector('.contact-section');
            if (premiumContactSection) {
                const isPaidMember = !(planLower === 'free' || planLower === '' || !planLower);
                premiumContactSection.style.display = isPaidMember ? '' : 'none';
            }

            // プラン管理の表示制御（無料会員のみ）
            if (planLower === 'free') {
                console.log('プラン管理を表示（無料会員）');
                document.getElementById('plan-section').style.display = 'block';
            }
            // ログアウトボタンの表示制御:
            //   無料 → plan-section 内の logout-btn-free（上で表示済み）
            //   有料 → logout-section-paid を表示（PR-B: ak_session を持つ有料会員のログアウト導線）
            const paidLogoutSection = document.getElementById('logout-section-paid');
            if (paidLogoutSection) {
                const isPaidLogout = !(planLower === 'free' || planLower === '' || !planLower);
                paidLogoutSection.style.display = isPaidLogout ? 'block' : 'none';
            }

            // アップグレード促進の表示制御（Premium系以外）
            if (planLower !== 'premium' && planLower !== 'premium combo' && planLower !== 'premium plus' && planLower !== 'premium sanrenpuku') {
                console.log('アップグレード促進を表示');
                document.getElementById('upgrade-promotion').style.display = 'block';
            }
        }

        // 成功メッセージ表示
        function showSuccess(message) {
            console.log('showSuccess 呼び出し:', message);
            const successEl = document.getElementById('success-message');
            console.log('success-message 要素:', successEl);
            if (successEl) {
                successEl.textContent = message;
                successEl.style.display = 'block';
                console.log('成功メッセージ表示済み');
                setTimeout(() => {
                    successEl.style.display = 'none';
                }, 10000);
            } else {
                console.error('success-message 要素が見つかりません');
            }
        }

        // エラー表示
        function showError(message) {
            const errorEl = document.getElementById('error-message');
            errorEl.textContent = message;
            errorEl.style.display = 'block';
            setTimeout(() => {
                errorEl.style.display = 'none';
            }, 5000);
        }

        // 特典申請（簡略化）
        document.getElementById('claim-reward-btn')?.addEventListener('click', async () => {
            const customer = getCustomerData();
            if (!customer || !customer.email) {
                showError('ログイン情報が取得できません');
                return;
            }
            
            if (confirm('特典を申請しますか？\n\n申請後は取り消しできません。')) {
                const button = document.getElementById('claim-reward-btn');
                button.disabled = true;
                button.textContent = '申請中...';
                
                try {
                    // 簡略化：ローカル処理
                    setTimeout(() => {
                        button.textContent = '✅ 申請済み';
                        button.style.background = '#64748b';
                        alert('特典申請を受け付けました！\n3営業日以内にメールでご連絡いたします。');
                        
                        // ローカルストレージに申請済みフラグを保存
                        localStorage.setItem('hasClaimedReward', 'true');
                    }, 1000);
                    
                } catch (error) {
                    console.error('特典申請エラー:', error);
                    button.disabled = false;
                    button.textContent = '🎁 特典を申請する';
                    alert('申請に失敗しました: ' + error.message);
                }
            }
        });

        // ポイント交換申請関数は下部の <script is:inline> セクションで定義

        // ログアウト（PR-B: サーバーで ak_session Cookie を削除してから localStorage を消す）
        // - まず logout Function を呼び、response.ok の時だけ localStorage 旧認証情報を削除する
        //   （Cookie 削除失敗時に「ログアウト成功」と誤表示しない / 有料 Cookie を残さない）
        // - HttpOnly の ak_session は JS から読まない・触らない（削除はサーバーの責務）
        // - 二重クリック防止 + finally でボタン状態を復元
        let _loggingOut = false;
        window.logout = async function() {
            if (_loggingOut) return;
            _loggingOut = true;

            const logoutButtons = [
                document.getElementById('logout-btn-free'),
                document.getElementById('logout-btn-paid'),
            ].filter(Boolean);
            const prevLabels = logoutButtons.map((b) => b.textContent);
            logoutButtons.forEach((b) => { b.disabled = true; b.textContent = 'ログアウト中...'; });

            try {
                const logoutUrl = window.location.hostname === 'localhost'
                    ? 'http://localhost:8888/.netlify/functions/logout'
                    : '/.netlify/functions/logout';

                let res;
                try {
                    res = await fetch(logoutUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                    });
                } catch (netErr) {
                    console.warn('logout 通信エラー:', netErr);
                    showError('ログアウトに失敗しました。通信環境を確認して、もう一度お試しください。');
                    return;
                }

                // サーバー Cookie 削除が成功した時だけ localStorage を消す
                if (!res.ok) {
                    showError('ログアウトに失敗しました。時間をおいて、もう一度お試しください。');
                    return;
                }

                // 全キー削除（強制ログアウトと同一の単一源）。権限・期限・三連複永久権の残存を防ぐ。
                clearAuthLocalStorage();

                // ナビゲーション更新イベントを発火 → ホームへ
                window.dispatchEvent(new CustomEvent('userLoggedOut'));
                setTimeout(() => { window.location.href = '/'; }, 500);
            } finally {
                _loggingOut = false;
                logoutButtons.forEach((b, i) => { b.disabled = false; b.textContent = prevLabels[i]; });
            }
        };

        // ページ読み込み時の初期化（簡略化）
        document.addEventListener('DOMContentLoaded', async () => {
            // 🛡️ 復活防止対策: プログレスバー即座に初期化
            initializeProgressBar();

            // ログアウトボタンにイベントリスナーを追加（無料会員用）
            const logoutBtnFree = document.getElementById('logout-btn-free');
            if (logoutBtnFree) {
                logoutBtnFree.addEventListener('click', () => {
                    logout();
                });
            }

            // ログアウトボタンにイベントリスナーを追加（有料会員用）
            const logoutBtnPaid = document.getElementById('logout-btn-paid');
            if (logoutBtnPaid) {
                logoutBtnPaid.addEventListener('click', () => {
                    logout();
                });
            }
            
            // ログイン情報の閉じるボタン
            const loginInfoCloseBtn = document.getElementById('login-info-close');
            if (loginInfoCloseBtn) {
                loginInfoCloseBtn.addEventListener('click', () => {
                    document.getElementById('login-info-section').style.display = 'none';
                });
            }
            
            // マジックリンク認証チェック
            await handleTokenAuth();

            // 既存セッションチェック
            console.log('🔐 認証チェック開始');
            const authLoading = document.getElementById('auth-loading-section');
            if (isAuthenticated()) {
                console.log('✅ 認証済み、顧客データ取得開始');
                // (1) 即時にキャッシュデータで dashboard を表示（白画面・login フラッシュ防止）
                const cached = getCachedCustomerData();
                if (cached) {
                    showDashboard(cached);
                }
                // (2) 最新ポイントは非同期で取得し、取得後に表示だけ更新
                getCustomerData().then((customer) => {
                    if (!customer) return;
                    if (!cached) {
                        showDashboard(customer);
                    } else if (typeof updatePointsDisplay === 'function') {
                        updatePointsDisplay(customer.points, customer.hasClaimedReward);
                    }
                }).catch((e) => {
                    console.warn('getCustomerData failed:', e);
                });
            } else {
                console.log('❌ 未認証');
                // 認証中インジケータを隠し login form を表示
                document.documentElement.classList.remove('auth-likely-in');
                if (authLoading) authLoading.style.display = 'none';
                document.getElementById('login-section').style.display = '';
            }
        });

        // localStorage のみから即時に customerData を組み立てる（ネットワーク無し）
        function getCachedCustomerData() {
            try {
                const raw = localStorage.getItem('user-plan');
                if (raw) {
                    const u = JSON.parse(raw);
                    return {
                        email: u.email,
                        plan: u.plan || 'free',
                        // 現在ユーザー(u)自身の権威値。同一ユーザーの user-plan から引き継ぐ（別ユーザー継承ではない）。
                        lifetimeSanrenpuku: u.lifetimeSanrenpuku === true,
                        points: typeof u.points === 'number' ? u.points : 0,
                        hasClaimedReward: localStorage.getItem('hasClaimedReward') === 'true',
                        registrationDate: u.registeredAt,
                        name: u.name || '',
                    };
                }
                const email = localStorage.getItem('userEmail') || localStorage.getItem('user_email');
                const plan = localStorage.getItem('userPlan') || localStorage.getItem('user_plan') || 'free';
                if (email || plan !== 'free') {
                    return { email: email || '', plan, points: 0, hasClaimedReward: false, name: '' };
                }
            } catch (_) {}
            return null;
        }

        // 🔧 グローバルスコープに公開（is:inline scriptからアクセスするため）
        window.getCustomerData = getCustomerData;
        window.fetchUserPoints = fetchUserPoints;
        console.log('✅ getCustomerData/fetchUserPoints をグローバルスコープに公開しました');

    </script>

