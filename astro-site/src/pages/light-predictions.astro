<script is:inline>
    // 🔧 2026-05-13 修正: アコーディオン内で <details>（不要馬・見送り馬 など）を
    //   開いた際、親の max-height が固定値のままだと overflow: hidden で
    //   クリップされる問題があった。
    //   open 時: 一度 scrollHeight に設定 → transitionend で 'none' に切替（内側展開を阻害しない）
    //   close 時: 一度 scrollHeight に戻してから次フレームで 0px → 閉じアニメ
    function openAccordion(content, icon) {
        // 既に open 中（'none'）で再度呼ばれた場合は何もしない
        if (content.style.maxHeight === 'none') return;
        content.style.maxHeight = content.scrollHeight + 'px';
        content.style.opacity = '1';
        icon.textContent = '◎';
        icon.style.transform = 'rotate(180deg)';
        const onEnd = (e) => {
            if (e.propertyName !== 'max-height') return;
            content.removeEventListener('transitionend', onEnd);
            // open アニメ完了後は制限解除（内側 details 展開を阻害しない）
            if (content.style.maxHeight !== '0px') {
                content.style.maxHeight = 'none';
            }
        };
        content.addEventListener('transitionend', onEnd);
    }
    function closeAccordion(content, icon) {
        if (content.style.maxHeight === 'none') {
            // none の状態から閉じる場合、現実の高さに戻してから 0 にしてアニメ
            content.style.maxHeight = content.scrollHeight + 'px';
            // 次フレームで 0 に
            requestAnimationFrame(() => {
                content.style.maxHeight = '0px';
                content.style.opacity = '0';
            });
        } else {
            content.style.maxHeight = '0px';
            content.style.opacity = '0';
        }
        icon.textContent = '▼';
        icon.style.transform = 'rotate(0deg)';
    }
    function isAccordionOpen(content) {
        return content.style.maxHeight === 'none' ||
            (content.style.maxHeight && content.style.maxHeight !== '0px' && content.style.maxHeight !== '');
    }

    // アコーディオン共通化: 一つ開けたら他を自動で閉じる
    function createToggleFunction(raceNumber) {
        return function() {
            const content = document.getElementById(`race-${raceNumber}r`);
            const icon = document.getElementById(`toggle-${raceNumber}r`);

            if (!content || !icon) return;

            // 他のアコーディオンをすべて閉じる
            for (let i = 1; i <= 12; i++) {
                if (i !== raceNumber) {
                    const otherContent = document.getElementById(`race-${i}r`);
                    const otherIcon = document.getElementById(`toggle-${i}r`);
                    if (otherContent && otherIcon) {
                        closeAccordion(otherContent, otherIcon);
                    }
                }
            }

            if (!isAccordionOpen(content)) {
                openAccordion(content, icon);
            } else {
                closeAccordion(content, icon);
            }
        };
    }

    // プレビュー用のトグル関数を生成（1R-12R）
    function createPreviewToggleFunction(raceNumber) {
        return function() {
            const content = document.getElementById(`preview-${raceNumber}r`);
            const icon = document.getElementById(`toggle-preview-${raceNumber}r`);

            if (!content || !icon) return;

            // 他のプレビューアコーディオンをすべて閉じる（1-12 全範囲）
            for (let i = 1; i <= 12; i++) {
                if (i !== raceNumber) {
                    const otherContent = document.getElementById(`preview-${i}r`);
                    const otherIcon = document.getElementById(`toggle-preview-${i}r`);
                    if (otherContent && otherIcon) {
                        closeAccordion(otherContent, otherIcon);
                    }
                }
            }

            if (!isAccordionOpen(content)) {
                openAccordion(content, icon);
            } else {
                closeAccordion(content, icon);
            }
        };
    }

    // 🔧 2026-05-13 修正: プレビューも全レース番号 (1-12) で生成
    //   旧: 1-9 のみ → メインレースが 11R の場合は 10R/12R のアコーディオンが開けなかった
    //   新: 1-12 全てに preview toggle を割り当て
    for (let i = 1; i <= 12; i++) {
        window[`togglePreview${i}R`] = createPreviewToggleFunction(i);
    }

    // 1R-12Rのすべてのトグル関数を生成
    for (let i = 1; i <= 12; i++) {
        window[`toggleRace${i}R`] = createToggleFunction(i);
    }

    // 週別結果タブ切り替え機能
    function showWeeklyResults(date) {
        // Hide all result divs
        const allResults = document.querySelectorAll('.weekly-results');
        allResults.forEach(result => result.style.display = 'none');

        // Remove active class from all tabs
        const allTabs = document.querySelectorAll('.weekly-tab');
        allTabs.forEach(tab => {
            tab.className = 'weekly-tab';
            tab.style.background = 'rgba(148, 163, 184, 0.1)';
            tab.style.color = 'var(--body-text-color)';
            tab.style.border = '1px solid rgba(148, 163, 184, 0.2)';
        });

        // Show selected result div
        const selectedResult = document.getElementById('results-' + date);
        if (selectedResult) {
            selectedResult.style.display = 'grid';
        }

        // Add active class to selected tab
        const selectedTab = document.getElementById('tab-' + date);
        if (selectedTab) {
            selectedTab.className = 'weekly-tab active';
            selectedTab.style.background = 'linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(16, 185, 129, 0.3) 100%)';
            selectedTab.style.color = '#10b981';
            selectedTab.style.border = '1px solid rgba(16, 185, 129, 0.3)';
        }
    }

    // グローバルに関数を公開
    window.showWeeklyResults = showWeeklyResults;
</script>