// ⚠️ SSR。有料本文を組み立てる前にサーバー側で認可を確定させる（2026-08-08）。
//    prerender=true のままだと静的 HTML に有料本文が入り、localStorage の書き換えだけで読めてしまう。
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionKeepAlive from '../components/SessionKeepAlive.astro';
import { gatePaidPage, PAID_PAGE_HEADERS } from '../lib/auth/paidPageGate.js';
import AccordionClickClose from '../components/AccordionClickClose.astro';
import RaceAccordionClickClose from '../components/RaceAccordionClickClose.astro';
import AccessControl from '../components/AccessControl.astro';
import ProgressBarConfidence from '../components/ProgressBarConfidence.astro';
import { processRaceData, normalizeHorseData, getRoleDisplayConfig, validateDataIntegrity, getHorseConfidenceFromMark, calculateMarkBasedConfidence, convertToStarRating, getRecommendationStars, generateStandardizedBets, calculateScoreBasedStats, getPredictionDataWithStrategies, calculateProgressBarConfidence } from '../lib/shared-prediction-logic.js';
import { convertToYesterdayResults, getLatestDayData, convertToSanrenpukuYesterdayResults, getLatestSanrenpukuDayData } from '../lib/archive-utils.js';
import { getRaceTier, PLAN_ACCESS } from '../lib/race-config.js';
import { generateMinorHorseComment } from '../lib/horseEnrichment.js';
import HorseMainCard from '../components/HorseMainCard.astro';
import RaceHorseSection from '../components/RaceHorseSection.astro';
import archiveSanrenpukuResults from '../data/archiveSanrenpukuResults.json';
import { pickLatestAndAdapt } from '../lib/adaptLatestPrediction.js';
import { injectHorseStatsNankan } from '../lib/injectHorseStatsNankan.js';
import { injectEntriesRecentRacesNankan } from '../lib/injectEntriesRecentRacesNankan.js';

// ── サーバー側認可（この行より前で有料データを組み立てない）──
// 判定は既存の単一源に委譲: ak_session（本人特定）+ resolveEntitlements（権利）。
// requiredPlan='standard' は既存どおり Light 以上（canViewLight）を意味する。
const gate = await gatePaidPage({
  request: Astro.request,
  requiredPlan: 'standard',
  env: process.env, // 認可ライブラリは env を直接参照しない方針のため、ページ側で注入する
});
if (gate.response) return gate.response;
for (const [k, v] of Object.entries(PAID_PAGE_HEADERS)) Astro.response.headers.set(k, v);

// src/data/predictions/*.json から最新日付を自動選択（自動反映フロー）
const predictionModules = import.meta.glob('/src/data/predictions/*.json', { eager: true });
const allRacesData = pickLatestAndAdapt(predictionModules);
if (!allRacesData) {
    throw new Error('予想データが見つかりません。src/data/predictions/ を確認してください。');
}

// 南関 uma_info 元表統計（既存正本 src/data/horseStats/nankan）を horse.horseStatsNankan へ注入。
// pickLatestAndAdapt（legacy単会場経路）は注入しないため、light でも premium/free 南関と同じ
// 既存 injectHorseStatsNankan で表示専用に補う（[allRacesData] を venues 形状として渡す）。
// recentRaces / featureScores / AI指数 / 印 / 買い目 / EV は一切変更しない。失敗は非致命。
try {
    injectHorseStatsNankan([allRacesData], allRacesData.raceDate, process.cwd());
} catch (_e) {
    // 注入失敗は非致命。既存表示を維持する。
}

// 南関 entries(出馬表) 由来の近走(最大5走)を horse.recentRacesFromEntriesNankan へ注入する。
// legacy単会場経路(pickLatestAndAdapt)は premium/free が通る adaptLatestPrediction 内の
// injectEntriesRecentRacesNankan を経由しないため、entries 近走が注入されず、
// RaceHorseSection が fallback の旧 recentRaces(最大4走)に落ちて「4走止まり」になっていた。
// premium/free と同じ既存ヘルパーで補う（別フィールドのみ・recentRaces / fallback / JRA は不変）。失敗は非致命。
try {
    injectEntriesRecentRacesNankan([allRacesData], allRacesData.raceDate, process.cwd());
} catch (_e) {
    // 注入失敗は非致命。既存表示(fallback)を維持する。
}

// 🛡️ 復活防止対策: processRaceDataのエラーハンドリング強化
let mainRace, race12R, sortedRaces;
try {
    const processedData = processRaceData(allRacesData);
    mainRace = processedData.mainRace;
    race12R = processedData.race12R;
    sortedRaces = processedData.sortedRaces || [];

    // デバッグ用ログ
    console.log('🔍 ProcessRaceData結果:', {
        mainRace: mainRace ? 'あり' : 'なし',
        race12R: race12R ? 'あり' : 'なし',
        sortedRacesLength: sortedRaces?.length || 0
    });
} catch (error) {
    console.error('❌ processRaceData エラー:', error);
    // フォールバック: 直接allRacesDataから取得
    mainRace = allRacesData?.races?.find(race => race.isMainRace === true) || null;
    race12R = allRacesData?.races?.find(r => r.raceNumber === '12R') || null;
    sortedRaces = allRacesData?.races?.sort((a, b) => a.displayOrder - b.displayOrder) || [];
}

// 日付と会場を取得
const raceDate = allRacesData.raceDate; // "2025-09-18"
const track = allRacesData.track;

// 日付を日本語形式に変換
const [year, month, day] = raceDate.split('-');
const formattedDate = `${year}年${parseInt(month)}月${parseInt(day)}日`;

// Standard会員向け: メインレースのみ（totalRaces別に動的取得）
// 🛡️ 復活防止対策: sortedRacesの安全性チェック
const totalRaces = allRacesData.totalRaces || 12;
const standardRaceNumbers = PLAN_ACCESS.standard.races(totalRaces); // [6,7,8] or [8,9,10] or [10,11,12]
console.log('🔍 Standard会員対象レース:', { totalRaces, standardRaceNumbers });

const standardRaces = (Array.isArray(sortedRaces) ? sortedRaces : []).filter(race => {
    const raceNum = parseInt(race?.raceNumber?.replace('R', ''));
    return standardRaceNumbers.includes(raceNum);
});

// Light の買い目はローカル生成を廃止し、保存 bettingLines.umatan（単一正本）のメインレース買い目を参照する。
// Light はメインレースのみ表示し、Premium の同一メインレースと完全一致させる（軸・相手の独自再選定はしない）。
// 正本のメインレース行「本命→相手5」(一方向5点)を軸+相手へ分解して既存の式表示に流すヘルパー。
function parseMainUmatanForDisplay(bettingLines, horses) {
    const stored = Array.isArray(bettingLines?.umatan) ? bettingLines.umatan : [];
    const mainLine = stored[0];
    if (!mainLine) return null;
    // 区切りは正本の → を主とし、旧 dash/↔/⇔ 形式にも後方互換で対応。
    const m = String(mainLine).match(/^(\d+)[-↔⇔→]([^()]+)/);
    if (!m) return null;
    const axis = parseInt(m[1], 10);
    const opponents = m[2].split('.').map(n => parseInt(n, 10)).filter(n => Number.isFinite(n));
    const axisHorse = (Array.isArray(horses) ? horses : []).find(h => Number(h.number ?? h.horseNumber) === axis);
    return {
        axis,
        axisName: axisHorse?.name ?? axisHorse?.horseName ?? '',
        axisLabel: '本命',
        opponents,
        scoreDiff: null,
    };
}

// ✅ archiveResults.jsonから自動取得するyesterdayResults（馬単）
