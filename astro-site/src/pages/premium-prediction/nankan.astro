<script is:inline>
    function toggleAccordion(id) {
        const content = document.getElementById(id);
        const icon = document.getElementById(id + 'Icon');
        
        if (content.style.maxHeight === '0px' || content.style.maxHeight === '') {
            content.style.maxHeight = content.scrollHeight + 'px';
            content.style.opacity = '1';
            icon.textContent = '◎';
        } else {
            content.style.maxHeight = '0px';
            content.style.opacity = '0';
            icon.textContent = '▼';
        }
    }

    // 会場タブ切り替え（同時開催対応）
    function selectNankanVenue(btn) {
        const idx = btn.getAttribute('data-venue-index');
        document.querySelectorAll('.venue-btn').forEach((b) => b.classList.toggle('active', b.getAttribute('data-venue-index') === idx));
        document.querySelectorAll('.venue-content').forEach((c) => c.classList.toggle('active', c.getAttribute('data-venue-index') === idx));
    }
    window.selectNankanVenue = selectNankanVenue;

    // アコーディオン共通化（同時開催対応：会場ごとにスコープ）
    function toggleNankanRace(venueIndex, raceNumber) {
        const content = document.getElementById(`race-v${venueIndex}-${raceNumber}r`);
        const icon = document.getElementById(`toggle-v${venueIndex}-${raceNumber}r`);
        if (!content || !icon) return;

        // 同じ会場の他アコーディオンを閉じる
        for (let i = 1; i <= 12; i++) {
            if (i !== raceNumber) {
                const otherContent = document.getElementById(`race-v${venueIndex}-${i}r`);
                const otherIcon = document.getElementById(`toggle-v${venueIndex}-${i}r`);
                if (otherContent && otherIcon) {
                    otherContent.style.maxHeight = '0px';
                    otherContent.style.opacity = '0';
                    otherIcon.textContent = '▼';
                    otherIcon.style.transform = 'rotate(0deg)';
                }
            }
        }

        if (content.style.maxHeight === '0px' || content.style.maxHeight === '') {
            content.style.maxHeight = content.scrollHeight + 'px';
            content.style.opacity = '1';
            icon.textContent = '◎';
            icon.style.transform = 'rotate(180deg)';
        } else {
            content.style.maxHeight = '0px';
            content.style.opacity = '0';
            icon.textContent = '▼';
            icon.style.transform = 'rotate(0deg)';
        }
    }
    window.toggleNankanRace = toggleNankanRace;

    // 開いているレースアコーディオンの「中身（非操作領域・テキスト部分・内側 details の中身）」を
    // クリックしたら閉じる（JRA と同方針）。操作要素（リンク/ボタン/summary/入力系/label 等）と
    // 開閉ヘッダー自身のみ除外。summary は除外するので内側 details の開閉操作は維持される
    // （details 全体は除外しない）。委譲で実装。
    const ACCORDION_CLOSE_IGNORE = 'a, button, summary, input, select, textarea, label, [role="button"], [contenteditable], .race-accordion-header';
    document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest(ACCORDION_CLOSE_IGNORE)) return;
        const content = target.closest('.race-accordion-content');
        if (!content) return;
        const mh = content.style.maxHeight;
        const isOpen = mh === 'none' || (!!mh && mh !== '0px');
        if (!isOpen) return;
        // id 形式: race-v{venueIndex}-{raceNumber}r
        const m = content.id.match(/^race-v(\d+)-(\d+)r$/);
        if (!m) return;
        toggleNankanRace(parseInt(m[1], 10), parseInt(m[2], 10));
    });

    // R1d-scroll-v1: 内側の過去走 <details> を後から開くと、親レースアコーディオン
    // (.race-accordion-content) の固定 maxHeight を超えてクリップされる問題を解消する。
    // admin docs §34.26。表示構造・データソース・通過順・コメント文言は変更しない（高さ再計算のみ）。
    function recalculateOpenAccordionHeightFrom(el) {
        const content = el && el.closest && el.closest('.race-accordion-content');
        if (!content) return;
        // レースアコーディオンが開いている時だけ再計算（閉じている＝maxHeight 0px/未設定 は触らない）
        const mh = content.style.maxHeight;
        if (mh === '0px' || mh === '') return;
        // 内側 details の開閉が DOM に反映された後の scrollHeight で追従させる
        requestAnimationFrame(() => {
            content.style.maxHeight = content.scrollHeight + 'px';
        });
    }

    // premium 南関ページ内の過去走 details(.recent-races) の toggle を監視。
    function bindRecentRacesAccordionRecalc() {
        document.querySelectorAll('details.recent-races').forEach((d) => {
            if (d.dataset.r1dScrollBound === '1') return;
            d.dataset.r1dScrollBound = '1';
            d.addEventListener('toggle', () => {
                recalculateOpenAccordionHeightFrom(d);
                // 補助: 開いた details を視認範囲に入れる（主目的は上の maxHeight 再計算）
                if (d.open) d.scrollIntoView({ block: 'nearest' });
            });
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindRecentRacesAccordionRecalc);
    } else {
        bindRecentRacesAccordionRecalc();
    }

    // テスト認証機能（開発環境用）
    window.setTestAuth = function(plan) {
        if (!['premium', 'standard', 'free'].includes(plan.toLowerCase())) {
            console.error('❌ 無効なプラン:', plan);
            console.log('📋 有効なプラン: premium, standard, free');
            return;
        }

        const testUser = {
            email: `test-${plan}@example.com`,
            name: `テスト${plan.charAt(0).toUpperCase() + plan.slice(1)}ユーザー`,
            plan: plan.toLowerCase(),
            isTest: true,
            points: plan === 'premium' ? 1000 : plan === 'standard' ? 500 : 100,
            registrationDate: new Date().toISOString(),
            lastLogin: new Date().toISOString()
        };

        // LocalStorageに保存
        localStorage.setItem('nankan_user', JSON.stringify(testUser));
        localStorage.setItem('nankan_test_auth', 'true');

        console.log(`✅ テスト認証設定完了: ${plan}プラン`, testUser);
        console.log('🔄 ページを更新して認証を適用してください');

        // 1秒後に自動リロード
        setTimeout(() => {
            location.reload();
        }, 1000);
    };

    // コンソールにヘルプメッセージ表示
    console.log('%c🔑 テスト認証機能が利用可能です', 'color: #60a5fa; font-weight: bold;');
    console.log('%c使用方法: setTestAuth("premium") または setTestAuth("standard")', 'color: #94a3b8;');

    // 三連複AI推奨買い目: 絞り込み / 通常 タブ切替
    document.addEventListener('click', function(e) {
        const btn = e.target && e.target.closest && e.target.closest('.srp-tab');
        if (!btn) return;
        const section = btn.closest('.sanrenpuku-section');
        if (!section) return;
        const mode = btn.getAttribute('data-srp-mode');
        section.querySelectorAll('.srp-tab').forEach((b) => {
            b.classList.toggle('active', b.getAttribute('data-srp-mode') === mode);
        });
        section.querySelectorAll('.srp-panel').forEach((p) => {
            p.classList.toggle('active', p.classList.contains(`srp-panel-${mode}`));
        });
    });
</script>

