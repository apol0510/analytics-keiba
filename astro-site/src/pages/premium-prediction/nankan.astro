        background: none;
        border: none;
        color: rgba(226, 232, 240, 0.6);
        font-size: 2rem;
        cursor: pointer;
        transition: color 0.3s ease;
        padding: 0;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
