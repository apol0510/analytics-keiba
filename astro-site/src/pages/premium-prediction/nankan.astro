---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccessControl from '../../components/AccessControl.astro';
import { processRaceData, processUnifiedRaceData, normalizeHorseData, getRoleDisplayConfig, validateDataIntegrity, getHorseConfidenceFromMark, calculateMarkBasedConfidence, convertToStarRating, getRecommendationStars, generateStandardizedBets, calculateScoreBasedStats, getPredictionDataWithStrategies, calculateProgressBarConfidence, isOsaeCandidate, isIneligibleHorse, sortOsaeCandidates, getDisplayComputerIndex, getHorseAiIndex } from '../../lib/shared-prediction-logic.js';
import { convertToSanrenpukuYesterdayResults, getLatestSanrenpukuDayData } from '../../lib/archive-utils.js';
import { pickLatestNankanVenuesAndAdapt } from '../../lib/adaptLatestPrediction.js';
import { getDisplayRecentRacesForNankan } from '../../lib/getDisplayRecentRacesForNankan.js';
import { generateRaceUmatanLines, countPointsFromUmatanLine } from '../../utils/mainRaceBetting.js';
import { generateMinorHorseComment } from '../../lib/horseEnrichment.js';
import { buildRaceSanrenpuku, formatSanrenpukuLine } from '../../utils/sanrenpukuBetting.js';
import { loadFeatureScores, getHorseFeatures, venueCodeFromName } from '../../lib/loadFeatureScores.js';
import { deriveAkImportance } from '../../lib/akFeatureSummary.js';
import NankanHorseStatsPanel from '../../components/NankanHorseStatsPanel.astro';
import AccordionClickClose from '../../components/AccordionClickClose.astro';

// R1d-impl-v2c Step2: 連下/補欠 compact 近走の field 読み替え（entries 由来 / 既存 getDisplay 由来の両 shape 対応）。
// 表示専用・正本順位不変・recentHorseHistories fallback 正本化しない・compact 維持・docs §34.24。
// 値が無いものは空文字を返し、呼び出し側で項目ごと非表示にする（空ラベル・0埋めはしない）。
function neCompactCell(v) { return v !== null && v !== undefined && String(v).trim() !== ''; }
function pickCompactCell(...xs) { for (const x of xs) { if (neCompactCell(x)) return String(x).trim(); } return ''; }
function compactRaceCells(r) {
  const rankRaw = r?.rank ?? r?.finish;
  return {
    venue: pickCompactCell(r?.venue, r?.track, r?.trackName),
    distance: pickCompactCell(r?.distance),
    rank: (rankRaw != null && Number.isFinite(Number(rankRaw))) ? `${rankRaw}着` : pickCompactCell(r?.finishStatus),
    time: pickCompactCell(r?.time),
    last3f: pickCompactCell(r?.last3f, r?.agari),
    bodyWeight: pickCompactCell(r?.bodyWeight, r?.weightBody),
    pass: pickCompactCell(r?.passingOrder, r?.cornerPassage, r?.corner),
    raceName: pickCompactCell(r?.raceName),
  };
}

// 南関 featureScores → AK 3項目（安定性/能力上位性/展開利）。
// shared featureScores がある馬のみ返す。無ければ null → 呼び出し側で既存 horse.importance に fallback。
// deriveAkImportance の値は 0〜100。既存 importance(0〜1) と揃えるため /100 に正規化。一部軸が欠ける馬は fallback。
function fsImportanceFor(featureScoresData, raceNumber, horseNumber) {
  if (!featureScoresData) return null;
  const fs6 = getHorseFeatures(featureScoresData, raceNumber, horseNumber);
  if (!fs6) return null;
  const akImp = deriveAkImportance(fs6);
  if (!akImp) return null;
  // 一部の軸が欠ける馬（少走・新馬など）は信頼できる3項目にならないため既存表示に fallback。
  if (akImp.some((it) => it.value == null)) return null;
  return akImp.map((it) => ({ label: it.label, value: it.value / 100 }));
}

// src/data/predictions/*.json から最新日付の全会場を取得（同時開催対応）
const predictionModules = import.meta.glob('/src/data/predictions/*.json', { eager: true });
const multiVenueData = pickLatestNankanVenuesAndAdapt(predictionModules);
if (!multiVenueData || multiVenueData.venues.length === 0) {
    throw new Error('予想データが見つかりません。src/data/predictions/ を確認してください。');
}

// 各会場ごとに必要な派生データを構築
const venuesProcessed = multiVenueData.venues.map((venueRaw) => {
    const { mainRace, race12R, sortedRaces } = processRaceData(venueRaw);
    return {
        allRacesData: venueRaw,
        venueSlug: venueRaw.venueSlug,
        track: venueRaw.track,
        raceDate: venueRaw.raceDate,
        totalRaces: venueRaw.totalRaces || venueRaw.races.length,
        mainRace,
        race12R,
        sortedRaces,
    };
});

const isMultiVenue = venuesProcessed.length > 1;
const firstVenue = venuesProcessed[0];

// SEO 用に最初の会場のメインレース情報を採用
const { mainRace, race12R, sortedRaces } = firstVenue;
const track = firstVenue.track;
const totalRaces = firstVenue.totalRaces;

// 日付を日本語形式に変換
const raceDate = multiVenueData.raceDate;
const [year, month, day] = raceDate.split('-');
const formattedDate = `${year}年${parseInt(month)}月${parseInt(day)}日`;

// 元のデータを直接使用（根本解決）
const { raceInfo, strategies, horses, analysis, preview, allHorses, totalHorses } = mainRace;
const { raceInfo: race12RInfo, strategies: race12RStrategies, horses: race12RHorses, allHorses: race12RAllHorses } = race12R || {};

// =========================================================================
// 本日の傾向分析（レース信頼度の多要素算出）
// =========================================================================
// 旧実装は「馬1頭の confidence (>=89)」だけでほぼ全レースが高信頼度になっていた。
// レース単位の信頼度は、本命の累積スコア・対抗との差・上位の広がり・頭数・
// 混戦度（contenderCount）の合成で算出する。
//
// 算出フロー:
//   1. raceData.allHorses から pt を取得
//   2. honmeiScore / taikouScore / topSpread / scoreGap / fieldSize /
//      contenderCount / chaosScore を算出
//   3. confidenceScore = 50 + scoreGap*1.4 + topSpread*0.35
//                          + (honmeiScore-145)*0.5 - 大頭数ペナルティ
//                          - contenderCount*1.5（0〜100にクランプ）
//   4. 分類:
//        高信頼度: confidenceScore >= 78 かつ scoreGap >= 8（最大4レースに制限）
//        高配当モード: confidenceScore <= 62 または scoreGap <= 2
//        それ以外: 通常
const clamp = (v, min, max) => Math.max(min, Math.min(max, v));

function buildRaceConfidenceMetrics(raceData) {
    const all = Array.isArray(raceData.allHorses) ? raceData.allHorses : [];
    const byRole = (role) => all.find((h) => h && h.role === role);
    const sortedPts = all
        .map((h) => Number(h?.pt) || 0)
        .filter((v) => v > 0)
        .sort((a, b) => b - a);

    const honmei = byRole('本命');
    const taikou = byRole('対抗');
    const honmeiScore = Number(honmei?.pt) || sortedPts[0] || 0;
    const taikouScore = Number(taikou?.pt) || sortedPts[1] || 0;
    const thirdScore = sortedPts[2] || 0;
    const fifthScore = sortedPts[4] || sortedPts[sortedPts.length - 1] || 0;
    const fieldSize = Number(raceData?.raceInfo?.horseCount) || all.length || sortedPts.length;
    const scoreGap = honmeiScore - taikouScore;
    const topSpread = honmeiScore - fifthScore;

    // 本命に近い対抗候補の数（本命を除く、pt >= 87% honmei）
    const contenderThreshold = honmeiScore > 0 ? honmeiScore * 0.87 : 0;
    const contenderCount = sortedPts.slice(1).filter((p) => p >= contenderThreshold).length;

    // 混戦度: 上位5頭の標準偏差が小さいほど混戦
    const top5 = sortedPts.slice(0, 5);
    const top5Mean = top5.length > 0 ? top5.reduce((s, v) => s + v, 0) / top5.length : 0;
    const top5Var = top5.length > 0
        ? top5.reduce((s, v) => s + (v - top5Mean) ** 2, 0) / top5.length
        : 0;
    const top5Stdev = Math.sqrt(top5Var);
    // 標準偏差が低い（接近）ほど chaos が高い
    const chaosScore = clamp(Math.round(30 - top5Stdev * 2), 0, 30);

    const fieldPenalty = Math.max(0, fieldSize - 12) * 3;
    const rawConfidence =
        50 +
        scoreGap * 1.4 +
        topSpread * 0.35 +
        (honmeiScore - 145) * 0.5 -
        fieldPenalty -
        contenderCount * 1.5;
    const confidenceScore = clamp(Math.round(rawConfidence), 0, 100);

    return {
        raceNumber: raceData.raceNumber,
        raceName: raceData.raceName,
        honmeiScore,
        taikouScore,
        thirdScore,
        scoreGap,
        topSpread,
        fieldSize,
        contenderCount,
        chaosScore,
        confidenceScore,
    };
}

const raceMetrics = venuesProcessed
    .flatMap((v) => v.sortedRaces)
    .map(buildRaceConfidenceMetrics);

// 1次分類
const HIGH_CONF_THRESHOLD = 78;
const HIGH_CONF_GAP_MIN = 8;
const UPSET_CONF_THRESHOLD = 62;
const UPSET_GAP_MAX = 2;
const HIGH_CONF_MAX_COUNT = 4; // 1開催あたり高信頼度の上限

const provisional = raceMetrics.map((m) => {
    let category;
    if (m.confidenceScore >= HIGH_CONF_THRESHOLD && m.scoreGap >= HIGH_CONF_GAP_MIN) {
        category = 'high';
    } else if (m.confidenceScore <= UPSET_CONF_THRESHOLD || m.scoreGap <= UPSET_GAP_MAX) {
        category = 'upset';
    } else {
        category = 'normal';
    }
    return { ...m, category };
});

// 高信頼度の数が上限を超えた場合は、confidenceScore 上位だけを高信頼度に残し、
// 残りは通常レースに降格する（過剰な絞り込みを避ける安全装置）
const highCandidates = provisional
    .filter((m) => m.category === 'high')
    .sort((a, b) => b.confidenceScore - a.confidenceScore);
if (highCandidates.length > HIGH_CONF_MAX_COUNT) {
    const keep = new Set(highCandidates.slice(0, HIGH_CONF_MAX_COUNT).map((m) => m.raceNumber));
    for (const m of provisional) {
        if (m.category === 'high' && !keep.has(m.raceNumber)) {
            m.category = 'normal';
        }
    }
}

const highConfidenceRaces = provisional.filter((m) => m.category === 'high');
const upsetModeRaces = provisional.filter((m) => m.category === 'upset');
const normalRaces = provisional.filter((m) => m.category === 'normal');

// デバッグログ: 各レースの分類根拠
console.log('🔍 Race confidence metrics:');
provisional.forEach((m) => {
    console.log(
        `  ${m.raceNumber} cat=${m.category} conf=${m.confidenceScore} ` +
        `honmei=${m.honmeiScore} taikou=${m.taikouScore} gap=${m.scoreGap} ` +
        `topSpread=${m.topSpread} field=${m.fieldSize} contender=${m.contenderCount} ` +
        `chaos=${m.chaosScore}`
    );
});

// 自動コメント生成（新分類ベース）
let autoInsight = '';
if (highConfidenceRaces.length >= 3) {
    autoInsight = `本日は本命候補が比較的明確なレースが${highConfidenceRaces.length}レースあります。AI推奨買い目で堅実な勝負がおすすめです。`;
} else if (upsetModeRaces.length >= 3) {
    autoInsight = `本日は上位拮抗・波乱含みのレースが${upsetModeRaces.length}レースあります。AI推奨買い目で高配当のチャンスを狙えます。`;
} else if (highConfidenceRaces.length > 0 && upsetModeRaces.length > 0) {
    autoInsight = `本日は本命明確なレース（${highConfidenceRaces.length}R）と上位拮抗レース（${upsetModeRaces.length}R）がバランス良く配置されています。AI推奨買い目をレースごとに確認してください。`;
} else {
    autoInsight = '本日は標準的なレース構成です。各レースのAI推奨買い目を確認しながら勝負レースを絞り込んでください。';
}

// ✅ 三連複昨日の的中結果データ取得（Premium会員のみ表示）
const sanrenpukuYesterdayResults = convertToSanrenpukuYesterdayResults();
const sanrenpukuLatestResult = getLatestSanrenpukuDayData();

---

<BaseLayout title={`プレミアム予想 | ${raceInfo.title}`} description={`AI技術による${raceInfo.track}競馬${raceInfo.raceName}の詳細分析。機械学習モデルによる高精度予想の有料版を提供中。`}>
    <AccessControl requiredPlan="premium">
        <div class="page-container">
        <!-- ヘッダーセクション -->
        <div class="header-section">
            <div class="ai-badge">
                <span class="pulse"></span>
                <span class="ai-status">AI分析完了</span>
            </div>
            <h1 class="race-title">
                {isMultiVenue
                    ? `${formattedDate} 南関競馬 ${venuesProcessed.length}会場 - 全${allSortedRaces.length}レース総合予想`
                    : `${formattedDate} ${track} - 全${totalRaces}レース総合予想`}
            </h1>
            <div class="ai-metrics">
                <div class="metric">
                    <div class="metric-value">{isMultiVenue ? allSortedRaces.length : totalRaces}</div>
                    <div class="metric-label">分析レース数</div>
                </div>
                <div class="metric">
                    <div class="metric-value">全レース対応</div>
                    <div class="metric-label">AI精密分析</div>
                </div>
                <div class="metric">
                    <div class="metric-value">馬単</div>
                    <div class="metric-label">AI推奨買い目</div>
                </div>
                <div class="metric">
                    <div class="metric-value">機械学習モデル</div>
                    <div class="metric-label">AI予想システム</div>
                </div>
            </div>
        </div>

        <!-- 会場タブ（同時開催の場合のみ表示） -->
        {isMultiVenue && (
            <div class="venue-selector">
                {venuesProcessed.map((v, i) => (
                    <button
                        class={`venue-btn ${i === 0 ? 'active' : ''}`}
                        data-venue-index={i}
                        type="button"
                        onclick="selectNankanVenue(this)"
                    >
                        <span class="venue-label">{v.track}</span>
                        <span class="venue-race-count">{v.allRacesData.races.length}R</span>
                    </button>
                ))}
            </div>
        )}

        <!-- 穴馬ページリンク -->
        <div class="dark-horse-link-section">
            <a href="/dark-horse-picks/?category=nankan" class="dark-horse-link-btn">
                <span class="dark-horse-icon">🐎</span>
                <div class="dark-horse-text">
                    <span class="dark-horse-title">本日の穴馬抽出ツール</span>
                    <span class="dark-horse-subtitle">AI予想から狙い目の穴馬を自動抽出</span>
                </div>
                <span class="dark-horse-arrow">→</span>
            </a>
        </div>

        <!-- プレミアム会員バッジ -->
        <div class="premium-status">
            <span class="premium-icon">👑</span>
            <span class="premium-status-text">プレミアム会員限定コンテンツ</span>
        </div>

        <script is:inline>
            // Premium会員のみ三連複昨日の結果を表示
            (function() {
                // user-plan（ハイフン）からJSON取得
                const userPlanData = localStorage.getItem('user-plan');
                let userPlan = null;

                if (userPlanData) {
                    try {
                        const data = JSON.parse(userPlanData);
                        userPlan = data.plan;
                    } catch (e) {
                        console.error('user-plan parse error:', e);
                    }
                }

                // フォールバック：userPlan（キャメルケース）も確認
                if (!userPlan) {
                    userPlan = localStorage.getItem('userPlan');
                }

                const sanrenpukuSection = document.getElementById('sanrenpuku-yesterday-results');

                if (sanrenpukuSection) {
                    // 🔧 2025-12-01修正: Premium会員・Premium Sanrenpuku会員のみ三連複結果を表示（Comboは非表示）
                    if (userPlan === 'Premium' || userPlan === 'Premium Sanrenpuku') {
                        sanrenpukuSection.style.display = 'block';
                        console.log('✅ 三連複昨日の結果表示: ' + userPlan + '会員');
                    } else if (userPlan === 'Premium Combo') {
                        console.log('🚫 三連複昨日の結果非表示: Premium Combo会員（/premium-sanrenpuku/で閲覧可能）');
                    }
                }
            })();
        </script>

        <script is:inline>
            // Premium Combo・Premium Sanrenpuku会員は三連複CTAを非表示
            document.addEventListener('DOMContentLoaded', function() {
                // user-plan（ハイフン）からJSON取得
                const userPlanData = localStorage.getItem('user-plan');
                let userPlan = null;

                if (userPlanData) {
                    try {
                        const data = JSON.parse(userPlanData);
                        userPlan = data.plan;
                    } catch (e) {
                        console.error('user-plan parse error:', e);
                    }
                }

                // フォールバック：userPlan（キャメルケース）も確認
                if (!userPlan) {
                    userPlan = localStorage.getItem('userPlan');
                }

                console.log('🔍 CTA制御: userPlan =', userPlan);

                const sanrenpukuCta = document.getElementById('sanrenpuku-cta-section');
                console.log('📍 sanrenpuku-cta-section要素:', sanrenpukuCta);

                // Premium Combo・Premium Sanrenpuku会員はCTA非表示
                if (userPlan === 'Premium Combo' || userPlan === 'Premium Sanrenpuku') {
                    if (sanrenpukuCta) {
                        sanrenpukuCta.style.display = 'none';
                        console.log('✅ 三連複CTA非表示完了');
                    } else {
                        console.error('❌ sanrenpuku-cta-section要素が見つかりません');
                    }
                } else {
                    console.log('ℹ️ 三連複CTA表示（プラン:', userPlan, ')');
                }
            });
        </script>

        <script is:inline>
            // 🔒 三連複AI推奨買い目セクション（.sanrenpuku-section）のアクセス制御
            // 対象プラン: Premium Sanrenpuku / Premium Combo / Premium + lifetimeSanrenpuku === true
            // 馬単のみのプラン (Premium / Premium Predictions など) には絞り込み買い目を出さない。
            (function gateSanrenpukuRecommendations() {
                function readPlanState() {
                    // 1. test_subscription_*（本番互換）
                    try {
                        const testKey = Object.keys(localStorage).find(k => k.startsWith('test_subscription_'));
                        if (testKey) {
                            const t = JSON.parse(localStorage.getItem(testKey));
                            return { plan: t.planType, lifetimeSanrenpuku: !!t.lifetimeSanrenpuku };
                        }
                    } catch (e) { /* noop */ }

                    // 2. user-plan（新形式・JSON）
                    try {
                        const raw = localStorage.getItem('user-plan');
                        if (raw) {
                            const u = JSON.parse(raw);
                            return { plan: u.plan, lifetimeSanrenpuku: !!u.lifetimeSanrenpuku };
                        }
                    } catch (e) { /* noop */ }

                    // 3. userPlan（旧キャメルケース）
                    const legacy = localStorage.getItem('userPlan');
                    return { plan: legacy || null, lifetimeSanrenpuku: false };
                }

                function isSanrenpukuEligible(plan, lifetimeSanrenpuku) {
                    if (!plan) return false;
                    if (plan === 'Premium Sanrenpuku') return true;
                    if (plan === 'Premium Combo') return true;
                    if ((plan === 'Premium' || plan === 'premium') && lifetimeSanrenpuku === true) return true;
                    return false;
                }

                function applyGate() {
                    const { plan, lifetimeSanrenpuku } = readPlanState();
                    const eligible = isSanrenpukuEligible(plan, lifetimeSanrenpuku);
                    console.log('🔒 三連複買い目アクセス制御:', { plan, lifetimeSanrenpuku, eligible });
                    if (!eligible) return; // CSS で既に非表示
                    document.querySelectorAll('.sanrenpuku-section').forEach((el) => {
                        el.classList.add('srp-access-granted');
                    });
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', applyGate);
                } else {
                    applyGate();
                }
            })();
        </script>

        <!-- 本日の傾向分析（AI自動判定） -->
        <div class="daily-analysis-section">
            <h3 class="analysis-title">🔍 本日の傾向分析（AI自動判定）</h3>
            <p class="analysis-subtitle">本命スコア・対抗との差・混戦度を合成したレース信頼度で自動分類しています</p>

            <div class="analysis-stats">
                <div class="stat-card high-confidence">
                    <div class="stat-icon">⭐</div>
                    <div class="stat-content">
                        <div class="stat-number">{highConfidenceRaces.length}</div>
                        <div class="stat-label">高信頼度レース</div>
                        <div class="stat-description">本命候補が比較的明確</div>
                    </div>
                </div>

                <div class="stat-card upset-mode">
                    <div class="stat-icon">💰</div>
                    <div class="stat-content">
                        <div class="stat-number">{upsetModeRaces.length}</div>
                        <div class="stat-label">高配当モードレース</div>
                        <div class="stat-description">上位拮抗・波乱含み</div>
                    </div>
                </div>

                <div class="stat-card normal">
                    <div class="stat-icon">📊</div>
                    <div class="stat-content">
                        <div class="stat-number">{normalRaces.length}</div>
                        <div class="stat-label">通常レース</div>
                        <div class="stat-description">標準的なAI推奨レース</div>
                    </div>
                </div>
            </div>

            <div class="auto-insight">
                <div class="insight-icon">💡</div>
                <div class="insight-text">{autoInsight}</div>
            </div>

            {/* レース別詳細リスト */}
            <div class="race-classification-list">
                {highConfidenceRaces.length > 0 && (
                    <div class="classification-group">
                        <div class="classification-header high">
                            <span class="badge">⭐ 高信頼度</span>
                            <span class="count">{highConfidenceRaces.length}レース</span>
                        </div>
                        <div class="race-chips">
                            {highConfidenceRaces.map((race) => (
                                <div class="race-chip high">
                                    <span class="chip-race">{race.raceNumber}</span>
                                    <span class="chip-score">{race.confidenceScore}pt</span>
                                </div>
                            ))}
                        </div>
                    </div>
                )}

                {normalRaces.length > 0 && (
                    <div class="classification-group">
                        <div class="classification-header normal">
                            <span class="badge">📊 通常</span>
                            <span class="count">{normalRaces.length}レース</span>
                        </div>
                        <div class="race-chips">
                            {normalRaces.map((race) => (
                                <div class="race-chip normal">
                                    <span class="chip-race">{race.raceNumber}</span>
                                    <span class="chip-score">{race.confidenceScore}pt</span>
                                </div>
                            ))}
                        </div>
                    </div>
                )}

                {upsetModeRaces.length > 0 && (
                    <div class="classification-group">
                        <div class="classification-header upset">
                            <span class="badge">💰 高配当モード</span>
                            <span class="count">{upsetModeRaces.length}レース</span>
                        </div>
