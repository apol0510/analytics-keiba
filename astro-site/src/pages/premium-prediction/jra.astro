<BaseLayout
  title="中央競馬プロ予想 - KEIBA Analytics"
  description="KEIBA Analytics 中央競馬（JRA）のプロフェッショナルAI予想。機械学習モデルによる全レース詳細分析と馬単買い目を提供。"
>
  <AccessControl requiredPlan="premium" venue="jra">
    <section class="prediction-section">
      <div class="container">
        {error && (
          <div class="error-card">
            <h1>エラー</h1>
            <p>{error}</p>
            <a href="/admin/prediction-converter/" class="btn btn-primary">予想データを作成</a>
          </div>
        )}

        {predictionData && (
          <>
            <!-- ページヘッダー（nankan版と統一） -->
            <div class="header-section">
              <div class="ai-badge">
                <span class="pulse"></span>
                <span class="ai-status">AI分析完了</span>
              </div>
              <h1 class="race-title">
                {isMultiVenue ? (
                  <>{predictionData.date} 中央競馬（JRA） {venues.length}会場 - 全{totalAnalyzedRaces}レース総合予想</>
                ) : (
                  <>{predictionData.eventInfo.date} {predictionData.eventInfo.venue} - 全{venues[0]?.predictions?.length || 0}レース総合予想</>
                )}
              </h1>
              <div class="ai-metrics">
                <div class="metric">
                  <div class="metric-value">{totalAnalyzedRaces}</div>
                  <div class="metric-label">分析レース数</div>
                </div>
                <div class="metric">
                  <div class="metric-value">全レース対応</div>
                  <div class="metric-label">AI精密分析</div>
                </div>
                <div class="metric">
                  <div class="metric-value">馬単</div>
                  <div class="metric-label">AI推奨買い目</div>
                </div>
                <div class="metric">
                  <div class="metric-value">機械学習モデル</div>
                  <div class="metric-label">AI予想システム</div>
                </div>
              </div>
            </div>

            <!-- 穴馬ページリンク -->
            <div class="dark-horse-link-section">
              <a href="/dark-horse-picks/?category=jra" class="dark-horse-link-btn">
                <span class="dark-horse-icon">🐎</span>
                <div class="dark-horse-text">
                  <span class="dark-horse-title">本日の穴馬抽出ツール</span>
                  <span class="dark-horse-subtitle">AI予想から狙い目の穴馬を自動抽出</span>
                </div>
                <span class="dark-horse-arrow">→</span>
              </a>
            </div>

            <!-- プレミアム会員バッジ -->
            <div class="premium-status">
              <span class="premium-icon">👑</span>
              <span class="premium-status-text">プレミアム会員限定コンテンツ</span>
            </div>

            <!-- 会場ごとの表示エリア -->
            {venues.map((venueData, venueIndex) => {
              const venuePredictions = venueData.predictions;
              const venueInfo = venueData.eventInfo;

              // AK専用3項目の素材: shared featureScores を会場単位で1回ロード（読むだけ）。
              // 無ければ null → 各馬は既存 e.importance fallback。
              const fsDate = venueInfo?.date || predictionData?.date || predictionData?.eventInfo?.date || null;
              const featureScoresData = loadFeatureScores('jra', fsDate, venueCodeFromName('jra', venueInfo?.venue));

              return (
                <div class={`venue-content ${venueIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex}>

                  {/* 本日の傾向分析（AI自動判定）— 会場ごと */}
                  {venueAnalysis[venueIndex] && (
                    <div class="daily-analysis-section">
                      <h3 class="analysis-title">🔍 本日の傾向分析（AI自動判定）</h3>
                      <p class="analysis-subtitle">本命スコア・対抗との差・混戦度を合成したレース信頼度で自動分類しています</p>

