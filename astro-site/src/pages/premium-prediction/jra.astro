    }
    .ai-pick-section .star-row {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      line-height: 1;
    }
    .ai-pick-section .star {
      font-size: 1.6rem;
      line-height: 1;
    }
    .ai-pick-section .star-filled {
      color: #fbbf24;
      text-shadow: 0 0 10px rgba(251, 191, 36, 0.55);
    }
    .ai-pick-section .star-empty {
      color: rgba(148, 163, 184, 0.35);
    }
    .ai-pick-section .confidence-num {
      font-size: 0.95rem;
      font-weight: 700;
      color: #cbd5e1;
      letter-spacing: 0.02em;
      opacity: 0.85;
    }
    .ai-pick-section .horse-card-main .confidence-num {
      color: #d1fae5;
      opacity: 1;
    }
    .ai-pick-section .basic-info {
      margin-top: 18px;
      padding: 14px 16px;
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 10px;
    }
    .ai-pick-section .basic-info h4,
    .ai-pick-section .eval-points h4 {
      color: #cbd5e1;
      font-size: 0.9rem;
      font-weight: 700;
      margin: 0 0 10px;
      letter-spacing: 0.04em;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .ai-pick-section .basic-info h4::before { content: "📋"; }
    .ai-pick-section .eval-points h4::before { content: "🎯"; }
    .ai-pick-section .horse-card-main .basic-info {
      background: rgba(15, 23, 42, 0.55);
      border-color: rgba(16, 185, 129, 0.28);
    }
    .ai-pick-section .info-grid {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .ai-pick-section .info-line {
      display: flex;
      align-items: baseline;
      gap: 8px;
      font-size: 0.92rem;
      color: #e2e8f0;
      line-height: 1.4;
    }
    .ai-pick-section .info-line-primary {
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 4px;
    }
    .ai-pick-section .info-chip {
      display: inline-block;
      background: rgba(59, 130, 246, 0.18);
      color: #bfdbfe;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .ai-pick-section .horse-card-main .info-chip {
      background: rgba(16, 185, 129, 0.2);
      color: #d1fae5;
      border-color: rgba(16, 185, 129, 0.4);
    }
    .ai-pick-section .info-key {
      color: #94a3b8;
      font-size: 0.82rem;
      font-weight: 600;
      min-width: 48px;
      flex-shrink: 0;
    }
    .ai-pick-section .info-val {
      color: #e2e8f0;
      font-weight: 600;
    }
    .ai-pick-section .info-val-strong {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 800;
      font-size: 1rem;
    }
    .ai-pick-section .eval-points {
      margin-top: 14px;
      padding: 14px 16px;
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 10px;
    }
    .ai-pick-section .horse-card-main .eval-points {
      background: rgba(15, 23, 42, 0.55);
      border-color: rgba(16, 185, 129, 0.28);
    }
    .ai-pick-section .eval-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .ai-pick-section .eval-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 5px 12px;
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.18) 0%, rgba(59, 130, 246, 0.18) 100%);
      border: 1px solid rgba(16, 185, 129, 0.4);
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #d1fae5;
    }
    .ai-pick-section .eval-tag::before {
      content: "✓";
      color: #10b981;
      font-weight: 900;
    }
    .ai-pick-section .horse-card-main .eval-tag {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(34, 197, 94, 0.2) 100%);
      border-color: rgba(16, 185, 129, 0.55);
      box-shadow: 0 2px 8px rgba(16, 185, 129, 0.2);
    }
    .ai-pick-section .feature-importance {
      margin-top: 20px;
    }
    .ai-pick-section .feature-importance h4 {
      color: #cbd5e1;
      font-size: 0.9rem;
      font-weight: 700;
      margin: 0 0 10px;
      letter-spacing: 0.04em;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .ai-pick-section .feature-importance h4::before { content: "📊"; }
    .ai-pick-section .importance-list {
      display: grid;
      gap: 12px;
    }
    .ai-pick-section .importance-item {
      display: flex;
      align-items: center;
      gap: 15px;
    }
    .ai-pick-section .importance-label {
      min-width: 120px;
      color: #94a3b8;
      font-size: 0.9rem;
      font-weight: 500;
    }
    .ai-pick-section .importance-bar {
      flex: 1;
      height: 16px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(148, 163, 184, 0.2);
    }
    .ai-pick-section .importance-fill {
      height: 100%;
      background: linear-gradient(90deg, #10b981 0%, #3b82f6 50%, #8b5cf6 100%);
      border-radius: 7px;
      transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      position: relative;
      box-shadow:
        0 0 8px rgba(59, 130, 246, 0.5) inset,
        0 0 12px rgba(139, 92, 246, 0.3);
    }
    .ai-pick-section .importance-fill::after {
      content: "";
      position: absolute;
      top: 0; right: 0; bottom: 0;
      width: 18px;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45));
      border-top-right-radius: 7px;
      border-bottom-right-radius: 7px;
    }
    .ai-pick-section .horse-card-main .importance-fill {
      background: linear-gradient(90deg, #22c55e 0%, #10b981 45%, #3b82f6 100%);
      box-shadow:
        0 0 10px rgba(16, 185, 129, 0.55) inset,
        0 0 14px rgba(16, 185, 129, 0.35);
    }
    .ai-pick-section .importance-percent {
      min-width: 42px;
      text-align: right;
      color: #e2e8f0;
      font-weight: 700;
      font-size: 0.85rem;
    }
    @media (max-width: 768px) {
      .ai-pick-section .horse-stats-row {
        grid-template-columns: 1fr;
        gap: 8px;
        margin-top: 14px;
        margin-bottom: 14px;
      }
      .ai-pick-section .stat-value { font-size: 1.4rem; }
      .ai-pick-section .star { font-size: 1.4rem; }
      .ai-pick-section .horse-mark-main { font-size: 2rem; }
      .ai-pick-section .importance-item { gap: 8px; }
      .ai-pick-section .importance-label { min-width: 70px; font-size: 0.8rem; }
      .ai-pick-section .importance-bar { height: 14px; }
      .ai-pick-section .importance-percent { min-width: 36px; font-size: 0.78rem; }
    }

    .detailed-horse-card {
      margin-bottom: var(--spacing-lg);
      padding: var(--spacing-lg);
      background: var(--bg-tertiary);
      border-radius: var(--radius-md);
      border: 2px solid var(--border-color);
    }

    .detailed-horse-card.honmei {
      border-color: #3b82f6;
    }

    .detailed-horse-card.taikou {
      border-color: #8b5cf6;
    }

    .detailed-horse-card.tanana {
      border-color: #f59e0b;
    }

    .dhc-header {
      margin-bottom: var(--spacing-md);
    }

    .dhc-info-card {
      background: rgba(30, 41, 59, 0.5);
      padding: var(--spacing-md);
      border-radius: var(--radius-sm);
    }

    .dhc-title-line {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-md);
      flex-wrap: wrap;
    }

    .dhc-mark-mobile {
      font-size: 1.5rem;
      font-weight: 900;
    }

    .detailed-horse-card.honmei .dhc-mark-mobile {
      color: #3b82f6;
    }

    .detailed-horse-card.taikou .dhc-mark-mobile {
      color: #8b5cf6;
    }

    .detailed-horse-card.tanana .dhc-mark-mobile {
      color: #f59e0b;
    }

    .dhc-number {
      font-size: 1.25rem;
      font-weight: 900;
      color: #60a5fa;
      font-family: 'Courier New', monospace;
      padding: 4px 12px;
      background: rgba(96, 165, 250, 0.15);
      border: 2px solid rgba(96, 165, 250, 0.4);
      border-radius: var(--radius-sm);
    }

    .dhc-name {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--text-primary);
      flex: 1;
    }

    .dhc-role-badge {
      padding: 4px 12px;
      background: rgba(139, 92, 246, 0.2);
      border: 1px solid rgba(139, 92, 246, 0.5);
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 600;
      color: #a78bfa;
    }

    .dhc-pt {
      padding: 4px 12px;
      background: rgba(16, 185, 129, 0.2);
      border: 1px solid rgba(16, 185, 129, 0.5);
      border-radius: 12px;
      font-size: 0.75rem;
      font-weight: 700;
      color: #10b981;
      font-family: 'Courier New', monospace;
    }

    .dhc-quick-metrics {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-sm);
    }

    .qm-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .qm-label {
      font-size: 0.65rem;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .qm-value {
      font-size: 1rem;
      font-weight: 800;
      color: var(--text-primary);
      font-family: 'Courier New', monospace;
    }

    .qm-value.risk-low { color: #10b981; }
    .qm-value.risk-medium { color: #f59e0b; }
    .qm-value.risk-high { color: #ef4444; }
    .qm-value.positive { color: #10b981; }
    .qm-value.negative { color: #ef4444; }

    .dhc-features {
      margin-top: var(--spacing-md);
    }

    .feature-title {
      font-size: 0.875rem;
      font-weight: 700;
      color: #60a5fa;
      margin-bottom: var(--spacing-sm);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .feature-grid {
      display: grid;
      gap: var(--spacing-sm);
    }

    .feature-item {
      display: grid;
      grid-template-columns: 180px 1fr 60px;
      align-items: center;
      gap: var(--spacing-sm);
      padding: var(--spacing-xs);
      background: rgba(0, 0, 0, 0.2);
      border-radius: var(--radius-sm);
    }

    .feature-label {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      font-size: 0.75rem;
      color: var(--text-secondary);
    }

    .feature-icon {
      font-size: 1rem;
    }

    .feature-bar-container {
      position: relative;
      height: 6px;
      background: rgba(0, 0, 0, 0.4);
      border-radius: 3px;
      overflow: hidden;
    }

    .feature-bar {
      height: 100%;
      background: linear-gradient(90deg, #3b82f6, #8b5cf6);
      border-radius: 3px;
      transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .feature-bar-container.trend {
      background: linear-gradient(90deg,
        rgba(239, 68, 68, 0.3) 0%,
        rgba(0, 0, 0, 0.4) 50%,
        rgba(16, 185, 129, 0.3) 100%);
    }

    .feature-bar-center {
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      background: rgba(255, 255, 255, 0.3);
    }

    .feature-bar.trend {
      position: absolute;
      top: 0;
      height: 100%;
    }

    .feature-value {
      font-size: 0.75rem;
      font-weight: 800;
      color: #60a5fa;
      font-family: 'Courier New', monospace;
      text-align: right;
    }

    .info-card {
      max-width: 900px;
      margin: var(--spacing-2xl) auto 0;
      padding: var(--spacing-xl);
      background: var(--bg-secondary);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .info-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-lg);
    }

    .info-icon {
      font-size: 1.5rem;
    }

    .info-header h3 {
      font-size: 1.125rem;
      color: #60a5fa;
      font-weight: 800;
    }

    .info-content {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
    }

    .tech-section h4 {
      font-size: 0.875rem;
      color: #a78bfa;
      margin-bottom: var(--spacing-sm);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 700;
    }

    .tech-section ul {
      list-style: none;
      padding-left: 0;
    }

    .tech-section li {
      margin-bottom: var(--spacing-xs);
      padding-left: var(--spacing-md);
      position: relative;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--text-secondary);
    }

    .tech-section li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: #3b82f6;
    }

    .tech-section strong {
      color: var(--text-primary);
      font-family: 'Courier New', monospace;
    }

    .disclaimer {
      padding: var(--spacing-md);
      background: rgba(239, 68, 68, 0.1);
      border-radius: var(--radius-md);
    }

    .disclaimer h4 {
      font-size: 0.875rem;
      color: #fca5a5;
      margin-bottom: var(--spacing-sm);
      font-weight: 700;
    }

    .disclaimer p {
      font-size: 0.8125rem;
      line-height: 1.6;
      color: var(--text-secondary);
    }

    .error-card {
      text-align: center;
      padding: var(--spacing-2xl);
      background: var(--bg-secondary);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(239, 68, 68, 0.5);
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* レスポンシブ */
    @media (max-width: 768px) {
      .page-title {
        font-size: 1.5rem;
      }

      .betting-grid {
        grid-template-columns: 1fr;
      }

      .dhc-quick-metrics {
        grid-template-columns: repeat(2, 1fr);
      }

      .feature-item {
        grid-template-columns: 1fr;
        gap: var(--spacing-xs);
      }

      .feature-label {
        justify-content: space-between;
      }
    }

    /* ================================================================
       nankan 構造準拠ヘッダー/分析セクション CSS（jra.astro 末尾で上書き）
       既存の .ai-badge / .metric-* 定義を上書きする
       ================================================================ */
    .header-section {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%);
      border-radius: 20px;
      padding: 40px;
      margin-bottom: 40px;
      border: 1px solid rgba(139, 92, 246, 0.2);
      text-align: center;
    }
    .header-section .ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 8px 20px;
      border-radius: 25px;
      margin-bottom: 20px;
      color: inherit;
      font-size: inherit;
      letter-spacing: normal;
    }
    .header-section .pulse {
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
      animation: ak-pulse 2s infinite;
    }
    @keyframes ak-pulse {
      0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
      100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .header-section .ai-status {
      color: #10b981;
      font-weight: 600;
      font-size: 0.9rem;
    }
    .header-section .race-title {
      font-size: 2.5rem;
      font-weight: 800;
      background: linear-gradient(135deg, #8b5cf6, #3b82f6);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 30px;
      line-height: 1.2;
    }
    .header-section .ai-metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }
    .header-section .metric {
      text-align: center;
      padding: 20px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 15px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .header-section .metric-value {
      font-size: 2rem;
      font-weight: 800;
      color: #3b82f6;
      margin-bottom: 5px;
    }
    .header-section .metric-label {
      color: #94a3b8;
      font-size: 0.9rem;
      font-weight: 500;
    }

    /* 穴馬ページリンク */
    .dark-horse-link-section {
      margin-bottom: 30px;
    }
    .dark-horse-link-btn {
      display: flex;
      align-items: center;
      gap: 15px;
      background: linear-gradient(135deg, #f59e0b, #ea580c);
      border: 1px solid rgba(245, 158, 11, 0.3);
      border-radius: 16px;
      padding: 20px 24px;
      text-decoration: none;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .dark-horse-link-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(245, 158, 11, 0.4);
      border-color: rgba(245, 158, 11, 0.5);
    }
    .dark-horse-icon {
      font-size: 2rem;
      flex-shrink: 0;
    }
    .dark-horse-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }
    .dark-horse-title {
      color: white;
      font-size: 1.1rem;
      font-weight: 700;
      line-height: 1.2;
    }
    .dark-horse-subtitle {
      color: rgba(255, 255, 255, 0.85);
      font-size: 0.9rem;
      line-height: 1.3;
    }
    .dark-horse-arrow {
      color: white;
      font-size: 1.5rem;
      font-weight: 700;
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }
    .dark-horse-link-btn:hover .dark-horse-arrow {
      transform: translateX(5px);
    }

    /* プレミアム会員バッジ */
    .premium-status {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #f59e0b;
      padding: 12px 40px;
      border-radius: 25px;
      margin: 0 auto 30px;
      font-weight: 600;
      backdrop-filter: blur(8px);
      max-width: 600px;
    }
    .premium-icon {
      font-size: 1.1rem;
      filter: saturate(1.5);
    }
    .premium-status-text {
      font-size: 0.9rem;
      letter-spacing: 0.05em;
    }

    /* 本日の傾向分析（AI自動判定） */
    .daily-analysis-section {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.95) 0%, rgba(15, 23, 42, 0.95) 100%);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 16px;
      padding: 30px;
