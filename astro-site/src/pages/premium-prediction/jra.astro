    .ai-pick-section .horse-card-sub .horse-number {
      width: 36px;
      height: 36px;
    }
    .ai-pick-section .horse-name {
      font-size: 1.2rem;
      font-weight: 700;
      color: #e2e8f0;
    }
    .ai-pick-section .horse-card-main .horse-name {
      font-size: 1.45rem;
      font-weight: 900;
      color: #f0fdf4;
      text-shadow: 0 1px 6px rgba(16, 185, 129, 0.35);
    }
    .ai-pick-section .horse-stats-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 18px;
      margin-bottom: 18px;
    }
    .ai-pick-section .stat-block {
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 10px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .ai-pick-section .horse-card-main .stat-block {
      background: rgba(15, 23, 42, 0.6);
      border-color: rgba(16, 185, 129, 0.35);
    }
    .ai-pick-section .horse-card-sub .stat-block {
      border-color: rgba(59, 130, 246, 0.3);
    }
    .ai-pick-section .stat-label {
      font-size: 0.78rem;
      color: #94a3b8;
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .ai-pick-section .stat-value {
      font-size: 1.6rem;
      font-weight: 900;
      line-height: 1;
      color: #e2e8f0;
    }
    .ai-pick-section .stat-score {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .ai-pick-section .stat-index {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .ai-pick-section .stat-unit {
      font-size: 0.8rem;
      font-weight: 700;
      margin-left: 4px;
      -webkit-text-fill-color: #f59e0b;
    }
    .ai-pick-section .star-rating {
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
      line-height: 1;
      flex-wrap: wrap;
    }
    .ai-pick-section .star-row {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      line-height: 1;
    }
    .ai-pick-section .star {
      font-size: 1.6rem;
      line-height: 1;
    }
    .ai-pick-section .star-filled {
      color: #fbbf24;
      text-shadow: 0 0 10px rgba(251, 191, 36, 0.55);
    }
    .ai-pick-section .star-empty {
      color: rgba(148, 163, 184, 0.35);
    }
    .ai-pick-section .confidence-num {
      font-size: 0.95rem;
      font-weight: 700;
      color: #cbd5e1;
      letter-spacing: 0.02em;
      opacity: 0.85;
    }
    .ai-pick-section .horse-card-main .confidence-num {
      color: #d1fae5;
      opacity: 1;
    }
    .ai-pick-section .basic-info {
      margin-top: 18px;
      padding: 14px 16px;
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 10px;
    }
    .ai-pick-section .basic-info h4,
    .ai-pick-section .eval-points h4 {
      color: #cbd5e1;
      font-size: 0.9rem;
      font-weight: 700;
      margin: 0 0 10px;
      letter-spacing: 0.04em;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .ai-pick-section .basic-info h4::before { content: "📋"; }
    .ai-pick-section .eval-points h4::before { content: "🎯"; }
    .ai-pick-section .horse-card-main .basic-info {
      background: rgba(15, 23, 42, 0.55);
      border-color: rgba(16, 185, 129, 0.28);
    }
    .ai-pick-section .info-grid {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .ai-pick-section .info-line {
      display: flex;
      align-items: baseline;
      gap: 8px;
      font-size: 0.92rem;
      color: #e2e8f0;
      line-height: 1.4;
    }
    .ai-pick-section .info-line-primary {
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 4px;
    }
    .ai-pick-section .info-chip {
      display: inline-block;
      background: rgba(59, 130, 246, 0.18);
      color: #bfdbfe;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .ai-pick-section .horse-card-main .info-chip {
      background: rgba(16, 185, 129, 0.2);
      color: #d1fae5;
      border-color: rgba(16, 185, 129, 0.4);
    }
    .ai-pick-section .info-key {
      color: #94a3b8;
      font-size: 0.82rem;
      font-weight: 600;
      min-width: 48px;
      flex-shrink: 0;
    }
    .ai-pick-section .info-val {
      color: #e2e8f0;
      font-weight: 600;
    }
    .ai-pick-section .info-val-strong {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 800;
      font-size: 1rem;
    }
    .ai-pick-section .eval-points {
      margin-top: 14px;
      padding: 14px 16px;
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 10px;
    }
    .ai-pick-section .horse-card-main .eval-points {
      background: rgba(15, 23, 42, 0.55);
      border-color: rgba(16, 185, 129, 0.28);
    }
    .ai-pick-section .eval-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .ai-pick-section .eval-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 5px 12px;
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.18) 0%, rgba(59, 130, 246, 0.18) 100%);
      border: 1px solid rgba(16, 185, 129, 0.4);
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #d1fae5;
    }
    .ai-pick-section .eval-tag::before {
      content: "✓";
      color: #10b981;
      font-weight: 900;
    }
    .ai-pick-section .horse-card-main .eval-tag {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(34, 197, 94, 0.2) 100%);
      border-color: rgba(16, 185, 129, 0.55);
      box-shadow: 0 2px 8px rgba(16, 185, 129, 0.2);
    }
    .ai-pick-section .feature-importance {
      margin-top: 20px;
    }
    .ai-pick-section .feature-importance h4 {
      color: #cbd5e1;
      font-size: 0.9rem;
      font-weight: 700;
      margin: 0 0 10px;
      letter-spacing: 0.04em;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .ai-pick-section .feature-importance h4::before { content: "📊"; }
    .ai-pick-section .importance-list {
      display: grid;
      gap: 12px;
    }
    .ai-pick-section .importance-item {
      display: flex;
      align-items: center;
      gap: 15px;
    }
    .ai-pick-section .importance-label {
      min-width: 120px;
      color: #94a3b8;
      font-size: 0.9rem;
      font-weight: 500;
    }
    .ai-pick-section .importance-bar {
      flex: 1;
      height: 16px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(148, 163, 184, 0.2);
    }
    .ai-pick-section .importance-fill {
      height: 100%;
      background: linear-gradient(90deg, #10b981 0%, #3b82f6 50%, #8b5cf6 100%);
      border-radius: 7px;
      transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      position: relative;
      box-shadow:
        0 0 8px rgba(59, 130, 246, 0.5) inset,
        0 0 12px rgba(139, 92, 246, 0.3);
    }
    .ai-pick-section .importance-fill::after {
      content: "";
      position: absolute;
      top: 0; right: 0; bottom: 0;
      width: 18px;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45));
      border-top-right-radius: 7px;
      border-bottom-right-radius: 7px;
    }
    .ai-pick-section .horse-card-main .importance-fill {
      background: linear-gradient(90deg, #22c55e 0%, #10b981 45%, #3b82f6 100%);
      box-shadow:
        0 0 10px rgba(16, 185, 129, 0.55) inset,
        0 0 14px rgba(16, 185, 129, 0.35);
    }
    .ai-pick-section .importance-percent {
      min-width: 42px;
      text-align: right;
      color: #e2e8f0;
      font-weight: 700;
      font-size: 0.85rem;
    }
    @media (max-width: 768px) {
      .ai-pick-section .horse-stats-row {
        grid-template-columns: 1fr;
        gap: 8px;
        margin-top: 14px;
        margin-bottom: 14px;
      }
      .ai-pick-section .stat-value { font-size: 1.4rem; }
      .ai-pick-section .star { font-size: 1.4rem; }
      .ai-pick-section .horse-mark-main { font-size: 2rem; }
      .ai-pick-section .importance-item { gap: 8px; }
      .ai-pick-section .importance-label { min-width: 70px; font-size: 0.8rem; }
      .ai-pick-section .importance-bar { height: 14px; }
      .ai-pick-section .importance-percent { min-width: 36px; font-size: 0.78rem; }
    }

    /* 旧 KI 風 詳細分析テーブル系の孤児 CSS は 2026-05-24
       クリーンアップで除去済み。
       新「特徴量重要度」表示は .ai-pick-section .feature-importance を使用。 */

    .info-card {
      max-width: 900px;
      margin: var(--spacing-2xl) auto 0;
      padding: var(--spacing-xl);
      background: var(--bg-secondary);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .info-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-lg);
    }

    .info-icon {
      font-size: 1.5rem;
    }

    .info-header h3 {
      font-size: 1.125rem;
      color: #60a5fa;
      font-weight: 800;
    }

    .info-content {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
    }

    .tech-section h4 {
      font-size: 0.875rem;
      color: #a78bfa;
      margin-bottom: var(--spacing-sm);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 700;
    }

    .tech-section ul {
      list-style: none;
      padding-left: 0;
    }

    .tech-section li {
      margin-bottom: var(--spacing-xs);
      padding-left: var(--spacing-md);
      position: relative;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--text-secondary);
    }

    .tech-section li::before {
      content: '▸';
      position: absolute;
      left: 0;
      color: #3b82f6;
    }

    .tech-section strong {
      color: var(--text-primary);
      font-family: 'Courier New', monospace;
    }

    .disclaimer {
      padding: var(--spacing-md);
      background: rgba(239, 68, 68, 0.1);
      border-radius: var(--radius-md);
    }

    .disclaimer h4 {
      font-size: 0.875rem;
      color: #fca5a5;
      margin-bottom: var(--spacing-sm);
      font-weight: 700;
    }

    .disclaimer p {
      font-size: 0.8125rem;
      line-height: 1.6;
      color: var(--text-secondary);
    }

    .error-card {
      text-align: center;
      padding: var(--spacing-2xl);
      background: var(--bg-secondary);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(239, 68, 68, 0.5);
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* レスポンシブ */
    @media (max-width: 768px) {
      .page-title {
        font-size: 1.5rem;
      }

      .betting-grid {
        grid-template-columns: 1fr;
      }

      /* 旧 KI 風 詳細分析テーブル系のレスポンシブ調整は
         孤児 CSS 削除に伴い不要。 */
    }

    /* ================================================================
       nankan 構造準拠ヘッダー/分析セクション CSS（jra.astro 末尾で上書き）
       既存の .ai-badge / .metric-* 定義を上書きする
       ================================================================ */
    .header-section {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%);
      border-radius: 20px;
      padding: 40px;
      margin-bottom: 40px;
      border: 1px solid rgba(139, 92, 246, 0.2);
      text-align: center;
    }
    .header-section .ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 8px 20px;
      border-radius: 25px;
      margin-bottom: 20px;
      color: inherit;
      font-size: inherit;
      letter-spacing: normal;
    }
    .header-section .pulse {
      width: 8px;
      height: 8px;
      background: #10b981;
      border-radius: 50%;
      animation: ak-pulse 2s infinite;
    }
    @keyframes ak-pulse {
