    .ai-pick-section .horse-card-main .stat-block {
      background: rgba(15, 23, 42, 0.6);
      border-color: rgba(16, 185, 129, 0.35);
    }
    .ai-pick-section .horse-card-sub .stat-block {
      border-color: rgba(59, 130, 246, 0.3);
    }
    .ai-pick-section .stat-label {
      font-size: 0.78rem;
      color: #94a3b8;
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .ai-pick-section .stat-value {
      font-size: 1.6rem;
      font-weight: 900;
      line-height: 1;
      color: #e2e8f0;
    }
    .ai-pick-section .stat-score {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
