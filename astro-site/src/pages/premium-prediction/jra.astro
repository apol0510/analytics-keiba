  <script is:inline>
    function selectVenue(event, button) {
      event.preventDefault();

      const venueIndex = button.getAttribute('data-venue-index');

      // 会場タブの切り替え
      document.querySelectorAll('.venue-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      button.classList.add('active');

      // 会場コンテンツの切り替え
      document.querySelectorAll('.venue-content').forEach(content => {
        content.classList.remove('active');
      });

      const selectedVenue = document.querySelector(`.venue-content[data-venue-index="${venueIndex}"]`);
      if (selectedVenue) {
        selectedVenue.classList.add('active');
        // 会場切替時にレースを自動 open しない（全レース閉のまま維持）。
      }
      // 会場タブ切替では active 切替のみ。ページ最上部へスクロールしない（スクロール位置を維持）。
    }

    // レース切替: premium 南関と統一したアコーディオン開閉。
    // 同じ会場内で 1 つ開いたら他を閉じる。
    function toggleJraRace(venueIndex, raceIndex) {
      const content = document.getElementById(`race-v${venueIndex}-r${raceIndex}`);
      const icon = document.getElementById(`toggle-v${venueIndex}-r${raceIndex}`);
      if (!content || !icon) return;

      const currentVenue = document.querySelector(`.venue-content[data-venue-index="${venueIndex}"]`);

      // 同じ会場内の他アコーディオンを閉じる
      if (currentVenue) {
        currentVenue.querySelectorAll('.race-accordion-content').forEach(other => {
          if (other !== content) {
            other.style.maxHeight = '0px';
            other.style.opacity = '0';
            const otherIcon = document.getElementById(other.id.replace('race-v', 'toggle-v'));
            if (otherIcon) {
              otherIcon.textContent = '▼';
              otherIcon.style.transform = 'rotate(0deg)';
            }
          }
        });
      }

      const mh = content.style.maxHeight;
      const isClosed = mh === '0px' || mh === '';
      if (isClosed) {
        content.style.maxHeight = content.scrollHeight + 'px';
        content.style.opacity = '1';
        icon.textContent = '◎';
        icon.style.transform = 'rotate(180deg)';
        // カウンターアニメーション（開いたレースのみ）
        content.querySelectorAll('[data-counter]').forEach(el => {
          const target = parseInt(el.getAttribute('data-counter'));
          if (!isNaN(target)) animateCounter(el, target);
        });
      } else {
        // 初期 open（none）は一旦実高さの px に固定してから 0 へ畳むと滑らかに閉じる。
        if (mh === 'none') {
          content.style.maxHeight = content.scrollHeight + 'px';
          requestAnimationFrame(() => {
            content.style.maxHeight = '0px';
            content.style.opacity = '0';
          });
        } else {
          content.style.maxHeight = '0px';
          content.style.opacity = '0';
        }
        icon.textContent = '▼';
        icon.style.transform = 'rotate(0deg)';
      }
    }
    window.toggleJraRace = toggleJraRace;

    // 初期 open は廃止（全レース初期 closed）。会場切替でも自動 open しない。

    // 内側の過去走 <details>（過去5走 / 過去走データ）を後から開くと、親レース
    // アコーディオン (.race-accordion-content) の固定 maxHeight を超えてクリップされる
    // 問題を解消する（高さ再計算のみ・表示構造やデータは変更しない）。premium 南関 §R1d 準拠。
    function recalculateOpenAccordionHeightFrom(el) {
      const content = el && el.closest && el.closest('.race-accordion-content');
      if (!content) return;
      const mh = content.style.maxHeight;
      // 閉じている(0px/'')、または none（=内容量どおり開いておりクリップ無し）は再計算不要。
      if (mh === '0px' || mh === '' || mh === 'none') return;
      requestAnimationFrame(() => {
        content.style.maxHeight = content.scrollHeight + 'px';
      });
    }
    function bindRecentRacesAccordionRecalc() {
      // レース本文内の全 nested details（過去5走/過去走データ/不要馬・見送り馬 等）を監視し、
      // open/close 双方で親レースアコーディオンの固定 max-height を再計算してクリップを防ぐ。
      // 個別 class 列挙だと追加漏れ（例: ineligible-section）でクリップするため、全 details を対象にする。
      document.querySelectorAll('.race-accordion-content details').forEach(d => {
        if (d.dataset.r1dScrollBound === '1') return;
        d.dataset.r1dScrollBound = '1';
        d.addEventListener('toggle', () => {
          recalculateOpenAccordionHeightFrom(d);
          if (d.open) d.scrollIntoView({ block: 'nearest' });
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindRecentRacesAccordionRecalc);
    } else {
      bindRecentRacesAccordionRecalc();
    }

    // 親レース本文クリックで閉じる挙動は共有 <RaceAccordionClickClose /> に統一（ページ個別実装は撤去）。
    // 内側 details の本文クリック閉じは共有 <AccordionClickClose /> が担当。

    function animateCounter(element, target) {
      const duration = 1500;
      const start = 0;
      const startTime = Date.now();

      function update() {
        const now = Date.now();
        const progress = Math.min((now - startTime) / duration, 1);
        const easeProgress = 1 - Math.pow(1 - progress, 3);
        const current = Math.floor(easeProgress * target);
        element.textContent = current.toLocaleString();

        if (progress < 1) {
          requestAnimationFrame(update);
        }
      }

      update();
    }

    document.addEventListener('DOMContentLoaded', () => {
      // レースアコーディオンは初期状態すべて閉じる（自動 open しない）。

      // ユーザータイプチェック
      const isFreeUser = sessionStorage.getItem('isFreeUser') === 'true';
      const isLightUser = sessionStorage.getItem('isLightUser') === 'true';
      console.log('🔍 ユーザータイプ:', isFreeUser ? '無料会員' : isLightUser ? 'ライト会員' : 'プロ会員');

      if (isFreeUser) {
        // 無料ユーザー向け表示
        document.querySelectorAll('.free-user-betting').forEach(el => {
          el.classList.remove('hidden');
        });
        document.querySelectorAll('.bet-list.pro-user-only, .betting-formula.pro-user-only').forEach(el => {
          el.classList.add('hidden');
        });
        document.querySelectorAll('.light-user-restricted').forEach(el => {
          el.classList.add('hidden');
        });
        document.querySelectorAll('.pro-tag.pro-only').forEach(el => {
          el.textContent = '無料会員';
          el.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
        });
      } else if (isLightUser) {
        // ライトユーザー向け表示（メインレースのみ買い目表示）
        // メインレース判定: 12R→R11、10R→R9、8R→R7、それ以外は最終レース
        const getMainRaceNumber = (n) => n === 12 ? 11 : n === 10 ? 9 : n === 8 ? 7 : n;
        document.querySelectorAll('.betting-section.pro-exclusive').forEach(section => {
          const raceNumber = parseInt(section.dataset.raceNumber);
          const totalRaces = parseInt(section.dataset.totalRaces);
          const isMainRace = raceNumber === getMainRaceNumber(totalRaces);

          if (isMainRace) {
            // メインレース：プロと同じ買い目を表示
            section.querySelector('.bet-list.pro-user-only, .betting-formula.pro-user-only')?.classList.remove('hidden');
            section.querySelector('.free-user-betting')?.classList.add('hidden');
            section.querySelector('.light-user-restricted')?.classList.add('hidden');
          } else {
            // メインレース以外：制限メッセージを表示
            section.querySelector('.bet-list.pro-user-only, .betting-formula.pro-user-only')?.classList.add('hidden');
            section.querySelector('.free-user-betting')?.classList.add('hidden');
            section.querySelector('.light-user-restricted')?.classList.remove('hidden');
          }
        });
        document.querySelectorAll('.pro-tag.pro-only').forEach(el => {
          el.textContent = 'LIGHT';
          el.style.background = 'linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%)';
        });
      } else {
        // プロユーザー向け表示
        document.querySelectorAll('.free-user-betting').forEach(el => {
          el.classList.add('hidden');
        });
        document.querySelectorAll('.light-user-restricted').forEach(el => {
          el.classList.add('hidden');
        });
        document.querySelectorAll('.bet-list.pro-user-only, .betting-formula.pro-user-only').forEach(el => {
          el.classList.remove('hidden');
        });
      }
    });
  </script>
