// 最新の中央競馬予想JSONファイルを取得
const predictionsDir = join(process.cwd(), 'src', 'data', 'predictions', 'jra');
let predictionData = null;
let venues = [];
let isMultiVenue = false;
let error = null;

try {
  if (existsSync(predictionsDir)) {
    // 階層構造（jra/YYYY/MM/YYYY-MM-DD.json）から最新ファイルを検索
    const years = readdirSync(predictionsDir).filter(name => /^\d{4}$/.test(name));
    let latestFile = null;
    let latestPath = null;

    // 全ファイルを収集して日付でソート
    let allFiles = [];

    for (const year of years) {
      const yearPath = join(predictionsDir, year);
      const months = readdirSync(yearPath).filter(name => /^\d{2}$/.test(name));

      for (const month of months) {
        const monthPath = join(yearPath, month);
        const files = readdirSync(monthPath).filter(file => file.endsWith('.json') && /^\d{4}-\d{2}-\d{2}\.json$/.test(file));

        for (const file of files) {
          // ファイル名から日付を抽出（YYYY-MM-DD.json）
          const dateMatch = file.match(/^(\d{4}-\d{2}-\d{2})\.json$/);
          if (dateMatch) {
            allFiles.push({
              date: dateMatch[1],
              path: join(monthPath, file),
              timestamp: new Date(dateMatch[1]).getTime()
            });
          }
        }
      }
    }

    // 日付でソート（最新が先頭）
    allFiles.sort((a, b) => b.timestamp - a.timestamp);

    if (allFiles.length > 0) {
      latestFile = allFiles[0].date + '.json';
      latestPath = allFiles[0].path;
    }

    if (latestPath) {
      const fileContent = readFileSync(latestPath, 'utf-8');
      const rawData = JSON.parse(fileContent);

      // データ構造の判定（venues配列があるか）
      if (rawData.venues && Array.isArray(rawData.venues)) {
        // 複数会場フォーマット
        isMultiVenue = true;
        venues = rawData.venues;
        predictionData = rawData;
      } else if (rawData.eventInfo && rawData.predictions) {
        // 単一会場フォーマット（従来互換）
        isMultiVenue = false;
        venues = [{
          venue: rawData.eventInfo.venue,
          eventInfo: rawData.eventInfo,
          predictions: rawData.predictions
        }];
        predictionData = rawData;
      } else {
        throw new Error('予想データのフォーマットが不正です');
      }
    } else {
      throw new Error('中央競馬の予想データがありません');
    }
  } else {
    throw new Error('中央競馬の予想データフォルダが見つかりません');
  }
} catch (err) {
  error = err.message;
}

// generateAdvancedMetrics imported from featureScores.js

// 馬単買い目を生成する関数（横並び馬番号形式）
// メインレースは本命軸のみ・上位5頭・抑えなし（importPredictionJra.js の10点ロジックと一致）。
// 通常レースは本命軸 + 対抗軸の従来表示。
function generateUmatanBets(horses, raceNumber, venueRaces) {
  // pt値でソート（降順）
  const sortedHorses = [...horses].sort((a, b) => b.pt - a.pt);

  // 本命・対抗・単穴を特定
  const honmei = sortedHorses.find(h => h.role === '本命');
  const taikou = sortedHorses.find(h => h.role === '対抗');
  const tananaList = sortedHorses.filter(h => h.role === '単穴');

  if (!honmei) return null;

  // メインレース: 本命軸 1行 / 上位5頭 / 対抗軸ラインなし
  if (isMainRace(raceNumber, venueRaces)) {
    const top5 = getTop5Challengers(horses);
    const opponents = top5
      .map(h => h.horseNumber ?? h.number)
      .filter(n => n != null && n !== honmei.horseNumber);
    return {
      honmei: {
        axis: honmei.horseNumber,
        axisName: honmei.horseName,
        opponents
      },
      taikou: null
    };
  }

  if (!taikou) return null;

  // 連下候補（連下最上位・連下、および「抑え候補」と判定された補欠のみ）
  // ※ 補欠でも isOsaeCandidate=false（ci<45 など）は不要馬扱いのため買い目に含めない
  const renkaList = sortedHorses.filter(h =>
    h.role === '連下最上位' || h.role === '連下' || (h.role === '補欠' && isOsaeCandidate(h))
  );

  // 相手馬リスト作成
  const buildOpponents = (axis) => {
    const opponents = [];

    // 軸が本命の場合：対抗→単穴→連下
    // 軸が対抗の場合：本命→単穴→連下
    if (axis === 'honmei') {
      opponents.push(taikou.horseNumber);
      tananaList.forEach(h => opponents.push(h.horseNumber));
      renkaList.forEach(h => opponents.push(h.horseNumber));
    } else {
      opponents.push(honmei.horseNumber);
      tananaList.forEach(h => opponents.push(h.horseNumber));
      renkaList.forEach(h => opponents.push(h.horseNumber));
    }

    return opponents;
  };

  const honmeiOpponents = buildOpponents('honmei');
  const taikouOpponents = buildOpponents('taikou');

  return {
    honmei: {
      axis: honmei.horseNumber,
      axisName: honmei.horseName,
      opponents: honmeiOpponents
    },
    taikou: {
      axis: taikou.horseNumber,
      axisName: taikou.horseName,
      opponents: taikouOpponents
    }
  };
}

// =========================================================================
// 本日の傾向分析（AI自動判定）— 会場ごと
// nankan 版と同一ロジック（buildRaceConfidenceMetrics → classifyRaces）
// =========================================================================
const __clamp = (v, min, max) => Math.max(min, Math.min(max, v));

function buildRaceConfidenceMetrics(race) {
  const all = Array.isArray(race.horses) ? race.horses : [];
  const byRole = (role) => all.find((h) => h && h.role === role);
  const sortedPts = all
    .map((h) => Number(h?.pt) || 0)
    .filter((v) => v > 0)
    .sort((a, b) => b - a);
  const honmei = byRole('本命');
  const taikou = byRole('対抗');
  const honmeiScore = Number(honmei?.pt) || sortedPts[0] || 0;
  const taikouScore = Number(taikou?.pt) || sortedPts[1] || 0;
  const fifthScore = sortedPts[4] || sortedPts[sortedPts.length - 1] || 0;
  const fieldSize = Number(race?.raceInfo?.horseCount) || all.length || sortedPts.length;
  const scoreGap = honmeiScore - taikouScore;
  const topSpread = honmeiScore - fifthScore;
  const contenderThreshold = honmeiScore > 0 ? honmeiScore * 0.87 : 0;
  const contenderCount = sortedPts.slice(1).filter((p) => p >= contenderThreshold).length;
  const top5 = sortedPts.slice(0, 5);
  const top5Mean = top5.length > 0 ? top5.reduce((s, v) => s + v, 0) / top5.length : 0;
  const top5Var = top5.length > 0
    ? top5.reduce((s, v) => s + (v - top5Mean) ** 2, 0) / top5.length
    : 0;
  const top5Stdev = Math.sqrt(top5Var);
  const chaosScore = __clamp(Math.round(30 - top5Stdev * 2), 0, 30);
  const fieldPenalty = Math.max(0, fieldSize - 12) * 3;
  const rawConfidence =
    50 +
    scoreGap * 1.4 +
    topSpread * 0.35 +
    (honmeiScore - 145) * 0.5 -
    fieldPenalty -
    contenderCount * 1.5;
  const confidenceScore = __clamp(Math.round(rawConfidence), 0, 100);
  return {
    raceNumber: race.raceInfo?.raceNumber,
    raceName: race.raceInfo?.raceName,
    honmeiScore,
    taikouScore,
    scoreGap,
    topSpread,
    fieldSize,
    contenderCount,
    chaosScore,
    confidenceScore,
  };
}

const HIGH_CONF_THRESHOLD = 78;
const HIGH_CONF_GAP_MIN = 8;
const UPSET_CONF_THRESHOLD = 62;
const UPSET_GAP_MAX = 2;
const HIGH_CONF_MAX_COUNT = 4;

function classifyVenue(predictions) {
  const raceMetrics = (predictions || []).map(buildRaceConfidenceMetrics);
  const provisional = raceMetrics.map((m) => {
    let category;
    if (m.confidenceScore >= HIGH_CONF_THRESHOLD && m.scoreGap >= HIGH_CONF_GAP_MIN) {
      category = 'high';
    } else if (m.confidenceScore <= UPSET_CONF_THRESHOLD || m.scoreGap <= UPSET_GAP_MAX) {
      category = 'upset';
    } else {
      category = 'normal';
    }
    return { ...m, category };
  });
  const highCandidates = provisional
    .filter((m) => m.category === 'high')
    .sort((a, b) => b.confidenceScore - a.confidenceScore);
  if (highCandidates.length > HIGH_CONF_MAX_COUNT) {
    const keep = new Set(highCandidates.slice(0, HIGH_CONF_MAX_COUNT).map((m) => m.raceNumber));
    for (const m of provisional) {
      if (m.category === 'high' && !keep.has(m.raceNumber)) {
        m.category = 'normal';
      }
    }
  }
  const highConfidenceRaces = provisional.filter((m) => m.category === 'high');
  const upsetModeRaces = provisional.filter((m) => m.category === 'upset');
  const normalRaces = provisional.filter((m) => m.category === 'normal');
  let autoInsight = '';
  if (highConfidenceRaces.length >= 3) {
    autoInsight = `本日は本命候補が比較的明確なレースが${highConfidenceRaces.length}レースあります。AI推奨買い目で堅実な勝負がおすすめです。`;
  } else if (upsetModeRaces.length >= 3) {
    autoInsight = `本日は上位拮抗・波乱含みのレースが${upsetModeRaces.length}レースあります。AI推奨買い目で高配当のチャンスを狙えます。`;
  } else if (highConfidenceRaces.length > 0 && upsetModeRaces.length > 0) {
    autoInsight = `本日は本命明確なレース（${highConfidenceRaces.length}R）と上位拮抗レース（${upsetModeRaces.length}R）がバランス良く配置されています。AI推奨買い目をレースごとに確認してください。`;
  } else {
    autoInsight = '本日は標準的なレース構成です。各レースのAI推奨買い目を確認しながら勝負レースを絞り込んでください。';
  }
  return { highConfidenceRaces, upsetModeRaces, normalRaces, autoInsight };
}

const venueAnalysis = (venues || []).map((venueData) => classifyVenue(venueData.predictions));
const totalAnalyzedRaces = (venues || []).reduce((sum, v) => sum + (v.predictions?.length || 0), 0);
