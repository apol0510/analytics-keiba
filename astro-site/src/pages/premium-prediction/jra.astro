<BaseLayout
  title="中央競馬プロ予想 - KEIBA Intelligence"
  description="KEIBA Intelligence 中央競馬（JRA）のプロフェッショナルAI予想。機械学習モデルによる全レース詳細分析と馬単買い目を提供。"
>
  <AccessControl requiredPlan="premium" venue="jra">
    <section class="prediction-section">
      <div class="container">
        {error && (
          <div class="error-card">
            <h1>エラー</h1>
            <p>{error}</p>
            <a href="/admin/prediction-converter" class="btn btn-primary">予想データを作成</a>
          </div>
        )}

        {predictionData && (
          <>
            <!-- ページヘッダー（nankan版と統一） -->
            <div class="header-section">
              <div class="ai-badge">
                <span class="pulse"></span>
                <span class="ai-status">AI分析完了</span>
              </div>
              <h1 class="race-title">
                {isMultiVenue ? (
                  <>{predictionData.date} 中央競馬（JRA） {venues.length}会場 - 全{totalAnalyzedRaces}レース総合予想</>
                ) : (
                  <>{predictionData.eventInfo.date} {predictionData.eventInfo.venue} - 全{venues[0]?.predictions?.length || 0}レース総合予想</>
                )}
              </h1>
              <div class="ai-metrics">
                <div class="metric">
                  <div class="metric-value">{totalAnalyzedRaces}</div>
                  <div class="metric-label">分析レース数</div>
                </div>
                <div class="metric">
                  <div class="metric-value">全レース対応</div>
                  <div class="metric-label">AI精密分析</div>
                </div>
                <div class="metric">
                  <div class="metric-value">馬単</div>
                  <div class="metric-label">AI推奨買い目</div>
                </div>
                <div class="metric">
                  <div class="metric-value">機械学習モデル</div>
                  <div class="metric-label">AI予想システム</div>
                </div>
              </div>
            </div>

            <!-- 穴馬ページリンク -->
            <div class="dark-horse-link-section">
              <a href="/dark-horse-picks/" class="dark-horse-link-btn">
                <span class="dark-horse-icon">🐎</span>
                <div class="dark-horse-text">
                  <span class="dark-horse-title">本日の穴馬抽出ツール</span>
                  <span class="dark-horse-subtitle">AI予想から狙い目の穴馬を自動抽出</span>
                </div>
                <span class="dark-horse-arrow">→</span>
              </a>
            </div>

            <!-- プレミアム会員バッジ -->
            <div class="premium-status">
              <span class="premium-icon">👑</span>
              <span class="premium-status-text">プレミアム会員限定コンテンツ</span>
            </div>

            <!-- 会場ごとの表示エリア -->
            {venues.map((venueData, venueIndex) => {
              const venuePredictions = venueData.predictions;
              const venueInfo = venueData.eventInfo;

              return (
                <div class={`venue-content ${venueIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex}>
                  <!-- 会場名（複数会場の場合のみ表示）-->
                  {isMultiVenue && (
                    <div class="venue-header">
                      <h2 class="venue-title">{venueInfo.venue}</h2>
                      <p class="venue-info">{venueInfo.date} - {venueInfo.totalRaces}レース</p>
                    </div>
                  )}

                  {/* 本日の傾向分析（AI自動判定）— 会場ごと */}
                  {venueAnalysis[venueIndex] && (
                    <div class="daily-analysis-section">
                      <h3 class="analysis-title">🔍 本日の傾向分析（AI自動判定）</h3>
                      <p class="analysis-subtitle">本命スコア・対抗との差・混戦度を合成したレース信頼度で自動分類しています</p>

                      <div class="analysis-stats">
                        <div class="stat-card high-confidence">
                          <div class="stat-icon">⭐</div>
                          <div class="stat-content">
                            <div class="stat-number">{venueAnalysis[venueIndex].highConfidenceRaces.length}</div>
                            <div class="stat-label">高信頼度レース</div>
                            <div class="stat-description">本命候補が比較的明確</div>
                          </div>
                        </div>

                        <div class="stat-card upset-mode">
                          <div class="stat-icon">💰</div>
                          <div class="stat-content">
                            <div class="stat-number">{venueAnalysis[venueIndex].upsetModeRaces.length}</div>
                            <div class="stat-label">高配当モードレース</div>
                            <div class="stat-description">上位拮抗・波乱含み</div>
                          </div>
                        </div>

                        <div class="stat-card normal">
                          <div class="stat-icon">📊</div>
                          <div class="stat-content">
                            <div class="stat-number">{venueAnalysis[venueIndex].normalRaces.length}</div>
                            <div class="stat-label">通常レース</div>
                            <div class="stat-description">標準的なAI推奨レース</div>
                          </div>
                        </div>
                      </div>

                      <div class="auto-insight">
                        <div class="insight-icon">💡</div>
                        <div class="insight-text">{venueAnalysis[venueIndex].autoInsight}</div>
                      </div>

                      <div class="race-classification-list">
                        {venueAnalysis[venueIndex].highConfidenceRaces.length > 0 && (
                          <div class="classification-group">
                            <div class="classification-header high">
                              <span class="badge">⭐ 高信頼度</span>
                              <span class="count">{venueAnalysis[venueIndex].highConfidenceRaces.length}レース</span>
                            </div>
                            <div class="race-chips">
                              {venueAnalysis[venueIndex].highConfidenceRaces.map((race) => (
                                <div class="race-chip high">
                                  <span class="chip-race">{race.raceNumber}R</span>
                                  <span class="chip-score">{race.confidenceScore}pt</span>
                                </div>
                              ))}
                            </div>
                          </div>
                        )}

                        {venueAnalysis[venueIndex].normalRaces.length > 0 && (
                          <div class="classification-group">
                            <div class="classification-header normal">
                              <span class="badge">📊 通常</span>
                              <span class="count">{venueAnalysis[venueIndex].normalRaces.length}レース</span>
                            </div>
                            <div class="race-chips">
                              {venueAnalysis[venueIndex].normalRaces.map((race) => (
                                <div class="race-chip normal">
                                  <span class="chip-race">{race.raceNumber}R</span>
                                  <span class="chip-score">{race.confidenceScore}pt</span>
                                </div>
                              ))}
                            </div>
                          </div>
                        )}

                        {venueAnalysis[venueIndex].upsetModeRaces.length > 0 && (
                          <div class="classification-group">
                            <div class="classification-header upset">
                              <span class="badge">💰 高配当モード</span>
                              <span class="count">{venueAnalysis[venueIndex].upsetModeRaces.length}レース</span>
                            </div>
                            <div class="race-chips">
                              {venueAnalysis[venueIndex].upsetModeRaces.map((race) => (
                                <div class="race-chip upset">
                                  <span class="chip-race">{race.raceNumber}R</span>
                                  <span class="chip-score">{race.confidenceScore}pt</span>
                                </div>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  )}

                  {/* 会場タブ（レース選択の直上） */}
                  {isMultiVenue && venues.length > 1 && (
                    <div class="venue-selector">
                      {venues.map((vd, vi) => (
                        <button
                          class={`venue-btn ${vi === venueIndex ? 'active' : ''}`}
                          data-venue-index={vi}
                          onclick="selectVenue(event, this)"
                        >
                          <span class="venue-label">{vd.venue}</span>
                          <span class="venue-race-count">{vd.eventInfo.totalRaces}R</span>
                        </button>
                      ))}
                    </div>
                  )}

                  <!-- レース選択ボタン -->
                  <div class="race-selector">
                    {venuePredictions.map((race, raceIndex) => (
                      <button
                        class={`race-btn ${raceIndex === 0 ? 'active' : ''}`}
                        data-venue-index={venueIndex}
                        data-race-index={raceIndex}
                        onclick="selectRace(event, this)"
                        title={race.raceInfo.raceName || `第${race.raceInfo.raceNumber}レース`}
                      >
                        <span class="race-label">{race.raceInfo.raceNumber}R</span>
                        <span class="race-indicator"></span>
                      </button>
                    ))}
                  </div>

                  <!-- レース表示エリア -->
                  <div class="race-display-area">
                    {venuePredictions.map((race, raceIndex) => {
              const allHorses = race.horses;
              const horsesWithMetrics = allHorses.map(horse => ({
                ...horse,
                metrics: generateAdvancedMetrics(horse, allHorses, race.raceInfo)
              }));

              // 全馬表示（プロ会員特典）
              // 役割順にソート（本命→対抗→単穴→連下最上位→連下→補欠→無）
              const sortedHorses = sortHorsesByRole(horsesWithMetrics);

              // 買い目生成
              const umatanBets = generateUmatanBets(allHorses, race.raceInfo.raceNumber, venuePredictions.length);

              // モデル統計
              const avgConfidence = (horsesWithMetrics.reduce((sum, h) =>
                sum + parseFloat(h.metrics.modelCertainty), 0) / horsesWithMetrics.length).toFixed(1);

              return (
                <div class={`race-content ${raceIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex} data-race-index={raceIndex}>
                  <!-- レース名ヘッダー -->
                  {race.raceInfo.raceName && (
                    <div class="race-name-header">
                      <h2 class="race-name-title">{race.raceInfo.raceNumber}R {race.raceInfo.raceName}</h2>
                      <div class="race-details">
                        {race.raceInfo.startTime && <span class="race-detail-item">🕐 {race.raceInfo.startTime}発走</span>}
                        {race.raceInfo.distance && <span class="race-detail-item">📏 {race.raceInfo.distance}m</span>}
                        {race.raceInfo.horseCount && <span class="race-detail-item">🐴 {race.raceInfo.horseCount}頭</span>}
                      </div>
                    </div>
                  )}


                  {/* AI推奨買い目（nankan 統一カード形式） */}
                  {umatanBets && (() => {
                    const isMain = isMainRace(race.raceInfo.raceNumber, venuePredictions.length);
                    const buildLine = (axisInfo, mark) => {
                      const opps5 = axisInfo.opponents.slice(0, 5);
                      const oppsExtra = axisInfo.opponents.slice(5);
                      const oppsStr = opps5.join('.') + (oppsExtra.length > 0 ? `（抑え ${oppsExtra.join('.')}）` : '');
                      const numbers = `${mark}${axisInfo.axis}↔${oppsStr}`;
                      const points = opps5.length + oppsExtra.length;
                      return { mark, name: axisInfo.axisName, numbers, points };
                    };
