            <script>
              // 三連複 段階表示コントローラ（単一源 sanrenpukuCtaStage.js を使用 / 南関 nankan と同型）:
              //   1日目=非表示 / 2日目=予告のみ / 3日目=予告＋三連複的中結果 / 4日目以降=既存CTA＋結果（南関と対称）
              // 対象は馬単のみの Premium（アップセル funnel）。三連複保有・無料・未ログインは何も出さない。
              // 【基準日】現状はブラウザ localStorage の初回表示時刻 ak-umatan-first-seen。
              //   サーバー Premium 開始日基準化は PR-C / PR-D 以降の認証強化フェーズで別対応（本スクリプトは認証コード非依存）。
              //   dismiss(ak-srp-cta-dismissed)・初回時刻(ak-umatan-first-seen) は南関ページと共有。
              import { isFunnelTarget, planSanrenpukuDisplay } from '../../lib/sanrenpuku/sanrenpukuCtaStage.js';
              (function () {
                var teaserEl = document.getElementById('sanrenpuku-teaser-section-jra');
                var ctaEl = document.getElementById('sanrenpuku-cta-section-jra');
                var resultEl = document.getElementById('sanrenpuku-yesterday-results'); // JRA も結果セクションを持つ（3日目以降に表示）
                if (!teaserEl && !ctaEl) return;
                var planRaw = '';
                try { var raw = localStorage.getItem('user-plan'); if (raw) planRaw = (JSON.parse(raw).plan || ''); } catch (e) {}
                if (!planRaw) { try { planRaw = localStorage.getItem('userPlan') || ''; } catch (e) {} }
                if (!isFunnelTarget(planRaw)) return; // 三連複保有・無料・未ログイン
                var now = Date.now();
                var firstSeen = 0;
                try { firstSeen = parseInt(localStorage.getItem('ak-umatan-first-seen') || '0', 10) || 0; } catch (e) {}
                if (!firstSeen) { firstSeen = now; try { localStorage.setItem('ak-umatan-first-seen', String(now)); } catch (e) {} }
                var dismissed = false;
                try { dismissed = localStorage.getItem('ak-srp-cta-dismissed') === '1'; } catch (e) {}
                var view = planSanrenpukuDisplay({ planRaw: planRaw, dismissed: dismissed, firstSeen: firstSeen, now: now, hasResultSection: !!resultEl });
                // 予告カード（2日目=day2 / 3日目=day3。4日目以降は none で CTA に切替＝排他）
                if (teaserEl) {
                  var day2 = teaserEl.querySelector('.srp-teaser-day2');
                  var day3 = teaserEl.querySelector('.srp-teaser-day3');
                  if (day2) day2.style.display = view.teaser === 'day2' ? '' : 'none';
                  if (day3) day3.style.display = view.teaser === 'day3' ? '' : 'none';
                  teaserEl.style.display = view.teaser === 'none' ? 'none' : '';
                }
                // 三連複的中結果（未購入 Premium は3日目以降のみ。購入済み/無料/未ログインは funnel 外で早期 return 済み）
                if (resultEl && view.showResult) resultEl.style.display = 'block';
                // 既存 CTA カード（4日目以降・未dismiss）
                if (ctaEl) {
                  ctaEl.style.display = view.showCta ? '' : 'none';
                  if (view.showCta) {
                    var closeBtn = ctaEl.querySelector('.srp-cta-close');
                    if (closeBtn) closeBtn.addEventListener('click', function () {
                      ctaEl.style.display = 'none';
                      try { localStorage.setItem('ak-srp-cta-dismissed', '1'); } catch (e) {}
                    });
                  }
                }
              })();
            </script>

