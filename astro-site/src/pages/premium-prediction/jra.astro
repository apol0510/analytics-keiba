      align-items: center;
      gap: 14px 16px;
      flex-wrap: wrap;
      min-width: 0;
    }

    .race-number {
      flex-shrink: 0;
      background: linear-gradient(135deg, #8b5cf6, #7c3aed);
      color: white;
      padding: 9px 16px;
      border-radius: 12px;
      font-weight: 800;
      font-size: 1.05rem;
      letter-spacing: 0.02em;
      box-shadow: 0 2px 8px rgba(139, 92, 246, 0.35);
    }

    .race-name {
      color: #e2e8f0;
      font-weight: 700;
      font-size: 1.08rem;
      line-height: 1.3;
    }

    .race-head-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 12px;
      align-items: center;
      width: 100%;
      margin-top: 2px;
    }

    .race-meta-chip {
      font-size: 0.83rem;
      color: #b6c2d9;
      font-weight: 600;
      padding: 5px 11px;
      background: rgba(30, 41, 59, 0.7);
      border-radius: 999px;
      border: 1px solid rgba(139, 92, 246, 0.28);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .main-race-badge {
      flex-shrink: 0;
      background: linear-gradient(135deg, #f59e0b, #fb923c);
      color: white;
      padding: 4px 12px;
      border-radius: 15px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .toggle-icon {
      flex-shrink: 0;
      font-size: 1.2rem;
      color: #10b981;
      transition: transform 0.3s ease;
      width: 24px;
      text-align: center;
    }

    .race-accordion-content {
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transition: max-height 0.4s ease, opacity 0.3s ease;
      background: rgba(15, 23, 42, 0.95);
    }

    .race-accordion-body {
      padding: 20px 18px 22px;
    }

    .analysis-section {
      background: var(--bg-secondary);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      margin-bottom: var(--spacing-xl);
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-lg);
      flex-wrap: wrap;
    }

    .header-icon {
      font-size: 1.5rem;
      filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.5));
    }

    .section-header h2 {
      font-size: 1.25rem;
      color: #60a5fa;
      font-weight: 800;
      flex: 1;
    }

    /* === AIモデル選出馬カード（無料版と統一デザイン） === */
    .ai-pick-section {
      margin-bottom: 30px;
    }
    .ai-pick-section .section-title {
      font-size: 1.4rem;
      font-weight: 700;
      color: #3b82f6;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .ai-pick-section .horse-card {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
      padding: 20px;
      border-radius: 14px;
      margin-bottom: 18px;
      border: 1px solid rgba(59, 130, 246, 0.2);
      position: relative;
      overflow: hidden;
    }
    .ai-pick-section .horse-card-tana {
      padding: 22px;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.06) 0%, rgba(139, 92, 246, 0.06) 100%);
      border: 1.5px solid rgba(245, 158, 11, 0.28);
    }
    .ai-pick-section .horse-card-main {
      padding: 28px;
      background: linear-gradient(135deg,
        rgba(16, 185, 129, 0.18) 0%,
        rgba(34, 197, 94, 0.14) 45%,
        rgba(59, 130, 246, 0.16) 100%);
      border: 2px solid transparent;
      background-clip: padding-box;
      box-shadow:
        0 0 0 1.5px rgba(16, 185, 129, 0.55),
        0 8px 28px rgba(16, 185, 129, 0.28),
        0 0 60px rgba(16, 185, 129, 0.18) inset;
      position: relative;
    }
    .ai-pick-section .horse-card-main::before {
      content: "";
      position: absolute;
      inset: -2px;
      border-radius: 16px;
      padding: 2px;
      background: linear-gradient(135deg, #10b981 0%, #22c55e 35%, #3b82f6 70%, #8b5cf6 100%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
              mask-composite: exclude;
      pointer-events: none;
      z-index: 0;
    }
    .ai-pick-section .horse-card-main > * { position: relative; z-index: 1; }
    .ai-pick-section .main-glow {
      position: absolute;
      top: -40%;
      left: -10%;
      width: 60%;
      height: 180%;
      background: radial-gradient(closest-side, rgba(16, 185, 129, 0.28), transparent 70%);
      filter: blur(20px);
      pointer-events: none;
      z-index: 0;
      animation: ai-pick-main-glow-pulse 3.6s ease-in-out infinite;
    }
    @keyframes ai-pick-main-glow-pulse {
      0%, 100% { opacity: 0.55; transform: translateX(0); }
      50%      { opacity: 0.95; transform: translateX(8%); }
    }
    .ai-pick-section .horse-card-sub {
      padding: 24px;
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.12) 0%, rgba(139, 92, 246, 0.12) 100%);
      border: 1.5px solid rgba(59, 130, 246, 0.45);
      box-shadow: 0 4px 18px rgba(59, 130, 246, 0.18);
    }
    .ai-pick-section .horse-mark-main {
      display: inline-block;
      font-size: 2.4rem;
      color: #10b981;
      font-weight: 900;
      margin-right: 12px;
      text-shadow:
        0 0 10px rgba(16, 185, 129, 0.7),
        0 0 22px rgba(16, 185, 129, 0.45);
      line-height: 1;
      vertical-align: middle;
    }
    .ai-pick-section .horse-mark-sub {
      display: inline-block;
      font-size: 1.7rem;
      color: #3b82f6;
      font-weight: 800;
      margin-right: 10px;
      text-shadow: 0 0 8px rgba(59, 130, 246, 0.45);
      line-height: 1;
      vertical-align: middle;
    }
    .ai-pick-section .horse-mark-tana {
      display: inline-block;
      font-size: 1.55rem;
      color: #f59e0b;
      font-weight: 800;
      margin-right: 10px;
      text-shadow: 0 0 8px rgba(245, 158, 11, 0.45);
      line-height: 1;
      vertical-align: middle;
    }
    .ai-pick-section .horse-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
      gap: 10px;
    }
    .ai-pick-section .horse-identity {
      display: flex;
      align-items: center;
      gap: 4px;
      flex-wrap: wrap;
    }
    .ai-pick-section .role-badge {
      display: inline-block;
      padding: 5px 14px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.04em;
