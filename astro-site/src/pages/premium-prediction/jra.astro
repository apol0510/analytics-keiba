import { enrichHorse, generateMinorHorseComment } from '../../lib/horseEnrichment.js';
import { getDisplayComputerIndex, isOsaeCandidate, isIneligibleHorse, sortOsaeCandidates } from '../../lib/shared-prediction-logic.js';

export const prerender = true;

// サーバーサイド認証チェック（セキュリティ強化）
