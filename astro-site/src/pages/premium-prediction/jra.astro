                  {/* 会場タブ（レース選択の直上） */}
                  {isMultiVenue && venues.length > 1 && (
                    <div class="venue-selector">
                      {venues.map((vd, vi) => (
                        <button
                          class={`venue-btn ${vi === venueIndex ? 'active' : ''}`}
                          data-venue-index={vi}
                          onclick="selectVenue(event, this)"
                        >
                          <span class="venue-label">{vd.venue}</span>
                          <span class="venue-race-count">{vd.eventInfo.totalRaces}R</span>
                        </button>
                      ))}
                    </div>
                  )}

                  <!-- 会場セクションラベル（タブの下に小さく統合・孤立した大カードは廃止） -->
                  {isMultiVenue && (
                    <div class="venue-section-label">
                      <span class="vsl-name">{venueInfo.venue}</span>
                      <span class="vsl-meta">{venueInfo.date}・全{venueInfo.totalRaces}レース</span>
                    </div>
                  )}

                  <!-- レース一覧（アコーディオン：premium 南関と統一） -->
                  <div class="race-accordion-list">
                    {venuePredictions.map((race, raceIndex) => {
              const allHorses = race.horses;
              const horsesWithMetrics = allHorses.map(horse => ({
                ...horse,
                metrics: generateAdvancedMetrics(horse, allHorses, race.raceInfo)
              }));

              // 全馬表示（プロ会員特典）
              // 役割順にソート（本命→対抗→単穴→連下最上位→連下→補欠→無）
              const sortedHorses = sortHorsesByRole(horsesWithMetrics);

              // 買い目データ取得（単一正本 = 保存 bettingLines.umatan / 欠落時のみ共通モジュールで再生成）
              // 通常レースは正本側で G-CI 適用済み、メインレースは本命軸の既存仕様のまま。
              const umatanLines = Array.isArray(race.bettingLines?.umatan) && race.bettingLines.umatan.length > 0
                ? race.bettingLines.umatan
                : generateRaceUmatanLines(allHorses, isMainRace(race.raceInfo.raceNumber, venuePredictions.length));

              // モデル統計
              const avgConfidence = (horsesWithMetrics.reduce((sum, h) =>
                sum + parseFloat(h.metrics.modelCertainty), 0) / horsesWithMetrics.length).toFixed(1);

              const accordionId = `race-v${venueIndex}-r${raceIndex}`;
              const toggleId = `toggle-v${venueIndex}-r${raceIndex}`;
              return (
                <div class="race-accordion-block" data-venue-index={venueIndex} data-race-index={raceIndex}>
                  <!-- レース概要カード（アコーディオンヘッダー） -->
                  <div class="race-accordion-header" onclick={`toggleJraRace(${venueIndex}, ${raceIndex})`}>
                    <div class="race-basic-info">
                      <span class="race-number">{race.raceInfo.raceNumber}R</span>
                      {race.raceInfo.raceName && <span class="race-name">{race.raceInfo.raceName}</span>}
                      {isMainRace(race.raceInfo.raceNumber, venuePredictions.length) && <span class="main-race-badge">メインレース</span>}
                      <div class="race-head-meta">
                        {race.raceInfo.startTime && <span class="race-meta-chip">🕐 {race.raceInfo.startTime}発走</span>}
                        {race.raceInfo.distance && <span class="race-meta-chip">📏 {race.raceInfo.distance}m</span>}
                        {race.raceInfo.horseCount && <span class="race-meta-chip">🐴 {race.raceInfo.horseCount}頭</span>}
                      </div>
                    </div>
                    <span class="toggle-icon" id={toggleId}>▼</span>
                  </div>

                  <div class="race-accordion-content" id={accordionId} style="max-height:0;opacity:0">
                    <div class="race-accordion-body">


                  {/* AI推奨買い目（nankan 統一カード形式） */}
                  {umatanLines && umatanLines.length > 0 && (() => {
                    // 保存 bettingLines.umatan（正本）をそのまま表示。軸の役割・馬名はラベル用に allHorses から復元。
                    // メインレースは正本生成時点で一方向「本命→相手5頭」5点で保存されるため、表示側で加工しない。
                    const markOf = (role) => role === '本命' ? '◎' : role === '対抗' ? '○' : role === '単穴' ? '▲' : role === '連下最上位' ? '△' : '';
                    const lines = umatanLines.map((lineStr) => {
                      const axisNum = parseInt(String(lineStr).match(/^(\d+)/)?.[1] ?? '', 10);
                      const axisHorse = allHorses.find(h => Number(h.horseNumber ?? h.number) === axisNum);
                      const role = axisHorse?.role || '';
                      return {
                        mark: markOf(role),
                        name: axisHorse?.horseName ?? axisHorse?.name ?? '',
                        numbers: stripOsaeForDisplay(lineStr),
                        points: countPointsFromUmatanLine(lineStr) || 0,
                        role,
                      };
                    });
                    return (
                      <div class="betting-section pro-exclusive recommendation-section" id={`betting-section-${raceIndex}`} data-race-number={race.raceInfo.raceNumber} data-total-races={venuePredictions.length}>
                        <div class="bet-strategy unified-bet-card">
                          <div class="unified-bet-header">
                            <h2 class="section-title">
                              <span>📊</span>
                              <span>AI推奨買い目</span>
                            </h2>
                            <span class="pro-tag pro-only">PRO限定</span>
                          </div>

                          {/* ライトプラン向け制限メッセージ（メインレース以外）*/}
                          <div class="light-user-restricted hidden" data-race-index={raceIndex}>
                            <div class="limited-betting-info">
                              <p>🔒 <strong>ライトプラン：</strong>買い目はメインレース（最終レース）のみ閲覧可能です</p>
                              <div class="upgrade-notice">
                                <p>💎 <strong>プロプランにアップグレードで全レースの買い目が見られます</strong></p>
                                <a href="/pricing/" class="btn btn-upgrade">料金プランを見る →</a>
                              </div>
                            </div>
                          </div>

                          {/* 無料会員向け制限買い目 */}
                          <div class="free-user-betting hidden" data-race-index={raceIndex}>
                            <div class="limited-betting-info">
                              <p>🎁 <strong>無料会員特典：</strong>本命・対抗・単穴・連下最上位の馬番号を表示</p>
                              <div class="limited-horses">
                                {allHorses
                                  .filter(h => ['本命', '対抗', '単穴', '連下最上位'].includes(h.role))
                                  .map((horse) => (
                                    <div class={`limited-horse ${horse.role === '本命' ? 'honmei' : horse.role === '対抗' ? 'taikou' : horse.role === '単穴' ? 'tanana' : 'renka-top'}`}>
                                      <span class="limited-mark">
                                        {horse.role === '本命' ? '◎' : horse.role === '対抗' ? '○' : horse.role === '単穴' ? '▲' : '△'}
                                      </span>
                                      <span class="limited-number">{horse.horseNumber}</span>
                                      <span class="limited-name">{horse.horseName}</span>
                                      <span class="limited-role">{horse.role}</span>
                                    </div>
                                  ))
                                }
                              </div>
                              <div class="upgrade-notice">
                                <p>💎 <strong>有料プランにアップグレードで全買い目（本線＋抑え）が見られます</strong></p>
                                <a href="/pricing/" class="btn btn-upgrade">料金プランを見る →</a>
                              </div>
                            </div>
                          </div>

                          {/* プロ会員向け完全買い目（bet-item 形式 / nankan 統一） */}
                          <div class="bet-list pro-user-only hidden">
                            {lines.map((ln) => (
                              <div class="bet-item">
                                <span class="bet-type">馬単</span>
                                <div class="bet-horses">
                                  {ln.name && <span class="bet-axis-label">{ln.role} {ln.name}</span>}
                                  <span class="bet-numbers">{ln.numbers}</span>
                                </div>
                              </div>
                            ))}
                          </div>

                        </div>
                      </div>
                    );
                  })()}

                  <!-- AIモデル選出馬カード（無料版と統一デザイン） -->
                  <div class="analysis-section ai-pick-section">
                    <h2 class="section-title">
                      <span>🤖</span>
                      <span>AIモデル選出馬</span>
                    </h2>

                    {sortedHorses.filter(h => h.role === '本命' || h.role === '対抗' || h.role === '単穴').map((horse) => {
                      const e = enrichHorse(horse, allHorses, race.raceInfo?.distance);
                      const role = horse.role;
                      const cardClass = role === '本命' ? 'horse-card horse-card-main'
                        : role === '対抗' ? 'horse-card horse-card-sub'
                        : 'horse-card horse-card-tana';
                      const mark = role === '本命' ? '◎' : role === '対抗' ? '○' : '▲';
                      const markClass = role === '本命' ? 'horse-mark-main'
                        : role === '対抗' ? 'horse-mark-sub'
                        : 'horse-mark-tana';
                      const ageGenderStr = (e.ageNum != null && e.gender)
                        ? `${e.ageNum}歳${e.gender}`
                        : (horse.age || null);
                      const weightStr = (horse.weight != null && horse.weight !== '' && Number.isFinite(Number(horse.weight)))
                        ? `${horse.weight}kg`
                        : null;
                      const hasBasicInfo = ageGenderStr || weightStr || horse.jockey || horse.trainer || horse.frame != null || horse.sire;
                      const displayCi = getHorseAiIndex(horse);
                      return (
                        <div class={cardClass}>
                          {role === '本命' && <div class="main-glow" aria-hidden="true"></div>}
                          <div class="horse-header">
                            <div class="horse-identity">
                              <span class={markClass}>{mark}</span>
                              <span class="horse-number">{horse.horseNumber}</span>
                              <span class="horse-name">{horse.horseName}</span>
                            </div>
                            <span class={`role-badge role-badge-${role === '本命' ? 'main' : role === '対抗' ? 'sub' : 'tana'}`}>{role}</span>
                          </div>

                          <div class="horse-stats-row">
                            <div class="stat-block stat-score-block">
                              <div class="stat-label">累積スコア</div>
                              <div class="stat-value stat-score">{e.pt}<span class="stat-unit">pt</span></div>
                            </div>
                            {displayCi != null && (
                              <div class="stat-block stat-index-block">
                                <div class="stat-label">AI総合指数</div>
                                <div class="stat-value stat-index">{displayCi}</div>
                              </div>
                            )}
                          </div>

                          {hasBasicInfo && (
                            <div class="basic-info">
                              <h4>基本情報</h4>
                              <div class="info-grid">
                                {(ageGenderStr || weightStr) && (
                                  <div class="info-line info-line-primary">
                                    {ageGenderStr && <span class="info-chip">{ageGenderStr}</span>}
                                    {weightStr && <span class="info-chip">{weightStr}</span>}
                                  </div>
                                )}
                                {horse.jockey && (
                                  <div class="info-line"><span class="info-key">騎手</span><span class="info-val">{horse.jockey}</span></div>
                                )}
                                {horse.trainer && (
                                  <div class="info-line"><span class="info-key">調教師</span><span class="info-val">{horse.trainer}</span></div>
                                )}
                                {horse.frame != null && (
                                  <div class="info-line"><span class="info-key">枠番</span><span class="info-val">{horse.frame}枠</span></div>
                                )}
                                {horse.sire && (
                                  <div class="info-line"><span class="info-key">父</span><span class="info-val">{horse.sire}</span></div>
                                )}
                              </div>
                            </div>
                          )}

                          {e.evalPoints && e.evalPoints.length > 0 && (
                            <div class="eval-points">
                              <h4>評価ポイント</h4>
                              <div class="eval-tags">
                                {e.evalPoints.map((p) => (
                                  <span class="eval-tag">{p}</span>
                                ))}
                              </div>
                            </div>
                          )}

                          {/* 特徴量重要度: shared featureScores 由来の AK専用3項目を優先。
                              無い/算出不能なら既存 e.importance(computeImportance 由来) に fallback。
                              両者は排他（二重表示しない）。AK では6項目名・個別値はそのまま出さない。 */}
                          {(() => {
                            const fs6 = featureScoresData
                              ? getHorseFeatures(featureScoresData, race.raceInfo.raceNumber, horse.horseNumber)
                              : null;
                            const akImp = fs6 ? deriveAkImportance(fs6) : null;
                            if (akImp) {
                              return (
                                <div class="feature-importance ai-pick-importance">
                                  <h4>特徴量重要度</h4>
                                  <div class="importance-list">
                                    {akImp.map((item) => (
                                      <div class="importance-item">
                                        <span class="importance-label">{item.label}</span>
                                        <div class="importance-bar">
                                          <div class="importance-fill" style={`width: ${item.value == null ? 0 : item.value}%`}></div>
                                        </div>
                                        <span class="importance-percent">{item.value == null ? '—' : `${item.value}%`}</span>
                                      </div>
                                    ))}
                                  </div>
                                </div>
                              );
                            }
                            if (e.importance && e.importance.length > 0) {
                              return (
                                <div class="feature-importance ai-pick-importance">
                                  <h4>特徴量重要度</h4>
                                  <div class="importance-list">
                                    {e.importance.map((item) => (
                                      <div class="importance-item">
                                        <span class="importance-label">{item.label}</span>
                                        <div class="importance-bar">
                                          <div class="importance-fill" style={`width: ${item.value * 100}%`}></div>
                                        </div>
                                        <span class="importance-percent">{Math.round(item.value * 100)}%</span>
                                      </div>
                                    ))}
                                  </div>
                                </div>
                              );
                            }
                            return null;
                          })()}

                          {/* 過去走 — horseHistories.recent5 を優先、なければ既存 recentRaces にフォールバック */}
                          {(() => {
                            const displayRecent = _displayRecentOf(horse);
                            if (!displayRecent.length) return null;
                            return (
                            <details class="recent-races recent-races-compact" data-click-close="true">
                              <summary>過去{Math.min(5, displayRecent.length)}走</summary>
                              <div class="recent-races-list">
                                {displayRecent.slice(0, 5).map((r) => {
                                  const rank = (r?.rank != null && Number.isFinite(Number(r.rank))) ? `${r.rank}着` : '';
                                  return (
                                    <div class="recent-race-row">
                                      <span class="recent-race-venue">{formatRecentVenue(r?.venue) || ''}</span>
                                      <span class="recent-race-distance">{formatRecentDistance(r?.distance)}</span>
                                      <span class="recent-race-rank">{rank}</span>
                                      {r?.time && <span class="recent-race-meta">タイム{r.time}</span>}
                                      {r?.last3f && <span class="recent-race-meta">上がり{r.last3f}</span>}
                                      {r?.bodyWeight && <span class="recent-race-meta">{r.bodyWeight}kg</span>}
                                    </div>
                                  );
                                })}
                              </div>
                            </details>
                            );
                          })()}

                          {/* 過去走データ（horseHistories.history 由来・表示専用アコーディオン）
                              プロフィール → 通算成績 → 条件別成績 → 競走成績の4セクション。
                              集計は buildHistoryAccordionContext（フロントマッター）で実行。
                              計算系・印・買い目・特徴量重要度には一切関与しない。 */}
                          {(() => {
                            const ctx = buildHistoryAccordionContext(horse, race);
                            if (!ctx) return null;
                            return (
                              <details class="history-details" data-click-close="true">
                                <summary class="history-summary">
                                  <span class="history-summary-text">過去走データ</span>
                                  <span class="history-summary-count">{ctx.summaryCount}</span>
                                  <span class="history-summary-chevron" aria-hidden="true">▾</span>
                                </summary>
                                <div class="history-content">
                                  {ctx.hasProfile && (
                                    <div class="history-section">
                                      <div class="history-section-label">プロフィール</div>
                                      <div class="history-profile-grid">
                                        {ctx.profileItems.map((p) => (
                                          <div class="history-profile-item">
                                            <span class="history-profile-label">{p.label}</span>
                                            <span class="history-profile-value">{p.value}</span>
                                          </div>
                                        ))}
                                      </div>
                                    </div>
                                  )}
                                  {ctx.hasRanked && (
                                    <div class="history-section">
                                      <div class="history-section-label">通算成績</div>
                                      <div class="history-record-grid">
                                        <div class="history-rec-card">
                                          <div class="history-rec-label">通算</div>
                                          <div class="history-rec-value">{ctx.recordValue}</div>
                                        </div>
                                        <div class="history-rec-card">
                                          <div class="history-rec-label">勝率</div>
                                          <div class="history-rec-value">{ctx.winPctStr}</div>
                                        </div>
                                        <div class="history-rec-card">
                                          <div class="history-rec-label">連対率</div>
                                          <div class="history-rec-value">{ctx.placePctStr}</div>
                                        </div>
                                        <div class="history-rec-card">
                                          <div class="history-rec-label">3着内率</div>
                                          <div class="history-rec-value">{ctx.showPctStr}</div>
                                        </div>
                                      </div>
                                    </div>
                                  )}
                                  {ctx.hasCondRows && (
                                    <div class="history-section">
                                      <div class="history-section-label">条件別成績</div>
                                      <div class="history-cond-list">
                                        {ctx.condRows.map((row) => (
                                          <div class="history-cond-row">
                                            <span class="history-cond-label">{row.label}</span>
                                            <span class="history-cond-stat">{fmtHistoryCondStat(row.stat)}</span>
                                          </div>
                                        ))}
                                      </div>
                                    </div>
                                  )}
                                  <div class="history-section">
                                    <div class="history-section-label">{ctx.sectionLabel}</div>
                                    <div class="history-list">
                                      {ctx.rows.map((row) => (
                                        <div class="history-row">
                                          <div class="hh-line hh-line-primary">
                                            {row.r._dateStr && <span class="hh-date">{row.r._dateStr}</span>}
                                            {row.r.venue && <span class="hh-venue">{row.r.venue}</span>}
                                            {row.r._displayDistance && <span class="hh-dist">{row.r._displayDistance}</span>}
                                            {row.hasFinishStatus && <span class="hh-status">[{row.r.finishStatus}]</span>}
                                            {row.hasRank && <span class={row.rankClass}>{row.r.rank}着</span>}
                                            {row.hasPopularity && <span class="hh-pop">{row.r.popularity}人気</span>}
                                          </div>
                                          <div class="hh-line hh-line-secondary">
                                            {row.r.raceName && <span class="hh-race-name">{row.r.raceName}</span>}
                                            {row.r.jockey && <span class="hh-jockey">🏇 {row.r.jockey}</span>}
                                            {row.r.bodyWeight && <span class="hh-bw">{row.r.bodyWeight}kg</span>}
                                            {row.r.time && <span class="hh-time">{row.r.time}</span>}
                                            {row.r.winnerName && <span class="hh-winner">勝: {row.r.winnerName}</span>}
                                          </div>
                                        </div>
                                      ))}
                                      {ctx.hasOverflow && (
                                        <div class="hh-overflow">他{ctx.overflow}走あり</div>
                                      )}
                                    </div>
                                  </div>
                                </div>
                              </details>
                            );
                          })()}
                        </div>
                      );
