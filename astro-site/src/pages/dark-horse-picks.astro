            position: fixed; inset: 0; z-index: 1000;
            display: none; align-items: center; justify-content: center;
            padding: 20px;
        }
        .modal.show { display: flex; animation: fadeIn 0.2s ease-out; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .modal-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); }
        .modal-content {
            position: relative; z-index: 1;
            max-width: 760px; width: 100%; max-height: 90vh;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            border: 1px solid rgba(236, 72, 153, 0.35);
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 0 0 60px rgba(236, 72, 153, 0.15);
            overflow-y: auto;
            padding: 24px;
        }
        .modal-close {
            position: absolute; top: 12px; right: 14px;
            background: transparent; border: none; color: #94a3b8;
            font-size: 1.8rem; cursor: pointer; line-height: 1;
        }
        .modal-close:hover { color: #f1f5f9; }
        .modal-header { padding-right: 32px; margin-bottom: 18px; border-bottom: 1px solid rgba(148, 163, 184, 0.2); padding-bottom: 14px; }
        .modal-meta { margin: 0 0 6px; color: #94a3b8; font-size: 0.82rem; }
        #modal-race-title {
            margin: 0;
            font-size: 1.4rem;
            background: linear-gradient(135deg, #ec4899, #f472b6, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .modal-body { display: block; min-height: 220px; }
        .horse-card-list { display: grid; gap: 16px; }

        /* AI ローディング演出 */
        .ai-loading {
            display: flex; flex-direction: column; align-items: center; gap: 18px;
            padding: 36px 12px 18px;
        }
        .ai-loading-orb {
            position: relative;
            width: 110px; height: 110px;
            display: flex; align-items: center; justify-content: center;
        }
        .orb-ring {
            position: absolute; inset: 0;
            border-radius: 50%;
            border: 2px solid transparent;
            border-top-color: rgba(236, 72, 153, 0.85);
            border-right-color: rgba(139, 92, 246, 0.5);
            animation: orbSpin 1.4s linear infinite;
        }
        .orb-ring.r2 { inset: 12px; border-top-color: rgba(244, 114, 182, 0.7); border-right-color: rgba(167, 139, 250, 0.5); animation-duration: 1.8s; animation-direction: reverse; }
        .orb-ring.r3 { inset: 24px; border-top-color: rgba(251, 191, 36, 0.7); border-right-color: rgba(236, 72, 153, 0.4); animation-duration: 2.2s; }
        @keyframes orbSpin { to { transform: rotate(360deg); } }
        .orb-core {
            font-size: 2.3rem;
            filter: drop-shadow(0 0 14px rgba(236, 72, 153, 0.7));
            animation: orbPulse 1.4s ease-in-out infinite;
        }
        @keyframes orbPulse {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 14px rgba(236, 72, 153, 0.7)); }
            50% { transform: scale(1.12); filter: drop-shadow(0 0 22px rgba(244, 114, 182, 0.95)); }
        }
        .ai-loading-status { text-align: center; }
        .ai-loading-title {
            font-size: 1.15rem; font-weight: 800; letter-spacing: 0.04em;
            background: linear-gradient(135deg, #ec4899, #f472b6, #8b5cf6);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            margin-bottom: 6px;
        }
        .ai-loading-step {
            font-size: 0.9rem; color: #cbd5e1;
            min-height: 1.3em;
            animation: stepFade 0.4s ease-out;
        }
        @keyframes stepFade { from { opacity: 0; transform: translateY(2px); } to { opacity: 1; transform: translateY(0); } }
        .ai-loading-bar {
            width: 220px; height: 6px;
            background: rgba(148, 163, 184, 0.18);
            border-radius: 999px; overflow: hidden;
        }
        .ai-loading-bar-fill {
            height: 100%; width: 0;
            background: linear-gradient(90deg, #ec4899, #f472b6, #8b5cf6, #ec4899);
            background-size: 200% 100%;
            animation: barFill 1.6s cubic-bezier(0.4, 0, 0.2, 1) forwards, barShimmer 1.2s linear infinite;
        }
        @keyframes barFill { from { width: 0; } to { width: 100%; } }
        @keyframes barShimmer { to { background-position: 200% 0; } }

        /* 馬カード（モーダル内） */
        .horse-card {
            position: relative;
            padding: 18px 18px 16px;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.85) 0%, rgba(30, 41, 59, 0.7) 100%);
            border: 1.5px solid rgba(236, 72, 153, 0.25);
            border-radius: 14px;
            overflow: hidden;
            opacity: 0;
            transform: translateY(8px);
            animation: horseCardReveal 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            animation-delay: var(--delay, 0ms);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
        }
        @keyframes horseCardReveal {
            to { opacity: 1; transform: translateY(0); }
        }
        .horse-card.is-darkhorse { border-color: rgba(252, 165, 165, 0.45); }
        .horse-card.is-value { border-color: rgba(252, 211, 77, 0.45); }
        .horse-card.is-fallback { border-color: rgba(167, 139, 250, 0.4); }
        .horse-card-glow {
            position: absolute; inset: 0;
            background: radial-gradient(circle at top right, rgba(236, 72, 153, 0.16), transparent 60%);
            pointer-events: none;
        }
        .horse-card.is-value .horse-card-glow {
            background: radial-gradient(circle at top right, rgba(251, 191, 36, 0.16), transparent 60%);
        }
        .horse-card-head { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; position: relative; }
        .horse-num-wrap { flex-shrink: 0; }
        .horse-num {
            display: inline-flex; align-items: center; justify-content: center;
            width: 44px; height: 44px;
            background: linear-gradient(135deg, #ec4899, #8b5cf6);
            color: white; border-radius: 10px;
            font-weight: 900; font-size: 1.25rem;
            box-shadow: 0 6px 14px rgba(236, 72, 153, 0.45);
        }
        .horse-card.is-value .horse-num {
            background: linear-gradient(135deg, #f59e0b, #ec4899);
            box-shadow: 0 6px 14px rgba(245, 158, 11, 0.45);
        }
        .horse-card.is-fallback .horse-num {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            box-shadow: 0 6px 14px rgba(99, 102, 241, 0.4);
        }
        .horse-card.is-fallback .horse-card-glow {
            background: radial-gradient(circle at top right, rgba(99, 102, 241, 0.14), transparent 60%);
        }
        .horse-name-wrap { flex: 1; min-width: 0; }
        .horse-name {
            color: #f8fafc; font-weight: 800; font-size: 1.05rem; line-height: 1.3;
            margin-bottom: 4px;
        }
        .horse-tag-row { display: flex; gap: 6px; flex-wrap: wrap; }
        .horse-card-rating {
            display: flex; align-items: center; justify-content: space-between;
            padding: 10px 14px; margin-bottom: 10px;
            background: rgba(30, 41, 59, 0.55);
            border: 1px solid rgba(148, 163, 184, 0.15);
            border-radius: 10px;
        }
        .rating-label { color: #cbd5e1; font-size: 0.85rem; font-weight: 700; }
        .rating-stars {
            font-size: 1.05rem; letter-spacing: 0.1em;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            font-weight: 700;
        }
        .horse-card-meta { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
        .meta-chip {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 12px;
            background: rgba(30, 41, 59, 0.55);
            border: 1px solid rgba(148, 163, 184, 0.18);
            border-radius: 999px;
            font-size: 0.85rem;
        }
        .meta-icon { font-size: 0.95rem; }
        .meta-label { color: #94a3b8; }
        .meta-value { color: #f1f5f9; font-weight: 700; }
        /* 評価根拠タグ（事実ベース） */
        .horse-tags {
            padding: 12px 14px;
            background: linear-gradient(135deg, rgba(236, 72, 153, 0.08), rgba(139, 92, 246, 0.08));
            border: 1px solid rgba(139, 92, 246, 0.22);
            border-radius: 10px;
        }
        .horse-card.is-value .horse-tags {
            background: linear-gradient(135deg, rgba(251, 191, 36, 0.08), rgba(236, 72, 153, 0.08));
            border-color: rgba(251, 191, 36, 0.25);
        }
        .horse-card.is-fallback .horse-tags {
            background: linear-gradient(135deg, rgba(148, 163, 184, 0.08), rgba(99, 102, 241, 0.08));
            border-color: rgba(99, 102, 241, 0.22);
        }
        .tags-head { display: flex; align-items: center; gap: 6px; margin-bottom: 8px; }
        .tags-head-icon { font-size: 1rem; }
        .tags-head-text {
            font-size: 0.78rem; font-weight: 800; letter-spacing: 0.06em;
            color: #c7d2fe; text-transform: uppercase;
        }
        .horse-card.is-value .tags-head-text { color: #fcd34d; }
        .horse-card.is-fallback .tags-head-text { color: #a5b4fc; }
        .tags-row { display: flex; gap: 6px; flex-wrap: wrap; }
        .horse-tag-chip {
            display: inline-flex; align-items: center;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 0.78rem; font-weight: 700;
            border: 1px solid transparent;
            white-space: nowrap;
        }
        .horse-tag-chip.tag-win {
            color: #fde68a;
            background: rgba(251, 191, 36, 0.15);
            border-color: rgba(251, 191, 36, 0.4);
        }
        .horse-tag-chip.tag-good {
            color: #6ee7b7;
            background: rgba(16, 185, 129, 0.13);
            border-color: rgba(16, 185, 129, 0.35);
        }
        .horse-tag-chip.tag-recover {
            color: #fca5a5;
            background: rgba(239, 68, 68, 0.13);
            border-color: rgba(239, 68, 68, 0.4);
        }
        .horse-tag-chip.tag-edge {
            color: #c4b5fd;
            background: rgba(139, 92, 246, 0.15);
            border-color: rgba(139, 92, 246, 0.4);
        }
        .horse-tag-chip.tag-fallback {
            color: #a5b4fc;
            background: rgba(99, 102, 241, 0.15);
            border-color: rgba(99, 102, 241, 0.35);
        }
        .horse-tag-chip.tag-warn {
            color: #94a3b8;
            background: rgba(71, 85, 105, 0.18);
            border-color: rgba(148, 163, 184, 0.3);
        }

        .modal-disclaimer {
            margin-top: 16px; padding: 10px 14px;
            background: rgba(245, 158, 11, 0.08);
            border: 1px solid rgba(245, 158, 11, 0.25);
            border-radius: 8px;
        }
        .modal-disclaimer p { margin: 0; color: #fcd34d; font-size: 0.78rem; line-height: 1.5; }

        /* 抽出ロジック */
        .how-it-works { margin: 56px 0 32px; }
        .how-it-works h2 { color: #f1f5f9; font-size: 1.3rem; margin: 0 0 16px; }
        .how-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
        @media (min-width: 800px) { .how-grid { grid-template-columns: repeat(3, 1fr); } }
        .how-card {
            padding: 18px;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 12px;
        }
        .how-card h3 { margin: 0 0 10px; color: #f1f5f9; font-size: 1rem; }
        .how-card ul { margin: 0; padding-left: 20px; color: #94a3b8; font-size: 0.88rem; }
        .how-card li { margin-bottom: 6px; }

        /* CTA */
        .cta-section { margin-top: 32px; }
        .cta-card {
            text-align: center; padding: 28px 20px;
            background: linear-gradient(135deg, rgba(236, 72, 153, 0.12) 0%, rgba(139, 92, 246, 0.12) 100%);
            border: 1px solid rgba(236, 72, 153, 0.3);
            border-radius: 14px;
        }
        .cta-card h2 { margin: 0 0 10px; color: #f1f5f9; font-size: 1.2rem; }
        .cta-card p { color: #94a3b8; margin: 0 0 16px; font-size: 0.9rem; }
        .cta-button {
            display: inline-block; padding: 12px 28px;
            background: linear-gradient(135deg, #ec4899, #8b5cf6);
            color: #fff; text-decoration: none; font-weight: 700;
            border-radius: 999px; transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 4px 16px rgba(236, 72, 153, 0.35);
        }
        .cta-button:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(236, 72, 153, 0.5); }

        @media (max-width: 720px) {
            body { padding: 12px; }
            .page-header { padding: 22px 18px; }
            .page-header h1 { font-size: 1.9rem; }
            .subtitle { font-size: 1rem; padding: 10px 18px; }
            .races-section h2 { font-size: 1.5rem; }
            .races-grid { grid-template-columns: 1fr; gap: 14px; }
            .race-card { padding: 18px; }
            .race-number { font-size: 1.1rem; padding: 6px 12px; }
            .horse-card { padding: 14px; }
            .horse-num { width: 38px; height: 38px; font-size: 1.05rem; }
            .horse-name { font-size: 0.98rem; }
            .horse-card-rating { padding: 8px 12px; }
            .modal-content { padding: 18px; max-height: 92vh; }
            #modal-race-title { font-size: 1.15rem; }
            .user-info-card { flex-direction: column; align-items: flex-start; }
            .daily-info { text-align: left; }
        }
    </style>
</body>
</html>
