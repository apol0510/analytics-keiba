<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>中央・南関 穴馬抽出ツール【無料】本日の狙い目をAI自動抽出 | KEIBA Analytics</title>
    <meta name="description" content="中央競馬（JRA）と南関競馬の穴馬候補をAI分析で自動抽出。レース別に狙い目の穴馬と妙味馬を表示します。" />
    <meta name="keywords" content="中央競馬,JRA,南関競馬,穴馬,穴馬抽出,AI予想,妙味馬,予想,競馬ツール" />
    <link rel="canonical" href="https://analytics.keiba.link/dark-horse-picks" />

    <meta property="og:title" content="中央・南関 穴馬抽出ツール【無料】" />
    <meta property="og:description" content="中央競馬（JRA）と南関競馬の穴馬候補を自動抽出。レース別に狙い目を表示。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://analytics.keiba.link/dark-horse-picks" />
    <meta property="og:site_name" content="KEIBA Analytics" />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="中央・南関 穴馬抽出ツール【無料】" />
    <meta name="twitter:description" content="中央競馬と南関競馬の穴馬候補を自動抽出。" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "中央・南関 穴馬抽出ツール",
      "applicationCategory": "SportsApplication",
      "operatingSystem": "Any",
      "description": "中央競馬（JRA）と南関競馬の穴馬候補をAI分析で自動抽出するツール",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "JPY", "availability": "https://schema.org/InStock" },
      "provider": { "@type": "Organization", "name": "KEIBA Analytics", "url": "https://analytics.keiba.link" }
    }
    </script>
</head>
<body>
    <div class="container">
        <header class="page-header">
            <div class="header-content">
                <a href="/" class="back-link">← トップへ戻る</a>
                <h1>🐴 本日の穴馬抽出</h1>
                <p class="subtitle">中央競馬と南関競馬の狙い目を自動抽出</p>
            </div>
        </header>

        {hasAnyData && (
            <div class="user-info-card">
                <div class="user-plan-info">
                    <div class="plan-badge" id="plan-badge">読み込み中...</div>
                    <div class="remaining-picks">
                        <span class="picks-label">本日の残り取得回数:</span>
                        <span class="picks-count" id="remaining-picks">-</span>
                    </div>
                </div>
                <div class="daily-info">
                    <p class="date-info">対象会場 {tabs.length} 会場 / 抽出件数 {totalDarkHorses} 頭</p>
                </div>
            </div>
        )}

        {hasAnyData && (
            <div class="plan-rules-card">
                <h2>📋 プラン別取得ルール</h2>
                <div class="rules-grid">
                    <div class="rule-item rule-free">
                        <div class="rule-header"><span class="rule-icon">🎯</span><span class="rule-plan">無料会員</span></div>
                        <p class="rule-desc">1日1レースまで取得可能</p>
                    </div>
                    <div class="rule-item rule-light">
                        <div class="rule-header"><span class="rule-icon">⭐</span><span class="rule-plan">ライト会員</span></div>
                        <p class="rule-desc">1日2レースまで取得可能</p>
                    </div>
                    <div class="rule-item rule-premium">
                        <div class="rule-header"><span class="rule-icon">👑</span><span class="rule-plan">プレミアム会員</span></div>
                        <p class="rule-desc">全レース無制限で取得可能</p>
                    </div>
                </div>
            </div>
        )}

        {!hasAnyData && (
            <div class="empty-state">
                <div class="empty-icon">⏳</div>
                <h2>本日の穴馬候補はまだ生成されていません</h2>
                <p>
                    本日のレースデータがAIで分析され次第、自動的にこのページへ反映されます。<br>
                    しばらく経ってから再度ご確認ください。
                </p>
            </div>
        )}

        {hasAnyData && tabs.length > 0 && (
            <nav class="venue-tabs" role="tablist" aria-label="会場切り替え">
                {tabs.map((t, i) => (
                    <button
                        class={`venue-tab ${i === 0 ? 'active' : ''}`}
                        type="button"
                        role="tab"
                        aria-selected={i === 0 ? 'true' : 'false'}
                        data-tab-id={t.tabId}
                    >
                        <span class="tab-emoji">{t.category === 'jra' ? '🏇' : '🏁'}</span>
                        <span class="tab-name">{t.venueName}</span>
                        <span class="tab-cat">{t.category === 'jra' ? 'JRA' : '南関'}</span>
                        <span class="tab-count">{t.raceCount}R</span>
                    </button>
                ))}
            </nav>
        )}

        {hasAnyData && venuesForRender.map((venue, i) => (
            <section class={`races-section venue-panel ${i === 0 ? 'active' : ''}`} data-tab-id={venue.tabId} role="tabpanel">
                <h2>🐎 {venue.date} {venue.venueName}競馬</h2>
                <p class="section-subtitle">狙い目の穴馬をレース別に抽出</p>
                <div class="races-grid">
                    {venue.races.map((race) => {
                        const raceId = `${venue.tabId}:${race.raceNumber}`;
                        const isEmpty = race.darkHorses.length === 0;
                        const distanceLabel = (() => {
                            if (race.distance == null) return null;
                            const n = typeof race.distance === 'number' ? race.distance : parseInt(String(race.distance).replace(/[^\d]/g, ''), 10);
                            return Number.isFinite(n) && n > 0 ? `${n}m` : String(race.distance);
                        })();
                        const horseCountLabel = race.horseCount ? `（${race.horseCount}頭）` : '';
                        const sizeLine = distanceLabel ? `${distanceLabel}${horseCountLabel}` : (horseCountLabel ? horseCountLabel : '');

                        return (
                            <div class={`race-card${isEmpty ? ' is-empty' : ''}`} data-race-id={raceId} data-empty={isEmpty ? '1' : '0'}>
                                <div class="race-header">
                                    <div class="race-title-row">
                                        <span class="race-number">{`${race.raceNumber}R`}</span>
                                        <span class="race-name">{race.raceName || `第${race.raceNumber}レース`}</span>
                                    </div>
                                </div>

                                <div class="race-details">
                                    {sizeLine && <div class="race-detail-line">{sizeLine}</div>}
                                    {race.startTime && <div class="race-detail-line start-time">💎発走時刻 {race.startTime}</div>}
                                </div>

                                {isEmpty ? (
                                    <div class="empty-pick">
                                        <span class="empty-pick-icon">―</span>
                                        <span class="empty-pick-text">本日の注目候補は少なめです</span>
                                    </div>
                                ) : (
                                    <button class="reveal-button" data-race-id={raceId}>
                                        <span class="button-icon">🔒</span>
                                        <span class="button-text">穴馬を見る</span>
                                    </button>
                                )}
                            </div>
                        );
                    })}
                </div>
            </section>
        ))}

        <section class="how-it-works">
            <h2>📌 抽出ロジックについて</h2>
            <div class="how-grid">
                <div class="how-card">
                    <h3>🤖 AI分析</h3>
                    <ul>
                        <li>独自AIが各馬の評価データを総合分析</li>
                        <li>過去パフォーマンスから巻き返し余地を判定</li>
                        <li>人気と評価のギャップから狙い目を抽出</li>
                    </ul>
                </div>
                <div class="how-card">
                    <h3>📊 区分の見方</h3>
                    <ul>
                        <li><span class="tag tag-darkhorse inline">穴馬</span>：前走6〜12着、人気以上に指数が評価しており巻き返し余地が大きい一頭</li>
                        <li><span class="tag tag-value inline">妙味馬</span>：前走3〜5着など、人気と指数のギャップで拾える一頭</li>
                        <li><span class="tag tag-fallback inline">補完候補</span>：通常抽出該当なしのレースで中位指数から拾った一頭</li>
                    </ul>
                </div>
                <div class="how-card">
                    <h3>⚠️ 注意事項</h3>
                    <ul>
                        <li>過去データに基づくAI抽出のため、的中を保証するものではありません</li>
                        <li>当日のコンディションも併せてご確認ください</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="cta-section">
            <div class="cta-card">
                <h2>🎯 全レースの詳細予想を見るなら</h2>
                <p>本ツールは穴馬候補のみを抽出しています。買い目・戦略を含む全レース詳細予想は会員プランでご利用いただけます。</p>
                <a href="/pricing" class="cta-button">料金プランを見る →</a>
            </div>
        </section>
    </div>

    <!-- 穴馬モーダル -->
    <div id="dark-horse-modal" class="modal" aria-hidden="true">
        <div class="modal-backdrop" data-modal-close></div>
        <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="modal-race-title">
            <button class="modal-close" data-modal-close aria-label="閉じる">×</button>
            <div class="modal-header">
                <p class="modal-meta" id="modal-meta"></p>
                <h2 id="modal-race-title">レース情報</h2>
            </div>
            <div class="modal-body" id="modal-body"></div>
            <div class="modal-disclaimer">
                <p>⚠️ この情報はAI分析により抽出した穴馬候補です。当日のコンディション等もご確認の上でご利用ください。</p>
            </div>
        </div>
    </div>

    <script is:inline define:vars={{ racesLookup, latestDateByCategory }}>
        const PLAN_LIMITS = { free: 1, light: 2, standard: 2, premium: Infinity };
        const PLAN_NAMES = { free: '🎯 無料会員', light: '⭐ ライト会員', standard: '⭐ ライト会員', premium: '👑 プレミアム会員' };

        const STORAGE_KEY = 'analytics-keiba-darkhorse-picks-v1';
        const STORAGE_DATE = Object.values(latestDateByCategory).sort().join(',') || 'none';

        let userPlan = 'free';
        let usedPicks = [];

        document.addEventListener('DOMContentLoaded', () => {
            loadUserPlan();
            loadUsedPicks();
            updatePlanBadge();
            updateUI();
            attachEventListeners();
        });

        function loadUserPlan() {
            try {
                const raw = localStorage.getItem('user-plan');
                if (raw) {
                    const data = JSON.parse(raw);
                    const plan = String(data?.plan || '').toLowerCase();
                    const isWithdrawal = localStorage.getItem('isWithdrawalRequested') === 'true';
                    const isExpired = localStorage.getItem('isExpired') === 'true';
                    if (isWithdrawal || isExpired) { userPlan = 'free'; return; }
                    if (plan.includes('premium')) userPlan = 'premium';
                    else if (plan.includes('light') || plan.includes('standard')) userPlan = 'light';
                    else userPlan = 'free';
                    return;
                }
                const oldPlan = localStorage.getItem('userPlan');
                if (oldPlan) {
                    const p = String(oldPlan).toLowerCase();
                    if (p.includes('premium')) userPlan = 'premium';
                    else if (p.includes('light') || p.includes('standard')) userPlan = 'light';
                    else userPlan = 'free';
                }
            } catch (e) {
                userPlan = 'free';
            }
        }

        function loadUsedPicks() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) { usedPicks = []; return; }
                const data = JSON.parse(raw);
                if (data?.date !== STORAGE_DATE) {
                    usedPicks = [];
                    saveUsedPicks();
                    return;
                }
                usedPicks = Array.isArray(data?.used) ? data.used : [];
            } catch (e) {
                usedPicks = [];
            }
        }

        function saveUsedPicks() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify({ date: STORAGE_DATE, used: usedPicks }));
            } catch (e) {}
        }

        function updatePlanBadge() {
            const el = document.getElementById('plan-badge');
            if (el) {
                el.textContent = PLAN_NAMES[userPlan] || PLAN_NAMES.free;
                el.className = 'plan-badge plan-' + userPlan;
            }
        }

        function getLimit() { return PLAN_LIMITS[userPlan] ?? 1; }

        function updateUI() {
            const limit = getLimit();
            const remainingEl = document.getElementById('remaining-picks');
            if (remainingEl) {
                remainingEl.textContent = limit === Infinity ? '無制限' : `${Math.max(0, limit - usedPicks.length)}回`;
            }

            document.querySelectorAll('.race-card').forEach((card) => {
                if (card.getAttribute('data-empty') === '1') return; // 該当馬なしはスキップ
                const id = card.getAttribute('data-race-id');
                const button = card.querySelector('.reveal-button');
                if (!button) return;
                const isUsed = usedPicks.includes(id);
                const isOverLimit = userPlan !== 'premium' && !isUsed && usedPicks.length >= limit;

                button.classList.remove('upgrade-button', 'used-button');
                button.disabled = false;
                card.classList.remove('disabled', 'used');

                if (isUsed) {
                    card.classList.add('used');
                    button.classList.add('used-button');
                    button.innerHTML = '<span class="button-icon">👀</span><span class="button-text">再確認する</span>';
                } else if (isOverLimit) {
                    card.classList.add('disabled');
                    button.classList.add('upgrade-button');
                    button.innerHTML = '<span class="button-icon">✨</span><span class="button-text">プランをアップグレード</span>';
                } else {
                    button.innerHTML = '<span class="button-icon">🔒</span><span class="button-text">穴馬を見る</span>';
                }
            });
        }

        function attachEventListeners() {
            // 会場タブ
            document.querySelectorAll('.venue-tab').forEach((tab) => {
                tab.addEventListener('click', () => {
                    const tabId = tab.getAttribute('data-tab-id');
                    document.querySelectorAll('.venue-tab').forEach((t) => {
                        const active = t.getAttribute('data-tab-id') === tabId;
                        t.classList.toggle('active', active);
                        t.setAttribute('aria-selected', active ? 'true' : 'false');
                    });
                    document.querySelectorAll('.venue-panel').forEach((p) => {
                        p.classList.toggle('active', p.getAttribute('data-tab-id') === tabId);
                    });
                });
            });

            // 穴馬リビール
            document.querySelectorAll('.reveal-button').forEach((btn) => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const id = btn.getAttribute('data-race-id');
                    if (btn.classList.contains('upgrade-button')) {
                        window.location.href = '/pricing';
                        return;
                    }
                    const isUsed = usedPicks.includes(id);
                    const limit = getLimit();
                    if (!isUsed && userPlan !== 'premium' && usedPicks.length >= limit) {
                        alert('本日の取得回数の上限に達しました。プランをアップグレードすると、さらに多くのレースを確認できます。');
                        return;
                    }
                    showModal(id);
                    if (!isUsed) {
                        usedPicks.push(id);
                        saveUsedPicks();
                        updateUI();
                    }
                });
            });

            // モーダル閉じる
            document.querySelectorAll('[data-modal-close]').forEach((el) => {
                el.addEventListener('click', closeModal);
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeModal();
            });
        }

        // 事実ベースの評価タグ生成（2026-05-11 改訂）
        // 穴馬・妙味馬の上昇余地と人気/指数ギャップを示す事実タグのみ使用。
        // 「前走勝利」「前走好走」など好走を強調するタグは穴馬ページの趣旨に反するため禁止。
        // 使用語彙: #巻き返し候補 / #指数妙味 / #人気盲点 / #着順上昇余地 /
        //          #中位指数 / #補完候補 / #相手候補 / #過去走データ不足
        function getFactualTags(horse, info) {
            const tags = [];
            const lf = horse.lastFinish;
            const count = info?.count ?? 0;
            const isFallback = !!horse.fallback;
            const gap = horse.gap || 0;
            const indexRank = horse.indexRank || 0;

            // 前走着順タグ（穴馬ページ趣旨に沿って「上昇余地」「巻き返し」のみ）
            if (lf != null) {
                if (lf >= 6 && lf <= 9) {
                    tags.push({ label: '巻き返し候補', kind: 'recover' });
                    tags.push({ label: '着順上昇余地', kind: 'good' });
                } else if (lf >= 10 && lf <= 12) {
                    tags.push({ label: '巻き返し候補', kind: 'recover' });
                } else if (lf === 4 || lf === 5) {
                    tags.push({ label: '着順上昇余地', kind: 'good' });
                }
                // lf === 3 や 例外2着、lf >= 13 は gap / indexRank タグに任せる
            }

            // 抽出根拠（gap / fallback / indexRank）
            if (isFallback) {
                tags.push({ label: '補完候補', kind: 'fallback' });
            } else if (gap >= 5) {
                tags.push({ label: '人気盲点', kind: 'edge' });
            } else if (gap >= 2) {
                tags.push({ label: '指数妙味', kind: 'edge' });
            }

            // 中位指数（穴馬ページでは中位指数の馬を優遇する）
            if (indexRank >= 3 && indexRank <= 6) {
                tags.push({ label: '中位指数', kind: 'edge' });
            }

            // データ不足の明示
            if (count === 0) tags.push({ label: '過去走データ不足', kind: 'warn' });

            // 何もタグが付かなければ無難な相手候補タグを 1 つ
            if (tags.length === 0) tags.push({ label: '相手候補', kind: 'good' });

            // 重複ラベルを除去（同じラベルが複数 push されるケースの安全弁）
            const seen = new Set();
            const dedup = [];
            for (const t of tags) {
                if (seen.has(t.label)) continue;
                seen.add(t.label);
                dedup.push(t);
            }
            return dedup.slice(0, 4);
        }

        // 表示用のカテゴリ判定（保存済みデータの category は信用せずクライアント側で再分類）
        // - fallback フラグあり → 補完候補
        // - 前走6〜12着 → 穴馬（上昇余地が大きい）
        // - 前走3〜5着、例外2着、データなし → 妙味馬
        function classifyHorse(horse) {
            if (horse.fallback) return { key: 'fallback', label: '補完候補' };
            const lf = horse.lastFinish;
            if (lf != null && lf >= 6 && lf <= 12) return { key: 'darkhorse', label: '穴馬' };
            return { key: 'value', label: '妙味馬' };
        }

        function getStarRating(score) {
            const s = Number(score) || 0;
            const stars = Math.max(2, Math.min(5, Math.round(s / 20)));
            return '★'.repeat(stars) + '☆'.repeat(5 - stars);
        }

        function buildHorseCardsHtml(horses, horsePastInfo) {
            return horses.map((h, idx) => {
                const cls = classifyHorse(h);
                const isDark = cls.key === 'darkhorse';
                const tag = `<span class="tag tag-${cls.key}">${cls.label}</span>`;
                const lf = h.lastFinish == null ? '-' : `${h.lastFinish}着`;
                const info = horsePastInfo?.[String(h.number)] || null;
                const factTags = getFactualTags(h, info);
                const stars = getStarRating(h.score);
                // タグはチップ表示。CSS gap が効かない環境でも視認できるよう
                // ラベルに # プレフィックスを付与し、チップ間にスペーステキストノードも挿入
                const tagsHtml = factTags
                    .map(t => `<span class="horse-tag-chip tag-${t.kind}">#${escapeHtml(t.label)}</span>`)
                    .join(' ');
                return `
                    <article class="horse-card is-${cls.key}" style="--delay: ${idx * 80}ms">
                        <div class="horse-card-glow"></div>
                        <header class="horse-card-head">
                            <div class="horse-num-wrap">
                                <span class="horse-num">${h.number}</span>
                            </div>
                            <div class="horse-name-wrap">
                                <div class="horse-name">${escapeHtml(h.name || '-')}</div>
                                <div class="horse-tag-row">${tag}</div>
                            </div>
                        </header>

                        <div class="horse-card-rating">
                            <span class="rating-label">🤖 AI評価</span>
                            <span class="rating-stars">${stars}</span>
                        </div>

                        <div class="horse-card-meta">
                            <span class="meta-chip"><span class="meta-icon">🏁</span><span class="meta-label">前走</span><span class="meta-value">${lf}</span></span>
                        </div>

                        <div class="horse-tags">
                            <div class="tags-head">
                                <span class="tags-head-icon">🤖</span>
                                <span class="tags-head-text">評価根拠</span>
                            </div>
                            <div class="tags-row">${tagsHtml}</div>
                        </div>
                    </article>
                `;
            }).join('');
        }

        function buildLoadingHtml() {
            return `
                <div class="ai-loading">
                    <div class="ai-loading-orb">
                        <div class="orb-ring r1"></div>
                        <div class="orb-ring r2"></div>
                        <div class="orb-ring r3"></div>
                        <div class="orb-core">🤖</div>
                    </div>
                    <div class="ai-loading-status">
                        <div class="ai-loading-title">AI分析中...</div>
                        <div class="ai-loading-step" id="ai-loading-step">レースデータを読み込み中</div>
                    </div>
                    <div class="ai-loading-bar"><div class="ai-loading-bar-fill"></div></div>
                </div>
            `;
        }

        function runLoadingSequence(callback) {
            const steps = [
                'レースデータを読み込み中...',
                '出走馬の過去成績を解析中...',
                '適性スコアを計算中...',
                '人気と評価のギャップを検出中...',
                '穴馬候補を抽出中...',
                '分析完了'
            ];
            const stepEl = document.getElementById('ai-loading-step');
            const totalMs = 1600;
            const interval = totalMs / steps.length;
            let i = 0;
            const timer = setInterval(() => {
                i++;
                if (stepEl && i < steps.length) {
                    stepEl.textContent = steps[i];
                }
                if (i >= steps.length - 1) {
                    clearInterval(timer);
                    setTimeout(callback, 220);
                }
            }, interval);
        }

        function showModal(id) {
            const race = racesLookup[id];
            if (!race) return;
            const modal = document.getElementById('dark-horse-modal');
            const meta = document.getElementById('modal-meta');
            const title = document.getElementById('modal-race-title');
            const body = document.getElementById('modal-body');

            const categoryLabel = race.category === 'jra' ? '🏇 中央競馬（JRA）' : '🏁 南関競馬';
            meta.textContent = `${categoryLabel} ／ ${race.date} ／ ${race.venueName}競馬`;
            title.textContent = `${race.raceNumber}R${race.raceName ? ' ' + race.raceName : ''}`;

            const horses = (race.darkHorses || []).slice().sort((a, b) => {
                if (a.category !== b.category) return a.category === 'darkhorse' ? -1 : 1;
                return (b.score || 0) - (a.score || 0);
            });

            body.innerHTML = buildLoadingHtml();
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';

            runLoadingSequence(() => {
                body.innerHTML = `<div class="horse-card-list">${buildHorseCardsHtml(horses, race.horsePastInfo)}</div>`;
            });
        }

        function closeModal() {
            const modal = document.getElementById('dark-horse-modal');
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    </script>

