---
import '../styles/global.css';

export const prerender = true;

// keiba-data-shared から取り込んだ computer JSON を読み込み（src/data/computer/{jra,nankan}/...）
const modules = import.meta.glob('/src/data/computer/**/*.json', { eager: true });

const VENUE_LABEL_JA = {
  TOK: '東京', NAK: '中山', KYO: '京都', HAN: '阪神', CHU: '中京',
  NII: '新潟', KOK: '小倉', SAP: '札幌', HKD: '函館', FKS: '福島',
  OOI: '大井', KAW: '川崎', FUN: '船橋', URA: '浦和'
};

// 各 JSON を venue エントリに正規化
const allEntries = Object.entries(modules)
  .map(([path, mod]) => {
    const m = path.match(/\/computer\/(jra|nankan)\/(\d{4})\/(\d{2})\/(\d{4}-\d{2}-\d{2})-([A-Z]+)\.json$/);
    if (!m) return null;
    const [, category, , , date, venueCode] = m;
    const data = (mod && mod.default) ? mod.default : mod;
    if (!data || !Array.isArray(data.races)) return null;
    return { path, category, date, venueCode, data };
  })
  .filter(Boolean);

const entriesWithDarkHorses = allEntries.filter(e =>
  e.data.races.some(r => Array.isArray(r.darkHorses) && r.darkHorses.length > 0)
);

// カテゴリごとに最新日付を採用
const latestDateByCategory = {};
for (const e of entriesWithDarkHorses) {
  if (!latestDateByCategory[e.category] || e.date > latestDateByCategory[e.category]) {
    latestDateByCategory[e.category] = e.date;
  }
}

// 表示対象は「カテゴリの最新日」と一致するもののみ
const visibleEntries = entriesWithDarkHorses
  .filter(e => e.date === latestDateByCategory[e.category])
  .sort((a, b) => {
    // JRA を先に、その後南関。同カテゴリ内は会場コード順
    if (a.category !== b.category) return a.category === 'jra' ? -1 : 1;
    return a.venueCode.localeCompare(b.venueCode);
  });

// タブ用 venue 一覧
const tabs = visibleEntries.map(e => ({
  category: e.category,
  venueCode: e.venueCode,
  venueName: VENUE_LABEL_JA[e.venueCode] || e.venueCode,
  date: e.date,
  raceCount: e.data.races.filter(r => r.darkHorses?.length > 0).length,
  tabId: `${e.category}-${e.venueCode}`,
}));

// 表示用に各 venue のレースを整形（darkHorses 入りのみ）
function buildVenueDisplay(entry) {
  return entry.data.races
    .map(r => ({
      raceNumber: parseInt(r.raceNumber, 10) || r.raceNumber,
      raceName: r.raceName || '',
      distance: r.distance || r.distanceMeters || null,
      horseCount: r.horseCount || (r.horses?.length ?? null),
      startTime: r.startTime || null,
      darkHorses: [...(r.darkHorses || [])]
        // 前走1着は完全除外、前走2着は例外（exceptional2nd フラグ）のみ許容
        .filter(h => h.lastFinish !== 1)
        .filter(h => h.lastFinish !== 2 || h.exceptional2nd === true)
        .sort((a, b) => (b.score || 0) - (a.score || 0))
        .slice(0, 3),
    }))
    .sort((a, b) => parseInt(a.raceNumber) - parseInt(b.raceNumber));
}

const venuesForRender = visibleEntries.map(e => ({
  ...e,
  venueName: VENUE_LABEL_JA[e.venueCode] || e.venueCode,
  tabId: `${e.category}-${e.venueCode}`,
  races: buildVenueDisplay(e),
}));

const totalDarkHorses = venuesForRender.reduce(
  (s, v) => s + v.races.reduce((ss, r) => ss + r.darkHorses.length, 0), 0
);
const hasAnyData = totalDarkHorses > 0;

// 前走 finish を抽出（dark-horse.mjs と同じロジック）
function extractFinishFromPast(pr) {
  if (!pr) return null;
  const raw = pr.finish ?? pr.finishPosition ?? pr.position ?? pr.rank ?? pr.chakujun ?? pr.result ?? null;
  if (raw == null) return null;
  const digits = String(raw).replace(/[^\d]/g, '');
  if (!digits) return null;
  const n = parseInt(digits, 10);
  return n > 0 ? n : null;
}

// クライアント JS にレースデータを渡す（dark horses + 各馬の過去走 finish 情報）
const racesLookup = {};
for (const v of venuesForRender) {
  const fullRaces = v.data?.races || [];
  for (const race of v.races) {
    const id = `${v.tabId}:${race.raceNumber}`;
    const fullRace = fullRaces.find(r => parseInt(r.raceNumber) === parseInt(race.raceNumber));
    const horsePastInfo = {};
    for (const dh of race.darkHorses) {
      const fullHorse = fullRace?.horses?.find(h => String(h.number) === String(dh.number));
      const past = (fullHorse?.pastRaces || []).slice(0, 5);
      const finishes = past.map(extractFinishFromPast).filter(n => n != null);
      horsePastInfo[String(dh.number)] = { count: past.length, finishes };
    }
    racesLookup[id] = {
      category: v.category,
      venueCode: v.venueCode,
      venueName: v.venueName,
      date: v.date,
      raceNumber: race.raceNumber,
      raceName: race.raceName,
      darkHorses: race.darkHorses,
      horsePastInfo,
    };
  }
}

function formatJpDate(date) {
  const [, m, d] = date.split('-');
  return `${parseInt(m)}月${parseInt(d)}日`;
}
