---
import '../styles/global.css';

export const prerender = true;

// keiba-data-shared から取り込んだ computer JSON を読み込み（src/data/computer/{jra,nankan}/...）
const modules = import.meta.glob('/src/data/computer/**/*.json', { eager: true });

/**
 * @typedef {Object} DarkHorse
 * @property {number|string} number
 * @property {string} name
 * @property {number} popularityRank
 * @property {number} indexRank
 * @property {number} gap
 * @property {number|null} lastFinish
 * @property {number} score
 * @property {'darkhorse'|'value'} category
 * @property {number|string} computerIndex
 * @property {string[]} reasons
 */

const CATEGORY_LABEL = {
  jra: { title: '🏇 中央競馬（JRA）の穴馬候補', subtitle: '指数で買われていない馬を抽出', accent: '#10b981' },
  nankan: { title: '🏁 南関競馬の穴馬候補', subtitle: '指数で買われていない馬を抽出', accent: '#ef4444' },
};

const VENUE_LABEL_JA = {
  TOK: '東京', NAK: '中山', KYO: '京都', HAN: '阪神', CHU: '中京',
  NII: '新潟', KOK: '小倉', SAP: '札幌', HKD: '函館', FKS: '福島',
  OOI: '大井', KAW: '川崎', FUN: '船橋', URA: '浦和'
};

// 各 JSON を venue エントリに正規化
const allEntries = Object.entries(modules)
  .map(([path, mod]) => {
    const m = path.match(/\/computer\/(jra|nankan)\/(\d{4})\/(\d{2})\/(\d{4}-\d{2}-\d{2})-([A-Z]+)\.json$/);
    if (!m) return null;
    const [, category, year, month, date, venueCode] = m;
    const data = (mod && mod.default) ? mod.default : mod;
    if (!data || !Array.isArray(data.races)) return null;
    return { path, category, date, venueCode, data };
  })
  .filter(Boolean);

// darkHorses が1件でも入っているエントリのみ表示対象
const entriesWithDarkHorses = allEntries.filter(e =>
  e.data.races.some(r => Array.isArray(r.darkHorses) && r.darkHorses.length > 0)
);

// カテゴリごとに最新日付を採用（古いデータが混じらないように）
const latestDateByCategory = {};
for (const e of entriesWithDarkHorses) {
  if (!latestDateByCategory[e.category] || e.date > latestDateByCategory[e.category]) {
    latestDateByCategory[e.category] = e.date;
  }
}

const visibleByCategory = { jra: [], nankan: [] };
for (const e of entriesWithDarkHorses) {
  if (e.date !== latestDateByCategory[e.category]) continue;
  visibleByCategory[e.category].push(e);
}

// 会場名でソート
['jra', 'nankan'].forEach(cat => {
  visibleByCategory[cat].sort((a, b) => a.venueCode.localeCompare(b.venueCode));
});

const totalDarkHorses = entriesWithDarkHorses
  .filter(e => e.date === latestDateByCategory[e.category])
  .reduce((sum, e) => sum + e.data.races.reduce((s, r) => s + (r.darkHorses?.length || 0), 0), 0);

const hasAnyData = totalDarkHorses > 0;
const totalVenues = visibleByCategory.jra.length + visibleByCategory.nankan.length;

function formatJpDate(date) {
  const [, m, d] = date.split('-');
  return `${parseInt(m)}月${parseInt(d)}日`;
}
function venueLabel(category, venueCode) {
  return VENUE_LABEL_JA[venueCode] || venueCode;
}
function lastFinishLabel(lastFinish) {
  return lastFinish == null ? '-' : `${lastFinish}着`;
}
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>中央・南関 穴馬抽出ツール【無料】本日の狙い目を自動抽出 | KEIBA Analytics</title>
    <meta name="description" content="中央競馬（JRA）と南関競馬の穴馬候補を、コンピ指数と人気順位の乖離・前走着順から自動抽出。レース別に狙い目の穴馬と指数妙味馬を表示します。" />
    <meta name="keywords" content="中央競馬,JRA,南関競馬,穴馬,穴馬抽出,コンピ指数,人気,指数妙味,予想,競馬ツール" />
    <link rel="canonical" href="https://analytics.keiba.link/dark-horse-picks" />

    <meta property="og:title" content="中央・南関 穴馬抽出ツール【無料】" />
    <meta property="og:description" content="中央競馬（JRA）と南関競馬の穴馬候補を自動抽出。コンピ指数と人気の乖離・前走着順から狙い目を表示。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://analytics.keiba.link/dark-horse-picks" />
    <meta property="og:site_name" content="KEIBA Analytics" />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="中央・南関 穴馬抽出ツール【無料】" />
    <meta name="twitter:description" content="中央競馬と南関競馬の穴馬候補を自動抽出。レース別に狙い目を表示。" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "中央・南関 穴馬抽出ツール",
      "applicationCategory": "SportsApplication",
      "operatingSystem": "Any",
      "description": "中央競馬（JRA）と南関競馬の穴馬候補を、コンピ指数と人気順位の乖離・前走着順から自動抽出するツール",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "JPY", "availability": "https://schema.org/InStock" },
      "provider": { "@type": "Organization", "name": "KEIBA Analytics", "url": "https://analytics.keiba.link" }
    }
    </script>
</head>
<body>
    <div class="container">
        <header class="page-header">
            <div class="header-content">
                <a href="/" class="back-link">← トップへ戻る</a>
                <h1>🐴 本日の穴馬抽出</h1>
                <p class="subtitle">中央競馬（JRA）と南関競馬の穴馬候補を自動抽出</p>
                <p class="header-meta">
                    対象会場 {totalVenues} 会場 / 抽出件数 {totalDarkHorses} 頭
                </p>
            </div>
        </header>

        {!hasAnyData && (
            <div class="empty-state">
                <div class="empty-icon">⏳</div>
                <h2>本日の穴馬候補はまだ生成されていません</h2>
                <p>
                    管理画面でコンピ指数を保存すると、自動的にこのページへ反映されます。<br>
                    しばらく経ってから再度ご確認ください。
                </p>
            </div>
        )}

        {hasAnyData && (['jra', 'nankan']).map((category) => {
            const venues = visibleByCategory[category];
            if (venues.length === 0) return null;
            const label = CATEGORY_LABEL[category];
            const date = latestDateByCategory[category];

            return (
                <section class={`category-section category-${category}`}>
                    <div class="category-header">
                        <h2 class="category-title">{label.title}</h2>
                        <p class="category-subtitle">{label.subtitle}</p>
                        <p class="category-date">{formatJpDate(date)}（{date}）{venues.length}会場</p>
                    </div>

                    <div class="venues-stack">
                        {venues.map((entry) => {
                            const venueName = venueLabel(category, entry.venueCode);
                            const races = entry.data.races
                                .filter(r => Array.isArray(r.darkHorses) && r.darkHorses.length > 0)
                                .sort((a, b) => parseInt(a.raceNumber) - parseInt(b.raceNumber));
                            if (races.length === 0) return null;

                            const venueDarkHorseCount = races.reduce((s, r) => s + r.darkHorses.length, 0);

                            return (
                                <article class="venue-card">
                                    <header class="venue-card-header">
                                        <h3 class="venue-name">
                                            <span class="venue-emoji">{category === 'jra' ? '🏇' : '🏁'}</span>
                                            {venueName}競馬
                                        </h3>
                                        <span class="venue-count">{races.length}R / {venueDarkHorseCount}頭</span>
                                    </header>

                                    <div class="races-list">
                                        {races.map((race) => (
                                            <div class="race-block">
                                                <div class="race-header">
                                                    <span class="race-number">R{race.raceNumber}</span>
                                                    {race.raceName && <span class="race-name">{race.raceName}</span>}
                                                </div>
                                                <div class="dark-horse-table-wrap">
                                                <table class="dark-horse-table">
                                                    <thead>
                                                        <tr>
                                                            <th class="th-num">馬番</th>
                                                            <th class="th-name">馬名</th>
                                                            <th class="th-tag">区分</th>
                                                            <th class="th-rank">人気</th>
                                                            <th class="th-rank">指数順位</th>
                                                            <th class="th-rank">差</th>
                                                            <th class="th-rank">前走</th>
                                                            <th class="th-score">スコア</th>
                                                            <th class="th-reason">分析理由</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {race.darkHorses
                                                            .slice()
                                                            .sort((a, b) => {
                                                                if (a.category !== b.category) return a.category === 'darkhorse' ? -1 : 1;
                                                                return (b.score || 0) - (a.score || 0);
                                                            })
                                                            .map((h) => {
                                                                const isDark = h.category === 'darkhorse';
                                                                return (
                                                                    <tr class={isDark ? 'row-darkhorse' : 'row-value'}>
                                                                        <td class="td-num">{h.number}</td>
                                                                        <td class="td-name">{h.name || '-'}</td>
                                                                        <td class="td-tag">
                                                                            <span class={`tag tag-${h.category}`}>
                                                                                {isDark ? '穴馬' : '指数妙味'}
                                                                            </span>
                                                                        </td>
                                                                        <td class="td-rank">{h.popularityRank}位</td>
                                                                        <td class="td-rank rank-index">{h.indexRank}位</td>
                                                                        <td class="td-rank rank-gap">+{h.gap}</td>
                                                                        <td class="td-rank">{lastFinishLabel(h.lastFinish)}</td>
                                                                        <td class="td-score">{h.score}</td>
                                                                        <td class="td-reason">
                                                                            {Array.isArray(h.reasons) && h.reasons.length > 0
                                                                                ? h.reasons.join(' / ')
                                                                                : '—'}
                                                                        </td>
                                                                    </tr>
                                                                );
                                                            })}
                                                    </tbody>
                                                </table>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </article>
                            );
                        })}
                    </div>
                </section>
            );
        })}

        <section class="how-it-works">
            <h2>📌 抽出ロジックについて</h2>
            <div class="how-grid">
                <div class="how-card">
                    <h3>🔎 抽出条件</h3>
                    <ul>
                        <li>人気順位 &gt; 指数順位（指数の方が上位）</li>
                        <li>人気1〜2位は穴馬対象から除外</li>
                        <li>前走着順が悪いほど加点（凡走で人気を落とした馬を優先）</li>
                        <li>前走1〜3着は「指数妙味馬」として区別</li>
                    </ul>
                </div>
                <div class="how-card">
                    <h3>📊 区分の見方</h3>
                    <ul>
                        <li><span class="tag tag-darkhorse inline">穴馬</span>：人気は低めだが指数で評価され、前走凡走から巻き返し余地ありの馬</li>
                        <li><span class="tag tag-value inline">指数妙味</span>：好走続きで人気との差は小さいが、指数評価が高い馬</li>
                    </ul>
                </div>
                <div class="how-card">
                    <h3>⚠️ 注意事項</h3>
                    <ul>
                        <li>過去データに基づく自動抽出のため、的中を保証するものではありません</li>
                        <li>当日のコンディションも併せてご確認ください</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="cta-section">
            <div class="cta-card">
                <h2>🎯 全レースの詳細予想を見るなら</h2>
                <p>本ツールは穴馬候補のみを抽出しています。買い目・戦略を含む全レース詳細予想は会員プランでご利用いただけます。</p>
                <a href="/pricing" class="cta-button">料金プランを見る →</a>
            </div>
        </section>
    </div>

    <style>
        :root {
            --bg-deep: #0f172a;
            --bg-card: rgba(15, 23, 42, 0.6);
            --bg-elev: rgba(30, 41, 59, 0.65);
            --border: rgba(148, 163, 184, 0.2);
            --text: #e2e8f0;
            --text-mute: #94a3b8;
            --text-strong: #f1f5f9;
            --jra: #10b981;
            --nankan: #ef4444;
            --gold: #fbbf24;
            --darkhorse: #fca5a5;
            --value: #fcd34d;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: var(--text);
            font-family: 'Hiragino Sans', 'Yu Gothic', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            margin: 0;
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px 80px;
        }

        .page-header {
            padding: 32px 0 24px;
            text-align: center;
            border-bottom: 1px solid var(--border);
            margin-bottom: 32px;
        }
        .header-content .back-link {
            display: inline-block;
            color: #93c5fd;
            text-decoration: none;
            margin-bottom: 12px;
            font-size: 0.9rem;
        }
        .header-content .back-link:hover { text-decoration: underline; }
        .page-header h1 {
            font-size: 2rem;
            margin: 0 0 8px;
            background: linear-gradient(135deg, var(--gold) 0%, var(--darkhorse) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .page-header .subtitle { color: var(--text-mute); margin: 0 0 6px; font-size: 0.95rem; }
        .page-header .header-meta { color: var(--text-mute); font-size: 0.85rem; margin: 0; }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: var(--bg-card);
            border: 1px dashed var(--border);
            border-radius: 16px;
            color: var(--text-mute);
        }
        .empty-state .empty-icon { font-size: 3rem; margin-bottom: 12px; }
        .empty-state h2 { color: var(--text-strong); margin: 0 0 12px; font-size: 1.3rem; }
        .empty-state p { margin: 0; font-size: 0.95rem; }

        .category-section { margin: 0 0 56px; }
        .category-header { margin-bottom: 18px; padding: 18px 20px; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--border); }
        .category-section.category-jra .category-header { border-left: 4px solid var(--jra); }
        .category-section.category-nankan .category-header { border-left: 4px solid var(--nankan); }
        .category-title { margin: 0 0 6px; color: var(--text-strong); font-size: 1.4rem; }
        .category-subtitle { margin: 0 0 6px; color: var(--text-mute); font-size: 0.9rem; }
        .category-date { margin: 0; color: var(--text-mute); font-size: 0.85rem; }

        .venues-stack { display: grid; gap: 18px; }

        .venue-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
        }
        .venue-card-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            padding: 14px 18px;
            background: var(--bg-elev);
            border-bottom: 1px solid var(--border);
        }
        .venue-name { margin: 0; color: var(--text-strong); font-size: 1.1rem; }
        .venue-emoji { margin-right: 6px; }
        .venue-count { color: var(--text-mute); font-size: 0.85rem; }

        .races-list { padding: 14px 14px 6px; display: grid; gap: 18px; }

        .race-block {
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        .race-header { padding: 10px 14px; background: rgba(51, 65, 85, 0.5); border-bottom: 1px solid var(--border); display: flex; gap: 10px; align-items: baseline; }
        .race-number { font-weight: 800; color: #a5b4fc; font-size: 0.95rem; }
        .race-name { color: var(--text-mute); font-size: 0.85rem; }

        /* 9列テーブルのスマホ対応: 横スクロール */
        .dark-horse-table-wrap {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .dark-horse-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
            min-width: 720px;
        }
        .dark-horse-table th, .dark-horse-table td {
            padding: 8px 10px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }
        .dark-horse-table th {
            background: rgba(30, 41, 59, 0.5);
            color: var(--text-strong);
            font-weight: 700;
            text-align: center;
            font-size: 0.78rem;
            letter-spacing: 0.02em;
        }
        .dark-horse-table .th-num, .dark-horse-table .td-num { width: 50px; text-align: center; font-weight: 800; color: var(--text-strong); }
        .dark-horse-table .td-name { font-weight: 600; color: var(--text-strong); }
        .dark-horse-table .th-tag, .dark-horse-table .td-tag { width: 90px; text-align: center; }
        .dark-horse-table .th-rank, .dark-horse-table .td-rank { width: 64px; text-align: center; color: var(--text-mute); }
        .dark-horse-table .rank-index { color: #a5b4fc; font-weight: 700; }
        .dark-horse-table .rank-gap { color: #6ee7b7; font-weight: 700; }
        .dark-horse-table .th-score, .dark-horse-table .td-score { width: 64px; text-align: center; color: var(--gold); font-weight: 700; }
        .dark-horse-table .td-reason { color: var(--text-mute); font-size: 0.82rem; }

        .row-darkhorse td { background: rgba(239, 68, 68, 0.05); }
        .row-value td { background: transparent; }

        .tag {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 800;
            border: 1px solid transparent;
        }
        .tag-darkhorse {
            background: rgba(239, 68, 68, 0.18);
            color: var(--darkhorse);
            border-color: rgba(239, 68, 68, 0.45);
        }
        .tag-value {
            background: rgba(245, 158, 11, 0.18);
            color: var(--value);
            border-color: rgba(245, 158, 11, 0.45);
        }
        .tag.inline { vertical-align: baseline; margin-right: 4px; }

        .how-it-works { margin: 56px 0 32px; }
        .how-it-works h2 { color: var(--text-strong); font-size: 1.3rem; margin: 0 0 16px; }
        .how-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
        @media (min-width: 800px) { .how-grid { grid-template-columns: repeat(3, 1fr); } }
        .how-card {
            padding: 18px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
        }
        .how-card h3 { margin: 0 0 10px; color: var(--text-strong); font-size: 1rem; }
        .how-card ul { margin: 0; padding-left: 20px; color: var(--text-mute); font-size: 0.88rem; }
        .how-card li { margin-bottom: 6px; }

        .cta-section { margin-top: 32px; }
        .cta-card {
            text-align: center;
            padding: 28px 20px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.12) 0%, rgba(139, 92, 246, 0.12) 100%);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 14px;
        }
        .cta-card h2 { margin: 0 0 10px; color: var(--text-strong); font-size: 1.2rem; }
        .cta-card p { color: var(--text-mute); margin: 0 0 16px; font-size: 0.9rem; }
        .cta-button {
            display: inline-block;
            padding: 12px 28px;
            background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            border-radius: 999px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);
        }

        @media (max-width: 720px) {
            .container { padding: 0 12px 60px; }
            .page-header h1 { font-size: 1.6rem; }
            .dark-horse-table { font-size: 0.78rem; }
            .dark-horse-table th, .dark-horse-table td { padding: 6px 6px; }
            .dark-horse-table .td-reason { font-size: 0.75rem; }
        }
    </style>
</body>
</html>
