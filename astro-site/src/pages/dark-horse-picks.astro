---
import '../styles/global.css';

export const prerender = true;

// keiba-data-shared から取り込んだ computer JSON を読み込み（src/data/computer/{jra,nankan}/...）
const modules = import.meta.glob('/src/data/computer/**/*.json', { eager: true });

const VENUE_LABEL_JA = {
  TOK: '東京', NAK: '中山', KYO: '京都', HAN: '阪神', CHU: '中京',
  NII: '新潟', KOK: '小倉', SAP: '札幌', HKD: '函館', FKS: '福島',
  OOI: '大井', KAW: '川崎', FUN: '船橋', URA: '浦和'
};

const CATEGORY_META = {
  jra: { title: '🏇 中央競馬（JRA）', accent: '#10b981' },
  nankan: { title: '🏁 南関競馬', accent: '#ef4444' },
};

// 各 JSON を venue エントリに正規化
const allEntries = Object.entries(modules)
  .map(([path, mod]) => {
    const m = path.match(/\/computer\/(jra|nankan)\/(\d{4})\/(\d{2})\/(\d{4}-\d{2}-\d{2})-([A-Z]+)\.json$/);
    if (!m) return null;
    const [, category, , , date, venueCode] = m;
    const data = (mod && mod.default) ? mod.default : mod;
    if (!data || !Array.isArray(data.races)) return null;
    return { path, category, date, venueCode, data };
  })
  .filter(Boolean);

const entriesWithDarkHorses = allEntries.filter(e =>
  e.data.races.some(r => Array.isArray(r.darkHorses) && r.darkHorses.length > 0)
);

// カテゴリごとに最新日付を採用
const latestDateByCategory = {};
for (const e of entriesWithDarkHorses) {
  if (!latestDateByCategory[e.category] || e.date > latestDateByCategory[e.category]) {
    latestDateByCategory[e.category] = e.date;
  }
}

const visibleByCategory = { jra: [], nankan: [] };
for (const e of entriesWithDarkHorses) {
  if (e.date !== latestDateByCategory[e.category]) continue;
  visibleByCategory[e.category].push(e);
}
['jra', 'nankan'].forEach(cat => {
  visibleByCategory[cat].sort((a, b) => a.venueCode.localeCompare(b.venueCode));
});

// 表示用に各 venue のレースを整形（darkHorses 入りのみ）
function buildVenueDisplay(entry) {
  const races = entry.data.races
    .filter(r => Array.isArray(r.darkHorses) && r.darkHorses.length > 0)
    .map(r => ({
      raceNumber: parseInt(r.raceNumber, 10) || r.raceNumber,
      raceName: r.raceName || '',
      distance: r.distance || r.distanceMeters || null,
      horseCount: r.horseCount || (r.horses?.length ?? null),
      startTime: r.startTime || null,
      darkHorses: r.darkHorses,
    }))
    .sort((a, b) => parseInt(a.raceNumber) - parseInt(b.raceNumber));
  return races;
}

const totalDarkHorses = ['jra', 'nankan']
  .flatMap(cat => visibleByCategory[cat])
  .reduce((sum, e) => sum + e.data.races.reduce((s, r) => s + (r.darkHorses?.length || 0), 0), 0);

const totalVenues = visibleByCategory.jra.length + visibleByCategory.nankan.length;
const hasAnyData = totalDarkHorses > 0;

// クライアント JS にレースデータを渡すための軽量化構造（HTML data 属性ではなく define:vars を使用）
const racesLookup = {};
for (const cat of ['jra', 'nankan']) {
  for (const entry of visibleByCategory[cat]) {
    const venueName = VENUE_LABEL_JA[entry.venueCode] || entry.venueCode;
    for (const race of buildVenueDisplay(entry)) {
      const id = `${cat}:${entry.venueCode}:${race.raceNumber}`;
      racesLookup[id] = {
        category: cat,
        venueCode: entry.venueCode,
        venueName,
        date: entry.date,
        raceNumber: race.raceNumber,
        raceName: race.raceName,
        darkHorses: race.darkHorses,
      };
    }
  }
}

function formatJpDate(date) {
  const [, m, d] = date.split('-');
  return `${parseInt(m)}月${parseInt(d)}日`;
}
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>中央・南関 穴馬抽出ツール【無料】本日の狙い目を自動抽出 | KEIBA Analytics</title>
    <meta name="description" content="中央競馬（JRA）と南関競馬の穴馬候補を、コンピ指数と人気順位の乖離・前走着順から自動抽出。レース別に狙い目の穴馬と指数妙味馬を表示します。" />
    <meta name="keywords" content="中央競馬,JRA,南関競馬,穴馬,穴馬抽出,コンピ指数,人気,指数妙味,予想,競馬ツール" />
    <link rel="canonical" href="https://analytics.keiba.link/dark-horse-picks" />

    <meta property="og:title" content="中央・南関 穴馬抽出ツール【無料】" />
    <meta property="og:description" content="中央競馬（JRA）と南関競馬の穴馬候補を自動抽出。レース別に狙い目を表示。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://analytics.keiba.link/dark-horse-picks" />
    <meta property="og:site_name" content="KEIBA Analytics" />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="中央・南関 穴馬抽出ツール【無料】" />
    <meta name="twitter:description" content="中央競馬と南関競馬の穴馬候補を自動抽出。" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "中央・南関 穴馬抽出ツール",
      "applicationCategory": "SportsApplication",
      "operatingSystem": "Any",
      "description": "中央競馬（JRA）と南関競馬の穴馬候補を、コンピ指数と人気順位の乖離・前走着順から自動抽出するツール",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "JPY", "availability": "https://schema.org/InStock" },
      "provider": { "@type": "Organization", "name": "KEIBA Analytics", "url": "https://analytics.keiba.link" }
    }
    </script>
</head>
<body>
    <div class="container">
        <header class="page-header">
            <div class="header-content">
                <a href="/" class="back-link">← トップへ戻る</a>
                <h1>🐴 本日の穴馬抽出</h1>
                <p class="subtitle">中央競馬（JRA）と南関競馬の穴馬候補を自動抽出</p>
                <p class="header-meta">
                    対象会場 {totalVenues} 会場 / 抽出件数 {totalDarkHorses} 頭
                </p>
            </div>
        </header>

        {hasAnyData && (
            <div class="user-info-card">
                <div class="user-plan-info">
                    <div class="plan-badge" id="plan-badge">読み込み中...</div>
                    <div class="remaining-picks">
                        <span class="picks-label">本日の残り取得回数:</span>
                        <span class="picks-count" id="remaining-picks">-</span>
                    </div>
                </div>
            </div>
        )}

        {hasAnyData && (
            <div class="plan-rules-card">
                <h2>📋 プラン別取得ルール</h2>
                <div class="rules-grid">
                    <div class="rule-item rule-free">
                        <div class="rule-header"><span class="rule-icon">🎯</span><span class="rule-plan">無料会員</span></div>
                        <p class="rule-desc">1日 1レース まで</p>
                    </div>
                    <div class="rule-item rule-light">
                        <div class="rule-header"><span class="rule-icon">⭐</span><span class="rule-plan">ライト会員</span></div>
                        <p class="rule-desc">1日 2レース まで</p>
                    </div>
                    <div class="rule-item rule-premium">
                        <div class="rule-header"><span class="rule-icon">👑</span><span class="rule-plan">プレミアム会員</span></div>
                        <p class="rule-desc">全レース無制限</p>
                    </div>
                </div>
            </div>
        )}

        {!hasAnyData && (
            <div class="empty-state">
                <div class="empty-icon">⏳</div>
                <h2>本日の穴馬候補はまだ生成されていません</h2>
                <p>
                    管理画面でコンピ指数を保存すると、自動的にこのページへ反映されます。<br>
                    しばらく経ってから再度ご確認ください。
                </p>
            </div>
        )}

        {hasAnyData && (['jra', 'nankan']).map((category) => {
            const venues = visibleByCategory[category];
            if (venues.length === 0) return null;
            const meta = CATEGORY_META[category];
            const date = latestDateByCategory[category];

            return (
                <section class={`category-section category-${category}`}>
                    <div class="category-header">
                        <h2 class="category-title">{meta.title}</h2>
                        <p class="category-date">{formatJpDate(date)}（{date}）{venues.length}会場</p>
                    </div>

                    <div class="venues-stack">
                        {venues.map((entry) => {
                            const venueName = VENUE_LABEL_JA[entry.venueCode] || entry.venueCode;
                            const races = buildVenueDisplay(entry);
                            if (races.length === 0) return null;
                            const venueDarkHorseCount = races.reduce((s, r) => s + r.darkHorses.length, 0);

                            return (
                                <article class="venue-card">
                                    <header class="venue-card-header">
                                        <h3 class="venue-name">
                                            <span class="venue-emoji">{category === 'jra' ? '🏇' : '🏁'}</span>
                                            {venueName}競馬
                                        </h3>
                                        <span class="venue-count">{races.length}R / {venueDarkHorseCount}頭</span>
                                    </header>

                                    <div class="races-grid">
                                        {races.map((race) => {
                                            const raceId = `${category}:${entry.venueCode}:${race.raceNumber}`;
                                            const distanceLabel = (() => {
                                                if (race.distance == null) return null;
                                                const n = typeof race.distance === 'number' ? race.distance : parseInt(String(race.distance).replace(/[^\d]/g, ''), 10);
                                                return Number.isFinite(n) && n > 0 ? `${n}m` : String(race.distance);
                                            })();

                                            return (
                                                <div class="race-card" data-race-id={raceId}>
                                                    <div class="race-card-head">
                                                        <span class="race-num">R{race.raceNumber}</span>
                                                        {race.raceName && <span class="race-name">{race.raceName}</span>}
                                                    </div>
                                                    <div class="race-card-meta">
                                                        {distanceLabel && <span class="meta-pill">📏 {distanceLabel}</span>}
                                                        {race.horseCount && <span class="meta-pill">🐎 {race.horseCount}頭</span>}
                                                        {race.startTime && <span class="meta-pill">🕐 {race.startTime}</span>}
                                                    </div>
                                                    <div class="dark-horse-count-badge">穴馬候補 {race.darkHorses.length}頭</div>
                                                    <button class="reveal-button" data-race-id={raceId}>
                                                        <span class="button-icon">🔓</span>
                                                        <span class="button-text">穴馬を見る</span>
                                                    </button>
                                                </div>
                                            );
                                        })}
                                    </div>
                                </article>
                            );
                        })}
                    </div>
                </section>
            );
        })}

        <section class="how-it-works">
            <h2>📌 抽出ロジックについて</h2>
            <div class="how-grid">
                <div class="how-card">
                    <h3>🔎 抽出条件</h3>
                    <ul>
                        <li>人気順位 &gt; 指数順位（指数の方が上位）</li>
                        <li>人気1〜2位は穴馬対象から除外</li>
                        <li>前走着順が悪いほど加点（凡走で人気を落とした馬を優先）</li>
                        <li>前走1〜3着は「指数妙味馬」として区別</li>
                    </ul>
                </div>
                <div class="how-card">
                    <h3>📊 区分の見方</h3>
                    <ul>
                        <li><span class="tag tag-darkhorse inline">穴馬</span>：人気は低めだが指数で評価され、前走凡走から巻き返し余地ありの馬</li>
                        <li><span class="tag tag-value inline">指数妙味</span>：好走続きで人気との差は小さいが、指数評価が高い馬</li>
                    </ul>
                </div>
                <div class="how-card">
                    <h3>⚠️ 注意事項</h3>
                    <ul>
                        <li>過去データに基づく自動抽出のため、的中を保証するものではありません</li>
                        <li>当日のコンディションも併せてご確認ください</li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="cta-section">
            <div class="cta-card">
                <h2>🎯 全レースの詳細予想を見るなら</h2>
                <p>本ツールは穴馬候補のみを抽出しています。買い目・戦略を含む全レース詳細予想は会員プランでご利用いただけます。</p>
                <a href="/pricing" class="cta-button">料金プランを見る →</a>
            </div>
        </section>
    </div>

    <!-- 穴馬モーダル -->
    <div id="dark-horse-modal" class="modal" aria-hidden="true">
        <div class="modal-backdrop" data-modal-close></div>
        <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="modal-race-title">
            <button class="modal-close" data-modal-close aria-label="閉じる">×</button>
            <div class="modal-header">
                <p class="modal-meta" id="modal-meta"></p>
                <h2 id="modal-race-title">レース情報</h2>
            </div>
            <div class="modal-body" id="modal-body"></div>
            <div class="modal-disclaimer">
                <p>⚠️ この情報はコンピ指数と人気の乖離・前走着順から算出した穴馬候補です。当日のコンディション等もご確認の上でご利用ください。</p>
            </div>
        </div>
    </div>

    <script is:inline define:vars={{ racesLookup, latestDateByCategory }}>
        const PLAN_LIMITS = { free: 1, light: 2, standard: 2, premium: Infinity };
        const PLAN_NAMES = { free: '🎯 無料会員', light: '⭐ ライト会員', standard: '⭐ ライト会員', premium: '👑 プレミアム会員' };

        const STORAGE_KEY = 'analytics-keiba-darkhorse-picks-v1';
        const STORAGE_DATE = Object.values(latestDateByCategory).sort().join(',') || 'none';

        let userPlan = 'free';
        let usedPicks = [];

        document.addEventListener('DOMContentLoaded', () => {
            loadUserPlan();
            loadUsedPicks();
            updatePlanBadge();
            updateUI();
            attachEventListeners();
        });

        function loadUserPlan() {
            try {
                const raw = localStorage.getItem('user-plan');
                if (raw) {
                    const data = JSON.parse(raw);
                    const plan = String(data?.plan || '').toLowerCase();
                    const isWithdrawal = localStorage.getItem('isWithdrawalRequested') === 'true';
                    const isExpired = localStorage.getItem('isExpired') === 'true';
                    if (isWithdrawal || isExpired) { userPlan = 'free'; return; }
                    if (plan.includes('premium')) userPlan = 'premium';
                    else if (plan.includes('light') || plan.includes('standard')) userPlan = 'light';
                    else userPlan = 'free';
                    return;
                }
                // 旧形式
                const oldPlan = localStorage.getItem('userPlan');
                if (oldPlan) {
                    const p = String(oldPlan).toLowerCase();
                    if (p.includes('premium')) userPlan = 'premium';
                    else if (p.includes('light') || p.includes('standard')) userPlan = 'light';
                    else userPlan = 'free';
                }
            } catch (e) {
                console.warn('プラン取得エラー:', e);
                userPlan = 'free';
            }
        }

        function loadUsedPicks() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) { usedPicks = []; return; }
                const data = JSON.parse(raw);
                if (data?.date !== STORAGE_DATE) {
                    // 日付が変わったらリセット
                    usedPicks = [];
                    saveUsedPicks();
                    return;
                }
                usedPicks = Array.isArray(data?.used) ? data.used : [];
            } catch (e) {
                usedPicks = [];
            }
        }

        function saveUsedPicks() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify({ date: STORAGE_DATE, used: usedPicks }));
            } catch (e) {}
        }

        function updatePlanBadge() {
            const el = document.getElementById('plan-badge');
            if (el) {
                el.textContent = PLAN_NAMES[userPlan] || PLAN_NAMES.free;
                el.className = 'plan-badge plan-' + userPlan;
            }
        }

        function getLimit() {
            return PLAN_LIMITS[userPlan] ?? 1;
        }

        function updateUI() {
            const limit = getLimit();
            const remainingEl = document.getElementById('remaining-picks');
            if (remainingEl) {
                remainingEl.textContent = limit === Infinity ? '無制限' : `${Math.max(0, limit - usedPicks.length)}回`;
            }

            document.querySelectorAll('.race-card').forEach((card) => {
                const id = card.getAttribute('data-race-id');
                const button = card.querySelector('.reveal-button');
                if (!button) return;
                const isUsed = usedPicks.includes(id);
                const isOverLimit = userPlan !== 'premium' && !isUsed && usedPicks.length >= limit;

                button.classList.remove('upgrade-button', 'used-button');
                button.disabled = false;
                card.classList.remove('disabled', 'used');

                if (isUsed) {
                    card.classList.add('used');
                    button.classList.add('used-button');
                    button.innerHTML = '<span class="button-icon">👀</span><span class="button-text">再確認する</span>';
                } else if (isOverLimit) {
                    card.classList.add('disabled');
                    button.classList.add('upgrade-button');
                    button.innerHTML = '<span class="button-icon">✨</span><span class="button-text">プランをアップグレード</span>';
                } else {
                    button.innerHTML = '<span class="button-icon">🔓</span><span class="button-text">穴馬を見る</span>';
                }
            });
        }

        function attachEventListeners() {
            document.querySelectorAll('.reveal-button').forEach((btn) => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const id = btn.getAttribute('data-race-id');
                    if (btn.classList.contains('upgrade-button')) {
                        window.location.href = '/pricing';
                        return;
                    }
                    const isUsed = usedPicks.includes(id);
                    const limit = getLimit();
                    if (!isUsed && userPlan !== 'premium' && usedPicks.length >= limit) {
                        alert('本日の取得回数の上限に達しました。プランをアップグレードすると、さらに多くのレースを確認できます。');
                        return;
                    }
                    showModal(id);
                    if (!isUsed) {
                        usedPicks.push(id);
                        saveUsedPicks();
                        updateUI();
                    }
                });
            });

            document.querySelectorAll('[data-modal-close]').forEach((el) => {
                el.addEventListener('click', closeModal);
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeModal();
            });
        }

        function showModal(id) {
            const race = racesLookup[id];
            if (!race) return;
            const modal = document.getElementById('dark-horse-modal');
            const meta = document.getElementById('modal-meta');
            const title = document.getElementById('modal-race-title');
            const body = document.getElementById('modal-body');

            const categoryLabel = race.category === 'jra' ? '🏇 中央競馬（JRA）' : '🏁 南関競馬';
            meta.textContent = `${categoryLabel} ／ ${race.date} ／ ${race.venueName}競馬`;
            title.textContent = `R${race.raceNumber}${race.raceName ? ' ' + race.raceName : ''}`;

            const horses = (race.darkHorses || []).slice().sort((a, b) => {
                if (a.category !== b.category) return a.category === 'darkhorse' ? -1 : 1;
                return (b.score || 0) - (a.score || 0);
            });

            body.innerHTML = horses.map((h) => {
                const isDark = h.category === 'darkhorse';
                const tag = isDark
                    ? '<span class="tag tag-darkhorse">穴馬</span>'
                    : '<span class="tag tag-value">指数妙味</span>';
                const lf = h.lastFinish == null ? '-' : `${h.lastFinish}着`;
                const reasons = Array.isArray(h.reasons) ? h.reasons : [];
                return `
                    <div class="horse-info-card ${isDark ? 'is-dark' : 'is-value'}">
                        <div class="horse-head">
                            <div class="horse-id-row">
                                <span class="horse-num">${h.number}</span>
                                <span class="horse-name">${escapeHtml(h.name || '-')}</span>
                                ${tag}
                            </div>
                            <div class="horse-score">スコア <strong>${h.score ?? '-'}</strong></div>
                        </div>
                        <div class="horse-stats">
                            <div class="stat"><span class="stat-label">人気</span><span class="stat-value">${h.popularityRank}位</span></div>
                            <div class="stat"><span class="stat-label">指数順位</span><span class="stat-value rank-index">${h.indexRank}位</span></div>
                            <div class="stat"><span class="stat-label">差</span><span class="stat-value rank-gap">+${h.gap}</span></div>
                            <div class="stat"><span class="stat-label">前走着順</span><span class="stat-value">${lf}</span></div>
                        </div>
                        ${reasons.length > 0 ? `
                            <div class="horse-reason">
                                <h4>📊 分析理由</h4>
                                <ul>${reasons.map(r => `<li>${escapeHtml(r)}</li>`).join('')}</ul>
                            </div>
                        ` : ''}
                    </div>
                `;
            }).join('');

            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            const modal = document.getElementById('dark-horse-modal');
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    </script>

    <style>
        :root {
            --bg-deep: #0f172a;
            --bg-card: rgba(15, 23, 42, 0.6);
            --bg-elev: rgba(30, 41, 59, 0.65);
            --border: rgba(148, 163, 184, 0.2);
            --text: #e2e8f0;
            --text-mute: #94a3b8;
            --text-strong: #f1f5f9;
            --jra: #10b981;
            --nankan: #ef4444;
            --gold: #fbbf24;
            --darkhorse: #fca5a5;
            --value: #fcd34d;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: var(--text);
            font-family: 'Hiragino Sans', 'Yu Gothic', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            margin: 0;
            line-height: 1.6;
        }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px 80px; }

        .page-header {
            padding: 32px 0 24px;
            text-align: center;
            border-bottom: 1px solid var(--border);
            margin-bottom: 24px;
        }
        .header-content .back-link { display: inline-block; color: #93c5fd; text-decoration: none; margin-bottom: 12px; font-size: 0.9rem; }
        .header-content .back-link:hover { text-decoration: underline; }
        .page-header h1 {
            font-size: 2rem;
            margin: 0 0 8px;
            background: linear-gradient(135deg, var(--gold) 0%, var(--darkhorse) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .page-header .subtitle { color: var(--text-mute); margin: 0 0 6px; font-size: 0.95rem; }
        .page-header .header-meta { color: var(--text-mute); font-size: 0.85rem; margin: 0; }

        /* ユーザー情報 */
        .user-info-card {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            padding: 14px 18px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            margin-bottom: 16px;
        }
        .user-plan-info { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
        .plan-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 700;
            background: rgba(148, 163, 184, 0.15);
            color: var(--text-strong);
            border: 1px solid var(--border);
        }
        .plan-badge.plan-premium { background: rgba(251, 191, 36, 0.2); color: #fde68a; border-color: rgba(251, 191, 36, 0.5); }
        .plan-badge.plan-light, .plan-badge.plan-standard { background: rgba(99, 102, 241, 0.2); color: #c7d2fe; border-color: rgba(99, 102, 241, 0.5); }
        .plan-badge.plan-free { background: rgba(148, 163, 184, 0.18); color: #cbd5e1; }
        .remaining-picks { color: var(--text-mute); font-size: 0.9rem; }
        .picks-count { color: var(--text-strong); font-weight: 800; margin-left: 6px; }

        /* プラン別ルール */
        .plan-rules-card {
            margin-bottom: 28px;
            padding: 18px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
        }
        .plan-rules-card h2 { margin: 0 0 12px; color: var(--text-strong); font-size: 1.1rem; }
        .rules-grid { display: grid; gap: 10px; grid-template-columns: 1fr; }
        @media (min-width: 720px) { .rules-grid { grid-template-columns: repeat(3, 1fr); } }
        .rule-item {
            padding: 12px 14px;
            background: rgba(15, 23, 42, 0.4);
            border: 1px solid var(--border);
            border-radius: 10px;
        }
        .rule-item.rule-free { border-left: 3px solid #94a3b8; }
        .rule-item.rule-light { border-left: 3px solid #6366f1; }
        .rule-item.rule-premium { border-left: 3px solid var(--gold); }
        .rule-header { display: flex; gap: 6px; align-items: center; margin-bottom: 4px; font-weight: 700; color: var(--text-strong); }
        .rule-desc { margin: 0; color: var(--text-mute); font-size: 0.88rem; }

        /* 空状態 */
        .empty-state { text-align: center; padding: 60px 20px; background: var(--bg-card); border: 1px dashed var(--border); border-radius: 16px; color: var(--text-mute); }
        .empty-state .empty-icon { font-size: 3rem; margin-bottom: 12px; }
        .empty-state h2 { color: var(--text-strong); margin: 0 0 12px; font-size: 1.3rem; }
        .empty-state p { margin: 0; font-size: 0.95rem; }

        /* カテゴリセクション */
        .category-section { margin: 0 0 48px; }
        .category-header { margin-bottom: 18px; padding: 16px 18px; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--border); }
        .category-section.category-jra .category-header { border-left: 4px solid var(--jra); }
        .category-section.category-nankan .category-header { border-left: 4px solid var(--nankan); }
        .category-title { margin: 0 0 4px; color: var(--text-strong); font-size: 1.3rem; }
        .category-date { margin: 0; color: var(--text-mute); font-size: 0.85rem; }

        /* 会場カード */
        .venues-stack { display: grid; gap: 16px; }
        .venue-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
        }
        .venue-card-header {
            display: flex; align-items: baseline; justify-content: space-between;
            padding: 12px 16px; background: var(--bg-elev); border-bottom: 1px solid var(--border);
        }
        .venue-name { margin: 0; color: var(--text-strong); font-size: 1.05rem; }
        .venue-emoji { margin-right: 6px; }
        .venue-count { color: var(--text-mute); font-size: 0.82rem; }

        /* レースカードグリッド */
        .races-grid {
            display: grid;
            gap: 12px;
            padding: 14px;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        }
        .race-card {
            display: flex; flex-direction: column; gap: 8px;
            padding: 14px;
            background: rgba(15, 23, 42, 0.5);
            border: 1px solid var(--border);
            border-radius: 10px;
            transition: transform 0.15s ease, border-color 0.15s ease;
        }
        .race-card:hover { transform: translateY(-2px); border-color: rgba(167, 139, 250, 0.5); }
        .race-card.used { border-color: rgba(16, 185, 129, 0.4); background: rgba(16, 185, 129, 0.04); }
        .race-card.disabled { opacity: 0.78; }
        .race-card-head { display: flex; gap: 8px; align-items: baseline; }
        .race-num { font-size: 1.1rem; font-weight: 800; color: #a5b4fc; }
        .race-name { color: var(--text-strong); font-size: 0.92rem; }
        .race-card-meta { display: flex; gap: 6px; flex-wrap: wrap; }
        .meta-pill {
            display: inline-block; padding: 2px 8px; border-radius: 999px;
            background: rgba(51, 65, 85, 0.4); color: var(--text-mute);
            font-size: 0.72rem; border: 1px solid rgba(148, 163, 184, 0.15);
        }
        .dark-horse-count-badge {
            display: inline-block; padding: 4px 10px;
            font-size: 0.78rem; font-weight: 700;
            color: var(--darkhorse);
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.35);
            border-radius: 6px;
            align-self: flex-start;
        }

        /* リビールボタン */
        .reveal-button {
            display: inline-flex; align-items: center; justify-content: center; gap: 6px;
            width: 100%; padding: 10px 12px;
            background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
            color: white; font-weight: 700;
            border: none; border-radius: 8px;
            cursor: pointer;
            transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
            font-size: 0.92rem;
        }
        .reveal-button:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(139, 92, 246, 0.4); }
        .reveal-button.used-button { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
        .reveal-button.upgrade-button { background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%); }
        .button-icon { font-size: 1rem; }
        .button-text { font-size: 0.9rem; }

        /* タグ */
        .tag {
            display: inline-block; padding: 3px 10px; border-radius: 999px;
            font-size: 0.72rem; font-weight: 800; border: 1px solid transparent;
        }
        .tag-darkhorse { background: rgba(239, 68, 68, 0.18); color: var(--darkhorse); border-color: rgba(239, 68, 68, 0.45); }
        .tag-value { background: rgba(245, 158, 11, 0.18); color: var(--value); border-color: rgba(245, 158, 11, 0.45); }
        .tag.inline { vertical-align: baseline; margin-right: 4px; }

        /* モーダル */
        .modal {
            position: fixed; inset: 0; z-index: 1000;
            display: none; align-items: center; justify-content: center;
            padding: 20px;
        }
        .modal.show { display: flex; animation: fadeIn 0.2s ease-out; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .modal-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); }
        .modal-content {
            position: relative; z-index: 1;
            max-width: 760px; width: 100%; max-height: 90vh;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
            overflow-y: auto;
            padding: 24px;
        }
        .modal-close {
            position: absolute; top: 12px; right: 14px;
            background: transparent; border: none; color: var(--text-mute);
            font-size: 1.8rem; cursor: pointer; line-height: 1;
        }
        .modal-close:hover { color: var(--text-strong); }
        .modal-header { padding-right: 32px; margin-bottom: 18px; border-bottom: 1px solid var(--border); padding-bottom: 14px; }
        .modal-meta { margin: 0 0 6px; color: var(--text-mute); font-size: 0.82rem; }
        #modal-race-title { margin: 0; color: var(--text-strong); font-size: 1.4rem; }
        .modal-body { display: grid; gap: 12px; }
        .horse-info-card {
            padding: 14px;
            background: rgba(15, 23, 42, 0.55);
            border: 1px solid var(--border);
            border-radius: 10px;
        }
        .horse-info-card.is-dark { border-left: 3px solid var(--darkhorse); }
        .horse-info-card.is-value { border-left: 3px solid var(--value); }
        .horse-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
        .horse-id-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .horse-num {
            display: inline-flex; align-items: center; justify-content: center;
            min-width: 32px; height: 32px; padding: 0 8px;
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            color: white; border-radius: 8px; font-weight: 800; font-size: 0.95rem;
        }
        .horse-name { color: var(--text-strong); font-weight: 700; font-size: 1rem; }
        .horse-score { color: var(--text-mute); font-size: 0.85rem; }
        .horse-score strong { color: var(--gold); margin-left: 4px; }
        .horse-stats {
            display: grid; gap: 8px;
            grid-template-columns: repeat(4, 1fr);
            margin-bottom: 10px;
        }
        .horse-stats .stat {
            display: flex; flex-direction: column; align-items: center;
            padding: 8px 6px;
            background: rgba(30, 41, 59, 0.5);
            border-radius: 6px;
        }
        .horse-stats .stat-label { font-size: 0.7rem; color: var(--text-mute); margin-bottom: 2px; }
        .horse-stats .stat-value { font-weight: 700; color: var(--text-strong); font-size: 0.95rem; }
        .horse-stats .rank-index { color: #a5b4fc; }
        .horse-stats .rank-gap { color: #6ee7b7; }
        .horse-reason h4 { margin: 0 0 6px; color: var(--text-mute); font-size: 0.78rem; }
        .horse-reason ul { margin: 0; padding-left: 18px; color: var(--text); font-size: 0.85rem; }
        .horse-reason li { margin-bottom: 3px; }
        .modal-disclaimer {
            margin-top: 16px; padding: 10px 14px;
            background: rgba(245, 158, 11, 0.08);
            border: 1px solid rgba(245, 158, 11, 0.25);
            border-radius: 8px;
        }
        .modal-disclaimer p { margin: 0; color: #fcd34d; font-size: 0.78rem; line-height: 1.5; }

        /* 抽出ロジック */
        .how-it-works { margin: 56px 0 32px; }
        .how-it-works h2 { color: var(--text-strong); font-size: 1.3rem; margin: 0 0 16px; }
        .how-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
        @media (min-width: 800px) { .how-grid { grid-template-columns: repeat(3, 1fr); } }
        .how-card { padding: 18px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; }
        .how-card h3 { margin: 0 0 10px; color: var(--text-strong); font-size: 1rem; }
        .how-card ul { margin: 0; padding-left: 20px; color: var(--text-mute); font-size: 0.88rem; }
        .how-card li { margin-bottom: 6px; }

        /* CTA */
        .cta-section { margin-top: 32px; }
        .cta-card {
            text-align: center; padding: 28px 20px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.12) 0%, rgba(139, 92, 246, 0.12) 100%);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 14px;
        }
        .cta-card h2 { margin: 0 0 10px; color: var(--text-strong); font-size: 1.2rem; }
        .cta-card p { color: var(--text-mute); margin: 0 0 16px; font-size: 0.9rem; }
        .cta-button {
            display: inline-block; padding: 12px 28px;
            background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
            color: #fff; text-decoration: none; font-weight: 700;
            border-radius: 999px; transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .cta-button:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4); }

        @media (max-width: 720px) {
            .container { padding: 0 12px 60px; }
            .page-header h1 { font-size: 1.6rem; }
            .races-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); padding: 10px; gap: 8px; }
            .race-card { padding: 10px; }
            .horse-stats { grid-template-columns: repeat(2, 1fr); }
            .modal-content { padding: 18px; max-height: 92vh; }
            #modal-race-title { font-size: 1.15rem; }
        }
    </style>
</body>
</html>
