---
// Paddle の決済画面を開くページ（取引の checkout.url = このページ?_ptxn=txn_…）。
// Paddle.js が _ptxn を読んで決済画面（オーバーレイ）を自動で開く。完了後は共通の完了画面へ。
// ⚠️ クライアントトークン（PADDLE_CLIENT_TOKEN）は公開してよい値。API 鍵（PADDLE_API_KEY）はここに出さない。
// 本番サイトでは cardSales.CARD_SALES_OPEN.paddle が true かつ live_ トークンのときだけ開く（それ以外は案内だけ）。
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { clientTokenMode } from '../../lib/billing/paddle/paddleCore.js';
import { resolveCardMode } from '../../lib/billing/cardSales.js';

const token = String(process.env.PADDLE_CLIENT_TOKEN || '');
const mode = resolveCardMode({ provider: 'paddle', keyMode: clientTokenMode(token), origin: Astro.url.origin });
const txn = Astro.url.searchParams.get('_ptxn') || '';
const safeTxn = /^txn_[a-z0-9]{10,40}$/.test(txn) ? txn : '';
const cfg = mode.ok && safeTxn ? { token, sandbox: mode.mode === 'test', txn: safeTxn } : null;
---

<BaseLayout title="お支払い" noindex={true}>
  <main class="co-page">
    <div class="co-card">
      {cfg ? (
        <>
          <h1 class="co-title">お支払い画面を開いています…</h1>
          <p class="co-text">画面が開かない場合は、ページを再読み込みしてください。</p>
        </>
      ) : (
        <>
          <h1 class="co-title">現在、カードでのお申し込みは受け付けていません</h1>
          <p class="co-text">お申し込みは銀行振込（年払い・買い切り）で承っています。</p>
          <a class="co-btn" href="/pricing/">料金プランへ</a>
        </>
      )}
    </div>
  </main>
</BaseLayout>

{cfg && (
  <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
)}
{cfg && (
  <script is:inline define:vars={{ cfg }}>
    (function () {
      if (!window.Paddle) return;
      if (cfg.sandbox) window.Paddle.Environment.set('sandbox');
      window.Paddle.Initialize({
        token: cfg.token,
        checkout: { settings: { displayMode: 'overlay', locale: 'ja', successUrl: location.origin + '/checkout/card-complete/?provider=paddle&order=' + encodeURIComponent(cfg.txn) } },
      });
    })();
  </script>
)}

<style>
  .co-page { max-width: 560px; margin: 3rem auto; padding: 0 16px; }
  .co-card { text-align: center; padding: 2rem 1.25rem; border-radius: 16px; background: linear-gradient(155deg, rgba(59,130,246,0.12), rgba(37,99,235,0.05)); border: 1px solid rgba(96,165,250,0.4); }
  .co-title { font-size: 1.3rem; color: #e2e8f0; margin: 0.5rem 0; }
  .co-text { color: #cbd5e1; line-height: 1.7; }
  .co-btn { display: inline-block; margin-top: 1rem; padding: 0.7rem 1.1rem; border-radius: 10px; background: #2563eb; color: #fff; text-decoration: none; font-weight: 700; }
</style>
