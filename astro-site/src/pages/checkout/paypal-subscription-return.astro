---
// PayPal 月額（定期課金）の戻り先。PayPal は ?subscription_id=I-…&ba_token=…&token=… を付けて戻す。
// ⚠️ ここへの遷移は支払いの証明ではない。反映は paypal-subscription-confirm（と Webhook）が PayPal API の照会結果だけで行い、この画面は状態を表示するだけ。
// 未ログインで申し込んだ方は、申込のブラウザだけが持つ HttpOnly の鍵（ak_pp_return）で確認する（viewer: 'guest'）。URL だけでは何も見えない（401）。
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SUBSCRIPTION_RETURN_COPY, SUBSCRIPTION_RETURN_GUEST, SUBSCRIPTION_RETURN_CONTACT } from '../../lib/billing/paypal/subscriptionReturnCopy.js';
import { POST_PURCHASE_DESTINATIONS } from '../../lib/billing/paypal/postPurchaseLanding.js';
const copy = SUBSCRIPTION_RETURN_COPY;
const guest = SUBSCRIPTION_RETURN_GUEST;
const contact = SUBSCRIPTION_RETURN_CONTACT;
// 自動遷移の行き先は許可リストの完全一致だけ（サーバーの値でもそのまま信じない）
const destinations = POST_PURCHASE_DESTINATIONS;
const raw = Astro.url.searchParams.get('subscription_id') || '';
const subscription = /^I-[A-Z0-9]{10,24}$/.test(raw) ? raw : '';
---

<BaseLayout title="お申し込みありがとうございます" noindex={true}>
  <main class="co-page">
    <div class="co-card">
      <div class="co-icon" id="ccIcon">⏳</div>
      <h1 class="co-title" id="ccTitle">お支払いを確認しています…</h1>
      <p class="co-text" id="ccText">そのまま数秒お待ちください（ページを閉じても、確認でき次第ご利用いただけます）。</p>
      <div class="co-actions" id="ccActions" hidden></div>
    </div>
  </main>
</BaseLayout>

<script is:inline define:vars={{ subscription, copy, guest, contact, destinations }}>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    function show(icon, title, text, links) {
      $('ccIcon').textContent = icon; $('ccTitle').textContent = title; $('ccText').textContent = text;
      var a = $('ccActions'); a.innerHTML = '';
      (links || []).forEach(function (l) { var e = document.createElement('a'); e.href = l[1]; e.textContent = l[0]; e.className = 'co-btn'; a.appendChild(e); });
      a.hidden = !(links && links.length);
    }
    // 商品ごとの文言（更新の周期つき）は subscriptionReturnCopy.js が正本。知らない商品は周期を書かない
    var FALLBACK = { text: 'Premium をご利用いただけます。', links: [['マイページへ', '/dashboard/']] };
    if (!subscription) { show('⚠️', 'お申し込み情報を確認できませんでした', 'マイページでご利用状況をご確認ください。', [['マイページへ', '/dashboard/']]); return; }
    var tries = 0;
    var asGuest = false;
    function poll() {
      tries += 1;
      fetch('/.netlify/functions/paypal-subscription-confirm?subscription=' + encodeURIComponent(subscription), { credentials: 'include' })
        .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { s: r.status, d: d }; }); })
        .then(function (x) {
          var st = x.d && x.d.status;
          if (x.d && x.d.viewer === 'guest') asGuest = true;
          if (st === 'active') {
            var t = copy[x.d.plan] || FALLBACK;
            // GA4 purchase: サーバーが反映済み（active）を返したときだけ。同じ購読は AkFunnel 側で 1 回だけ
            if (copy[x.d.plan] && window.AkFunnel && window.AkFunnel.purchaseCompleted) window.AkFunnel.purchaseCompleted(x.d.plan, subscription, 'paypal');
            // 決済完了 → 自動遷移（2026-10-22 MK 確定・postPurchaseLanding.js）。active＝サーバーが PayPal で照会して反映済みのときだけ
            if (asGuest) {
              // 未ログイン: 完了を読める時間を置いてからログイン画面へ。ログイン後はサーバーが Premium の利用画面へ送る
              show('✅', 'お申し込みが完了しました', t.text + guest.activeNext, guest.activeLinks);
              return setTimeout(function () { window.location.replace(guest.activeRedirect); }, 4000);
            }
            var dest = x.d.destination && destinations.indexOf(x.d.destination) !== -1 ? x.d.destination : null;
            if (dest) {
              show('✅', 'お申し込みが完了しました', t.text + 'まもなく Premium 予想へ移動します。', t.links);
              return setTimeout(function () { window.location.replace(dest); }, 2000);
            }
            return show('✅', 'お申し込みが完了しました', t.text, t.links);
          }
          if (st === 'needs_support') return show('📩', 'お支払いを確認しました', 'ご契約内容の確認が必要なため、担当よりご連絡いたします。', [['お問い合わせ', '/contact/']]);
          if (x.s === 401) return show('🔑', guest.loginRequired.title, guest.loginRequired.text, guest.loginRequired.links);
          if (x.s === 404) return show('⚠️', 'お申し込み情報を確認できませんでした', 'お申し込みのときと同じアカウントでログインしているかご確認ください。', [['マイページへ', '/dashboard/'], contact]);
          if (tries < 20) return setTimeout(poll, 3000);
          if (asGuest) return show('⏳', '確認に時間がかかっています', guest.timeoutText, guest.timeoutLinks);
          show('⏳', '確認に時間がかかっています', '反映まで数分かかることがあります。もう一度お支払いいただく必要はありません。しばらくしてからマイページをご確認ください。', [['マイページへ', '/dashboard/'], contact]);
        })
        .catch(function () { if (tries < 20) setTimeout(poll, 3000); });
    }
    poll();
  })();
</script>

<style>
  .co-page { max-width: 560px; margin: 3rem auto; padding: 0 16px; }
  .co-card { text-align: center; padding: 2rem 1.25rem; border-radius: 16px; background: linear-gradient(155deg, rgba(59,130,246,0.12), rgba(37,99,235,0.05)); border: 1px solid rgba(96,165,250,0.4); }
  .co-icon { font-size: 2.2rem; }
  .co-title { font-size: 1.3rem; color: #e2e8f0; margin: 0.5rem 0; }
  .co-text { color: #cbd5e1; line-height: 1.7; }
  .co-actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 1rem; }
  .co-btn { display: inline-block; padding: 0.7rem 1.1rem; border-radius: 10px; background: #2563eb; color: #fff; text-decoration: none; font-weight: 700; }
</style>
