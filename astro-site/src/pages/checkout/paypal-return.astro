---
// PayPal の承認後の戻り先（return_url）。?token=<注文 ID>&PayerID=… で戻ってくる。
// サーバー（paypal-capture）が注文を照会して capture・反映し、その後は共通の完了画面で状態を表示する。
// ⚠️ ここへの遷移は支払いの証明ではない。capture と反映はサーバーが PayPal API の照会結果だけで行う。
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
const token = Astro.url.searchParams.get('token') || '';
const order = /^[A-Z0-9]{10,24}$/.test(token) ? token : '';
---

<BaseLayout title="お支払いを確定しています" noindex={true}>
  <main class="co-page">
    <div class="co-card">
      <h1 class="co-title" id="prTitle">お支払いを確定しています…</h1>
      <p class="co-text" id="prText">このままお待ちください（二重にお支払いいただく必要はありません）。</p>
      <a class="co-btn" id="prLink" href="/dashboard/" hidden>マイページへ</a>
    </div>
  </main>
</BaseLayout>

<script is:inline define:vars={{ order }}>
  (function () {
    function fail(t) {
      document.getElementById('prTitle').textContent = '確定を確認できませんでした';
      document.getElementById('prText').textContent = t;
      document.getElementById('prLink').hidden = false;
    }
    if (!order) return fail('お申し込み情報を確認できませんでした。マイページでご利用状況をご確認ください。');
    var go = function () { location.replace('/checkout/card-complete/?provider=paypal&order=' + encodeURIComponent(order)); };
    fetch('/.netlify/functions/paypal-capture', {
      method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ order: order }),
    }).then(go, go); // 失敗しても Webhook が反映する。完了画面で状態を確認する
  })();
</script>

<style>
  .co-page { max-width: 560px; margin: 3rem auto; padding: 0 16px; }
  .co-card { text-align: center; padding: 2rem 1.25rem; border-radius: 16px; background: linear-gradient(155deg, rgba(59,130,246,0.12), rgba(37,99,235,0.05)); border: 1px solid rgba(96,165,250,0.4); }
  .co-title { font-size: 1.3rem; color: #e2e8f0; margin: 0.5rem 0; }
  .co-text { color: #cbd5e1; line-height: 1.7; }
  .co-btn { display: inline-block; margin-top: 1rem; padding: 0.7rem 1.1rem; border-radius: 10px; background: #2563eb; color: #fff; text-decoration: none; font-weight: 700; }
</style>
