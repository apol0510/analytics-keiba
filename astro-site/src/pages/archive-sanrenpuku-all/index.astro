            <span class="bank-info-value" style="color: #10b981; font-size: 1.3rem;" id="modalAmount">¥78,000</span>
          </div>
        </div>

        <div class="bank-steps">
          <div class="bank-steps-title">📝 お申し込み手順</div>
          <div class="bank-step">
            <span class="bank-step-number">1</span>
            <span>上記の口座情報に振込金額をお振込みください</span>
          </div>
          <div class="bank-step">
            <span class="bank-step-number">2</span>
            <span>振込完了後、下記のフォームから必要情報をご送信ください</span>
          </div>
          <div class="bank-step">
            <span class="bank-step-number">3</span>
            <span>入金確認取れ次第、即時にログイン情報をメールでお送りいたします</span>
          </div>
        </div>

        <div class="bank-form-section">
          <div class="bank-form-title">💳 銀行振込完了フォーム</div>

          <form id="bankTransferForm" class="bank-form">
            <div class="form-group">
              <label for="fullName" class="form-label">お名前 <span class="required">*</span></label>
              <input type="text" id="fullName" name="fullName" class="form-input" required placeholder="山田 太郎">
            </div>

            <div class="form-group">
              <label for="email" class="form-label">メールアドレス <span class="required">*</span></label>
              <input type="email" id="email" name="email" class="form-input" required placeholder="example@email.com">
            </div>

            <div class="form-group">
              <label for="transferDate" class="form-label">振込完了日 <span class="required">*</span></label>
              <input type="date" id="transferDate" name="transferDate" class="form-input" required>
            </div>

            <div class="form-group">
              <label for="transferAmount" class="form-label">振込金額 <span class="required">*</span></label>
              <input type="number" id="transferAmount" name="transferAmount" class="form-input" required readonly>
            </div>

            <div class="form-group">
              <label for="remarks" class="form-label">備考・ご要望</label>
              <textarea id="remarks" name="remarks" class="form-input" rows="3" placeholder="何かご要望がありましたらご記入ください（任意）"></textarea>
            </div>

            <div class="form-group" style="margin: 16px 0;">
              <label style="display:flex; align-items:flex-start; gap:8px; cursor:pointer; font-size:0.9rem; line-height:1.5; text-align:left;">
                <input type="checkbox" id="paymentCompletedConfirm" name="paymentCompletedConfirm" required style="margin-top:3px; flex-shrink:0;">
                <span>銀行振込を完了済みです。このフォームは入金後の報告専用であることを確認しました。<span style="color:#ef4444;">*</span></span>
              </label>
            </div>
            <button type="submit" class="form-submit-button" id="submitButton">
              <span class="submit-text">📨 申し込みを送信</span>
              <span class="submit-loading" style="display: none;">送信中...</span>
            </button>

            <div class="form-message" id="formMessage" style="display: none;"></div>
          </form>
        </div>

        <div class="bank-warning">
          <div class="bank-warning-title">⚠️ ご注意事項</div>
          <div class="bank-warning-text">
            ・振込手数料はお客様負担となります<br>
            ・土日祝日の場合、確認が翌営業日となる場合がございます<br>
            ・<strong>お名前と同じ名義で振込をお願いします</strong><br>
            ・名義が異なる場合は、備考欄にその旨をご記入ください<br>
            ・ご入金後のキャンセル・返金は承っておりません
          </div>
        </div>
      </div>
    </div>

    <!-- Sticky CTA（三連複保有会員には JS で非表示） -->
    <div class="sticky-cta" id="sticky-cta" style="display: none;">
        <div class="sticky-cta-content">
            <div class="sticky-cta-text">
                <div class="sticky-cta-title">🎯 中央＋南関の三連複買い目をお求めの方へ</div>
                <div class="sticky-cta-description">Premium Sanrenpuku 一つで両方の三連複（AI自動絞り込み）が使えます</div>
            </div>
            <button type="button" class="sticky-cta-button" onclick="openBankModal('Premium Sanrenpuku Lifetime', 78000, 'lifetime')">
                👑 三連複プランに申し込む
            </button>
        </div>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <!-- 会場タブ切替 -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var tabs = document.querySelectorAll('.venue-tab');
        tabs.forEach(function (t) {
          t.addEventListener('click', function () {
            var v = t.getAttribute('data-venue');
            document.querySelectorAll('.venue-tab').forEach(function (x) { x.classList.toggle('active', x === t); });
            document.querySelectorAll('.venue-panel').forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-venue') === v); });
          });
        });
      });
    </script>

    <!-- CTA / Sticky の表示制御: 三連複保有（Sanrenpuku/Combo/Full）会員には出さない。casing 非依存。 -->
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('user-plan');
          var plan = '';
          if (raw) { try { plan = (JSON.parse(raw).plan || '').toString(); } catch (e) {} }
          if (!plan) plan = localStorage.getItem('userPlan') || '';
          plan = plan.toString().trim().toLowerCase();
          var HAS_SRP = ['premium sanrenpuku','premiumsanrenpuku','premium combo','premiumcombo','premium full'];
          if (HAS_SRP.indexOf(plan) !== -1) return;
          var box = document.getElementById('cta-upsell-box');
          var sticky = document.getElementById('sticky-cta');
          if (box) box.style.display = '';
          if (sticky) sticky.style.display = '';
        } catch (e) {}
      })();
    </script>

    <!-- 銀行振込モーダル JS（JRA archive と同型 / 送信プラン=Premium Sanrenpuku Lifetime） -->
    <script is:inline>
      let currentPlan = '';
      let currentAmount = 0;

      function openBankModal(planName, amount) {
        currentPlan = planName;
        currentAmount = amount;
        document.getElementById('modalPlanInfo').textContent = `プラン: ${planName}（¥${amount.toLocaleString()} 買い切り）`;
        document.getElementById('modalAmount').textContent = `¥${amount.toLocaleString()}`;
        document.getElementById('transferAmount').value = amount;
        document.getElementById('bankModal').classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeBankModal() {
        document.getElementById('bankModal').classList.remove('active');
        document.body.style.overflow = 'auto';
      }

      function copyToClipboard(text) {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          document.execCommand('copy');
          alert('コピーしました: ' + text);
        } catch (err) {
          console.error('コピーに失敗しました:', err);
        }
        document.body.removeChild(textarea);
      }

      document.addEventListener('DOMContentLoaded', () => {
        document.addEventListener('click', (e) => {
          const bankModal = document.getElementById('bankModal');
          if (e.target === bankModal) { closeBankModal(); }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { closeBankModal(); }
        });

        const bankTransferForm = document.getElementById('bankTransferForm');
        if (bankTransferForm) {
          bankTransferForm.addEventListener('submit', async (e) => {
            e.preventDefault();
        const paymentCompletedCheckbox = document.getElementById('paymentCompletedConfirm');
        if (!paymentCompletedCheckbox || !paymentCompletedCheckbox.checked) {
          const fm = document.getElementById('formMessage');
          if (fm) { fm.textContent = '⚠️ 銀行振込完了後にチェックを入れてから送信してください。'; fm.className = 'form-message error'; fm.style.display = 'block'; }
          return;
        }
            const submitButton = document.getElementById('submitButton');
            const submitText = submitButton.querySelector('.submit-text');
            const submitLoading = submitButton.querySelector('.submit-loading');
            const formMessage = document.getElementById('formMessage');

            submitButton.disabled = true;
            submitText.style.display = 'none';
            submitLoading.style.display = 'inline';
            formMessage.style.display = 'none';

            const formData = {
              fullName: document.getElementById('fullName').value,
              email: document.getElementById('email').value,
              transferDate: document.getElementById('transferDate').value,
              transferTime: "00:00",
              transferAmount: document.getElementById('transferAmount').value,
              transferName: document.getElementById('fullName').value,
              remarks: document.getElementById('remarks').value,
              productName: `${currentPlan}（¥${currentAmount.toLocaleString()} 買い切り）`,
          paymentCompletedConfirm: document.getElementById('paymentCompletedConfirm').checked,
              timestamp: new Date().toISOString()
            };

            try {
              const response = await fetch('/.netlify/functions/bank-transfer-application', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
              });
              const result = await response.json();
              if (result.success) {
                document.getElementById('bankTransferForm').reset();
                window.SubmissionResult && window.SubmissionResult.showSuccessScreen({
                  formEl: bankTransferForm,
                  messageEl: formMessage,
                  options: {
                    title: 'お申し込みを受け付けました',
                    message: `${formData.productName} のお申し込みを受け付けました。`,
                    subMessage: '確認メールをお送りしましたのでご確認ください。マイページから申請状況も確認できます。'
                  },
                  history: {
                    type: 'bank-transfer',
                    label: `銀行振込お申し込み: ${formData.productName}`,
                    status: 'pending',
                    details: { email: formData.email, transferAmount: formData.transferAmount, transferDate: formData.transferDate, productName: formData.productName }
                  }
                });
              } else {
                throw new Error(result.error || '送信に失敗しました');
              }
            } catch (error) {
              formMessage.textContent = '❌ エラーが発生しました: ' + error.message;
              formMessage.className = 'form-message error';
              formMessage.style.display = 'block';
              submitButton.disabled = false;
              submitText.style.display = 'inline';
              submitLoading.style.display = 'none';
            }
          });
        }
      });
    </script>
</BaseLayout>

