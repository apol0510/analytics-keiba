---
// 三連複 的中実績アーカイブ 統合ページ（中央JRA・南関を1ページにタブで並べる）。
// ★ 的中実績（統計）は合算しない。中央と南関はそれぞれ独立して集計・表示する。
// - 中央タブ: archiveSanrenpukuResultsJra.json を集計。月カードは /archive-sanrenpuku-jra/{y}/{m}/（getStaticPaths 生成）へ。
// - 南関タブ: 旧 per-month legacy JSON（＝手書き詳細ページと1:1）＋ combined をマージして集計。
//   月カードは既存詳細ページ /archive-sanrenpuku/{y}/{m}/ が存在する月のみ（import.meta.glob で検証）。
// 会員ゲート＋CTA＋銀行振込モーダル＋Sticky CTA は JRA archive と同型。購入は Premium Sanrenpuku（中央＋南関 両方）。
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import jraData from '../../data/archiveSanrenpukuResultsJra.json';
import nankanCombined from '../../data/archiveSanrenpukuResults.json';

const MONTH_LABEL = ['', '1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'];

// 南関: 旧 per-month legacy JSON を全読み込み（詳細ページと同一の月データ）＋ combined をマージ。
// 詳細ページは archive-sanrenpuku/[year]/[month].astro（getStaticPaths）で全月生成されるため、
// 「リンク可能な月」の存在チェックは不要（全月リンク可・JRA と同方式）。
const legacyMods = import.meta.glob('../../data/archiveSanrenpukuResults_*.json', { eager: true });

function mergeNankan() {
  const merged = {};
  const put = (data) => {
    for (const y of Object.keys(data || {})) {
      merged[y] = merged[y] || {};
      for (const m of Object.keys(data[y] || {})) {
        merged[y][m] = { ...(merged[y][m] || {}), ...data[y][m] };
      }
    }
  };
  for (const mod of Object.values(legacyMods)) put(mod && mod.default ? mod.default : mod);
  put(nankanCombined); // combined を後勝ちでマージ（南関 index と同方針）
  return merged;
}

// 1会場分の集計（会場ごとに独立・合算しない）。validSet が渡された月だけ採用。
// 1日分の投資額(invested)を安全に算出。
//   totalBetPoints があれば ×100。無ければ日別 recoveryRate から逆算（invested = payout / (recoveryRate/100)）。
//   南関の旧データは totalBetPoints 欠落日が多く、payout/betPoints だと分母過小で回収率が異常膨張する（例: 2242%）ため、
//   この二段フォールバックで正しい回収率（Σpayout/Σinvested）を出す。
function investedOfDay(dd) {
  const p = dd.totalPayout || 0;
  const bp = dd.totalBetPoints || 0;
  if (bp > 0) return bp * 100;
  if (typeof dd.recoveryRate === 'number' && dd.recoveryRate > 0) return p / (dd.recoveryRate / 100);
  return 0;
}

function buildVenue(data, hrefBase, validSet) {
  const monthCards = [];
  let races = 0, hits = 0, payout = 0, invested = 0;
  for (const y of Object.keys(data).sort().reverse()) {
    for (const m of Object.keys(data[y]).sort().reverse()) {
      if (validSet && !validSet.has(`${y}/${m}`)) continue; // 詳細ページが無い月はカードにしない（404回避）
      const daysObj = data[y][m];
      const dayKeys = Object.keys(daysObj);
      let mR = 0, mH = 0, mP = 0, mInv = 0;
      for (const d of dayKeys) {
        const dd = daysObj[d];
        mR += dd.totalRaces || 0;
        mH += dd.hitRaces || 0;
        mP += dd.totalPayout || 0;
        mInv += investedOfDay(dd);
      }
      const mRecovery = mInv > 0 ? Math.round((mP / mInv) * 100) : 0;
      const mHitRate = mR > 0 ? Math.round((mH / mR) * 100) : 0;
      races += mR; hits += mH; payout += mP; invested += mInv;
      monthCards.push({
        year: y, month: m, label: `${y}年${MONTH_LABEL[parseInt(m)]}`,
        mRaces: mR, mHits: mH, mPayout: mP, mHitRate, mRecovery, daysCount: dayKeys.length,
        href: `${hrefBase}/${y}/${m}/`,
      });
    }
  }
  const hitRate = races > 0 ? Math.round((hits / races) * 100) : 0;
  const recovery = invested > 0 ? Math.round((payout / invested) * 100) : 0;
  const period = monthCards.length
    ? (monthCards[monthCards.length - 1].label === monthCards[0].label
        ? monthCards[0].label
        : `${monthCards[monthCards.length - 1].label}〜${monthCards[0].label}`)
    : '';
  return { monthCards, hitRate, recovery, payout, hits, races, hasData: monthCards.length > 0, period };
}

// 中央: JRA は getStaticPaths で全月ページ生成済み → validSet 不要（全月リンク可）。
const jra = buildVenue(jraData, '/archive-sanrenpuku-jra', null);
// 南関: getStaticPaths で全月ページ生成済み → 全月カード化（validSet 不要・JRA と同方式）。
const nankan = buildVenue(mergeNankan(), '/archive-sanrenpuku', null);

const pageTitle = '中央競馬（JRA）・南関競馬 三連複 的中実績';
const pageDesc = '中央競馬（JRA）と南関競馬の三連複 AI厳選買い目の的中実績アーカイブ。Premium Sanrenpuku なら中央＋南関の三連複が1購入で両方使えます。';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDesc,
  about: '中央競馬 JRA 南関競馬 三連複 AI予想 的中実績',
};
---

<BaseLayout title={pageTitle} description={pageDesc} canonical="/archive-sanrenpuku-all/">
    <!-- 🔒 会員専用認証チェック（クライアントサイド / casing 非依存 / dev はバイパス） -->
    <script is:inline>
      (function () {
        function isDev() {
          return location.hostname === 'localhost' || location.hostname === '127.0.0.1'
            || location.port === '4321' || location.port === '3000';
        }
        var userPlan = null;
        try {
          var d = localStorage.getItem('user-plan');
          if (d) userPlan = JSON.parse(d).plan;
        } catch (e) {}
        if (!userPlan) userPlan = localStorage.getItem('userPlan');
        var planLower = userPlan ? String(userPlan).toLowerCase() : '';
        var ALLOWED = ['premium','premium predictions','premiumpredictions',
          'premium sanrenpuku','premiumsanrenpuku','premium combo','premiumcombo',
          'premium plus','premiumplus','premium full'];
        var isAllowed = !!userPlan && ALLOWED.indexOf(planLower) !== -1;
        if (!isDev() && !isAllowed) {
          alert('この実績ページは会員専用です。\n\nPremium会員にアップグレードすると、三連複の的中実績をご覧いただけます。');
          window.location.href = '/premium-prediction/nankan/';
        }
      })();
    </script>

    <div class="archive-container">
        <div class="archive-hero">
            <div class="premium-badge"><span class="badge-icon">👑</span><span>Premium会員 実績</span></div>
