                                </div>
                                <div class="mc-view-details">📊 この月の詳細を見る →</div>
                            </a>
                        ))}
                    </div>
                    <div class="panel-link"><a href="/premium-sanrenpuku-jra/">🎯 中央（JRA）三連複 予想を見る</a></div>
                </>
            ) : (
                <div class="no-data-card"><p>中央競馬（JRA）三連複の実績データがまだありません。</p></div>
            )}
        </div>

        <!-- 南関パネル -->
        <div class="venue-panel" data-venue="nankan">
            {nankan.hasData ? (
                <>
                    <div class="venue-summary">
                        <div class="vs-title">南関競馬 三連複 実績{nankan.period && ` ・ ${nankan.period}`}</div>
                        <div class="venue-stats">
                            <div class="venue-stat"><div class="venue-stat-value">{nankan.hitRate}%</div><div class="venue-stat-label">的中率</div></div>
                            <div class="venue-stat"><div class="venue-stat-value">{nankan.recovery}%</div><div class="venue-stat-label">回収率</div></div>
                            <div class="venue-stat"><div class="venue-stat-value">{nankan.hits}<span class="unit">/{nankan.races}</span></div><div class="venue-stat-label">的中/レース</div></div>
                            <div class="venue-stat"><div class="venue-stat-value">¥{nankan.payout.toLocaleString()}</div><div class="venue-stat-label">累計配当</div></div>
                        </div>
                    </div>
                    <div class="months-grid">
                        {nankan.monthCards.map((mc) => (
                            <a href={mc.href} class={`month-card${mc.mRecovery >= 200 ? ' month-card-hot' : ''}`}>
                                <div class="month-card-header">
                                    <h2 class="month-card-title">{mc.label}</h2>
                                    {mc.mHitRate === 100
                                      ? <div class="perfect-count">🏆 {mc.mHits}/{mc.mRaces}的中</div>
                                      : mc.mRecovery >= 200
                                        ? <div class="hot-badge">🔥 高回収</div>
                                        : (mc.mRecovery >= 100 && <div class="profit-badge">📈 プラス収支</div>)}
                                </div>
                                <div class="month-card-stats">
                                    <div class="mc-stat"><div class="mc-stat-value">{mc.mHitRate}%</div><div class="mc-stat-label">的中率</div></div>
                                    <div class="mc-stat"><div class="mc-stat-value">{mc.mRecovery}%</div><div class="mc-stat-label">回収率</div></div>
                                    <div class="mc-stat"><div class="mc-stat-value">{mc.daysCount}日</div><div class="mc-stat-label">開催日数</div></div>
                                    <div class="mc-stat"><div class="mc-stat-value">¥{mc.mPayout.toLocaleString()}</div><div class="mc-stat-label">合計配当</div></div>
                                </div>
                                <div class="mc-view-details">📊 この月の詳細を見る →</div>
                            </a>
                        ))}
                    </div>
                    <div class="panel-link"><a href="/premium-sanrenpuku/">🎯 南関三連複 予想を見る</a></div>
                </>
            ) : (
                <div class="no-data-card"><p>南関競馬 三連複の実績データがまだありません。</p></div>
            )}
        </div>
    </div>

    <!-- 銀行振込モーダル（CSS は global.css） -->
    <div class="bank-modal" id="bankModal">
      <div class="bank-modal-content">
        <button class="bank-modal-close" onclick="closeBankModal()">×</button>

        <h2 class="bank-modal-title">🏦 銀行振込でのお申し込み</h2>
        <p class="modal-plan-info" id="modalPlanInfo"></p>

        <div class="bank-info-box">
          <div class="bank-info-item">
            <span class="bank-info-label">振込先銀行</span>
            <span class="bank-info-value">三井住友銀行
              <button class="copy-button" onclick="copyToClipboard('三井住友銀行')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">支店名</span>
            <span class="bank-info-value">洲本支店
              <button class="copy-button" onclick="copyToClipboard('洲本支店')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">口座種別</span>
            <span class="bank-info-value">普通</span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">口座番号</span>
            <span class="bank-info-value">5338892
              <button class="copy-button" onclick="copyToClipboard('5338892')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">口座名義</span>
            <span class="bank-info-value" style="font-size: 0.95rem;">ﾏ-ｸｱﾂﾌﾟｴ-ｱｲｻ-ﾋﾞｽ ｱｻｲ ﾄｼﾋﾛ
              <button class="copy-button" onclick="copyToClipboard('ﾏ-ｸｱﾂﾌﾟｴ-ｱｲｻ-ﾋﾞｽ ｱｻｲ ﾄｼﾋﾛ')">コピー</button>
            </span>
