                </div>
            </div>
            <div class="cta-plans">
                <button onclick="openBankModal('Premium Sanrenpuku Lifetime', 78000, 'lifetime')" class="cta-plan-card cta-plan-recommended">
                    <div class="recommended-badge">おすすめ</div>
                    <div class="plan-header"><span class="plan-name">🏦 Sanrenpuku Lifetime（中央＋南関）</span></div>
                    <div class="plan-price">¥78,000<span class="plan-period">（買い切り）</span></div>
                    <div class="plan-description">今だけ特別価格：¥108,000 → ¥78,000 ／ 中央・南関の三連複が両方使えます</div>
                </button>
            </div>
        </div>

        <!-- 会場タブ（中央 / 南関）。的中実績は会場ごとに独立表示（合算しない）。 -->
        <div class="venue-tabs">
            <button type="button" class="venue-tab active" data-venue="jra">中央（JRA）</button>
            <button type="button" class="venue-tab" data-venue="nankan">南関</button>
        </div>

        <!-- 中央（JRA）パネル -->
        <div class="venue-panel active" data-venue="jra">
            {jra.hasData ? (
                <>
                    <div class="venue-summary">
                        <div class="vs-title">中央（JRA）三連複 実績{jra.period && ` ・ ${jra.period}`}</div>
                        <div class="venue-stats">
                            <div class="venue-stat"><div class="venue-stat-value">{jra.hitRate}%</div><div class="venue-stat-label">的中率</div></div>
                            <div class="venue-stat"><div class="venue-stat-value">{jra.recovery}%</div><div class="venue-stat-label">回収率</div></div>
                            <div class="venue-stat"><div class="venue-stat-value">{jra.hits}<span class="unit">/{jra.races}</span></div><div class="venue-stat-label">的中/レース</div></div>
                            <div class="venue-stat"><div class="venue-stat-value">¥{jra.payout.toLocaleString()}</div><div class="venue-stat-label">累計配当</div></div>
