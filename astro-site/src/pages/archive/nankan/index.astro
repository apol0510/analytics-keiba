---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync, existsSync, readdirSync } from 'fs';
import { join } from 'path';
import { buildMergedMonthData } from '../../../lib/archiveMonthlyView.js';

export const prerender = false;

const dataDir = join(process.cwd(), 'src', 'data');
const archivePath = join(dataDir, 'archiveResults.json');
const archiveJraPath = join(dataDir, 'archiveResultsJra.json');

let archiveResults: any[] = [];
let archiveResultsJra: any[] = [];

try {
  if (existsSync(archivePath)) archiveResults = JSON.parse(readFileSync(archivePath, 'utf-8'));
  if (existsSync(archiveJraPath)) archiveResultsJra = JSON.parse(readFileSync(archiveJraPath, 'utf-8'));
} catch (e) {
  console.error('[archive/nankan] load error:', e);
}

// 全年×月を data 配下から自動収集（singular + monthly snapshot）
const yearMonthSet = new Map<string, Set<string>>();
const addYM = (y: string, m: string) => {
  if (!yearMonthSet.has(y)) yearMonthSet.set(y, new Set());
  yearMonthSet.get(y)!.add(m);
};

for (const entry of archiveResults) {
  if (!entry?.date) continue;
  const [y, m] = entry.date.split('-');
  if (y && m) addYM(y, m);
}
for (const entry of archiveResultsJra) {
  if (!entry?.date) continue;
  const [y, m] = entry.date.split('-');
  if (y && m) addYM(y, m);
}
try {
  const files = readdirSync(dataDir);
  for (const file of files) {
    const match = file.match(/^archiveResults_(\d{4})-(\d{2})\.json$/);
    if (!match) continue;
    const [, y, m] = match;
    try {
      const snap = JSON.parse(readFileSync(join(dataDir, file), 'utf-8'));
      const entries = snap?.[y]?.[m];
      if (entries && Object.keys(entries).length > 0) addYM(y, m);
    } catch {}
  }
} catch {}

const snapshotCache = new Map<string, any>();
const loadSnapshot = (year: string, month: string) => {
  const key = `${year}-${month}`;
  if (snapshotCache.has(key)) return snapshotCache.get(key);
  const path = join(dataDir, `archiveResults_${key}.json`);
  let snap: any = {};
  if (existsSync(path)) {
    try { snap = JSON.parse(readFileSync(path, 'utf-8')); } catch {}
  }
  snapshotCache.set(key, snap);
  return snap;
};

const years = Array.from(yearMonthSet.keys()).sort().reverse();

const yearSummaries = years.map(year => {
  const months = Array.from(yearMonthSet.get(year)!).sort().reverse();

  let perfectDays = 0;
  let totalPayout = 0;
  let totalHitRaces = 0;
  let totalRaces = 0;
  let totalDays = 0;

  months.forEach(month => {
    const snapshot = loadSnapshot(year, month);
    const monthData = buildMergedMonthData(archiveResults, snapshot, year, month, archiveResultsJra);
    const days = Object.keys(monthData);
    totalDays += days.length;

    days.forEach(day => {
      const dayData = monthData[day];
      if (dayData.perfectHit) perfectDays++;
      totalPayout += dayData.totalPayout || 0;
      totalHitRaces += dayData.hitRaces || 0;
      totalRaces += dayData.totalRaces || 0;
    });
  });

  const hitRate = totalRaces > 0 ? Math.round((totalHitRaces / totalRaces) * 100) : 0;
  const latestMonth = months[0];

  return {
    year,
    latestMonth,
    perfectDays,
    payout: totalPayout,
    hitRaces: totalHitRaces,
    totalRaces,
    hitRate,
    daysCount: totalDays,
    monthsCount: months.length
  };
});

const pageTitle = '南関競馬的中実績アーカイブ';
const pageDescription = '南関競馬の全的中実績アーカイブ。マリーンカップ・日本テレビ盃等の重賞レース含む年別・月別の的中記録と配当金額を完全公開。';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="archive-nankan-hub">
    <div class="page-header">
      <h1 class="title">🏆 的中実績アーカイブ</h1>
      <p class="subtitle">南関競馬の全的中記録を完全公開</p>
      <p class="description">
        パーフェクト的中の日も、不的中の日も、すべて公開。<br>
        透明性と信頼性を最優先にしています。
      </p>
    </div>

    <div class="cta-box">
      <p class="cta-text">
        🎯 これらの実績を生み出したAI予想を、あなたも利用できます
      </p>
      <a href="/pricing/" class="cta-button">プレミアム予想を見る →</a>
    </div>

    <div class="years-grid">
      {yearSummaries.map(summary => (
        <a href={`/archive/nankan/${summary.year}/`} class="year-card">
          <div class="year-header">
            <h2 class="year-title">{summary.year}年</h2>
            {summary.hitRate === 100 && (
              <div class="perfect-highlight">🏆 {summary.hitRaces}/{summary.totalRaces}的中</div>
            )}
          </div>

          <div class="year-stats-grid">
            <div class="year-stat">
              <div class="year-stat-value">{summary.hitRate}%</div>
              <div class="year-stat-label">年間的中率</div>
            </div>
            <div class="year-stat">
              <div class="year-stat-value">{summary.monthsCount}ヶ月</div>
              <div class="year-stat-label">開催月数</div>
            </div>
            <div class="year-stat">
              <div class="year-stat-value">{summary.daysCount}日</div>
              <div class="year-stat-label">開催日数</div>
            </div>
            <div class="year-stat">
              <div class="year-stat-value">{summary.hitRaces}/{summary.totalRaces}</div>
              <div class="year-stat-label">的中レース数</div>
            </div>
            <div class="year-stat">
              <div class="year-stat-value">¥{(summary.payout / 1000).toFixed(0)}K</div>
              <div class="year-stat-label">合計配当</div>
            </div>
          </div>

          <div class="view-details-button">📊 詳細を見る →</div>
        </a>
      ))}
    </div>

    <div class="back-link">
      <a href="/archive/">← アーカイブトップ</a>
      <a href="/archive/jra/">JRAアーカイブ</a>
      <a href="/pricing/">プレミアム予想</a>
    </div>
  </div>
</BaseLayout>

<style>
  .archive-nankan-hub { padding: 2rem 0 3rem; color: #e2e8f0; }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 2rem;
    background: rgba(30, 41, 59, 0.5);
    border-radius: 16px;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .title { font-size: 2.5rem; font-weight: bold; color: #f59e0b; margin: 0 0 1rem; }
  .subtitle { font-size: 1.2rem; color: #cbd5e1; margin-bottom: 0.5rem; }
  .description { font-size: 1rem; color: #94a3b8; max-width: 600px; margin: 0 auto; }

  .years-grid { display: grid; gap: 2rem; }

  .year-card {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(100, 116, 139, 0.3);
    border-radius: 16px;
    padding: 2.5rem;
    transition: all 0.3s;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .year-card:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 158, 11, 0.5);
    box-shadow: 0 12px 30px rgba(245, 158, 11, 0.3);
  }

  .year-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid rgba(100, 116, 139, 0.3);
  }

  .year-title { font-size: 2.5rem; font-weight: bold; color: #fbbf24; margin: 0; }

  .perfect-highlight {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #fff;
    padding: 0.8rem 1.5rem;
    border-radius: 12px;
    font-weight: bold;
    font-size: 1.1rem;
  }

  .year-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
  }

  .year-stat {
    text-align: center;
    background: rgba(15, 23, 42, 0.5);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid rgba(59, 130, 246, 0.2);
  }
  .year-stat-value { font-size: 2rem; font-weight: bold; color: #60a5fa; margin-bottom: 0.5rem; }
  .year-stat-label { font-size: 0.9rem; color: #94a3b8; }

  .back-link {
    text-align: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(100, 116, 139, 0.3);
  }
  .back-link a {
    color: #60a5fa;
    text-decoration: none;
    font-size: 1rem;
    transition: color 0.3s;
    margin: 0 0.5rem;
  }
  .back-link a:hover { color: #3b82f6; }

  .cta-box {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1));
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    margin-bottom: 3rem;
  }
  .cta-text { font-size: 1.1rem; color: #e2e8f0; margin-bottom: 1rem; }
  .cta-button {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: #fff;
    padding: 1rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    display: inline-block;
    font-weight: bold;
    transition: all 0.3s;
  }
  .cta-button:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(59, 130, 246, 0.4); }

  .view-details-button {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: bold;
    font-size: 1rem;
    text-align: center;
    margin-top: 1.5rem;
    transition: all 0.3s;
    display: inline-block;
    width: 100%;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .view-details-button:hover {
    background: rgba(245, 158, 11, 0.25);
    border-color: rgba(245, 158, 11, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(245, 158, 11, 0.3);
  }

  @media (max-width: 768px) {
    .title { font-size: 1.8rem; }
    .year-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .year-title { font-size: 2rem; }
    .year-stats-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
