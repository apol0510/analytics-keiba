---
/**
 * 旧 南関予想ページ /prediction/{YYYY-MM-DD}-{venue}（2026-10-03 廃止）
 *
 * ⚠️ このページは認可なしで有料の馬単買い目（全レース）を表示していた（本番で未ログイン 200 を確認）。
 * 有料予想は認可済みページ（/premium-prediction/nankan/ 等・gatePaidPage）だけで出す。
 * 旧 URL は同じ日付の無料予想へ 301、それ以外の slug は 404（ファイルを読みに行かない）。
 * AIBettingSection.astro は残す（削除可否は CLAUDE.md の保留事項・ここからは使わない）。
 */
export const prerender = false;

const LEGACY_SLUG = /^(\d{4}-\d{2}-\d{2})-(ooi|kawasaki|funabashi|urawa)$/;

function legacyPredictionRedirect(slug) {
  const m = LEGACY_SLUG.exec(String(slug || ''));
  return m ? `/free-prediction/nankan/${m[1]}/` : null;
}

const to = legacyPredictionRedirect(Astro.params.slug);
if (to) return Astro.redirect(to, 301);
return new Response('Not Found', { status: 404, headers: { 'Cache-Control': 'no-store' } });
---
