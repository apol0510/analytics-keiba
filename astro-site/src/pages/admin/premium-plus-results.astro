---
export const prerender = true;
// 認可: この画面は /admin/* の Basic-Auth 背後。POST は x-admin-secret + production を
// premium-plus-results Function 側で検証する。secret はこのタブ限定（sessionStorage）。
import BaseLayout from '../../layouts/BaseLayout.astro';
// カード CSS 単一源（本番 /premium-plus-v2/ と同一ルール）。プレビューを本番と同じ見た目にする。
import '../../styles/premiumPlusReceiptCard.css';
---
<BaseLayout title="Premium Plus 結果入力（管理）">
  <div class="ppr">
    <h1>Premium Plus 結果入力</h1>
    <p class="lead">配信した 1 鞍の結果を入力すると、git 台帳にコミット → Netlify 自動ビルド → <code>/premium-plus/</code> に反映されます（1 日 1 件・同日は上書き）。</p>

    <div class="card">
      <label>管理シークレット（PREMIUM_PLUS_ADMIN_SECRET・このタブのみ保持）</label>
      <input type="password" id="secret" placeholder="Netlify に設定した値" autocomplete="off" />
    </div>

    <div class="editor">
    <div class="card form-card">
      <div class="grid">
        <div><label>開催日</label><input type="date" id="date" /></div>
        <div><label>サーキット</label>
          <select id="circuit">
            <option value="">自動（平日=南関 / 土日=中央）</option>
            <option value="nankan">南関（SPAT4）</option>
            <option value="chuo">中央（JRA）</option>
          </select>
        </div>
        <div><label>会場</label>
          <select id="venue">
            <option value="">選択してください</option>
            <optgroup label="南関（SPAT4）">
              <option>大井</option><option>船橋</option><option>川崎</option><option>浦和</option>
            </optgroup>
            <optgroup label="中央（JRA）">
              <option>札幌</option><option>函館</option><option>福島</option><option>新潟</option><option>東京</option><option>中山</option><option>中京</option><option>京都</option><option>阪神</option><option>小倉</option>
            </optgroup>
          </select>
        </div>
        <div><label>レース番号</label><input type="number" id="raceNumber" min="1" max="12" placeholder="11" /></div>
        <div class="wide"><label>レース名（任意）</label><input type="text" id="raceName" placeholder="東京スプリント など" /></div>
        <div class="wide"><label>1着（1頭・馬番をクリック）</label>
          <div class="numpick" id="pick-first" data-mode="single" data-target="first"></div>
          <input type="hidden" id="first" />
        </div>
        <div class="wide"><label>2着（複数可・馬番をクリック）</label>
          <div class="numpick" id="pick-second" data-mode="multi" data-target="second"></div>
          <input type="hidden" id="second" />
        </div>
        <div class="wide"><label>3着（複数可・馬番をクリック）</label>
          <div class="numpick" id="pick-third" data-mode="multi" data-target="third"></div>
          <input type="hidden" id="third" />
        </div>
        <div><label>1点あたりの購入金額</label>
          <select id="unitStake">
            <option value="100">各100円</option>
            <option value="200">各200円</option>
            <option value="300">各300円</option>
            <option value="500">各500円</option>
            <option value="1000" selected>各1,000円</option>
            <option value="2000">各2,000円</option>
            <option value="3000">各3,000円</option>
            <option value="5000">各5,000円</option>
            <option value="10000">各10,000円</option>
          </select>
        </div>
        <div class="chk"><label><input type="checkbox" id="isHit" /> 的中</label>
          <span id="ptsPreview" class="pts">点数: — / 合計: —</span></div>
        <div><label>払戻金額（合計・的中時）<small class="hint">実際に戻ってきた総額。カードの「払戻」に表示</small></label><input type="number" id="payout" placeholder="599000" /></div>
        <div class="wide"><label>的中組合せ（的中時・1着→2着→3着の馬番を選択）</label>
          <div class="combo3">
            <select id="hit1"></select><span class="arw">→</span>
            <select id="hit2"></select><span class="arw">→</span>
            <select id="hit3"></select>
          </div>
        </div>
        <div><label>払戻単価（1組あたり配当・任意）<small class="hint">JRAカードのみ表示。南関(SPAT4)は空欄でOK</small></label><input type="number" id="unitPayout" placeholder="（通常は空欄）" /></div>
        <div class="wide"><label>実スクショ画像パス（任意・後日）</label><input type="text" id="imageFile" placeholder="/premium-plus-proof/2026-07-22.png" /></div>
        <div><label>受付番号（既定 0001・実スクショに合わせて変更可）</label><input type="text" id="receiptNo" value="0001" placeholder="0001" /></div>
        <div><label>受付時刻（任意）<small class="hint">受付日は「開催日」と同じ扱い。時刻だけ選択</small></label><input type="time" id="receiptTime" /></div>
      </div>
      <div class="actions">
        <button id="save" class="primary">保存（追記 / 上書き）</button>
        <button id="del" class="danger">この日付を削除</button>
      </div>
      <pre id="out" class="out"></pre>
    </div>

    <div class="card preview">
      <div class="preview-head">プレビュー <small>本番 <code>/premium-plus-v2/</code> と同じ表示（中央=JRA / 南関=SPAT4 を自動判定）</small></div>
      <div class="preview-stage">
        <div id="cardPreview" class="pp-cards"></div>
        <p id="previewHint" class="preview-hint">サーキット（中央／南関）または開催日を選ぶと、カードの土台が表示されます。買い目を入れると追従します。</p>
      </div>
    </div>
    </div>
  </div>

  <style>
    .ppr{max-width:1280px;margin:0 auto;padding:24px 16px 80px;color:#e6edf7}
    /* 横並びエディタ: 左=入力 / 右=プレビュー固定。狭い画面は縦積み＋上部sticky。 */
    .editor{display:grid;grid-template-columns:1fr;gap:16px 20px;align-items:start}
    .editor .card{margin-bottom:0}
    @media(min-width:1120px){
      .editor{grid-template-columns:minmax(0,1fr) 700px}
      .editor .preview{position:sticky;top:16px;align-self:start}
    }
    @media(max-width:1119px){
      .editor .preview{position:sticky;top:0;z-index:5;max-height:52vh;overflow:auto;order:-1}
    }
    .editor .preview .preview-stage{overflow-x:auto}
    .ppr h1{font-size:1.4rem;margin:0 0 .3em}
    .ppr .lead{color:#93a4bd;font-size:.9rem;margin:0 0 20px}
    .ppr code{background:rgba(245,196,81,.1);color:#f5c451;padding:.1em .4em;border-radius:5px}
    .card{background:#111c33;border:1px solid rgba(148,163,184,.18);border-radius:14px;padding:18px;margin-bottom:16px}
    .card label{display:block;font-size:.78rem;color:#93a4bd;margin-bottom:.35em}
    .card label .hint{display:block;font-weight:400;color:#6f819c;font-size:.7rem;margin-top:.2em;line-height:1.4}
    .card input,.card select{width:100%;padding:9px 10px;border-radius:8px;border:1px solid rgba(148,163,184,.28);background:#0b1120;color:#e6edf7;font-size:.95rem}
    .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 14px}
    .grid .wide{grid-column:1/-1}
    .grid .chk{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:12px}
    .grid .chk label{display:flex;align-items:center;gap:.5em;color:#e6edf7;margin:0;font-size:.95rem}
    .grid .chk input{width:auto}
    .combo3{display:flex;align-items:center;gap:8px}
    .combo3 select{flex:1}
    .combo3 .arw{color:#f5c451;font-weight:700}
    /* 馬番チップピッカー（1着=単一 / 2着・3着=複数） */
    .numpick{display:grid;grid-template-columns:repeat(9,1fr);gap:6px}
    .numpick .chip{padding:8px 0;border-radius:8px;border:1px solid rgba(148,163,184,.28);background:#0b1120;color:#e6edf7;font-size:.95rem;font-weight:700;cursor:pointer;transition:all .08s}
    .numpick .chip:hover{border-color:rgba(245,196,81,.5)}
    .numpick .chip.on{background:linear-gradient(180deg,#ffe08a,#f5c451 55%,#d99b1f);color:#3a2a05;border-color:transparent}
    @media(max-width:560px){.numpick{grid-template-columns:repeat(6,1fr)}}
    .pts{color:#f5c451;font-size:.85rem}
    .actions{display:flex;gap:12px;margin-top:16px}
    .actions button{border:0;border-radius:10px;padding:11px 18px;font-weight:700;cursor:pointer}
    .actions .primary{background:linear-gradient(180deg,#ffe08a,#f5c451 55%,#d99b1f);color:#3a2a05}
    .actions .danger{background:transparent;border:1px solid rgba(248,113,113,.5);color:#f87171}
    .out{margin-top:14px;background:#0b1120;border:1px solid rgba(148,163,184,.18);border-radius:8px;padding:10px;color:#93a4bd;font-size:.8rem;white-space:pre-wrap;min-height:1.4em}
    .preview .preview-head{font-size:.9rem;font-weight:700;color:#e6edf7;margin-bottom:12px}
    .preview .preview-head small{display:block;font-weight:400;color:#6f819c;font-size:.72rem;margin-top:.25em}
    .preview .preview-stage{background:repeating-linear-gradient(135deg,rgba(255,255,255,.012) 0 8px,transparent 8px 16px),#0b1120;border:1px solid rgba(148,163,184,.14);border-radius:12px;padding:16px}
    .preview .pp-cards{display:flex;flex-direction:column;gap:16px}
    .preview .preview-hint{color:#6f819c;font-size:.82rem;text-align:center;padding:1.5rem 0;margin:0}
    @media(max-width:560px){.grid{grid-template-columns:1fr}}
  </style>

  <script>
    // カードプレビューは本番と同じ単一源を再利用（値は deriveCard・見た目は renderReceiptCardHtml + 共有CSS）
    import { deriveCard, circuitFromDate, toHorseNumbers, computePoints, pad2, UNIT_STAKE } from '../../lib/premiumPlusResults.js';
    import { renderReceiptCardHtml } from '../../lib/premiumPlusReceiptCardView.js';
    const API = '/.netlify/functions/premium-plus-results';
    const $ = (id) => document.getElementById(id);
    // secret はこのタブのみ
    const savedSecret = sessionStorage.getItem('pprSecret');
    if (savedSecret) $('secret').value = savedSecret;
    $('secret').addEventListener('change', () => sessionStorage.setItem('pprSecret', $('secret').value.trim()));
    // 既定日 = 今日
    try { $('date').value = new Date().toISOString().slice(0, 10); } catch {}

    // 的中組合せ: 1着→2着→3着 の馬番セレクト（1〜18）を生成
    ['hit1','hit2','hit3'].forEach((id, i) => {
      const label = ['1着','2着','3着'][i];
      $(id).innerHTML = `<option value="">${label}</option>` +
        Array.from({ length: 18 }, (_, k) => `<option value="${k + 1}">${k + 1}</option>`).join('');
    });
    // 1着/2着/3着 の馬番チップピッカー（1〜18）。1着=単一選択 / 2着・3着=複数選択。
    // 選択は hidden input(first/second/third)へ昇順カンマ区切りで書き込み、entry()/points() と互換。
    function buildNumpick(pickId){
      const c = $(pickId), mode = c.dataset.mode, hiddenId = c.dataset.target;
      c.innerHTML = Array.from({ length: 18 }, (_, k) => `<button type="button" class="chip" data-n="${k + 1}">${k + 1}</button>`).join('');
      c.addEventListener('click', (ev) => {
        const b = ev.target.closest('.chip');
        if (!b) return;
        if (mode === 'single') {
          const wasOn = b.classList.contains('on');
          c.querySelectorAll('.chip.on').forEach((x) => x.classList.remove('on'));
          if (!wasOn) b.classList.add('on');
        } else {
          b.classList.toggle('on');
        }
        const sel = Array.from(c.querySelectorAll('.chip.on')).map((x) => +x.dataset.n).sort((a, b) => a - b);
        $(hiddenId).value = sel.join(',');
        refreshAll();
      });
    }
    ['pick-first','pick-second','pick-third'].forEach(buildNumpick);
    // 的中組合せ → "7-1-9"（3つ揃ったときのみ）
    function hitCombo(){
      const h = [$('hit1').value, $('hit2').value, $('hit3').value].filter(Boolean);
      return h.length === 3 ? h.join('-') : '';
    }
    // 受付日時 = 開催日（date）＋ 受付時刻 → "2026年07月23日 15:11"（開催日が無ければ送らない）
    function receiptAt(){
      const d = $('date').value; // 開催日 YYYY-MM-DD（受付日と同じ扱い）
      const t = $('receiptTime').value; // HH:MM
      if (!d) return undefined;
      const [y, m, day] = d.split('-');
      return `${y}年${m}月${day}日${t ? ' ' + t : ''}`;
    }

    function nums(s){ return (s||'').split(/[^0-9]+/).map(x=>parseInt(x,10)).filter(n=>n>=1&&n<=28); }
    function uniq(a){ const o=[]; for(const x of a) if(!o.includes(x)) o.push(x); return o; }
    function points(){
      const F=uniq(nums($('first').value)), S=uniq(nums($('second').value)), T=uniq(nums($('third').value));
      let n=0; for(const a of F) for(const b of S) for(const c of T) if(a!==b&&a!==c&&b!==c) n++;
      return n;
    }
    function unitStake(){ return parseInt($('unitStake').value, 10) || 1000; }
    function updatePreview(){
      const p=points(); $('ptsPreview').textContent = p ? `点数: ${p} / 合計: ¥${(p*unitStake()).toLocaleString()}` : '点数: — / 合計: —';
    }
    // 買い目が未確定でも土台を見せる寛容プレビュー用カード。値ロジックは premiumPlusResults.js の
    // 共通ヘルパー（circuitFromDate / toHorseNumbers / computePoints / pad2 / UNIT_STAKE）で本番と揃える。
    function lenientCard(e){
      const circuit = (e.circuit === 'chuo' || e.circuit === 'nankan') ? e.circuit : circuitFromDate(e.date);
      const first = toHorseNumbers(e.first), second = toHorseNumbers(e.second), third = toHorseNumbers(e.third);
      const points = computePoints(e.first, e.second, e.third);
      const uStake = parseInt(e.unitStake, 10) > 0 ? parseInt(e.unitStake, 10) : UNIT_STAKE;
      const pay = Math.max(0, parseInt(String(e.payout || '').replace(/[^\d]/g, ''), 10) || 0);
      const isHit = !!e.isHit || pay > 0;
      const rNum = parseInt(e.raceNumber, 10) || null;
      return {
        date: e.date || '', circuit, service: circuit === 'chuo' ? 'jra' : 'spat4',
        venue: e.venue || '', raceNumber: rNum, raceName: e.raceName || '',
        first, second, third, points, unitStake: uStake, stake: points * uStake,
        isHit, payout: isHit ? pay : 0, hitCombo: e.hitCombo || '', winnerCombo: e.hitCombo || '',
        unitPayout: isHit ? (parseInt(e.unitPayout, 10) || 0) : 0,
        receiptNo: e.receiptNo || '', receiptAt: e.receiptAt || '',
        firstPad: first.map(pad2), secondPad: second.map(pad2), thirdPad: third.map(pad2),
        raceLabel: `${e.venue || ''}${rNum ? `${rNum}R` : ''}`.trim(),
      };
    }
    // サーキット選択 or 開催日が決まった時点でプレビュー表示。買い目が揃えば deriveCard（本番一致）に切替。
    function currentPreviewCard(){
      const e = entry();
      let strict = null;
      try { strict = deriveCard(e); } catch { strict = null; }
      if (strict) return strict; // 買い目まで揃った → 本番と完全一致の描画
      const hasCircuit = e.circuit === 'chuo' || e.circuit === 'nankan';
      const hasDate = /^\d{4}-\d{2}-\d{2}$/.test(e.date || '');
      if (!hasCircuit && !hasDate) return null; // まだ中央/南関も日付も未確定 → hint
      return lenientCard(e); // 土台を先に見せる（中央=JRA / 南関=SPAT4）
    }
    // カードのライブプレビュー。サーキット/開催日が決まった時点で土台を表示し、以後は入力に追従。
    function updateCardPreview(){
      const el = $('cardPreview'), hint = $('previewHint');
      const card = currentPreviewCard();
      if (!card) { el.innerHTML = ''; hint.style.display = 'block'; return; }
      hint.style.display = 'none';
      el.innerHTML = renderReceiptCardHtml(card);
    }
    function refreshAll(){ updatePreview(); updateCardPreview(); }
    // フォーム内の全入力変化（text/number は input、select/checkbox/date/time は change）で再描画
    const formGrid = document.querySelector('.grid');
    formGrid.addEventListener('input', refreshAll);
    formGrid.addEventListener('change', refreshAll);

    function entry(){
      return {
        date: $('date').value.trim(),
        circuit: $('circuit').value || undefined,
        venue: $('venue').value.trim(),
        raceNumber: $('raceNumber').value.trim(),
        raceName: $('raceName').value.trim(),
        first: $('first').value.trim(),
        second: $('second').value.trim(),
        third: $('third').value.trim(),
        unitStake: $('unitStake').value,
        isHit: $('isHit').checked,
        payout: $('payout').value.trim(),
        hitCombo: hitCombo(),
        unitPayout: $('unitPayout').value.trim(),
        imageFile: $('imageFile').value.trim() || undefined,
        receiptNo: $('receiptNo').value.trim() || undefined,
        receiptAt: receiptAt(),
      };
    }
    async function post(payload){
      const secret = $('secret').value.trim();
      if(!secret){ $('out').textContent='管理シークレットを入力してください'; return; }
      $('out').textContent='送信中…';
      try{
        const res = await fetch(API,{ method:'POST', headers:{'Content-Type':'application/json','x-admin-secret':secret}, body:JSON.stringify(payload) });
        const j = await res.json();
        $('out').textContent = res.ok ? `✅ ${j.action} 完了: ${j.summary}（台帳 ${j.count} 件）\nNetlify ビルド後に /premium-plus/ へ反映されます` : `❌ ${res.status}: ${j.error||''} ${j.detail||''}`;
      }catch(e){ $('out').textContent='❌ 通信エラー: '+e.message; }
    }
    $('save').addEventListener('click',()=>post({action:'upsert', entry:entry()}));
    $('del').addEventListener('click',()=>{ if(confirm($('date').value+' を削除しますか？')) post({action:'remove', date:$('date').value.trim()}); });
    refreshAll();
  </script>
</BaseLayout>
