---
export const prerender = true;
// 認可: この画面は /admin/* の Basic-Auth（Edge Function）背後。POST は x-admin-secret を
// premium-plus-eligibility Function 側で検証する。secret はこのタブ限定（sessionStorage）。
//
// この画面が変更するのは **Premium Plus の販売資格だけ**。
// プラン / Status / 有効期限 / LifetimeSanrenpuku / メール状態は一切変更しない。
// 資格変更でメール送信・課金・昇格は起きない（表示資格のみ）。
//
// 2026-07-30: UI のみ刷新（カード化 / 状態バッジ / フィルター / Email 検索 / 操作の分離）。
// 管理 Function の write 契約（action='update' の payload）と preview の read-only 契約は不変。
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Premium Plus 販売管理（管理）">
  <div class="ppe">
    <header class="ppe-head">
      <div>
        <h1>Premium Plus 販売対象</h1>
        <p class="lead">
          販売してよい会員を <b>管理者が手動で選別</b>します。候補は自動で「販売可」になりません
          （新規候補は必ず <b>保留</b> から始まります）。変更されるのは
          <b>Premium Plus の表示資格だけ</b>で、プラン・有効期限・メール・課金には影響しません。
        </p>
      </div>
      <button id="reload" type="button" class="btn-reload">一覧を読み込む</button>
    </header>

    <details class="conn" id="connPanel">
      <summary>
        <span class="conn-title">管理接続</span>
        <span class="conn-state" id="connState">未接続</span>
      </summary>
      <div class="conn-body">
        <label for="secret">管理シークレット（PREMIUM_PLUS_ADMIN_SECRET・このタブのみ保持）</label>
        <input type="password" id="secret" placeholder="Netlify に設定した値" autocomplete="off" />
        <p class="note" id="writeState"></p>
      </div>
    </details>

    <div id="summary" class="summary"></div>

    <div class="toolbar">
      <div class="chips" id="filters" role="group" aria-label="状態で絞り込み"></div>
      <div class="search">
        <input type="search" id="q" placeholder="Email で検索" autocomplete="off" aria-label="Email 検索" />
        <label class="chk"><input type="checkbox" id="onlyReview" /> 保留のみ再取得</label>
      </div>
    </div>

    <p class="msg" id="message"></p>
    <p class="count" id="count"></p>
    <div id="list" class="list"></div>

    <!-- 管理者プレビュー モーダル（read-only。実顧客セッションは作らない） -->
    <div id="pvBackdrop" class="pv-backdrop" hidden>
      <div class="pv-modal" role="dialog" aria-modal="true" aria-labelledby="pvTitle">
        <div class="pv-head">
          <h2 id="pvTitle">表示プレビュー</h2>
          <button type="button" id="pvClose" class="pv-close" aria-label="閉じる">×</button>
        </div>
        <p class="pv-notice">管理者プレビュー / 実顧客には影響しません（読み取りのみ・ログインもメール送信もしません）</p>
        <div class="pv-controls">
          <label>時刻シミュレーション <select id="pvTime"></select></label>
          <label>PHASE 表示確認 <select id="pvPhase"></select></label>
        </div>
        <div id="pvBody" class="pv-body"></div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .ppe { max-width: 1100px; margin: 0 auto; padding: 1.5rem 1rem 5rem; color: #e6edf7; }

  /* ── ヘッダ ── */
  .ppe .ppe-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.1rem; }
  .ppe .ppe-head h1 { font-size: 1.35rem; margin: 0 0 .5rem; }
  .ppe .lead { color: #93a4bd; font-size: .84rem; line-height: 1.8; margin: 0; max-width: 68ch; }
  .ppe .btn-reload { flex: 0 0 auto; background: #f5c451; color: #2a1d02; border: 0; border-radius: 9px; padding: .6rem 1.1rem; font-weight: 800; cursor: pointer; font-family: inherit; }

  /* ── 管理接続（折りたたみ）── */
  .ppe .conn { background: #111c33; border: 1px solid rgba(148,163,184,.18); border-radius: 11px; margin-bottom: 1.1rem; }
  .ppe .conn > summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: .7rem; padding: .7rem 1rem; font-size: .84rem; }
  .ppe .conn > summary::-webkit-details-marker { display: none; }
  .ppe .conn > summary::before { content: '▸'; color: #93a4bd; transition: transform .15s; }
  .ppe .conn[open] > summary::before { transform: rotate(90deg); }
  .ppe .conn-title { font-weight: 700; }
  .ppe .conn-state { font-size: .74rem; padding: .15rem .6rem; border-radius: 999px; background: rgba(148,163,184,.16); color: #93a4bd; }
  .ppe .conn-state.ok { background: rgba(52,211,153,.14); color: #34d399; }
  .ppe .conn-body { padding: 0 1rem 1rem; }
  .ppe .conn-body label { display: block; font-size: .76rem; color: #93a4bd; margin-bottom: .35rem; }
  .ppe .conn-body input { width: 100%; max-width: 460px; padding: .55rem .7rem; border-radius: 8px; border: 1px solid rgba(148,163,184,.28); background: #0b1120; color: #e6edf7; font-family: inherit; }
  .ppe .note { font-size: .74rem; color: #93a4bd; margin: .6rem 0 0; }

  /* ── サマリー ── */
  .ppe .summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: .6rem; margin-bottom: 1.2rem; }
  .ppe .sum { background: #111c33; border: 1px solid rgba(148,163,184,.18); border-radius: 11px; padding: .7rem .8rem; }
  .ppe .sum .k { font-size: .72rem; color: #93a4bd; }
  .ppe .sum .v { font-size: 1.5rem; font-weight: 900; line-height: 1.25; }
  .ppe .sum.pri-immediate { border-color: rgba(245,196,81,.45); }
  .ppe .sum.pri-immediate .v { color: #f5c451; }
  .ppe .sum.pri-eligible { border-color: rgba(52,211,153,.4); }
  .ppe .sum.pri-eligible .v { color: #34d399; }
  .ppe .sum.pri-review { border-color: rgba(96,165,250,.4); }
  .ppe .sum.pri-review .v { color: #60a5fa; }
  .ppe .sum.sub { padding: .5rem .7rem; opacity: .78; }
  .ppe .sum.sub .v { font-size: 1.05rem; }

  /* ── ツールバー ── */
  .ppe .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: .9rem; }
  .ppe .chips { display: flex; gap: .4rem; flex-wrap: wrap; }
  .ppe .chip { background: #0d1729; border: 1px solid rgba(148,163,184,.24); color: #cbd5e6; border-radius: 999px; padding: .35rem .85rem; font-size: .78rem; cursor: pointer; font-family: inherit; }
  .ppe .chip[aria-pressed='true'] { background: #f5c451; border-color: #f5c451; color: #2a1d02; font-weight: 800; }
  .ppe .search { display: flex; align-items: center; gap: .8rem; }
  .ppe .search input[type=search] { min-width: 220px; padding: .45rem .7rem; border-radius: 8px; border: 1px solid rgba(148,163,184,.28); background: #0b1120; color: #e6edf7; font-family: inherit; font-size: .84rem; }
  .ppe .chk { display: flex; align-items: center; gap: .35rem; font-size: .78rem; color: #93a4bd; }
  .ppe .msg { font-size: .84rem; min-height: 1.2em; margin: 0 0 .5rem; }
  .ppe .msg.ok { color: #34d399; }
  .ppe .msg.err { color: #f87171; }
  .ppe .count { font-size: .76rem; color: #93a4bd; margin: 0 0 .8rem; }

  /* ── 顧客カード ── */
  .ppe .list { display: grid; gap: .85rem; }
  .ppe .cust { background: #111c33; border: 1px solid rgba(148,163,184,.16); border-radius: 13px; overflow: hidden; }
  .ppe .cust.is-immediate { border-color: rgba(245,196,81,.4); }
  .ppe .cust.is-blocked { border-color: rgba(248,113,113,.3); }
  .ppe .cust-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .85rem 1.1rem; border-bottom: 1px solid rgba(148,163,184,.14); background: rgba(13,23,41,.6); }
  .ppe .cust-email { font-weight: 700; font-size: .92rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .ppe .badge { flex: 0 0 auto; font-size: .78rem; font-weight: 800; padding: .3rem .85rem; border-radius: 999px; white-space: nowrap; }
  .ppe .badge.review { background: rgba(96,165,250,.16); color: #60a5fa; }
  .ppe .badge.staged { background: rgba(52,211,153,.14); color: #34d399; }
  .ppe .badge.sale { background: rgba(52,211,153,.2); color: #34d399; }
  .ppe .badge.immediate { background: linear-gradient(135deg,#f5c451,#d99b1f); color: #2a1d02; }
  .ppe .badge.blocked { background: rgba(248,113,113,.16); color: #f87171; }

  .ppe .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: .8rem 1rem; padding: 1rem 1.1rem; }
  .ppe .fact .k { font-size: .7rem; color: #93a4bd; margin-bottom: .15rem; }
  .ppe .fact .v { font-size: .88rem; font-weight: 700; overflow-wrap: anywhere; }
  .ppe .fact .v.muted { color: #6f819c; font-weight: 400; }

  .ppe .memo { margin: 0 1.1rem 1rem; background: rgba(11,17,32,.6); border-left: 3px solid rgba(245,196,81,.5); border-radius: 6px; padding: .55rem .8rem; font-size: .8rem; color: #cbd5e6; }
  .ppe .memo .k { font-size: .7rem; color: #93a4bd; display: block; margin-bottom: .15rem; }

  .ppe .ops { border-top: 1px solid rgba(148,163,184,.14); padding: .9rem 1.1rem 1.1rem; display: grid; gap: .8rem; }
  .ppe .ops-row { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }
  .ppe .ops-label { font-size: .7rem; color: #93a4bd; flex: 0 0 5.5rem; }
  .ppe .ops-danger .ops-label { color: #f87171; }
  .ppe .ops button { border: 0; border-radius: 9px; padding: .55rem 1rem; font-weight: 700; font-size: .82rem; cursor: pointer; font-family: inherit; }
  .ppe .ops button[disabled] { opacity: .4; cursor: not-allowed; }
  .ppe .b-preview { background: #334155; color: #e6edf7; }
  .ppe .b-staged { background: #34d399; color: #05261a; }
  .ppe .b-review { background: #475569; color: #e6edf7; }
  .ppe .b-immediate { background: linear-gradient(135deg,#f5c451,#d99b1f); color: #2a1d02; box-shadow: 0 6px 18px -8px rgba(245,196,81,.8); }
  .ppe .b-blocked { background: transparent; color: #f87171; border: 1px solid rgba(248,113,113,.55) !important; }
  .ppe .applied { font-size: .7rem; color: #6f819c; }
  .ppe .memo-input { flex: 1 1 240px; min-width: 180px; padding: .45rem .6rem; border-radius: 8px; border: 1px solid rgba(148,163,184,.28); background: #0b1120; color: #e6edf7; font-size: .8rem; font-family: inherit; }
  .ppe .empty { color: #93a4bd; font-size: .86rem; padding: 2rem 0; text-align: center; }

  /* ── プレビュー モーダル ── */
  .ppe .pv-backdrop { position: fixed; inset: 0; background: rgba(3,7,18,.74); display: flex; align-items: flex-start; justify-content: center; padding: 4vh 1rem; z-index: 50; overflow-y: auto; }
  .ppe .pv-backdrop[hidden] { display: none; }
  .ppe .pv-modal { background: #0d1729; border: 1px solid rgba(148,163,184,.24); border-radius: 14px; width: min(780px, 100%); padding: 1.2rem 1.3rem 1.6rem; }
  .ppe .pv-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .ppe .pv-head h2 { font-size: 1.05rem; margin: 0; }
  .ppe .pv-close { background: transparent; border: 0; color: #93a4bd; font-size: 1.5rem; line-height: 1; padding: 0 .4rem; cursor: pointer; }
  .ppe .pv-notice { font-size: .76rem; color: #f5c451; background: rgba(245,196,81,.08); border: 1px solid rgba(245,196,81,.26); border-radius: 8px; padding: .5rem .7rem; margin: .7rem 0 1rem; }
  .ppe .pv-controls { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .ppe .pv-controls label { font-size: .78rem; color: #93a4bd; display: flex; align-items: center; gap: .4rem; }
  .ppe .pv-controls select { background: #0b1120; color: #e6edf7; border: 1px solid rgba(148,163,184,.28); border-radius: 8px; padding: .35rem .5rem; font-family: inherit; }
  .ppe .pv-body { display: grid; gap: .9rem; }
  .ppe .pv-top { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: .6rem; }
  .ppe .pv-top .cell { background: #111c33; border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .6rem .7rem; }
  .ppe .pv-top .k { font-size: .68rem; color: #93a4bd; }
  .ppe .pv-top .v { font-size: .95rem; font-weight: 800; margin-top: .15rem; }
  .ppe .pv-sec { border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .8rem 1rem; background: #111c33; }
  .ppe .pv-sec h3 { font-size: .78rem; color: #93a4bd; margin: 0 0 .5rem; font-weight: 700; }
  .ppe .pv-kv { display: grid; grid-template-columns: max-content 1fr; gap: .3rem .9rem; font-size: .82rem; margin: 0; }
  .ppe .pv-kv dt { color: #93a4bd; }
  .ppe .pv-kv dd { margin: 0; font-weight: 700; }
  .ppe .pv-mock { border: 1px dashed rgba(148,163,184,.35); border-radius: 10px; padding: 1rem; text-align: center; }
  .ppe .pv-mock .pv-intake-t { font-size: .76rem; color: #93a4bd; }
  .ppe .pv-mock .pv-intake-s { font-size: 1.05rem; font-weight: 900; margin: .25rem 0; }
  .ppe .pv-mock .pv-intake-n { font-size: .72rem; color: #93a4bd; }
  .ppe .pv-mock .pv-price { margin: .8rem 0 .5rem; font-weight: 900; color: #f5c451; }
  .ppe .pv-mock .pv-cta { display: inline-block; border-radius: 10px; padding: .6rem 1.4rem; font-weight: 800; background: linear-gradient(135deg,#f5c451,#d99b1f); color: #2a1d02; }
  .ppe .pv-mock .pv-cta.off { opacity: .45; filter: grayscale(.6); }
  .ppe .pv-mock .pv-none { color: #93a4bd; font-size: .84rem; }
  .ppe .pv-vis { font-size: .82rem; line-height: 1.7; margin: .8rem 0 0; }
  .ppe .yes { color: #34d399; }
  .ppe .no { color: #f87171; }

  /* ── レスポンシブ ── */
 @media (max-width: 860px) {
    .ppe .ppe-head { flex-direction: column; gap: .9rem; }
    .ppe .btn-reload { align-self: stretch; }
    .ppe .toolbar { flex-direction: column; align-items: stretch; }
    .ppe .search { flex-direction: column; align-items: stretch; }
    .ppe .search input[type=search] { min-width: 0; width: 100%; }
  }
 @media (max-width: 640px) {
    .ppe .cust-head { flex-direction: column; align-items: flex-start; gap: .5rem; }
    .ppe .cust-email { max-width: 100%; }
    .ppe .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ppe .ops-row { flex-direction: column; align-items: stretch; }
    .ppe .ops-label { flex: none; }
    .ppe .ops button { width: 100%; }
    .ppe .memo-input { width: 100%; }
  }
</style>

<script is:inline>
  (() => {
    const API = '/.netlify/functions/premium-plus-eligibility';
    const $ = (id) => document.getElementById(id);
    const secretEl = $('secret');

    const saved = sessionStorage.getItem('pp-admin-secret');
    if (saved) secretEl.value = saved;
    secretEl.addEventListener('change', () => {
      sessionStorage.setItem('pp-admin-secret', secretEl.value);
      setConn(false);
    });

    function setConn(ok) {
      const el = $('connState');
      el.textContent = ok ? '管理API 接続済み' : '未接続';
      el.className = 'conn-state' + (ok ? ' ok' : '');
      if (ok) $('connPanel').open = false;
    }
    if (!saved) $('connPanel').open = true;

    function msg(text, kind) {
      const el = $('message');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function call(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { msg('管理シークレットを入力してください', 'err'); $('connPanel').open = true; return null; }
      const res = await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { msg(data.error || ('エラー: ' + res.status), 'err'); if (res.status === 403) setConn(false); return null; }
      setConn(true);
      return data;
    }

    // ── 状態の分類（表示・並び順・フィルター用。判定そのものは Function 側の単一源）──
    const STATE = {
      review:    { key: 'review',    label: '保留',        badge: 'review',    order: 1 },
      staged:    { key: 'staged',    label: '段階公開中',   badge: 'staged',    order: 2 },
      sale:      { key: 'sale',      label: '販売中',      badge: 'sale',      order: 2 },
      immediate: { key: 'immediate', label: '即時販売',     badge: 'immediate', order: 3 },
      blocked:   { key: 'blocked',   label: '販売対象外',   badge: 'blocked',   order: 4 },
    };
    function classify(r) {
      if (r.eligibility === 'blocked') return STATE.blocked;
      if (r.eligibility !== 'eligible') return STATE.review;
      if (r.overrideApplied) return STATE.immediate;
      return r.phase === 4 ? STATE.sale : STATE.staged;
    }
    const ROUTE_LABEL = { sanrenpuku: 'A（三連複）', premium_30d: 'B（Premium 30日）', none: '対象外' };
    const fmtDate = (v) => (v ? String(v).slice(0, 10) : '—');

    // ── フィルター ──
    const FILTERS = [
      { key: 'all', label: 'すべて' },
      { key: 'review', label: '保留' },
      { key: 'eligible', label: '販売可' },
      { key: 'immediate', label: '即時販売' },
      { key: 'blocked', label: '販売対象外' },
      { key: 'routeA', label: 'ROUTE A' },
      { key: 'routeB', label: 'ROUTE B' },
    ];
    let activeFilter = 'all';
    let lastData = null;

    function buildFilters() {
      const box = $('filters');
      box.innerHTML = '';
      for (const f of FILTERS) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'chip';
        b.textContent = f.label;
        b.dataset.filter = f.key;
        b.setAttribute('aria-pressed', String(f.key === activeFilter));
        b.addEventListener('click', () => { activeFilter = f.key; buildFilters(); render(); });
        box.appendChild(b);
      }
    }

    function matches(r) {
      const st = classify(r).key;
      if (activeFilter === 'review' && st !== 'review') return false;
      if (activeFilter === 'eligible' && !(st === 'staged' || st === 'sale')) return false;
      if (activeFilter === 'immediate' && st !== 'immediate') return false;
      if (activeFilter === 'blocked' && st !== 'blocked') return false;
      if (activeFilter === 'routeA' && r.route !== 'sanrenpuku') return false;
      if (activeFilter === 'routeB' && r.route !== 'premium_30d') return false;
      const q = $('q').value.trim().toLowerCase();
      if (q && !String(r.email || '').toLowerCase().includes(q)) return false;
      return true;
    }

    function sortRows(rows) {
      return [...rows].sort((a, b) => {
        const d = classify(a).order - classify(b).order;
        if (d !== 0) return d;
        const ua = String(a.updatedAt || ''), ub = String(b.updatedAt || '');
        if (ua !== ub) return ub.localeCompare(ua); // 最終更新が新しい順
        return String(a.email).localeCompare(String(b.email));
      });
    }

    // ── サマリー ──
    function renderSummary(c) {
      const cards = [
        ['即時販売', c.immediate, 'pri-immediate'],
        ['販売可', c.eligible, 'pri-eligible'],
        ['保留', c.review, 'pri-review'],
        ['候補', c.total, ''],
        ['販売対象外', c.blocked, ''],
        ['ROUTE A', c.routeA, 'sub'],
        ['ROUTE B', c.routeB, 'sub'],
      ];
      $('summary').innerHTML = '';
      for (const [k, v, cls] of cards) {
        const d = document.createElement('div');
        d.className = 'sum ' + cls;
        const kk = document.createElement('div'); kk.className = 'k'; kk.textContent = k;
        const vv = document.createElement('div'); vv.className = 'v'; vv.textContent = String(v ?? 0);
        d.appendChild(kk); d.appendChild(vv);
        $('summary').appendChild(d);
      }
    }

    // ── 顧客カード ──
    function fact(k, v, muted) {
      const w = document.createElement('div'); w.className = 'fact';
      const kk = document.createElement('div'); kk.className = 'k'; kk.textContent = k;
      const vv = document.createElement('div'); vv.className = 'v' + (muted ? ' muted' : ''); vv.textContent = v;
      w.appendChild(kk); w.appendChild(vv); return w;
    }

    function card(r, data) {
      const st = classify(r);
      const el = document.createElement('article');
      el.className = 'cust is-' + st.key;

      // 上部: Email + 状態バッジ
      const head = document.createElement('div'); head.className = 'cust-head';
      const em = document.createElement('div');
      em.className = 'cust-email';
      em.textContent = r.email || '(メール未設定)';
      em.title = r.email || '';
      const badge = document.createElement('span');
      badge.className = 'badge ' + st.badge;
      badge.textContent = r.state || st.label;
      head.appendChild(em); head.appendChild(badge);

      // 中段: ラベル付きの情報グリッド
      const facts = document.createElement('div'); facts.className = 'facts';
      facts.appendChild(fact('プラン', r.plan || '—'));
      facts.appendChild(fact('三連複', r.hasSanrenpuku ? 'あり' : 'なし'));
      facts.appendChild(fact('Route', ROUTE_LABEL[r.route] || r.route));
      facts.appendChild(fact('PHASE', String(r.phase)));
      facts.appendChild(fact('Premium経過', r.daysSincePremium == null ? '—' : r.daysSincePremium + ' 日', r.daysSincePremium == null));
      facts.appendChild(fact('販売許可日', fmtDate(r.eligibleAt), !r.eligibleAt));
      facts.appendChild(fact('最終更新', fmtDate(r.updatedAt), !r.updatedAt));

      el.appendChild(head); el.appendChild(facts);

      // 内部メモ（あるときだけ別枠）
      if (r.reason) {
        const memo = document.createElement('div'); memo.className = 'memo';
        const k = document.createElement('span'); k.className = 'k'; k.textContent = '内部メモ（管理者のみ）';
        memo.appendChild(k); memo.appendChild(document.createTextNode(r.reason));
        el.appendChild(memo);
      }

      // 操作エリア
      const ops = document.createElement('div'); ops.className = 'ops';
      const memoInput = document.createElement('input');
      memoInput.className = 'memo-input';
      memoInput.placeholder = '内部メモ（管理者のみ・任意）';
      memoInput.value = r.reason || '';

      const buttons = [];
      const mkBtn = (plusAction, label, cls, isCurrent, extraDisabled) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = cls;
        b.textContent = label;
        b.dataset.action = plusAction;
        b.disabled = !data.writeEnabled || isCurrent || !!extraDisabled;
        if (isCurrent) b.title = '現在この状態です（適用中）';
        b.addEventListener('click', async () => {
          if (b.dataset.busy === '1') return; // 二重クリック防止
          if (plusAction === 'immediate') {
            const ok = window.confirm(
              'この会員は即時PHASE 4となり、価格と購入CTAが表示されます。\n\n'
              + '段階公開（PHASE 1→4）を飛ばして、いますぐ販売可能な状態にします。\n'
              + '実行してよろしいですか？'
            );
            if (!ok) return;
          }
          b.dataset.busy = '1';
          buttons.forEach((x) => { x.disabled = true; });
          msg('更新中…');
          const out = await call({ action: 'update', recordId: r.recordId, plusAction, reason: memoInput.value });
          b.dataset.busy = '';
          if (out) {
            msg('更新しました: ' + out.label + (out.override === 'phase4' ? '（即時販売）' : ''), 'ok');
            load();
          } else {
            render(); // 失敗時は現在の状態でボタンを再構成する
          }
        });
        buttons.push(b);
        return b;
      };

      const isImmediate = st.key === 'immediate';
      const isStagedNow = r.eligibility === 'eligible' && !r.overrideApplied;

      // 通常操作
      const rowN = document.createElement('div'); rowN.className = 'ops-row';
      const lbN = document.createElement('span'); lbN.className = 'ops-label'; lbN.textContent = '通常操作';
      rowN.appendChild(lbN);
      const pv = document.createElement('button');
      pv.type = 'button'; pv.className = 'b-preview'; pv.textContent = '表示プレビュー';
      pv.addEventListener('click', () => openPreview(r.recordId));
      rowN.appendChild(pv);
      rowN.appendChild(mkBtn('staged', '段階公開で販売可', 'b-staged', isStagedNow));
      rowN.appendChild(mkBtn('review', '保留', 'b-review', r.eligibility === 'review'));
      if (isStagedNow) { const s = document.createElement('span'); s.className = 'applied'; s.textContent = '段階公開で適用中'; rowN.appendChild(s); }

      // 強い操作
      const rowD = document.createElement('div'); rowD.className = 'ops-row ops-danger';
      const lbD = document.createElement('span'); lbD.className = 'ops-label'; lbD.textContent = '強い操作';
      rowD.appendChild(lbD);
      rowD.appendChild(mkBtn('immediate', '今すぐ販売可', 'b-immediate', isImmediate, !data.overrideEnabled));
      rowD.appendChild(mkBtn('blocked', '販売対象外', 'b-blocked', r.eligibility === 'blocked'));
      if (isImmediate) { const s = document.createElement('span'); s.className = 'applied'; s.textContent = '即時販売を適用中'; rowD.appendChild(s); }

      const rowM = document.createElement('div'); rowM.className = 'ops-row';
      const lbM = document.createElement('span'); lbM.className = 'ops-label'; lbM.textContent = 'メモ';
      rowM.appendChild(lbM); rowM.appendChild(memoInput);

      ops.appendChild(rowN); ops.appendChild(rowD); ops.appendChild(rowM);
      el.appendChild(ops);
      return el;
    }

    function render() {
      if (!lastData) return;
      const data = lastData;
      renderSummary(data.counts || {});
      $('writeState').textContent = (data.writeEnabled
        ? '書き込み: 有効'
        : '書き込み: 無効（Airtable に Premium Plus フィールド未作成 / PREMIUM_PLUS_FIELDS_READY 未設定）。一覧は閲覧のみ。')
        + (data.overrideEnabled
          ? ' / 今すぐ販売可: 利用可'
          : ' / 今すぐ販売可: 無効（PremiumPlusReleaseOverride 未作成 / PREMIUM_PLUS_OVERRIDE_READY 未設定）');

      const rows = sortRows((data.rows || []).filter(matches));
      const list = $('list');
      list.innerHTML = '';
      for (const r of rows) list.appendChild(card(r, data));
      $('count').textContent = '表示 ' + rows.length + ' 件 / 全 ' + (data.rows || []).length + ' 件';
      if (!rows.length) {
        const p = document.createElement('p'); p.className = 'empty';
        p.textContent = (data.rows || []).length ? '条件に一致する会員はいません。' : '該当する候補はありません。';
        list.appendChild(p);
      }
      if (data.truncated) msg('件数が多いため一部のみ表示しています', 'err');
    }

    async function load() {
      msg('読み込み中…');
      const data = await call({ action: 'list', onlyReview: $('onlyReview').checked });
      if (data) { msg(''); lastData = data; render(); }
    }

    // ── 管理者プレビュー（read-only）─────────────────────────────
    let pvRecordId = null;
    let pvOptionsReady = false;

    function fillOptions(sel, items, valueKey, current) {
      if (sel.options.length) return;
      for (const it of items) {
        const o = document.createElement('option');
        o.value = it[valueKey] === null ? '' : String(it[valueKey]);
        o.textContent = it.label;
        sel.appendChild(o);
      }
      sel.value = current ?? '';
    }

    function row(dl, k, v, cls) {
      const dt = document.createElement('dt'); dt.textContent = k;
      const dd = document.createElement('dd'); dd.textContent = String(v);
      if (cls) dd.className = cls;
      dl.appendChild(dt); dl.appendChild(dd);
    }
    const yn = (b) => (b ? 'はい' : 'いいえ');
    const ynCls = (b) => (b ? 'yes' : 'no');

    function renderPreview(data) {
      const p = data.preview;
      const body = $('pvBody');
      body.innerHTML = '';

      // 上部サマリー: 現在 PHASE / 受付 / 商品ページ / CTA / purchaseEnabled
      const top = document.createElement('div'); top.className = 'pv-top';
      const cell = (k, v, cls) => {
        const c = document.createElement('div'); c.className = 'cell';
        const kk = document.createElement('div'); kk.className = 'k'; kk.textContent = k;
        const vv = document.createElement('div'); vv.className = 'v' + (cls ? ' ' + cls : ''); vv.textContent = v;
        c.appendChild(kk); c.appendChild(vv); top.appendChild(c);
      };
      cell('現在 PHASE', 'PHASE ' + p.phase + (p.simulated.phaseDaysAgo === null ? '' : '（シミュ）'));
      cell('受付状態', p.intakeStatus || '（PHASE 4 未満）');
      cell('商品ページ', p.showProductPage ? '表示 (200)' : '非表示 (404)', ynCls(p.showProductPage));
      cell('価格・CTA', p.showPurchaseCta ? '表示' : '非表示', ynCls(p.showPurchaseCta));
      cell('purchaseEnabled', yn(p.purchaseEnabled), ynCls(p.purchaseEnabled));
      body.appendChild(top);

      const mk = (title) => { const s = document.createElement('div'); s.className = 'pv-sec'; const h = document.createElement('h3'); h.textContent = title; s.appendChild(h); body.appendChild(s); return s; };

      const mock = mk('会員に見える表示（Premium Plus 商品ページ 相当）');
      const box = document.createElement('div'); box.className = 'pv-mock';
      if (!p.showProductPage) {
        const n = document.createElement('p'); n.className = 'pv-none';
        n.textContent = p.showTeaser ? '商品ページ: 404（会員ページに予告カードのみ表示）' : '商品ページ: 404（予告も出ません）';
        box.appendChild(n);
      } else {
        if (p.intakeStatus) {
          const t = document.createElement('div'); t.className = 'pv-intake-t'; t.textContent = p.intakeTitle || '';
          const s2 = document.createElement('div'); s2.className = 'pv-intake-s'; s2.textContent = p.intakeStatus;
          box.appendChild(t); box.appendChild(s2);
          if (p.intakeNote) { const nt = document.createElement('div'); nt.className = 'pv-intake-n'; nt.textContent = p.intakeNote; box.appendChild(nt); }
        }
        const pr = document.createElement('div'); pr.className = 'pv-price';
        pr.textContent = p.priceVisible ? '価格ブロック: 表示される' : '価格ブロック: 非表示（受付準備中）';
        box.appendChild(pr);
        const cta = document.createElement('span');
        cta.className = 'pv-cta' + (p.ctaEnabled ? '' : ' off');
        cta.textContent = p.showPurchaseCta ? (p.ctaEnabled ? '銀行振込で購入する（操作可）' : '銀行振込で購入する（操作不可）') : '受付準備中';
        box.appendChild(cta);
      }
      mock.appendChild(box);
      const vis = document.createElement('p'); vis.className = 'pv-vis'; vis.textContent = data.visibility || '';
      mock.appendChild(vis);

      const d1 = mk('判定');
      const dl1 = document.createElement('dl'); dl1.className = 'pv-kv';
      row(dl1, '評価時刻(JST)', p.evaluatedAtJst + (p.simulated.isSimulatedTime ? '（シミュレーション）' : ''));
      row(dl1, 'route', p.route);
      row(dl1, 'PremiumPlusEligibility', p.eligibility);
      row(dl1, 'PremiumPlusReleaseOverride', p.releaseOverride || '(空)');
      row(dl1, 'overrideApplied', yn(p.overrideApplied), ynCls(p.overrideApplied));
      row(dl1, '状態', p.state);
      row(dl1, 'anchor(JST)', p.anchorJst || '(なし)');
      row(dl1, 'intake', p.intake || '(PHASE 4 未満)');
      d1.appendChild(dl1);

      const d2 = mk('表示フラグ');
      const dl2 = document.createElement('dl'); dl2.className = 'pv-kv';
      row(dl2, 'showTeaser', yn(p.showTeaser), ynCls(p.showTeaser));
      row(dl2, 'showProductPage', yn(p.showProductPage), ynCls(p.showProductPage));
      row(dl2, 'showPurchaseCta', yn(p.showPurchaseCta), ynCls(p.showPurchaseCta));
      row(dl2, 'purchaseEnabled', yn(p.purchaseEnabled), ynCls(p.purchaseEnabled));
      row(dl2, '商品ページ HTTP', p.productPageStatus);
      if (p.canBrowseWhenClosed !== null) row(dl2, 'CLOSED でも閲覧可', yn(p.canBrowseWhenClosed), ynCls(p.canBrowseWhenClosed));
      d2.appendChild(dl2);
    }

    async function refreshPreview() {
      if (!pvRecordId) return;
      $('pvBody').textContent = '読み込み中…';
      const data = await call({
        action: 'preview',
        recordId: pvRecordId,
        atMin: $('pvTime').value === '' ? null : Number($('pvTime').value),
        phaseDaysAgo: $('pvPhase').value === '' ? null : Number($('pvPhase').value),
      });
      if (!data) { $('pvBody').textContent = '取得に失敗しました'; return; }
      if (!pvOptionsReady && data.options) {
        fillOptions($('pvTime'), data.options.times, 'atMin', '');
        fillOptions($('pvPhase'), data.options.phases, 'daysAgo', '');
        pvOptionsReady = true;
      }
      renderPreview(data);
    }

    function openPreview(recordId) {
      pvRecordId = recordId;
      $('pvBackdrop').hidden = false;
      refreshPreview();
    }
    function closePreview() { $('pvBackdrop').hidden = true; pvRecordId = null; }

    $('pvClose').addEventListener('click', closePreview);
    $('pvBackdrop').addEventListener('click', (e) => { if (e.target === $('pvBackdrop')) closePreview(); });
    $('pvTime').addEventListener('change', refreshPreview);
    $('pvPhase').addEventListener('change', refreshPreview);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !$('pvBackdrop').hidden) closePreview(); });

    $('reload').addEventListener('click', load);
    $('q').addEventListener('input', render);
    buildFilters();
  })();
</script>
