---
export const prerender = true;
// 認可: この画面は /admin/* の Basic-Auth（Edge Function）背後。POST は x-admin-secret を
// premium-plus-eligibility Function 側で検証する。secret はこのタブ限定（sessionStorage）。
//
// この画面が変更するのは **Premium Plus の販売資格だけ**。
// プラン / Status / 有効期限 / LifetimeSanrenpuku / メール状態は一切変更しない。
// 資格変更でメール送信・課金・昇格は起きない（表示資格のみ）。
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Premium Plus 販売管理（管理）">
  <div class="ppe">
    <h1>Premium Plus 販売対象</h1>
    <p class="lead">
      Premium Plus を販売してよい会員を <b>管理者が手動で選別</b>します。
      候補は自動で「販売可」になりません（新規候補は必ず <b>保留</b> から始まります）。
      ここでの変更は <b>Premium Plus の表示資格だけ</b>で、プラン・有効期限・メール・課金には影響しません。
    </p>
    <p class="lead warn">
      <b>「今すぐ販売可」</b>はその会員だけ段階公開を飛ばして <b>即 PHASE 4（価格・購入 CTA 表示）</b>にする操作です。
      確認ダイアログでの承諾後にのみ実行されます。購入日や販売許可日を過去日に書き換えることはしません。
    </p>

    <div class="card">
      <label>管理シークレット（PREMIUM_PLUS_ADMIN_SECRET・このタブのみ保持）</label>
      <input type="password" id="secret" placeholder="Netlify に設定した値" autocomplete="off" />
      <div class="row">
        <label class="chk"><input type="checkbox" id="onlyReview" /> 保留（確認待ち）だけ表示</label>
        <button id="reload" type="button">一覧を読み込む</button>
      </div>
      <p class="note" id="writeState"></p>
    </div>

    <div id="summary" class="summary"></div>

    <!-- 管理者プレビュー モーダル（read-only。実顧客セッションは作らない） -->
    <div id="pvBackdrop" class="pv-backdrop" hidden>
      <div class="pv-modal" role="dialog" aria-modal="true" aria-labelledby="pvTitle">
        <div class="pv-head">
          <h2 id="pvTitle">表示プレビュー</h2>
          <button type="button" id="pvClose" class="pv-close" aria-label="閉じる">×</button>
        </div>
        <p class="pv-notice">管理者プレビュー / 実顧客には影響しません（読み取りのみ・ログインもメール送信もしません）</p>
        <div class="pv-controls">
          <label>時刻シミュレーション <select id="pvTime"></select></label>
          <label>PHASE 表示確認 <select id="pvPhase"></select></label>
        </div>
        <div id="pvBody" class="pv-body"></div>
      </div>
    </div>
    <div id="message" class="msg"></div>
    <div id="list" class="list"></div>
  </div>
</BaseLayout>

<style>
  .ppe { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1rem 4rem; color: #e6edf7; }
  .ppe h1 { font-size: 1.4rem; margin: 0 0 .6rem; }
  .lead { color: #93a4bd; font-size: .88rem; line-height: 1.8; margin: 0 0 1.2rem; }
  .card { background: #111c33; border: 1px solid rgba(148,163,184,.18); border-radius: 12px; padding: 1rem; margin-bottom: 1rem; }
  .card label { display: block; font-size: .8rem; color: #93a4bd; margin-bottom: .35rem; }
  .card input[type=password] { width: 100%; padding: .6rem .7rem; border-radius: 8px; border: 1px solid rgba(148,163,184,.28); background: #0b1120; color: #e6edf7; }
  .row { display: flex; align-items: center; gap: 1rem; margin-top: .8rem; flex-wrap: wrap; }
  .chk { display: flex; align-items: center; gap: .4rem; margin: 0; }
  button { cursor: pointer; border: 0; border-radius: 8px; padding: .55rem 1rem; font-weight: 700; font-family: inherit; }
  #reload { background: #f5c451; color: #2a1d02; }
  .note { font-size: .76rem; color: #93a4bd; margin: .6rem 0 0; }
  .summary { display: flex; gap: .6rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .pill { background: #0d1729; border: 1px solid rgba(148,163,184,.2); border-radius: 999px; padding: .35rem .8rem; font-size: .78rem; }
  .msg { font-size: .84rem; margin-bottom: 1rem; min-height: 1.2em; }
  .msg.ok { color: #34d399; } .msg.err { color: #f87171; }
  .list { display: grid; gap: .6rem; }
  .item { background: #111c33; border: 1px solid rgba(148,163,184,.16); border-radius: 10px; padding: .8rem 1rem; display: grid; gap: .5rem; }
  .item .top { display: flex; gap: .8rem; align-items: baseline; flex-wrap: wrap; }
  .item .em { font-weight: 700; }
  .item .meta { font-size: .76rem; color: #93a4bd; display: flex; gap: .8rem; flex-wrap: wrap; }
  .badge { font-size: .72rem; font-weight: 800; padding: .15rem .6rem; border-radius: 999px; }
  .badge.eligible { background: rgba(52,211,153,.14); color: #34d399; }
  .badge.review { background: rgba(245,196,81,.14); color: #f5c451; }
  .badge.blocked { background: rgba(248,113,113,.14); color: #f87171; }
  .acts { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
  .acts input { flex: 1 1 220px; min-width: 180px; padding: .45rem .6rem; border-radius: 8px; border: 1px solid rgba(148,163,184,.28); background: #0b1120; color: #e6edf7; font-size: .82rem; }
  .acts button { font-size: .8rem; }
  .lead.warn { color: #f5c451; }
  .state { font-size: .8rem; font-weight: 800; }
  .b-staged { background: #34d399; color: #05261a; }
  .b-immediate { background: linear-gradient(135deg, #f5c451, #d99b1f); color: #2a1d02; }
  .badge.immediate { background: rgba(245,196,81,.18); color: #f5c451; }
  .acts button[disabled] { opacity: .45; cursor: not-allowed; }
  .b-preview { background: #334155; color: #e6edf7; }
  .pv-backdrop { position: fixed; inset: 0; background: rgba(3,7,18,.72); display: flex; align-items: flex-start; justify-content: center; padding: 4vh 1rem; z-index: 50; overflow-y: auto; }
  .pv-backdrop[hidden] { display: none; }
  .pv-modal { background: #0d1729; border: 1px solid rgba(148,163,184,.24); border-radius: 14px; width: min(760px, 100%); padding: 1.2rem 1.3rem 1.6rem; }
  .pv-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .pv-head h2 { font-size: 1.05rem; margin: 0; }
  .pv-close { background: transparent; color: #93a4bd; font-size: 1.4rem; line-height: 1; padding: 0 .4rem; }
  .pv-notice { font-size: .76rem; color: #f5c451; background: rgba(245,196,81,.08); border: 1px solid rgba(245,196,81,.26); border-radius: 8px; padding: .5rem .7rem; margin: .7rem 0 1rem; }
  .pv-controls { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .pv-controls label { font-size: .78rem; color: #93a4bd; display: flex; align-items: center; gap: .4rem; }
  .pv-controls select { background: #0b1120; color: #e6edf7; border: 1px solid rgba(148,163,184,.28); border-radius: 8px; padding: .35rem .5rem; font-family: inherit; }
  .pv-body { display: grid; gap: .9rem; }
  .pv-sec { border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .8rem 1rem; background: #111c33; }
  .pv-sec h3 { font-size: .8rem; color: #93a4bd; margin: 0 0 .5rem; font-weight: 700; }
  .pv-kv { display: grid; grid-template-columns: max-content 1fr; gap: .3rem .9rem; font-size: .82rem; }
  .pv-kv dt { color: #93a4bd; }
  .pv-kv dd { margin: 0; font-weight: 700; }
  .pv-mock { border: 1px dashed rgba(148,163,184,.35); border-radius: 10px; padding: 1rem; text-align: center; }
  .pv-mock .pv-intake-t { font-size: .78rem; color: #93a4bd; }
  .pv-mock .pv-intake-s { font-size: 1.05rem; font-weight: 900; margin: .25rem 0; }
  .pv-mock .pv-intake-n { font-size: .74rem; color: #93a4bd; }
  .pv-mock .pv-price { margin: .8rem 0 .5rem; font-weight: 900; color: #f5c451; }
  .pv-mock .pv-cta { display: inline-block; border-radius: 10px; padding: .6rem 1.4rem; font-weight: 800; background: linear-gradient(135deg,#f5c451,#d99b1f); color: #2a1d02; }
  .pv-mock .pv-cta.off { opacity: .45; filter: grayscale(.6); }
  .pv-mock .pv-none { color: #93a4bd; font-size: .84rem; }
  .pv-vis { font-size: .84rem; line-height: 1.7; }
  .yes { color: #34d399; } .no { color: #f87171; }
  .b-eligible { background: #34d399; color: #05261a; }
  .b-review { background: #f5c451; color: #2a1d02; }
  .b-blocked { background: #f87171; color: #2a0707; }
</style>

<script is:inline>
  (() => {
    const API = '/.netlify/functions/premium-plus-eligibility';
    const $ = (id) => document.getElementById(id);
    const secretEl = $('secret');

    const saved = sessionStorage.getItem('pp-admin-secret');
    if (saved) secretEl.value = saved;
    secretEl.addEventListener('change', () => sessionStorage.setItem('pp-admin-secret', secretEl.value));

    function msg(text, kind) {
      const el = $('message');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function call(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { msg('管理シークレットを入力してください', 'err'); return null; }
      const res = await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { msg(data.error || ('エラー: ' + res.status), 'err'); return null; }
      return data;
    }

    const ROUTE_LABEL = { sanrenpuku: '三連複', premium_30d: 'Premium 30日', none: '対象外' };

    function render(data) {
      const c = data.counts || {};
      $('summary').innerHTML = [
        ['候補', c.total], ['保留', c.review], ['販売可', c.eligible], ['販売対象外', c.blocked],
        ['ROUTE A(三連複)', c.routeA], ['ROUTE B(Premium30日)', c.routeB], ['即時販売', c.immediate],
      ].map(([k, v]) => `<span class="pill">${k}: <b>${v ?? 0}</b></span>`).join('');

      $('writeState').textContent = (data.writeEnabled
        ? '書き込み: 有効'
        : '書き込み: 無効（Airtable に Premium Plus フィールド未作成 / PREMIUM_PLUS_FIELDS_READY 未設定）。一覧は閲覧のみ。')
        + (data.overrideEnabled
          ? ' / 今すぐ販売可: 利用可'
          : ' / 今すぐ販売可: 無効（PremiumPlusReleaseOverride 未作成 / PREMIUM_PLUS_OVERRIDE_READY 未設定）');

      const list = $('list');
      list.innerHTML = '';
      for (const r of data.rows || []) {
        const el = document.createElement('div');
        el.className = 'item';

        const top = document.createElement('div');
        top.className = 'top';
        const em = document.createElement('span');
        em.className = 'em';
        em.textContent = r.email || '(メール未設定)';
        const badge = document.createElement('span');
        badge.className = 'badge ' + (r.overrideApplied ? 'immediate' : r.eligibility);
        badge.textContent = r.eligibilityLabel;
        const state = document.createElement('span');
        state.className = 'state';
        state.textContent = r.state || '';
        top.appendChild(em); top.appendChild(badge); top.appendChild(state);

        const meta = document.createElement('div');
        meta.className = 'meta';
        const days = r.daysSincePremium == null ? '—' : r.daysSincePremium + '日';
        meta.textContent = [
          'プラン: ' + (r.plan || '—'),
          '三連複: ' + (r.hasSanrenpuku ? 'あり' : 'なし'),
          'Premium経過: ' + days,
          'route: ' + (ROUTE_LABEL[r.route] || r.route),
          'phase: ' + r.phase,
          r.eligibleAt ? '販売許可日(段階公開の起点): ' + String(r.eligibleAt).slice(0, 10) : '',
          r.releaseOverride ? 'override: ' + r.releaseOverride : '',
          r.updatedAt ? '最終更新(監査): ' + String(r.updatedAt).slice(0, 10) : '',
          r.reason ? 'メモ: ' + r.reason : '',
        ].filter(Boolean).join('　/　');

        const acts = document.createElement('div');
        acts.className = 'acts';
        const reason = document.createElement('input');
        reason.placeholder = '内部メモ（管理者のみ・任意）';
        reason.value = r.reason || '';
        acts.appendChild(reason);
        const pv = document.createElement('button');
        pv.type = 'button';
        pv.className = 'b-preview';
        pv.textContent = '表示プレビュー';
        pv.addEventListener('click', () => openPreview(r.recordId));
        acts.appendChild(pv);

        const buttons = [];
        for (const [plusAction, label, cls] of [
          ['staged', '段階公開で販売可', 'b-staged'],
          ['immediate', '今すぐ販売可', 'b-immediate'],
          ['review', '保留', 'b-review'],
          ['blocked', '販売対象外', 'b-blocked'],
        ]) {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = cls;
          b.textContent = label;
          b.disabled = !data.writeEnabled || (plusAction === 'immediate' && !data.overrideEnabled);
          b.addEventListener('click', async () => {
            if (b.dataset.busy === '1') return; // 二重クリック防止
            if (plusAction === 'immediate') {
              const ok = window.confirm(
                'この会員は即時PHASE 4となり、価格と購入CTAが表示されます。\n\n'
                + '段階公開（PHASE 1→4）を飛ばして、いますぐ販売可能な状態にします。\n'
                + '実行してよろしいですか？'
              );
              if (!ok) return;
            }
            // 処理中は行内の全ボタンを無効化（二重送信対策）
            b.dataset.busy = '1';
            buttons.forEach((x) => { x.disabled = true; });
            msg('更新中…');
            const out = await call({ action: 'update', recordId: r.recordId, plusAction, reason: reason.value });
            b.dataset.busy = '';
            if (out) {
              msg(`更新しました: ${out.label}${out.override === 'phase4' ? '（即時販売）' : ''}`, 'ok');
              load(); // 再読込で最新状態に置き換わる（ボタンも再生成される）
            } else {
              buttons.forEach((x) => { x.disabled = !data.writeEnabled || (x.dataset.action === 'immediate' && !data.overrideEnabled); });
            }
          });
          b.dataset.action = plusAction;
          buttons.push(b);
          acts.appendChild(b);
        }

        el.appendChild(top); el.appendChild(meta); el.appendChild(acts);
        list.appendChild(el);
      }
      if (!(data.rows || []).length) list.innerHTML = '<p class="note">該当する候補はありません。</p>';
      if (data.truncated) msg('件数が多いため一部のみ表示しています', 'err');
    }

    async function load() {
      msg('読み込み中…');
      const data = await call({ action: 'list', onlyReview: $('onlyReview').checked });
      if (data) { msg(''); render(data); }
    }

    // ── 管理者プレビュー（read-only）─────────────────────────────
    let pvRecordId = null;
    let pvOptionsReady = false;

    function fillOptions(sel, items, valueKey, current) {
      if (sel.options.length) return;
      for (const it of items) {
        const o = document.createElement('option');
        o.value = it[valueKey] === null ? '' : String(it[valueKey]);
        o.textContent = it.label;
        sel.appendChild(o);
      }
      sel.value = current ?? '';
    }

    function row(dl, k, v, cls) {
      const dt = document.createElement('dt'); dt.textContent = k;
      const dd = document.createElement('dd'); dd.textContent = String(v);
      if (cls) dd.className = cls;
      dl.appendChild(dt); dl.appendChild(dd);
    }
    const yn = (b) => (b ? 'はい' : 'いいえ');
    const ynCls = (b) => (b ? 'yes' : 'no');

    function renderPreview(data) {
      const p = data.preview;
      const body = $('pvBody');
      body.innerHTML = '';

      const mk = (title) => { const s = document.createElement('div'); s.className = 'pv-sec'; const h = document.createElement('h3'); h.textContent = title; s.appendChild(h); body.appendChild(s); return s; };

      // 会員向けページの見え方（モック）
      const mock = mk('会員に見える表示（Premium Plus 商品ページ 相当）');
      const box = document.createElement('div'); box.className = 'pv-mock';
      if (!p.showProductPage) {
        const n = document.createElement('p'); n.className = 'pv-none';
        n.textContent = p.showTeaser ? '商品ページ: 404（会員ページに予告カードのみ表示）' : '商品ページ: 404（予告も出ません）';
        box.appendChild(n);
      } else {
        if (p.intakeStatus) {
          const t = document.createElement('div'); t.className = 'pv-intake-t'; t.textContent = p.intakeTitle || '';
          const st = document.createElement('div'); st.className = 'pv-intake-s'; st.textContent = p.intakeStatus;
          box.appendChild(t); box.appendChild(st);
          if (p.intakeNote) { const nt = document.createElement('div'); nt.className = 'pv-intake-n'; nt.textContent = p.intakeNote; box.appendChild(nt); }
        }
        const pr = document.createElement('div'); pr.className = 'pv-price';
        pr.textContent = p.priceVisible ? '価格ブロック: 表示される' : '価格ブロック: 非表示（受付準備中）';
        box.appendChild(pr);
        const cta = document.createElement('span');
        cta.className = 'pv-cta' + (p.ctaEnabled ? '' : ' off');
        cta.textContent = p.showPurchaseCta ? (p.ctaEnabled ? '銀行振込で購入する（操作可）' : '銀行振込で購入する（操作不可）') : '受付準備中';
        box.appendChild(cta);
      }
      mock.appendChild(box);
      const vis = document.createElement('p'); vis.className = 'pv-vis'; vis.textContent = data.visibility || '';
      mock.appendChild(vis);

      // 判定の内訳
      const d1 = mk('判定');
      const dl1 = document.createElement('dl'); dl1.className = 'pv-kv';
      row(dl1, '評価時刻(JST)', p.evaluatedAtJst + (p.simulated.isSimulatedTime ? '（シミュレーション）' : ''));
      row(dl1, 'route', p.route);
      row(dl1, 'PremiumPlusEligibility', p.eligibility);
      row(dl1, 'PremiumPlusReleaseOverride', p.releaseOverride || '(空)');
      row(dl1, 'overrideApplied', yn(p.overrideApplied), ynCls(p.overrideApplied));
      row(dl1, 'PHASE', p.phase + (p.simulated.phaseDaysAgo === null ? '' : '（シミュレーション）'));
      row(dl1, '状態', p.state);
      row(dl1, 'anchor(JST)', p.anchorJst || '(なし)');
      row(dl1, 'intake', p.intake || '(PHASE 4 未満)');
      d1.appendChild(dl1);

      // 表示フラグ
      const d2 = mk('表示フラグ');
      const dl2 = document.createElement('dl'); dl2.className = 'pv-kv';
      row(dl2, 'showTeaser', yn(p.showTeaser), ynCls(p.showTeaser));
      row(dl2, 'showProductPage', yn(p.showProductPage), ynCls(p.showProductPage));
      row(dl2, 'showPurchaseCta', yn(p.showPurchaseCta), ynCls(p.showPurchaseCta));
      row(dl2, 'purchaseEnabled', yn(p.purchaseEnabled), ynCls(p.purchaseEnabled));
      row(dl2, '商品ページ HTTP', p.productPageStatus);
      if (p.canBrowseWhenClosed !== null) row(dl2, 'CLOSED でも閲覧可', yn(p.canBrowseWhenClosed), ynCls(p.canBrowseWhenClosed));
      d2.appendChild(dl2);
    }

    async function refreshPreview() {
      if (!pvRecordId) return;
      $('pvBody').textContent = '読み込み中…';
      const data = await call({
        action: 'preview',
        recordId: pvRecordId,
        atMin: $('pvTime').value === '' ? null : Number($('pvTime').value),
        phaseDaysAgo: $('pvPhase').value === '' ? null : Number($('pvPhase').value),
      });
      if (!data) { $('pvBody').textContent = '取得に失敗しました'; return; }
      if (!pvOptionsReady && data.options) {
        fillOptions($('pvTime'), data.options.times, 'atMin', '');
        fillOptions($('pvPhase'), data.options.phases, 'daysAgo', '');
        pvOptionsReady = true;
      }
      renderPreview(data);
    }

    function openPreview(recordId) {
      pvRecordId = recordId;
      $('pvBackdrop').hidden = false;
      refreshPreview();
    }
    function closePreview() { $('pvBackdrop').hidden = true; pvRecordId = null; }

    $('pvClose').addEventListener('click', closePreview);
    $('pvBackdrop').addEventListener('click', (e) => { if (e.target === $('pvBackdrop')) closePreview(); });
    $('pvTime').addEventListener('change', refreshPreview);
    $('pvPhase').addEventListener('change', refreshPreview);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !$('pvBackdrop').hidden) closePreview(); });

    $('reload').addEventListener('click', load);
  })();
</script>
