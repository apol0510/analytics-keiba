  /* ── 実行前確認（対象者・除外者・理由）── */
  .ppe .pv-head { font-size: .84rem; font-weight: 800; color: #e6edf7; padding: .4rem .6rem;
    background: rgba(56,189,248,.12); border-radius: 6px; }
  .ppe .pv-head.pv-blocked { background: rgba(248,113,113,.14); }
  .ppe .pv-blocker { font-size: .76rem; color: #fca5a5; margin: .25rem 0; font-weight: 700; }
  .ppe .pv-tabs { display: flex; flex-wrap: wrap; gap: .3rem; margin: .5rem 0 .3rem; }
  .ppe .selwarn { font-size: .72rem; color: #fbbf24; }

  /* ── 推奨アクション ── */
  .ppe .rec { border-left: 3px solid #38bdf8; background: rgba(56,189,248,.07);
    border-radius: 6px; padding: .45rem .6rem; margin-bottom: .45rem; }
  .ppe .rec-warn { border-left-color: #fbbf24; background: rgba(251,191,36,.08); }
  .ppe .rec-danger { border-left-color: #f87171; background: rgba(248,113,113,.09); }
  .ppe .rec-title { font-size: .82rem; font-weight: 800; color: #e6edf7; }
  .ppe .rec-why { font-size: .76rem; color: #cbd5e6; margin: .2rem 0 .3rem; line-height: 1.5; }
  .ppe .rec-meta { display: flex; flex-wrap: wrap; gap: .35rem .8rem; font-size: .7rem; color: #94a3b8; }

  /* ── マーケティング履歴 ── */
  .ppe .tl-note { font-size: .72rem; color: #fbbf24; margin: 0 0 .4rem; line-height: 1.5; }
  .ppe .tl-row { display: grid; grid-template-columns: 8.5rem 9rem 1fr auto; gap: .5rem;
    font-size: .74rem; padding: .22rem 0; border-bottom: 1px dotted rgba(148,163,184,.14); align-items: baseline; }
  .ppe .tl-row.tl-unknown { opacity: .75; }
  .ppe .tl-when { color: #94a3b8; }
  .ppe .tl-kind { color: #93c5fd; font-weight: 700; }
  .ppe .tl-detail { color: #e6edf7; word-break: break-word; }
  .ppe .tl-src { color: #64748b; font-size: .66rem; white-space: nowrap; }

  /* ── 表示列の切替（狭い画面は主要列だけ）── */
  .ppe .colmode { font-size: .72rem; color: #94a3b8; display: inline-flex; align-items: center; gap: .3rem; }
  .ppe .btn-ghost.is-on { background: rgba(56,189,248,.18); border-color: rgba(56,189,248,.5); color: #e6edf7; }
  .ppe #paneMkt[data-colmode=basic] .col-detail { display: none; }
  .ppe .action-box { border-color: rgba(56,189,248,.35); }

  /* ── ジョブカードからの送信（確認 → 実行）────────────────────── */
  .ppe .job-send {
    margin: .5rem 0 .2rem; padding: .55rem .7rem;
    border: 1px solid rgba(148,163,184,.22); border-left: 3px solid var(--action-yellow);
    border-radius: 8px; background: rgba(234,179,8,.06);
  }
  .ppe .job-send-ops { display: flex; flex-wrap: wrap; gap: .45rem; }
  .ppe .job-send-ops button { min-height: 40px; }
  /* 行の見た目は既存の .dp-row / .dp-k / .dp-v をそのまま使う（重複定義しない） */
  .ppe .job-send-result { margin: .5rem 0 0; }
  @media (max-width: 640px) {
    .ppe .job-send-ops { flex-direction: column; align-items: stretch; }
    .ppe .job-send-ops button { width: 100%; }
  }

  /* ── 送信ジョブ一覧 ──────────────────────────────────────────
     時系列（.tl-row）のグリッドを流用すると列が潰れて縦組みになるため、
     ここは**縦に積むだけ**にする。狭い画面でも同じ形で読める。 */
  .ppe .job-row {
    display: block; padding: .55rem 0; font-size: .74rem;
    border-bottom: 1px dotted rgba(148,163,184,.14);
  }
  .ppe .job-row .job-head {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem .5rem; margin: 0 0 .3rem;
  }
  .ppe .job-row .tl-detail { margin: .12rem 0; }
  .ppe .job-counts {
    display: flex; flex-wrap: wrap; gap: .2rem .85rem; margin: .25rem 0 0;
  }
  /* 項目の中では折り返さない（「送信待ち 28」が分断されないように）*/
  .ppe .job-count { white-space: nowrap; color: #cbd5e1; }
  .ppe .job-count .jc-k { color: #94a3b8; margin-right: .3rem; }
  .ppe .job-count .jc-v { color: #e6edf7; }
  .ppe .job-count.is-wait .jc-v { color: var(--action-yellow); }
  .ppe .job-count.is-ok .jc-v { color: #6ee7b7; }
  .ppe .job-count.is-ng .jc-v { color: #fca5a5; }
  .ppe .job-row .ops { margin: .45rem 0 0; }

  @media (max-width: 720px) {
    /* 狭い画面では詳細列を常に隠す（カルテで確認する） */
    .ppe #paneMkt .col-detail { display: none; }
    .ppe .tl-row { grid-template-columns: 1fr; gap: .1rem; }
    .ppe .d-k { flex-basis: 7rem; }
  }

  /* ── 顧客カルテ ── */
  .ppe .dossier { background: #0f1a2f; border: 1px solid rgba(148,163,184,.22); border-radius: 11px;
    padding: .85rem 1rem; margin-top: 1rem; }
  .ppe .dossier-head { display: flex; align-items: center; justify-content: space-between; gap: .6rem;
    margin-bottom: .5rem; }
  .ppe .dossier-head h2 { font-size: .9rem; margin: 0; color: #e6edf7; word-break: break-all; }
  .ppe .d-sec { margin-top: .7rem; }
  .ppe .d-sec h3 { font-size: .8rem; margin: 0 0 .35rem; color: #93c5fd; font-weight: 700; }
  .ppe .d-row { display: flex; gap: .6rem; padding: .18rem 0; font-size: .78rem;
    border-bottom: 1px dotted rgba(148,163,184,.14); }
  .ppe .d-row.sub-row { font-size: .72rem; color: #94a3b8; border-bottom: none; }
  .ppe .d-k { flex: 0 0 11rem; color: #94a3b8; }
  .ppe .d-v { flex: 1 1 auto; color: #e6edf7; word-break: break-word; }
  .ppe .d-row.ok .d-v { color: #6ee7b7; font-weight: 700; }
  .ppe .d-row.ng .d-v { color: #fca5a5; font-weight: 700; }
  .ppe .btn-sm { padding: .18rem .5rem; font-size: .72rem; }
  .ppe .c-login .sub { display: block; font-size: .68rem; color: #94a3b8; }

  /* ── 実配信（不可逆操作なので視覚的に区別する）── */
  .ppe .dispatch-box { border-color: rgba(248,113,113,.35); }
  .ppe .btn-danger { background: #b91c1c; color: #fff; border: 1px solid #ef4444;
    border-radius: 7px; padding: .38rem .8rem; font-size: .8rem; font-weight: 700; cursor: pointer; }
  .ppe .btn-danger:disabled { background: #4b5563; border-color: #6b7280; color: #cbd5e6;
    cursor: not-allowed; opacity: .7; }

  /* ── キャンペーン操作 ── */
  .ppe .campaign-box { background: #111c33; border: 1px solid rgba(148,163,184,.16); border-radius: 11px;
    padding: .85rem 1rem; margin-top: 1rem; }
  .ppe .campaign-box h2 { font-size: .9rem; margin: 0 0 .6rem; color: #e6edf7; }
  .ppe .offer-row { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: 0 0 .5rem; }
  .ppe .offer-label { min-width: 12rem; font-size: .78rem; color: #cbd5e6; font-weight: 700; }
  .ppe .offer-sub { display: inline-flex; align-items: center; gap: .35rem; font-size: .72rem; color: #93a4bd; }
  .ppe .offer-sub input { width: 7rem; }
  .ppe .offer-note { margin: 0 0 .8rem; font-size: .72rem; color: #93a4bd; }
  .ppe .price-box { background: #0d1626; border: 1px solid rgba(148,163,184,.16); border-radius: 9px;
    padding: .6rem .8rem; margin: 0 0 .7rem; }
  .ppe .camp-desc { font-size: .76rem; color: #93a4bd; line-height: 1.7; margin: .4rem 0 0; }
  /* 運用テスト専用キャンペーン（顧客向けと混同させない） */
  .ppe .testonly { margin: 0 0 .5rem; padding: .5rem .7rem; border-radius: 6px; font-size: .76rem; line-height: 1.6;
    background: rgba(96,165,250,.1); border-left: 3px solid rgba(96,165,250,.6); color: #bfd4f5; font-weight: 700; }
  .ppe .exlist { margin: 0; padding-left: 1.1rem; font-size: .78rem; color: #cbd5e6; line-height: 1.9; }
  .ppe .exlist strong { color: #e6edf7; }
  .ppe .exlist .sub { padding-left: .9rem; font-size: .74rem; color: #93a4bd; line-height: 1.7; }
  .ppe .prev-subject { font-size: .86rem; font-weight: 700; color: #e6edf7; margin: 0; }
  /* 実際のメール本文をそのまま出す枠。枠内の配色はメール側の HTML が決める
     （管理 UI 側のダーク配色をここへ持ち込まない） */
  .ppe .prev-frame { width: 100%; height: 22rem; border: 1px solid rgba(148,163,184,.2); border-radius: 8px; }
  .ppe .seq-box { margin-top: .8rem; }
  .ppe .mail-text { margin-top: .6rem; padding: .6rem .7rem; max-height: 16rem; overflow: auto;
    white-space: pre-wrap; font-size: .8rem; line-height: 1.6; background: rgba(15,23,42,.35);
    border: 1px solid rgba(148,163,184,.2); border-radius: 8px; }
  .ppe .prev-body { white-space: pre-wrap; word-break: break-word; font-size: .78rem; line-height: 1.8;
    color: #dbe6f5; background: #0d1626; border: 1px solid rgba(148,163,184,.16); border-radius: 8px;
    padding: .8rem; margin: .5rem 0 0; font-family: inherit; }

  /* ── 候補区分（表示専用。販売資格ではないので badge とは別の弱い見た目にする）── */
  .ppe .kind { display: inline-block; font-size: .7rem; font-weight: 700; color: #93a4bd; white-space: nowrap; }
  .ppe .kind.waiting_30d { color: #cbd5e6; }
  .ppe .kind.anchor_missing { color: #f5c451; }
  .ppe .blocker { margin: .6rem 0 0; padding: .5rem .7rem; border-radius: 6px; font-size: .76rem; line-height: 1.5;
    background: rgba(245,196,81,.08); border-left: 3px solid rgba(245,196,81,.55); color: #f0d9a0; }

  /* ── 詳細・操作パネル ──
     z-index はサイト共通ヘッダ（position: fixed / z-index: 1000）より上。
     下だとパネル上部（タイトル・閉じる×）がヘッダに隠れ、閉じられなくなる（2026-07-30 本番で発生）。 */
  .ppe .dt-backdrop { position: fixed; inset: 0; background: rgba(3,7,18,.7); z-index: 2000; display: flex; justify-content: flex-end; }
  .ppe .dt-backdrop[hidden] { display: none; }
  .ppe .dt-panel { width: min(460px, 100%); height: 100%; overflow-y: auto; overscroll-behavior: contain; background: #0d1729; border-left: 1px solid rgba(148,163,184,.24); padding: 0 1.2rem 2.5rem; }
  /* 見出しと戻る/閉じるは常に見える位置に固定する（スクロールしても届く） */
  .ppe .dt-head { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: .8rem; margin: 0 0 .9rem; padding: .85rem 0 .7rem; background: #0d1729; border-bottom: 1px solid rgba(148,163,184,.18); }
  .ppe .dt-head-l { display: flex; align-items: center; gap: .6rem; min-width: 0; }
  .ppe .dt-head h2 { font-size: 1rem; margin: 0; }
  .ppe .btn-back { background-color: var(--nv-2); color: var(--ink-2); border-color: var(--line-2); border-radius: 9px; padding: .38rem .8rem; font-size: .76rem; font-weight: 700; white-space: nowrap; }
  .ppe .btn-back:hover:not([disabled]) { background-color: var(--nv-3); border-color: rgba(96,165,250,.5); color: var(--ink); }
  .ppe .x { background-color: transparent; border-color: transparent; box-shadow: none; color: var(--muted); font-size: 1.4rem; line-height: 1; padding: 0 .35rem; }
  .ppe .x:hover:not([disabled]) { background-color: rgba(148,163,184,.14); border-color: transparent; color: var(--ink); }
  .ppe .dt-body { display: grid; gap: .9rem; }
  .ppe .dt-email { font-weight: 700; font-size: .9rem; overflow-wrap: anywhere; margin-bottom: .4rem; }
  .ppe .dt-sec { border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .8rem .9rem; background: #111c33; }
  .ppe .dt-sec h3 { font-size: .72rem; color: #93a4bd; margin: 0 0 .55rem; font-weight: 700; }
  .ppe .dt-sec.danger { border-color: rgba(248,113,113,.32); }
  .ppe .dt-sec.danger h3 { color: #f87171; }
  .ppe .kv { display: grid; grid-template-columns: max-content 1fr; gap: .3rem .9rem; font-size: .8rem; margin: 0; }
  .ppe .kv dt { color: #93a4bd; }
  .ppe .kv dd { margin: 0; font-weight: 700; overflow-wrap: anywhere; }
  .ppe .memo-view { background: rgba(11,17,32,.6); border-left: 3px solid rgba(245,196,81,.5); border-radius: 6px; padding: .5rem .7rem; font-size: .78rem; color: #cbd5e6; margin-top: .6rem; }
  /* 三連複保有バッジ。プラン名を書き換えず、隣に添えて一目で分かるようにする */
  .ppe .srp-badge {
    display: inline-block; margin-left: .4rem; padding: 1px 7px;
    font-size: .68rem; font-weight: 700; line-height: 1.6; white-space: nowrap;
    color: #7ee0c0; background: rgba(126,224,192,.10);
    border: 1px solid rgba(126,224,192,.42); border-radius: 999px;
  }
  /* 旧プランで Premium 期限切れ＝現在は閲覧不可。保有と同じ色に見せない */
  .ppe .srp-badge.off {
    color: #9fb0c9; background: rgba(159,176,201,.10); border-color: rgba(159,176,201,.35);
  }
  .ppe .srp-note { font-size: .74rem; color: #9fb0c9; line-height: 1.7; margin-top: -.2rem; }

  /* 「自動」の判定ルール（既定は畳んでおき、必要なときだけ開く） */
  .ppe .auto-rules { margin-top: .6rem; font-size: .78rem; color: #9fb0c9; }
  .ppe .auto-rules summary { cursor: pointer; color: #cbd5e6; }
  .ppe .auto-rules ul { margin: .45rem 0 0; padding-left: 1.2rem; line-height: 1.75; }
  .ppe .ops { display: flex; gap: .5rem; flex-wrap: wrap; }
  .ppe .ops button { border-radius: 9px; padding: .5rem .95rem; font-weight: 700; font-size: .8rem; }
  .ppe .b-preview { background: linear-gradient(180deg, #1f3557, #17273f); color: #cfe0ff; border-color: rgba(96,165,250,.38); width: 100%; }
  .ppe .b-preview:hover:not([disabled]) { background: linear-gradient(180deg, #27436e, #1c3050); }
  .ppe .b-staged { background: linear-gradient(180deg, #1f8f6b, #177557); color: #e8fff6; border-color: rgba(52,211,153,.5); }
  .ppe .b-staged:hover:not([disabled]) { background-color: #26a87e; border-color: rgba(52,211,153,.75); }
  .ppe .b-review { background-color: #26344f; color: var(--ink-2); border-color: rgba(148,163,184,.35); }
  .ppe .b-review:hover:not([disabled]) { background-color: #31425f; }
  .ppe .b-immediate { background: linear-gradient(135deg, var(--gold), var(--gold-2)); color: #2a1d02; border-color: rgba(245,196,81,.7); box-shadow: 0 8px 20px -10px rgba(245,196,81,.85); }
  .ppe .b-immediate:hover:not([disabled]) { background: linear-gradient(135deg, #ffd77a, #e5a929); border-color: rgba(245,196,81,.9); }
  .ppe .b-blocked { background-color: #2a1416; color: #fca5a5; border-color: rgba(248,113,113,.6); }
  .ppe .b-blocked:hover:not([disabled]) { background-color: #3a1a1d; border-color: rgba(248,113,113,.85); }
  .ppe .applied { font-size: .7rem; color: #6f819c; align-self: center; }
  .ppe .memo-input { width: 100%; padding: .5rem .65rem; font-size: .8rem; }

  /* ── プレビュー モーダル ──
     共通ヘッダ（z-index: 1000）より上。見出し・戻る・PHASE 切替は固定し、本文だけを内部スクロールさせる。 */
  .ppe .pv-backdrop { position: fixed; inset: 0; background: rgba(3,7,18,.78); display: flex; align-items: center; justify-content: center; padding: 2vh 1rem; z-index: 2010; overflow: hidden; }
  .ppe .pv-backdrop[hidden] { display: none; }
  .ppe .pv-modal { background: #0d1729; border: 1px solid rgba(148,163,184,.24); border-radius: 14px; width: min(780px, 100%); max-height: 96vh; padding: 1.1rem 1.2rem 1.2rem; display: flex; flex-direction: column; overflow: hidden; }
  .ppe .pv-head { display: flex; align-items: center; justify-content: space-between; gap: .8rem; flex: 0 0 auto; }
  .ppe .pv-head-l { display: flex; align-items: center; gap: .6rem; min-width: 0; }
  .ppe .pv-head h2 { font-size: 1rem; margin: 0; }
  .ppe .pv-notice { font-size: .74rem; color: #f5c451; background: rgba(245,196,81,.08); border: 1px solid rgba(245,196,81,.26); border-radius: 8px; padding: .45rem .7rem; margin: .6rem 0 .8rem; flex: 0 0 auto; }
  .ppe .pv-controls { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: .7rem; flex: 0 0 auto; }
  .ppe .pv-controls label { font-size: .76rem; color: #93a4bd; display: flex; align-items: center; gap: .4rem; }
  .ppe .pv-controls select { height: 30px; padding: 0 1.9rem 0 .6rem; font-size: .78rem; }
  /* 段階公開の切替はプレビューの主操作。ここを見落として「404 のまま」と誤読されるため強調する */
  .ppe .pv-controls .ctl-main { color: var(--gold); font-weight: 700; }
  .ppe .pv-controls .ctl-main select { border-color: rgba(245,196,81,.55); font-weight: 700; color: var(--ink); }
  .ppe .pv-hint { font-size: .76rem; line-height: 1.65; color: #cbd5e6; background: rgba(96,165,250,.08); border: 1px solid rgba(96,165,250,.28); border-radius: 8px; padding: .5rem .7rem; margin: 0 0 .8rem; flex: 0 0 auto; }
  .ppe .pv-hint[hidden] { display: none; }
  .ppe .pv-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .ppe .pv-body { display: grid; gap: .8rem; }
  .ppe .pv-top { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: .5rem; }
  .ppe .pv-top .cell { background: #111c33; border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .55rem .65rem; }
  .ppe .pv-top .k { font-size: .66rem; color: #93a4bd; }
  .ppe .pv-top .v { font-size: .92rem; font-weight: 800; margin-top: .12rem; }
  .ppe .pv-sec { border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .8rem .9rem; background: #111c33; }
  .ppe .pv-sec h3 { font-size: .74rem; color: #93a4bd; margin: 0 0 .5rem; font-weight: 700; }
  .ppe .pv-mock { border: 1px dashed rgba(148,163,184,.35); border-radius: 10px; padding: .9rem; text-align: center; }
  .ppe .pv-intake-t { font-size: .74rem; color: #93a4bd; }
  .ppe .pv-intake-s { font-size: 1rem; font-weight: 900; margin: .2rem 0; }
  .ppe .pv-intake-n { font-size: .7rem; color: #93a4bd; }
  .ppe .pv-price { margin: .7rem 0 .45rem; font-weight: 900; color: #f5c451; }
  .ppe .pv-cta { display: inline-block; border-radius: 10px; padding: .55rem 1.3rem; font-weight: 800; background: linear-gradient(135deg,#f5c451,#d99b1f); color: #2a1d02; }
  .ppe .pv-cta.off { opacity: .45; filter: grayscale(.6); }
  .ppe .pv-none { color: #93a4bd; font-size: .82rem; }
  .ppe .pv-vis { font-size: .8rem; line-height: 1.7; margin: .7rem 0 0; }
  .ppe .yes { color: #34d399; }
  .ppe .no { color: #f87171; }

  /* ── モバイル: テーブル → 1 顧客 1 コンパクトカード（横スクロールさせない）── */
  @media (max-width: 860px) {
    .ppe .ppe-head { flex-direction: column; gap: .8rem; }
    .ppe .ppe-head-r { width: 100%; }
    .ppe .toolbar input[type=search] { flex: 1 1 100%; }
    .ppe .tablewrap { background: transparent; border: 0; border-radius: 0; overflow: visible; }
    .ppe .tbl { display: block; width: 100%; }
    .ppe .tbl tbody { display: block; width: 100%; }
    .ppe .tbl tr { display: block; width: 100%; }
    .ppe .tbl td { display: block; width: 100%; }
    .ppe .tbl thead { display: none; }
    .ppe .tbl tbody tr { background: #111c33; border: 1px solid rgba(148,163,184,.16); border-radius: 11px; margin-bottom: .6rem; padding: .7rem .85rem; }
    .ppe .tbl tbody td { border: 0; padding: .15rem 0; }
    .ppe .tbl tbody td::before { content: attr(data-label) '　'; color: #93a4bd; font-size: .7rem; }
    .ppe .tbl tbody td.c-cust::before { content: ''; }
    .ppe .tbl tbody td.c-state::before { content: ''; }
    .ppe .tbl tbody td.c-ops::before { content: ''; }
    .ppe .tbl tbody td.c-eligible { display: none; }
    .ppe .tbl tbody td.c-updated { display: none; }
    .ppe .tbl tbody td.c-chk::before { content: ''; }
    .ppe .tbl tbody td.c-chk { width: 100%; text-align: left; margin-bottom: .3rem; }
    .ppe .tab { flex: 1 1 auto; padding: .55rem .5rem; }
    .ppe .selcount { margin-left: 0; width: 100%; }
    .ppe .prev-frame { height: 60vh; }
    .ppe .tbl tbody td.c-cust { font-weight: 700; margin-bottom: .2rem; }
    .ppe .tbl td.c-cust { max-width: 100%; }
    .ppe .em { max-width: 100%; }
    .ppe .tbl tbody td.c-ops { text-align: left; margin-top: .5rem; }
    .ppe .btn-detail { width: 100%; padding: .5rem; }
    /* パネル / モーダルは全画面。上部の「戻る」に必ず届くようにする */
    .ppe .dt-panel { width: 100%; border-left: 0; }
    .ppe .pv-backdrop { padding: 0; }
    .ppe .pv-modal { width: 100%; max-height: 100%; height: 100%; border: 0; border-radius: 0; padding: .85rem .9rem 1rem; }
    .ppe .pv-controls { gap: .55rem; }
    .ppe .pv-controls label { flex: 1 1 100%; justify-content: space-between; }
    .ppe .pv-controls select { flex: 0 1 62%; }
  }

  /* ═══ 操作順が分かる画面（Step 1〜6 / 2026-08-02）═══ */
  .ppe .stepbar { display: flex; flex-wrap: wrap; gap: .4rem; margin: .6rem 0 1rem; }
  .ppe .stepbar .stp { font-size: .74rem; padding: .22rem .6rem; border-radius: 999px;
    background: rgba(148,163,184,.10); color: var(--muted); border: 1px solid var(--line); white-space: nowrap; }
  .ppe .stepbar .stp.is-done { color: var(--green); border-color: rgba(52,211,153,.35); }
  .ppe .stepbar .stp.is-now { background: rgba(245,196,81,.16); color: var(--gold);
    border-color: rgba(245,196,81,.45); font-weight: 700; }
  .ppe .step { border-top: 1px solid var(--line); padding-top: .85rem; margin-top: 1.25rem; }
  .ppe .step-h { display: flex; align-items: center; gap: .5rem; font-size: .95rem; margin: 0 0 .55rem; color: var(--ink); }
  .ppe .step-n { display: inline-flex; align-items: center; justify-content: center; width: 1.45rem; height: 1.45rem;
    border-radius: 50%; background: rgba(245,196,81,.18); color: var(--gold); font-size: .76rem; font-weight: 700; flex: none; }
  .ppe .step-counts { margin-left: auto; font-size: .72rem; color: var(--muted); font-weight: 400; }
  .ppe .box-h { font-size: .88rem; margin: 0 0 .4rem; color: var(--ink); }

  .ppe .filter-more { margin: .4rem 0; }
  .ppe .filter-more > summary { cursor: pointer; font-size: .76rem; color: var(--muted); padding: .3rem 0; }
  .ppe .filter-actions { align-items: center; }
  .ppe .filter-count { font-size: .72rem; color: var(--muted); }
  .ppe .filter-count.is-on { color: var(--gold); font-weight: 700; }
  .ppe .btn-quiet { opacity: .6; }
  .ppe .btn-quiet:hover { opacity: 1; }

  /* 通知（内容別） */
  .ppe .notices { display: flex; flex-direction: column; gap: .35rem; margin: .5rem 0; }
  .ppe .notice { display: flex; align-items: flex-start; gap: .5rem; padding: .5rem .7rem; border-radius: .4rem;
    font-size: .78rem; border: 1px solid var(--line); background: rgba(148,163,184,.08); color: var(--ink); }
  .ppe .notice-ok { border-color: rgba(52,211,153,.4); color: var(--green); }
  .ppe .notice-warn { border-color: rgba(245,196,81,.4); color: var(--gold); }
  .ppe .notice-err { border-color: rgba(248,113,113,.45); color: var(--red); }
  .ppe .notice-info { border-color: rgba(148,163,184,.35); color: var(--ink); }
  .ppe .notice-d { font-weight: 400; color: var(--muted); }
  .ppe .notice-x { margin-left: auto; background: none; border: 0; cursor: pointer; font-size: 1rem;
    line-height: 1; color: var(--muted); }

  /* dry-run パネル */
  .ppe .dry-state { font-size: .74rem; color: var(--muted); }
  .ppe .dry-state.is-ok { color: var(--green); font-weight: 700; }
  .ppe .dry-state.is-stale { color: var(--gold); font-weight: 700; }
  .ppe .dry-panel { margin-top: .6rem; border: 1px solid var(--line); border-radius: .5rem;
    padding: .6rem .8rem; background: rgba(148,163,184,.06); }
  .ppe .dp-row { display: flex; gap: .6rem; padding: .18rem 0; font-size: .78rem; }
  .ppe .dp-k { flex: 0 0 9.5rem; color: var(--muted); }
  .ppe .dp-v { flex: 1; color: var(--ink); }
  .ppe .dp-row.is-ok .dp-v { color: var(--green); font-weight: 700; }
  .ppe .dp-row.is-ng .dp-v { color: var(--red); font-weight: 700; }
  .ppe .dp-ex { margin: .45rem 0; padding: .45rem .6rem; border: 1px dashed var(--line);
    border-radius: .4rem; font-size: .74rem; color: var(--muted); }
  .ppe .dp-ex ul { margin: .2rem 0 0 1rem; }

  /* キャンペーンカード */
  .ppe .camp-card { margin-top: .5rem; padding: .5rem .7rem; border: 1px solid var(--line);
    border-radius: .5rem; background: rgba(148,163,184,.06); }
  .ppe .camp-card.is-test { border-color: rgba(245,196,81,.45); }
  .ppe .camp-meta { font-size: .72rem; color: var(--muted); margin-top: .25rem; }
  .ppe .badge { display: inline-block; font-size: .68rem; padding: .1rem .45rem; border-radius: 999px; font-weight: 700; }
  .ppe .b-normal { background: rgba(96,165,250,.16); color: #93c5fd; }
  .ppe .b-test { background: rgba(245,196,81,.18); color: var(--gold); }
  .ppe .b-ok { background: rgba(52,211,153,.16); color: var(--green); }
  .ppe .b-warn { background: rgba(245,196,81,.18); color: var(--gold); }
  .ppe .b-ng { background: rgba(248,113,113,.18); color: var(--red); }
  .ppe .b-info { background: rgba(96,165,250,.16); color: #93c5fd; }
  .ppe .b-muted { background: rgba(148,163,184,.14); color: var(--muted); }

  /* 追従バー */
  .ppe .stickybar { position: sticky; bottom: 0; z-index: 20; display: flex; flex-wrap: wrap; align-items: center;
    gap: .6rem; margin-top: 1rem; padding: .55rem .8rem; background: #0b1526; color: var(--ink);
    border: 1px solid var(--line); border-radius: .5rem .5rem 0 0; font-size: .74rem; }
  .ppe .stickybar .sb-item { white-space: nowrap; color: var(--muted); }
  .ppe .stickybar #sbNext { margin-left: auto; }

  /* 顧客表のヘッダー追従 */
  .ppe .tablewrap { max-height: 60vh; overflow: auto; }
  .ppe .tbl thead th { position: sticky; top: 0; z-index: 2; background: #111c33; }
  .ppe .tbl tr.is-unsendable { opacity: .55; }

  @media (max-width: 1024px) {
    .ppe .dp-k { flex-basis: 7rem; }
    .ppe .stepbar .stp { font-size: .68rem; padding: .18rem .45rem; }
  }
  @media (max-width: 720px) {
    .ppe .step-h { flex-wrap: wrap; }
    .ppe .step-counts { margin-left: 0; width: 100%; }
    .ppe .dp-row { flex-direction: column; gap: .1rem; }
    .ppe .dp-k { flex-basis: auto; }
    .ppe .stickybar { font-size: .7rem; gap: .4rem; }
    .ppe .stickybar #sbNext { margin-left: 0; width: 100%; }
    .ppe .tablewrap { max-height: none; }
  }

  /* ═══ 一覧のコンパクト化（42 名を少ないスクロールで / 2026-08-02）═══ */
  .ppe .listbar { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin: .4rem 0; font-size: .74rem; color: var(--muted); }
  .ppe .listbar .spacer { flex: 1 1 auto; }
  .ppe .listbar .lb { display: inline-flex; align-items: center; gap: .25rem; }
  .ppe .listbar select { padding: .15rem .4rem; font-size: .74rem; }
  .ppe .list-sum { color: var(--ink); font-weight: 700; }
  .ppe .list-range { min-width: 9rem; text-align: center; }
  .ppe .listbar-bottom { justify-content: flex-start; border-top: 1px solid var(--line); padding-top: .4rem; }

  /* 行を詰めて 1 画面に多く出す */
  .ppe .tbl.is-compact td, .ppe .tbl.is-compact th { padding: .28rem .4rem; font-size: .76rem; line-height: 1.25; }
  .ppe .tbl.is-compact td.c-chk { width: 1.9rem; }
  .ppe .tbl.is-compact .c-cust { max-width: 15rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* 左端の選択列と顧客列は固定して横スクロールでも見失わない */
  .ppe .tbl.is-compact thead th.c-chk, .ppe .tbl.is-compact tbody td.c-chk { position: sticky; left: 0; z-index: 3; background: #111c33; }
  .ppe .tbl.is-compact thead th.c-cust, .ppe .tbl.is-compact tbody td.c-cust { position: sticky; left: 1.9rem; z-index: 3; background: #111c33; }
  .ppe .chk-danger { color: var(--red); font-weight: 700; }

  /* カムバックの対象区分 */
  .ppe .seg-row { display: flex; gap: .5rem; flex-wrap: wrap; margin: .3rem 0; }
  .ppe .seg { font-size: .72rem; padding: .1rem .45rem; border-radius: 999px; background: rgba(148,163,184,.14); color: var(--muted); }
  .ppe .seg.is-active-member { background: rgba(248,113,113,.18); color: var(--red); font-weight: 700; }

  @media (max-width: 900px) {
    /* 小画面は表をやめてコンパクトカードにする（主要 5 項目のみ） */
    .ppe .tbl.is-compact thead { display: none; }
    .ppe .tbl.is-compact tbody tr { display: grid; grid-template-columns: 1.6rem 1fr; gap: .1rem .4rem;
      border: 1px solid var(--line); border-radius: .4rem; padding: .35rem .5rem; margin-bottom: .35rem; }
    .ppe .tbl.is-compact tbody td { border: 0; padding: .1rem 0; }
    .ppe .tbl.is-compact tbody td.col-detail { display: none; }
    .ppe .tbl.is-compact thead th.c-chk, .ppe .tbl.is-compact tbody td.c-chk,
    .ppe .tbl.is-compact thead th.c-cust, .ppe .tbl.is-compact tbody td.c-cust { position: static; }
  }

  /* ═══ カムバック特典タブ: Step 表示（2026-08-02）═══ */
  .ppe .cb-lead { margin: .3rem 0 .8rem; }
  .ppe .cb-purpose { font-size: .86rem; color: var(--ink); margin: 0 0 .3rem; }
  .ppe .cb-safety { margin: 0; padding-left: 1.1rem; font-size: .76rem; color: var(--muted); }
  .ppe .cb-safety li { margin: .1rem 0; }
  .ppe .cb-step.is-locked { opacity: .45; }
  .ppe .cb-step.is-locked .step-n { background: rgba(148,163,184,.16); color: var(--muted); }
  .ppe .cb-step.is-now { border-top-color: rgba(245,196,81,.5); }
  .ppe .cb-step.is-done .step-n::after { content: " ✓"; }
  .ppe .cb-filter-desc { font-size: .78rem; color: var(--gold); margin: .35rem 0 0; }
  /* 「退会・課金停止」が配信停止と別物であることの常設説明 */
  .ppe .cb-seg-note {
    font-size: .74rem; color: #c8d4e6; line-height: 1.75; margin: .4rem 0 0;
    padding: .5rem .6rem; border-radius: 8px;
    background: rgba(255, 255, 255, .04); border-left: 3px solid var(--gold);
  }
  .ppe .cb-seg-note strong { color: #fff; }
  /* 選んだ特典が退会者へ配れるか（サーバー判定の表示） */
  .ppe .cb-withdrawn-avail {
    font-size: .74rem; line-height: 1.75; margin: .4rem 0 0;
    padding: .5rem .6rem; border-radius: 8px; white-space: pre-wrap;
    background: rgba(255, 255, 255, .04); border-left: 3px solid #4b5b73; color: #c8d4e6;
  }
  .ppe .cb-withdrawn-avail.ok { border-left-color: #3fa66a; }
  .ppe .cb-withdrawn-avail.warn { border-left-color: #d9a441; }
  .ppe .dp-note { font-size: .7rem; color: #93a4bd; line-height: 1.6; margin: .1rem 0 .35rem; }
  @media (max-width: 640px) {
    .ppe .cb-seg-note,
    .ppe .cb-withdrawn-avail { font-size: .72rem; padding: .45rem .5rem; }
  }
  .ppe .cb-offer-summary { font-size: .82rem; color: var(--ink); background: rgba(148,163,184,.08);
    border: 1px solid var(--line); border-radius: .4rem; padding: .4rem .6rem; margin: .3rem 0; }
  .ppe .opt-danger { color: var(--red); }
  .ppe .cb-tools { margin-top: 1rem; }
  .ppe .cb-row-locked { opacity: .55; }
  .ppe .cb-row-reason { font-size: .7rem; color: var(--red); }

  /* ═══════════════════════════════════════════════════════════════
     操作の意味を色で固定する（2026-08-02）
     暗い画面の中で「次に押すもの」「危ないもの」を一目で分ける。
     色だけに頼らず、アイコン・文言・枠でも区別する。
     ═══════════════════════════════════════════════════════════════ */
  .ppe {
    /* 役割ごとの色。直書きを増やさず、ここだけを見れば意味が分かる状態にする */
    --action-blue: #3b82f6;        /* 取得・再読み込み・詳細・戻る（通常操作）*/
    --action-blue-dk: #1d4ed8;
    --action-green: #10b981;       /* 安全に完了できる確定操作・成功 */
    --action-green-dk: #047857;
    --action-yellow: #f5c451;      /* 現在の段階・次の主要操作・確認待ち */
    --action-yellow-dk: #b7791f;
    --action-orange: #fb923c;      /* 実行前の強い注意・失効・危険設定 */
    --action-orange-dk: #c2410c;
    --action-red: #ef4444;         /* 本番データが変わる操作・不可逆・エラー */
    --action-red-dk: #b91c1c;
    --action-purple: #a78bfa;      /* 上位プラン・特典設定 */
    --action-purple-dk: #6d28d9;
    --surface-raised: #16233d;     /* カード（既定より一段明るい）*/
    --surface-active: #1c2c4c;     /* 現在の段階のカード */
    --text-main: #f1f5fb;
    --text-muted: #93a4bd;
    --border-soft: rgba(148,163,184,.22);
    --focus-ring: rgba(245,196,81,.75);
  }

  /* ── ボタンの階層 ─────────────────────────────────────────
     主要（btn-lg）は大きく明るく、補助は彩度を落とす。
     危険操作は赤系 + 警告アイコン + 通常操作から離して置く。 */
  .ppe .btn-lg {
    min-height: 50px; padding: 0 26px; font-size: 16px; font-weight: 700;
    border-radius: 11px; display: inline-flex; align-items: center; gap: .5rem;
  }
  .ppe .btn-md { min-height: 40px; padding: 0 16px; font-size: 14px; border-radius: 9px; }

  .ppe .btn-primary,
  .ppe .btn-blue { background-color: var(--action-blue-dk); border-color: var(--action-blue); color: var(--text-main); }
  .ppe .btn-primary:hover:not([disabled]),
  .ppe .btn-blue:hover:not([disabled]) { background-color: var(--action-blue); }

  .ppe .btn-success { background-color: var(--action-green-dk); border-color: var(--action-green); color: var(--text-main); }
  .ppe .btn-success:hover:not([disabled]) { background-color: var(--action-green); color: #06251b; }

  .ppe .btn-warning { background-color: var(--action-yellow-dk); border-color: var(--action-yellow); color: var(--text-main); }
  .ppe .btn-warning:hover:not([disabled]) { background-color: var(--action-yellow); color: #2a1e05; }

  .ppe .btn-caution { background-color: var(--action-orange-dk); border-color: var(--action-orange); color: var(--text-main); }
  .ppe .btn-caution:hover:not([disabled]) { background-color: var(--action-orange); color: #2b1206; }

  .ppe .btn-danger,
  .ppe .b-immediate { background-color: var(--action-red-dk); border-color: var(--action-red); color: var(--text-main); font-weight: 700; }
  .ppe .btn-danger:hover:not([disabled]),
  .ppe .b-immediate:hover:not([disabled]) { background-color: var(--action-red); }

  .ppe .btn-purple { background-color: var(--action-purple-dk); border-color: var(--action-purple); color: var(--text-main); }
  .ppe .btn-secondary { background-color: var(--surface-raised); border-color: var(--border-soft); color: var(--text-main); }

  /* 押せない理由が分かるようにする（色だけに頼らない）*/
  .ppe button[disabled] { cursor: not-allowed; filter: grayscale(.5); }
  .ppe button:focus-visible,
  .ppe select:focus-visible,
  .ppe input:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 2px; }

  /* ── Step ナビ（丸番号 + アイコン + 補足）───────────────── */
  .ppe .stepbar { gap: .5rem; }
  .ppe .stepbar .stp {
    display: flex; flex-direction: column; justify-content: center; gap: .1rem;
    min-height: 72px; min-width: 8.5rem; padding: .5rem .7rem; border-radius: 12px;
    background: rgba(148,163,184,.07); border: 1px solid var(--border-soft);
    color: var(--text-muted); font-size: 15px; opacity: .6;
  }
  .ppe .stepbar .stp .stp-n { font-size: 30px; font-weight: 700; line-height: 1; }
  .ppe .stepbar .stp .stp-sub { font-size: 11px; }
  .ppe .stepbar .stp.is-now {
    opacity: 1; background: var(--surface-active); color: var(--text-main);
    border-color: var(--action-yellow); box-shadow: inset 0 0 0 1px rgba(245,196,81,.35);
  }
  .ppe .stepbar .stp.is-now .stp-n { color: var(--action-yellow); }
  .ppe .stepbar .stp.is-done {
    opacity: 1; background: rgba(16,185,129,.10); color: var(--text-main); border-color: var(--action-green);
  }
  .ppe .stepbar .stp.is-done .stp-n { color: var(--action-green); }

  /* ── Step カード ───────────────────────────────────────── */
  .ppe .cb-step, .ppe .step { border-left: 5px solid transparent; padding-left: .8rem; border-radius: 0 10px 10px 0; }
  .ppe .cb-step.is-now, .ppe .step.is-now {
    border-left-color: var(--action-yellow); background: rgba(245,196,81,.05);
  }
  .ppe .cb-step.is-done { border-left-color: var(--action-green); }
  .ppe .cb-step.is-locked { border-left-color: var(--border-soft); opacity: .42; }
  /* Step 5 は「最終確認へ進む」段階であって本番 write ではないので赤にしない。
     赤は確認モーダルの付与ボタンだけに残す（赤いボタンを画面に複数置かない）。 */
  .ppe .cb-step[data-cbcard="5"].is-now { border-left-color: var(--action-yellow); background: rgba(234,179,8,.06); }
  .ppe .step-hint { font-size: .78rem; color: var(--action-yellow); margin: .1rem 0 .4rem; }
  .ppe .step-hint.is-locked { color: var(--text-muted); }
  .ppe .step-hint.is-danger { color: var(--action-red); font-weight: 700; }
  .ppe .step-done-badge { margin-left: auto; font-size: .72rem; color: var(--action-green); font-weight: 700; }

  /* ── 状態バッジ（区分・確認状態）──────────────────────── */
  .ppe .tag { display: inline-flex; align-items: center; gap: .2rem; font-size: .72rem;
    padding: .12rem .5rem; border-radius: 999px; border: 1px solid; font-weight: 700; }
  .ppe .tag-blue { color: #93c5fd; border-color: rgba(59,130,246,.5); background: rgba(59,130,246,.12); }
  .ppe .tag-green { color: #6ee7b7; border-color: rgba(16,185,129,.5); background: rgba(16,185,129,.12); }
  .ppe .tag-yellow { color: var(--action-yellow); border-color: rgba(245,196,81,.5); background: rgba(245,196,81,.12); }
  .ppe .tag-orange { color: #fdba74; border-color: rgba(251,146,60,.5); background: rgba(251,146,60,.12); }
  .ppe .tag-red { color: #fca5a5; border-color: rgba(239,68,68,.55); background: rgba(239,68,68,.14); }
  .ppe .tag-purple { color: #c4b5fd; border-color: rgba(167,139,250,.5); background: rgba(167,139,250,.12); }
  .ppe .tag-slate { color: var(--text-muted); border-color: var(--border-soft); background: rgba(148,163,184,.10); }

  /* ── 追従バー ─────────────────────────────────────────── */
  .ppe .stickybar {
    background: var(--surface-active); border-top: 3px solid var(--action-yellow);
    box-shadow: 0 -6px 18px rgba(2,6,23,.45); padding: .6rem .9rem; font-size: .8rem;
  }
  .ppe .stickybar .sb-item { color: var(--text-main); }
  .ppe .stickybar #cbSbNext, .ppe .stickybar #sbNext { min-height: 52px; font-size: 16px; font-weight: 700; padding: 0 22px; }

  /* ── 通知（5 種・アイコン + 左ボーダー）──────────────────── */
  .ppe .notice { border-left-width: 5px; font-size: .82rem; }
  .ppe .notice-ok { border-color: var(--action-green); background: rgba(16,185,129,.10); color: #a7f3d0; }
  .ppe .notice-info { border-color: var(--action-blue); background: rgba(59,130,246,.10); color: #bfdbfe; }
  .ppe .notice-warn { border-color: var(--action-yellow); background: rgba(245,196,81,.10); color: #fde68a; }
  .ppe .notice-caution { border-color: var(--action-orange); background: rgba(251,146,60,.12); color: #fed7aa; }
  .ppe .notice-err { border-color: var(--action-red); background: rgba(239,68,68,.12); color: #fecaca; }

  /* ── フォーム ─────────────────────────────────────────── */
  .ppe .cb-step select, .ppe .cb-step input[type=search], .ppe .cb-step input[type=number],
  .ppe .step select, .ppe .step input[type=search] { min-height: 44px; font-size: 14px; background-color: var(--nv-1); }
  .ppe .danger-setting { border: 1px solid var(--action-orange); border-radius: 10px; padding: .5rem .7rem;
    background: rgba(251,146,60,.07); }
