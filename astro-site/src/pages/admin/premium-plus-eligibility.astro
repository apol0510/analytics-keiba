<script is:inline>
  (() => {
    const API = '/.netlify/functions/premium-plus-eligibility';
    const $ = (id) => document.getElementById(id);
    const secretEl = $('secret');

    const saved = sessionStorage.getItem('pp-admin-secret');
    if (saved) secretEl.value = saved;
    secretEl.addEventListener('change', () => {
      sessionStorage.setItem('pp-admin-secret', secretEl.value);
      setConn(false);
    });

    function setConn(ok) {
      const el = $('connState');
      el.textContent = ok ? '● 管理API 接続済み' : '● 未接続';
      el.className = 'conn-pill' + (ok ? ' ok' : '');
      if (ok) $('connBody').hidden = true;
    }
    if (!saved) $('connBody').hidden = false;
    $('connToggle').addEventListener('click', () => { $('connBody').hidden = !$('connBody').hidden; });

    function msg(text, kind) {
      const el = $('message');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function call(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { msg('管理シークレットを入力してください', 'err'); $('connBody').hidden = false; return null; }
      const res = await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { msg(data.error || ('エラー: ' + res.status), 'err'); if (res.status === 403) setConn(false); return null; }
      setConn(true);
      return data;
    }

    // ── 状態の分類（表示・並び順・フィルター用。判定そのものは Function 側の単一源）──
    function classify(r) {
      if (r.eligibility === 'blocked') return { key: 'blocked', badge: 'blocked', short: '販売対象外', order: 4 };
      if (r.eligibility !== 'eligible') return { key: 'review', badge: 'review', short: '保留', order: 1 };
      if (r.overrideApplied) return { key: 'immediate', badge: 'immediate', short: '即時販売', order: 3 };
      if (r.phase === 4) return { key: 'sale', badge: 'sale', short: '販売中', order: 2 };
      return { key: 'staged', badge: 'staged', short: 'PHASE ' + r.phase, order: 2 };
    }
    const ROUTE_SHORT = { sanrenpuku: 'A', premium_30d: 'B', premium_admin: 'C', none: '—' };
    const ROUTE_LABEL = {
      sanrenpuku: 'A（三連複）', premium_30d: 'B（Premium 30日）',
      premium_admin: 'C（管理者指定）', none: '対象外',
    };

    // 販売CTA（UpsellTarget）。Function 側 upsellTarget.js の UPSELL_TARGET と対応。
    // ⚠️ 「何を売るか」の選択であり、販売資格（PremiumPlusEligibility）とは別概念。
    const UPSELL_LABEL = { auto: '自動', sanrenpuku: '三連複', plus: 'Plus', none: 'なし' };

    // 候補区分（表示専用。販売資格ではない）。Function 側 premiumPlusAdminAudience.js の PP_CANDIDATE と対応。
    const KIND_SHORT = {
      route_a: 'A 成立', route_b: 'B 成立',
      waiting_30d: '待機中', anchor_missing: '加入日なし',
      explicit: '設定済み', none: '—',
    };
    function kindShort(r) {
      const k = r.candidateKind || 'none';
      if (k === 'waiting_30d' && r.daysUntilRouteB != null) return '待機中 あと' + r.daysUntilRouteB + '日';
      return KIND_SHORT[k] || k;
    }
    const fmtDate = (v) => (v ? String(v).slice(0, 10) : '—');

    let lastData = null;

    function matches(r) {
      const st = classify(r).key;
      const fs = $('fState').value;
      if (fs === 'review' && st !== 'review') return false;
      if (fs === 'eligible' && !(st === 'staged' || st === 'sale')) return false;
      if (fs === 'immediate' && st !== 'immediate') return false;
      if (fs === 'blocked' && st !== 'blocked') return false;
      const fr = $('fRoute').value;
      if (fr !== 'all' && r.route !== fr) return false;
      const fk = $('fKind').value;
      if (fk !== 'all' && r.candidateKind !== fk) return false;
      const fu = $('fUpsell').value;
      if (fu !== 'all' && (r.upsellTarget || 'auto') !== fu) return false;
      const q = $('q').value.trim().toLowerCase();
      if (q && !String(r.email || '').toLowerCase().includes(q)) return false;
      return true;
    }

    function sortRows(rows) {
      return [...rows].sort((a, b) => {
        const d = classify(a).order - classify(b).order;
        if (d !== 0) return d;
        const ua = String(a.updatedAt || ''), ub = String(b.updatedAt || '');
        if (ua !== ub) return ub.localeCompare(ua);
        return String(a.email).localeCompare(String(b.email));
      });
    }

    // ── サマリーバー（クリックでフィルター）──
    function renderSummary(c) {
      const bar = $('summary');
      bar.innerHTML = '';
      const items = [
        ['即時販売', c.immediate, 'immediate', 'immediate'],
        ['販売可', c.eligible, 'eligible', 'eligible'],
        ['保留', c.review, 'review', 'review'],
        ['販売対象外', c.blocked, 'blocked', 'blocked'],
        ['候補', c.total, '', 'all'],
      ];
      items.forEach((item, i) => {
        const k = item[0], v = item[1], cls = item[2], filter = item[3];
        if (i > 0) { const sp = document.createElement('span'); sp.className = 'sep'; sp.textContent = '|'; bar.appendChild(sp); }
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 's ' + cls;
        b.title = k + 'で絞り込む';
        const kk = document.createElement('span'); kk.className = 'k'; kk.textContent = k;
        const vv = document.createElement('span'); vv.className = 'v'; vv.textContent = String(v == null ? 0 : v);
        b.appendChild(kk); b.appendChild(vv);
        b.addEventListener('click', () => { $('fState').value = filter; render(); });
        bar.appendChild(b);
      });
      $('summarySub').textContent = 'ROUTE A（三連複） ' + (c.routeA == null ? 0 : c.routeA)
        + '　/　ROUTE B（Premium 30日） ' + (c.routeB == null ? 0 : c.routeB)
        + '　/　ROUTE B 待機中 ' + (c.waiting30d == null ? 0 : c.waiting30d)
        + '　/　加入日データなし ' + (c.anchorMissing == null ? 0 : c.anchorMissing);
    }

    // ── 一覧（テーブル。write ボタンは置かない）──
    function td(cls, label, text, extraCls) {
      const e = document.createElement('td');
      e.className = cls;
      if (label) e.setAttribute('data-label', label);
      if (text !== undefined) {
        const s = document.createElement('span');
        if (extraCls) s.className = extraCls;
        s.textContent = text;
        e.appendChild(s);
      }
      return e;
    }

    function render() {
      if (!lastData) return;
      const data = lastData;
      renderSummary(data.counts || {});
      $('writeState').textContent = (data.writeEnabled
        ? '書き込み: 有効'
        : '書き込み: 無効（Airtable に Premium Plus フィールド未作成 / PREMIUM_PLUS_FIELDS_READY 未設定）。一覧は閲覧のみ。')
        + (data.overrideEnabled ? ' / 今すぐ販売可: 利用可' : ' / 今すぐ販売可: 無効（PREMIUM_PLUS_OVERRIDE_READY 未設定）');

      const rows = sortRows((data.rows || []).filter(matches));
      const tb = $('rows');
      tb.innerHTML = '';
      for (const r of rows) {
        const st = classify(r);
        const tr = document.createElement('tr');

        const c1 = td('c-cust', '', undefined);
        const em = document.createElement('span');
        em.className = 'em';
        em.textContent = r.email || '(メール未設定)';
        em.title = r.email || '';
        c1.appendChild(em);
        tr.appendChild(c1);

        const c2 = document.createElement('td');
        c2.className = 'c-state';
        const badge = document.createElement('span');
        badge.className = 'badge ' + st.badge;
        badge.textContent = st.short;
        badge.title = r.state || st.short;
        c2.appendChild(badge);
        tr.appendChild(c2);

        // プラン列: プラン名はそのまま。三連複保有者にはバッジを添える。
        // ⚠️ 「プラン=Premium + LifetimeSanrenpuku=true」は三連複購入者だが、
        //    プラン名だけでは分からない。旧形式（プラン=Premium Sanrenpuku）と
        //    同じバッジで見分けられるようにする（文言の正本は sanrenpukuDisplay.js）。
        const cP = document.createElement('td');
        cP.className = 'c-plan';
        cP.setAttribute('data-label', 'プラン');
        const pn = document.createElement('span');
        pn.textContent = r.plan || '—';
        if (!r.plan) pn.className = 'muted';
        cP.appendChild(pn);
        if (r.sanrenpukuBadge) {
          const sb = document.createElement('span');
          sb.className = 'srp-badge' + (r.sanrenpukuBasis === 'legacy_expired' ? ' off' : '');
          sb.textContent = r.sanrenpukuBadge;
          if (r.sanrenpukuNote) sb.title = r.sanrenpukuNote;
          cP.appendChild(sb);
        }
        tr.appendChild(cP);
        tr.appendChild(td('c-route', 'Route', ROUTE_SHORT[r.route] || r.route));

        // 区分（表示専用。route 未成立でレビュー対象に出している理由を明示する）
        const cK = document.createElement('td');
        cK.className = 'c-kind';
        cK.setAttribute('data-label', '区分');
        const kb = document.createElement('span');
        kb.className = 'kind ' + (r.candidateKind || '');
        kb.textContent = kindShort(r);
        if (r.candidateNote) kb.title = r.candidateNote;
        cK.appendChild(kb);
        tr.appendChild(cK);
        // 販売CTA（管理者が設定した値）と 実表示（顧客側で実際に見えるもの）を分けて出す
        tr.appendChild(td('c-upsell', '販売CTA', UPSELL_LABEL[r.upsellTarget] || '自動',
          (r.upsellTarget || 'auto') === 'auto' ? 'muted' : ''));
        const cD = document.createElement('td');
        cD.className = 'c-display';
        cD.setAttribute('data-label', '実表示');
        cD.textContent = r.upsellDisplay || '—';
        if (r.upsellReason) cD.title = r.upsellReason;
        if (!r.upsellDisplay || r.upsellDisplay === '表示なし') cD.classList.add('muted');
        tr.appendChild(cD);
        tr.appendChild(td('c-phase', 'PHASE', String(r.phase)));
        tr.appendChild(td('c-eligible', '販売許可日', fmtDate(r.eligibleAt), r.eligibleAt ? '' : 'muted'));
        tr.appendChild(td('c-updated', '最終更新', fmtDate(r.updatedAt), r.updatedAt ? '' : 'muted'));

        const c8 = document.createElement('td');
        c8.className = 'c-ops';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-detail';
        btn.textContent = '詳細・操作';
        btn.addEventListener('click', () => openDetail(r.recordId));
        c8.appendChild(btn);
        tr.appendChild(c8);

        tb.appendChild(tr);
      }
      $('count').textContent = '表示 ' + rows.length + ' 件 / 全 ' + (data.rows || []).length + ' 件';
      const emp = $('empty');
      emp.hidden = rows.length > 0;
      emp.textContent = (data.rows || []).length ? '条件に一致する会員はいません。' : '該当する候補はありません。';
      if (data.truncated) msg('件数が多いため一部のみ表示しています', 'err');
    }

    async function load() {
      msg('読み込み中…');
      const data = await call({ action: 'list', onlyReview: $('onlyReview').checked });
      if (data) { msg(''); lastData = data; render(); }
    }

    // ── 詳細・操作パネル（write はここだけ）──
    let dtRecordId = null;

    function kvRow(dl, k, v, cls) {
      const dt = document.createElement('dt'); dt.textContent = k;
      const dd = document.createElement('dd'); dd.textContent = String(v);
      if (cls) dd.className = cls;
      dl.appendChild(dt); dl.appendChild(dd);
    }

    function renderDetail() {
      const data = lastData;
      const r = (data && (data.rows || []).find((x) => x.recordId === dtRecordId)) || null;
      const body = $('dtBody');
      body.innerHTML = '';
      if (!r) { body.textContent = '対象が見つかりません。再読み込みしてください。'; return; }
      const st = classify(r);

      const head = document.createElement('div');
      const em = document.createElement('div'); em.className = 'dt-email'; em.textContent = r.email || '(メール未設定)';
      const b = document.createElement('span'); b.className = 'badge ' + st.badge; b.textContent = r.state || st.short;
      head.appendChild(em); head.appendChild(b);
      body.appendChild(head);

      const info = document.createElement('div'); info.className = 'dt-sec';
      const h1 = document.createElement('h3'); h1.textContent = '基本情報'; info.appendChild(h1);
      const dl = document.createElement('dl'); dl.className = 'kv';
      // 「プラン（会員ランク）」と「三連複（買い切りの entitlement）」は別概念なので
      // 必ず別項目として出す。三連複は保有の**根拠と寿命**まで日本語で示す。
      kvRow(dl, 'プラン', r.plan || '—');
      kvRow(dl, '三連複', r.sanrenpukuLabel || (r.hasSanrenpuku ? '保有' : 'なし'),
        r.hasSanrenpuku ? '' : 'muted');
      if (r.sanrenpukuNote) {
        const dt = document.createElement('dt'); dt.textContent = '';
        const dd = document.createElement('dd'); dd.className = 'srp-note';
        dd.textContent = r.sanrenpukuNote;
        dl.appendChild(dt); dl.appendChild(dd);
      }
      kvRow(dl, 'Route', ROUTE_LABEL[r.route] || r.route);
      kvRow(dl, '候補区分', r.candidateLabel || '—');
      kvRow(dl, 'PHASE', String(r.phase));
      // ⚠️ daysSincePremium == null を「未記録」と決め打ちしない。
      //    ROUTE A は判定対象外で常に null になる（PaidAt があっても）。
      //    文言の正本は upsellExplain.js の describeDaysSincePremium。
      kvRow(dl, 'Premium経過', r.daysSincePremiumText || '—',
        r.daysSincePremium == null ? 'muted' : '');
      kvRow(dl, '販売許可日', fmtDate(r.eligibleAt));
      kvRow(dl, '最終更新', fmtDate(r.updatedAt));
      info.appendChild(dl);
      // 一覧に出しても顧客側に出ない相手は、操作前にその理由を出す（空振りの操作をさせない）
      if (r.releaseBlockedBy && r.candidateNote) {
        const warn = document.createElement('p');
        warn.className = 'blocker';
        warn.textContent = '⚠️ ' + r.candidateNote;
        info.appendChild(warn);
      }
      if (r.reason) {
        const memo = document.createElement('div'); memo.className = 'memo-view';
        memo.textContent = '内部メモ: ' + r.reason;
        info.appendChild(memo);
      }
      body.appendChild(info);

      // ── 販売CTA（UpsellTarget）: 何を売る導線を見せるか ──────────────
      // ⚠️ 販売資格（下の「通常操作」）とは別概念。ここは「見せる商品の選択」だけ。
      const upSec = document.createElement('div'); upSec.className = 'dt-sec';
      const uh = document.createElement('h3'); uh.textContent = '販売CTA'; upSec.appendChild(uh);
      const uNote = document.createElement('p'); uNote.className = 'muted';
      uNote.style.margin = '0 0 8px'; uNote.style.fontSize = '0.82rem';
      uNote.textContent = '顧客に見せる販売導線を 1 つだけ選びます（会員権・販売資格は変わりません）。';
      upSec.appendChild(uNote);

      // 判断材料 → 自動判定 → 現在の設定 → 実表示 の順に並べる。
      // 「今なぜこの CTA が出ているのか」をこのブロックだけで読み切れるようにする。
      const uCur = document.createElement('dl'); uCur.className = 'kv';
      kvRow(uCur, '三連複保有', r.sanrenpukuLabel || (r.hasSanrenpuku ? '保有' : 'なし'));
      kvRow(uCur, 'ROUTE', r.routeLabel || ROUTE_LABEL[r.route] || r.route || '対象外');
      kvRow(uCur, 'Premium加入からの経過', r.daysSincePremiumText || '—',
        r.daysSincePremium == null ? 'muted' : '');
      kvRow(uCur, '自動判定CTA', r.upsellAutoChannelLabel || '—');
      kvRow(uCur, '自動判定の理由', r.upsellAutoReasonText || r.upsellReason || '—', 'muted');
      kvRow(uCur, '現在の設定', UPSELL_LABEL[r.upsellTarget] || r.upsellTarget || '自動');
      kvRow(uCur, '顧客に表示されるCTA', r.upsellChannelLabel || '—');
      kvRow(uCur, '実表示', r.upsellDisplay || '—');
      kvRow(uCur, '実表示の理由', r.upsellReasonText || r.upsellReason || '—', 'muted');
      upSec.appendChild(uCur);

      // 手動指定が自動判定と違う結果になっているときだけ、その旨を明示する
      if (r.upsellIsManual && r.upsellDiffersFromAuto) {
        const d = document.createElement('p');
        d.className = 'blocker';
        d.textContent = 'ℹ️ 手動指定により、自動判定（' + (r.upsellAutoChannelLabel || '—')
          + '）とは異なる CTA（' + (r.upsellChannelLabel || '—') + '）を表示しています。';
        upSec.appendChild(d);
      }

      // 「自動」を選んだときに何が起きるかを常設で明示する（正本は upsellExplain.js）
      const rules = (lastData && lastData.upsellAutoRules) || [];
      if (rules.length) {
        const rd = document.createElement('details');
        rd.className = 'auto-rules';
        const rs = document.createElement('summary');
        rs.textContent = '「自動」の判定ルール';
        rd.appendChild(rs);
        const ul = document.createElement('ul');
        for (const line of rules) {
          const li = document.createElement('li');
          li.textContent = line;
          ul.appendChild(li);
        }
        rd.appendChild(ul);
        upSec.appendChild(rd);
      }

      const uOps = document.createElement('div'); uOps.className = 'ops';
      const uRadioName = 'upsell-' + r.recordId;
      const uButtons = [];
      for (const [value, label] of Object.entries(UPSELL_LABEL)) {
        const lab = document.createElement('label');
        lab.style.cssText = 'display:inline-flex;align-items:center;gap:6px;margin-right:14px;font-size:0.9rem;';
        const radio = document.createElement('input');
        radio.type = 'radio';
        radio.name = uRadioName;
        radio.value = value;
        radio.checked = (r.upsellTarget || 'auto') === value;
        radio.disabled = !data.upsellEnabled;
        // 三連複保有済みに「三連複」を選ばせない（再購入 CTA は出さない仕様）
        if (value === 'sanrenpuku' && r.hasSanrenpuku) {
          radio.disabled = true;
          lab.title = 'この会員は三連複を保有済みのため選べません';
        }
        radio.addEventListener('change', async () => {
          if (!radio.checked) return;
          uButtons.forEach((x) => { x.disabled = true; });
          msg('販売CTA を更新中…');
          const out = await call({ action: 'setUpsell', recordId: r.recordId, upsellTarget: value });
          if (out) {
            msg('販売CTA を「' + (out.upsellTargetLabel || value) + '」に設定しました'
              + (out.warning ? ' / ⚠️ ' + out.warning : ''), out.warning ? '' : 'ok');
            await load();
          }
          renderDetail();
        });
        uButtons.push(radio);
        lab.appendChild(radio);
        lab.appendChild(document.createTextNode(label));
        uOps.appendChild(lab);
      }
      upSec.appendChild(uOps);
      if (!data.upsellEnabled) {
        const w = document.createElement('p'); w.className = 'blocker';
        w.textContent = '⚠️ 販売CTA の変更は無効です（Airtable に UpsellTarget を作成し UPSELL_TARGET_FIELD_READY=1 を設定してください）。表示は「自動」として動作します。';
        upSec.appendChild(w);
      }
      body.appendChild(upSec);

      const pvSec = document.createElement('div'); pvSec.className = 'dt-sec';
      const h2 = document.createElement('h3'); h2.textContent = '表示確認'; pvSec.appendChild(h2);
      const pvBtn = document.createElement('button');
      pvBtn.type = 'button'; pvBtn.className = 'b-preview'; pvBtn.textContent = '表示プレビュー';
      pvBtn.addEventListener('click', () => openPreview(r.recordId));
      const ops0 = document.createElement('div'); ops0.className = 'ops'; ops0.appendChild(pvBtn);
      pvSec.appendChild(ops0);
      body.appendChild(pvSec);

      // メモ入力（write payload の reason に載せる）
      const memoInput = document.createElement('input');
      memoInput.className = 'memo-input';
      memoInput.placeholder = '内部メモ（管理者のみ・任意）';
      memoInput.value = r.reason || '';

      const buttons = [];
      const mkBtn = (plusAction, label, cls, isCurrent, extraDisabled) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = cls;
        btn.textContent = label;
        btn.dataset.action = plusAction;
        btn.disabled = !data.writeEnabled || isCurrent || !!extraDisabled;
        if (isCurrent) btn.title = '現在この状態です（適用中）';
        btn.addEventListener('click', async () => {
          if (btn.dataset.busy === '1') return; // 二重クリック防止
          if (plusAction === 'immediate') {
            const ok = window.confirm(
              'この会員は即時PHASE 4となり、価格と購入CTAが表示されます。\n\n'
              + '段階公開（PHASE 1→4）を飛ばして、いますぐ販売可能な状態にします。\n'
              + '実行してよろしいですか？'
            );
            if (!ok) return;
          }
          btn.dataset.busy = '1';
          buttons.forEach((x) => { x.disabled = true; });
          msg('更新中…');
          const out = await call({ action: 'update', recordId: r.recordId, plusAction, reason: memoInput.value });
          btn.dataset.busy = '';
          if (out) {
            msg('更新しました: ' + out.label + (out.override === 'phase4' ? '（即時販売）' : ''), 'ok');
            await load();
          }
          renderDetail(); // パネルを最新状態で再構成
        });
        buttons.push(btn);
        return btn;
      };

      const isImmediate = st.key === 'immediate';
      const isStagedNow = r.eligibility === 'eligible' && !r.overrideApplied;

      const secN = document.createElement('div'); secN.className = 'dt-sec';
      const h3 = document.createElement('h3'); h3.textContent = '通常操作'; secN.appendChild(h3);
      // ⚠️ 「販売可にした＝すぐ買える」ではない。待機日数が残ることを操作前に明示する
      const noteN = document.createElement('p'); noteN.className = 'imp-meta';
      noteN.textContent = '段階公開で販売可: 販売資格を与えます。価格と購入CTAは段階公開'
        + '（PHASE 1→4）の待機日数が経過してから表示されます。今日は買えません。';
      secN.appendChild(noteN);
      const opsN = document.createElement('div'); opsN.className = 'ops';
      opsN.appendChild(mkBtn('staged', '段階公開で販売可（CTAは待機後）', 'b-staged', isStagedNow));
      opsN.appendChild(mkBtn('review', '保留', 'b-review', r.eligibility === 'review'));
      if (isStagedNow) { const s = document.createElement('span'); s.className = 'applied'; s.textContent = '適用中'; opsN.appendChild(s); }
      secN.appendChild(opsN);
      body.appendChild(secN);

