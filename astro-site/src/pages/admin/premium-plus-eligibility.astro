<script is:inline>
  (() => {
    const API = '/.netlify/functions/premium-plus-eligibility';
    const $ = (id) => document.getElementById(id);
    const secretEl = $('secret');

    const saved = sessionStorage.getItem('pp-admin-secret');
    if (saved) secretEl.value = saved;
    secretEl.addEventListener('change', () => {
      sessionStorage.setItem('pp-admin-secret', secretEl.value);
      setConn(false);
    });

    function setConn(ok) {
      const el = $('connState');
      el.textContent = ok ? '● 管理API 接続済み' : '● 未接続';
      el.className = 'conn-pill' + (ok ? ' ok' : '');
      if (ok) $('connBody').hidden = true;
    }
    if (!saved) $('connBody').hidden = false;
    $('connToggle').addEventListener('click', () => { $('connBody').hidden = !$('connBody').hidden; });

    function msg(text, kind) {
      const el = $('message');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function call(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { msg('管理シークレットを入力してください', 'err'); $('connBody').hidden = false; return null; }
      const res = await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { msg(data.error || ('エラー: ' + res.status), 'err'); if (res.status === 403) setConn(false); return null; }
      setConn(true);
      return data;
    }

    // ── 状態の分類（表示・並び順・フィルター用。判定そのものは Function 側の単一源）──
    function classify(r) {
      if (r.eligibility === 'blocked') return { key: 'blocked', badge: 'blocked', short: '販売対象外', order: 4 };
      if (r.eligibility !== 'eligible') return { key: 'review', badge: 'review', short: '保留', order: 1 };
      if (r.overrideApplied) return { key: 'immediate', badge: 'immediate', short: '即時販売', order: 3 };
      if (r.phase === 4) return { key: 'sale', badge: 'sale', short: '販売中', order: 2 };
      return { key: 'staged', badge: 'staged', short: 'PHASE ' + r.phase, order: 2 };
    }
    const ROUTE_SHORT = { sanrenpuku: 'A', premium_30d: 'B', premium_admin: 'C', none: '—' };
    const ROUTE_LABEL = {
      sanrenpuku: 'A（三連複）', premium_30d: 'B（Premium 30日）',
      premium_admin: 'C（管理者指定）', none: '対象外',
    };

    // 販売CTA（UpsellTarget）。Function 側 upsellTarget.js の UPSELL_TARGET と対応。
    // ⚠️ 「何を売るか」の選択であり、販売資格（PremiumPlusEligibility）とは別概念。
    const UPSELL_LABEL = { auto: '自動', sanrenpuku: '三連複', plus: 'Plus', none: 'なし' };

    // 候補区分（表示専用。販売資格ではない）。Function 側 premiumPlusAdminAudience.js の PP_CANDIDATE と対応。
    const KIND_SHORT = {
      route_a: 'A 成立', route_b: 'B 成立',
      waiting_30d: '待機中', anchor_missing: '加入日なし',
      explicit: '設定済み', none: '—',
    };
    function kindShort(r) {
      const k = r.candidateKind || 'none';
      if (k === 'waiting_30d' && r.daysUntilRouteB != null) return '待機中 あと' + r.daysUntilRouteB + '日';
      return KIND_SHORT[k] || k;
    }
    const fmtDate = (v) => (v ? String(v).slice(0, 10) : '—');

    let lastData = null;

    function matches(r) {
      const st = classify(r).key;
      const fs = $('fState').value;
      if (fs === 'review' && st !== 'review') return false;
      if (fs === 'eligible' && !(st === 'staged' || st === 'sale')) return false;
      if (fs === 'immediate' && st !== 'immediate') return false;
      if (fs === 'blocked' && st !== 'blocked') return false;
      const fr = $('fRoute').value;
      if (fr !== 'all' && r.route !== fr) return false;
      const fk = $('fKind').value;
      if (fk !== 'all' && r.candidateKind !== fk) return false;
      const fu = $('fUpsell').value;
      if (fu !== 'all' && (r.upsellTarget || 'auto') !== fu) return false;
      const q = $('q').value.trim().toLowerCase();
      if (q && !String(r.email || '').toLowerCase().includes(q)) return false;
      return true;
    }

    function sortRows(rows) {
      return [...rows].sort((a, b) => {
        const d = classify(a).order - classify(b).order;
        if (d !== 0) return d;
        const ua = String(a.updatedAt || ''), ub = String(b.updatedAt || '');
        if (ua !== ub) return ub.localeCompare(ua);
        return String(a.email).localeCompare(String(b.email));
      });
    }

    // ── サマリーバー（クリックでフィルター）──
    function renderSummary(c) {
      const bar = $('summary');
      bar.innerHTML = '';
      const items = [
        ['即時販売', c.immediate, 'immediate', 'immediate'],
        ['販売可', c.eligible, 'eligible', 'eligible'],
        ['保留', c.review, 'review', 'review'],
        ['販売対象外', c.blocked, 'blocked', 'blocked'],
        ['候補', c.total, '', 'all'],
      ];
      items.forEach((item, i) => {
        const k = item[0], v = item[1], cls = item[2], filter = item[3];
        if (i > 0) { const sp = document.createElement('span'); sp.className = 'sep'; sp.textContent = '|'; bar.appendChild(sp); }
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 's ' + cls;
        b.title = k + 'で絞り込む';
        const kk = document.createElement('span'); kk.className = 'k'; kk.textContent = k;
        const vv = document.createElement('span'); vv.className = 'v'; vv.textContent = String(v == null ? 0 : v);
        b.appendChild(kk); b.appendChild(vv);
        b.addEventListener('click', () => { $('fState').value = filter; render(); });
        bar.appendChild(b);
      });
      $('summarySub').textContent = 'ROUTE A（三連複） ' + (c.routeA == null ? 0 : c.routeA)
        + '　/　ROUTE B（Premium 30日） ' + (c.routeB == null ? 0 : c.routeB)
        + '　/　ROUTE B 待機中 ' + (c.waiting30d == null ? 0 : c.waiting30d)
        + '　/　加入日データなし ' + (c.anchorMissing == null ? 0 : c.anchorMissing);
    }

    // ── 一覧（テーブル。write ボタンは置かない）──
    function td(cls, label, text, extraCls) {
      const e = document.createElement('td');
      e.className = cls;
      if (label) e.setAttribute('data-label', label);
      if (text !== undefined) {
        const s = document.createElement('span');
        if (extraCls) s.className = extraCls;
        s.textContent = text;
        e.appendChild(s);
      }
      return e;
    }

    function render() {
      if (!lastData) return;
      const data = lastData;
      renderSummary(data.counts || {});
      $('writeState').textContent = (data.writeEnabled
        ? '書き込み: 有効'
        : '書き込み: 無効（Airtable に Premium Plus フィールド未作成 / PREMIUM_PLUS_FIELDS_READY 未設定）。一覧は閲覧のみ。')
        + (data.overrideEnabled ? ' / 今すぐ販売可: 利用可' : ' / 今すぐ販売可: 無効（PREMIUM_PLUS_OVERRIDE_READY 未設定）');

      const rows = sortRows((data.rows || []).filter(matches));
      const tb = $('rows');
      tb.innerHTML = '';
      for (const r of rows) {
        const st = classify(r);
        const tr = document.createElement('tr');

        const c1 = td('c-cust', '', undefined);
        const em = document.createElement('span');
        em.className = 'em';
        em.textContent = r.email || '(メール未設定)';
        em.title = r.email || '';
        c1.appendChild(em);
        tr.appendChild(c1);

        const c2 = document.createElement('td');
        c2.className = 'c-state';
        const badge = document.createElement('span');
        badge.className = 'badge ' + st.badge;
        badge.textContent = st.short;
        badge.title = r.state || st.short;
        c2.appendChild(badge);
        tr.appendChild(c2);

        tr.appendChild(td('c-plan', 'プラン', r.plan || '—', r.plan ? '' : 'muted'));
        tr.appendChild(td('c-route', 'Route', ROUTE_SHORT[r.route] || r.route));

        // 区分（表示専用。route 未成立でレビュー対象に出している理由を明示する）
        const cK = document.createElement('td');
        cK.className = 'c-kind';
        cK.setAttribute('data-label', '区分');
        const kb = document.createElement('span');
        kb.className = 'kind ' + (r.candidateKind || '');
        kb.textContent = kindShort(r);
        if (r.candidateNote) kb.title = r.candidateNote;
        cK.appendChild(kb);
        tr.appendChild(cK);
        // 販売CTA（管理者が設定した値）と 実表示（顧客側で実際に見えるもの）を分けて出す
        tr.appendChild(td('c-upsell', '販売CTA', UPSELL_LABEL[r.upsellTarget] || '自動',
          (r.upsellTarget || 'auto') === 'auto' ? 'muted' : ''));
        const cD = document.createElement('td');
        cD.className = 'c-display';
        cD.setAttribute('data-label', '実表示');
        cD.textContent = r.upsellDisplay || '—';
        if (r.upsellReason) cD.title = r.upsellReason;
        if (!r.upsellDisplay || r.upsellDisplay === '表示なし') cD.classList.add('muted');
        tr.appendChild(cD);
        tr.appendChild(td('c-phase', 'PHASE', String(r.phase)));
        tr.appendChild(td('c-eligible', '販売許可日', fmtDate(r.eligibleAt), r.eligibleAt ? '' : 'muted'));
        tr.appendChild(td('c-updated', '最終更新', fmtDate(r.updatedAt), r.updatedAt ? '' : 'muted'));

        const c8 = document.createElement('td');
        c8.className = 'c-ops';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-detail';
        btn.textContent = '詳細・操作';
        btn.addEventListener('click', () => openDetail(r.recordId));
        c8.appendChild(btn);
        tr.appendChild(c8);

        tb.appendChild(tr);
      }
      $('count').textContent = '表示 ' + rows.length + ' 件 / 全 ' + (data.rows || []).length + ' 件';
      const emp = $('empty');
      emp.hidden = rows.length > 0;
      emp.textContent = (data.rows || []).length ? '条件に一致する会員はいません。' : '該当する候補はありません。';
      if (data.truncated) msg('件数が多いため一部のみ表示しています', 'err');
    }

    async function load() {
      msg('読み込み中…');
      const data = await call({ action: 'list', onlyReview: $('onlyReview').checked });
      if (data) { msg(''); lastData = data; render(); }
    }

    // ── 詳細・操作パネル（write はここだけ）──
    let dtRecordId = null;

    function kvRow(dl, k, v, cls) {
      const dt = document.createElement('dt'); dt.textContent = k;
      const dd = document.createElement('dd'); dd.textContent = String(v);
      if (cls) dd.className = cls;
      dl.appendChild(dt); dl.appendChild(dd);
    }

    function renderDetail() {
      const data = lastData;
      const r = (data && (data.rows || []).find((x) => x.recordId === dtRecordId)) || null;
      const body = $('dtBody');
      body.innerHTML = '';
      if (!r) { body.textContent = '対象が見つかりません。再読み込みしてください。'; return; }
      const st = classify(r);

      const head = document.createElement('div');
      const em = document.createElement('div'); em.className = 'dt-email'; em.textContent = r.email || '(メール未設定)';
      const b = document.createElement('span'); b.className = 'badge ' + st.badge; b.textContent = r.state || st.short;
      head.appendChild(em); head.appendChild(b);
      body.appendChild(head);

      const info = document.createElement('div'); info.className = 'dt-sec';
      const h1 = document.createElement('h3'); h1.textContent = '基本情報'; info.appendChild(h1);
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, 'プラン', r.plan || '—');
      kvRow(dl, '三連複', r.hasSanrenpuku ? 'あり' : 'なし');
      kvRow(dl, 'Route', ROUTE_LABEL[r.route] || r.route);
      kvRow(dl, '候補区分', r.candidateLabel || '—');
      kvRow(dl, 'PHASE', String(r.phase));
      kvRow(dl, 'Premium経過', r.daysSincePremium == null ? '加入日（PaidAt）未記録' : r.daysSincePremium + ' 日',
        r.daysSincePremium == null ? 'muted' : '');
      kvRow(dl, '販売許可日', fmtDate(r.eligibleAt));
      kvRow(dl, '最終更新', fmtDate(r.updatedAt));
      info.appendChild(dl);
      // 一覧に出しても顧客側に出ない相手は、操作前にその理由を出す（空振りの操作をさせない）
      if (r.releaseBlockedBy && r.candidateNote) {
        const warn = document.createElement('p');
        warn.className = 'blocker';
        warn.textContent = '⚠️ ' + r.candidateNote;
        info.appendChild(warn);
      }
      if (r.reason) {
        const memo = document.createElement('div'); memo.className = 'memo-view';
        memo.textContent = '内部メモ: ' + r.reason;
        info.appendChild(memo);
      }
      body.appendChild(info);

      // ── 販売CTA（UpsellTarget）: 何を売る導線を見せるか ──────────────
      // ⚠️ 販売資格（下の「通常操作」）とは別概念。ここは「見せる商品の選択」だけ。
      const upSec = document.createElement('div'); upSec.className = 'dt-sec';
      const uh = document.createElement('h3'); uh.textContent = '販売CTA'; upSec.appendChild(uh);
      const uNote = document.createElement('p'); uNote.className = 'muted';
      uNote.style.margin = '0 0 8px'; uNote.style.fontSize = '0.82rem';
      uNote.textContent = '顧客に見せる販売導線を 1 つだけ選びます（会員権・販売資格は変わりません）。';
      upSec.appendChild(uNote);

      const uCur = document.createElement('dl'); uCur.className = 'kv';
      kvRow(uCur, '現在の設定', UPSELL_LABEL[r.upsellTarget] || r.upsellTarget || '自動');
      kvRow(uCur, '実表示', r.upsellDisplay || '—');
      kvRow(uCur, '理由', r.upsellReason || '—', 'muted');
      upSec.appendChild(uCur);

      const uOps = document.createElement('div'); uOps.className = 'ops';
      const uRadioName = 'upsell-' + r.recordId;
      const uButtons = [];
      for (const [value, label] of Object.entries(UPSELL_LABEL)) {
        const lab = document.createElement('label');
        lab.style.cssText = 'display:inline-flex;align-items:center;gap:6px;margin-right:14px;font-size:0.9rem;';
        const radio = document.createElement('input');
        radio.type = 'radio';
        radio.name = uRadioName;
        radio.value = value;
        radio.checked = (r.upsellTarget || 'auto') === value;
        radio.disabled = !data.upsellEnabled;
        // 三連複保有済みに「三連複」を選ばせない（再購入 CTA は出さない仕様）
        if (value === 'sanrenpuku' && r.hasSanrenpuku) {
          radio.disabled = true;
          lab.title = 'この会員は三連複を保有済みのため選べません';
        }
        radio.addEventListener('change', async () => {
          if (!radio.checked) return;
          uButtons.forEach((x) => { x.disabled = true; });
          msg('販売CTA を更新中…');
          const out = await call({ action: 'setUpsell', recordId: r.recordId, upsellTarget: value });
          if (out) {
            msg('販売CTA を「' + (out.upsellTargetLabel || value) + '」に設定しました'
              + (out.warning ? ' / ⚠️ ' + out.warning : ''), out.warning ? '' : 'ok');
            await load();
          }
          renderDetail();
        });
        uButtons.push(radio);
        lab.appendChild(radio);
        lab.appendChild(document.createTextNode(label));
        uOps.appendChild(lab);
      }
      upSec.appendChild(uOps);
      if (!data.upsellEnabled) {
        const w = document.createElement('p'); w.className = 'blocker';
        w.textContent = '⚠️ 販売CTA の変更は無効です（Airtable に UpsellTarget を作成し UPSELL_TARGET_FIELD_READY=1 を設定してください）。表示は「自動」として動作します。';
        upSec.appendChild(w);
      }
      body.appendChild(upSec);

      const pvSec = document.createElement('div'); pvSec.className = 'dt-sec';
      const h2 = document.createElement('h3'); h2.textContent = '表示確認'; pvSec.appendChild(h2);
      const pvBtn = document.createElement('button');
      pvBtn.type = 'button'; pvBtn.className = 'b-preview'; pvBtn.textContent = '表示プレビュー';
      pvBtn.addEventListener('click', () => openPreview(r.recordId));
      const ops0 = document.createElement('div'); ops0.className = 'ops'; ops0.appendChild(pvBtn);
      pvSec.appendChild(ops0);
      body.appendChild(pvSec);

      // メモ入力（write payload の reason に載せる）
      const memoInput = document.createElement('input');
      memoInput.className = 'memo-input';
      memoInput.placeholder = '内部メモ（管理者のみ・任意）';
      memoInput.value = r.reason || '';

      const buttons = [];
      const mkBtn = (plusAction, label, cls, isCurrent, extraDisabled) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = cls;
        btn.textContent = label;
        btn.dataset.action = plusAction;
        btn.disabled = !data.writeEnabled || isCurrent || !!extraDisabled;
        if (isCurrent) btn.title = '現在この状態です（適用中）';
        btn.addEventListener('click', async () => {
          if (btn.dataset.busy === '1') return; // 二重クリック防止
          if (plusAction === 'immediate') {
            const ok = window.confirm(
              'この会員は即時PHASE 4となり、価格と購入CTAが表示されます。\n\n'
              + '段階公開（PHASE 1→4）を飛ばして、いますぐ販売可能な状態にします。\n'
              + '実行してよろしいですか？'
            );
            if (!ok) return;
          }
          btn.dataset.busy = '1';
          buttons.forEach((x) => { x.disabled = true; });
          msg('更新中…');
          const out = await call({ action: 'update', recordId: r.recordId, plusAction, reason: memoInput.value });
          btn.dataset.busy = '';
          if (out) {
            msg('更新しました: ' + out.label + (out.override === 'phase4' ? '（即時販売）' : ''), 'ok');
            await load();
          }
          renderDetail(); // パネルを最新状態で再構成
        });
        buttons.push(btn);
        return btn;
      };

      const isImmediate = st.key === 'immediate';
      const isStagedNow = r.eligibility === 'eligible' && !r.overrideApplied;

      const secN = document.createElement('div'); secN.className = 'dt-sec';
      const h3 = document.createElement('h3'); h3.textContent = '通常操作'; secN.appendChild(h3);
      const opsN = document.createElement('div'); opsN.className = 'ops';
      opsN.appendChild(mkBtn('staged', '段階公開で販売可', 'b-staged', isStagedNow));
      opsN.appendChild(mkBtn('review', '保留', 'b-review', r.eligibility === 'review'));
      if (isStagedNow) { const s = document.createElement('span'); s.className = 'applied'; s.textContent = '適用中'; opsN.appendChild(s); }
      secN.appendChild(opsN);
      body.appendChild(secN);

      const secD = document.createElement('div'); secD.className = 'dt-sec danger';
      const h4 = document.createElement('h3'); h4.textContent = '強い操作（本番の販売状態が変わります）'; secD.appendChild(h4);
      const opsD = document.createElement('div'); opsD.className = 'ops';
      opsD.appendChild(mkBtn('immediate', '今すぐ販売可', 'b-immediate', isImmediate, !data.overrideEnabled));
      opsD.appendChild(mkBtn('blocked', '販売対象外', 'b-blocked', r.eligibility === 'blocked'));
      if (isImmediate) { const s = document.createElement('span'); s.className = 'applied'; s.textContent = '適用中'; opsD.appendChild(s); }
      secD.appendChild(opsD);
      body.appendChild(secD);

      const secM = document.createElement('div'); secM.className = 'dt-sec';
      const h5 = document.createElement('h3'); h5.textContent = '内部メモ'; secM.appendChild(h5);
      secM.appendChild(memoInput);
      body.appendChild(secM);
    }

    // オーバーレイ表示中は背面の一覧をスクロールさせない（閉じたら必ず元に戻す）
    function lockScroll() { document.body.style.overflow = 'hidden'; }
    function unlockScroll() { document.body.style.overflow = ''; }

    function openDetail(recordId) {
      dtRecordId = recordId;
      $('dtBackdrop').hidden = false;
      lockScroll();
      renderDetail();
      $('dtPanel').scrollTop = 0;
    }
    function closeDetail() {
      $('dtBackdrop').hidden = true;
      dtRecordId = null;
      if ($('pvBackdrop').hidden) unlockScroll();
    }
    $('dtClose').addEventListener('click', closeDetail);
    $('dtBack').addEventListener('click', closeDetail);
    $('dtBackdrop').addEventListener('click', (e) => { if (e.target === $('dtBackdrop')) closeDetail(); });

    // ── 管理者プレビュー（read-only）──
    let pvRecordId = null;
    let pvOptionsReady = false;

    function fillOptions(sel, items, valueKey, current) {
      if (sel.options.length) return;
      for (const it of items) {
        const o = document.createElement('option');
        o.value = it[valueKey] === null ? '' : String(it[valueKey]);
        o.textContent = it.label;
        sel.appendChild(o);
      }
      sel.value = current == null ? '' : current;
    }
    const yn = (b) => (b ? 'はい' : 'いいえ');
    const ynCls = (b) => (b ? 'yes' : 'no');

    // 「404 のまま」を誤読させないための説明。何を操作すれば表示されるかまで書く
    function renderPreviewHint(p) {
      const hint = $('pvHint');
      let text = '';
      if (!p.showProductPage) {
        if (p.eligibility !== 'eligible') {
          const label = p.eligibility === 'blocked' ? '販売対象外' : '保留';
          text = 'この会員は「' + label + '」のため、PHASE を切り替えても商品ページは表示されません。'
            + '先に詳細パネルで「段階公開で販売可」にする必要があります（PHASE の切替はプレビュー内だけの確認で、実データは変わりません）。';
        } else if (p.simulated.phaseDaysAgo === null) {
          text = '実データでは PHASE ' + p.phase + ' のため、会員にはまだ何も表示されません（正常です）。'
            + '段階公開が進んだあとの見え方を確認するには、上の「段階公開の表示確認」で PHASE 2〜4 を選んでください。';
        }
      }
      hint.textContent = text;
      hint.hidden = !text;
    }

    function renderPreview(data) {
      const p = data.preview;
      renderPreviewHint(p);
      const body = $('pvBody');
      body.innerHTML = '';

      const top = document.createElement('div'); top.className = 'pv-top';
      const cell = (k, v, cls) => {
        const c = document.createElement('div'); c.className = 'cell';
        const kk = document.createElement('div'); kk.className = 'k'; kk.textContent = k;
        const vv = document.createElement('div'); vv.className = 'v' + (cls ? ' ' + cls : ''); vv.textContent = v;
        c.appendChild(kk); c.appendChild(vv); top.appendChild(c);
      };
      cell('PHASE', 'PHASE ' + p.phase + (p.simulated.phaseDaysAgo === null ? '' : '（シミュ）'));
      cell('受付状態', p.intakeStatus || '（PHASE 4 未満）');
      cell('商品ページ', p.showProductPage ? '表示 (200)' : '非表示 (404)', ynCls(p.showProductPage));
      cell('価格・CTA', p.showPurchaseCta ? '表示' : '非表示', ynCls(p.showPurchaseCta));
      cell('購入可否', yn(p.purchaseEnabled), ynCls(p.purchaseEnabled));
      body.appendChild(top);

      const mk = (title) => { const s = document.createElement('div'); s.className = 'pv-sec'; const h = document.createElement('h3'); h.textContent = title; s.appendChild(h); body.appendChild(s); return s; };

      const mock = mk('会員に見える表示（Premium Plus 商品ページ 相当）');
      const box = document.createElement('div'); box.className = 'pv-mock';
      if (!p.showProductPage) {
        const n = document.createElement('p'); n.className = 'pv-none';
        n.textContent = p.showTeaser ? '商品ページ: 404（会員ページに予告カードのみ表示）' : '商品ページ: 404（予告も出ません）';
        box.appendChild(n);
      } else {
        if (p.intakeStatus) {
          const t = document.createElement('div'); t.className = 'pv-intake-t'; t.textContent = p.intakeTitle || '';
          const s2 = document.createElement('div'); s2.className = 'pv-intake-s'; s2.textContent = p.intakeStatus;
          box.appendChild(t); box.appendChild(s2);
          if (p.intakeNote) { const nt = document.createElement('div'); nt.className = 'pv-intake-n'; nt.textContent = p.intakeNote; box.appendChild(nt); }
        }
        const pr = document.createElement('div'); pr.className = 'pv-price';
        pr.textContent = p.priceVisible ? '価格ブロック: 表示される' : '価格ブロック: 非表示（受付準備中）';
        box.appendChild(pr);
        const cta = document.createElement('span');
        cta.className = 'pv-cta' + (p.ctaEnabled ? '' : ' off');
        cta.textContent = p.showPurchaseCta ? (p.ctaEnabled ? '銀行振込で購入する（操作可）' : '銀行振込で購入する（操作不可）') : '受付準備中';
        box.appendChild(cta);
      }
      mock.appendChild(box);
      const vis = document.createElement('p'); vis.className = 'pv-vis'; vis.textContent = data.visibility || '';
      mock.appendChild(vis);

      const d1 = mk('判定');
      const dl1 = document.createElement('dl'); dl1.className = 'kv';
      kvRow(dl1, '評価時刻(JST)', p.evaluatedAtJst + (p.simulated.isSimulatedTime ? '（シミュレーション）' : ''));
      kvRow(dl1, 'route', p.route);
      kvRow(dl1, 'PremiumPlusEligibility', p.eligibility);
      kvRow(dl1, 'PremiumPlusReleaseOverride', p.releaseOverride || '(空)');
      kvRow(dl1, 'overrideApplied', yn(p.overrideApplied), ynCls(p.overrideApplied));
      kvRow(dl1, '状態', p.state);
      kvRow(dl1, 'anchor(JST)', p.anchorJst || '(なし)');
      kvRow(dl1, 'intake', p.intake || '(PHASE 4 未満)');
      d1.appendChild(dl1);

      const d2 = mk('表示フラグ');
      const dl2 = document.createElement('dl'); dl2.className = 'kv';
      kvRow(dl2, 'showTeaser', yn(p.showTeaser), ynCls(p.showTeaser));
      kvRow(dl2, 'showProductPage', yn(p.showProductPage), ynCls(p.showProductPage));
      kvRow(dl2, 'showPurchaseCta', yn(p.showPurchaseCta), ynCls(p.showPurchaseCta));
      kvRow(dl2, 'purchaseEnabled', yn(p.purchaseEnabled), ynCls(p.purchaseEnabled));
      kvRow(dl2, '商品ページ HTTP', p.productPageStatus);
      if (p.canBrowseWhenClosed !== null) kvRow(dl2, 'CLOSED でも閲覧可', yn(p.canBrowseWhenClosed), ynCls(p.canBrowseWhenClosed));
      d2.appendChild(dl2);
    }

    async function refreshPreview() {
      if (!pvRecordId) return;
      $('pvHint').hidden = true;
      $('pvBody').textContent = '読み込み中…';
      const data = await call({
        action: 'preview',
        recordId: pvRecordId,
        atMin: $('pvTime').value === '' ? null : Number($('pvTime').value),
        phaseDaysAgo: $('pvPhase').value === '' ? null : Number($('pvPhase').value),
      });
      if (!data) { $('pvBody').textContent = '取得に失敗しました'; return; }
      if (!pvOptionsReady && data.options) {
        fillOptions($('pvTime'), data.options.times, 'atMin', '');
        fillOptions($('pvPhase'), data.options.phases, 'daysAgo', '');
        pvOptionsReady = true;
      }
      renderPreview(data);
    }

    function openPreview(recordId) {
      pvRecordId = recordId;
      $('pvBackdrop').hidden = false;
      lockScroll();
      $('pvScroll').scrollTop = 0;
      refreshPreview();
    }
    // 閉じると詳細パネルに戻る（詳細も閉じていれば一覧へ）
    function closePreview() {
      $('pvBackdrop').hidden = true;
      pvRecordId = null;
      if ($('dtBackdrop').hidden) unlockScroll();
    }

    $('pvClose').addEventListener('click', closePreview);
    $('pvBack').addEventListener('click', closePreview);
    $('pvBackdrop').addEventListener('click', (e) => { if (e.target === $('pvBackdrop')) closePreview(); });
    $('pvTime').addEventListener('change', refreshPreview);
    $('pvPhase').addEventListener('change', refreshPreview);
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!$('pvBackdrop').hidden) { closePreview(); return; }
      if (!$('dtBackdrop').hidden) closeDetail();
    });

    $('reload').addEventListener('click', load);
    $('q').addEventListener('input', render);
    $('fState').addEventListener('change', render);
    $('fRoute').addEventListener('change', render);
    $('fUpsell').addEventListener('change', render);
    $('fKind').addEventListener('change', render);

    // ══════════════════════════════════════════════════════════════
    //  顧客マーケティング（AK 独自 / KMA とは無関係）
    //  この領域は Premium Plus の販売資格を一切変更しない。呼ぶ API も別。
    // ══════════════════════════════════════════════════════════════
    const MKT_API = '/.netlify/functions/admin-marketing';

    function mkMsg(text, kind) {
      const el = $('mkMessage');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function mkCall(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { mkMsg('管理シークレットを入力してください', 'err'); $('connBody').hidden = false; return null; }
      const res = await fetch(MKT_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        // 503（送信無効）/ 409（対象変化）は理由をそのまま出す
        mkMsg(data.error || ('エラー: ' + res.status), 'err');
        return null;
      }
      return data;
    }

    let mkData = null;                 // 直近の customers 応答
    let mkCampaigns = [];              // カタログ
    let mkSendEnabled = false;         // live 送信が有効か（本番は既定 false）
    const mkSelected = new Set();      // 選択中の recordId

    /** 画面のフィルター値をまとめて読む（dry-run 失効判定にも使う） */
    function mkCurrentFilters() {
      const v = (id) => { const el = $(id); return el ? String(el.value || '') : ''; };
      return {
        q: v('mkQ'), contract: v('mkContract'), plan: v('mkPlan'), sendable: v('mkSendable'),
        pp: v('mkPp'), history: v('mkHistory'), offer: v('mkOfferState'),
        promo: v('mkPromoState'), frequency: v('mkFrequency'), lastLogin: v('mkLastLogin'),
      };
    }
    const MK_FILTER_DEFAULTS = {
      q: '', contract: 'all', plan: 'all', sendable: 'all', pp: 'all',
      history: 'all', offer: 'all', promo: 'all', frequency: 'all', lastLogin: 'all',
    };
    /** 適用中の条件数を出す（今どれだけ絞っているかを見せる） */
    function mkRenderFilterCount() {
      const el = $('mkFilterCount');
      if (!el) return;
      const sum = flowApi().summarizeFilters(mkCurrentFilters(), MK_FILTER_DEFAULTS);
      el.textContent = '適用中の条件: ' + sum.count;
      el.classList.toggle('is-on', sum.count > 0);
    }

    // ── タブ切替（販売 / マーケティング / カムバック特典）──
    const TABS = [
      ['sales', 'tabSales', 'paneSales'],
      ['mkt', 'tabMkt', 'paneMkt'],
      ['comeback', 'tabCb', 'paneCb'],
    ];
    function showTab(which) {
      for (const [name, tabId, paneId] of TABS) {
        const on = name === which;
        $(paneId).hidden = !on;
        $(tabId).classList.toggle('on', on);
        $(tabId).setAttribute('aria-selected', String(on));
      }
      if (which === 'mkt' && mkCampaigns.length === 0) mkLoadCampaigns();
      if (which === 'comeback' && !cbCatalog) cbLoadOffers();
    }
    $('tabSales').addEventListener('click', () => showTab('sales'));
    $('tabMkt').addEventListener('click', () => showTab('mkt'));
    $('tabCb').addEventListener('click', () => showTab('comeback'));

    // ── キャンペーンカタログ ──
    async function mkLoadCampaigns() {
      const data = await mkCall({ action: 'campaigns' });
      if (data) { mkState.sendEnabled = !!data.sendEnabled; mkState.dispatchEnabled = !!data.dispatchEnabled; }
      if (!data) return;
      mkCampaigns = data.campaigns || [];
      mkSendEnabled = !!data.sendEnabled;
      mkState.sendEnabled = !!data.sendEnabled;
      mkState.dispatchEnabled = !!data.dispatchEnabled;
      mkSyncFlow();
      const sel = $('mkCampaign');
      sel.innerHTML = '';
      for (const c of mkCampaigns) {
        const o = document.createElement('option');
        o.value = c.campaignId;
        // 使用可否と「運用テスト専用」を選択肢の時点で分かるようにする
        o.textContent = (c.usable ? '' : '⛔ ') + (c.testOnly ? '🧪 ' : '') + c.name + '（v' + c.version + '）'
          + (c.testOnly ? ' — 運用テスト専用' : '')
          + (c.usable ? '' : ' — 使用停止中');
        o.disabled = !c.usable;
        if (!c.usable && c.disabledReason) o.title = c.disabledReason;
        sel.appendChild(o);
      }
      // 既定選択は使用可能なものにする（停止中が先頭でも選ばれないように）
      const firstUsable = mkCampaigns.find((c) => c.usable);
      if (firstUsable) sel.value = firstUsable.campaignId;
      // ⚠️ change イベントはプログラム選択では発火しない。
      //    ここで状態へ入れないと「キャンペーン未選択」と判定され、
      //    dry-run ボタンが永久に押せなくなる（2026-08-02 の不具合）。
      mkApplyCampaignSelection();
      renderCampDesc();
      $('mkSendState').textContent = data.sendEnabled
        ? (data.dispatchEnabled
          ? '送信: 有効（キャンペーン配信も有効。実際にメールが届きます）'
          : '送信: キュー登録のみ有効（MARKETING_CAMPAIGN_DISPATCH_ENABLED が無効のため実送信されません）')
        : '送信: 無効（MARKETING_CAMPAIGN_ENABLED 未設定）。対象確認（dry-run）までは利用できます。';
      $('mkSendState').className = 'note' + (data.sendEnabled ? '' : ' off');
    }

    function currentCampaign() {
      const id = $('mkCampaign').value;
      return mkCampaigns.find((c) => c.campaignId === id) || null;
    }

    function renderCampDesc() {
      const c = currentCampaign();
      const el = $('mkCampDesc');
      el.innerHTML = '';
      if (!c) return;
      const rule = c.audienceRule || {};
      const limits = [];
      if (rule.contracts && rule.contracts.length) limits.push('契約状態: ' + rule.contracts.join(' / '));
      if (rule.plans && rule.plans.length) limits.push('プラン: ' + rule.plans.join(' / '));
      if (c.extraAudience) limits.push('追加条件: ' + c.extraAudience);

      // 運用テスト専用は顧客向けと混同しないよう最初に明示する
      if (c.testOnly) {
        const t = document.createElement('p');
        t.className = 'testonly';
        t.textContent = '🧪 運用テスト専用キャンペーンです。'
          + 'NEWSLETTER_TEST_RECIPIENTS に登録されたテスト受信者にのみ送信され、'
          + '一般顧客を選択しても送信対象になりません（対象を手動で広げることはできません）。';
        el.appendChild(t);
      }

      const line = document.createElement('span');
      line.textContent = c.description
        + (limits.length ? '　【対象条件】' + limits.join('・') + (rule.enforce ? '（条件外は自動で除外）' : '') : '');
      el.appendChild(line);

      // 使用停止中は理由を明示する（なぜ選べないのかを画面で完結させる）
      if (!c.usable) {
        const warn = document.createElement('p');
        warn.className = 'blocker';
        warn.textContent = '⛔ 使用停止中: ' + (c.disabledReason || '利用不可');
        el.appendChild(warn);
      }
    }
    // 条件クリア（全部戻して数え直す）
    $('mkFilterClear')?.addEventListener('click', () => {
      for (const [id, def] of Object.entries({
        mkQ: '', mkContract: 'all', mkPlan: 'all', mkSendable: 'all', mkPp: 'all',
        mkHistory: 'all', mkOfferState: 'all', mkPromoState: 'all', mkFrequency: 'all', mkLastLogin: 'all',
      })) { const el = $(id); if (el) el.value = def; }
      mkRenderFilterCount();
      mkNotify('ok', '条件をクリアしました', 'もう一度「この条件で取得」を押してください。');
    });
    for (const id of ['mkQ', 'mkContract', 'mkPlan', 'mkSendable', 'mkPp', 'mkHistory',
      'mkOfferState', 'mkPromoState', 'mkFrequency', 'mkLastLogin']) {
      $(id)?.addEventListener('change', mkRenderFilterCount);
      $(id)?.addEventListener('input', mkRenderFilterCount);
    }

    /** 選択欄の値を状態へ反映する（change でもプログラム選択でも必ずここを通す） */
    function mkApplyCampaignSelection() {
      const c = currentCampaign();
      mkState.campaignId = c ? c.campaignId : '';
      mkState.campaignVersion = c ? String(c.version) : '';
      mkState.campaign = c || null;
      mkRenderCampCard(c);
      mkSyncFlow();
    }

    $('mkCampaign').addEventListener('change', () => {
      renderCampDesc();
      const c = currentCampaign();
      mkState.campaignId = c ? c.campaignId : '';
      mkState.campaignVersion = c ? String(c.version) : '';
      mkState.campaign = c || null;
      // キャンペーンが変われば「確認した内容」は別物 → 失効させる
      mkInvalidateDryRun('キャンペーンが変わりました。');
      mkRenderCampCard(c);
      mkSyncFlow();
    });

    /** キャンペーンカード（名前・version・対象条件・種別・実績・再送可否） */
    function mkRenderCampCard(c) {
      const card = $('mkCampCard');
      if (!card) return;
      card.innerHTML = '';
      if (!c) { card.hidden = true; return; }
      card.hidden = false;
      card.className = 'camp-card' + (c.testOnly ? ' is-test' : '');
      const kind = document.createElement('span');
      kind.className = 'badge ' + (c.testOnly ? 'b-test' : 'b-normal');
      kind.textContent = c.testOnly ? '🧪 運用テスト専用' : '通常配信';
      card.appendChild(kind);
      const title = document.createElement('b');
      title.textContent = ' ' + c.name + ' v' + c.version;
      card.appendChild(title);
      const meta = document.createElement('div'); meta.className = 'camp-meta';
      const stat = mkCampStats.get(c.campaignId + ':v' + c.version) || null;
      meta.textContent = stat
        ? ('送信済み ' + stat.sent + ' 名 / 最終送信 ' + (stat.lastAt ? fmtDate(stat.lastAt) : '—')
          + ' / 同一 version の再送: 不可（version を上げれば可）')
        : 'この version の送信実績はまだありません（再送制限なし）';
      card.appendChild(meta);
    }
    /** campaignType → 実績（history から作る） */
    const mkCampStats = new Map();

    // ── 顧客一覧 ──
    async function mkLoad() {
      mkMsg('読み込み中…');
      const data = await mkCall({
        action: 'customers',
        contract: $('mkContract').value,
        plan: $('mkPlan').value,
        marketing: $('mkSendable').value,
        premiumPlus: $('mkPp').value,
        history: $('mkHistory').value,
        lastLogin: $('mkLastLogin').value,
        offerState: $('mkOfferState').value,
        promoState: $('mkPromoState').value,
        frequency: $('mkFrequency').value,
      });
      if (!data) return;
      mkData = data;
      // 取得結果を状態へ反映（件数・条件・確認結果の失効）
      mkApplyCustomersLoaded(data.rows || []);
      mkSendEnabled = !!data.sendEnabled;
      mkMsg('');
      mkRender();
      renderApplied(data);
      mkRenderListSummary();
    }

    // 適用中の条件と件数を画面に出す（何で絞ったのか分からない状態を作らない）
    function renderApplied(data) {
      const f = data.appliedFilters || {};
      const LBL = { contract: '契約', plan: 'プラン', marketing: '送信可否', premiumPlus: 'Plus 資格',
        history: '送信履歴', lastLogin: '最終ログイン', offerState: 'オファー', promoState: '無料特典', frequency: '送信タイミング' };
      const parts = Object.entries(f).filter(([, v]) => v && v !== 'all').map(([k, v]) => (LBL[k] || k) + '=' + v);
      $('mkApplied').textContent = '条件: ' + (parts.length ? parts.join(' AND ') : '指定なし（全件）')
        + ' → 該当 ' + (data.matchedCount || 0) + ' 名';
    }

    // 列の表示切替（狭い画面では主要列だけ）
    function setColMode(mode) {
      document.getElementById('paneMkt').dataset.colmode = mode;
      $('mkColBasic').classList.toggle('is-on', mode === 'basic');
      $('mkColAll').classList.toggle('is-on', mode === 'all');
    }
    $('mkColBasic').addEventListener('click', () => setColMode('basic'));
    $('mkColAll').addEventListener('click', () => setColMode('all'));
    setColMode('basic');

    const CONTRACT_LABEL = {
      active: '有効', expiring_soon: '期限間近', expired: '期限切れ',
      unknown: '不明', none: '契約なし',
    };
    const PLAN_LABEL = {
      premium_sanrenpuku: '三連複', premium: 'Premium', light: 'Light', free: 'Free',
    };

    /**
     * 画面に**いま出ている行**（絞り込み → 検索 → 現在ページ）。
     * 「表示中を全選択」もこの範囲だけを対象にする。
     */
    function mkVisibleRows() {
      const info = mkPageInfo();
      return mkSearchedRows().slice((info.page - 1) * mkList.pageSize, info.page * mkList.pageSize);
    }

    function mkRender() {
      if (!mkData) return;
      document.querySelector('#paneMkt .tbl')?.classList.add('is-compact');
      const seg = mkData.segments || {};
      const bar = $('mkSummary');
      bar.innerHTML = '';
      const items = [
        ['有効', seg.contract?.active || 0],
        ['期限間近', seg.contract?.expiring_soon || 0],
        ['期限切れ', seg.contract?.expired || 0],
        ['不明', seg.contract?.unknown || 0],
        ['Free', seg.contract?.none || 0],
        ['送信除外', seg.marketing?.suppressed || 0],
      ];
      items.forEach((it, i) => {
        if (i > 0) { const sp = document.createElement('span'); sp.className = 'sep'; sp.textContent = '|'; bar.appendChild(sp); }
        const b = document.createElement('span');
        b.className = 's';
        const kk = document.createElement('span'); kk.className = 'k'; kk.textContent = it[0];
        const vv = document.createElement('span'); vv.className = 'v'; vv.textContent = String(it[1]);
        b.appendChild(kk); b.appendChild(vv);
        bar.appendChild(b);
      });
      const sup = seg.suppression || {};
      const wd = seg.withdrawn || {};
      $('mkSummarySub').textContent =
        '全顧客 ' + (mkData.totalCustomers || 0) + ' 名　/　除外内訳: '
        + ['unsubscribed', 'blacklist', 'no_email', 'suspended', 'test_account']
          .map((k) => (mkData.labels?.suppression?.[k] || k) + ' ' + (sup[k] || 0)).join('・')
        // 退会は「除外」ではない。契約状態として別枠で件数を出す
        + '　/　退会（課金停止）' + (wd.total || 0) + ' 名（うち送信可能 ' + (wd.sendable || 0) + ' 名）';

      const rows = mkVisibleRows();
      const tb = $('mkRows');
      tb.innerHTML = '';
      for (const r of rows) {
        const tr = document.createElement('tr');
        if (!r.sendable) tr.className = 'row-suppressed';

        const c0 = document.createElement('td');
        c0.className = 'c-chk';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = mkSelected.has(r.recordId);
        cb.disabled = !r.sendable; // 送信できない相手は選べない（fail closed）
        cb.setAttribute('aria-label', '選択');
        if (!r.sendable) {
          // なぜ選べないのかをその場で分かるようにする（列を見に行かせない）
          const why = (r.suppressionReasons || []).map((x) => (mkData.labels?.suppression?.[x] || x)).join('・');
          cb.title = '選択できません: ' + (why || '送信除外');
          tr.classList.add('is-unsendable');
        }
        cb.addEventListener('change', () => {
          if (cb.checked) mkSelected.add(r.recordId); else mkSelected.delete(r.recordId);
          mkRenderSelCount();
        });
        c0.appendChild(cb);
        tr.appendChild(c0);

        const c1 = td('c-cust', '', undefined);
        const em = document.createElement('span');
        em.className = 'em';
        em.textContent = r.email || '(メール未設定)';
        c1.appendChild(em);
        if (r.name) { const nm = document.createElement('span'); nm.className = 'sub'; nm.textContent = r.name; c1.appendChild(nm); }
        tr.appendChild(c1);

        // 契約状態と送信可否は別概念。退会（課金停止）は契約欄に履歴として出し、
        // 送信可否には影響させない。
        const cCon = td('c-contract', '契約', CONTRACT_LABEL[r.contract] || r.contract);
        cCon.firstChild.className = 'contract ' + r.contract;
        if (r.daysToExpiry != null) cCon.firstChild.title = '期限まで ' + r.daysToExpiry + ' 日';
        if (r.withdrawn) {
          const wb = document.createElement('span');
          wb.className = 'wd-badge';
          wb.textContent = '退会';
          wb.title = '課金停止（退会申請）。メール配信の可否とは別です';
          cCon.appendChild(wb);
        }
        tr.appendChild(cCon);

        tr.appendChild(td('c-plan', 'プラン', PLAN_LABEL[r.planGroup] || r.planGroup));

        const sendText = r.sendable
          ? '送信可能'
          : '除外: ' + r.suppressionReasons.map((x) => (mkData.labels?.suppression?.[x] || x)).join('・');
        tr.appendChild(td('c-send', '送信', sendText, r.sendable ? 'ok-txt' : 'ng-txt'));

        // 最終ログイン。**どの記録由来か**を必ず併記する（旧ポイント履歴は 2026-07-08 で更新停止）
        const loginText = r.lastLoginAt
          ? fmtDate(r.lastLoginAt) + (r.daysSinceLogin != null ? '（' + r.daysSinceLogin + '日前）' : '')
          : '記録なし';
        const cLogin = td('c-login', '最終ログイン', loginText, r.lastLoginAt ? '' : 'muted');
        if (r.lastLoginSourceLabel) cLogin.firstChild.title = '出所: ' + r.lastLoginSourceLabel;
        if (r.lastLoginSource === 'legacy_points') {
          const lb = document.createElement('span');
          lb.className = 'sub';
          lb.textContent = '旧記録（〜7/8）';
          cLogin.appendChild(lb);
        }
        tr.appendChild(cLogin);

        // ── 詳細列（狭い画面では非表示。カルテで確認できる）──
        const acc = r.access || {};
        const accText = [acc.free && "無料", acc.light && "Light", acc.premium && "Premium", acc.sanrenpuku && "三連複"].filter(Boolean).join("/") || "なし";
        tr.appendChild(td("c-access col-detail", "閲覧権限", accText, acc.premium || acc.sanrenpuku ? "ok-txt" : ""));

        const promoText = r.promoActive
          ? (r.promoLifetime ? "無期限" : (r.promoUntil ? "〜" + fmtDate(r.promoUntil) : "期間不明"))
          : "—";
        tr.appendChild(td("c-promo col-detail", "無料特典", promoText, r.promoActive ? "ok-txt" : "muted"));

        const offerText = r.liveOfferCount
          ? r.liveOfferCount + " 件" + (r.offerExpiresAt ? "（〜" + fmtDate(r.offerExpiresAt) + "）" : "")
          : "—";
        tr.appendChild(td("c-offer col-detail", "オファー", offerText, r.liveOfferCount ? "ok-txt" : "muted"));

        tr.appendChild(td("c-next col-detail", "次回送信可",
          r.nextSendableAt ? fmtDate(r.nextSendableAt) + " 以降" : "いま送れる",
          r.nextSendableAt ? "ng-txt" : "ok-txt"));

        tr.appendChild(td('c-pp', 'Plus', r.premiumPlusEligibility || '未設定',
          r.premiumPlusEligibility ? '' : 'muted'));

        tr.appendChild(td('c-hist', '送信履歴',
          r.sentCount ? (r.sentCount + ' 回 / ' + fmtDate(r.lastSentAt)) : '—',
          r.sentCount ? '' : 'muted'));

        const cDet = document.createElement('td');
        cDet.className = 'c-detail';
        const detBtn = document.createElement('button');
        detBtn.type = 'button';
        detBtn.className = 'btn-ghost btn-sm';
        detBtn.textContent = 'カルテ';
        detBtn.addEventListener('click', () => mkOpenDossier(r.recordId, r.email));
        cDet.appendChild(detBtn);
        tr.appendChild(cDet);

        tb.appendChild(tr);
      }

      $('mkCount').textContent = '表示 ' + rows.length + ' 件 / 条件一致 ' + (mkData.matchedCount || 0) + ' 件'
        + (mkData.truncated ? '（上限を超えたため一部のみ表示）' : '');
      const emp = $('mkEmpty');
      emp.hidden = rows.length > 0;
      emp.textContent = '条件に一致する顧客はいません。';
      if (mkData.truncated) mkMsg('条件一致が多いため一部のみ表示しています。条件を絞ってください。', 'err');
      mkRenderSelCount();
    }

    /** 顧客一覧を取得したときの状態更新（件数・条件・確認結果の失効） */
    function mkApplyCustomersLoaded(rows) {
      mkState.loadedCount = Array.isArray(rows) ? rows.length : 0;
      mkState.filters = mkCurrentFilters();
      mkInvalidateDryRun('顧客一覧を取得し直しました。');
      mkRenderFilterCount();
      mkSyncFlow();
    }

    /** 一覧の表示状態（ページ・件数・絞り込み）。変わったら dry-run を失効させる */
    const mkList = { page: 1, pageSize: 25, view: 'all' };

    /** 絞り込み（すべて / 送信可能のみ / 選択者のみ）を適用した母集合 */
    function mkScopedRows() {
      const rows = (mkData?.rows || []);
      if (mkList.view === 'selected') return rows.filter((r) => mkSelected.has(r.recordId));
      if (mkList.view === 'sendable') return rows.filter((r) => r.sendable === true);
      return rows;
    }

    /** 母集合に検索語を適用した行（ページ分割の前段） */
    function mkSearchedRows() {
      const q = $('mkQ').value.trim().toLowerCase();
      return mkScopedRows().filter((r) => !q || String(r.email || '').toLowerCase().includes(q));
    }

    /** ページ範囲（「42 件中 1〜25 件」） */
    function mkPageInfo() {
      const total = mkSearchedRows().length;
      const pages = Math.max(1, Math.ceil(total / mkList.pageSize));
      const page = Math.min(Math.max(1, mkList.page), pages);
      const from = total === 0 ? 0 : (page - 1) * mkList.pageSize + 1;
      const to = Math.min(page * mkList.pageSize, total);
      return { total, pages, page, from, to, label: total === 0 ? '0 件' : total + ' 件中 ' + from + '〜' + to + ' 件' };
    }

    /** 一覧の要約（該当 / 送信可能 / 送信不可 / 選択） */
    function mkRenderListSummary() {
      const rows = (mkData?.rows || []);   // 該当件数は取得した全件で数える
      const sendable = rows.filter((r) => r.sendable === true).length;
      const el = $('mkListSummary');
      if (el) {
        el.textContent = rows.length === 0 ? '未取得'
          : '該当 ' + rows.length + ' 名（送信可能 ' + sendable + ' / 送信不可 ' + (rows.length - sendable) + '）　選択 ' + mkSelected.size + ' 名';
      }
      const info = mkPageInfo();
      for (const id of ['mkPageLabel', 'mkPageLabelBottom']) { const x = $(id); if (x) x.textContent = info.label; }
      const prev = $('mkPrevPage'); if (prev) prev.disabled = info.page <= 1;
      const next = $('mkNextPage'); if (next) next.disabled = info.page >= info.pages;
    }

    /** 表示条件が変わったら確認結果を失効させて描画し直す */
    function mkChangeList(patch) {
      Object.assign(mkList, patch);
      mkInvalidateDryRun('一覧の表示が変わりました。');
      mkRender();
    }
    $('mkPageSize')?.addEventListener('change', () => mkChangeList({ pageSize: Number($('mkPageSize').value) || 25, page: 1 }));
    $('mkViewMode')?.addEventListener('change', () => mkChangeList({ view: $('mkViewMode').value, page: 1 }));
    $('mkPrevPage')?.addEventListener('click', () => mkChangeList({ page: Math.max(1, mkList.page - 1) }));
    $('mkNextPage')?.addEventListener('click', () => mkChangeList({ page: mkList.page + 1 }));
    $('mkSelAllBottom')?.addEventListener('click', () => $('mkSelAll').click());
    $('mkSelNoneBottom')?.addEventListener('click', () => $('mkSelNone').click());

    function mkRenderSelCount() {
      mkRenderListSummary();
      // 選択が変われば「確認した母集団」とズレる → dry-run を失効させる
      if (mkState.dryRun && flowApi().isDryRunStale({ dryRun: mkState.dryRun, current: { ...mkState, selectedIds: [...mkSelected] } })) {
        mkInvalidateDryRun('選択した顧客が変わりました。');
      }
      mkSyncFlow();
      $('mkSelCount').textContent = mkSelected.size + ' 名を選択中';
      // 絞り込みで見えなくなった選択を知らせる（見えないまま実行させない）
      const PV = window.__planView;
      const off = PV ? PV.offscreenSelection({ current: mkSelected, visibleIds: mkVisibleRows().map((r) => r.recordId) }) : [];
      $('mkSelWarn').textContent = off.length ? '⚠️ うち ' + off.length + ' 名は現在の絞り込みに表示されていません' : '';
    }

    // ── 顧客カルテ（read-only）─────────────────────────────────────
    function dossierRow(parent, label, value, cls) {
      const dl = document.createElement('div');
      dl.className = 'd-row' + (cls ? ' ' + cls : '');
      const k = document.createElement('span'); k.className = 'd-k'; k.textContent = label;
      const v = document.createElement('span'); v.className = 'd-v'; v.textContent = value;
      dl.appendChild(k); dl.appendChild(v);
      parent.appendChild(dl);
      return dl;
    }
    function dossierSection(parent, title) {
      const sec = document.createElement('section');
      sec.className = 'd-sec';
      const h = document.createElement('h3'); h.textContent = title;
      sec.appendChild(h);
      parent.appendChild(sec);
      return sec;
    }

    async function mkOpenDossier(recordId, email) {
      const box = $('mkDossier');
      const body = $('mkDossierBody');
      box.hidden = false;
      $('mkDossierTitle').textContent = 'カルテ: ' + (email || recordId);
      body.textContent = '読み込み中…';
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      let data;
      try {
        data = await mkCall({ action: 'customerDetail', recordId });
      } catch (e) {
        body.textContent = '取得に失敗しました: ' + (e && e.message ? e.message : 'unknown');
        return;
      }
      const d = data.dossier;
      body.innerHTML = '';

      // ⓪ 推奨アクション（提案のみ。ここから自動実行はしない）
      const s0 = dossierSection(body, '★ 推奨アクション（提案のみ・自動実行しません）');
      for (const rec of (d.recommendations || [])) {
        const box = document.createElement('div');
        box.className = 'rec rec-' + (rec.severity || 'info');
        const h = document.createElement('div'); h.className = 'rec-title'; h.textContent = rec.title;
        const why = document.createElement('p'); why.className = 'rec-why'; why.textContent = rec.reason;
        box.appendChild(h); box.appendChild(why);
        const meta = document.createElement('div'); meta.className = 'rec-meta';
        const add = (k, v) => { const s = document.createElement('span'); s.textContent = k + ': ' + v; meta.appendChild(s); };
        add('使用データ', (rec.dataUsed || []).join(' / ') || '—');
        add('送信可否', rec.sendable === null ? '送信を伴わない' : (rec.sendable ? '送れる' : '送れない'));
        add('実行できる最短', rec.earliestAt ? fmtDate(rec.earliestAt) : '—');
        if (rec.campaignId) add('推奨キャンペーン', rec.campaignId);
        if (rec.offerId) add('推奨施策', rec.offerId);
        box.appendChild(meta);
        s0.appendChild(box);
      }

      // ① ログイン
      const s1 = dossierSection(body, '① ログイン');
      dossierRow(s1, 'いまログインできるか', d.login.canLogin ? 'できる' : 'できない',
        d.login.canLogin ? 'ok' : 'ng');
      dossierRow(s1, '状態', d.login.label);
      dossierRow(s1, 'ログイン方法',
        d.login.loginMethod === 'link' ? 'メールで届くリンクを開く（有料階層）' : 'メールアドレス入力だけで入れる（無料）');
      dossierRow(s1, 'セッションのプラン', d.login.sessionPlan || '—');
      dossierRow(s1, '権限の根拠',
        d.login.entitlementSource === 'promotional_grant' ? '無料特典（支払いではない）'
          : d.login.entitlementSource === 'paid_contract' ? '課金契約' : '—');
      dossierRow(s1, '最終ログイン',
        (d.login.lastLogin.at ? fmtDate(d.login.lastLogin.at) : '記録なし')
        + (d.login.daysSinceLogin != null ? '（' + d.login.daysSinceLogin + '日前）' : '')
        + ' ／ 出所: ' + d.login.lastLogin.sourceLabel);

      // ② メール到達性・送信履歴
      const s2 = dossierSection(body, '② メール到達性・送信履歴');
      dossierRow(s2, '送信可否', d.reachability.sendable ? '送信可能' : '送信除外',
        d.reachability.sendable ? 'ok' : 'ng');
      if (!d.reachability.sendable) {
        dossierRow(s2, '除外理由', (d.reachability.suppressionReasons || []).join('・') || '—');
      }
      dossierRow(s2, '配信基盤の配信停止リスト',
        d.reachability.providerSuppressed === null ? '確認できず（不明）'
          : d.reachability.providerSuppressed ? '登録あり（送れない）' : 'なし',
        d.reachability.providerSuppressed ? 'ng' : '');
      dossierRow(s2, 'AK ブラックリスト', d.reachability.blacklisted ? 'あり' : 'なし');
      dossierRow(s2, 'ソフトバウンス', d.reachability.softBounced ? 'あり' : 'なし');
      dossierRow(s2, '配信停止', d.reachability.unsubscribed ? 'あり' : 'なし');
      dossierRow(s2, 'キャンペーン送信',
        d.delivery.sentCount ? (d.delivery.sentCount + ' 回 / 最終 ' + fmtDate(d.delivery.lastSentAt)) : '未送信');
      for (const h of d.delivery.recent) {
        dossierRow(s2, '　' + fmtDate(h.at), h.campaign + '（' + h.status + '）', 'sub-row');
      }

      // ③ 特典・オファー
      const s3 = dossierSection(body, '③ 無料特典・割引オファー');
      const gl = d.grantsAndOffers.promoLight;
      const gp = d.grantsAndOffers.promoPremium;
      dossierRow(s3, 'Light 無料特典',
        gl.active ? (gl.lifetime ? '永久' : '〜' + fmtDate(gl.until)) : 'なし', gl.active ? 'ok' : '');
      dossierRow(s3, 'Premium 無料特典',
        gp.active ? (gp.lifetime ? '永久' : '〜' + fmtDate(gp.until)) : 'なし', gp.active ? 'ok' : '');
      if (d.grantsAndOffers.promoInconsistent) {
        dossierRow(s3, '⚠️ 特典データ', '矛盾あり（取消済みなのに値が残っている）', 'ng');
      }
      dossierRow(s3, '有効な割引オファー', String(d.grantsAndOffers.liveOfferCount));
      for (const o of d.grantsAndOffers.offers) {
        dossierRow(s3, '　' + o.offerId,
          '¥' + (o.regularPrice || 0).toLocaleString() + ' → ¥' + (o.offerPrice || 0).toLocaleString()
          + ' / ' + o.status + ' / 〜' + fmtDate(o.expiresAt) + (o.live ? '（有効）' : '（無効）'),
          'sub-row');
      }
      dossierRow(s3, 'Premium Plus 資格', d.grantsAndOffers.premiumPlusEligibility || '未設定');

      // ④ 契約・決済
      const s4 = dossierSection(body, '④ 契約・決済');
      dossierRow(s4, 'プラン', (d.contract.plan || '—') + (d.contract.planType ? ' / ' + d.contract.planType : ''));
      dossierRow(s4, '契約状態', CONTRACT_LABEL[d.contract.contractState] || d.contract.contractState);
      dossierRow(s4, '有効期限', d.contract.expiresAt ? fmtDate(d.contract.expiresAt) : '—');
      dossierRow(s4, '退会', d.contract.withdrawn ? ('あり ' + fmtDate(d.contract.withdrawalDate)) : 'なし');
      dossierRow(s4, '三連複 買い切り', d.contract.lifetimeSanrenpuku ? 'あり' : 'なし');
      dossierRow(s4, '入金', d.contract.paymentConfirmed ? '確認済み' : '—');
      dossierRow(s4, '入金日', d.contract.paidAt ? fmtDate(d.contract.paidAt) : '—');
      if (d.contract.requested) {
        dossierRow(s4, '申込中', d.contract.requested.plan + ' / ¥'
          + (d.contract.requested.amount || 0).toLocaleString(), 'ng');
      }
      dossierRow(s4, '登録日', d.registeredAt ? fmtDate(d.registeredAt) : '—');

      // ⑤ 閲覧できるもの
      const s5 = dossierSection(body, '⑤ いま閲覧できるもの');
      dossierRow(s5, '無料コンテンツ', d.access.canViewFree ? '閲覧可' : '不可', d.access.canViewFree ? 'ok' : '');
      dossierRow(s5, 'Light', d.access.canViewLight ? '閲覧可' : '不可', d.access.canViewLight ? 'ok' : '');
      dossierRow(s5, 'Premium', d.access.canViewPremium ? '閲覧可' : '不可', d.access.canViewPremium ? 'ok' : '');
      dossierRow(s5, '三連複', d.access.canViewSanrenpuku ? '閲覧可' : '不可', d.access.canViewSanrenpuku ? 'ok' : '');

      // ⑥ マーケティング履歴（新しい順・出所つき）
      const s6 = dossierSection(body, '⑥ マーケティング履歴（新しい順）');
      const lim = d.timelineLimits || {};
      const notes = [];
      notes.push('問い合わせ履歴: ' + (lim.inquiriesAvailable ? '取得可' : '台帳が無く取得できません'));
      if (lim.contractHistoryIsSnapshotOnly) notes.push('過去の契約は最新 1 件ぶんのみ（履歴テーブルが無いため）');
      if (lim.offerRevokeHasNoTimestamp) notes.push('オファー取消は日時が台帳に無いため末尾に表示');
      const eng = (data.engagementSource || {});
      notes.push('開封・クリック: ' + (eng.available ? eng.note : (eng.note || '取得できません')));
      const noteEl = document.createElement('p'); noteEl.className = 'tl-note'; noteEl.textContent = '⚠️ ' + notes.join(' / ');
      s6.appendChild(noteEl);

      // ⑥-2 メール反応（恒久台帳 EmailEvents）。⑥ の「直近ぶん」とは出所も期間も違うので別枠にする。
      // resolved かつ CustomerRecordId 完全一致の行だけが集計対象で、
      // 未確定（unresolved / conflict）はこの人の反応として表示しない。
      const s62 = dossierSection(body, '⑥-2 メール反応（恒久台帳）');
      const led = (data.ledgerSource || {});
      const le = d.ledgerEngagement || {};
      if (!led.available || le.available !== true) {
        dossierRow(s62, '状態', '取得不能（反応が無かったという意味ではありません）', 'ng');
      } else {
        dossierRow(s62, '配信済み', String(le.delivered ?? 0) + ' 件');
        dossierRow(s62, '開封', String(le.opens ?? 0) + ' 回');
        dossierRow(s62, '初回開封', le.firstOpenAt ? fmtDate(le.firstOpenAt) : '—');
        dossierRow(s62, '最終開封', le.lastOpenAt ? fmtDate(le.lastOpenAt) : '—');
        dossierRow(s62, 'クリック', String(le.clicks ?? 0) + ' 回');
        dossierRow(s62, '初回クリック', le.firstClickAt ? fmtDate(le.firstClickAt) : '—');
        dossierRow(s62, '最終クリック', le.lastClickAt ? fmtDate(le.lastClickAt) : '—');
        if ((le.clickCategories || []).length > 0) {
          dossierRow(s62, 'クリック先', le.clickCategories.join(' / '));
        }
        dossierRow(s62, 'bounce / 配信停止 / 迷惑報告',
          String(le.bounced ?? 0) + ' / ' + String(le.unsubscribed ?? 0) + ' / ' + String(le.spamReported ?? 0));
      }
      // 未確定（unresolved / conflict）は**この人の反応ではない**。件数だけ参考として出す。
      // 出さないと「取りこぼしが起きていること自体」に気付けない。
      if (led.unattributedAvailable) {
        dossierRow(s62, '未確定イベント（全体・顧客未紐付）',
          String(led.unresolvedTotal ?? 0) + ' 件 / 食い違い ' + String(led.conflictTotal ?? 0) + ' 件');
      } else {
        dossierRow(s62, '未確定イベント（全体）', '取得不能', 'ng');
      }
      const ledNote = document.createElement('p'); ledNote.className = 'tl-note';
      ledNote.textContent = '⚠️ ' + (led.note || '') + '（⑥ の直近ぶんとは出所が異なります。'
        + '誰のものか確定していないイベントは、この人の反応として数えていません）';
      s62.appendChild(ledNote);

      const rows = [...(d.timeline || []), ...(d.timelineUnknownDate || [])];
      if (rows.length === 0) {
        const empty = document.createElement('p'); empty.className = 'tl-note'; empty.textContent = '記録がありません。';
        s6.appendChild(empty);
      }
      for (const e of rows) {
        const row = document.createElement('div');
        row.className = 'tl-row' + (e.atMs === null ? ' tl-unknown' : '');
        const when = document.createElement('span'); when.className = 'tl-when';
        when.textContent = e.at ? fmtDate(e.at) : '日時不明';
        const kind = document.createElement('span'); kind.className = 'tl-kind'; kind.textContent = e.label;
        const detail = document.createElement('span'); detail.className = 'tl-detail'; detail.textContent = e.detail || '';
        const src = document.createElement('span'); src.className = 'tl-src';
        src.textContent = e.source + (e.field ? '.' + e.field : '');
        row.appendChild(when); row.appendChild(kind); row.appendChild(detail); row.appendChild(src);
        s6.appendChild(row);
      }
    }

    $('mkDossierClose').addEventListener('click', () => { $('mkDossier').hidden = true; });

    // ── 施策パネル（dry-run のみ。実行系は既存フローに委ねる）───────────
    $('mkActionDry').addEventListener('click', async () => {
      const kind = $('mkActionKind').value;
      const ids = [...mkSelected];
      const box = $('mkActionResult');
      box.innerHTML = '';
      if (ids.length === 0) { $('mkActionState').textContent = '対象を選択してください。'; return; }
      $('mkActionState').textContent = '確認中…（書き込みは行いません）';
      try {
        const PV = window.__planView;
        const rowsById = new Map((mkData && mkData.rows ? mkData.rows : []).map((r) => [r.recordId, r]));
        let result; let planKind; let campaign = null;
        if (kind === 'campaign') {
          campaign = mkCampaigns.find((x) => x.campaignId === $('mkCampaign').value);
          result = await mkCall({ action: 'dryRun', campaignId: campaign.campaignId, recordIds: ids });
          planKind = PV.PLAN_KIND.CAMPAIGN;
        } else {
          const key = kind.startsWith('premium-') ? 'premiumOfferId' : 'lightOfferId';
          result = await cbCall({ action: 'dryRun', [key]: kind, recordIds: ids });
          planKind = PV.PLAN_KIND.GRANT_OFFER;
        }
        if (!result) { $('mkActionState').textContent = '確認できませんでした。'; return; }
        // 対象/除外の判定は API の結果をそのまま使う（画面では再判定しない）
        const view = PV.buildPlanView({ kind: planKind, selectedIds: ids, rowsById, result, campaign, nowMs: Date.now() });
        renderPlanView(box, view);
        $('mkActionState').textContent = view.executable
          ? '確認しました。実行は各タブの確認 → 実行から行ってください。'
          : '⛔ この内容では実行できません: ' + view.blockers.join(' / ');
      } catch (e) {
        $('mkActionState').textContent = '確認に失敗しました: ' + (e && e.message ? e.message : 'unknown');
      }
    });

    /** dry-run の結果を「実行前確認」の形で描く（タブ: 対象者 / 除外者 / 理由 / 実行内容 / rollback）*/
    function renderPlanView(box, view) {
      const head = document.createElement('div');
      head.className = 'pv-head' + (view.executable ? '' : ' pv-blocked');
      head.textContent = view.title
        + '　選択 ' + view.selectedCount + ' / 対象 ' + view.includedCount + ' / 除外 ' + view.excludedCount;
      box.appendChild(head);

      const warn = document.createElement('p'); warn.className = 'tl-note'; warn.textContent = '⚠️ ' + view.warning;
      box.appendChild(warn);
      for (const b of view.blockers) {
        const p2 = document.createElement('p'); p2.className = 'pv-blocker'; p2.textContent = '⛔ ' + b;
        box.appendChild(p2);
      }

      const tabs = document.createElement('div'); tabs.className = 'pv-tabs';
      const panes = document.createElement('div');
      const TABS = [
        ['対象者 ' + view.included.length, () => {
          const s = dossierSection(panes, view.detailComplete ? 'この人に実行されます' : '対象者を確定できません');
          if (!view.detailComplete) {
            dossierRow(s, '⛔ 未確定', '権威 API から除外者の明細を取得できないため、誰が対象かを特定できません。推測で一覧を出しません。', 'ng');
          }
          // 特典・オファーは「変更前 → 変更後」を dry-run の preview からそのまま出す
          const prevMap = new Map(((view.previews) || []).map((x) => [x.recordId, x]));
          if (view.included.length === 0) dossierRow(s, '—', '対象者はいません', 'ng');
          for (const p3 of view.included) {
            dossierRow(s, (p3.name || p3.email || p3.recordId),
              [p3.email, CONTRACT_LABEL[p3.contract] || p3.contract,
                '閲覧: ' + [p3.access && p3.access.free && '無料', p3.access && p3.access.light && 'Light',
                  p3.access && p3.access.premium && 'Premium', p3.access && p3.access.sanrenpuku && '三連複'].filter(Boolean).join('/'),
                '最終ログイン: ' + (p3.lastLoginAt ? fmtDate(p3.lastLoginAt) : '記録なし'),
                'オファー: ' + p3.liveOfferCount + ' 件',
                '特典: ' + (p3.promoActive ? (p3.promoUntil ? '〜' + fmtDate(p3.promoUntil) : 'あり') : 'なし'),
                '次回送信可: ' + (p3.nextSendableAt ? fmtDate(p3.nextSendableAt) : 'いま送れる'),
              ].join(' / '), 'ok');
            const pv = prevMap.get(p3.recordId);
            if (pv) dossierRow(s, '　変更前 → 変更後', (pv.before || '—') + ' → ' + (pv.after || '—'), 'sub-row');
          }
        }],
        ['除外者 ' + view.excluded.length, () => {
          const s = dossierSection(panes, 'この人には実行されません');
          if (!view.detailAvailable) dossierRow(s, '注意', '明細が取得できないため理由集計のみ表示します', 'ng');
          for (const p4 of view.excluded) {
            dossierRow(s, (p4.name || p4.email || p4.recordId),
              p4.reasonLabel + '（' + p4.reasonCode + '）', p4.known ? '' : 'ng');
          }
        }],
        ['除外理由', () => {
          const s = dossierSection(panes, '除外理由の集計');
          if (view.reasonSummary.length === 0) dossierRow(s, '—', '除外はありません', 'ok');
          for (const r of view.reasonSummary) {
            dossierRow(s, r.label + '（' + r.code + '）', r.count + ' 名', r.known ? '' : 'ng');
          }
        }],
        ['実行内容', () => {
          const s = dossierSection(panes, '実行すると何が起きるか');
          if (view.campaignId) {
            dossierRow(s, 'キャンペーンID', view.campaignId + ':v' + view.version);
            dossierRow(s, '件名', view.subject || '—');
          }
          if (view.offer) {
            dossierRow(s, 'オファー', (view.offer.offerId || '') + ' ¥'
              + Number(view.offer.regularPrice || 0).toLocaleString() + ' → ¥'
              + Number(view.offer.offerPrice || 0).toLocaleString());
            if (view.offer.earliestExpiresAt) dossierRow(s, '有効期限（最短）', fmtDate(view.offer.earliestExpiresAt));
          }
          if (view.grants) {
            if (view.grants.light) dossierRow(s, 'Light 特典', view.grants.light);
            if (view.grants.premium) dossierRow(s, 'Premium 特典', view.grants.premium);
          }
          dossierRow(s, 'operationId', view.operationId || view.planFingerprint || '—');
          dossierRow(s, '対象件数', view.includedCount + ' 名（除外 ' + view.excludedCount + ' 名 / 選択 ' + view.selectedCount + ' 名）');
          dossierRow(s, '対象者一覧', view.detailComplete ? '確定（対象者タブを参照）' : '⛔ 未確定（誰が対象か特定できません）', view.detailComplete ? 'ok' : 'ng');
          dossierRow(s, '取り消し方法', view.rollback.join(' / '));
          dossierRow(s, 'この操作の副作用', view.sideEffects + '（dry-run のため本番は未変更）', 'ok');
          dossierRow(s, '本番変更', 'この確認では行われません（実行は各タブの確認 → 実行）', 'ok');
        }],
        ['rollback', () => {
          const s = dossierSection(panes, '取り消し方法');
          for (const line of view.rollback) dossierRow(s, '・', line);
        }],
      ];
      TABS.forEach(([label, render], i) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn-ghost btn-sm' + (i === 0 ? ' is-on' : '');
        b.textContent = label;
        b.addEventListener('click', () => {
          panes.innerHTML = '';
          [...tabs.children].forEach((c) => c.classList.remove('is-on'));
          b.classList.add('is-on');
          render();
        });
        tabs.appendChild(b);
      });
      box.appendChild(tabs);
      box.appendChild(panes);
      TABS[0][1]();
    }

    // ── 実配信（キューを配信基盤へ渡す）────────────────────────────

    // ══════════════════════════════════════════════════════════════
    //  操作順の管理（押せる／押せないの根拠は marketingConsoleFlow.js が単一源）
    //  画面はここで判定を呼ぶだけ。判定を画面側に書き直さない。
    // ══════════════════════════════════════════════════════════════
    // 判定の単一源。module script（上の <script>）が window へ橋渡しする
    const flowApi = () => window.__mkFlow;
    /** 画面の現在状態。dry-run の指紋もここに持つ */
    const mkState = {
      loadedCount: 0, selectedIds: [], filters: {}, campaignId: '', campaignVersion: '',
      campaign: null, dryRun: null, enqueued: false, dispatch: {}, busy: false,
      sendEnabled: false, dispatchEnabled: false,
    };

    /** 通知（内容別に色分けし、「何をすべきか」まで書く） */
    function mkNotify(kind, text, detail) {
      const box = $('mkNotices');
      if (!box) return;
      const el = document.createElement('div');
      el.className = 'notice notice-' + kind;
      const t = document.createElement('b'); t.textContent = text; el.appendChild(t);
      if (detail) { const d = document.createElement('span'); d.className = 'notice-d'; d.textContent = detail; el.appendChild(d); }
      const x = document.createElement('button'); x.type = 'button'; x.className = 'notice-x'; x.textContent = '×';
      x.addEventListener('click', () => el.remove());
      el.appendChild(x);
      box.prepend(el);
      while (box.children.length > 4) box.lastChild.remove();
    }

    /** 現在の母集団から dry-run の指紋を作る（確認した対象と送る対象のズレを検知する） */
    function mkFingerprint() {
      return flowApi().computeSelectionFingerprint({
        selectedIds: [...mkSelected], filters: mkState.filters,
        campaignId: mkState.campaignId, campaignVersion: mkState.campaignVersion,
      });
    }

    /** dry-run 結果を無効にする（選択・条件・キャンペーンが変わったとき） */
    function mkInvalidateDryRun(why) {
      if (!mkState.dryRun) return;
      mkState.dryRun = null;
      mkState.enqueued = false;
      mkState.dispatch = {};
      const panel = $('mkDryPanel');
      if (panel) { panel.hidden = true; panel.innerHTML = ''; }
      mkNotify('warn', '確認結果を無効にしました', why + ' もう一度 dry-run してください。');
      mkSyncFlow();
    }

    /** 状態 → 画面（ボタンの活性・ステップ表示・sticky バー）を一括更新する */
    function mkSyncFlow() {
      mkState.selectedIds = [...mkSelected];
      const st = { ...mkState, selectedIds: [...mkSelected] };
      const step = flowApi().resolveStep(st);
      for (const el of document.querySelectorAll('#mkSteps .stp')) {
        const n = Number(el.dataset.step);
        el.classList.toggle('is-now', n === step);
        el.classList.toggle('is-done', n < step);
      }
      const apply = (id, verdict, labelWhenOk) => {
        const btn = $(id);
        if (!btn) return;
        btn.disabled = !verdict.allowed;
        btn.title = verdict.allowed ? (labelWhenOk || '') : (flowApi().BLOCK_LABEL[verdict.reason] || '');
      };
      apply('mkDryRun', flowApi().canDryRun(st));
      apply('mkDispatchCheck', flowApi().canDispatchCheck(st));
      apply('mkDispatchRun', flowApi().canDispatchSend(st));

      const dry = $('mkDryState');
      if (dry) {
        const stale = mkState.dryRun ? flowApi().isDryRunStale({ dryRun: mkState.dryRun, current: st }) : true;
        dry.textContent = !mkState.dryRun ? '未確認'
          : stale ? '確認結果は無効（対象が変わりました）'
            : '確認済み: 送信対象 ' + (mkState.dryRun.willSend || 0) + ' 名';
        dry.className = 'dry-state ' + (!mkState.dryRun ? '' : stale ? 'is-stale' : 'is-ok');
      }

      // sticky バー（現在地と次の操作）
      const bar = $('mkStickyBar');
      if (bar) {
        bar.hidden = false;
        $('sbSel').textContent = mkSelected.size + ' 名を選択';
        $('sbCamp').textContent = mkState.campaign
          ? (mkState.campaign.name + ' v' + mkState.campaign.version + (mkState.campaign.testOnly ? '（テスト専用）' : ''))
          : 'キャンペーン未選択';
        $('sbDry').textContent = dry ? dry.textContent : '';
        $('sbGate').textContent = 'gate: 登録' + (mkState.sendEnabled ? '可' : '不可') + ' / 配信' + (mkState.dispatchEnabled ? '可' : '不可');
        const next = mkNextAction(st);
        const nb = $('sbNext');
        nb.textContent = next.label;
        nb.disabled = !next.target;
        nb.onclick = next.target ? () => { const t = $(next.target); if (t) { t.scrollIntoView({ block: 'center' }); t.focus?.(); } } : null;
      }
      const counts = $('mkStepCounts');
      if (counts) counts.textContent = '取得 ' + mkState.loadedCount + ' 名 / 選択 ' + mkSelected.size + ' 名';
    }

    /** 次に押すべきものを 1 つだけ示す */
    function mkNextAction(st) {
      if (mkSelected.size === 0) return { label: '顧客を選ぶ', target: 'mkSelAll' };
      if (!mkState.campaignId) return { label: 'キャンペーンを選ぶ', target: 'mkCampaign' };
      const enq = flowApi().canEnqueue(st);
      if (!enq.allowed && (enq.reason === 'no_dry_run' || enq.reason === 'dry_run_stale')) {
        return { label: '送信対象を確認', target: 'mkDryRun' };
      }
      if (!mkState.enqueued) return { label: 'キュー登録へ', target: 'mkDryRun' };
      if (!mkState.dispatch.check) return { label: '配信内容を確認', target: 'mkDispatchCheck' };
      return { label: '実際に配信する', target: 'mkDispatchRun' };
    }

    const DISPATCH_API = '/.netlify/functions/marketing-campaign-dispatch';
    async function mkDispatchCall(dryRun, jobId) {
      const secret = secretEl.value.trim();
      if (!secret) { $('connBody').hidden = false; throw new Error('管理シークレットを入力してください'); }
      const res = await fetch(DISPATCH_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        // jobId を渡すと、そのジョブだけが対象になる（他のキューを巻き込まない）
        body: JSON.stringify(jobId ? { dryRun, jobId } : { dryRun }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
      return data;
    }

    function mkRenderDispatch(data, dryRun) {
      const box = $('mkDispatchResult');
      box.innerHTML = '';
      const s = dossierSection(box, dryRun ? '確認結果（送信していません）' : '配信結果');
      dossierRow(s, '対象ジョブ', String(data.jobs || 0));
      dossierRow(s, '再検証した宛先', String(data.verified || 0));
      dossierRow(s, dryRun ? '送信される見込み' : '送信済み',
        String(dryRun ? (data.jobResults || []).reduce((a, j) => a + (j.willSend || 0), 0) : (data.sent || 0)),
        'ok');
      dossierRow(s, '送らない', String(dryRun
        ? (data.jobResults || []).reduce((a, j) => a + (j.willSkip || 0), 0)
        : (data.skipped || 0)));
      const reasons = data.skippedByReason || {};
      for (const k of Object.keys(reasons)) dossierRow(s, '　' + k, String(reasons[k]), 'sub-row');
      if (data.failed) dossierRow(s, '失敗', String(data.failed), 'ng');
      const sup = data.providerSuppression || {};
      dossierRow(s, '配信基盤の配信停止リスト照合',
        sup.available ? ('OK（' + (sup.total || 0) + ' 件）') : '確認できず（送信しません）',
        sup.available ? '' : 'ng');
    }

    $('mkDispatchCheck').addEventListener('click', async () => {
      const btn = $('mkDispatchCheck');
      btn.disabled = true;
      $('mkDispatchState').textContent = '確認中…';
      try {
        const data = await mkDispatchCall(true);
        mkRenderDispatch(data, true);
        const willSend = (data.jobResults || []).reduce((a, j) => a + (j.willSend || 0), 0);
        $('mkDispatchState').textContent = data.jobs
          ? '確認しました。この内容で配信できます。'
          : '送信待ちのキューはありません。';
        // 送る相手が 1 人もいないなら実行ボタンは開けない
        // 「これから送る 1 件」を確定させる。1 件に特定できなければ送らせない
        const preflight = sendApi().buildDispatchPreflight(data);
        mkState.dispatch = { ...mkState.dispatch, check: { willSend, jobs: data.jobs }, preflight, raw: data };
        if (!preflight.ok) {
          mkNotify('warn', '送信できません', sendApi().SEND_BLOCK_LABEL[preflight.reason] || '');
        }
        mkSyncFlow();
        if (!(data.jobs && willSend > 0)) {
          mkNotify('warn', '送信対象がありません', '送信待ちのジョブが無いか、再検証で全員除外されました。');
        }
      } catch (e) {
        $('mkDispatchState').textContent = '確認に失敗しました: ' + (e && e.message ? e.message : 'unknown');
        $('mkDispatchRun').disabled = true;
      } finally {
        btn.disabled = false;
      }
    });

    /** 送信系の判定の単一源（marketingSendNow.js） */
    const sendApi = () => window.__mkSend;

    $('mkDispatchRun').addEventListener('click', async () => {
      const btn = $('mkDispatchRun');
      if (btn.dataset.busy === '1') return;                  // 二重クリックで 2 回走らせない
      const c = mkState.campaign || currentCampaign();
      const sendState = {
        busy: mkState.busy, dispatchEnabled: mkState.dispatchEnabled,
        dryRun: mkState.dryRun,
        dryRunStale: mkState.dryRun ? flowApi().isDryRunStale({ dryRun: mkState.dryRun, current: { ...mkState, selectedIds: [...mkSelected] } }) : true,
        enqueued: mkState.enqueued, preflight: mkState.dispatch.preflight,
        sent: !!mkState.dispatch.sent, campaign: c,
      };
      const verdict = sendApi().canSendNow(sendState);
      if (!verdict.allowed) { mkNotify('warn', '送信できません', sendApi().SEND_BLOCK_LABEL[verdict.reason] || ''); return; }

      const operationId = 'send-' + (mkState.dispatch.preflight.jobId || 'job') + '-' + Date.now().toString(36);
      const conf = sendApi().buildSendNowConfirmation({
        campaign: c, dryRun: mkState.dryRun, preflight: mkState.dispatch.preflight,
        dispatchEnabled: mkState.dispatchEnabled, sendEnabled: mkState.sendEnabled, operationId,
      });

      // ① 内容を読ませる（何が起きるかを全部出す）
      const ok1 = window.confirm(
        '【今すぐ送信】' + conf.effect + '\n\n'
        + 'キャンペーン: ' + conf.campaignName + ' v' + conf.version + '（' + conf.kind + '）\n'
        + '宛先: ' + conf.audience + '\n'
        + '選択 ' + conf.selected + ' 名 / 対象 ' + conf.targeted + ' 名 / 除外 ' + conf.excluded + ' 名\n'
        + '実送信予定: ' + conf.willSend + ' 通\n'
        + 'jobId: ' + conf.jobId + '\n'
        + 'operationId: ' + conf.operationId + '\n'
        + 'gate: 登録' + (conf.gate.enqueue ? '可' : '不可') + ' / 配信' + (conf.gate.dispatch ? '可' : '不可') + '\n'
        + '二重送信防止: ' + conf.duplicateGuard + '\n'
        + conf.afterSend + '\n\n続けますか？'
      );
      if (!ok1) return;

      // ② 通常配信は送信予定人数の入力一致を必須にする
      let typed = '';
      if (conf.requiresTypedCount) {
        typed = window.prompt('確認のため、実送信予定人数「' + conf.willSend + '」を入力してください') || '';
      }

      btn.dataset.busy = '1';
      mkState.busy = true; mkSyncFlow();
      $('mkDispatchState').textContent = '送信直前の再確認中…';
      try {
        // ③ 直前にもう一度 dryRun:true を取り、**同じ jobId・同じ内容**であることを確かめる
        const latest = await mkDispatchCall(true, mkState.dispatch.preflight.jobId);
        const pre = sendApi().verifySendPrecondition({
          preflight: mkState.dispatch.preflight, latest,
          confirmedCount: conf.willSend, typedCount: typed, campaign: c,
        });
        if (!pre.ok) {
          mkState.busy = false; btn.dataset.busy = ''; mkSyncFlow();
          mkNotify('warn', '送信を中止しました', sendApi().SEND_BLOCK_LABEL[pre.reason] || '');
          $('mkDispatchState').textContent = '';
          return;
        }

        // ④ 実送信（既存 dispatcher のみ。対象は確認したジョブ 1 件に限定する）
        $('mkDispatchState').textContent = conf.willSend + ' 通を送信中…';
        const data = await mkDispatchCall(false, pre.jobId);
        const res = sendApi().summarizeSendResult(data, { completedAt: new Date().toISOString() });
        mkState.busy = false; btn.dataset.busy = '';
        // 送信後は直前確認を破棄する（同じ画面から二度押せない）
        mkState.dispatch = { sent: true, result: data, summary: res, check: null, preflight: null };
        mkRenderSendResult(conf, res);
        mkSyncFlow();
        if (res.outcome.key === 'PARTIAL' || res.outcome.key === 'FAILED') {
          mkNotify('warn', res.outcome.label + 'で終了しました', res.partialNote || '失敗理由を確認してください。再送は自動では行いません。');
        } else {
          mkNotify('ok', '送信しました', res.sent + ' 通を配信基盤が受理しました。' + res.deliveredNote);
        }
      } catch (e) {
        mkState.busy = false; btn.dataset.busy = ''; mkSyncFlow();
        mkNotify('err', '送信に失敗しました',
          '配信基盤へ到達できませんでした。Step 6 の送信状況で、実際に送られたかを必ず確認してください（再送は自動では行いません）。');
        $('mkDispatchState').textContent = '';
      }
    });

    /** 送信結果を画面内に出す（取消不可・部分成功・受理と配信の別を明示） */
    function mkRenderSendResult(conf, res) {
      const box = $('mkDispatchResult');
      if (!box) return;
      box.innerHTML = '';
      const head = document.createElement('div');
      const badge = document.createElement('span');
      badge.className = 'badge b-' + res.outcome.tone;
      badge.textContent = res.outcome.label;
      head.appendChild(badge);
      const t = document.createElement('b');
      t.textContent = ' ' + conf.campaignName + ' v' + conf.version + '（' + conf.kind + '）';
      head.appendChild(t);
      box.appendChild(head);

      const row = (k, v) => {
        const d = document.createElement('div'); d.className = 'dp-row';
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); box.appendChild(d);
      };
      row('送信（provider 受理）', res.sent + ' 通');
      row('スキップ', res.skipped + ' 通');
      row('失敗', res.failed + ' 通');
      row('ジョブ', conf.jobId + '（' + res.outcome.label + '）');
      row('完了時刻', res.completedAt ? fmtDate(res.completedAt) : '—');
      row('取消', res.cancelNote);
      if (res.skippedReasons.length) {
        row('除外理由', res.skippedReasons.map((x) => (window.__planView?.labelFor?.(x.reason) || x.reason) + ' ' + x.count + ' 件').join(' / '));
      }
      if (res.partialNote) row('部分成功の扱い', res.partialNote);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = res.deliveredNote;
      box.appendChild(note);
    }

    $('mkLoad').addEventListener('click', mkLoad);
    $('mkQ').addEventListener('input', mkRender);
    // 選択の更新は純粋モジュールへ委譲（絞り込みを変えても選択が勝手に増えない）。
    // 「全顧客から選択」= いま読み込んでいる全件（検索・絞り込みに依存しない）
    // 「表示中のみ選択」= 画面に出ている行だけ
    $('mkSelAllLoaded').addEventListener('click', () => {
      const all = (mkData && mkData.rows) ? mkData.rows : [];
      const before = mkSelected.size;
      const next = window.__planView.updateSelection({
        current: mkSelected,
        visibleIds: all.map((r) => r.recordId),
        selectableIds: all.filter((r) => r.sendable).map((r) => r.recordId),
        op: 'add-visible',
      });
      mkSelected.clear();
      for (const id of next) mkSelected.add(id);
      mkRender();
      // 大量選択を黙って行わない
      mkMsg('全顧客から ' + (mkSelected.size - before) + ' 名を追加しました（合計 ' + mkSelected.size + ' 名 / 読み込み済み ' + all.length + ' 名中）');
    });

    $('mkSelAll').addEventListener('click', () => {
      const visible = mkVisibleRows();
      const next = window.__planView.updateSelection({
        current: mkSelected,
        visibleIds: visible.map((r) => r.recordId),
        // 送信できない相手は選ばせない（UI 側でも fail closed）
        selectableIds: visible.filter((r) => r.sendable).map((r) => r.recordId),
        op: 'add-visible',
      });
      mkSelected.clear();
      for (const id of next) mkSelected.add(id);
      mkRender();
      mkMsg('表示中から ' + mkSelected.size + ' 名を選択中です（表示 ' + visible.length + ' 名）');
    });
    $('mkSelNone').addEventListener('click', () => {
      const next = window.__planView.updateSelection({ current: mkSelected, op: 'clear' });
      mkSelected.clear();
      for (const id of next) mkSelected.add(id);
      mkRender();
    });
    $('mkSelList').addEventListener('click', () => {
      const body = mkOpenModal('選択中の顧客（' + mkSelected.size + ' 名）');
      const byId = new Map((mkData && mkData.rows ? mkData.rows : []).map((r) => [r.recordId, r]));
      const s = dossierSection(body, '選択は recordId で保持しています');
      for (const id of mkSelected) {
        const r = byId.get(id);
        dossierRow(s, r ? (r.name || r.email || id) : id,
          r ? (r.email + ' / ' + (CONTRACT_LABEL[r.contract] || r.contract)) : '（現在の絞り込みに表示されていません）',
          r ? '' : 'ng');
      }
    });

    // ── モーダル（プレビュー / dry-run 確認）──
    function mkOpenModal(title) {
      $('mkModalTitle').textContent = title;
      $('mkBackdrop').hidden = false;
      lockScroll();
      $('mkModalBody').innerHTML = '';
      return $('mkModalBody');
    }
    function mkCloseModal() {
      $('mkBackdrop').hidden = true;
      if ($('dtBackdrop').hidden && $('pvBackdrop').hidden) unlockScroll();
    }
    $('mkModalClose').addEventListener('click', mkCloseModal);
    $('mkModalBack').addEventListener('click', mkCloseModal);
    $('mkBackdrop').addEventListener('click', (e) => { if (e.target === $('mkBackdrop')) mkCloseModal(); });

    // ── 本文プレビュー ──
    $('mkPreview').addEventListener('click', async () => {
      const c = currentCampaign();
      if (!c) { mkMsg('キャンペーンを選択してください', 'err'); return; }
      const data = await mkCall({ action: 'preview', campaignId: c.campaignId, sampleName: '山田' });
      if (!data) return;
      const body = mkOpenModal('本文プレビュー');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const h = document.createElement('h3'); h.textContent = '件名'; sec.appendChild(h);
      const sub = document.createElement('p'); sub.className = 'prev-subject'; sub.textContent = data.subject;
      sec.appendChild(sub);
      body.appendChild(sec);

      const sec2 = document.createElement('div'); sec2.className = 'dt-sec';
      const h2 = document.createElement('h3'); h2.textContent = '本文'; sec2.appendChild(h2);
      const frame = document.createElement('iframe');
      frame.className = 'prev-frame';
      frame.setAttribute('sandbox', ''); // スクリプト実行なし
      // 実際の受信環境に近い白地でメール本文だけを表示する（管理 UI の配色を混ぜない）
      frame.srcdoc = '<body style="margin:0;background:#fff;">' + data.html + '</body>';
      sec2.appendChild(frame);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec2.appendChild(note);
      body.appendChild(sec2);
    });

    // ── dry-run → 最終確認 → 送信 ──
    $('mkDryRun').addEventListener('click', async () => {
      const c = currentCampaign();
      const verdict = flowApi().canDryRun({ ...mkState, selectedIds: [...mkSelected] });
      if (!verdict.allowed) { mkNotify('warn', '実行できません', flowApi().BLOCK_LABEL[verdict.reason]); return; }
      if (!c.usable) { mkNotify('err', '使用停止中のキャンペーンです', c.disabledReason || ''); return; }
      // 押した瞬間に必ず表示を変える（無反応を作らない）
      mkState.busy = true; mkSyncFlow();
      $('mkDryState').textContent = '確認中…';
      $('mkDryState').className = 'dry-state';
      mkMsg('対象を確認中…');
      mkNotify('info', '送信対象を確認しています…', '選択 ' + mkSelected.size + ' 名 / ' + (c.name || ''));
      let plan = null;
      try {
        plan = await mkCall({
          action: 'dryRun', campaignId: c.campaignId, recordIds: [...mkSelected],
        });
      } catch (e) {
        plan = null;
      }
      mkState.busy = false;
      if (!plan) {
        // API 失敗でも必ず理由と次の操作を出す
        $('mkDryState').textContent = '確認に失敗しました';
        $('mkDryState').className = 'dry-state is-stale';
        mkNotify('err', '送信対象を確認できませんでした',
          '管理シークレット・ネットワーク・選択内容を確認して、もう一度お試しください。');
        mkMsg('');
        mkSyncFlow();
        return;
      }
      mkMsg('');
      if ((Number(plan.willSend) || 0) === 0) {
        mkNotify('warn', '対象者がいません',
          '選択 ' + plan.selected + ' 名すべてが除外されました（除外 ' + plan.excluded + ' 名）。除外理由を確認してください。');
      } else {
        mkNotify('ok', '確認しました', '対象 ' + plan.willSend + ' 名 / 除外 ' + plan.excluded + ' 名');
      }
      // この結果が「どの母集団に対する確認か」を指紋で固定する
      mkState.dryRun = {
        fingerprint: mkFingerprint(),
        selected: plan.selected, excluded: plan.excluded, willSend: plan.willSend,
        excludedDetail: plan.excludedDetail, planFingerprint: plan.planFingerprint,
      };
      mkState.enqueued = false;
      mkState.dispatch = {};
      mkRenderDryPanel(c, plan);
      mkSyncFlow();
      mkRenderConfirm(c, plan);
    });

    /** dry-run の結果を主要パネルへ（確認 → 登録の判断材料を 1 か所に集める） */
    function mkRenderDryPanel(c, plan) {
      const panel = $('mkDryPanel');
      if (!panel) return;
      panel.hidden = false;
      panel.innerHTML = '';
      const row = (k, v, cls) => {
        const d = document.createElement('div'); d.className = 'dp-row ' + (cls || '');
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); panel.appendChild(d);
      };
      row('キャンペーン', c.name + ' v' + c.version + (c.testOnly ? '（🧪 テスト専用）' : ''));
      row('選択人数', plan.selected + ' 名');
      row('送信対象', plan.willSend + ' 名', plan.willSend > 0 ? 'is-ok' : 'is-ng');
      row('除外', plan.excluded + ' 名');
      const ex = flowApi().summarizeExclusions(plan.excludedDetail || []);
      if (ex.length) {
        const box = document.createElement('div'); box.className = 'dp-ex';
        const t = document.createElement('b'); t.textContent = '除外理由（送信できない理由。失敗ではありません）';
        box.appendChild(t);
        const ul = document.createElement('ul');
        for (const e of ex) {
          const li = document.createElement('li');
          li.textContent = (window.__planView?.labelFor?.(e.reason) || e.reason) + ' … ' + e.count + ' 名';
          ul.appendChild(li);
        }
        box.appendChild(ul); panel.appendChild(box);
      }
      row('gate', '登録' + (mkState.sendEnabled ? '可' : '不可') + ' / 配信' + (mkState.dispatchEnabled ? '可' : '不可'),
        mkState.sendEnabled ? '' : 'is-ng');
      row('二重送信防止', '同一 campaign×version×宛先は DeliveryKey で 1 通に固定（再実行しても増えない）');
      row('確認 ID', String(plan.planFingerprint || '').slice(0, 12) + '…（対象が変わると無効）');
      row('実行すると', 'キューに登録されます。ここではまだ 1 通も送られません。');
    }

    function mkRenderConfirm(campaign, plan) {
      const body = mkOpenModal('送信内容の確認');

      const head = document.createElement('div'); head.className = 'dt-sec';
      const h = document.createElement('h3');
      h.textContent = (campaign.testOnly ? '🧪 ' : '') + campaign.name + ' v' + campaign.version;
      head.appendChild(h);
      if (campaign.testOnly) {
        const t = document.createElement('p'); t.className = 'testonly';
        t.textContent = '🧪 運用テスト専用。テスト受信者以外は自動的に除外されます。';
        head.appendChild(t);
      }
      const dl = document.createElement('dl'); dl.className = 'kv';
      // 配信台帳の CampaignType と同じ表記。名前が似たキャンペーンの取り違えを防ぐ
      kvRow(dl, 'キャンペーンID', campaign.campaignId + ':v' + campaign.version);
      kvRow(dl, '件名', plan.subject);
      // 割引案内は「何をいくらで案内するか」を最終確認に出す（金額の取り違え防止）
      const os = plan.offerSummary;
      if (os) {
        kvRow(dl, 'オファー種別', os.offerId);
        kvRow(dl, '通常価格', '¥' + Number(os.regularPrice || 0).toLocaleString());
        kvRow(dl, 'オファー価格',
          '¥' + Number(os.offerPrice || 0).toLocaleString() + '（' + os.discountPercent + '%OFF）', 'strong-ok');
        kvRow(dl, '有効期限（最短）',
          os.earliestExpiresAt ? String(os.earliestExpiresAt).slice(0, 10) : '（有効なオファーなし）');
        kvRow(dl, 'CTA', (os.ctaLabel || '') + ' → ' + os.ctaKind);
        kvRow(dl, '発行済みオファー', os.liveOffers + ' 件（有効・期限内）');
      }
      kvRow(dl, '選択', plan.selected + ' 名');
      kvRow(dl, '除外', plan.excluded + ' 名');
      kvRow(dl, '実送信', plan.willSend + ' 名', plan.willSend > 0 ? 'strong-ok' : 'muted');
      head.appendChild(dl);
      body.appendChild(head);

      if (plan.excludedDetail && plan.excludedDetail.length) {
        const sec = document.createElement('div'); sec.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '除外の内訳'; sec.appendChild(h2);

        // 理由をグループへ束ねて出す（何がどれだけ落ちたかを分類で把握できるように）
        const GROUPS = [
          ['キャンペーン条件外', ['contract_mismatch', 'plan_mismatch', 'campaign_mismatch']],
          ['割引オファー未発行・不一致', ['offer_missing', 'offer_ambiguous', 'offer_mismatch', 'offer_secret_unavailable']],
          ['配信停止・除外リスト', ['unsubscribed', 'blacklist', 'soft_bounce', 'withdrawn', 'suspended', 'test_account', 'no_email', 'invalid_email']],
          ['最近マーケティング送信済み', ['recent_marketing_contact']],
          ['配信基盤の配信停止', ['provider_suppressed']],
          ['その他', ['already_delivered', 'duplicate', 'unknown_customer']],
        ];
        const byReason = {};
        for (const e of plan.excludedDetail) byReason[e.reason] = e;

        const ul = document.createElement('ul'); ul.className = 'exlist';
        let shown = 0;
        for (const g of GROUPS) {
          const label = g[0], reasons = g[1];
          const items = reasons.map((r) => byReason[r]).filter(Boolean);
          if (items.length === 0) continue;
          const total = items.reduce((s, e) => s + e.count, 0);
          shown += total;
          const li = document.createElement('li');
          const strong = document.createElement('strong');
          strong.textContent = label + '　' + total + ' 名';
          li.appendChild(strong);
          const sub = document.createElement('ul'); sub.className = 'exlist sub';
          for (const e of items) {
            const li2 = document.createElement('li');
            li2.textContent = e.label + '　' + e.count + ' 名';
            sub.appendChild(li2);
          }
          li.appendChild(sub);
          ul.appendChild(li);
        }
        // 分類に載らない理由が出ても件数を落とさない
        if (shown < plan.excluded) {
          const li = document.createElement('li');
          li.textContent = '未分類　' + (plan.excluded - shown) + ' 名';
          ul.appendChild(li);
        }
        sec.appendChild(ul);
        body.appendChild(sec);
      }

      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const h3 = document.createElement('h3'); h3.textContent = '送信'; sec3.appendChild(h3);
      const state = document.createElement('p'); state.className = 'note';
      state.textContent = plan.sendEnabled
        ? (plan.dispatchEnabled
          ? 'キャンペーン配信は有効です。実行すると実際にメールが配信されます。'
          : '実行するとキューに登録されますが、キャンペーン配信が無効なため実送信はされません。')
        : '送信は無効（MARKETING_CAMPAIGN_ENABLED 未設定）です。実行できません。';
      sec3.appendChild(state);

      // provider 側の配信停止をどれだけ確認できたかを明示する（確認できていないなら送らせない）
      const ps = plan.providerSuppression;
      if (ps) {
        const psNote = document.createElement('p');
        psNote.className = ps.available ? 'note' : 'blocker';
        psNote.textContent = ps.available
          ? `配信基盤の配信停止リスト ${ps.total} 件と照合済み`
          : `⚠️ 配信基盤の配信停止リストを確認できませんでした（${ps.error}）。この状態では送信できません。`;
        sec3.appendChild(psNote);
      }

      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-immediate';
      btn.textContent = plan.willSend + ' 名へ送信する';
      btn.disabled = !plan.sendEnabled || plan.willSend === 0;
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;      // 二重クリック防止
        const ok = window.confirm(
          campaign.name + ' v' + campaign.version + '\n\n'
          + '送信対象: ' + plan.selected + ' 名\n'
          + '除外: ' + plan.excluded + ' 名\n'
          + '実送信: ' + plan.willSend + ' 名\n\n'
          + 'この内容で送信しますか？'
        );
        if (!ok) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        btn.textContent = '送信登録中…';
        const out = await mkCall({
          action: 'send',
          campaignId: campaign.campaignId,
          recordIds: [...mkSelected],
          planFingerprint: plan.planFingerprint,   // 対象が変わっていたら Function 側が中止する
        });
        btn.dataset.busy = '';
        if (out) {
          // 登録できた ＝ 次は「送信直前の確認」。ここではまだ 1 通も送られていない
          mkState.enqueued = true;
          mkState.dispatch = {};
          mkNotify('ok', 'キューに登録しました（まだ送信されていません）',
            (out.queued || 0) + ' 名分。Step 5 の「配信内容を確認」→「実際に配信する」で送信します。');
          mkMsg(out.notice || ('登録しました: ' + out.queued + ' 名'), 'ok');
          mkSelected.clear();
          mkCloseModal();
          mkSyncFlow();
          await mkLoad();
        } else {
          btn.textContent = '再試行';
          btn.disabled = false;
        }
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    }

    // ── 送信状況（予定 / 送信済 / 失敗 / 取消）と取消操作 ──
    // 「いま何が送信待ちか」「どれが失敗したか」「取り消せるのか」を 1 画面で出す。
    // 送信は取り返しがつかないので、**止められる状態**を運用者に持たせる。
    const JOB_STATUS_LABEL = {
      PENDING: '送信待ち', SENT: '送信済み', FAILED: '失敗', CANCELLED: '取消済み',
    };
    const CANCEL_REASON_LABEL = {
      already_sent: '送信済みのため取消不可（メールは取り消せません）',
      already_failed: '送信を試行済みのため取消不可',
      already_cancelled: '取消済み',
      not_marketing_job: 'マーケティングジョブではない',
      job_not_found: 'ジョブが見つからない',
      unknown_status: '状態を判定できない',
    };

    async function mkRenderJobs() {
      const data = await mkCall({ action: 'jobs' });
      if (!data) return;
      const body = mkOpenModal('キャンペーン送信状況');

      // gate 状態は最初に出す。閉じているなら「なぜ送られないか」を明示する
      const gate = document.createElement('div'); gate.className = 'dt-sec';
      const gh = document.createElement('h3'); gh.textContent = '① 送信ゲート'; gate.appendChild(gh);
      dossierRow(gate, 'キュー登録', data.sendEnabled ? '有効' : '無効（MARKETING_CAMPAIGN_ENABLED 未設定）',
        data.sendEnabled ? 'ok' : 'ng');
      dossierRow(gate, '実送信', data.dispatchEnabled ? '有効' : '無効（MARKETING_CAMPAIGN_DISPATCH_ENABLED 未設定）',
        data.dispatchEnabled ? 'ok' : 'ng');
      const gn = document.createElement('p'); gn.className = 'tl-note'; gn.textContent = '⚠️ ' + data.notice;
      gate.appendChild(gn);
      const auto = document.createElement('p'); auto.className = 'tl-note';
      auto.textContent = '⚠️ ゲートが有効でも、この画面から実行しない限り自動送信はされません（定期実行に載っていません）。';
      gate.appendChild(auto);
      body.appendChild(gate);

      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const h = document.createElement('h3'); h.textContent = '② ジョブ一覧（新しい順）'; sec.appendChild(h);
      if (!data.jobs.length) {
        const p = document.createElement('p'); p.className = 'tl-note'; p.textContent = 'キャンペーンジョブはまだありません。';
        sec.appendChild(p);
      }
      for (const j of data.jobs) {
        const box = document.createElement('div'); box.className = 'tl-row';
        const head = document.createElement('div');
        const badge = flowApi().resolveJobBadge({ status: j.status, counts: j.counts });
        const b = document.createElement('span');
        b.className = 'badge b-' + badge.tone;
        b.textContent = badge.label;
        head.appendChild(b);
        const ttl = document.createElement('b');
        ttl.textContent = ' ' + (j.campaignId || '(不明)') + (j.version ? ' v' + j.version : '');
        head.appendChild(ttl);
        const when = document.createElement('span'); when.className = 'tl-src';
        when.textContent = ' 作成 ' + (j.scheduledFor ? fmtDate(j.scheduledFor) : '—')
          + ' / 実行者 admin-marketing / job ' + String(j.jobId || '').slice(-12);
        head.appendChild(when);
        box.appendChild(head);

        const c = j.counts || {};
        const counts = document.createElement('div'); counts.className = 'tl-detail';
        counts.textContent = '対象 ' + j.recipientCount + ' 名 ／ 送信待ち ' + (c.queued || 0)
          + ' ／ 送信済 ' + (c.sent || 0) + ' ／ 失敗 ' + (c.failed || 0)
          + ' ／ スキップ ' + (c.skipped || 0) + ' ／ 取消 ' + (c.cancelled || 0);
        box.appendChild(counts);

        // 失敗・スキップの理由は分類として出す（アドレスは出さない）
        const reasons = Object.entries(j.errorReasons || {});
        if (reasons.length) {
          const rl = document.createElement('div'); rl.className = 'tl-detail';
          rl.textContent = '理由: ' + reasons.map(([k, v]) => k + ' ' + v + ' 件').join(' / ');
          box.appendChild(rl);
        }

        const ops = document.createElement('div'); ops.className = 'ops';
        if (j.cancelable) {
          const btn = document.createElement('button');
          btn.type = 'button'; btn.className = 'b-immediate'; btn.textContent = '送信予定を取り消す';
          btn.addEventListener('click', async () => {
            if (btn.dataset.busy === '1') return;
            // 二段階確認: 取消も取り返しの効く操作ではないため、内容を読ませてから実行する
            const ok1 = window.confirm(
              '送信予定を取り消します。\n\n'
              + 'キャンペーン: ' + (j.campaignId || '') + (j.version ? ' v' + j.version : '') + '\n'
              + '送信待ち: ' + (c.queued || 0) + ' 件\n'
              + '送信済み: ' + (c.sent || 0) + ' 件（**取り消しません**）\n\n'
              + '続けますか？'
            );
            if (!ok1) return;
            const typed = window.prompt('確認のため CANCEL と入力してください');
            if (String(typed || '').trim().toUpperCase() !== 'CANCEL') { mkMsg('取消を中止しました。', 'ng'); return; }
            btn.dataset.busy = '1'; btn.disabled = true; btn.textContent = '取消中…';
            // 同じ取消を 2 回押しても 2 重に書かないための操作 ID
            const operationId = 'cancel-' + j.jobId + '-' + Date.now().toString(36);
            const out = await mkCall({ action: 'cancelJob', jobId: j.jobId, operationId });
            btn.dataset.busy = '';
            if (out && out.cancelled) {
              mkMsg(out.notice || '取り消しました', 'ok');
              mkCloseModal();
              await mkRenderJobs();
            } else {
              btn.textContent = '再試行';
              btn.disabled = false;
            }
          });
          ops.appendChild(btn);
        } else {
          const p = document.createElement('span'); p.className = 'tl-src';
          p.textContent = CANCEL_REASON_LABEL[j.cancelReason] || '取消不可';
          ops.appendChild(p);
        }
        box.appendChild(ops);
        sec.appendChild(box);
      }
      const note = document.createElement('p'); note.className = 'tl-note';
      note.textContent = '⚠️ ' + data.cancelNote + ' 「送信済み」は配信基盤が受理した状態で、実際に届いたか（delivered）とは別です。';
      sec.appendChild(note);
      body.appendChild(sec);
    }

    $('mkJobsBtn').addEventListener('click', mkRenderJobs);

    // ── 送信履歴 ──
    $('mkHistoryBtn').addEventListener('click', async () => {
      const data = await mkCall({ action: 'history' });
      if (!data) return;
      const body = mkOpenModal('キャンペーン送信履歴');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      if (!data.runs.length) {
        sec.textContent = '送信履歴はまだありません。';
      } else {
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const r of data.runs) {
          const li = document.createElement('li');
          li.textContent = r.campaignType + '　登録 ' + r.queued + ' / 処理済 ' + r.sent
            + ' / 失敗 ' + r.failed + ' / スキップ ' + r.skipped + '　' + fmtDate(r.lastAt);
          ul.appendChild(li);
        }
        sec.appendChild(ul);
      }
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec.appendChild(note);
      body.appendChild(sec);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$('mkBackdrop').hidden) mkCloseModal();
    });

    // ══════════════════════════════════════════════════════════════
    //  カムバック特典（無料 entitlement の付与）
    //  ⚠️ メール送信とは別機能。ここから 1 通もメールを送らない。
    //  ⚠️ 変更するのは特典専用フィールドのみ。課金・契約・Plus 販売資格は触らない。
    // ══════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════
    //  カムバック特典タブ: 操作順の管理
    //  押せる／押せないの根拠は comebackConsoleFlow.js（単一源）。画面は従うだけ。
    // ══════════════════════════════════════════════════════════════
    const cbApi = () => window.__cbFlow;
    const cbState = {
      loaded: false, candidateCount: 0, selectedCount: 0,
      offer: { lightOffer: 'none', premiumOffer: 'none' },
      dryRun: null, dryStale: false, applied: false, busy: false,
      offerSummaryShort: '未設定',
    };

    /** 通知（内容別。gate や失効の理由をここに出す） */
    function cbNotify(kind, text, detail) {
      const box = $('cbNotices');
      if (!box) return;
      const el = document.createElement('div');
      el.className = 'notice notice-' + kind;
      const t = document.createElement('b'); t.textContent = text; el.appendChild(t);
      if (detail) { const d = document.createElement('span'); d.className = 'notice-d'; d.textContent = detail; el.appendChild(d); }
      const x = document.createElement('button'); x.type = 'button'; x.className = 'notice-x'; x.textContent = '×';
      x.addEventListener('click', () => el.remove());
      el.appendChild(x);
      box.prepend(el);
      while (box.children.length > 4) box.lastChild.remove();
    }

    /** いまの特典設定を読む */
    function cbCurrentOffer() {
      return {
        lightOffer: $('cbLightOffer')?.value || 'none',
        lightDays: $('cbLightDays')?.value || '',
        premiumOffer: $('cbPremiumOffer')?.value || 'none',
        premiumDays: $('cbPremiumDays')?.value || '',
        premiumPrice: $('cbPremiumPrice')?.value || '',
      };
    }

    /** 確認結果の指紋（条件・選択・特典） */
    function cbFingerprint() {
      return cbApi().computeCbFingerprint({
        filters: { contract: $('cbContract')?.value || '', plan: $('cbPlan')?.value || '',
          withdrawn: $('cbWithdrawn')?.value || '', promo: $('cbPromo')?.value || '',
          grantable: $('cbGrantable')?.value || '', history: $('cbHistory')?.value || '',
          q: $('cbQ')?.value || '' },
        selectedIds: [...cbSelected],
        offer: cbCurrentOffer(),
      });
    }

    /** 確認結果を失効させる */
    function cbInvalidate(why) {
      if (!cbState.dryRun) return;
      cbState.dryStale = true;
      const p = $('cbReviewPanel');
      if (p) { p.hidden = true; p.innerHTML = ''; }
      cbNotify('warn', '確認結果を無効にしました', why + ' もう一度「付与内容を確認」を押してください。');
      cbSync();
    }

    /** 状態 → 画面（段階の強調・操作可否・追従バー） */
    function cbSync() {
      cbState.selectedCount = cbSelected.size;
      cbState.offer = cbCurrentOffer();
      cbState.offerSummaryShort = cbOfferShortLabel();
      if (cbState.dryRun) {
        cbState.dryStale = cbApi().isCbDryStale({ dryRun: cbState.dryRun, current: {
          filters: { contract: $('cbContract')?.value || '', plan: $('cbPlan')?.value || '',
            withdrawn: $('cbWithdrawn')?.value || '', promo: $('cbPromo')?.value || '',
            grantable: $('cbGrantable')?.value || '', history: $('cbHistory')?.value || '',
            q: $('cbQ')?.value || '' },
          selectedIds: [...cbSelected], offer: cbCurrentOffer(),
        } });
      }
      const step = cbApi().resolveCbStep(cbState);
      for (const el of document.querySelectorAll('#cbSteps .stp')) {
        const n = Number(el.dataset.cbstep);
        el.classList.toggle('is-now', n === step);
        el.classList.toggle('is-done', n < step);
      }
      // 未到達の段階は薄く・操作不可にする
      for (const card of document.querySelectorAll('.cb-step')) {
        const n = Number(card.dataset.cbcard);
        const reached = n <= step;
        card.classList.toggle('is-locked', !reached);
        card.classList.toggle('is-now', n === step);
        card.classList.toggle('is-done', n < step);
        for (const c of card.querySelectorAll('button, select, input')) {
          if (c.dataset.always === '1') continue;
          c.disabled = !reached;
        }
      }
      const dry = cbApi().canReview(cbState);
      const btn = $('cbDryRun');
      if (btn) { btn.disabled = !dry.allowed; btn.title = dry.allowed ? '' : (dry.reason || ''); }
      const apply = cbApi().canApply(cbState);
      const ab = $('cbApplyBtn');
      if (ab) { ab.disabled = !apply.allowed; ab.title = apply.allowed ? '' : (apply.reason || ''); }
      const lock5 = $('cbStep5Lock');
      if (lock5) lock5.textContent = apply.allowed ? '確認済みです。実行できます。' : (apply.reason || '');
      const lock3 = $('cbStep3Lock');
      if (lock3) {
        const cfg = cbApi().canConfigureOffer(cbState);
        lock3.textContent = cfg.allowed ? '' : (cfg.reason || '');
        lock3.hidden = cfg.allowed;
      }
      const empty2 = $('cbStep2Empty');
      if (empty2) empty2.hidden = cbState.loaded;
      const counts = $('cbStepCounts');
      if (counts) counts.textContent = cbState.loaded ? ('候補 ' + cbState.candidateCount + ' 名 / 選択 ' + cbSelected.size + ' 名') : '';

      const sum = $('cbOfferSummary');
      if (sum) {
        const text = cbApi().describeOfferSelection({
          count: cbSelected.size,
          lightLabel: cbOfferLabel('cbLightOffer'),
          premiumLabel: cbOfferLabel('cbPremiumOffer'),
        });
        sum.textContent = text;
        sum.hidden = cbSelected.size === 0;
      }

      const bar = $('cbStickyBar');
      if (bar) {
        bar.hidden = false;
        const v = cbApi().buildCbStickyView(cbState);
        $('cbSbLeft').textContent = v.left;
        $('cbSbOffer').textContent = v.offer;
        $('cbSbReview').textContent = v.review;
        $('cbSbNext').textContent = v.next;
      }
    }

    /** 選択肢のラベル（「付与しない」は空にする） */
    function cbOfferLabel(id) {
      const el = $(id);
      if (!el || !el.value || el.value === 'none') return '';
      return el.options[el.selectedIndex]?.textContent?.trim() || '';
    }
    function cbOfferShortLabel() {
      const l = cbOfferLabel('cbLightOffer');
      const p = cbOfferLabel('cbPremiumOffer');
      if (!l && !p) return '未設定';
      return (l || 'Light なし') + ' / ' + (p || 'Premium なし');
    }

    /** 条件を変えたら要約を出し、現有効会員なら警告する */
    function cbRenderFilterDesc() {
      const v = $('cbContract')?.value || 'candidates';
      const d = $('cbFilterDesc');
      if (d) d.textContent = cbApi().describeContractFilter(v);
      if (v === 'active') cbNotify('warn', '通常の対象ではありません', cbApi().ACTIVE_FILTER_WARNING);
      cbInvalidate('対象条件が変わりました。');
      cbSync();
    }
    for (const id of ['cbContract', 'cbPlan', 'cbWithdrawn', 'cbPromo', 'cbGrantable', 'cbHistory', 'cbQ']) {
      document.getElementById(id)?.addEventListener('change', cbRenderFilterDesc);
    }
    for (const id of ['cbLightOffer', 'cbLightDays', 'cbPremiumOffer', 'cbPremiumDays', 'cbPremiumPrice']) {
      document.getElementById(id)?.addEventListener('change', () => {
        cbInvalidate('特典の内容が変わりました。');
        cbSync();
      });
    }
    $('cbViewSelected')?.addEventListener('click', () => {
      cbState.viewSelected = !cbState.viewSelected;
      $('cbViewSelected').textContent = cbState.viewSelected ? 'すべて表示' : '選択者のみ表示';
      cbRender();
    });

    const CB_API = '/.netlify/functions/admin-comeback-grants';

    let cbData = null;                 // 直近の customers 応答
    let cbCatalog = null;              // 特典カタログ（Light / Premium無料 / Premium割引）
    let cbWriteEnabled = false;        // 実行が有効か（本番は既定 false）
    let cbLastOperationId = '';        // 直近の dry-run / 実行の操作 ID（再開・突合用）
    const cbSelected = new Set();      // 選択中の recordId

    function cbMsg(text, kind) {
      const el = $('cbMessage');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function cbCall(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { cbMsg('管理シークレットを入力してください', 'err'); $('connBody').hidden = false; return null; }
      const res = await fetch(CB_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        // 503（gate 無効）/ 409（対象変化）/ 502（部分失敗）は理由をそのまま出す
        cbMsg((data.error || ('エラー: ' + res.status)) + (data.howToRecover ? '　' + data.howToRecover : ''), 'err');
        return null;
      }
      return data;
    }

    function cbFillSelect(id, offers, noneLabel) {
      const sel = $(id);
      sel.innerHTML = '';
      const none = document.createElement('option');
      none.value = 'none';
      none.textContent = noneLabel;
      sel.appendChild(none);
      for (const o of offers) {
        const opt = document.createElement('option');
        opt.value = o.offerId;
        opt.textContent = o.name;
        opt.dataset.customDays = o.requiresCustomDays ? '1' : '';
        opt.dataset.customPrice = o.requiresCustomPrice ? '1' : '';
        opt.dataset.kind = o.kind;
        opt.dataset.regularPrice = String(o.regularPrice);
        sel.appendChild(opt);
      }
    }

    async function cbLoadOffers() {
      const data = await cbCall({ action: 'offers' });
      if (!data) return;
      cbCatalog = data;
      cbWriteEnabled = !!data.writeEnabled;

      cbFillSelect('cbLightOffer', data.lightOffers, 'なし');
      // Premium は「無料付与」と「割引購入」を 1 つのセレクトに分けて入れる（種類は option に持たせる）
      const premium = [...data.premiumGrantOffers, ...data.premiumPurchaseOffers];
      cbFillSelect('cbPremiumOffer', premium, 'なし');

      // 主要施策を既定値に（Light 永久無料 ＋ Premium 30日無料）
      if (data.lightOffers.some((o) => o.offerId === 'light-lifetime-free')) {
        $('cbLightOffer').value = 'light-lifetime-free';
      }
      cbRenderOfferDesc();
      $('cbGateState').textContent = data.notice || '';
      $('cbGateState').className = 'note' + (data.writeEnabled ? '' : ' off');
    }

    function cbSelectedOption(id) {
      const sel = $(id);
      return sel.options[sel.selectedIndex] || null;
    }

    /** 選択内容 → API へ渡す payload（任意日数・任意価格を含む） */
    function cbSelectionPayload() {
      const light = $('cbLightOffer').value;
      const premium = $('cbPremiumOffer').value;
      const out = {};
      if (light && light !== 'none') {
        out.lightOfferId = light;
        if (cbSelectedOption('cbLightOffer').dataset.customDays) {
          out.lightCustomDays = Number($('cbLightDays').value);
        }
      }
      if (premium && premium !== 'none') {
        out.premiumOfferId = premium;
        const opt = cbSelectedOption('cbPremiumOffer');
        if (opt.dataset.customDays) out.premiumCustomDays = Number($('cbPremiumDays').value);
        if (opt.dataset.customPrice) out.premiumCustomPrice = Number($('cbPremiumPrice').value);
      }
      return out;
    }

    /** 任意入力欄の出し分け＋価格の内訳表示 */
    function cbRenderOfferDesc() {
      const lightOpt = cbSelectedOption('cbLightOffer');
      const premiumOpt = cbSelectedOption('cbPremiumOffer');
      $('cbLightDaysWrap').hidden = !(lightOpt && lightOpt.dataset.customDays);
      $('cbPremiumDaysWrap').hidden = !(premiumOpt && premiumOpt.dataset.customDays);
      $('cbPremiumPriceWrap').hidden = !(premiumOpt && premiumOpt.dataset.customPrice);

      // 価格の内訳（通常価格 / 割引 / 特別価格 / 無料）
      const box = $('cbPriceBox');
      const dl = $('cbPriceKv');
      dl.innerHTML = '';
      const isPurchase = premiumOpt && premiumOpt.dataset.kind === 'purchase_offer';
      if (isPurchase) {
        const regular = Number(premiumOpt.dataset.regularPrice) || 0;
        const price = premiumOpt.dataset.customPrice
          ? Number($('cbPremiumPrice').value)
          : null;
        kvRow(dl, '通常価格', '¥' + regular.toLocaleString());
        if (price !== null) {
          const off = regular > 0 ? Math.round((1 - price / regular) * 100) : 0;
          kvRow(dl, '特別価格', '¥' + (price || 0).toLocaleString(), 'strong-ok');
          kvRow(dl, '割引率', off + '%OFF');
        } else {
          kvRow(dl, '特別価格', 'dry-run で確定します');
        }
        kvRow(dl, '権限', '購入条件のみ（支払い完了まで権限は付与されません）');
        box.hidden = false;
      } else if (premiumOpt && premiumOpt.value !== 'none') {
        kvRow(dl, '料金', '無料（課金は発生しません）', 'strong-ok');
        box.hidden = false;
      } else {
        box.hidden = true;
      }

      const parts = [];
      if (lightOpt && lightOpt.value !== 'none') parts.push('Light: ' + lightOpt.textContent);
      if (premiumOpt && premiumOpt.value !== 'none') parts.push('Premium: ' + premiumOpt.textContent);
      $('cbOfferDesc').textContent = parts.length ? parts.join('　/　') : '特典を選択してください。';
    }
    for (const id of ['cbLightOffer', 'cbPremiumOffer', 'cbLightDays', 'cbPremiumDays', 'cbPremiumPrice']) {
      $(id).addEventListener('change', cbRenderOfferDesc);
      $(id).addEventListener('input', cbRenderOfferDesc);
    }

    async function cbLoad() {
      cbMsg('読み込み中…');
      const data = await cbCall({
        action: 'customers',
        contract: $('cbContract').value,
        plan: $('cbPlan').value,
        withdrawn: $('cbWithdrawn').value,
        promo: $('cbPromo').value,
        grantable: $('cbGrantable').value,
        history: $('cbHistory').value,
      });
      if (!data) return;
      cbData = data;
      // Step 1 完了。ここから Step 2 を操作できる
      cbState.loaded = true;
      cbState.candidateCount = (data.rows || []).length;
      cbInvalidate('対象候補を取得し直しました。');
      cbNotify('ok', '対象候補を表示しました', (data.rows || []).length + ' 名（現有効会員は既定で対象外）');
      cbSync();
      cbWriteEnabled = !!data.writeEnabled;
      cbMsg('');
      cbRender();
    }

    function cbVisibleRows() {
      const q = $('cbQ').value.trim().toLowerCase();
      return (cbData?.rows || []).filter((r) => !q || String(r.email || '').toLowerCase().includes(q));
    }

    function cbRender() {
      if (!cbData) return;
      const s = cbData.summary || {};
      const bar = $('cbSummary');
      bar.innerHTML = '';
      const items = [
        ['期限切れ', s.contract?.expired || 0],
        ['契約なし', s.contract?.none || 0],
        ['退会あり', s.withdrawn || 0],
        ['特典あり', (s.promo?.light || 0) + (s.promo?.trialActive || 0)],
        ['付与できる', s.grantable || 0],
      ];
      items.forEach((it, i) => {
        if (i > 0) { const sp = document.createElement('span'); sp.className = 'sep'; sp.textContent = '|'; bar.appendChild(sp); }
        const b = document.createElement('span');
        b.className = 's';
        const kk = document.createElement('span'); kk.className = 'k'; kk.textContent = it[0];
        const vv = document.createElement('span'); vv.className = 'v'; vv.textContent = String(it[1]);
        b.appendChild(kk); b.appendChild(vv);
        bar.appendChild(b);
      });
      const p = s.promo || {};
      $('cbSummarySub').textContent =
        '全顧客 ' + (cbData.totalCustomers || 0) + ' 名　/　特典内訳: Light 永久無料 ' + (p.light || 0)
        + '・Premium 無料期間中 ' + (p.trialActive || 0) + '・Premium 無料 終了 ' + (p.trialExpired || 0)
        + (p.inconsistent ? '・⚠️ 不整合 ' + p.inconsistent : '');

      const rows = cbVisibleRows();
      const tb = $('cbRows');
      tb.innerHTML = '';
      for (const r of rows) {
        const tr = document.createElement('tr');
        if (!r.grantable) tr.className = 'row-suppressed';

        const c0 = document.createElement('td');
        c0.className = 'c-chk';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = cbSelected.has(r.recordId);
        cb.disabled = !r.grantable; // 付与しても使えない相手は選べない（fail closed）
        cb.setAttribute('aria-label', '選択');
        cb.addEventListener('change', () => {
          if (cb.checked) cbSelected.add(r.recordId); else cbSelected.delete(r.recordId);
          cbRenderSelCount();
        });
        c0.appendChild(cb);
        tr.appendChild(c0);

        const c1 = td('c-cust', '', undefined);
        const em = document.createElement('span');
        em.className = 'em';
        em.textContent = r.email || '(メール未設定)';
        c1.appendChild(em);
        if (r.name) { const nm = document.createElement('span'); nm.className = 'sub'; nm.textContent = r.name; c1.appendChild(nm); }
        tr.appendChild(c1);

        const cCon = td('c-contract', '契約', CONTRACT_LABEL[r.contract] || r.contract);
        cCon.firstChild.className = 'contract ' + r.contract;
        if (r.withdrawn) {
          const wb = document.createElement('span');
          wb.className = 'wd-badge';
          wb.textContent = '退会';
          wb.title = '課金停止（退会申請）。この状態ではログインできないため特典を付与しません';
          cCon.appendChild(wb);
        }
        tr.appendChild(cCon);

        tr.appendChild(td('c-plan', 'プラン', PLAN_LABEL[r.planGroup] || r.planGroup));
        tr.appendChild(td('c-promo', '現在の特典', r.promoText,
          r.promoInconsistent ? 'ng-txt' : (r.promoText === '特典なし' ? 'muted' : 'ok-txt')));
        tr.appendChild(td('c-grantable', '付与可否',
          r.grantable ? '付与できる' : ('付与不可: ' + (r.grantBlockedLabel || '')),
          r.grantable ? 'ok-txt' : 'ng-txt'));

        tb.appendChild(tr);
      }

      $('cbCount').textContent = '表示 ' + rows.length + ' 件 / 条件一致 ' + (cbData.matchedCount || 0) + ' 件'
        + (cbData.truncated ? '（上限を超えたため一部のみ表示）' : '');
      const emp = $('cbEmpty');
      emp.hidden = rows.length > 0;
      emp.textContent = '条件に一致する顧客はいません。';
      cbRenderSelCount();
    }

    function cbRenderSelCount() {
      cbInvalidate('選択した顧客が変わりました。');
      cbSync();
      $('cbSelCount').textContent = cbSelected.size + ' 名を選択中';
    }

    $('cbLoad').addEventListener('click', cbLoad);
    $('cbQ').addEventListener('input', cbRender);
    $('cbSelAll').addEventListener('click', () => {
      for (const r of cbVisibleRows()) if (r.grantable) cbSelected.add(r.recordId);
      cbRender();
    });
    $('cbSelNone').addEventListener('click', () => { cbSelected.clear(); cbRender(); });

    // ── モーダル ──
    function cbOpenModal(title) {
      $('cbModalTitle').textContent = title;
      $('cbBackdrop').hidden = false;
      lockScroll();
      $('cbModalBody').innerHTML = '';
      return $('cbModalBody');
    }
    function cbCloseModal() {
      $('cbBackdrop').hidden = true;
      if ($('dtBackdrop').hidden && $('pvBackdrop').hidden && $('mkBackdrop').hidden) unlockScroll();
    }
    $('cbModalClose').addEventListener('click', cbCloseModal);
    $('cbModalBack').addEventListener('click', cbCloseModal);
    $('cbBackdrop').addEventListener('click', (e) => { if (e.target === $('cbBackdrop')) cbCloseModal(); });

    // ── 文面プレビュー（送信しない）──
    $('cbPreviewBtn').addEventListener('click', async () => {
      const sel = cbSelectionPayload();
      if (!sel.lightOfferId && !sel.premiumOfferId) { cbMsg('特典を選択してください', 'err'); return; }
      const data = await cbCall({ action: 'preview', ...sel });
      if (!data) return;
      const body = cbOpenModal('案内文面プレビュー');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '特典', data.selection);
      kvRow(dl, '件名', data.subject);
      sec.appendChild(dl);
      const pre = document.createElement('pre');
      pre.className = 'prev-body';
      pre.textContent = data.body;
      sec.appendChild(pre);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec.appendChild(note);
      body.appendChild(sec);
    });

    // ── dry-run → 最終確認 → 実行 ──
    /** 付与内容の確認結果を Step 4 のパネルへ出す */
    function cbRenderReview(plan) {
      const p = $('cbReviewPanel');
      if (!p) return;
      p.hidden = false;
      p.innerHTML = '';
      const row = (k, v, cls) => {
        const d = document.createElement('div'); d.className = 'dp-row ' + (cls || '');
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); p.appendChild(d);
      };
      const aud = plan.audience || {};
      row('選択人数', (plan.selected ?? cbSelected.size) + ' 名');
      row('付与される人数', (plan.willGrant ?? aud.eligible ?? 0) + ' 名',
        (plan.willGrant ?? aud.eligible ?? 0) > 0 ? 'is-ok' : 'is-ng');
      row('除外', (plan.excluded ?? aud.excluded ?? 0) + ' 名');
      row('現有効会員の混入', (aud.activeMembers ?? 0) + ' 名', (aud.activeMembers ?? 0) > 0 ? 'is-ng' : '');
      const seg = aud.bySegment || {};
      row('対象区分', Object.entries(seg).map(([k, n]) => cbApi().segmentLabel(k) + ' ' + n + ' 名').join(' / ') || '—');
      const reasons = aud.byReason || {};
      if (Object.keys(reasons).length) {
        row('除外理由', Object.entries(reasons).map(([k, n]) => ((aud.reasonLabels || {})[k] || k) + ' ' + n + ' 名').join(' / '));
      }
      row('付与する特典', cbOfferShortLabel());
      row('変更しないもの', cbApi().UNCHANGED_NOTICE);
      if ((aud.activeMembers ?? 0) > 0) {
        const w = document.createElement('p'); w.className = 'blocker';
        w.textContent = '⛔ 現在有効な会員が含まれています。対象から外すまで実行できません。';
        p.appendChild(w);
      }
    }

    $('cbDryRun').addEventListener('click', async () => {
      const sel = cbSelectionPayload();
      if (!sel.lightOfferId && !sel.premiumOfferId) { cbMsg('特典を選択してください', 'err'); return; }
      if (cbSelected.size === 0) { cbMsg('対象を選択してください', 'err'); return; }
      cbMsg('変更内容を確認中…');
      const plan = await cbCall({
        action: 'dryRun', ...sel, recordIds: [...cbSelected],
        // 直前の操作をやり直す場合は同じ operationId を引き継ぐ（冪等な再開）
        operationId: cbLastOperationId || undefined,
      });
      if (!plan) {
        cbNotify('err', '付与内容を確認できませんでした', '条件・選択・管理シークレットを確認して、もう一度お試しください。');
        cbSync();
        return;
      }
      cbLastOperationId = plan.operationId;
      cbMsg('');
      // この確認が「どの条件・選択・特典に対するものか」を指紋で固定する
      cbState.dryRun = {
        fingerprint: cbFingerprint(),
        willGrant: plan.willGrant, selected: plan.selected, excluded: plan.skipped,
        activeMembers: (plan.audience && plan.audience.activeMembers) || 0,
        operationId: plan.operationId, audience: plan.audience || null,
      };
      cbState.dryStale = false;
      cbState.applied = false;
      cbRenderReview({ ...plan, excluded: plan.skipped, audience: plan.audience });
      const active = (plan.audience && plan.audience.activeMembers) || 0;
      if (active > 0) {
        cbNotify('err', '現在有効な会員が含まれています', active + ' 名。対象から外すまで実行できません。');
      } else if ((plan.willGrant || 0) === 0) {
        cbNotify('warn', '付与される顧客がいません', '除外理由を確認してください。');
      } else {
        cbNotify('ok', '確認しました', plan.willGrant + ' 名へ付与します。実行はまだしていません。');
      }
      cbSync();
      cbRenderConfirm(sel, plan);
    });

    // ── Step 5: 特典を付与する（確認モーダル + 人数入力）────────────
    $('cbApplyBtn')?.addEventListener('click', async () => {
      const btn = $('cbApplyBtn');
      if (btn.dataset.busy === '1') return;
      const verdict = cbApi().canApply(cbState);
      if (!verdict.allowed) { cbNotify('warn', '実行できません', verdict.reason || ''); return; }
      const dry = cbState.dryRun;
      const aud = dry.audience || {};
      const seg = Object.entries(aud.bySegment || {})
        .map(([k, n]) => cbApi().segmentLabel(k) + ' ' + n + ' 名').join(' / ') || '—';
      const ok1 = window.confirm(
        '【無料特典の付与】\n\n'
        + '対象: ' + dry.willGrant + ' 名\n'
        + '対象区分: ' + seg + '\n'
        + '現有効会員: ' + (aud.activeMembers || 0) + ' 名\n'
        + '特典: ' + cbOfferShortLabel() + '\n'
        + cbApi().UNCHANGED_NOTICE + '\n'
        + cbApi().APPLY_EFFECT_NOTICE + '\n\n続けますか？'
      );
      if (!ok1) return;
      const typed = window.prompt('確認のため、付与予定人数「' + dry.willGrant + '」を入力してください') || '';
      if (String(typed).trim() !== String(dry.willGrant)) {
        cbNotify('warn', '実行を中止しました', '入力が一致しませんでした。');
        return;
      }
      btn.dataset.busy = '1';
      cbState.busy = true; cbSync();
      const sel = cbSelectionPayload();
      const out = await cbCall({
        action: 'apply', ...sel, recordIds: [...cbSelected],
        operationId: cbState.dryRun.operationId,   // dry-run と同じ ID（冪等）
      });
      cbState.busy = false; btn.dataset.busy = '';
      if (!out) { cbNotify('err', '付与に失敗しました', '結果を「前回操作の突合」で確認してください。'); cbSync(); return; }
      cbState.applied = true;
      cbState.dryRun = null;
      cbRenderApplyResult(out);
      cbNotify('ok', '無料特典を付与しました', (out.granted ?? out.willGrant ?? 0) + ' 名。案内メールは別途送ってください。');
      cbSync();
    });

    /** 実行結果（成功 / 除外 / 失敗 / operationId / 実行日時） */
    function cbRenderApplyResult(out) {
      const box = $('cbApplyResult');
      if (!box) return;
      box.innerHTML = '';
      const row = (k, v) => {
        const d = document.createElement('div'); d.className = 'dp-row';
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); box.appendChild(d);
      };
      box.className = 'dry-panel';
      row('付与できた人数', String(out.granted ?? out.applied ?? 0) + ' 名');
      row('除外', String(out.skipped ?? 0) + ' 名');
      row('失敗', String(out.failed ?? 0) + ' 名');
      row('操作 ID', String(out.operationId || cbLastOperationId || '—'));
      row('実行日時', fmtDate(new Date().toISOString()));
      row('変更しないもの', cbApi().UNCHANGED_NOTICE);
    }

    function cbRenderConfirm(sel, plan) {
      const body = cbOpenModal('実行内容の確認');

      const head = document.createElement('div'); head.className = 'dt-sec';
      const h = document.createElement('h3'); h.textContent = plan.selection;
      head.appendChild(h);
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '選択', plan.selected + ' 名');
      kvRow(dl, '無料特典を付与', plan.willGrant + ' 名', plan.willGrant > 0 ? 'strong-ok' : 'muted');
      if (plan.purchaseOffer) {
        kvRow(dl, '割引オファーを発行', plan.willOffer + ' 名', plan.willOffer > 0 ? 'strong-ok' : 'muted');
        kvRow(dl, '価格', '通常 ¥' + plan.purchaseOffer.regularPrice.toLocaleString()
          + ' → ¥' + plan.purchaseOffer.offerPrice.toLocaleString()
          + '（' + plan.purchaseOffer.discountPercent + '%OFF）');
        kvRow(dl, '権限', '付与しません（支払い完了後に既存の入金確認フローが昇格します）');
      }
      kvRow(dl, '対象外', plan.skipped + ' 名');
      kvRow(dl, '操作 ID', plan.operationId);
      head.appendChild(dl);
      body.appendChild(head);

      // 内訳（Light 何件 / Premium 何件 / オファー何件）
      const partsSec = document.createElement('div'); partsSec.className = 'dt-sec';
      const ph = document.createElement('h3'); ph.textContent = '内訳'; partsSec.appendChild(ph);
      const pul = document.createElement('ul'); pul.className = 'exlist';
      const parts = plan.parts || {};
      for (const [label, n] of [
        ['Light 無料を新規付与', parts.lightGrant || 0],
        ['Premium 無料を新規付与', parts.premiumGrant || 0],
        ['割引オファーを発行', parts.purchaseOffer || 0],
      ]) {
        const li = document.createElement('li');
        li.textContent = label + '　' + n + ' 名';
        pul.appendChild(li);
      }
      for (const d of (plan.partSkipDetail || [])) {
        const li = document.createElement('li');
        li.textContent = d.partLabel + ' は付与しない（' + d.label + '）　' + d.count + ' 名';
        pul.appendChild(li);
      }
      partsSec.appendChild(pul);
      body.appendChild(partsSec);

      if (plan.skippedDetail && plan.skippedDetail.length) {
        const sec = document.createElement('div'); sec.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '対象外の内訳'; sec.appendChild(h2);
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const d of plan.skippedDetail) {
          const li = document.createElement('li');
          li.textContent = d.label + '　' + d.count + ' 名';
          ul.appendChild(li);
        }
        sec.appendChild(ul);
        body.appendChild(sec);
      }

      if (plan.preview && plan.preview.length) {
        const sec = document.createElement('div'); sec.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '顧客ごとの変更（現在 → 付与後）'; sec.appendChild(h2);
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const p of plan.preview) {
          const li = document.createElement('li');
          const strong = document.createElement('strong');
          strong.textContent = p.email;
          li.appendChild(strong);
          const sub = document.createElement('ul'); sub.className = 'exlist sub';
          const l1 = document.createElement('li'); l1.textContent = '現在: ' + p.before; sub.appendChild(l1);
          const l2 = document.createElement('li'); l2.textContent = '付与後: ' + p.after; sub.appendChild(l2);
          if (p.offer) {
            const l3 = document.createElement('li');
            l3.textContent = '割引オファー: ' + p.offer + '（権限は付与されません）';
            sub.appendChild(l3);
          }
          for (const part of (p.partial || [])) {
            const l4 = document.createElement('li');
            l4.textContent = '※ ' + part.part + ' は付与しません（' + part.label + '）';
            sub.appendChild(l4);
          }
          li.appendChild(sub);
          ul.appendChild(li);
        }
        sec.appendChild(ul);
        if (plan.previewTruncated) {
          const note = document.createElement('p'); note.className = 'note';
          note.textContent = '※ 表示は先頭 50 名のみです（実行は対象全員に行われます）。';
          sec.appendChild(note);
        }
        body.appendChild(sec);
      }

      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const h3 = document.createElement('h3'); h3.textContent = '実行'; sec3.appendChild(h3);
      const state = document.createElement('p'); state.className = 'note';
      state.textContent = plan.writeEnabled
        ? '実行すると無料特典は即時に反映されます。課金・入金状態・メールは変わりません。'
        : '実行は無効（COMEBACK_GRANT_FIELDS_READY / COMEBACK_OFFER_TABLE_READY / COMEBACK_GRANT_ENABLED 未設定）です。';
      sec3.appendChild(state);
      const mailNote = document.createElement('p'); mailNote.className = 'note';
      mailNote.textContent = '📪 この操作でメールは送信されません。案内はマーケティングタブから別途送ってください。';
      sec3.appendChild(mailNote);

      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-immediate';
      const total = (plan.willGrant || 0) + (plan.willOffer || 0);
      btn.textContent = '実行する（付与 ' + plan.willGrant + ' 名 / オファー ' + plan.willOffer + ' 名）';
      btn.disabled = !plan.writeEnabled || total === 0;
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;      // 二重クリック防止
        const ok = window.confirm(
          plan.selection + '\n\n'
          + '対象: ' + plan.selected + ' 名\n'
          + '無料特典を付与: ' + plan.willGrant + ' 名\n'
          + '割引オファーを発行: ' + plan.willOffer + ' 名\n'
          + '対象外: ' + plan.skipped + ' 名\n\n'
          + 'この内容で実行しますか？（メールは送信されません）'
        );
        if (!ok) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        btn.textContent = '実行中…';
        const out = await cbCall({
          action: 'apply',
          ...sel,
          recordIds: [...cbSelected],
          operationId: plan.operationId,          // 冪等性の鍵（再実行しても二重付与しない）
          planFingerprint: plan.planFingerprint,  // 対象が変わっていたら Function 側が中止する
        });
        btn.dataset.busy = '';
        if (out) {
          cbMsg(out.notice || ('実行しました: 付与 ' + out.granted + ' 名 / オファー ' + out.offersIssued + ' 名'), 'ok');
          if (out.offerTokens && out.offerTokens.length) cbRenderOfferTokens(out);
          cbSelected.clear();
          cbCloseModal();
          await cbLoad();
        } else {
          btn.textContent = '再試行（同じ操作 ID で安全に再実行できます）';
          btn.disabled = false;
        }
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    }

    /** 発行した専用 URL（生トークンはこの応答にしか無い） */
    function cbRenderOfferTokens(out) {
      const body = cbOpenModal('発行した専用 URL');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const note = document.createElement('p'); note.className = 'note';
      note.textContent = 'この URL は対象のお客様だけが利用できます（署名付き・メールアドレス一致が必要）。'
        + '台帳にはハッシュしか保存されないため、この画面を閉じると再表示できません。';
      sec.appendChild(note);
      const ul = document.createElement('ul'); ul.className = 'exlist';
      for (const t of out.offerTokens) {
        const li = document.createElement('li');
        li.textContent = t.url + '（〜' + String(t.expiresAt).slice(0, 10) + '）';
        ul.appendChild(li);
      }
      sec.appendChild(ul);
      body.appendChild(sec);
    }

    // ── 取り消し（無料権利だけ）──
    $('cbRevokeBtn').addEventListener('click', async () => {
      if (cbSelected.size === 0) { cbMsg('取り消す対象を選択してください', 'err'); return; }
      const tiers = [];
      if (window.confirm('Light の無料権利を取り消しますか？\n（キャンセルすると Premium だけを対象にします）')) {
        tiers.push('light');
      }
      if (window.confirm('Premium の無料権利を取り消しますか？')) tiers.push('premium');
      if (tiers.length === 0) { cbMsg('取り消す特典が選択されていません', 'err'); return; }
      const reason = window.prompt('取り消し理由（管理者メモ・任意）') || '';

      const plan = await cbCall({
        action: 'revokeDryRun', tiers, recordIds: [...cbSelected], reason,
      });
      if (!plan) return;

      const body = cbOpenModal('取り消し内容の確認');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '対象', (plan.tierLabels || []).join(' / '));
      kvRow(dl, '選択', plan.selected + ' 名');
      kvRow(dl, '取り消し', plan.willRevoke + ' 名', plan.willRevoke > 0 ? 'strong-ok' : 'muted');
      kvRow(dl, '対象外', plan.skipped + ' 名');
      sec.appendChild(dl);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = plan.notice || '';
      sec.appendChild(note);
      body.appendChild(sec);

      if (plan.preview && plan.preview.length) {
        const sec2 = document.createElement('div'); sec2.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '顧客ごとの変更'; sec2.appendChild(h2);
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const p of plan.preview) {
          const li = document.createElement('li');
          li.textContent = p.email + '　' + p.before + ' → ' + p.after;
          ul.appendChild(li);
        }
        sec2.appendChild(ul);
        body.appendChild(sec2);
      }

      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-blocked';
      btn.textContent = plan.willRevoke + ' 名の無料特典を取り消す';
      btn.disabled = !cbWriteEnabled || plan.willRevoke === 0;
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;
        if (!window.confirm('無料特典を取り消します。有料契約・三連複買い切り・発行済みオファーは変わりません。よろしいですか？')) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        const out = await cbCall({
          action: 'revoke', tiers, recordIds: [...cbSelected],
          planFingerprint: plan.planFingerprint, reason,
        });
        btn.dataset.busy = '';
        if (out) {
          cbMsg('取り消しました: ' + out.revoked + ' 名', 'ok');
          cbSelected.clear();
          cbCloseModal();
          await cbLoad();
        } else {
          btn.disabled = false;
        }
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    });

    // ── 発行済み割引オファーの取り消し（PromotionalOffers の 1 行だけ）──
    //   無料特典の取り消し（cbRevokeBtn）とは別経路。権限・課金は 1 バイトも動かない。
    //   PII / token / TokenHash は API が返さないので、画面にも出ない。
    const OFFER_STATUS_LABEL = {
      issued: '発行済み', redeemed: '申込済み', expired: '期限切れ', revoked: '取り消し済み',
    };
    const TIER_LABEL = { premium: 'Premium', light: 'Light' };
    const TERM_LABEL = { annual: '年額', monthly: '月額', lifetime: '買い切り' };
    const yen = (n) => '¥' + Number(n || 0).toLocaleString();

    async function cbOfferLoad() {
      cbMsg('発行済みオファーを読み込み中…');
      const data = await cbCall({ action: 'offerList' });
      if (!data) return;
      cbMsg('');
      const tb = $('cbOfferRows');
      tb.innerHTML = '';
      for (const r of (data.rows || [])) {
        const tr = document.createElement('tr');
        if (!r.canRevoke) tr.className = 'row-suppressed';
        tr.appendChild(td('', 'オファー種別', r.offerId));
        tr.appendChild(td('', '対象', TIER_LABEL[r.targetTier] || r.targetTier));
        tr.appendChild(td('', '期間', TERM_LABEL[r.billingTerm] || r.billingTerm));
        tr.appendChild(td('', '通常価格', yen(r.regularPrice)));
        tr.appendChild(td('', 'オファー価格', yen(r.offerPrice)));
        tr.appendChild(td('', '状態', OFFER_STATUS_LABEL[r.status] || r.status,
          r.status === 'issued' ? 'ok-txt' : 'muted'));
        tr.appendChild(td('', '有効期限', String(r.expiresAt || '').slice(0, 10)));

        const cOps = document.createElement('td');
        // 誤操作防止: redeemed / expired / revoked にはボタン自体を出さない
        if (r.canRevoke) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn-ghost';
          btn.textContent = '取り消す';
          btn.addEventListener('click', () => cbOfferRevokeStart(r));
          cOps.appendChild(btn);
        } else {
          const sp = document.createElement('span');
          sp.className = 'muted';
          sp.textContent = '—';
          cOps.appendChild(sp);
        }
        tr.appendChild(cOps);
        tb.appendChild(tr);
      }
      const c = data.counts || {};
      $('cbOfferCount').textContent = '合計 ' + (data.total || 0) + ' 件'
        + '（発行済み ' + (c.issued || 0) + '・申込済み ' + (c.redeemed || 0)
        + '・期限切れ ' + (c.expired || 0) + '・取り消し済み ' + (c.revoked || 0) + '）'
        + (data.truncated ? ' ※一部のみ表示' : '');
      const emp = $('cbOfferEmpty');
      emp.hidden = (data.rows || []).length > 0;
      emp.textContent = '発行済みのオファーはありません。';
    }
    $('cbOfferLoad').addEventListener('click', cbOfferLoad);

    /** 手順: dry-run（対象確認）→ 最終実行。いきなり書き込まない。 */
    async function cbOfferRevokeStart(row) {
      const reason = window.prompt('取り消し理由（管理者メモ・任意）') || '';
      const plan = await cbCall({
        action: 'offerRevokeDryRun',
        offerRecordId: row.offerRecordId,
        // 対象の取り違えを Function 側でも検証させる
        operationId: row.operationId,
        customerRecordId: row.customerRecordId,
        offerKey: row.offerKey,
        reason,
      });
      if (!plan) return;

      const o = plan.offer || {};
      const body = cbOpenModal('割引オファーの取り消し');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, 'オファー種別', o.offerId);
      kvRow(dl, '対象', TIER_LABEL[o.targetTier] || o.targetTier);
      kvRow(dl, '期間', TERM_LABEL[o.billingTerm] || o.billingTerm);
      kvRow(dl, '通常価格', yen(o.regularPrice));
      kvRow(dl, 'オファー価格', yen(o.offerPrice), 'strong-ok');
      kvRow(dl, '状態', OFFER_STATUS_LABEL[o.status] || o.status);
      kvRow(dl, '有効期限', String(o.expiresAt || '').slice(0, 10));
      kvRow(dl, '操作 ID', o.operationId);
      kvRow(dl, '書き込む項目', (plan.willWriteFields || []).join(' / '));
      sec.appendChild(dl);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = plan.notice || '';
      sec.appendChild(note);
      body.appendChild(sec);

      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const h3 = document.createElement('h3'); h3.textContent = '取り消しの実行'; sec3.appendChild(h3);
      const warn = document.createElement('p'); warn.className = 'note';
      warn.textContent = '取り消すと専用 URL は使えなくなります。閲覧権・課金契約・入金状態・メールは変わりません。';
      sec3.appendChild(warn);

      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-blocked';
      btn.textContent = 'このオファーを取り消す';
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;
        if (!window.confirm('このオファーを取り消します。よろしいですか？\n（顧客の権限・課金は変わりません）')) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        btn.textContent = '取り消し中…';
        const out = await cbCall({
          action: 'offerRevoke',
          offerRecordId: o.offerRecordId,
          operationId: o.operationId,
          customerRecordId: o.customerRecordId,
          offerKey: o.offerKey,
          offerFingerprint: plan.offerFingerprint,  // 状態が動いていたら Function 側が 409 で止める
          reason,
        });
        btn.dataset.busy = '';
        if (out) {
          cbMsg(out.notice || 'オファーを取り消しました', 'ok');
          cbCloseModal();
          await cbOfferLoad();
        } else {
          btn.textContent = '再試行（もう一度 dry-run からやり直してください）';
          btn.disabled = false;
        }
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    }

    // ── 前回操作の突合（read-only）──
    $('cbReconcileBtn').addEventListener('click', async () => {
      const op = window.prompt('突合する操作 ID', cbLastOperationId || '') || '';
      if (!op.trim()) return;
      const data = await cbCall({
        action: 'reconcile', operationId: op.trim(),
        recordIds: cbSelected.size ? [...cbSelected] : undefined,
      });
      if (!data) return;
      const body = cbOpenModal('前回操作の突合');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '操作 ID', data.operationId);
      kvRow(dl, '確認した顧客', data.total + ' 名');
      kvRow(dl, '適用済み', data.applied + ' 名', 'strong-ok');
      kvRow(dl, '未適用', data.missing + ' 名', data.missing > 0 ? 'ng-txt' : 'muted');
      sec.appendChild(dl);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec.appendChild(note);
      body.appendChild(sec);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$('cbBackdrop').hidden) cbCloseModal();
    });
  })();
</script>
