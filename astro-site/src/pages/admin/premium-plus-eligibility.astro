---
export const prerender = true;
// 認可: この画面は /admin/* の Basic-Auth（Edge Function）背後。POST は x-admin-secret を
// premium-plus-eligibility Function 側で検証する。secret はこのタブ限定（sessionStorage）。
//
// この画面が変更するのは **Premium Plus の販売資格だけ**。
// プラン / Status / 有効期限 / LifetimeSanrenpuku / メール状態は一切変更しない。
// 資格変更でメール送信・課金・昇格は起きない（表示資格のみ）。
//
// 2026-07-30: UI を「管理テーブル + 詳細操作パネル」型へ再設計（表示のみ）。
//   - 一覧は 1 行 1 顧客のテーブル。**write ボタンは一覧に出さない**
//   - write は詳細パネル内だけで行う（誤操作防止）
//   - 管理 Function の write 契約（action='update' の payload）と preview の
//     read-only 契約は不変
//
// ⚠️ style は必ず `is:global` + `.ppe` 名前空間で書くこと。
//    Astro の scoped style は `.cust[data-astro-cid-xxx]` へ変換されるため、
//    JS で生成する行・バッジ・ボタンには **一切適用されない**（2026-07-30 に本番で発生）。
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="AK 顧客販売・マーケティング管理（管理）">
  <div class="ppe">
    <header class="ppe-head">
      <div class="ppe-head-l">
        <h1>AK 顧客販売・マーケティング管理</h1>
        <p class="lead">
          <b>Premium Plus 販売資格</b>と<b>マーケティング対象</b>は別概念です。
          期限切れ会員はキャンペーンの対象にできますが、販売資格へは自動で入りません。
        </p>
      </div>
      <div class="ppe-head-r">
        <span class="conn-pill" id="connState">● 未接続</span>
        <button type="button" id="connToggle" class="btn-ghost">管理接続設定</button>
        <button type="button" id="reload" class="btn-primary">再読み込み</button>
      </div>
    </header>

    <div class="conn-body" id="connBody" hidden>
      <label for="secret">管理シークレット（PREMIUM_PLUS_ADMIN_SECRET・このタブのみ保持）</label>
      <input type="password" id="secret" placeholder="Netlify に設定した値" autocomplete="off" />
      <p class="note" id="writeState"></p>
    </div>

    <nav class="tabs" role="tablist">
      <button type="button" class="tab on" id="tabSales" role="tab" aria-selected="true">💠 Premium Plus 販売</button>
      <button type="button" class="tab" id="tabMkt" role="tab" aria-selected="false">📣 顧客マーケティング</button>
      <button type="button" class="tab" id="tabCb" role="tab" aria-selected="false">🎁 カムバック特典</button>
    </nav>

    <!-- ═══ タブ1: Premium Plus 販売資格（既存の安全設計を維持）═══ -->
    <section id="paneSales">
    <p class="pane-lead">
      販売してよい会員を <b>管理者が手動で選別</b>します。候補は自動で「販売可」になりません。
      変更されるのは <b>Premium Plus の表示資格だけ</b>で、プラン・有効期限・メール・課金には影響しません。
    </p>

    <div class="sumbar" id="summary"></div>
    <div class="sumsub" id="summarySub"></div>

    <div class="toolbar">
      <details class="email-search" id="qBox">
          <summary class="email-summary">🔎 Email で個別検索<span class="email-badge" id="qBadge" hidden>Email 条件あり</span></summary>
          <p class="email-note">特定の顧客をメールアドレスで探す場合だけ使用します。</p>
          <div class="email-row">
            <input type="search" id="q" placeholder="Email で検索" autocomplete="off" aria-label="Email 検索" />
            <button type="button" id="qClear" class="btn-ghost btn-sm">クリア</button>
          </div>
        </details>
      <select id="fState" aria-label="状態で絞り込み">
        <option value="all">すべての状態</option>
        <option value="review">保留（確認待ち）</option>
        <option value="eligible">販売できる</option>
        <option value="immediate">即時販売（CTA表示・購入可）</option>
        <option value="blocked">販売対象外</option>
      </select>
      <select id="fRoute" aria-label="Route で絞り込み">
        <option value="all">すべての Route</option>
        <option value="sanrenpuku">三連複の購入から</option>
        <option value="premium_30d">Premium 加入30日から</option>
      </select>
      <select id="fKind" aria-label="候補区分で絞り込み">
        <option value="all">すべての区分</option>
        <option value="waiting_30d">Premium 30日待ち</option>
        <option value="anchor_missing">加入日が不明</option>
      </select>
      <select id="fUpsell" aria-label="販売CTA で絞り込み">
        <option value="all">すべての販売CTA</option>
        <option value="auto">自動で選ぶ</option>
        <option value="sanrenpuku">三連複を案内</option>
        <option value="plus">Premium Plus を案内</option>
        <option value="none">案内しない</option>
      </select>
      <label class="chk"><input type="checkbox" id="onlyReview" /> 保留のみ再取得</label>
    </div>

    <p class="msg" id="message"></p>
    <p class="count" id="count"></p>

    <div class="tablewrap">
      <table class="tbl">
        <thead>
          <tr>
            <th class="c-cust">顧客</th>
            <th class="c-state">状態</th>
            <th class="c-plan">プラン</th>
            <th class="c-route">Route</th>
            <th class="c-kind">区分</th>
            <th class="c-upsell">販売CTA</th>
            <th class="c-display">実表示</th>
            <th class="c-phase">PHASE</th>
            <th class="c-eligible">販売許可日</th>
            <th class="c-updated">最終更新</th>
            <th class="c-ops">操作</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
      <p class="empty" id="empty" hidden></p>
    </div>
    </section>

    <!-- ═══ タブ2: 顧客マーケティング（AK 独自機能 / KMA とは統合しない）═══ -->
    <section id="paneMkt" hidden>
      <p class="pane-lead">
        契約状態を横断して顧客を選び、キャンペーンメールを送ります。
        <b>この画面はプラン・有効期限・権限・Premium Plus 販売資格を一切変更しません。</b>
        メールを送っても会員権限は復活しません。
      </p>

      <div class="sumbar" id="mkSummary"></div>
      <div class="sumsub" id="mkSummarySub"></div>
      <p class="note" id="mkSendState"></p>

      <p class="step-progress" id="mkProgress" aria-live="polite">Step 1 / 6</p>
      <div class="stepbar" id="mkSteps" aria-label="操作の順序">
        <span class="stp" data-step="1"><b class="stp-n">1</b> 🔍 絞り込み<span class="stp-sub">対象を絞る</span></span>
        <span class="stp" data-step="2"><b class="stp-n">2</b> 👥 顧客を選ぶ<span class="stp-sub">宛先を決める</span></span>
        <span class="stp" data-step="3"><b class="stp-n">3</b> 📝 キャンペーン<span class="stp-sub">送る内容</span></span>
        <span class="stp" data-step="4"><b class="stp-n">4</b> ✅ 送信対象の確認<span class="stp-sub">dry-run</span></span>
        <span class="stp" data-step="5"><b class="stp-n">5</b> 🚀 登録・送信<span class="stp-sub">実メールが届く</span></span>
        <span class="stp" data-step="6"><b class="stp-n">6</b> 📊 状況・取消<span class="stp-sub">結果を見る</span></span>
      </div>

      <div id="mkNotices" class="notices" aria-live="polite"></div>

      <!--
        大規模セグメントの下見（read-only）。
        約 1,300 名の無料ユーザー、将来 13,000 名規模を **1 件も DOM へ描画せず**
        件数だけ見る。個別に顧客を選ぶ下の一覧とは別物なので、はっきり分ける。
      -->
      <section class="step seg-step" aria-labelledby="mkSegH">
        <h2 id="mkSegH" class="step-h"><span class="step-n">◎</span> セグメントの下見（大規模）</h2>
        <p class="note">
          大きなまとまりの<b>人数だけ</b>を確認します。顧客一覧は表示しません（個人情報を画面へ出しません）。
          <b>まだ送信対象は固定されていません。</b>
        </p>
        <div class="toolbar">
          <select id="mkSegSelect" aria-label="セグメント"></select>
          <button type="button" id="mkSegLoad" class="btn-primary btn-md">人数を数える（送信しません）</button>
          <span class="note" id="mkSegState" aria-live="polite"></span>
        </div>
        <div class="dry-panel" id="mkSegResult" hidden></div>
        <div class="measure-box" id="mkMeasureBox" hidden></div>
        <!--
          連続配信（シーケンス）の状況。**送信前に「誰が何通目か・次に何人へ送るか」を見る**。
          ここでは送信もキュー登録もしない。実際に届く HTML は各ステップの「文面を見る」で確認する。
        -->
        <!--
          無料体験の入口（自動付与）の下見。**ここでは付与しない**。
          CSV 取り込みの対象総数・付与候補・除外理由を送信前に確認する。
        -->
        <div class="seq-box">
          <div class="toolbar">
            <button type="button" id="mkTrialLoad" class="btn-ghost btn-md">無料体験の入口を数える（付与しません）</button>
            <span class="note" id="mkTrialState" aria-live="polite"></span>
          </div>
          <div class="dry-panel" id="mkTrialResult" hidden></div>
        </div>
        <div class="seq-box">
          <div class="toolbar">
            <select id="mkSeqSelect" aria-label="連続配信キャンペーン"></select>
            <button type="button" id="mkSeqLoad" class="btn-primary btn-md">状況を見る（送信しません）</button>
            <span class="note" id="mkSeqState" aria-live="polite"></span>
          </div>
          <div class="dry-panel" id="mkSeqResult" hidden></div>
        </div>
        <!--
          反応（engagement）の状況。**送信前にここで「何人が反応なしで除外されるか」を見る**。
          除外を適用してよい材料が揃っていないときは、区分の人数を参考値と断ったうえで
          「除外は適用していません」と明示する（0 と未計測を混同させない）。
        -->
        <div class="dry-panel" id="mkEngBox" hidden></div>
      </section>

      <!--
        外部保有リストの取り込み（下見だけ）。
        ⚠️ この領域は **1 件も書き込まない**。CSV を読んで件数を数えるだけ。
           本番取り込みは別 Phase・別承認で、ボタンは常に disabled のまま置く。
        ⚠️ 13,000 行を DOM へ描かない。出すのは件数と理由コードだけ。
      -->
      <section class="step imp-step" aria-labelledby="impH">
        <h2 id="impH" class="step-h"><span class="step-n">＋</span> 外部顧客リストの取り込み（下見）</h2>
        <p class="note">
          別途お持ちの無料ユーザーリスト（CSV）を、<b>取り込まずに</b>下見します。
          件数と除外理由だけを表示し、<b>メールアドレス・氏名・顧客 ID は画面にも通信にも出しません</b>。
          <b>この操作では 1 件も取り込まれません。</b>
        </p>
        <div class="toolbar">
          <input type="file" id="impFile" accept=".csv,text/csv,text/plain" aria-label="CSV ファイル" />
          <button type="button" id="impPreview" class="btn-primary btn-md">下見する（取り込みません）</button>
          <button type="button" id="impSpec" class="btn-ghost btn-sm">受け入れ仕様を見る</button>
          <span class="note" id="impState" aria-live="polite"></span>
        </div>
        <p class="imp-warn" id="impNotImported">まだ取り込まれていません（下見のみ）。</p>
        <ul class="imp-policy">
          <li><b>初回は新規作成のみ</b>です（CREATE のみ）。</li>
          <li>すでに AK にいる方（下見の「既存更新候補」）は <b>1 件も更新しません</b>。</li>
          <li>AK 側の重複は<b>再判定</b>して除外します（自動統合はしません）。</li>
          <li>1 回の実行は<b>最大 100 件</b>の試験取り込みです。</li>
          <li>実行には<b>別承認</b>（書き込みの有効化 + 確認文字列）が必要です。</li>
          <li><b>現在は書き込み無効</b>のため、このボタンは押せません。</li>
        </ul>
        <div class="dry-panel" id="impResult" hidden></div>
        <div class="toolbar imp-run-row">
          <button type="button" id="impRun" class="btn-primary btn-md" disabled aria-disabled="true">
            本番取り込みを実行（無効）
          </button>
          <span class="note">
            本番取り込みは<b>別承認</b>が必要です。実 CSV の受領・書き込みの有効化・実行手順が決まるまで、このボタンは押せません。
            大量取り込みは下の「取り込みジョブ」を使います（この単発ボタンは使いません）。
          </span>
        </div>
      </section>

      <!--
        取り込みジョブ（親ジョブ + 子バッチ）。
        ⚠️ 残り 14,284 件を 1 回 100 件の手動実行で回すと約 143 回になるため、
           **開始は 1 回**にして内部で 100 件以下の子バッチへ分割する。
        ⚠️ 1 呼び出し = 子バッチ 1 つ。画面が逐次呼び直す（**並行に走らせない**）。
        ⚠️ 書き込みゲート（CUSTOMER_IMPORT_WRITE_ENABLED）が閉じていれば開始できない。
        ⚠️ 画面に出すのは件数と状態だけ。**アドレス・氏名・顧客 ID は出さない。**
      -->
      <section class="step imp-step" aria-labelledby="impJobH">
        <h2 id="impJobH" class="step-h"><span class="step-n">＋</span> 外部顧客リストの取り込みジョブ（大量）</h2>
        <p class="note">
          残りの取り込み対象を、<b>100 件以下の子バッチ</b>へ自動で分割して進めます。
          開始は 1 回だけで、途中で止まっても<b>続きから再開</b>できます。
          作るのは<b>新規のみ</b>で、すでに AK にいる方は <b>1 件も更新しません</b>。
        </p>
        <div class="toolbar">
          <input type="file" id="impJobFile" accept=".csv,text/csv,text/plain" multiple aria-label="CSV ファイル（複数可）" />
          <input type="text" id="impJobBatchId" placeholder="ImportBatchId（例 imp-2026-08-05-004）" aria-label="ImportBatchId" />
          <button type="button" id="impJobPlan" class="btn-ghost btn-md">下見する（取り込みません）</button>
          <span class="note" id="impJobState" aria-live="polite"></span>
        </div>
        <div class="dry-panel" id="impJobPlanResult" hidden></div>

        <div class="toolbar">
          <input type="text" id="impJobConfirm" placeholder="確認文字列（下見に表示されます）" aria-label="確認文字列" />
          <button type="button" id="impJobStart" class="btn-primary btn-md" disabled aria-disabled="true">開始する</button>
          <button type="button" id="impJobResume" class="btn-primary btn-md" disabled aria-disabled="true">再開する</button>
          <button type="button" id="impJobCancel" class="btn-ghost btn-md" disabled aria-disabled="true">取り消す</button>
        </div>
        <p class="imp-warn">
          <b>【BLOCKED】このジョブの書き込みは設計未完了のため停止中です。</b>
          同時実行を fail-closed で拒否できず、親ジョブが正本になっていないため、
          <b>開始・再開を押しても API 側が 403 で断ります</b>（下見と進捗表示だけ使えます）。
          正本と排他を Upstash Redis へ移す設計の承認待ちです（docs/decisions.md 2026-08-05）。
        </p>
        <p class="imp-warn" id="impJobGateWarn" hidden>
          書き込みゲートが閉じています（CUSTOMER_IMPORT_WRITE_ENABLED）。<b>開始できません。</b>
        </p>

        <div class="imp-job-progress" id="impJobProgress" hidden>
          <div class="imp-job-bar"><span id="impJobBarFill"></span></div>
          <dl class="imp-job-stats">
            <div><dt>jobId</dt><dd id="impJobIdV">-</dd></div>
            <div><dt>ImportBatchId</dt><dd id="impJobBatchV">-</dd></div>
            <div><dt>Source</dt><dd id="impJobSourceV">-</dd></div>
            <div><dt>状態</dt><dd id="impJobStatusV">-</dd></div>
            <div><dt>対象総数</dt><dd id="impJobTotalV">-</dd></div>
            <div><dt>処理済み</dt><dd id="impJobAttemptedV">-</dd></div>
            <div><dt>作成済み</dt><dd id="impJobCreatedV">-</dd></div>
            <div><dt>既存スキップ</dt><dd id="impJobSkippedV">-</dd></div>
            <div><dt>失敗</dt><dd id="impJobFailedV">-</dd></div>
            <div><dt>残件数</dt><dd id="impJobRemainingV">-</dd></div>
            <div><dt>進捗率</dt><dd id="impJobPctV">-</dd></div>
            <div><dt>現在の子バッチ</dt><dd id="impJobChildV">-</dd></div>
            <div><dt>最終更新時刻</dt><dd id="impJobUpdatedV">-</dd></div>
          </dl>
          <p class="note" id="impJobRollback"></p>
        </div>

        <ul class="imp-policy">
          <li>子バッチは<b>最大 100 件</b>、Airtable への書き込みは<b>10 件ずつ</b>です。</li>
          <li>子バッチのたびに既存アドレスを<b>取り直して再判定</b>します（二重作成しません）。</li>
          <li><b>完了したジョブは再実行できません。</b>取り消しても<b>作成済みの行は消しません</b>。</li>
          <li>戻すときは <b>Source 単位の隔離</b>（削除ではありません）。</li>
          <li>このジョブは<b>メールを 1 通も送りません</b>。</li>
        </ul>
      </section>

      <!--
        自動配信（AK 専用メルマガ自動化）。
        ⚠️ Phase A は **dry-run まで**。プリセットは全て初期 OFF で、
           有効化・実行・取消は配線していない（API は 501 を返す）。
        ⚠️ この領域は **1 通も送らず、1 行も書かない**。件数と除外理由だけを表示する。
        ⚠️ 送信経路は既存の 1 本だけ（ScheduledEmails → 既存 dispatcher）。
           自動化は独自の配信基盤を持たない。
      -->
      <section class="step auto-step" aria-labelledby="autoH">
        <h2 id="autoH" class="step-h"><span class="step-n">⏱</span> 自動配信</h2>
        <p class="note">
          条件と配信時刻を決めておけば、対象者の抽出から配信までを自動で行う設定です。
          プリセットは<b>すべて OFF</b>で、管理者が明示的に有効化するまで<b>自動実行されません</b>。
        </p>
        <p class="imp-warn" id="autoBlockedNote">
          <b>本番自動配信は未有効です。</b>
          編集内容の入力と下見（dry-run）はできますが、<b>保存・ACTIVE 化・一時停止・取消はできません</b>。
          ボタンを迂回して API を直接呼んでも <b>403</b> で拒否されます。
        </p>

        <div class="toolbar">
          <button type="button" id="autoList" class="btn-ghost btn-md">自動化一覧を読み込む</button>
          <select id="autoPick" aria-label="自動化を選ぶ"><option value="">自動化を選択…</option></select>
          <span class="note" id="autoState" aria-live="polite"></span>
        </div>
        <div class="dry-panel" id="autoListResult" hidden></div>

        <!-- ── 見込み客プール（外部 CSV）─────────────────────────────
             反応した人だけ Customers へ登録する。未反応のアドレスは
             顧客台帳へ入れない。**保存系ボタンは env が開くまで disabled**。 -->
        <h3 class="sub-h">見込み客プール（外部リスト）</h3>
        <p class="imp-meta">
          1 回でも開封・クリックした人は<strong>自動で</strong>顧客台帳へ登録されます（定期実行）。
          下の「反応した人を登録」は<strong>手動の救済・再実行</strong>用です。
          3 回送って無反応なら登録せず、以後の配信対象から永久に外します
          （除外は台帳に残り、CSV を入れ直しても復活しません）。
        </p>

        <div class="toolbar">
          <button type="button" id="prSnapshot" class="btn-ghost btn-md">顧客一覧の写しを更新（依頼）</button>
          <button type="button" id="prStatus" class="btn-ghost btn-md">件数を確認</button>
          <button type="button" id="prPreview" class="btn-primary btn-md">配信の下見（送信しません）</button>
          <button type="button" id="prPromoPreview" class="btn-ghost btn-md">昇格の下見（登録しません）</button>
        </div>

        <dl class="auto-stats" id="prCounts" hidden>
          <div><dt>送信候補</dt><dd id="prActiveV">-</dd></div>
