    /** 通知（内容別に色分けし、「何をすべきか」まで書く） */
    function mkNotify(kind, text, detail) {
      const box = $('mkNotices');
      if (!box) return;
      const el = document.createElement('div');
      el.className = 'notice notice-' + kind;
      const t = document.createElement('b'); t.textContent = text; el.appendChild(t);
      if (detail) { const d = document.createElement('span'); d.className = 'notice-d'; d.textContent = detail; el.appendChild(d); }
      const x = document.createElement('button'); x.type = 'button'; x.className = 'notice-x'; x.textContent = '×';
      x.addEventListener('click', () => el.remove());
      el.appendChild(x);
      box.prepend(el);
      while (box.children.length > 4) box.lastChild.remove();
    }

    /** 現在の母集団から dry-run の指紋を作る（確認した対象と送る対象のズレを検知する） */
    function mkFingerprint() {
      return flowApi().computeSelectionFingerprint({
        selectedIds: [...mkSelected], filters: mkState.filters,
        campaignId: mkState.campaignId, campaignVersion: mkState.campaignVersion,
        handoff: mkState.handoff,
      });
    }

    /** dry-run 結果を無効にする（選択・条件・キャンペーンが変わったとき） */
    function mkInvalidateDryRun(why) {
      if (!mkState.dryRun) return;
      mkState.dryRun = null;
      mkState.enqueued = false;
      mkState.dispatch = {};
      const panel = $('mkDryPanel');
      if (panel) { panel.hidden = true; panel.innerHTML = ''; }
      mkNotify('warn', '確認結果を無効にしました', why + ' もう一度 dry-run してください。');
      mkSyncFlow();
    }

    /** 状態 → 画面（ボタンの活性・ステップ表示・sticky バー）を一括更新する */
    function mkSyncFlow() {
      mkState.selectedIds = [...mkSelected];
      const st = { ...mkState, selectedIds: [...mkSelected] };
      const step = flowApi().resolveStep(st);
      for (const el of document.querySelectorAll('#mkSteps .stp')) {
        const n = Number(el.dataset.step);
        el.classList.toggle('is-now', n === step);
        el.classList.toggle('is-done', n < step);
      }
      const mkProg = $('mkProgress');
      if (mkProg) mkProg.textContent = 'Step ' + step + ' / 6';
      // 現在地はカードの色とバッジの両方で示す（色覚に依存しない）
      for (const card of document.querySelectorAll('#paneMkt .step')) {
        const n = Number(card.dataset.step);
        card.classList.toggle('is-now', n === step);
        card.classList.toggle('is-done', n < step);
        let badge = card.querySelector('.step-now-badge');
        if (n === step) {
          if (!badge) {
            badge = document.createElement('span');
            badge.className = 'step-now-badge';
            badge.textContent = '現在の操作';
            card.querySelector('.step-h')?.appendChild(badge);
          }
        } else if (badge) {
          badge.remove();
        }
      }
      const apply = (id, verdict, labelWhenOk) => {
        const btn = $(id);
        if (!btn) return;
        btn.disabled = !verdict.allowed;
        btn.title = verdict.allowed ? (labelWhenOk || '') : (flowApi().BLOCK_LABEL[verdict.reason] || '');
      };
      apply('mkDryRun', flowApi().canDryRun(st));
      apply('mkDispatchCheck', flowApi().canDispatchCheck(st));
      apply('mkDispatchRun', flowApi().canDispatchSend(st));

      // 文面の確認状態（編集したら送信系は押せない）
      const content = draftApi().canSendContent({
        campaign: mkState.campaign, draftValid: mkContent.valid,
        draft: mkDraft(), confirmed: mkContent.confirmed,
      });
      if (!content.allowed) {
        for (const id of ['mkDispatchCheck', 'mkDispatchRun']) {
          const b3 = $(id);
          if (b3) { b3.disabled = true; b3.title = draftApi().CONTENT_BLOCK_LABEL[content.reason] || ''; }
        }
      }
      const cs = $('mkContentState');
      if (cs) {
        cs.textContent = content.allowed
          ? '文面: 確認済み（hash ' + String(mkContent.confirmed.contentHash).slice(0, 12) + '）'
          : '文面: ' + (draftApi().CONTENT_BLOCK_LABEL[content.reason] || '未確認');
        cs.className = 'dry-state' + (content.allowed ? ' is-ok' : ' is-stale');
      }

      const dry = $('mkDryState');
      if (dry) {
        const stale = mkState.dryRun ? flowApi().isDryRunStale({ dryRun: mkState.dryRun, current: st }) : true;
        dry.textContent = !mkState.dryRun ? '未確認'
          : stale ? '確認結果は無効（対象が変わりました）'
            : '確認済み: 送信対象 ' + (mkState.dryRun.willSend || 0) + ' 名';
        dry.className = 'dry-state ' + (!mkState.dryRun ? '' : stale ? 'is-stale' : 'is-ok');
      }

      // sticky バー（現在地と次の操作）
      const bar = $('mkStickyBar');
      if (bar) {
        bar.hidden = false;
        $('sbSel').textContent = mkSelected.size + ' 名を選択';
        $('sbCamp').textContent = mkState.campaign
          ? (mkState.campaign.name + ' v' + mkState.campaign.version + (mkState.campaign.testOnly ? '（テスト専用）' : ''))
          : 'キャンペーン未選択';
        $('sbDry').textContent = dry ? dry.textContent : '';
        $('sbGate').textContent = 'gate: 登録' + (mkState.sendEnabled ? '可' : '不可') + ' / 配信' + (mkState.dispatchEnabled ? '可' : '不可');
        const next = mkNextAction(st);
        const nb = $('sbNext');
        const toneByStep = { 1: 'btn-primary', 2: 'btn-warning', 3: 'btn-purple', 4: 'btn-success', 5: 'btn-danger', 6: 'btn-primary' };
        nb.className = 'btn-lg ' + (toneByStep[step] || 'btn-primary');
        nb.textContent = next.label;
        nb.disabled = !next.target;
        nb.onclick = next.target ? () => { const t = $(next.target); if (t) { t.scrollIntoView({ block: 'center' }); t.focus?.(); } } : null;
      }
      const counts = $('mkStepCounts');
      if (counts) {
        // 引き継ぎ中は画面選択を使わない。「取得 0 名 / 選択 0 名」を主表示にすると
        // 異常に見えるので、引き継ぎ人数を主にして取得件数は補助へ下げる。
        counts.textContent = mkState.handoff
          ? '引き継ぎ対象 ' + mkState.handoff.grantedCount + ' 名（画面での再選択は不要）'
          : '取得 ' + mkState.loadedCount + ' 名 / 選択 ' + mkSelected.size + ' 名';
        counts.classList.toggle('is-handoff', !!mkState.handoff);
      }
      const sub = $('mkStepCountsSub');
      if (sub) {
        sub.hidden = !mkState.handoff;
        sub.textContent = mkState.handoff
          ? '（参考）取得 ' + mkState.loadedCount + ' 名 / 選択 ' + mkSelected.size + ' 名'
            + '。対象は送信のたびにサーバーが確定します。'
          : '';
      }
    }

    /** 次に押すべきものを 1 つだけ示す */
    function mkNextAction(st) {
      if (mkSelected.size === 0) return { label: '顧客を選ぶ', target: 'mkSelAll' };
      if (!mkState.campaignId) return { label: 'キャンペーンを選ぶ', target: 'mkCampaign' };
      const enq = flowApi().canEnqueue(st);
      if (!enq.allowed && (enq.reason === 'no_dry_run' || enq.reason === 'dry_run_stale')) {
        return { label: '送信対象を確認', target: 'mkDryRun' };
      }
      if (!mkState.enqueued) return { label: 'キュー登録へ', target: 'mkDryRun' };
      if (!mkState.dispatch.check) return { label: '配信内容を確認', target: 'mkDispatchCheck' };
      return { label: '実際に配信する', target: 'mkDispatchRun' };
    }

    const DISPATCH_API = '/.netlify/functions/marketing-campaign-dispatch';
    async function mkDispatchCall(dryRun, jobId, expectedWillSend) {
      const secret = secretEl.value.trim();
      if (!secret) { $('connBody').hidden = false; throw new Error('管理シークレットを入力してください'); }
      // jobId を渡すと、そのジョブだけが対象になる（他のキューを巻き込まない）。
      // 実送信では確認した人数も添え、API 側でも食い違いを弾く。
      const payload = jobId ? { dryRun, jobId } : { dryRun };
      if (!dryRun && Number.isFinite(Number(expectedWillSend))) {
        payload.expectedWillSend = Number(expectedWillSend);
      }
      const res = await fetch(DISPATCH_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
      return data;
    }

    /**
     * キュー登録したジョブを**そのまま送信まで実行する**。
     *
     * ── なぜここでやるか ──────────────────────────────────────
     * 「◯名へ送信する」を押したのにキュー登録で止まると、運用者は送ったつもりで
     * 画面を離れ、ジョブが PENDING のまま残る（2026-08-04 の 36 名ジョブで実際に発生）。
     * 別画面・CLI・手動 dispatcher を要求しない。**1 操作で完結させる**。
     *
     * ── 安全性は落とさない ────────────────────────────────────
     * ジョブごとに「確認（dryRun）→ 実送信」を通す。実送信には jobId と
     * 確認時の人数を必ず添えるので、
     *   ・他のキューを巻き込まない
     *   ・確認と人数が食い違えば API 側が 409 で止める（書き込みゼロ）
     *   ・同じジョブで送信済みの相手は API 側が除外する（二重送信しない）
     * 送信直前の配信停止・バウンス・退会・頻度の再判定も従来どおり働く。
     */
    async function mkSendQueuedJobs(jobs) {
      const list = (jobs || []).map((j) => String(j && j.jobId ? j.jobId : '')).filter(Boolean);
      const out = { attempted: 0, sent: 0, failed: 0, skipped: 0, byReason: {}, errors: [], jobs: list.length };
      if (list.length === 0) {
        out.errors.push('登録したジョブを特定できませんでした。送信状況から実行してください。');
        return out;
      }
      for (const jobId of list) {
        try {
          // ① 確認（書き込みなし）。ここで実際に送る人数が決まる
          const pre = jobSendApi().buildJobPreflight(await mkDispatchCall(true, jobId), jobId);
          if (!pre.ok) {
            out.errors.push(jobSendApi().JOB_SEND_BLOCK_LABEL[pre.reason] || '確認できませんでした');
            continue;
          }
          if (pre.willSend === 0) {
            out.skipped += pre.willSkip;
            for (const [k, v] of Object.entries(pre.skipByReason || {})) {
              out.byReason[k] = (out.byReason[k] || 0) + v;
            }
            continue;
          }
          // ② 実送信（確認した人数を添える。食い違えば API 側が止める）
          out.attempted += pre.willSend;
          const res = await mkDispatchCall(false, jobId, pre.willSend);
          out.sent += Number(res.sent) || 0;
          out.failed += Number(res.failed) || 0;
          out.skipped += Number(res.skipped) || 0;
          for (const [k, v] of Object.entries(res.skippedByReason || {})) {
            out.byReason[k] = (out.byReason[k] || 0) + v;
          }
        } catch (e) {
          out.errors.push(String((e && e.message) || '送信に失敗しました'));
        }
      }
      return out;
    }

    /**
     * 送信結果を出す。**成功・部分失敗・失敗を読み違えさせない**。
     * 失敗しても PENDING のまま黙って放置せず、理由と再実行できることを伝える。
     */
    function mkRenderSendOutcome(r, enqueued) {
      const queued = Number(enqueued && enqueued.queued) || 0;
      const reasons = Object.entries(r.byReason || {})
        .map(([k, v]) => (mkExclusionLabel(k) + ' ' + v + ' 名')).join(' / ');
      const detail = 'キュー登録 ' + queued + ' 名 / 送信 ' + r.sent + ' 名'
        + (r.failed ? ' / 失敗 ' + r.failed + ' 名' : '')
        + (r.skipped ? ' / 送らなかった ' + r.skipped + ' 名' : '')
        + (reasons ? '（' + reasons + '）' : '');

      if (r.errors.length > 0 && r.sent === 0) {
        mkNotify('err', '送信できませんでした（キュー登録は済んでいます）',
          r.errors.join(' / ') + '。' + detail
          + '。送信状況の該当ジョブから「配信内容を確認」→「今すぐ送信」で再実行できます'
          + '（送信済みの相手へは二重に送りません）。');
        return;
      }
      if (r.failed > 0 || r.errors.length > 0) {
        mkNotify('warn', r.sent + ' 名へ送信しました（一部は送れていません）',
          detail + (r.errors.length ? ' / ' + r.errors.join(' / ') : '')
          + '。失敗分は自動で再送しません。送信状況から再実行できます。');
        return;
      }
      if (r.sent === 0) {
        mkNotify('warn', '送信対象がありませんでした',
          detail + '。全員が送信直前の再判定で除外されました。');
        return;
      }
      mkNotify('ok', r.sent + ' 名へ送信しました', detail
        + '。「送信済み」は配信基盤が受理した状態です。実際に届いたかは送信状況で確認できます。');
    }

    /** 除外理由コード → 表示名（API が返すラベルを優先） */
    function mkExclusionLabel(code) {
      const labels = (mkLabels && mkLabels.exclusion) || {};
      return labels[code] || code;
    }

    function mkRenderDispatch(data, dryRun) {
      const box = $('mkDispatchResult');
      box.innerHTML = '';
      const s = dossierSection(box, dryRun ? '確認結果（送信していません）' : '配信結果');
      dossierRow(s, '対象ジョブ', String(data.jobs || 0));
      dossierRow(s, '再検証した宛先', String(data.verified || 0));
      dossierRow(s, dryRun ? '送信される見込み' : '送信済み',
        String(dryRun ? (data.jobResults || []).reduce((a, j) => a + (j.willSend || 0), 0) : (data.sent || 0)),
        'ok');
      dossierRow(s, '送らない', String(dryRun
        ? (data.jobResults || []).reduce((a, j) => a + (j.willSkip || 0), 0)
        : (data.skipped || 0)));
      const reasons = data.skippedByReason || {};
      for (const k of Object.keys(reasons)) dossierRow(s, '　' + k, String(reasons[k]), 'sub-row');
      if (data.failed) dossierRow(s, '失敗', String(data.failed), 'ng');
      const sup = data.providerSuppression || {};
      dossierRow(s, '配信基盤の配信停止リスト照合',
        sup.available ? ('OK（' + (sup.total || 0) + ' 件）') : '確認できず（送信しません）',
        sup.available ? '' : 'ng');
    }

    $('mkDispatchCheck').addEventListener('click', async () => {
      const btn = $('mkDispatchCheck');
      btn.disabled = true;
      $('mkDispatchState').textContent = '確認中…';
      try {
        const data = await mkDispatchCall(true);
        mkRenderDispatch(data, true);
        const willSend = (data.jobResults || []).reduce((a, j) => a + (j.willSend || 0), 0);
        $('mkDispatchState').textContent = data.jobs
          ? '確認しました。この内容で配信できます。'
          : '送信待ちのキューはありません。';
        // 送る相手が 1 人もいないなら実行ボタンは開けない
        // 「これから送る 1 件」を確定させる。1 件に特定できなければ送らせない
        const preflight = sendApi().buildDispatchPreflight(data);
        mkState.dispatch = { ...mkState.dispatch, check: { willSend, jobs: data.jobs }, preflight, raw: data };
        if (!preflight.ok) {
          mkNotify('warn', '送信できません', sendApi().SEND_BLOCK_LABEL[preflight.reason] || '');
        }
        mkSyncFlow();
        if (!(data.jobs && willSend > 0)) {
          mkNotify('warn', '送信対象がありません', '送信待ちのジョブが無いか、再検証で全員除外されました。');
        }
      } catch (e) {
        $('mkDispatchState').textContent = '確認に失敗しました: ' + (e && e.message ? e.message : 'unknown');
        $('mkDispatchRun').disabled = true;
      } finally {
        btn.disabled = false;
      }
    });

    /** 送信系の判定の単一源（marketingSendNow.js） */
    const sendApi = () => window.__mkSend;

    $('mkDispatchRun').addEventListener('click', async () => {
      const btn = $('mkDispatchRun');
      if (btn.dataset.busy === '1') return;                  // 二重クリックで 2 回走らせない
      const c = mkState.campaign || currentCampaign();
      const sendState = {
        busy: mkState.busy, dispatchEnabled: mkState.dispatchEnabled,
        dryRun: mkState.dryRun,
        dryRunStale: mkState.dryRun ? flowApi().isDryRunStale({ dryRun: mkState.dryRun, current: { ...mkState, selectedIds: [...mkSelected] } }) : true,
        enqueued: mkState.enqueued, preflight: mkState.dispatch.preflight,
        sent: !!mkState.dispatch.sent, campaign: c,
      };
      const verdict = sendApi().canSendNow(sendState);
      if (!verdict.allowed) { mkNotify('warn', '送信できません', sendApi().SEND_BLOCK_LABEL[verdict.reason] || ''); return; }

      const operationId = 'send-' + (mkState.dispatch.preflight.jobId || 'job') + '-' + Date.now().toString(36);
      const conf = sendApi().buildSendNowConfirmation({
        campaign: c, dryRun: mkState.dryRun, preflight: mkState.dispatch.preflight,
        dispatchEnabled: mkState.dispatchEnabled, sendEnabled: mkState.sendEnabled, operationId,
      });

      // ① 内容を読ませる（何が起きるかを全部出す）
      const ok1 = window.confirm(
        '【今すぐ送信】' + conf.effect + '\n\n'
        + 'キャンペーン: ' + conf.campaignName + ' v' + conf.version + '（' + conf.kind + '）\n'
        + '宛先: ' + conf.audience + '\n'
        + '選択 ' + conf.selected + ' 名 / 対象 ' + conf.targeted + ' 名 / 除外 ' + conf.excluded + ' 名\n'
        + '実送信予定: ' + conf.willSend + ' 通\n'
        + 'jobId: ' + conf.jobId + '\n'
        + 'operationId: ' + conf.operationId + '\n'
        + 'gate: 登録' + (conf.gate.enqueue ? '可' : '不可') + ' / 配信' + (conf.gate.dispatch ? '可' : '不可') + '\n'
        + '二重送信防止: ' + conf.duplicateGuard + '\n'
        + conf.afterSend + '\n\n続けますか？'
      );
      if (!ok1) return;

      // ② 通常配信は送信予定人数の入力一致を必須にする
      let typed = '';
      if (conf.requiresTypedCount) {
        typed = window.prompt('確認のため、実送信予定人数「' + conf.willSend + '」を入力してください') || '';
      }

      btn.dataset.busy = '1';
      mkState.busy = true; mkSyncFlow();
      $('mkDispatchState').textContent = '送信直前の再確認中…';
      try {
        // ③ 直前にもう一度 dryRun:true を取り、**同じ jobId・同じ内容**であることを確かめる
        const latest = await mkDispatchCall(true, mkState.dispatch.preflight.jobId);
        const pre = sendApi().verifySendPrecondition({
          preflight: mkState.dispatch.preflight, latest,
          confirmedCount: conf.willSend, typedCount: typed, campaign: c,
        });
        if (!pre.ok) {
          mkState.busy = false; btn.dataset.busy = ''; mkSyncFlow();
          mkNotify('warn', '送信を中止しました', sendApi().SEND_BLOCK_LABEL[pre.reason] || '');
          $('mkDispatchState').textContent = '';
          return;
        }

        // ④ 実送信（既存 dispatcher のみ。対象は確認したジョブ 1 件に限定する）
        $('mkDispatchState').textContent = conf.willSend + ' 通を送信中…';
        const data = await mkDispatchCall(false, pre.jobId);
        const res = sendApi().summarizeSendResult(data, { completedAt: new Date().toISOString() });
        mkState.busy = false; btn.dataset.busy = '';
        // 送信後は直前確認を破棄する（同じ画面から二度押せない）
        mkState.dispatch = { sent: true, result: data, summary: res, check: null, preflight: null };
        mkRenderSendResult(conf, res);
        mkSyncFlow();
        if (res.outcome.key === 'PARTIAL' || res.outcome.key === 'FAILED') {
          mkNotify('warn', res.outcome.label + 'で終了しました', res.partialNote || '失敗理由を確認してください。再送は自動では行いません。');
        } else {
          mkNotify('ok', '送信しました', res.sent + ' 通を配信基盤が受理しました。' + res.deliveredNote);
        }
      } catch (e) {
        mkState.busy = false; btn.dataset.busy = ''; mkSyncFlow();
        mkNotify('err', '送信に失敗しました',
          '配信基盤へ到達できませんでした。Step 6 の送信状況で、実際に送られたかを必ず確認してください（再送は自動では行いません）。');
        $('mkDispatchState').textContent = '';
      }
    });

    /** 送信結果を画面内に出す（取消不可・部分成功・受理と配信の別を明示） */
    function mkRenderSendResult(conf, res) {
      const box = $('mkDispatchResult');
      if (!box) return;
      box.innerHTML = '';
      const head = document.createElement('div');
      const badge = document.createElement('span');
      badge.className = 'badge b-' + res.outcome.tone;
      badge.textContent = res.outcome.label;
      head.appendChild(badge);
      const t = document.createElement('b');
      t.textContent = ' ' + conf.campaignName + ' v' + conf.version + '（' + conf.kind + '）';
      head.appendChild(t);
      box.appendChild(head);

      const row = (k, v) => {
        const d = document.createElement('div'); d.className = 'dp-row';
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); box.appendChild(d);
      };
      row('送信（provider 受理）', res.sent + ' 通');
      row('スキップ', res.skipped + ' 通');
      row('失敗', res.failed + ' 通');
      row('ジョブ', conf.jobId + '（' + res.outcome.label + '）');
      row('完了時刻', res.completedAt ? fmtDate(res.completedAt) : '—');
      row('取消', res.cancelNote);
      if (res.skippedReasons.length) {
        row('除外理由', res.skippedReasons.map((x) => (window.__planView?.labelFor?.(x.reason) || x.reason) + ' ' + x.count + ' 件').join(' / '));
      }
      if (res.partialNote) row('部分成功の扱い', res.partialNote);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = res.deliveredNote;
      box.appendChild(note);
    }

    $('mkLoad').addEventListener('click', mkLoad);
    $('mkQ').addEventListener('input', mkRender);
    // 選択の更新は純粋モジュールへ委譲（絞り込みを変えても選択が勝手に増えない）。
    // 「全顧客から選択」= いま読み込んでいる全件（検索・絞り込みに依存しない）
    // 「表示中のみ選択」= 画面に出ている行だけ
    $('mkSelAllLoaded').addEventListener('click', () => {
      const all = (mkData && mkData.rows) ? mkData.rows : [];
      const before = mkSelected.size;
      const next = window.__planView.updateSelection({
        current: mkSelected,
        visibleIds: all.map((r) => r.recordId),
        selectableIds: all.filter((r) => r.sendable).map((r) => r.recordId),
        op: 'add-visible',
      });
      mkSelected.clear();
      for (const id of next) mkSelected.add(id);
      mkRender();
      // 大量選択を黙って行わない
      mkMsg('全顧客から ' + (mkSelected.size - before) + ' 名を追加しました（合計 ' + mkSelected.size + ' 名 / 読み込み済み ' + all.length + ' 名中）');
    });

    $('mkSelAll').addEventListener('click', () => {
      const visible = mkVisibleRows();
      const next = window.__planView.updateSelection({
        current: mkSelected,
        visibleIds: visible.map((r) => r.recordId),
        // 送信できない相手は選ばせない（UI 側でも fail closed）
        selectableIds: visible.filter((r) => r.sendable).map((r) => r.recordId),
        op: 'add-visible',
      });
      mkSelected.clear();
      for (const id of next) mkSelected.add(id);
      mkRender();
      mkMsg('表示中から ' + mkSelected.size + ' 名を選択中です（表示 ' + visible.length + ' 名）');
    });
    $('mkSelNone').addEventListener('click', () => {
      const next = window.__planView.updateSelection({ current: mkSelected, op: 'clear' });
      mkSelected.clear();
      for (const id of next) mkSelected.add(id);
      mkRender();
    });
    $('mkSelList').addEventListener('click', () => {
      const body = mkOpenModal('選択中の顧客（' + mkSelected.size + ' 名）');
      const byId = new Map((mkData && mkData.rows ? mkData.rows : []).map((r) => [r.recordId, r]));
      const s = dossierSection(body, '選択は recordId で保持しています');
      for (const id of mkSelected) {
        const r = byId.get(id);
        dossierRow(s, r ? (r.name || r.email || id) : id,
          r ? (r.email + ' / ' + (CONTRACT_LABEL[r.contract] || r.contract)) : '（現在の絞り込みに表示されていません）',
          r ? '' : 'ng');
      }
    });

    // ── モーダル（プレビュー / dry-run 確認）──
    function mkOpenModal(title) {
      $('mkModalTitle').textContent = title;
      $('mkBackdrop').hidden = false;
      lockScroll();
      $('mkModalBody').innerHTML = '';
      return $('mkModalBody');
    }
    function mkCloseModal() {
      $('mkBackdrop').hidden = true;
      if ($('dtBackdrop').hidden && $('pvBackdrop').hidden) unlockScroll();
    }
    $('mkModalClose').addEventListener('click', mkCloseModal);
    $('mkModalBack').addEventListener('click', mkCloseModal);
    $('mkBackdrop').addEventListener('click', (e) => { if (e.target === $('mkBackdrop')) mkCloseModal(); });

    // ── 本文プレビュー ──
    $('mkPreview').addEventListener('click', async () => {
      const c = currentCampaign();
      if (!c) { mkMsg('キャンペーンを選択してください', 'err'); return; }
      const data = await mkCall({ action: 'preview', campaignId: c.campaignId, sampleName: '山田' });
      if (!data) return;
      const body = mkOpenModal('本文プレビュー');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const h = document.createElement('h3'); h.textContent = '件名'; sec.appendChild(h);
      const sub = document.createElement('p'); sub.className = 'prev-subject'; sub.textContent = data.subject;
      sec.appendChild(sub);
      body.appendChild(sec);

      // ── プリヘッダー（受信箱の一覧に出る一文）──
      if (data.preheader) {
        const ph = document.createElement('p'); ph.className = 'note';
        ph.textContent = '受信箱の一覧に出る一文: ' + data.preheader;
        sec.appendChild(ph);
      }

      const sec2 = document.createElement('div'); sec2.className = 'dt-sec';
      const h2 = document.createElement('h3'); h2.textContent = '本文'; sec2.appendChild(h2);

      // 表示の切替（デスクトップ幅 / モバイル幅 / テキスト版）。
      // 実際に届く形をそのまま見るため、同じ HTML を幅だけ変えて表示する。
      const tabs = document.createElement('div'); tabs.className = 'toolbar prev-tabs';
      const frame = document.createElement('iframe');
      frame.className = 'prev-frame';
      frame.setAttribute('sandbox', '');            // スクリプト実行なし
      frame.setAttribute('title', 'メール本文のプレビュー');
      const textBox = document.createElement('pre');
      textBox.className = 'prev-body';
      textBox.textContent = data.text || '';
      textBox.hidden = true;

      const showHtml = (width) => {
        textBox.hidden = true; frame.hidden = false;
        frame.style.width = width ? width + 'px' : '100%';
        frame.style.maxWidth = '100%';
        // 実際の受信環境に近い白地でメール本文だけを表示する（管理 UI の配色を混ぜない）
        frame.srcdoc = '<body style="margin:0;">' + data.html + '</body>';
      };
      const modes = [
        ['🖥 デスクトップ幅', () => showHtml(0)],
        ['📱 モバイル幅（375px）', () => showHtml(375)],
        ['📄 テキスト版', () => { frame.hidden = true; textBox.hidden = false; }],
      ];
      let current = 0;
      const btns = modes.map(([label, fn], i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'btn-ghost btn-sm' + (i === 0 ? ' is-on' : '');
        b.textContent = label;
        b.addEventListener('click', () => {
          current = i;
          btns.forEach((x, j) => x.classList.toggle('is-on', j === current));
          fn();
        });
        tabs.appendChild(b);
        return b;
      });
      sec2.appendChild(tabs);
      sec2.appendChild(frame);
      sec2.appendChild(textBox);
      showHtml(0);

      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec2.appendChild(note);
      const unsub = document.createElement('p'); unsub.className = 'note';
      unsub.textContent = data.unsubscribeNote || '';
      sec2.appendChild(unsub);
      const sample = document.createElement('p'); sample.className = 'note';
      sample.textContent = 'プレビューはサンプル宛名「' + (data.sampleName || '山田') + '」と'
        + 'サンプルの配信停止 URL で表示しています（実際のお客様の情報は使っていません）。';
      sec2.appendChild(sample);
      body.appendChild(sec2);
    });

    // ── dry-run → 最終確認 → 送信 ──
    $('mkDryRun').addEventListener('click', async () => {
      const c = currentCampaign();
      const verdict = flowApi().canDryRun({ ...mkState, selectedIds: [...mkSelected] });
      if (!verdict.allowed) { mkNotify('warn', '実行できません', flowApi().BLOCK_LABEL[verdict.reason]); return; }
      if (!c.usable) { mkNotify('err', '使用停止中のキャンペーンです', c.disabledReason || ''); return; }
      // 押した瞬間に必ず表示を変える（無反応を作らない）
      mkState.busy = true; mkSyncFlow();
      $('mkDryState').textContent = '確認中…';
      $('mkDryState').className = 'dry-state';
      mkMsg('対象を確認中…');
      mkNotify('info', '送信対象を確認しています…',
        (mkState.handoff
          ? '付与成功者 ' + mkState.handoff.grantedCount + ' 名（引き継ぎ）'
          : '選択 ' + mkSelected.size + ' 名') + ' / ' + (c.name || ''));
      let plan = null;
      try {
        const draft = mkDraft();
        plan = await mkCall({
          action: 'dryRun', campaignId: c.campaignId, ...mkTargetPayload(),
          // 今回送る文面を一緒に確認する（確認した内容と送る内容を一致させる）
          subject: draft.subject, body: draft.body,
        });
      } catch (e) {
        plan = null;
      }
      mkState.busy = false;
      if (!plan) {
        // API 失敗でも必ず理由と次の操作を出す
        $('mkDryState').textContent = '確認に失敗しました';
        $('mkDryState').className = 'dry-state is-stale';
        mkNotify('err', '送信対象を確認できませんでした',
          '管理シークレット・ネットワーク・選択内容を確認して、もう一度お試しください。');
        mkMsg('');
        mkSyncFlow();
        return;
      }
      mkMsg('');
      if ((Number(plan.willSend) || 0) === 0) {
        mkNotify('warn', '対象者がいません',
          '選択 ' + plan.selected + ' 名すべてが除外されました（除外 ' + plan.excluded + ' 名）。除外理由を確認してください。');
      } else {
        mkNotify('ok', '確認しました', '対象 ' + plan.willSend + ' 名 / 除外 ' + plan.excluded + ' 名');
      }
      // この結果が「どの母集団に対する確認か」を指紋で固定する
      mkState.dryRun = {
        fingerprint: mkFingerprint(),
        selected: plan.selected, excluded: plan.excluded, willSend: plan.willSend,
        excludedDetail: plan.excludedDetail, planFingerprint: plan.planFingerprint,
        contentHash: plan.contentHash || '',
      };
      // 確認できたのは**この文面**。以後、編集されたら送信操作を止める
      mkContent.confirmed = draftApi().acceptConfirmation({
        draft: { subject: plan.subject, body: plan.body },
        contentHash: plan.contentHash, planFingerprint: plan.planFingerprint,
      });
      mkContent.acknowledged = false;
      if (plan.contentEdited) {
        mkNotify('info', '編集した文面で確認しました',
          '内容 hash: ' + String(plan.contentHash || '').slice(0, 12) + '（この文面だけが送信されます）');
      }
      mkState.enqueued = false;
      mkState.dispatch = {};
      mkRenderDryPanel(c, plan);
      mkSyncFlow();
      mkRenderConfirm(c, plan);
    });

    /** dry-run の結果を主要パネルへ（確認 → 登録の判断材料を 1 か所に集める） */
    function mkRenderDryPanel(c, plan) {
      const panel = $('mkDryPanel');
      if (!panel) return;
      panel.hidden = false;
      panel.innerHTML = '';
      const row = (k, v, cls) => {
        const d = document.createElement('div'); d.className = 'dp-row ' + (cls || '');
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); panel.appendChild(d);
      };
      row('キャンペーン', c.name + ' v' + c.version + (c.testOnly ? '（🧪 テスト専用）' : ''));
      // 「同一キャンペーン送信済み」で全員除外されたときに、何と衝突しているのかを読めるようにする
      row('送信識別子', c.campaignId + ' : v' + c.version);
      row('二重送信の判定', 'この キャンペーン × 版 × 受信者 の組でのみ「送信済み」と判定します（DeliveryKey）');
      if (plan.handoff) {
        row('引き継ぎ対象', (plan.handoff.resolved || 0) + ' 名（サーバーが付与成功者から確定）');
      }
      row(plan.handoff ? '対象人数' : '選択人数', plan.selected + ' 名');
      row('送信対象', plan.willSend + ' 名', plan.willSend > 0 ? 'is-ok' : 'is-ng');
      row('除外', plan.excluded + ' 名');
      const ex = flowApi().summarizeExclusions(plan.excludedDetail || []);
      if (ex.length) {
        const box = document.createElement('div'); box.className = 'dp-ex';
        const t = document.createElement('b'); t.textContent = '除外理由（送信できない理由。失敗ではありません）';
        box.appendChild(t);
        const ul = document.createElement('ul');
        for (const e of ex) {
          const li = document.createElement('li');
          li.textContent = (window.__planView?.labelFor?.(e.reason) || e.reason) + ' … ' + e.count + ' 名';
          ul.appendChild(li);
        }
        box.appendChild(ul); panel.appendChild(box);
      }
      row('gate', '登録' + (mkState.sendEnabled ? '可' : '不可') + ' / 配信' + (mkState.dispatchEnabled ? '可' : '不可'),
        mkState.sendEnabled ? '' : 'is-ng');
      row('二重送信防止', '同一 campaign×version×宛先は DeliveryKey で 1 通に固定（再実行しても増えない）');
      row('確認 ID', String(plan.planFingerprint || '').slice(0, 12) + '…（対象が変わると無効）');
      row('実行すると', 'キューに登録されます。ここではまだ 1 通も送られません。');
    }

    function mkRenderConfirm(campaign, plan) {
      const body = mkOpenModal('送信内容の確認');

      const head = document.createElement('div'); head.className = 'dt-sec';
      const h = document.createElement('h3');
      h.textContent = (campaign.testOnly ? '🧪 ' : '') + campaign.name + ' v' + campaign.version;
      head.appendChild(h);
      if (campaign.testOnly) {
        const t = document.createElement('p'); t.className = 'testonly';
        t.textContent = '🧪 運用テスト専用。テスト受信者以外は自動的に除外されます。';
        head.appendChild(t);
      }
      const dl = document.createElement('dl'); dl.className = 'kv';
      // 配信台帳の CampaignType と同じ表記。名前が似たキャンペーンの取り違えを防ぐ
      kvRow(dl, 'キャンペーンID', campaign.campaignId + ':v' + campaign.version);
      kvRow(dl, '件名', plan.subject);
      // 割引案内は「何をいくらで案内するか」を最終確認に出す（金額の取り違え防止）
      const os = plan.offerSummary;
      if (os) {
        kvRow(dl, 'オファー種別', os.offerId);
        kvRow(dl, '通常価格', '¥' + Number(os.regularPrice || 0).toLocaleString());
        kvRow(dl, 'オファー価格',
          '¥' + Number(os.offerPrice || 0).toLocaleString() + '（' + os.discountPercent + '%OFF）', 'strong-ok');
        kvRow(dl, '有効期限（最短）',
          os.earliestExpiresAt ? String(os.earliestExpiresAt).slice(0, 10) : '（有効なオファーなし）');
        kvRow(dl, 'CTA', (os.ctaLabel || '') + ' → ' + os.ctaKind);
        kvRow(dl, '発行済みオファー', os.liveOffers + ' 件（有効・期限内）');
      }
      kvRow(dl, '選択', plan.selected + ' 名');
      kvRow(dl, '除外', plan.excluded + ' 名');
      kvRow(dl, '実送信', plan.willSend + ' 名', plan.willSend > 0 ? 'strong-ok' : 'muted');
      // 反応なし除外は「何人落ちたか」と「そもそも適用しているか」を必ず並べる。
      // 適用していないのに 0 名と出すと「反応が無い人は居ない」と読み違える。
      if (plan.engagement) {
        const eg = plan.engagement;
        kvRow(dl, 'うち 反応なしで除外',
          eg.applied ? (Number(eg.blockedThisPlan || 0) + ' 名')
            : '適用していません（' + (eg.reasonLabel || eg.reason || '理由不明') + '）',
          eg.applied ? '' : 'muted');
        if (eg.applied && eg.coverage && eg.coverage.since) {
          kvRow(dl, '反応を数えた期間', String(eg.coverage.since).slice(0, 10) + ' 以降の配信');
        }
      }
      // 何を送るのかを hash まで出す（キュー登録後はこの内容で固定される）
      kvRow(dl, '内容 hash', String(plan.contentHash || '').slice(0, 12)
        + (plan.contentEdited ? '（今回だけ編集）' : '（既定文面）'));
      head.appendChild(dl);
      body.appendChild(head);

      // 送る本文そのもの。**確認した文面**を完成形で出す（編集途中の値は使わない）
      const secBody = document.createElement('div'); secBody.className = 'dt-sec';
      const hb = document.createElement('h3'); hb.textContent = '送信する本文'; secBody.appendChild(hb);
      if (plan.preview) {
        const kv2 = document.createElement('dl'); kv2.className = 'kv';
        kvRow(kv2, 'From', plan.preview.from);
        kvRow(kv2, '宛名', plan.preview.salutation);
        kvRow(kv2, 'CTA', (plan.preview.ctaLabel || '（なし）') + ' → ' + plan.preview.ctaKind);
        kvRow(kv2, 'フッター', plan.preview.footer);
        kvRow(kv2, '配信停止', plan.preview.unsubscribeNote);
        secBody.appendChild(kv2);
        const frame = document.createElement('iframe');
        frame.className = 'prev-frame';
        frame.setAttribute('sandbox', '');
        frame.srcdoc = '<body style="margin:0;background:#fff;">' + plan.preview.html + '</body>';
        secBody.appendChild(frame);
      } else {
        const pre = document.createElement('pre'); pre.className = 'prev-text';
        pre.textContent = String(plan.body || '');
        secBody.appendChild(pre);
      }
      body.appendChild(secBody);

      if (plan.excludedDetail && plan.excludedDetail.length) {
        const sec = document.createElement('div'); sec.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '除外の内訳'; sec.appendChild(h2);

        // 理由をグループへ束ねて出す（何がどれだけ落ちたかを分類で把握できるように）
        const GROUPS = [
          ['キャンペーン条件外', ['contract_mismatch', 'plan_mismatch', 'campaign_mismatch']],
          ['割引オファー未発行・不一致', ['offer_missing', 'offer_ambiguous', 'offer_mismatch', 'offer_secret_unavailable']],
          ['配信停止・除外リスト', ['unsubscribed', 'blacklist', 'soft_bounce', 'withdrawn', 'suspended', 'test_account', 'no_email', 'invalid_email']],
          ['最近マーケティング送信済み', ['recent_marketing_contact']],
          ['配信基盤の配信停止', ['provider_suppressed']],
          ['その他', ['already_delivered', 'duplicate', 'unknown_customer']],
        ];
        const byReason = {};
        for (const e of plan.excludedDetail) byReason[e.reason] = e;

        const ul = document.createElement('ul'); ul.className = 'exlist';
        let shown = 0;
        for (const g of GROUPS) {
          const label = g[0], reasons = g[1];
          const items = reasons.map((r) => byReason[r]).filter(Boolean);
          if (items.length === 0) continue;
          const total = items.reduce((s, e) => s + e.count, 0);
          shown += total;
          const li = document.createElement('li');
          const strong = document.createElement('strong');
          strong.textContent = label + '　' + total + ' 名';
          li.appendChild(strong);
          const sub = document.createElement('ul'); sub.className = 'exlist sub';
          for (const e of items) {
            const li2 = document.createElement('li');
            li2.textContent = e.label + '　' + e.count + ' 名';
            sub.appendChild(li2);
          }
          li.appendChild(sub);
          ul.appendChild(li);
        }
        // 分類に載らない理由が出ても件数を落とさない
        if (shown < plan.excluded) {
          const li = document.createElement('li');
          li.textContent = '未分類　' + (plan.excluded - shown) + ' 名';
          ul.appendChild(li);
        }
        sec.appendChild(ul);
        body.appendChild(sec);
      }

      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const h3 = document.createElement('h3'); h3.textContent = '送信'; sec3.appendChild(h3);
      const state = document.createElement('p'); state.className = 'note';
      state.textContent = plan.sendEnabled
        ? (plan.dispatchEnabled
          ? 'キャンペーン配信は有効です。実行すると実際にメールが配信されます。'
          : '実行するとキューに登録されますが、キャンペーン配信が無効なため実送信はされません。')
        : '送信は無効（MARKETING_CAMPAIGN_ENABLED 未設定）です。実行できません。';
      sec3.appendChild(state);

      // provider 側の配信停止をどれだけ確認できたかを明示する（確認できていないなら送らせない）
      const ps = plan.providerSuppression;
      if (ps) {
        const psNote = document.createElement('p');
        psNote.className = ps.available ? 'note' : 'blocker';
        psNote.textContent = ps.available
          ? `配信基盤の配信停止リスト ${ps.total} 件と照合済み`
          : `⚠️ 配信基盤の配信停止リストを確認できませんでした（${ps.error}）。この状態では送信できません。`;
        sec3.appendChild(psNote);
      }

      // 「表示されている件名・本文を、この対象者へ送信します」への同意（チェックまで送れない）
      const ack = document.createElement('label'); ack.className = 'chk chk-danger';
      const ackBox = document.createElement('input');
      ackBox.type = 'checkbox'; ackBox.id = 'mkSendAck';
      const ackText = document.createElement('span');
      ackText.textContent = '表示されている件名・本文を、この対象者へ送信します';
      ack.appendChild(ackBox); ack.appendChild(ackText);
      sec3.appendChild(ack);
      const irreversible = document.createElement('p');
      irreversible.className = 'blocker';
      irreversible.textContent = '⚠️ このボタンでキュー登録と送信まで完了します。'
        + '送信後は取り消せません。実際の顧客へメールが届きます。';
      sec3.appendChild(irreversible);

      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-immediate';
      btn.textContent = plan.willSend + ' 名へ送信する';
      const syncAck = () => {
        mkContent.acknowledged = ackBox.checked;
        btn.disabled = !plan.sendEnabled || plan.willSend === 0 || !ackBox.checked;
        btn.title = ackBox.checked ? '' : draftApi().CONTENT_BLOCK_LABEL[draftApi().CONTENT_BLOCK.NOT_ACKNOWLEDGED];
      };
      ackBox.addEventListener('change', syncAck);
      btn.disabled = true;
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;      // 二重クリック防止
        // 押す瞬間にもう一度、文面が確認済みのものと同じか見る
        const guard = draftApi().canSendContent({
          campaign, draftValid: mkContent.valid, draft: mkDraft(),
          confirmed: mkContent.confirmed, acknowledged: ackBox.checked, requireAck: true,
        });
        if (!guard.allowed) {
          mkNotify('err', '送信できません', draftApi().CONTENT_BLOCK_LABEL[guard.reason] || '');
          return;
        }
        const ok = window.confirm(
          campaign.name + ' v' + campaign.version + '\n'
          + '件名: ' + String(plan.subject || '') + '\n'
          + '内容 hash: ' + String(plan.contentHash || '').slice(0, 12) + '\n\n'
          + '送信対象: ' + plan.selected + ' 名\n'
          + '除外: ' + plan.excluded + ' 名\n'
          + '実送信: ' + plan.willSend + ' 名\n\n'
          + 'このままキュー登録して送信まで実行します。送信後は取り消せません。\n'
          + '実行しますか？'
        );
        if (!ok) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        btn.textContent = 'キュー登録中…';
        const out = await mkCall({
          action: 'send',
          campaignId: campaign.campaignId,
          ...mkTargetPayload(),
          planFingerprint: plan.planFingerprint,   // 対象が変わっていたら Function 側が中止する
          // 確認した文面そのもの。hash が合わなければ Function 側が 409 で止める
          subject: mkContent.confirmed ? mkContent.confirmed.subject : undefined,
          body: mkContent.confirmed ? mkContent.confirmed.body : undefined,
          contentHash: mkContent.confirmed ? mkContent.confirmed.contentHash : undefined,
          // 確認したときの「組み立て方」の版。deploy でシェルが変わっていたら
          // Function 側が 409 で止める（確認した内容と違うメールを送らない）
          shellVersion: plan.shellVersion,
        });
        btn.dataset.busy = '';
        if (out) {
          mkState.enqueued = true;
          mkState.dispatch = {};
          // 引き継ぎは**使い切り**。同じ成功者へもう一度送るには付与結果から取り直す
          if (mkState.handoff) {
            handoffApi().markHandoffQueued(sessionStorage, (out.jobs || []).map((j) => j.jobId));
            mkHandoffRelease(true);
          }

          // ── ここで**続けて送信まで行う** ────────────────────────────
          // 「◯名へ送信する」を押したら、キュー登録で止めない。
          // 以前はここで終わっており、運用者は送ったつもりなのにジョブが
          // PENDING のまま残っていた（2026-08-04 の 36 名ジョブ）。
          btn.textContent = '送信中…';
          const result = await mkSendQueuedJobs(out.jobs || []);
          btn.dataset.busy = '';

          mkSelected.clear();
          mkCloseModal();
          mkSyncFlow();
          await mkLoad();
          mkRenderSendOutcome(result, out);
        } else {
          btn.textContent = '再試行';
          btn.disabled = false;
        }
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    }

    // ── 送信状況（予定 / 送信済 / 失敗 / 取消）と取消操作 ──
    // 「いま何が送信待ちか」「どれが失敗したか」「取り消せるのか」を 1 画面で出す。
    // 送信は取り返しがつかないので、**止められる状態**を運用者に持たせる。
    const JOB_STATUS_LABEL = {
      PENDING: '送信待ち', SENT: '送信済み', FAILED: '失敗', CANCELLED: '取消済み',
    };
    const CANCEL_REASON_LABEL = {
      already_sent: '送信済みのため取消不可（メールは取り消せません）',
      already_failed: '送信を試行済みのため取消不可',
      already_cancelled: '取消済み',
      not_marketing_job: 'マーケティングジョブではない',
      job_not_found: 'ジョブが見つからない',
      unknown_status: '状態を判定できない',
    };

    const jobSendApi = () => window.__mkJobSend;

    /**
     * 送信待ちジョブ 1 件の「配信内容を確認 → 今すぐ送信」パネル。
     *
     * ── 押せる順 ────────────────────────────────────────────────
     *   配信内容を確認（dispatcher dryRun:true / 書き込みなし）
     *     → 送信予定人数・除外理由・版・内容 hash を表示
     *     → 「今すぐ送信」が押せるようになる
     *     → 人数を入力して確定 → 直前にもう一度確認を取り直して照合
     *     → 該当 jobId だけを 1 回だけ送る
     *
     * 二重クリック・再読込・通信 retry では二重送信しない
     * （画面の busy ガード + API 側の job 単位の冪等性）。
     */
    function mkBuildJobSendPanel(job, jobsData) {
      const api = jobSendApi();
      const wrap = document.createElement('div');
      wrap.className = 'job-send';

      const state = { busy: false, preflight: null, sent: false };
      const checkBtn = document.createElement('button');
      const sendBtn = document.createElement('button');
      const result = document.createElement('div');
      // 行の見た目は Step 4 の確認パネルと同じ部品を使う（新しい見た目を増やさない）
      result.className = 'job-send-result dry-panel';
      result.hidden = true;
      const msg = document.createElement('p');
      msg.className = 'note';
      msg.setAttribute('aria-live', 'polite');

      const sync = () => {
        const verdict = api.canSendJob({
          busy: state.busy, dispatchEnabled: !!jobsData.dispatchEnabled,
          status: job.status, preflight: state.preflight, sent: state.sent,
        });
        sendBtn.disabled = !verdict.allowed;
        sendBtn.setAttribute('aria-disabled', String(!verdict.allowed));
        sendBtn.title = verdict.allowed ? '' : (verdict.label || '');
        checkBtn.disabled = state.busy || state.sent;
      };

      // ── ① 配信内容を確認（書き込みなし）──
      checkBtn.type = 'button';
      checkBtn.className = 'btn-success btn-md';
      checkBtn.textContent = '✅ 配信内容を確認';
      checkBtn.setAttribute('aria-label', 'このジョブの配信内容を確認する（送信はしません）');
      checkBtn.addEventListener('click', async () => {
        if (state.busy) return;
        state.busy = true; sync();
        msg.textContent = '確認中…（送信も書き込みもしていません）';
        try {
          const out = await mkDispatchCall(true, job.jobId);
          const pf = api.buildJobPreflight(out, job.jobId);
          state.preflight = pf;
          mkRenderJobPreflight(result, pf, job);
          msg.textContent = pf.ok
            ? 'この内容で送信できます。人数を確認して「今すぐ送信」を押してください。'
            : (api.JOB_SEND_BLOCK_LABEL[pf.reason] || '送信できません。');
        } catch (e) {
          state.preflight = null;
          result.innerHTML = '';
          msg.textContent = '確認できませんでした。管理シークレットとネットワークを確認してください。';
        } finally {
          state.busy = false; sync();
        }
      });

      // ── ② 今すぐ送信（このジョブだけ・1 回だけ）──
      sendBtn.type = 'button';
      sendBtn.className = 'b-immediate';
      sendBtn.textContent = '📩 このジョブを今すぐ送信';
      sendBtn.disabled = true;
      sendBtn.setAttribute('aria-disabled', 'true');
      sendBtn.addEventListener('click', async () => {
        if (state.busy || sendBtn.dataset.busy === '1') return;   // 二重クリック防止
        const verdict = api.canSendJob({
          busy: state.busy, dispatchEnabled: !!jobsData.dispatchEnabled,
          status: job.status, preflight: state.preflight, sent: state.sent,
        });
        if (!verdict.allowed) { mkNotify('warn', '送信できません', verdict.label || ''); return; }

        const operationId = 'jobsend-' + job.jobId + '-' + Date.now().toString(36);
        const conf = api.buildJobSendConfirmation({ preflight: state.preflight, operationId });
        const ok = window.confirm(
          '【このジョブを送信】' + conf.effect + '\n\n'
          + 'キャンペーン: ' + conf.campaign + '\n'
          + 'job: ' + conf.jobId + '\n'
          + '内容 hash: ' + conf.contentHash + ' / 組み立て版 v' + conf.shellVersion + '\n'
          + '送信予定: ' + conf.willSend + ' 名（除外 ' + conf.willSkip + ' 名）\n\n'
          + conf.reverify + '\n' + conf.failClosed + '\n' + conf.afterSend + '\n\n続けますか？'
        );
        if (!ok) return;
        const typed = window.prompt('確認のため、送信予定人数「' + conf.willSend + '」を入力してください') || '';

        sendBtn.dataset.busy = '1';
        state.busy = true; sync();
        sendBtn.textContent = '送信中…';
        msg.textContent = '送信直前の再確認中…';
        try {
          // ③ 直前にもう一度確認を取り、同じジョブ・同じ内容であることを確かめる
          const latest = await mkDispatchCall(true, job.jobId);
          const pre = api.verifyJobSendPrecondition({
            preflight: state.preflight, latest, typedCount: typed,
          });
          if (!pre.ok) {
            msg.textContent = api.JOB_SEND_BLOCK_LABEL[pre.reason] || '送信を中止しました。';
            mkNotify('warn', '送信を中止しました', api.JOB_SEND_BLOCK_LABEL[pre.reason] || '');
            sendBtn.textContent = '📩 このジョブを今すぐ送信';
            return;
          }
          // ④ 実送信。対象は jobId で固定し、確認した人数を API 側でも照合させる
          msg.textContent = pre.willSend + ' 通を送信中…';
          const out = await mkDispatchCall(false, job.jobId, pre.willSend);
          if (!out) {
            msg.textContent = '送信に失敗しました。送信状況を再読み込みして、実際に送られたかを必ず確認してください。';
            sendBtn.textContent = '📩 このジョブを今すぐ送信';
            return;
          }
          state.sent = true;
          state.preflight = null;
          const res = api.summarizeJobSendResult(out, job.jobId);
          mkRenderJobSendResult(result, res);
          sendBtn.textContent = '送信済み（このカードからは再送できません）';
          msg.textContent = res.note;
          mkNotify(res.outcome === 'SENT' ? 'ok' : 'warn', res.label,
            '送信 ' + res.sent + ' / 失敗 ' + res.failed + ' / 除外 ' + res.skipped);
        } catch (e) {
          msg.textContent = '配信基盤へ到達できませんでした。送信状況を再読み込みして実際に送られたかを確認してください（自動では再送しません）。';
        } finally {
          sendBtn.dataset.busy = '';
          state.busy = false; sync();
        }
      });

      const bar = document.createElement('div');
      bar.className = 'job-send-ops';
      bar.appendChild(checkBtn);
      bar.appendChild(sendBtn);
      wrap.appendChild(bar);
      wrap.appendChild(result);
      wrap.appendChild(msg);
      if (!jobsData.dispatchEnabled) {
        const g = document.createElement('p'); g.className = 'note';
        g.textContent = api.JOB_SEND_BLOCK_LABEL[api.JOB_SEND_BLOCK.GATE_CLOSED];
        wrap.appendChild(g);
      }
      sync();
      return wrap;
    }

    /** 確認結果（このジョブの内訳だけ。アドレスは出さない） */
    function mkRenderJobPreflight(box, pf, job) {
      box.innerHTML = '';
      box.hidden = false;
      const api = jobSendApi();
      const row = (k, v, cls) => {
        const d = document.createElement('div'); d.className = 'dp-row ' + (cls || '');
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = String(v);
        d.appendChild(a); d.appendChild(b); box.appendChild(d);
      };
      if (!pf.ok) {
        row('確認結果', api.JOB_SEND_BLOCK_LABEL[pf.reason] || '送信できません', 'is-ng');
        if (pf.blocked) row('理由', pf.note || pf.blocked, 'is-ng');
        if (pf.jobShellVersion !== undefined && pf.jobShellVersion !== null) {
          row('ジョブの組み立て版', 'v' + pf.jobShellVersion + '（現在 v' + pf.expectedShellVersion + '）', 'is-ng');
        }
        return;
      }
      row('キャンペーン', pf.campaignId + (pf.version ? ' v' + pf.version : ''));
      row('内容 hash', pf.contentHash || '（記録なし）');
      row('組み立て版', pf.shellVersion === null ? '（印なし）' : 'v' + pf.shellVersion);
      row('キュー登録', pf.queued + ' 名');
      row('実送信予定', pf.willSend + ' 名', pf.willSend > 0 ? 'is-ok' : 'is-ng');
      row('除外', pf.willSkip + ' 名');
      const reasons = Object.entries(pf.skipByReason || {});
      if (reasons.length) {
        row('除外理由', reasons.map(([k, v]) => k + ' ' + v + ' 名').join(' / '));
      }
      const sup = pf.providerSuppression || {};
      row('配信停止リストの照合', sup.available ? 'OK（' + (sup.total || 0) + ' 件）' : '確認できず（送信しません）',
        sup.available ? '' : 'is-ng');
    }

    /** 送信結果（部分失敗を成功と読ませない） */
    function mkRenderJobSendResult(box, res) {
      box.innerHTML = '';
      box.hidden = false;
      const row = (k, v, cls) => {
        const d = document.createElement('div'); d.className = 'dp-row ' + (cls || '');
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = String(v);
        d.appendChild(a); d.appendChild(b); box.appendChild(d);
      };
      row('結果', res.label, res.outcome === 'SENT' ? 'is-ok' : 'is-ng');
      row('送信', res.sent + ' 通', res.sent > 0 ? 'is-ok' : '');
      row('失敗', res.failed + ' 通', res.failed > 0 ? 'is-ng' : '');
      row('除外', res.skipped + ' 通');
      const reasons = Object.entries(res.skipByReason || {});
      if (reasons.length) row('除外理由', reasons.map(([k, v]) => k + ' ' + v + ' 名').join(' / '));
    }

    async function mkRenderJobs() {
      const data = await mkCall({ action: 'jobs' });
      if (!data) return;
      const body = mkOpenModal('キャンペーン送信状況');

      // gate 状態は最初に出す。閉じているなら「なぜ送られないか」を明示する
      const gate = document.createElement('div'); gate.className = 'dt-sec';
      const gh = document.createElement('h3'); gh.textContent = '① 送信ゲート'; gate.appendChild(gh);
      dossierRow(gate, 'キュー登録', data.sendEnabled ? '有効' : '無効（MARKETING_CAMPAIGN_ENABLED 未設定）',
        data.sendEnabled ? 'ok' : 'ng');
      dossierRow(gate, '実送信', data.dispatchEnabled ? '有効' : '無効（MARKETING_CAMPAIGN_DISPATCH_ENABLED 未設定）',
        data.dispatchEnabled ? 'ok' : 'ng');
      const gn = document.createElement('p'); gn.className = 'tl-note'; gn.textContent = '⚠️ ' + data.notice;
      gate.appendChild(gn);
      const auto = document.createElement('p'); auto.className = 'tl-note';
      auto.textContent = '⚠️ ゲートが有効でも、この画面から実行しない限り自動送信はされません（定期実行に載っていません）。';
      gate.appendChild(auto);
      body.appendChild(gate);

      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const h = document.createElement('h3'); h.textContent = '② ジョブ一覧（新しい順）'; sec.appendChild(h);
      if (!data.jobs.length) {
        const p = document.createElement('p'); p.className = 'tl-note'; p.textContent = 'キャンペーンジョブはまだありません。';
        sec.appendChild(p);
      }
      for (const j of data.jobs) {
        // 顧客カルテの時系列（.tl-row）は 4 カラムのグリッド。ここで流用すると
        // 「取り消す」ボタンの列が幅を奪い、件数の列が 0 幅近くまで潰れて
        // **1 文字ずつ縦に折り返す**（2026-08-03 本番で発生）。専用クラスで縦に積む。
        const box = document.createElement('div'); box.className = 'job-row';
        const head = document.createElement('div'); head.className = 'job-head';
        const badge = flowApi().resolveJobBadge({ status: j.status, counts: j.counts });
        const b = document.createElement('span');
        b.className = 'badge b-' + badge.tone;
        b.textContent = badge.label;
        head.appendChild(b);
        const ttl = document.createElement('b');
        ttl.textContent = ' ' + (j.campaignId || '(不明)') + (j.version ? ' v' + j.version : '');
        head.appendChild(ttl);
        const when = document.createElement('span'); when.className = 'tl-src';
        when.textContent = ' 作成 ' + (j.scheduledFor ? fmtDate(j.scheduledFor) : '—')
          + (j.completedAt ? ' / 送信 ' + fmtDate(j.completedAt) : '')
          + ' / 実行者 ' + (j.createdBy || 'admin-marketing')
          + ' / job ' + String(j.jobId || '').slice(-12);
        head.appendChild(when);
        box.appendChild(head);

        // 実際に送った（送る）件名と内容 hash。**後から編集できない記録**
        const subj = document.createElement('div'); subj.className = 'tl-detail';
        subj.textContent = '件名: ' + (j.subject || '（記録なし）')
          + (j.contentHash ? '　内容 hash: ' + j.contentHash + (j.contentEdited ? '（今回だけ編集）' : '') : '');
        box.appendChild(subj);

        const c = j.counts || {};
        // 1 つの長い文字列にすると、列が狭いときに文字単位で折り返して縦組みになる。
        // 項目ごとの要素に分け、**折り返しは項目の境目でだけ**起きるようにする。
        const counts = document.createElement('div'); counts.className = 'job-counts';
        for (const [label, value, tone] of [
          ['対象', j.recipientCount + ' 名', ''],
          ['送信待ち', c.queued || 0, (c.queued || 0) > 0 ? 'is-wait' : ''],
          ['送信済', c.sent || 0, (c.sent || 0) > 0 ? 'is-ok' : ''],
          ['失敗', c.failed || 0, (c.failed || 0) > 0 ? 'is-ng' : ''],
          ['スキップ', c.skipped || 0, ''],
          ['取消', c.cancelled || 0, ''],
        ]) {
          const item = document.createElement('span');
          item.className = 'job-count' + (tone ? ' ' + tone : '');
          const k = document.createElement('span'); k.className = 'jc-k'; k.textContent = label;
          const v = document.createElement('b'); v.className = 'jc-v'; v.textContent = String(value);
          item.appendChild(k); item.appendChild(v);
          counts.appendChild(item);
        }
        box.appendChild(counts);

        // 失敗・スキップの理由は分類として出す（アドレスは出さない）
        const reasons = Object.entries(j.errorReasons || {});
        if (reasons.length) {
          const rl = document.createElement('div'); rl.className = 'tl-detail';
          rl.textContent = '理由: ' + reasons.map(([k, v]) => k + ' ' + v + ' 件').join(' / ');
          box.appendChild(rl);
        }

        const ops = document.createElement('div'); ops.className = 'ops';
        if (j.cancelable) {
          const btn = document.createElement('button');
          btn.type = 'button'; btn.className = 'b-immediate'; btn.textContent = '送信予定を取り消す';
          btn.addEventListener('click', async () => {
            if (btn.dataset.busy === '1') return;
            // 二段階確認: 取消も取り返しの効く操作ではないため、内容を読ませてから実行する
            const ok1 = window.confirm(
              '送信予定を取り消します。\n\n'
              + 'キャンペーン: ' + (j.campaignId || '') + (j.version ? ' v' + j.version : '') + '\n'
              + '送信待ち: ' + (c.queued || 0) + ' 件\n'
              + '送信済み: ' + (c.sent || 0) + ' 件（**取り消しません**）\n\n'
              + '続けますか？'
            );
            if (!ok1) return;
            const typed = window.prompt('確認のため CANCEL と入力してください');
            if (String(typed || '').trim().toUpperCase() !== 'CANCEL') { mkMsg('取消を中止しました。', 'ng'); return; }
            btn.dataset.busy = '1'; btn.disabled = true; btn.textContent = '取消中…';
            // 同じ取消を 2 回押しても 2 重に書かないための操作 ID
            const operationId = 'cancel-' + j.jobId + '-' + Date.now().toString(36);
            const out = await mkCall({ action: 'cancelJob', jobId: j.jobId, operationId });
            btn.dataset.busy = '';
            if (out && out.cancelled) {
              mkMsg(out.notice || '取り消しました', 'ok');
              mkCloseModal();
              await mkRenderJobs();
            } else {
              btn.textContent = '再試行';
              btn.disabled = false;
            }
          });
          ops.appendChild(btn);
        } else {
          const p = document.createElement('span'); p.className = 'tl-src';
          p.textContent = CANCEL_REASON_LABEL[j.cancelReason] || '取消不可';
          ops.appendChild(p);
        }
        box.appendChild(ops);

        // ── 送信待ちジョブは、このカードから確認 → 送信できる ─────────────
        // 対象は**このカードの jobId だけ**。画面の顧客選択・絞り込み・
        // キャンペーン選択には一切依存しない（別の日・別の人でも引き継げる）。
        if (String(j.status || '').toUpperCase() === jobSendApi().SENDABLE_STATUS) {
          box.appendChild(mkBuildJobSendPanel(j, data));
        }

        sec.appendChild(box);
      }
      const note = document.createElement('p'); note.className = 'tl-note';
      note.textContent = '⚠️ ' + data.cancelNote + ' 「送信済み」は配信基盤が受理した状態で、実際に届いたか（delivered）とは別です。';
      sec.appendChild(note);
      body.appendChild(sec);
    }

    $('mkJobsBtn').addEventListener('click', mkRenderJobs);

    // ── 送信履歴 ──
    $('mkHistoryBtn').addEventListener('click', async () => {
      const data = await mkCall({ action: 'history' });
      if (!data) return;
      const body = mkOpenModal('キャンペーン送信履歴');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      if (!data.runs.length) {
        sec.textContent = '送信履歴はまだありません。';
      } else {
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const r of data.runs) {
          const li = document.createElement('li');
          li.textContent = r.campaignType + '　登録 ' + r.queued + ' / 処理済 ' + r.sent
            + ' / 失敗 ' + r.failed + ' / スキップ ' + r.skipped + '　' + fmtDate(r.lastAt);
          ul.appendChild(li);
        }
        sec.appendChild(ul);
      }
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec.appendChild(note);
      body.appendChild(sec);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$('mkBackdrop').hidden) mkCloseModal();
    });

    // ══════════════════════════════════════════════════════════════
    //  カムバック特典（無料 entitlement の付与）
    //  ⚠️ メール送信とは別機能。ここから 1 通もメールを送らない。
    //  ⚠️ 変更するのは特典専用フィールドのみ。課金・契約・Plus 販売資格は触らない。
    // ══════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════
    //  複数選択フィルター（チェック式）
    //  「すべて」か 1 項目しか選べないと、実際に使う条件（期限切れ＋退会済み＋休眠 /
    //  Premium＋Light）が作れない。既存の <select> をチェック式へ置き換える。
    //  判定は adminMultiFilter.js（純粋）が単一源。
    // ══════════════════════════════════════════════════════════════
    const filterApi = () => window.__mkFilter;
    /** 表示名・説明の単一源 */
    const defsApi = () => window.__filterDefs;
    /** id → { values, labels, selected, button, panel } */
    const multiFilters = new Map();

    // ══════════════════════════════════════════════════════════════
    //  説明ポップオーバー（hover だけに頼らない）
    //  スマホ・タブレットでも読めるよう、**タップで開く**。同時に 1 つだけ。
    // ══════════════════════════════════════════════════════════════
    let infoOpener = null;
    function infoBox() {
      let el = document.getElementById('infoPop');
      if (el) return el;
      el = document.createElement('div');
      el.id = 'infoPop';
      el.className = 'info-pop';
      el.setAttribute('role', 'dialog');
      el.hidden = true;
      el.innerHTML = '<div class="info-head"><b class="info-title"></b>'
        + '<button type="button" class="info-close" aria-label="説明を閉じる">×</button></div>'
        + '<p class="info-body"></p>';
      el.querySelector('.info-close').addEventListener('click', closeInfo);
      // 名前空間 .ppe の中へ入れる（CSS をグローバルへ漏らさない）
      (document.querySelector('.ppe') || document.body).appendChild(el);
      return el;
    }

    function closeInfo() {
      const el = document.getElementById('infoPop');
      if (el) el.hidden = true;
      if (infoOpener) {
        infoOpener.setAttribute('aria-expanded', 'false');
        infoOpener = null;
      }
    }

    /** 説明を開く（画面外へはみ出さない位置に置く） */
    function openInfo(anchor, title, text) {
      const el = infoBox();
      // 同じボタンをもう一度押したら閉じる
      if (!el.hidden && infoOpener === anchor) { closeInfo(); return; }
      closeInfo();
      el.querySelector('.info-title').textContent = title;
      el.querySelector('.info-body').textContent = text;
      el.hidden = false;
      el.classList.toggle('is-sheet', window.innerWidth <= 900);
      if (window.innerWidth > 900) {
        const r = anchor.getBoundingClientRect();
        const w = el.offsetWidth;
        // 右端・下端からはみ出さないように寄せる
        const left = Math.max(8, Math.min(r.left, window.innerWidth - w - 8));
        const top = r.bottom + 8 + el.offsetHeight > window.innerHeight
          ? Math.max(8, r.top - el.offsetHeight - 8) : r.bottom + 8;
        el.style.left = left + 'px';
        el.style.top = top + 'px';
      } else {
        el.style.left = ''; el.style.top = '';
      }
      anchor.setAttribute('aria-expanded', 'true');
      el.setAttribute('aria-label', title);
      infoOpener = anchor;
    }

    document.addEventListener('click', (e) => {
      const el = document.getElementById('infoPop');
      if (!el || el.hidden) return;
      if (el.contains(e.target) || (infoOpener && infoOpener.contains(e.target))) return;
      closeInfo();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeInfo(); });

    /**
     * 既存の <select> を複数選択メニューへ変換する。
     * - 元の select は残さず、同じ id を持つ非表示 input で値を引き継ぐ（既存コードの互換）
     * - 「すべて」に相当する選択肢は**チェック項目にしない**（0 件＝条件なし）
     */
    function makeMultiFilter(selectId, opts = {}) {
      const sel = document.getElementById(selectId);
      if (!sel || sel.dataset.multi === '1') return null;
      const label = opts.label || sel.getAttribute('aria-label') || selectId;
      const defs = defsApi();
      const items = [...sel.querySelectorAll('option')]
        .map((o) => ({ value: o.value, label: o.textContent.trim().replace(/^[^:]+:\s*/, '') }))
        .filter((o) => o.value && o.value !== 'all' && o.value !== 'candidates')
        // 表示名は単一源（filterDefinitions）を優先する。無ければ option の文言のまま
        .map((o) => ({ ...o, label: (defs && defs.optionLabel(selectId, o.value)) || o.label }));

      const wrap = document.createElement('div');
      wrap.className = 'mfilter';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'mfilter-btn btn-secondary btn-md';
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-controls', selectId + 'Panel');
      btn.textContent = label + ': 指定なし';

      const panel = document.createElement('div');
      panel.className = 'mfilter-panel';
      panel.id = selectId + 'Panel';
      panel.hidden = true;
      panel.setAttribute('role', 'group');
      panel.setAttribute('aria-label', label);

      const list = document.createElement('div'); list.className = 'mfilter-list';
      for (const it of items) {
        const row = document.createElement('label');
        row.className = 'mfilter-row';
        const cb = document.createElement('input');
        cb.type = 'checkbox'; cb.value = it.value;
        const txt = document.createElement('span'); txt.textContent = it.label;
        row.appendChild(cb); row.appendChild(txt);
        // 選択肢の説明（ⓘ）。**押してもチェックは変わらない**
        const od = defsApi() && defsApi().getOptionDefinition(selectId, it.value);
        if (od && od.description) {
          const info = document.createElement('button');
          info.type = 'button'; info.className = 'info-btn';
          info.textContent = 'ⓘ';
          info.setAttribute('aria-label', it.label + ' の説明');
          info.setAttribute('aria-expanded', 'false');
          info.addEventListener('click', (e) => {
            e.preventDefault(); e.stopPropagation();   // チェックを切り替えない
            openInfo(info, it.label, od.description);
          });
          row.appendChild(info);
        }
        cb.addEventListener('change', () => {
          row.classList.toggle('is-on', cb.checked);
          syncState(false);
        });
        list.appendChild(row);
      }
      panel.appendChild(list);

      const ops = document.createElement('div'); ops.className = 'mfilter-ops';
      const mkOp = (text, fn, cls) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = (cls || 'btn-ghost') + ' btn-sm'; b.textContent = text;
        b.addEventListener('click', fn);
        ops.appendChild(b);
        return b;
      };
      mkOp('すべて選択', () => setValues(items.map((i) => i.value)));
      mkOp('全解除', () => setValues([]));
      mkOp('適用', () => { close(); if (opts.onApply) opts.onApply(); }, 'btn-primary');
      panel.appendChild(ops);

      wrap.appendChild(btn);
      // 項目そのものの説明（フィルター名の右のⓘ）
      const fd = defsApi() && defsApi().getFilterDefinition(selectId);
      // 分類（現在状態 / 履歴 / 追加条件 / 操作可否）を短く添える。
      // 種類の違う条件が同じ見た目で並ぶのを防ぐ
      const catText = defsApi() ? defsApi().categoryLabel(selectId) : '';
      if (catText) {
        const cat = document.createElement('span');
        cat.className = 'mfilter-cat cat-' + (fd && fd.category ? fd.category : 'state');
        cat.textContent = catText;
        wrap.insertBefore(cat, btn);
      }
      if (fd && fd.description) {
        const info = document.createElement('button');
        info.type = 'button'; info.className = 'info-btn info-btn-head';
        info.textContent = 'ⓘ';
        info.setAttribute('aria-label', fd.label + ' の説明');
        info.setAttribute('aria-expanded', 'false');
        info.addEventListener('click', (e) => {
          e.preventDefault(); e.stopPropagation();
          openInfo(info, fd.label, fd.description);
        });
        wrap.appendChild(info);
      }
      wrap.appendChild(panel);
      sel.replaceWith(wrap);

      // 既存コードが値を読めるように、同じ id の hidden input を置く
      const hidden = document.createElement('input');
      hidden.type = 'hidden'; hidden.id = selectId; hidden.value = '';
      hidden.dataset.multi = '1';
      wrap.appendChild(hidden);

      const state = { id: selectId, label, items, selected: [], button: btn, panel, hidden };
      multiFilters.set(selectId, state);

      function setValues(values) {
        const set = new Set(values);
        for (const cb of list.querySelectorAll('input[type=checkbox]')) {
          cb.checked = set.has(cb.value);
          cb.closest('.mfilter-row').classList.toggle('is-on', cb.checked);
        }
        syncState(false);
      }
      function syncState(silent) {
        state.selected = [...list.querySelectorAll('input[type=checkbox]')]
          .filter((c) => c.checked).map((c) => c.value);
        hidden.value = state.selected.join(',');
        const only = state.selected.length === 1
          ? (items.find((i) => i.value === state.selected[0]) || null) : null;
        btn.textContent = label + ': ' + (only ? only.label
          : filterApi().summarizeSelection(state.selected, items.map((i) => i.value), '全' + label));
        btn.classList.toggle('is-on', state.selected.length > 0);
        if (!silent && opts.onChange) opts.onChange(state.selected);
      }
      function open() {
        for (const [, o] of multiFilters) if (o !== state) o.panel.hidden = true;
        panel.hidden = false; btn.setAttribute('aria-expanded', 'true');
        // 画面右端に近いフィルターは右揃えにする（はみ出して読めなくなるのを防ぐ）
        panel.classList.remove('is-right');
        if (panel.getBoundingClientRect().right > window.innerWidth - 8) panel.classList.add('is-right');
      }
      function close() { panel.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
      btn.addEventListener('click', () => (panel.hidden ? open() : close()));
      panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') { close(); btn.focus(); } });
      state.setValues = setValues;
      state.close = close;
      syncState(true);
      return state;
    }

    /** 外側クリックで閉じる */
    document.addEventListener('click', (e) => {
      for (const [, st] of multiFilters) {
        if (!st.panel.hidden && !st.panel.contains(e.target) && e.target !== st.button) st.close();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') for (const [, st] of multiFilters) st.close();
    });

    /**
     * Email 個別検索（補助機能）。
     * 通常のセグメント検索と混同しないよう既定は閉じておき、
     * **入力が残っているときだけ**「Email 条件あり」を出す。
     */
    function initEmailSearch(inputId) {
      const box = document.getElementById(inputId + 'Box');
      const input = document.getElementById(inputId);
      const badge = document.getElementById(inputId + 'Badge');
      const clear = document.getElementById(inputId + 'Clear');
      if (!box || !input) return;
      const sync = () => {
        const has = String(input.value || '').trim() !== '';
        if (badge) badge.hidden = !has;
        box.classList.toggle('is-active', has);
        if (has) box.open = true;   // 検索中は閉じない（条件が隠れないように）
      };
      input.addEventListener('input', sync);
      clear?.addEventListener('click', () => {
        input.value = '';
        input.dispatchEvent(new Event('input', { bubbles: true }));
        sync();
      });
      sync();
    }

    /** いまの複数選択をまとめて読む */
    function multiValues(ids) {
      const out = {};
      for (const id of ids) {
        // 画面組み立て前に呼ばれても「条件なし」で返す（初期描画で落とさない）
        let st = null;
        try { st = multiFilters.get(id); } catch (e) { st = null; }
        out[id] = st ? st.selected : [];
      }
      return out;
    }

    // ══════════════════════════════════════════════════════════════
    //  カムバック特典タブ: 操作順の管理
    //  押せる／押せないの根拠は comebackConsoleFlow.js（単一源）。画面は従うだけ。
    // ══════════════════════════════════════════════════════════════
    const cbApi = () => window.__cbFlow;
    // 「確認を開く」と「本番付与」の文言・可否の単一源（cbSync からも使うのでここで定義する）
    const applyApi = () => window.__cbApply;
    const cbState = {
      loaded: false, candidateCount: 0, selectedCount: 0,
      offer: { lightOffer: 'none', premiumOffer: 'none' },
      dryRun: null, dryStale: false, applied: false, busy: false,
      offerSummaryShort: '未選択',
      /** 直近の付与実行が返した引き継ぎ票（operationId と人数だけ。PII は入らない） */
      lastHandoff: null,
      /** 絞り込みを変えたまま再取得していない（一覧が古い） */
      filtersChanged: false,
      /** 現有効会員の警告を出したか（同じ警告を積み上げない） */
      activeWarned: false,
    };

    /** 通知（内容別。gate や失効の理由をここに出す） */
    function cbNotify(kind, text, detail, key) {
      const box = $('cbNotices');
      if (!box) return;
      // 同じ種類の通知を積み上げない。キー付きなら**常に最大 1 件**で、内容だけ差し替える
      const id = String(key || '');
      const existing = id ? box.querySelector('[data-notice-key="' + id + '"]') : null;
      const el = existing || document.createElement('div');
      el.className = 'notice notice-' + kind;
      if (id) el.dataset.noticeKey = id;
      el.innerHTML = '';
      const t = document.createElement('b'); t.textContent = text; el.appendChild(t);
      if (detail) { const d = document.createElement('span'); d.className = 'notice-d'; d.textContent = detail; el.appendChild(d); }
      const x = document.createElement('button'); x.type = 'button'; x.className = 'notice-x'; x.textContent = '×';
      x.addEventListener('click', () => {
        el.remove();
        // × で閉じたら「閉じた」ことを覚える。同じ状態では出し直さない
        if (id) cbDismissed.add(id);
      });
      el.appendChild(x);
      if (!existing) box.prepend(el);
      while (box.children.length > 3) box.lastChild.remove();
      return el;
    }

    /** キー付き通知を消す（状態が解消したら自動で消える） */
    function cbClearNotice(key) {
      const box = $('cbNotices');
      const el = box && box.querySelector('[data-notice-key="' + String(key) + '"]');
      if (el) el.remove();
      cbDismissed.delete(String(key));
    }

    /** × で閉じた通知のキー（同じ状態では出し直さない） */
    const cbDismissed = new Set();

    /** 通知キー（種類ごとに 1 件だけ） */
    const CB_NOTICE = { STALE: 'filter-stale', LOADING: 'filter-loading', LOADED: 'filter-loaded', ERROR: 'filter-error' };

    /** いまの特典設定を読む */
    function cbCurrentOffer() {
      return {
        lightOffer: $('cbLightOffer')?.value || 'none',
        lightDays: $('cbLightDays')?.value || '',
        premiumOffer: $('cbPremiumOffer')?.value || 'none',
        premiumDays: $('cbPremiumDays')?.value || '',
        premiumPrice: $('cbPremiumPrice')?.value || '',
      };
    }

    /** 確認結果の指紋（条件・選択・特典） */
    function cbFingerprint() {
      return cbApi().computeCbFingerprint({
        filters: { ...multiValues(CB_MULTI_IDS), q: $('cbQ')?.value || '' },
        selectedIds: [...cbSelected],
        offer: cbCurrentOffer(),
      });
    }

    /** 確認結果を失効させる */
    function cbInvalidate(why) {
      if (!cbState.dryRun) return;
      cbState.dryStale = true;
      const p = $('cbReviewPanel');
      if (p) { p.hidden = true; p.innerHTML = ''; }
      cbNotify('warn', '確認結果を無効にしました', why + ' もう一度「付与内容を確認」を押してください。');
      cbSync();
    }

    /** 状態 → 画面（段階の強調・操作可否・追従バー） */
    function cbSync() {
      cbState.selectedCount = cbSelected.size;
      cbState.offer = cbCurrentOffer();
      cbState.offerSummaryShort = cbOfferShortLabel();
      if (cbState.dryRun) {
        cbState.dryStale = cbApi().isCbDryStale({ dryRun: cbState.dryRun, current: {
          filters: { ...multiValues(CB_MULTI_IDS), q: $('cbQ')?.value || '' },
          selectedIds: [...cbSelected], offer: cbCurrentOffer(),
        } });
      }
      const step = cbApi().resolveCbStep(cbState);
      for (const el of document.querySelectorAll('#cbSteps .stp')) {
        const n = Number(el.dataset.cbstep);
        el.classList.toggle('is-now', n === step);
        el.classList.toggle('is-done', n < step);
      }
      // 未到達の段階は薄く・操作不可にする
      for (const card of document.querySelectorAll('.cb-step')) {
        const n = Number(card.dataset.cbcard);
        const reached = n <= step;
        card.classList.toggle('is-locked', !reached);
        card.classList.toggle('is-now', n === step);
        card.classList.toggle('is-done', n < step);
        for (const c of card.querySelectorAll('button, select, input')) {
          if (c.dataset.always === '1') continue;
          c.disabled = !reached;
        }
      }
      const dry = cbApi().canReview(cbState);
      const btn = $('cbDryRun');
      if (btn) { btn.disabled = !dry.allowed; btn.title = dry.allowed ? '' : (dry.reason || ''); }
      const apply = cbApi().canApply(cbState);
      const ab = $('cbApplyBtn');
      if (ab) { ab.disabled = !apply.allowed; ab.title = apply.allowed ? '' : (apply.reason || ''); }
      const lock5 = $('cbStep5Lock');
      // 「まだ変更されない」ことは常に出す（押せる状態でも消さない）
      if (lock5) {
        lock5.textContent = apply.allowed
          ? '確認済みです。最終確認へ進めます（このボタンでは付与されません）。'
          : (apply.reason || '');
      }
      const hint5 = $('cbStep5Hint');
      if (hint5) hint5.textContent = applyApi().OPEN_CONFIRM_HINT;
      const lock3 = $('cbStep3Lock');
      if (lock3) {
        const cfg = cbApi().canConfigureOffer(cbState);
        lock3.textContent = cfg.allowed ? '' : (cfg.reason || '');
        lock3.hidden = cfg.allowed;
      }
      const empty2 = $('cbStep2Empty');
      if (empty2) empty2.hidden = cbState.loaded;
      const counts = $('cbStepCounts');
      if (counts) counts.textContent = cbState.loaded ? ('候補 ' + cbState.candidateCount + ' 名 / 選択 ' + cbSelected.size + ' 名') : '';

      const sum = $('cbOfferSummary');
      if (sum) {
        const text = cbApi().describeOfferSelection({
          count: cbSelected.size,
          lightLabel: cbOfferLabel('cbLightOffer'),
          premiumLabel: cbOfferLabel('cbPremiumOffer'),
        });
        sum.textContent = text;
        sum.hidden = cbSelected.size === 0;
      }

      const prog = $('cbProgress');
      if (prog) prog.textContent = 'Step ' + step + ' / 5';

      // 各カードに「いま何をすべきか」を出す（色だけに頼らない）
      for (const card of document.querySelectorAll('.cb-step')) {
        const n = Number(card.dataset.cbcard);
        // 現在地はバッジでも示す（色覚に依存しない）
        let badge = card.querySelector('.step-now-badge');
        if (n === step) {
          if (!badge) {
            badge = document.createElement('span');
            badge.className = 'step-now-badge';
            badge.textContent = '現在の操作';
            card.querySelector('.step-h')?.appendChild(badge);
          }
        } else if (badge) {
          badge.remove();
        }
        let hint = card.querySelector('.step-hint.js-hint');
        if (!hint) {
          hint = document.createElement('p');
          hint.className = 'step-hint js-hint';
          card.querySelector('.step-h')?.insertAdjacentElement('afterend', hint);
        }
        if (n === step) {
          hint.textContent = '👉 ここを操作してください';
          hint.className = 'step-hint js-hint' + (n === 5 ? ' is-danger' : '');
        } else if (n < step) {
          hint.textContent = '✅ 完了';
          hint.className = 'step-hint js-hint';
        } else {
          hint.textContent = '前の Step を完了してください';
          hint.className = 'step-hint js-hint is-locked';
        }
      }

      const bar = $('cbStickyBar');
      if (bar) {
        bar.hidden = false;
        const v = cbApi().buildCbStickyView(cbState);
        $('cbSbLeft').innerHTML = '';
        const left = document.createElement('span');
        left.className = 'tag tag-yellow';
        left.textContent = v.left;
        $('cbSbLeft').appendChild(left);
        $('cbSbOffer').textContent = v.offer;
        // いま何で絞っているかを常に出す（条件を忘れたまま実行させない）
        const cond = $('cbSbCond');
        if (cond) {
          const selections = multiValues(CB_MULTI_IDS);
          const n = filterApi().countApplied(selections);
          // 「項目」ではなく**選んだ値の数**なので件で数える（1 項目に複数値が入る）
          // 上部の案内と同じ長文を繰り返さない。ここは状態を一言だけ
          cond.textContent = cbState.filtersChanged
            ? '未反映の条件変更あり'
            : '条件: ' + (n === 0 ? '指定なし' : n + ' 件');
          cond.classList.toggle('is-changed', !!cbState.filtersChanged);
        }
        // 確認状態は色でも分ける（未確認=黄 / 確認済み=緑 / 失効=オレンジ）
        $('cbSbReview').innerHTML = '';
        const rv = document.createElement('span');
        rv.className = 'tag ' + (v.review.includes('確認済み') ? 'tag-green'
          : v.review.includes('失効') ? 'tag-orange' : 'tag-yellow');
        rv.textContent = v.review;
        $('cbSbReview').appendChild(rv);
        // 次の操作は 1 つだけ。段階で色を変える
        const next = $('cbSbNext');
        // Step 5 でも danger にしない。追従バーは確認画面を開くだけで、
        // 本番データを変えるのは確認モーダルの最終ボタンだけなので、赤は 1 つに保つ。
        const tone = { 1: 'btn-primary', 2: 'btn-warning', 3: 'btn-purple', 4: 'btn-success', 5: 'btn-primary' }[step] || 'btn-primary';
        // 条件を変えたままなら、次にやることは「再表示」ひとつ
        if (cbState.filtersChanged) {
          next.className = 'btn-lg btn-caution';
          next.textContent = '🔍 対象候補を再表示';
        } else {
          next.className = 'btn-lg ' + tone;
          // Step 5 のアイコンは本体ボタンと同じ 📋（同じ操作であることを見た目でも揃える）
          next.textContent = ({ 1: '🔍 ', 2: '👥 ', 3: '🎁 ', 4: '✅ ', 5: '📋 ' }[step] || '') + v.next;
        }
      }
    }

    /** 選択肢のラベル（「付与しない」は空にする） */
    function cbOfferLabel(id) {
      const el = $(id);
      if (!el || !el.value || el.value === 'none') return '';
      return el.options[el.selectedIndex]?.textContent?.trim() || '';
    }
    function cbOfferShortLabel() {
      const l = cbOfferLabel('cbLightOffer');
      const p = cbOfferLabel('cbPremiumOffer');
      // Step 3 で何も選んでいないうちは「未選択」と言う。
      // 既定値の名前（Light 永久無料）を出すと、選んでいない特典が
      // 判定基準に見えてしまう。
      if (!l && !p) return '未選択';
      return (l || 'Light なし') + ' / ' + (p || 'Premium なし');
    }

    /** 条件を変えたら要約を出し、現有効会員なら警告する */
    function cbRenderFilterDesc() {
      // 説明はチップ描画側（cbRenderChips）が自然文で出す
      cbRenderChips();
      cbInvalidate('対象条件が変わりました。');
      cbSync();
    }
    for (const id of ['cbContract', 'cbPlan', 'cbWithdrawn', 'cbPromo', 'cbGrantable', 'cbHistory', 'cbQ']) {
      document.getElementById(id)?.addEventListener('change', cbRenderFilterDesc);
    }
    for (const id of ['cbLightOffer', 'cbLightDays', 'cbPremiumOffer', 'cbPremiumDays', 'cbPremiumPrice']) {
      document.getElementById(id)?.addEventListener('change', () => {
        cbInvalidate('特典の内容が変わりました。');
        cbSync();
      });
    }
    $('cbViewSelected')?.addEventListener('click', () => {
      cbState.viewSelected = !cbState.viewSelected;
      $('cbViewSelected').textContent = cbState.viewSelected ? 'すべて表示' : '選択者のみ表示';
      cbRender();
    });

    /** 顧客マーケティングの絞り込みを複数選択へ変換する */
    const MK_MULTI_IDS = ['mkContract', 'mkPlan', 'mkSendable', 'mkPp', 'mkHistory',
      'mkOfferState', 'mkOfferWindow', 'mkPromoState', 'mkFrequency', 'mkLastLogin'];
    const MK_MULTI_LABELS = {
      mkContract: '契約状態', mkPlan: 'プラン', mkSendable: '送信可否', mkPp: 'Plus 資格',
      mkHistory: '送信履歴', mkOfferState: 'オファーの状態', mkOfferWindow: 'オファーの残り期間',
      mkPromoState: '現在の無料付与',
      mkFrequency: '送信タイミング', mkLastLogin: '最終ログイン',
    };
    /**
     * 通常運用の初期値へ戻す。
     * 「指定なし」は**送信できない顧客も候補に入る**ため、送信可否だけは既定で絞る。
     */
    function mkApplyDefaults() {
      const defs = defsApi();
      if (!defs) return;
      for (const id of MK_MULTI_IDS) {
        multiFilters.get(id)?.setValues(defs.defaultSelection(id));
      }
    }

    function mkInitFilters() {
      for (const id of MK_MULTI_IDS) {
        makeMultiFilter(id, {
          label: MK_MULTI_LABELS[id],
          onChange: () => { mkRenderChips(); mkInvalidateDryRun('絞り込み条件が変わりました。'); },
          onApply: () => { mkRenderChips(); },
        });
      }
      const note = $('mkLogicNote');
      if (note) note.textContent = filterApi().FILTER_LOGIC_NOTE;
      const routine = $('mkRoutineNote');
      if (routine && defsApi()) routine.textContent = defsApi().ROUTINE_FILTER_NOTE;
      // 通常運用の初期値（送信可否 = メール送信可能）を最初から入れておく
      mkApplyDefaults();
      mkRenderChips();
    }

    /** 条件を自然文で出し、両立しない組合せは取得前に知らせる */
    function mkRenderConditionSummary() {
      const defs = defsApi();
      if (!defs) return;
      const selections = multiValues(MK_MULTI_IDS);
      const sum = $('mkConditionText');
      if (sum) sum.textContent = defs.describeConditionsNatural(selections);
      const warn = $('mkConditionWarn');
      if (warn) {
        const problems = defs.detectImpossibleCombination(selections);
        warn.textContent = problems.map((p) => p.message).join(' ');
        warn.hidden = problems.length === 0;
      }
    }

    function mkRenderChips() {
      const box = $('mkChips');
      if (!box) return;
      mkRenderConditionSummary();
      const selections = multiValues(MK_MULTI_IDS);
      const labels = {};
      for (const id of MK_MULTI_IDS) {
        const st = multiFilters.get(id);
        labels[id] = Object.fromEntries((st?.items || []).map((i) => [i.value, i.label]));
      }
      box.innerHTML = '';
      for (const c of filterApi().buildChips(selections, labels)) {
        const el = document.createElement('button');
        el.type = 'button'; el.className = 'chip';
        el.textContent = c.label + ' ×';
        el.title = MK_MULTI_LABELS[c.key] + ' から外す';
        el.addEventListener('click', () => {
          const st = multiFilters.get(c.key);
          st?.setValues(st.selected.filter((v) => v !== c.value));
          mkRenderChips();
          mkInvalidateDryRun('絞り込み条件が変わりました。');
        });
        box.appendChild(el);
      }
      const n = filterApi().countApplied(selections);
      if (n > 0) {
        const clear = document.createElement('button');
        clear.type = 'button'; clear.className = 'chip chip-clear';
        clear.textContent = '条件をすべてクリア';
        clear.addEventListener('click', () => {
          for (const id of MK_MULTI_IDS) multiFilters.get(id)?.setValues([]);
          mkRenderChips();
        });
        box.appendChild(clear);
        const count = document.createElement('span');
        count.className = 'chip-count'; count.textContent = n + ' 条件を適用中';
        box.appendChild(count);
      }
      if ($('mkFilterCount')) mkRenderFilterCount();
    }

    /** カムバックの絞り込みを複数選択へ変換する */
    const CB_MULTI_IDS = ['cbContract', 'cbPlan', 'cbWithdrawn',
      'cbGrantNow', 'cbGrantHistory', 'cbGrantable', 'cbHistory'];
    const CB_MULTI_LABELS = {
      cbContract: '対象区分', cbPlan: 'プラン', cbWithdrawn: '退会履歴',
      // 「特典」という曖昧な語をやめ、**いま**と**これまで**を分ける
      cbGrantNow: '現在の無料付与', cbGrantHistory: '無料付与履歴',
      // 「今回この操作を実行できるか」。現在状態・履歴とは別項目
      cbGrantable: '今回の無料付与', cbHistory: '送信履歴',
    };
    function cbInitFilters() {
      for (const id of CB_MULTI_IDS) {
        makeMultiFilter(id, {
          label: CB_MULTI_LABELS[id],
          onChange: () => { cbRenderChips(); cbMarkFilterChanged(); },
          onApply: () => { cbRenderChips(); cbMarkFilterChanged(); },
        });
      }
      // 初期値: 期限切れ・退会済み・休眠（安全な候補だけ）
      multiFilters.get('cbContract')?.setValues([...filterApi().CB_SEGMENT_DEFAULT]);

      // プリセット（「カムバック候補すべて」は選択肢ではなくボタン）
      const row = $('cbPresets');
      if (row) {
        for (const [key, p] of Object.entries(filterApi().CB_SEGMENT_PRESETS)) {
          const b = document.createElement('button');
          b.type = 'button'; b.className = 'btn-ghost btn-sm'; b.dataset.preset = key;
          b.textContent = p.label;
          b.addEventListener('click', () => {
            multiFilters.get('cbContract')?.setValues([...p.values]);
            cbRenderChips(); cbMarkFilterChanged();
          });
          row.appendChild(b);
        }
      }
      const note = $('cbLogicNote');
      if (note) note.textContent = filterApi().FILTER_LOGIC_NOTE;
      // 現在状態 / 履歴 / 今回の可否は別物。取り違えないよう画面に書く
      const gn = $('cbGrantNote');
      if (gn) gn.textContent = cbApi().GRANT_ELIGIBILITY_NOTE || '';
      cbRenderChips();
    }

    /** 適用中の条件をチップで出す（1 件ずつ外せる） */
    function cbRenderChips() {
      const box = $('cbChips');
      if (!box) return;
      const selections = multiValues(CB_MULTI_IDS);
      const labels = {};
      for (const id of CB_MULTI_IDS) {
        const st = multiFilters.get(id);
        labels[id] = Object.fromEntries((st?.items || []).map((i) => [i.value, i.label]));
      }
      box.innerHTML = '';
      const chips = filterApi().buildChips(selections, labels);
      for (const c of chips) {
        const el = document.createElement('button');
        el.type = 'button'; el.className = 'chip';
        el.textContent = c.label + ' ×';
        el.title = CB_MULTI_LABELS[c.key] + ' から外す';
        el.addEventListener('click', () => {
          const st = multiFilters.get(c.key);
          st?.setValues(st.selected.filter((v) => v !== c.value));
          cbRenderChips(); cbMarkFilterChanged();
        });
        box.appendChild(el);
      }
      if (chips.length) {
        const clear = document.createElement('button');
        clear.type = 'button'; clear.className = 'chip chip-clear';
        clear.textContent = '条件をすべてクリア';
        clear.addEventListener('click', () => {
          for (const id of CB_MULTI_IDS) multiFilters.get(id)?.setValues([]);
          cbRenderChips(); cbMarkFilterChanged();
        });
        box.appendChild(clear);
        const count = document.createElement('span');
        count.className = 'chip-count';
        count.textContent = filterApi().countApplied(selections) + ' 条件を適用中';
        box.appendChild(count);
      }
      const desc = $('cbFilterDesc');
      if (desc) desc.textContent = filterApi().describeConditions(selections, labels, CB_MULTI_IDS);

      // 「現在有効な会員」は通常のカムバック対象ではない。選んだら必ず警告を出す
      const hasActive = filterApi().isActiveMemberIncluded(selections.cbContract);
      if (hasActive && !cbState.activeWarned) {
        cbState.activeWarned = true;
        cbNotify('warn', '通常の対象ではありません', cbApi().ACTIVE_FILTER_WARNING);
      }
      if (!hasActive) cbState.activeWarned = false;
    }

    /** 条件が変わったら一覧と確認結果を古い扱いにする */
    function cbMarkFilterChanged() {
      if (cbState.loaded) {
        // 条件を変えるのは**通常の操作**。エラーではなくオレンジの案内を 1 件だけ出す。
        // × で閉じても、**さらに条件を変えたら**もう一度出す（未反映のまま実行させない）。
        cbState.filtersChanged = true;
        cbDismissed.delete(CB_NOTICE.STALE);
        cbNotify('caution', '検索条件が変わりました。', '対象候補を再表示してください。', CB_NOTICE.STALE);
      }
      cbInvalidate('対象条件が変わりました。');
      cbSync();
    }

    // 画面表示時に複数選択へ変換する（既存 select はここで置き換わる）
    document.addEventListener('DOMContentLoaded', () => {
      try {
        cbInitFilters();
        mkInitFilters();
        for (const id of ['q', 'mkQ', 'cbQ']) initEmailSearch(id);
        // 初期表示でも「いまどの Step か」を出す（マーケティングは同期待ちで無色のままだった）
        mkSyncFlow();
        cbSync();
      } catch (e) { /* 変換できなくても既存動作は壊さない */ }
    });

    const CB_API = '/.netlify/functions/admin-comeback-grants';

    let cbData = null;                 // 直近の customers 応答
    let cbCatalog = null;              // 特典カタログ（Light / Premium無料 / Premium割引）
    let cbWriteEnabled = false;        // 実行が有効か（本番は既定 false）
    let cbLastOperationId = '';        // 直近の dry-run / 実行の操作 ID（再開・突合用）
    const cbSelected = new Set();      // 選択中の recordId

    function cbMsg(text, kind) {
      const el = $('cbMessage');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function cbCall(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { cbMsg('管理シークレットを入力してください', 'err'); $('connBody').hidden = false; return null; }
      const res = await fetch(CB_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        // 503（gate 無効）/ 409（対象変化）/ 502（部分失敗）は理由をそのまま出す
        cbMsg((data.error || ('エラー: ' + res.status)) + (data.howToRecover ? '　' + data.howToRecover : ''), 'err');
        return null;
      }
      return data;
    }

    /**
     * 付与実行だけは**失敗応答の中身も要る**。
     * 途中で止まった（502 partial）ときでも「書き込めた分」は実在するので、
     * その成功者を案内メールへ引き継げるようにする。
     * ⚠️ 巻き戻しはしない。付与は付与、メールはメールとして別に扱う。
     */
    async function cbCallDetailed(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { cbMsg('管理シークレットを入力してください', 'err'); $('connBody').hidden = false; return { ok: false, data: null }; }
      const res = await fetch(CB_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        cbMsg((data.error || ('エラー: ' + res.status)) + (data.howToRecover ? '　' + data.howToRecover : ''), 'err');
      }
      return { ok: res.ok, data };
    }

    function cbFillSelect(id, offers, noneLabel) {
      const sel = $(id);
      sel.innerHTML = '';
      const none = document.createElement('option');
      none.value = 'none';
      none.textContent = noneLabel;
      sel.appendChild(none);
      for (const o of offers) {
        const opt = document.createElement('option');
        opt.value = o.offerId;
        opt.textContent = o.name;
        opt.dataset.customDays = o.requiresCustomDays ? '1' : '';
        opt.dataset.customPrice = o.requiresCustomPrice ? '1' : '';
        opt.dataset.kind = o.kind;
        opt.dataset.regularPrice = String(o.regularPrice);
        // 退会・課金停止の方へ配れるか（判定はサーバー側の単一源。画面は結果を表示するだけ）
        opt.dataset.withdrawnAllowed = o.withdrawnAllowed ? '1' : '';
        opt.dataset.withdrawnLabel = o.withdrawnLabel || '';
        opt.dataset.withdrawnNote = o.withdrawnNote || '';
        opt.dataset.policyCampaign = o.policyCampaignLabel || '';
        opt.dataset.policySegments = ((o.policy && o.policy.audienceSegments) || []).join(',');
        sel.appendChild(opt);
      }
    }

    async function cbLoadOffers() {
      const data = await cbCall({ action: 'offers' });
      if (!data) return;
      cbCatalog = data;
      cbWriteEnabled = !!data.writeEnabled;

      cbFillSelect('cbLightOffer', data.lightOffers, 'なし');
      // Premium は「無料付与」と「割引購入」を 1 つのセレクトに分けて入れる（種類は option に持たせる）
      const premium = [...data.premiumGrantOffers, ...data.premiumPurchaseOffers];
      cbFillSelect('cbPremiumOffer', premium, 'なし');

      // ⚠️ **既定で特典を選ばない**。既定値を入れると Step 2 の一覧が
      //    「まだ選んでいない特典」を基準に判定され、退会・課金停止の候補が
      //    全員「対象外」になって Step 3 へ進めなくなる（本番で発生）。
      $('cbLightOffer').value = 'none';
      $('cbPremiumOffer').value = 'none';
      cbRenderOfferDesc();
      $('cbGateState').textContent = data.notice || '';
      $('cbGateState').className = 'note' + (data.writeEnabled ? '' : ' off');
    }

    function cbSelectedOption(id) {
      const sel = $(id);
      return sel.options[sel.selectedIndex] || null;
    }

    /**
     * いま選ばれている**無料付与**の offerId（0〜2 件）。
     * 一覧の「今回付与できる」を dry-run と同じ基準で出すためにサーバーへ渡す。
     * 未選択なら空配列＝従来どおりの判定。
     */
    function cbSelectedGrantOfferIds() {
      const out = [];
      for (const id of ['cbLightOffer', 'cbPremiumOffer']) {
        const el = $(id);
        const v = el ? String(el.value || '') : '';
        if (v && v !== 'none') out.push(v);
      }
      return out;
    }

    /** 選択内容 → API へ渡す payload（任意日数・任意価格を含む） */
    function cbSelectionPayload() {
      const light = $('cbLightOffer').value;
      const premium = $('cbPremiumOffer').value;
      const out = {};
      if (light && light !== 'none') {
        out.lightOfferId = light;
        if (cbSelectedOption('cbLightOffer').dataset.customDays) {
          out.lightCustomDays = Number($('cbLightDays').value);
        }
      }
      if (premium && premium !== 'none') {
        out.premiumOfferId = premium;
        const opt = cbSelectedOption('cbPremiumOffer');
        if (opt.dataset.customDays) out.premiumCustomDays = Number($('cbPremiumDays').value);
        if (opt.dataset.customPrice) out.premiumCustomPrice = Number($('cbPremiumPrice').value);
      }
      return out;
    }

    /** 任意入力欄の出し分け＋価格の内訳表示 */
    function cbRenderOfferDesc() {
      const lightOpt = cbSelectedOption('cbLightOffer');
      const premiumOpt = cbSelectedOption('cbPremiumOffer');
      $('cbLightDaysWrap').hidden = !(lightOpt && lightOpt.dataset.customDays);
      $('cbPremiumDaysWrap').hidden = !(premiumOpt && premiumOpt.dataset.customDays);
      $('cbPremiumPriceWrap').hidden = !(premiumOpt && premiumOpt.dataset.customPrice);

      // 価格の内訳（通常価格 / 割引 / 特別価格 / 無料）
      const box = $('cbPriceBox');
      const dl = $('cbPriceKv');
      dl.innerHTML = '';
      const isPurchase = premiumOpt && premiumOpt.dataset.kind === 'purchase_offer';
      if (isPurchase) {
        const regular = Number(premiumOpt.dataset.regularPrice) || 0;
        const price = premiumOpt.dataset.customPrice
          ? Number($('cbPremiumPrice').value)
          : null;
        kvRow(dl, '通常価格', '¥' + regular.toLocaleString());
        if (price !== null) {
          const off = regular > 0 ? Math.round((1 - price / regular) * 100) : 0;
          kvRow(dl, '特別価格', '¥' + (price || 0).toLocaleString(), 'strong-ok');
          kvRow(dl, '割引率', off + '%OFF');
        } else {
          kvRow(dl, '特別価格', 'dry-run で確定します');
        }
        kvRow(dl, '権限', '購入条件のみ（支払い完了まで権限は付与されません）');
        box.hidden = false;
      } else if (premiumOpt && premiumOpt.value !== 'none') {
        kvRow(dl, '料金', '無料（課金は発生しません）', 'strong-ok');
        box.hidden = false;
      } else {
        box.hidden = true;
      }

      const parts = [];
      if (lightOpt && lightOpt.value !== 'none') parts.push('Light: ' + lightOpt.textContent);
      if (premiumOpt && premiumOpt.value !== 'none') parts.push('Premium: ' + premiumOpt.textContent);
      $('cbOfferDesc').textContent = parts.length ? parts.join('　/　') : '特典を選択してください。';

      cbRenderWithdrawnAvailability(lightOpt, premiumOpt);
    }

    /**
     * 選んだ特典が「退会・課金停止」の方へ配れるかを出す。
     * **判定はしない**（サーバーが特典カタログの宣言から出した結果を表示するだけ）。
     * 対象区分に「退会・課金停止」を選んでいるのに配れない特典なら、はっきり警告する。
     */
    function cbRenderWithdrawnAvailability(lightOpt, premiumOpt) {
      const box = $('cbWithdrawnAvail');
      if (!box) return;
      const chosen = [lightOpt, premiumOpt].filter((o) => o && o.value && o.value !== 'none');
      const grants = chosen.filter((o) => o.dataset.kind !== 'purchase_offer');
      if (grants.length === 0) { box.hidden = true; box.textContent = ''; return; }

      const wantsWithdrawn = (multiValues(['cbContract']).cbContract || [])
        .some((v) => v === 'withdrawn' || v === 'candidates');
      const allowed = grants.filter((o) => o.dataset.withdrawnAllowed === '1');
      const blocked = grants.filter((o) => o.dataset.withdrawnAllowed !== '1');

      const lines = [];
      for (const o of allowed) {
        lines.push(`✅ ${o.textContent}：${o.dataset.withdrawnLabel || '退会・課金停止の方へも配れます'}`
          + (o.dataset.withdrawnNote ? `\n　${o.dataset.withdrawnNote}` : '')
          + (o.dataset.policyCampaign ? `\n　案内メール：${o.dataset.policyCampaign}` : ''));
      }
      for (const o of blocked) {
        lines.push(`⚠️ ${o.textContent}：${o.dataset.withdrawnLabel || '退会・課金停止の方へは配れません'}`
          + (o.dataset.withdrawnNote ? `\n　${o.dataset.withdrawnNote}` : ''));
      }
      if (wantsWithdrawn && blocked.length > 0) {
        lines.push('※ 対象区分に「退会・課金停止」が入っています。この特典は該当者が確認の時点で除外されます（付与されません）。');
      }
      box.textContent = lines.join('\n');
      box.className = 'cb-withdrawn-avail' + (blocked.length > 0 ? ' warn' : ' ok');
      box.hidden = false;
    }
    for (const id of ['cbLightOffer', 'cbPremiumOffer', 'cbLightDays', 'cbPremiumDays', 'cbPremiumPrice']) {
      $(id).addEventListener('change', cbRenderOfferDesc);
      $(id).addEventListener('input', cbRenderOfferDesc);
    }
    /**
     * 特典を選び直したら**一覧の「今回付与できる」を取り直す**。
     *
     * 付与できるかは特典によって変わる（退会・課金停止の方を対象にできるのは
     * カタログで宣言した施策だけ）。取り直さないと、一覧の表示・「付与可能者を全選択」と
     * dry-run の判定がズレる ―― 実際「退会・課金停止」を選ぶと全行が付与不可に見えて
     * 全選択が 0 名なのに、手動チェックだけは通る、という食い違いが起きていた。
     */
    for (const id of ['cbLightOffer', 'cbPremiumOffer']) {
      $(id).addEventListener('change', async () => {
        if (!cbData) return;                   // まだ一覧を出していないなら何もしない
        cbNotify('info', '選んだ特典に合わせて対象を判定し直しています…', '', CB_NOTICE.LOADING);
        await cbLoad();
        cbPruneSelectionForOffer();
      });
    }

    /**
     * Step 3 で特典を決めた時点で、**選択済みの顧客を施策の条件で再判定**する。
     *
     * Step 2 は絶対除外だけで選ばせるので、選択の中に「この特典では対象外」の人が
     * 混ざりうる（例: 退会・課金停止の方に、退会者非対応の特典を選んだ場合）。
     * ここで外し、**何人・なぜ外れたかを必ず件数付きで伝える**（黙って減らさない）。
     * 実際に付与できるかは Step 4 dry-run と実行直前にも同じ単一源で再判定する。
     */
    function cbPruneSelectionForOffer() {
      if (!cbData || cbSelected.size === 0) return;
      const rows = cbData.rows || [];
      if (!rows.some((r) => r.grantEvaluated)) return;   // 特典 未選択なら何もしない
      const byId = new Map(rows.map((r) => [r.recordId, r]));
      const dropped = {};
      let removed = 0;
      for (const id of [...cbSelected]) {
        const r = byId.get(id);
        if (!r || r.grantEvaluated !== true) continue;   // 一覧に無い行は触らない
        if (r.grantable) continue;
        cbSelected.delete(id);
        removed += 1;
        const label = r.grantBlockedLabel || r.selectBlockedLabel || 'この特典では対象外';
        dropped[label] = (dropped[label] || 0) + 1;
      }
      if (removed === 0) {
        cbNotify('ok', '選択中の' + cbSelected.size + ' 名はこの特典で付与できます', '', CB_NOTICE.LOADING);
      } else {
        const why = Object.entries(dropped).map(([k, n]) => k + ' ' + n + ' 名').join(' / ');
        cbNotify('warn', 'この特典では対象外の ' + removed + ' 名を選択から外しました',
          why + '。残り ' + cbSelected.size + ' 名です。', CB_NOTICE.LOADING);
      }
      cbRender();
      cbSyncSticky();
    }

    async function cbLoad() {
      cbMsg('読み込み中…');
      cbClearNotice(CB_NOTICE.ERROR);
      cbNotify('info', '対象候補を更新しています…', '', CB_NOTICE.LOADING);
      // 複数選択は配列で送る（同じ項目内は OR / 未選択は条件なし）
      const sel = multiValues(CB_MULTI_IDS);
      const data = await cbCall({
        action: 'customers',
        contract: sel.cbContract,
        plan: sel.cbPlan,
        withdrawn: sel.cbWithdrawn,
        // 無料付与は「いま」と「これまで」を別条件で送る（項目間は AND）
        currentGrant: sel.cbGrantNow,
        grantHistory: sel.cbGrantHistory,
        grantable: sel.cbGrantable,
        history: sel.cbHistory,
        // 選択中の特典を渡すと「今回付与できる」の判定が dry-run と揃う。
        // カムバックの Light 30 日無料のときだけ退会者も「付与できる」と出る。
        grantOfferIds: cbSelectedGrantOfferIds(),
      });
      cbClearNotice(CB_NOTICE.LOADING);
      if (!data) {
        // 失敗したときだけ赤。案内（オレンジ）は残したままにする
        cbNotify('err', '対象候補を取得できませんでした', 'もう一度お試しください。', CB_NOTICE.ERROR);
        cbMsg('');
        return;
      }
      cbData = data;
      // Step 1 完了。ここから Step 2 を操作できる
      cbState.filtersChanged = false;
      cbState.loaded = true;
      cbState.candidateCount = (data.rows || []).length;
      // 条件変更の案内は役目を終えたので消す（再取得したら自動で消える）
      cbClearNotice(CB_NOTICE.STALE);
      cbInvalidate('対象候補を取得し直しました。');
      cbNotify('ok', '対象候補を表示しました', (data.rows || []).length + ' 名（現有効会員は既定で対象外）', CB_NOTICE.LOADED);
      // 成功通知は積み上げない。短時間で自動的に消す
      setTimeout(() => cbClearNotice(CB_NOTICE.LOADED), 6000);
      cbSync();
      cbWriteEnabled = !!data.writeEnabled;
      cbMsg('');
      cbRender();
    }

    function cbVisibleRows() {
      const q = $('cbQ').value.trim().toLowerCase();
      return (cbData?.rows || []).filter((r) => !q || String(r.email || '').toLowerCase().includes(q));
    }

    /**
     * 一覧の「今回付与できる」が**どの特典を前提にした数字か**を一文で返す。
     * 特典未選択なら、退会・課金停止の方は付与不可として数えられていることを明示する。
     */
    function cbGrantBasisText() {
      const opts = ['cbLightOffer', 'cbPremiumOffer']
        .map((id) => cbSelectedOption(id))
        .filter((o) => o && o.value && o.value !== 'none' && o.dataset.kind !== 'purchase_offer');
      if (opts.length === 0) {
        return '特典 未選択（退会・課金停止の方は付与不可として集計しています）';
      }
      return opts.map((o) => o.textContent
        + (o.dataset.withdrawnAllowed === '1' ? '（退会・課金停止も対象）' : '（退会・課金停止は対象外）')).join(' + ');
    }

    function cbRender() {
      if (!cbData) return;
      const s = cbData.summary || {};
      const bar = $('cbSummary');
      bar.innerHTML = '';
      const items = [
        ['期限切れ', s.contract?.expired || 0],
        ['契約なし', s.contract?.none || 0],
        ['退会あり', s.withdrawn || 0],
        ['無料付与あり', (s.promo?.light || 0) + (s.promo?.trialActive || 0)],
        ['今回付与できる', s.grantable || 0],
      ];
      items.forEach((it, i) => {
        if (i > 0) { const sp = document.createElement('span'); sp.className = 'sep'; sp.textContent = '|'; bar.appendChild(sp); }
        const b = document.createElement('span');
        b.className = 's';
        const kk = document.createElement('span'); kk.className = 'k'; kk.textContent = it[0];
        const vv = document.createElement('span'); vv.className = 'v'; vv.textContent = String(it[1]);
        b.appendChild(kk); b.appendChild(vv);
        bar.appendChild(b);
      });
      const p = s.promo || {};
      // 「今回付与できる」は**どの特典を選んでいるか**で変わる。何を基準に出した数字かを必ず添える
      const basis = cbGrantBasisText();
      $('cbSummarySub').textContent =
        '全顧客 ' + (cbData.totalCustomers || 0) + ' 名　/　特典内訳: Light 永久無料 ' + (p.light || 0)
        + '・Premium 無料期間中 ' + (p.trialActive || 0) + '・Premium 無料 終了 ' + (p.trialExpired || 0)
        + (p.inconsistent ? '・⚠️ 不整合 ' + p.inconsistent : '')
        + '　/　「今回付与できる」の基準: ' + basis;

      const rows = cbVisibleRows();
      const tb = $('cbRows');
      tb.innerHTML = '';
      for (const r of rows) {
        const tr = document.createElement('tr');
        if (!r.selectable) tr.className = 'row-suppressed';

        const c0 = document.createElement('td');
        c0.className = 'c-chk';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = cbSelected.has(r.recordId);
        // Step 2 は**絶対除外だけ**で選択可否を決める（退会・課金停止は選べる）。
        // 特典ごとの可否は Step 3 で判定し、選択済みから外す。
        cb.disabled = !r.selectable;
        cb.setAttribute('aria-label', '選択');
        cb.addEventListener('change', () => {
          if (cb.checked) cbSelected.add(r.recordId); else cbSelected.delete(r.recordId);
          cbRenderSelCount();
        });
        c0.appendChild(cb);
        tr.appendChild(c0);

        const c1 = td('c-cust', '', undefined);
        const em = document.createElement('span');
        em.className = 'em';
        em.textContent = r.email || '(メール未設定)';
        c1.appendChild(em);
        if (r.name) { const nm = document.createElement('span'); nm.className = 'sub'; nm.textContent = r.name; c1.appendChild(nm); }
        tr.appendChild(c1);

        const cCon = td('c-contract', '契約', CONTRACT_LABEL[r.contract] || r.contract);
        cCon.firstChild.className = 'contract ' + r.contract;
        if (r.withdrawn) {
          const wb = document.createElement('span');
          wb.className = 'wd-badge';
          wb.textContent = '退会';
          wb.title = '課金停止（退会申請）。この状態ではログインできないため特典を付与しません';
          cCon.appendChild(wb);
        }
        tr.appendChild(cCon);

        tr.appendChild(td('c-plan', 'プラン', PLAN_LABEL[r.planGroup] || r.planGroup));
        // 無料付与は「いま」と「これまで」を 1 セルに分けて出す（色だけに頼らない）
        const fg = r.freeGrant || null;
        const cell = document.createElement('td');
        cell.className = 'c-promo';
        cell.setAttribute('data-label', '無料付与');
        const nowLine = document.createElement('div');
        nowLine.className = 'fg-now ' + (fg && fg.conflicts && fg.conflicts.length ? 'ng-txt'
          : (fg && fg.badges && fg.badges.some((x) => x.tone === 'ok') ? 'ok-txt' : 'muted'));
        nowLine.textContent = (fg && fg.conflicts && fg.conflicts.length ? '⚠️ ' : '')
          + (fg ? fg.current : (r.promoText || '—'));
        cell.appendChild(nowLine);
        const histLine = document.createElement('div');
        histLine.className = 'fg-hist';
        histLine.textContent = '履歴: ' + (fg ? fg.history : '—');
        if (fg && fg.historyNote) histLine.title = fg.historyNote;
        cell.appendChild(histLine);
        if (fg && fg.source) {
          const src = document.createElement('div');
          src.className = 'fg-src'; src.textContent = '付与元: ' + fg.source;
          cell.appendChild(src);
        }
        if (fg && fg.conflicts && fg.conflicts.length) {
          const why = document.createElement('div');
          why.className = 'fg-why'; why.textContent = fg.conflicts.join(' / ');
          cell.appendChild(why);
        }
        tr.appendChild(cell);
        // 今回の無料付与（実行できるか）。理由は API と同じラベルを出す
        const el = r.eligibility || null;
        const elText = el ? el.text : (r.grantable ? '付与可能' : ('付与不可：' + (r.grantBlockedLabel || '')));
        const elTone = el
          ? (el.status === 'grantable' ? 'ok-txt'
            : (el.status === 'review' ? 'warn-txt'
              : (el.status === 'pending_offer' ? 'muted-txt' : 'ng-txt')))
          : (r.grantable ? 'ok-txt' : 'ng-txt');
        tr.appendChild(td('c-grantable', '今回の無料付与', elText, elTone));

        tb.appendChild(tr);
      }

      $('cbCount').textContent = '表示 ' + rows.length + ' 件 / 条件一致 ' + (cbData.matchedCount || 0) + ' 件'
        + (cbData.truncated ? '（上限を超えたため一部のみ表示）' : '');
      const emp = $('cbEmpty');
      emp.hidden = rows.length > 0;
      emp.textContent = '条件に一致する顧客はいません。';
      cbRenderSelCount();
    }

    function cbRenderSelCount() {
      cbInvalidate('選択した顧客が変わりました。');
      cbSync();
      $('cbSelCount').textContent = cbSelected.size + ' 名を選択中';
    }

    $('cbLoad').addEventListener('click', cbLoad);
    $('cbQ').addEventListener('input', cbRender);
    $('cbSelAll').addEventListener('click', () => {
      for (const r of cbVisibleRows()) if (r.selectable) cbSelected.add(r.recordId);
      cbRender();
    });
    $('cbSelNone').addEventListener('click', () => { cbSelected.clear(); cbRender(); });

    // ── モーダル ──
    /** モーダルを開いた元のボタン（閉じたらここへフォーカスを戻す） */
    let cbModalOpener = null;

    function cbOpenModal(title) {
      $('cbModalTitle').textContent = title;
      $('cbBackdrop').hidden = false;
      lockScroll();
      $('cbModalBody').innerHTML = '';
      // 開いたら見出しへフォーカスを移す（キーボード・読み上げの現在地を合わせる）
      $('cbModalTitle').focus();
      return $('cbModalBody');
    }
    function cbCloseModal() {
      $('cbBackdrop').hidden = true;
      if ($('dtBackdrop').hidden && $('pvBackdrop').hidden && $('mkBackdrop').hidden) unlockScroll();
      // 閉じたら開いたボタンへ戻す（どこを操作していたか見失わせない）
      const back = cbModalOpener;
      cbModalOpener = null;
      if (back && typeof back.focus === 'function' && !back.disabled) back.focus();
    }
    $('cbModalClose').addEventListener('click', cbCloseModal);
    $('cbModalBack').addEventListener('click', cbCloseModal);
    $('cbBackdrop').addEventListener('click', (e) => { if (e.target === $('cbBackdrop')) cbCloseModal(); });

    // ── 送信予定文面の「例」（送信しない・ここでは編集もしない）──
    // 実際に送る件名・本文は**メール作成工程**で編集する。ここは特典の内容から
    // 組み立てた例を見せるだけで、閲覧専用のまま終わらせずに次工程へ接続する。
    $('cbPreviewBtn').addEventListener('click', async () => {
      const sel = cbSelectionPayload();
      if (!sel.lightOfferId && !sel.premiumOfferId) { cbMsg('特典を選択してください', 'err'); return; }
      const data = await cbCall({ action: 'preview', ...sel });
      if (!data) return;
      const body = cbOpenModal('送信予定文面の例');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const lead = document.createElement('p');
      lead.className = 'note';
      lead.textContent = 'これは特典内容から組み立てた**例**です。実際に送る件名・本文は '
        + 'メール作成工程（顧客マーケティング）で編集し、そこで確定した文面だけが送信されます。';
      sec.appendChild(lead);
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '特典', data.selection);
      kvRow(dl, '件名の例', data.subject);
      sec.appendChild(dl);
      const pre = document.createElement('pre');
      pre.className = 'prev-body';
      pre.textContent = data.body;
      sec.appendChild(pre);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec.appendChild(note);

      // 閲覧専用で終わらせない: そのままメール作成工程へ渡す
      const ops = document.createElement('div'); ops.className = 'toolbar';
      const go = document.createElement('button');
      go.type = 'button'; go.className = 'btn-primary';
      go.textContent = '✉️ メール作成工程へ進む';
      go.addEventListener('click', () => {
        cbCloseModal();
        // 付与実行済みなら成功者を引き継ぐ。まだなら工程を開くだけ（対象は空のまま）
        if (cbState.lastHandoff && cbState.lastHandoff.canHandoff) window.__mkHandoff.adopt(cbState.lastHandoff);
        else window.__mkHandoff.open();
      });
      ops.appendChild(go);
      const hint = document.createElement('p'); hint.className = 'note';
      hint.textContent = cbState.lastHandoff && cbState.lastHandoff.canHandoff
        ? '直前の付与で成功した ' + cbState.lastHandoff.grantedCount + ' 名を引き継ぎます。'
        : 'まだ付与を実行していないため、対象は引き継がれません（Step 5 の実行後に引き継げます）。';
      sec.appendChild(ops);
      sec.appendChild(hint);
      body.appendChild(sec);
    });

    // ── dry-run → 最終確認 → 実行 ──
    /** 付与内容の確認結果を Step 4 のパネルへ出す */
    function cbRenderReview(plan) {
      const p = $('cbReviewPanel');
      if (!p) return;
      p.hidden = false;
      p.innerHTML = '';
      const row = (k, v, cls, note) => {
        const d = document.createElement('div'); d.className = 'dp-row ' + (cls || '');
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); p.appendChild(d);
        if (note) {
          const n = document.createElement('p'); n.className = 'dp-note'; n.textContent = note;
          p.appendChild(n);
        }
      };
      const aud = plan.audience || {};
      // 3 つの人数を**混ぜずに**出す（対象 → 付与予定 → 送信予定）
      row('対象人数（選択）', (plan.selected ?? cbSelected.size) + ' 名');
      row('付与予定人数', (plan.willGrant ?? aud.eligible ?? 0) + ' 名',
        (plan.willGrant ?? aud.eligible ?? 0) > 0 ? 'is-ok' : 'is-ng');
      // 案内メールは**付与に成功した人だけ**が対象。付与予定がそのまま送信予定になる
      row('送信予定人数（付与成功者のみ）', (plan.willGrant ?? 0) + ' 名',
        '', 'この人数を引き継いだあと、メール工程で配信停止・停止リスト・24時間の間隔を再判定します。');
      row('除外', (plan.excluded ?? aud.excluded ?? 0) + ' 名');
      row('現有効会員の混入', (aud.activeMembers ?? 0) + ' 名', (aud.activeMembers ?? 0) > 0 ? 'is-ng' : '');
      const seg = aud.bySegment || {};
      row('対象区分', Object.entries(seg).map(([k, n]) => cbApi().segmentLabel(k) + ' ' + n + ' 名').join(' / ') || '—');
      // 除外理由は**必ず件数付きで全部出す**（黙って落とさない）
      const reasons = plan.skippedDetail && plan.skippedDetail.length
        ? Object.fromEntries(plan.skippedDetail.map((d) => [d.reason, d.count]))
        : (aud.byReason || {});
      const reasonLabels = plan.skippedDetail && plan.skippedDetail.length
        ? Object.fromEntries(plan.skippedDetail.map((d) => [d.reason, d.label]))
        : (aud.reasonLabels || {});
      if (Object.keys(reasons).length) {
        row('除外理由', Object.entries(reasons)
          .sort((a, b) => b[1] - a[1])
          .map(([k, n]) => (reasonLabels[k] || k) + ' ' + n + ' 名').join(' / '));
      }
      row('付与する特典', cbOfferShortLabel());
      row('変更しないもの', cbApi().UNCHANGED_NOTICE);
      if ((aud.activeMembers ?? 0) > 0) {
        const w = document.createElement('p'); w.className = 'blocker';
        w.textContent = '⛔ 現在有効な会員が含まれています。対象から外すまで実行できません。';
        p.appendChild(w);
      }
    }

    $('cbDryRun').addEventListener('click', async () => {
      const sel = cbSelectionPayload();
      if (!sel.lightOfferId && !sel.premiumOfferId) { cbMsg('特典を選択してください', 'err'); return; }
      if (cbSelected.size === 0) { cbMsg('対象を選択してください', 'err'); return; }
      cbMsg('変更内容を確認中…');
      const plan = await cbCall({
        action: 'dryRun', ...sel, recordIds: [...cbSelected],
        // 直前の操作をやり直す場合は同じ operationId を引き継ぐ（冪等な再開）
        operationId: cbLastOperationId || undefined,
      });
      if (!plan) {
        cbNotify('err', '付与内容を確認できませんでした', '条件・選択・管理シークレットを確認して、もう一度お試しください。');
        cbSync();
        return;
      }
      cbLastOperationId = plan.operationId;
      cbMsg('');
      // この確認が「どの条件・選択・特典に対するものか」を指紋で固定する
      cbState.dryRun = {
        fingerprint: cbFingerprint(),
        willGrant: plan.willGrant, selected: plan.selected, excluded: plan.skipped,
        activeMembers: (plan.audience && plan.audience.activeMembers) || 0,
        operationId: plan.operationId, audience: plan.audience || null,
      };
      cbState.dryStale = false;
      cbState.applied = false;
      // 確認モーダルは **Step 5 から明示的に開く**（dry-run では開かない）。
      // dry-run＝「確認」、Step 5＝「最終確認へ」、モーダル最終ボタン＝「本番付与」と
      // 段階を 1 対 1 に保つため、ここで書き込みボタン入りの画面を勝手に出さない。
      cbState.dryPlan = plan;
      cbState.drySel = sel;
      cbRenderReview({ ...plan, excluded: plan.skipped, audience: plan.audience });
      const active = (plan.audience && plan.audience.activeMembers) || 0;
      if (active > 0) {
        cbNotify('err', '現在有効な会員が含まれています', active + ' 名。対象から外すまで実行できません。');
      } else if ((plan.willGrant || 0) === 0) {
        cbNotify('warn', '付与される顧客がいません', '除外理由を確認してください。');
      } else {
        cbNotify('ok', '確認しました', plan.willGrant + ' 名へ付与します。実行はまだしていません。');
      }
      cbSync();
    });

    // ── Step 5: 付与内容の最終確認へ（**確認画面を開くだけ・書き込みは一切しない**）──
    //
    // 本番付与を呼ぶのは `cbRunApply()` ただ 1 つで、確認モーダルの最終ボタンからしか
    // 呼ばれない。Step 5 本体と追従バーは、どちらもこの関数で**同じ画面**を開くだけ。
    // 「赤いボタンが画面に複数あって、どれが本番なのか分からない」を構造的に無くす。
    function cbOpenApplyConfirm(opener) {
      const verdict = cbApi().canApply(cbState);
      if (!verdict.allowed) { cbNotify('warn', '最終確認へ進めません', verdict.reason || ''); return; }
      if (!cbState.dryPlan) {
        cbNotify('warn', '最終確認へ進めません', '先に「付与内容を確認」を押してください。');
        return;
      }
      cbModalOpener = opener || null;
      cbRenderConfirm(cbState.drySel || cbSelectionPayload(), cbState.dryPlan);
    }

    $('cbApplyBtn')?.addEventListener('click', () => cbOpenApplyConfirm($('cbApplyBtn')));

    // 追従バーはスクロール補助。Step 5 では本体と**同じ**確認画面を開き、
    // それ以外の段階では、いま操作すべきカードへ移動するだけ（書き込みは一切しない）。
    $('cbSbNext')?.addEventListener('click', () => {
      const step = cbApi().resolveCbStep(cbState);
      if (step === cbApi().CB_STEP.APPLY) { cbOpenApplyConfirm($('cbSbNext')); return; }
      const card = document.querySelector('.cb-step[data-cbcard="' + step + '"]');
      if (!card) return;
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card.querySelector('button:not([disabled]), select:not([disabled])')?.focus();
    });

    /**
     * 本番付与の**唯一の実行経路**（確認モーダルの最終ボタンからだけ呼ぶ）。
     *
     * - `operationId` は dry-run のものをそのまま使う（再実行しても二重付与しない）
     * - `planFingerprint` を必ず送る（対象が変わっていたら Function 側が 409 で中止する）
     * - 完了後はこの確認から再実行できないようにする
     * - 付与できた分の引き継ぎ票は、途中で止まった場合でも保持する（巻き戻さない）
     *
     * @param {HTMLButtonElement} btn 押された最終ボタン
     * @param {object} plan dry-run が返した計画
     * @param {object} sel 特典の選択内容
     */
    async function cbRunApply(btn, plan, sel) {
      btn.dataset.busy = '1';
      btn.disabled = true;
      btn.setAttribute('aria-disabled', 'true');
      btn.textContent = applyApi().APPLY_BUSY_LABEL;
      cbState.busy = true; cbSync();
      const res = await cbCallDetailed({
        action: 'apply', ...sel, recordIds: [...cbSelected],
        operationId: cbState.dryRun.operationId,   // dry-run と同じ ID（冪等）
        planFingerprint: plan.planFingerprint,     // 対象が変わっていたら Function 側が中止する
      });
      const out = res.ok ? res.data : null;
      cbState.busy = false; btn.dataset.busy = '';
      if (!out) {
        // 途中で止まっても、**書き込めた分**は取り消さずに引き継げるようにする
        const partial = res.data && res.data.handoff && res.data.handoff.canHandoff ? res.data.handoff : null;
        cbState.lastHandoff = partial;
        if (partial) {
          cbRenderApplyResult({ ...res.data, granted: partial.grantedCount });
          cbNotify('warn', '途中で止まりましたが、付与できた分は残っています',
            partial.grantedCount + ' 名は付与済みです（取り消していません）。'
            + '残りは「前回操作の突合」で確認し、同じ操作 ID で再実行してください。');
        } else {
          cbNotify('err', '付与に失敗しました', '結果を「前回操作の突合」で確認してください。');
        }
        btn.disabled = false;
        btn.removeAttribute('aria-disabled');
        btn.textContent = '再試行（同じ操作 ID で安全に再実行できます）';
        cbSync();
        return;
      }
      // 完了。**同じ確認からは二度と実行させない**
      cbState.applied = true;
      cbState.dryRun = null;
      cbState.dryPlan = null;
      // 付与結果に付いてきた引き継ぎ票を保持する（メール工程はこれだけを受け取る）
      cbState.lastHandoff = out.handoff || null;
      btn.textContent = applyApi().APPLY_DONE_LABEL;
      cbRenderApplyResult(out);
      cbCloseModal();
      if (out.offerTokens && out.offerTokens.length) cbRenderOfferTokens(out);
      const grantedNow = Number(out.granted ?? out.willGrant ?? 0);
      cbNotify('ok', grantedNow + ' 名の付与が完了しました。案内メール作成へ進みます',
        'メールはまだ送っていません。文面を確認してから送信します。');
      cbSync();

      // ── 付与成功者を**自動で**メール工程へ引き継ぐ ──────────────────
      // 運用者に operationId を探させない。渡すのは引き継ぎ票（人数と offerId だけ）で、
      // 対象そのものは送信のたびにサーバーが operationId から再導出する。
      // 1 名も付与できていなければ引き継がない（canHandoff=false）。
      if (out.handoff && out.handoff.canHandoff) {
        window.__mkHandoff.adopt(out.handoff);
      }
    }

    /** 実行結果（成功 / 除外 / 失敗 / operationId / 実行日時） */
    /** 区分バッジ（色 + 文言。色だけで意味を表さない） */
    function cbSegmentBadge(segment) {
      const el = document.createElement('span');
      const tone = {
        expired: 'tag-blue', withdrawn: 'tag-purple', dormant: 'tag-yellow',
        active_member: 'tag-red', unknown: 'tag-orange',
      }[segment] || 'tag-slate';
      el.className = 'tag ' + tone + ' seg-' + segment;
      el.textContent = cbApi().segmentLabel(segment);
      return el;
    }

    function cbRenderApplyResult(out) {
      const box = $('cbApplyResult');
      if (!box) return;
      box.innerHTML = '';
      const row = (k, v) => {
        const d = document.createElement('div'); d.className = 'dp-row';
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); box.appendChild(d);
      };
      box.className = 'dry-panel';
      const ho = out.handoff || null;
      const granted = Number(out.granted ?? out.applied ?? 0);
      row('付与できた人数', String(granted) + ' 名');
      row('付与できなかった人数', String(ho ? ho.notGrantedCount : (out.skipped ?? 0)) + ' 名');
      // 理由は**件数の集計だけ**（誰が該当したかは出さない）
      const reasons = (ho && ho.notGrantedReasons) || [];
      if (reasons.length) {
        row('付与できなかった理由', reasons.map((r) => (r.label || r.reason) + ' ' + r.count + ' 名').join(' / '));
      }
      row('失敗', String(out.failed ?? 0) + ' 名');
      row('操作 ID', String(out.operationId || cbLastOperationId || '—'));
      row('実行日時', fmtDate(new Date().toISOString()));
      row('変更しないもの', cbApi().UNCHANGED_NOTICE);
      row('メール', 'この操作でメールは送信されません（次の工程で作成します）');

      // ── 次工程への導線（付与できた人だけを引き継ぐ）──────────────
      const ops = document.createElement('div');
      ops.className = 'toolbar cb-handoff-ops';
      const go = document.createElement('button');
      go.type = 'button';
      go.className = 'btn-primary btn-lg';
      go.textContent = '✉️ 成功者へ案内メールを作成';
      const canGo = !!(ho && ho.canHandoff);
      go.disabled = !canGo;
      go.setAttribute('aria-disabled', String(!canGo));
      go.addEventListener('click', () => {
        if (go.dataset.busy === '1') return;       // 二重クリックで 2 回引き継がない
        go.dataset.busy = '1';
        const adopted = window.__mkHandoff.adopt(ho);
        if (!adopted) go.dataset.busy = '';
      });
      ops.appendChild(go);
      box.appendChild(ops);

      const hint = document.createElement('p');
      hint.className = 'note';
      hint.textContent = canGo
        ? '付与できた ' + granted + ' 名だけを引き継ぎます。顧客を選び直す必要はありません。'
          + '対象は送信のたびにサーバーが確定するため、付与できなかった顧客は含まれません。'
        : '付与できた顧客がいないため、案内メールの作成へは進めません。';
      box.appendChild(hint);
    }

    function cbRenderConfirm(sel, plan) {
      const body = cbOpenModal('付与内容の最終確認');

      const head = document.createElement('div'); head.className = 'dt-sec';
      const h = document.createElement('h3'); h.textContent = plan.selection;
      head.appendChild(h);
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '選択', plan.selected + ' 名');
      kvRow(dl, '無料特典を付与', plan.willGrant + ' 名', plan.willGrant > 0 ? 'strong-ok' : 'muted');
      if (plan.purchaseOffer) {
        kvRow(dl, '割引オファーを発行', plan.willOffer + ' 名', plan.willOffer > 0 ? 'strong-ok' : 'muted');
        kvRow(dl, '価格', '通常 ¥' + plan.purchaseOffer.regularPrice.toLocaleString()
          + ' → ¥' + plan.purchaseOffer.offerPrice.toLocaleString()
          + '（' + plan.purchaseOffer.discountPercent + '%OFF）');
        kvRow(dl, '権限', '付与しません（支払い完了後に既存の入金確認フローが昇格します）');
      }
      kvRow(dl, '対象外', plan.skipped + ' 名');
      kvRow(dl, '操作 ID', plan.operationId);
      head.appendChild(dl);
      body.appendChild(head);

      // 内訳（Light 何件 / Premium 何件 / オファー何件）
      const partsSec = document.createElement('div'); partsSec.className = 'dt-sec';
      const ph = document.createElement('h3'); ph.textContent = '内訳'; partsSec.appendChild(ph);
      const pul = document.createElement('ul'); pul.className = 'exlist';
      const parts = plan.parts || {};
      for (const [label, n] of [
        ['Light 無料を新規付与', parts.lightGrant || 0],
        ['Premium 無料を新規付与', parts.premiumGrant || 0],
        ['割引オファーを発行', parts.purchaseOffer || 0],
      ]) {
        const li = document.createElement('li');
        li.textContent = label + '　' + n + ' 名';
        pul.appendChild(li);
      }
      for (const d of (plan.partSkipDetail || [])) {
        const li = document.createElement('li');
        li.textContent = d.partLabel + ' は付与しない（' + d.label + '）　' + d.count + ' 名';
        pul.appendChild(li);
      }
      partsSec.appendChild(pul);
      body.appendChild(partsSec);

      if (plan.skippedDetail && plan.skippedDetail.length) {
        const sec = document.createElement('div'); sec.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '対象外の内訳'; sec.appendChild(h2);
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const d of plan.skippedDetail) {
          const li = document.createElement('li');
          li.textContent = d.label + '　' + d.count + ' 名';
          ul.appendChild(li);
        }
        sec.appendChild(ul);
        body.appendChild(sec);
      }

      if (plan.preview && plan.preview.length) {
        const sec = document.createElement('div'); sec.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '顧客ごとの変更（現在 → 付与後）'; sec.appendChild(h2);
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const p of plan.preview) {
          const li = document.createElement('li');
          const strong = document.createElement('strong');
          strong.textContent = p.email;
          li.appendChild(strong);
          const sub = document.createElement('ul'); sub.className = 'exlist sub';
          const l1 = document.createElement('li'); l1.textContent = '現在: ' + p.before; sub.appendChild(l1);
          const l2 = document.createElement('li'); l2.textContent = '付与後: ' + p.after; sub.appendChild(l2);
          if (p.offer) {
            const l3 = document.createElement('li');
            l3.textContent = '割引オファー: ' + p.offer + '（権限は付与されません）';
            sub.appendChild(l3);
          }
          for (const part of (p.partial || [])) {
            const l4 = document.createElement('li');
            l4.textContent = '※ ' + part.part + ' は付与しません（' + part.label + '）';
            sub.appendChild(l4);
          }
          li.appendChild(sub);
          ul.appendChild(li);
        }
        sec.appendChild(ul);
        if (plan.previewTruncated) {
          const note = document.createElement('p'); note.className = 'note';
          note.textContent = '※ 表示は先頭 50 名のみです（実行は対象全員に行われます）。';
          sec.appendChild(note);
        }
        body.appendChild(sec);
      }

      // ── ここから下だけが本番データを変更する ───────────────────────
      // 画面内で danger 色を持つボタンは**このボタン 1 つだけ**にする。
      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const h3 = document.createElement('h3'); h3.textContent = '本番データの変更'; sec3.appendChild(h3);

      // 何がどれだけ変わるかを 1 画面で（項目の並びは単一源が決める）
      const benefits = applyApi().describeBenefits({
        lightLabel: cbOfferLabel('cbLightOffer'), premiumLabel: cbOfferLabel('cbPremiumOffer'),
      });
      const sumDl = document.createElement('dl'); sumDl.className = 'kv';
      for (const r of applyApi().buildApplySummaryRows({
        plan, audience: plan.audience, benefits, unchangedNotice: cbApi().UNCHANGED_NOTICE,
      })) {
        kvRow(sumDl, r.label, r.value, r.tone === 'ok' ? 'strong-ok' : r.tone === 'ng' ? 'ng-txt' : '');
      }
      sec3.appendChild(sumDl);

      // 色だけに頼らず、文章でも「本番が変わる」ことを言う
      const writeNote = document.createElement('p'); writeNote.className = 'blocker';
      writeNote.textContent = '⚠️ ' + applyApi().APPLY_WRITE_NOTICE
        + '（顧客の閲覧権限が変わります。プラン・課金・入金状態・Premium Plus 販売資格は変更しません）';
      sec3.appendChild(writeNote);

      const effect = document.createElement('p'); effect.className = 'note';
      effect.textContent = cbApi().APPLY_EFFECT_NOTICE;
      sec3.appendChild(effect);
      const state = document.createElement('p'); state.className = 'note';
      state.textContent = plan.writeEnabled
        ? '押すと無料特典が即時に反映されます。'
        : applyApi().APPLY_BLOCK_LABEL[applyApi().APPLY_BLOCK.WRITE_DISABLED];
      sec3.appendChild(state);
      const mailNote = document.createElement('p'); mailNote.className = 'note';
      mailNote.textContent = '📪 ' + applyApi().APPLY_MAIL_NOTICE;
      sec3.appendChild(mailNote);
      const handoffNote = document.createElement('p'); handoffNote.className = 'note';
      handoffNote.textContent = '✉️ ' + applyApi().APPLY_HANDOFF_NOTICE;
      sec3.appendChild(handoffNote);

      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-immediate';
      const total = (plan.willGrant || 0) + (plan.willOffer || 0);
      const labelInput = {
        willGrant: plan.willGrant, willOffer: plan.willOffer,
        lightLabel: cbOfferLabel('cbLightOffer'), premiumLabel: cbOfferLabel('cbPremiumOffer'),
      };
      // 「実行する」ではなく、**何名に何をするのか**をボタン自身に書く
      btn.textContent = applyApi().buildApplyActionLabel(labelInput);
      btn.setAttribute('aria-label', applyApi().buildApplyActionAriaLabel(labelInput));
      btn.disabled = !plan.writeEnabled || total === 0;
      if (btn.disabled) btn.setAttribute('aria-disabled', 'true');
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;      // 二重クリック（Enter 連打）防止
        const run = applyApi().canRunApply({
          writeEnabled: plan.writeEnabled, willGrant: plan.willGrant, willOffer: plan.willOffer,
          busy: cbState.busy, applied: cbState.applied,
        });
        if (!run.allowed) { cbNotify('warn', '付与できません', run.label); return; }
        const ok = window.confirm(
          plan.selection + '\n\n'
          + '対象: ' + plan.selected + ' 名\n'
          + '無料特典を付与: ' + plan.willGrant + ' 名\n'
          + '割引オファーを発行: ' + plan.willOffer + ' 名\n'
          + '対象外: ' + plan.skipped + ' 名\n\n'
          + 'この内容で付与しますか？（メールは送信されません）'
        );
        if (!ok) return;
        const typed = window.prompt('確認のため、付与予定人数「' + plan.willGrant + '」を入力してください') || '';
        if (String(typed).trim() !== String(plan.willGrant)) {
          cbNotify('warn', '付与を中止しました', '入力が一致しませんでした。');
          return;
        }
        // 本番付与はここ 1 か所からしか呼ばない
        await cbRunApply(btn, plan, sel);
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    }

    /** 発行した専用 URL（生トークンはこの応答にしか無い） */
    function cbRenderOfferTokens(out) {
      const body = cbOpenModal('発行した専用 URL');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const note = document.createElement('p'); note.className = 'note';
      note.textContent = 'この URL は対象のお客様だけが利用できます（署名付き・メールアドレス一致が必要）。'
        + '台帳にはハッシュしか保存されないため、この画面を閉じると再表示できません。';
      sec.appendChild(note);
      const ul = document.createElement('ul'); ul.className = 'exlist';
      for (const t of out.offerTokens) {
        const li = document.createElement('li');
        li.textContent = t.url + '（〜' + String(t.expiresAt).slice(0, 10) + '）';
        ul.appendChild(li);
      }
      sec.appendChild(ul);
      body.appendChild(sec);
    }

    // ── 取り消し（無料権利だけ）──
    $('cbRevokeBtn').addEventListener('click', async () => {
      if (cbSelected.size === 0) { cbMsg('取り消す対象を選択してください', 'err'); return; }
      const tiers = [];
      if (window.confirm('Light の無料権利を取り消しますか？\n（キャンセルすると Premium だけを対象にします）')) {
        tiers.push('light');
      }
      if (window.confirm('Premium の無料権利を取り消しますか？')) tiers.push('premium');
      if (tiers.length === 0) { cbMsg('取り消す特典が選択されていません', 'err'); return; }
      const reason = window.prompt('取り消し理由（管理者メモ・任意）') || '';

      const plan = await cbCall({
        action: 'revokeDryRun', tiers, recordIds: [...cbSelected], reason,
      });
      if (!plan) return;

      const body = cbOpenModal('取り消し内容の確認');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '対象', (plan.tierLabels || []).join(' / '));
      kvRow(dl, '選択', plan.selected + ' 名');
      kvRow(dl, '取り消し', plan.willRevoke + ' 名', plan.willRevoke > 0 ? 'strong-ok' : 'muted');
      kvRow(dl, '対象外', plan.skipped + ' 名');
      sec.appendChild(dl);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = plan.notice || '';
      sec.appendChild(note);
      body.appendChild(sec);

      if (plan.preview && plan.preview.length) {
        const sec2 = document.createElement('div'); sec2.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '顧客ごとの変更'; sec2.appendChild(h2);
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const p of plan.preview) {
          const li = document.createElement('li');
          li.textContent = p.email + '　' + p.before + ' → ' + p.after;
          ul.appendChild(li);
        }
        sec2.appendChild(ul);
        body.appendChild(sec2);
      }

      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-blocked';
      btn.textContent = plan.willRevoke + ' 名の無料特典を取り消す';
      btn.disabled = !cbWriteEnabled || plan.willRevoke === 0;
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;
        if (!window.confirm('無料特典を取り消します。有料契約・三連複買い切り・発行済みオファーは変わりません。よろしいですか？')) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        const out = await cbCall({
          action: 'revoke', tiers, recordIds: [...cbSelected],
          planFingerprint: plan.planFingerprint, reason,
        });
        btn.dataset.busy = '';
        if (out) {
          cbMsg('取り消しました: ' + out.revoked + ' 名', 'ok');
          cbSelected.clear();
          cbCloseModal();
          await cbLoad();
        } else {
          btn.disabled = false;
        }
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    });

    // ── 発行済み割引オファーの取り消し（PromotionalOffers の 1 行だけ）──
    //   無料特典の取り消し（cbRevokeBtn）とは別経路。権限・課金は 1 バイトも動かない。
    //   PII / token / TokenHash は API が返さないので、画面にも出ない。
    const OFFER_STATUS_LABEL = {
      issued: '発行済み', redeemed: '申込済み', expired: '期限切れ', revoked: '取り消し済み',
    };
    const TIER_LABEL = { premium: 'Premium', light: 'Light' };
    const TERM_LABEL = { annual: '年額', monthly: '月額', lifetime: '買い切り' };
    const yen = (n) => '¥' + Number(n || 0).toLocaleString();

    async function cbOfferLoad() {
      cbMsg('発行済みオファーを読み込み中…');
      const data = await cbCall({ action: 'offerList' });
      if (!data) return;
      cbMsg('');
      const tb = $('cbOfferRows');
      tb.innerHTML = '';
      for (const r of (data.rows || [])) {
        const tr = document.createElement('tr');
        if (!r.canRevoke) tr.className = 'row-suppressed';
        tr.appendChild(td('', 'オファー種別', r.offerId));
        tr.appendChild(td('', '対象', TIER_LABEL[r.targetTier] || r.targetTier));
        tr.appendChild(td('', '期間', TERM_LABEL[r.billingTerm] || r.billingTerm));
        tr.appendChild(td('', '通常価格', yen(r.regularPrice)));
        tr.appendChild(td('', 'オファー価格', yen(r.offerPrice)));
        tr.appendChild(td('', '状態', OFFER_STATUS_LABEL[r.status] || r.status,
          r.status === 'issued' ? 'ok-txt' : 'muted'));
        tr.appendChild(td('', '有効期限', String(r.expiresAt || '').slice(0, 10)));

        const cOps = document.createElement('td');
        // 誤操作防止: redeemed / expired / revoked にはボタン自体を出さない
        if (r.canRevoke) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn-ghost';
          btn.textContent = '取り消す';
          btn.addEventListener('click', () => cbOfferRevokeStart(r));
          cOps.appendChild(btn);
        } else {
          const sp = document.createElement('span');
          sp.className = 'muted';
          sp.textContent = '—';
          cOps.appendChild(sp);
        }
        tr.appendChild(cOps);
        tb.appendChild(tr);
      }
      const c = data.counts || {};
      $('cbOfferCount').textContent = '合計 ' + (data.total || 0) + ' 件'
        + '（発行済み ' + (c.issued || 0) + '・申込済み ' + (c.redeemed || 0)
        + '・期限切れ ' + (c.expired || 0) + '・取り消し済み ' + (c.revoked || 0) + '）'
        + (data.truncated ? ' ※一部のみ表示' : '');
      const emp = $('cbOfferEmpty');
      emp.hidden = (data.rows || []).length > 0;
      emp.textContent = '発行済みのオファーはありません。';
    }
    $('cbOfferLoad').addEventListener('click', cbOfferLoad);

    /** 手順: dry-run（対象確認）→ 最終実行。いきなり書き込まない。 */
    async function cbOfferRevokeStart(row) {
      const reason = window.prompt('取り消し理由（管理者メモ・任意）') || '';
      const plan = await cbCall({
        action: 'offerRevokeDryRun',
        offerRecordId: row.offerRecordId,
        // 対象の取り違えを Function 側でも検証させる
        operationId: row.operationId,
        customerRecordId: row.customerRecordId,
        offerKey: row.offerKey,
        reason,
      });
      if (!plan) return;

      const o = plan.offer || {};
      const body = cbOpenModal('割引オファーの取り消し');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, 'オファー種別', o.offerId);
      kvRow(dl, '対象', TIER_LABEL[o.targetTier] || o.targetTier);
      kvRow(dl, '期間', TERM_LABEL[o.billingTerm] || o.billingTerm);
      kvRow(dl, '通常価格', yen(o.regularPrice));
      kvRow(dl, 'オファー価格', yen(o.offerPrice), 'strong-ok');
      kvRow(dl, '状態', OFFER_STATUS_LABEL[o.status] || o.status);
      kvRow(dl, '有効期限', String(o.expiresAt || '').slice(0, 10));
      kvRow(dl, '操作 ID', o.operationId);
      kvRow(dl, '書き込む項目', (plan.willWriteFields || []).join(' / '));
      sec.appendChild(dl);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = plan.notice || '';
      sec.appendChild(note);
      body.appendChild(sec);

      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const h3 = document.createElement('h3'); h3.textContent = '取り消しの実行'; sec3.appendChild(h3);
      const warn = document.createElement('p'); warn.className = 'note';
      warn.textContent = '取り消すと専用 URL は使えなくなります。閲覧権・課金契約・入金状態・メールは変わりません。';
      sec3.appendChild(warn);

      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-blocked';
      btn.textContent = 'このオファーを取り消す';
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;
        if (!window.confirm('このオファーを取り消します。よろしいですか？\n（顧客の権限・課金は変わりません）')) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        btn.textContent = '取り消し中…';
        const out = await cbCall({
          action: 'offerRevoke',
          offerRecordId: o.offerRecordId,
          operationId: o.operationId,
          customerRecordId: o.customerRecordId,
          offerKey: o.offerKey,
          offerFingerprint: plan.offerFingerprint,  // 状態が動いていたら Function 側が 409 で止める
          reason,
        });
        btn.dataset.busy = '';
        if (out) {
          cbMsg(out.notice || 'オファーを取り消しました', 'ok');
          cbCloseModal();
          await cbOfferLoad();
        } else {
          btn.textContent = '再試行（もう一度 dry-run からやり直してください）';
          btn.disabled = false;
        }
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    }

    // ── 前回操作の突合（read-only）──
    $('cbReconcileBtn').addEventListener('click', async () => {
      const op = window.prompt('突合する操作 ID', cbLastOperationId || '') || '';
      if (!op.trim()) return;
      const data = await cbCall({
        action: 'reconcile', operationId: op.trim(),
        recordIds: cbSelected.size ? [...cbSelected] : undefined,
      });
      if (!data) return;
      const body = cbOpenModal('前回操作の突合');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '操作 ID', data.operationId);
      kvRow(dl, '確認した顧客', data.total + ' 名');
      kvRow(dl, '適用済み', data.applied + ' 名', 'strong-ok');
      kvRow(dl, '未適用', data.missing + ' 名', data.missing > 0 ? 'ng-txt' : 'muted');
      sec.appendChild(dl);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec.appendChild(note);
      body.appendChild(sec);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$('cbBackdrop').hidden) cbCloseModal();
    });

    $('mkRehandoffBtn')?.addEventListener('click', mkRehandoff);
    $('mkRecoverBtn')?.addEventListener('click', mkRecoverLatestHandoff);

    /**
     * bridge（`window.__cb*` / `window.__mk*`）が揃ってから走らせる初期化。
     *
     * ⚠️ **この画面は 2 種類の script でできている**:
     *   `<script>`（ES module）… 判定モジュールを import して `window.__*` へ橋渡しする。**defer 実行**
     *   `<script is:inline>`（classic）… UI 本体。**解析時に即実行**
     *
     * つまり inline の末尾で `window.__cbHandoff` を触ると **必ず undefined** になる。
     * 実際、本番で初期化が
     *   TypeError: Cannot read properties of undefined (reading 'loadHandoff')
     * で止まり、**再読み込み時の引き継ぎ復元と引き継ぎ復旧バーの表示が動いていなかった**。
     *
     * module script は `DOMContentLoaded` より前に実行されるので、ここで待てば必ず揃う。
     * 既に発火済みでも動くよう readyState を見てから登録する。
     */
    function mkAfterBridgesReady(fn) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fn, { once: true });
      } else {
        fn();
      }
    }

    mkAfterBridgesReady(() => {
      // 画面を読み込み直しても、同じタブなら引き継ぎは続く（期限切れ・使用済みは復元しない）
      mkHandoffRestore();
      // セグメントの選択肢はサーバーの定義をそのまま出す（画面で条件を組み立てない）
      mkSegInit().catch(() => {});
    });
  })();
</script>
