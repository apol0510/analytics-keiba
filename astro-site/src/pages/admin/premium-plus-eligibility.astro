---
export const prerender = true;
// 認可: この画面は /admin/* の Basic-Auth（Edge Function）背後。POST は x-admin-secret を
// premium-plus-eligibility Function 側で検証する。secret はこのタブ限定（sessionStorage）。
//
// この画面が変更するのは **Premium Plus の販売資格だけ**。
// プラン / Status / 有効期限 / LifetimeSanrenpuku / メール状態は一切変更しない。
// 資格変更でメール送信・課金・昇格は起きない（表示資格のみ）。
//
// 2026-07-30: UI を「管理テーブル + 詳細操作パネル」型へ再設計（表示のみ）。
//   - 一覧は 1 行 1 顧客のテーブル。**write ボタンは一覧に出さない**
//   - write は詳細パネル内だけで行う（誤操作防止）
//   - 管理 Function の write 契約（action='update' の payload）と preview の
//     read-only 契約は不変
//
// ⚠️ style は必ず `is:global` + `.ppe` 名前空間で書くこと。
//    Astro の scoped style は `.cust[data-astro-cid-xxx]` へ変換されるため、
//    JS で生成する行・バッジ・ボタンには **一切適用されない**（2026-07-30 に本番で発生）。
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="AK 顧客販売・マーケティング管理（管理）">
  <div class="ppe">
    <header class="ppe-head">
      <div class="ppe-head-l">
        <h1>AK 顧客販売・マーケティング管理</h1>
        <p class="lead">
          <b>Premium Plus 販売資格</b>と<b>マーケティング対象</b>は別概念です。
          期限切れ会員はキャンペーンの対象にできますが、販売資格へは自動で入りません。
        </p>
      </div>
      <div class="ppe-head-r">
        <span class="conn-pill" id="connState">● 未接続</span>
        <button type="button" id="connToggle" class="btn-ghost">管理接続設定</button>
        <button type="button" id="reload" class="btn-primary">再読み込み</button>
      </div>
    </header>

    <div class="conn-body" id="connBody" hidden>
      <label for="secret">管理シークレット（PREMIUM_PLUS_ADMIN_SECRET・このタブのみ保持）</label>
      <input type="password" id="secret" placeholder="Netlify に設定した値" autocomplete="off" />
      <p class="note" id="writeState"></p>
    </div>

    <nav class="tabs" role="tablist">
      <button type="button" class="tab on" id="tabSales" role="tab" aria-selected="true">💠 Premium Plus 販売</button>
      <button type="button" class="tab" id="tabMkt" role="tab" aria-selected="false">📣 顧客マーケティング</button>
      <button type="button" class="tab" id="tabCb" role="tab" aria-selected="false">🎁 カムバック特典</button>
    </nav>

    <!-- ═══ タブ1: Premium Plus 販売資格（既存の安全設計を維持）═══ -->
    <section id="paneSales">
    <p class="pane-lead">
      販売してよい会員を <b>管理者が手動で選別</b>します。候補は自動で「販売可」になりません。
      変更されるのは <b>Premium Plus の表示資格だけ</b>で、プラン・有効期限・メール・課金には影響しません。
    </p>

    <div class="sumbar" id="summary"></div>
    <div class="sumsub" id="summarySub"></div>

    <div class="toolbar">
      <input type="search" id="q" placeholder="Email で検索" autocomplete="off" aria-label="Email 検索" />
      <select id="fState" aria-label="状態で絞り込み">
        <option value="all">すべての状態</option>
        <option value="review">保留</option>
        <option value="eligible">販売可（段階公開中・販売中）</option>
        <option value="immediate">即時販売</option>
        <option value="blocked">販売対象外</option>
      </select>
      <select id="fRoute" aria-label="Route で絞り込み">
        <option value="all">すべての Route</option>
        <option value="sanrenpuku">ROUTE A（三連複）</option>
        <option value="premium_30d">ROUTE B（Premium 30日）</option>
      </select>
      <select id="fKind" aria-label="候補区分で絞り込み">
        <option value="all">すべての区分</option>
        <option value="waiting_30d">ROUTE B 待機中</option>
        <option value="anchor_missing">加入日データなし</option>
      </select>
      <label class="chk"><input type="checkbox" id="onlyReview" /> 保留のみ再取得</label>
    </div>

    <p class="msg" id="message"></p>
    <p class="count" id="count"></p>

    <div class="tablewrap">
      <table class="tbl">
        <thead>
          <tr>
            <th class="c-cust">顧客</th>
            <th class="c-state">状態</th>
            <th class="c-plan">プラン</th>
            <th class="c-route">Route</th>
            <th class="c-kind">区分</th>
            <th class="c-phase">PHASE</th>
            <th class="c-eligible">販売許可日</th>
            <th class="c-updated">最終更新</th>
            <th class="c-ops">操作</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
      <p class="empty" id="empty" hidden></p>
    </div>
    </section>

    <!-- ═══ タブ2: 顧客マーケティング（AK 独自機能 / KMA とは統合しない）═══ -->
    <section id="paneMkt" hidden>
      <p class="pane-lead">
        契約状態を横断して顧客を選び、キャンペーンメールを送ります。
        <b>この画面はプラン・有効期限・権限・Premium Plus 販売資格を一切変更しません。</b>
        メールを送っても会員権限は復活しません。
      </p>

      <div class="sumbar" id="mkSummary"></div>
      <div class="sumsub" id="mkSummarySub"></div>
      <p class="note" id="mkSendState"></p>

      <div class="toolbar">
        <input type="search" id="mkQ" placeholder="Email で検索" autocomplete="off" aria-label="Email 検索" />
        <select id="mkContract" aria-label="契約状態">
          <option value="all">契約状態: すべて</option>
          <option value="active">有効</option>
          <option value="expiring_soon">期限間近</option>
          <option value="expired">期限切れ</option>
          <option value="unknown">不明（legacy）</option>
          <option value="none">契約なし（Free）</option>
        </select>
        <select id="mkPlan" aria-label="プラン">
          <option value="all">プラン: すべて</option>
          <option value="premium_sanrenpuku">Premium Sanrenpuku</option>
          <option value="premium">Premium</option>
          <option value="light">Light</option>
          <option value="free">Free</option>
        </select>
        <select id="mkSendable" aria-label="マーケティング">
          <option value="all">送信可否: すべて</option>
          <option value="sendable">送信可能</option>
          <option value="suppressed">送信除外</option>
        </select>
        <select id="mkPp" aria-label="Premium Plus 資格">
          <option value="all">Plus 資格: すべて</option>
          <option value="eligible">販売可</option>
          <option value="review">保留</option>
          <option value="blocked">販売対象外</option>
          <option value="unset">未設定</option>
        </select>
        <select id="mkHistory" aria-label="送信履歴">
          <option value="all">送信履歴: すべて</option>
          <option value="never">未送信</option>
          <option value="recent">最近送信済み</option>
          <option value="sent">送信あり</option>
        </select>
        <button type="button" id="mkLoad" class="btn-primary">この条件で取得</button>
      </div>

      <div class="selbar">
        <button type="button" id="mkSelAll" class="btn-ghost">表示中を全選択</button>
        <button type="button" id="mkSelNone" class="btn-ghost">全解除</button>
        <span class="selcount" id="mkSelCount">0 名を選択中</span>
      </div>

      <p class="msg" id="mkMessage"></p>
      <p class="count" id="mkCount"></p>

      <div class="tablewrap">
        <table class="tbl">
          <thead>
            <tr>
              <th class="c-chk"><span class="sr">選択</span></th>
              <th class="c-cust">顧客</th>
              <th class="c-contract">契約</th>
              <th class="c-plan">プラン</th>
              <th class="c-send">送信</th>
              <th class="c-pp">Plus</th>
              <th class="c-hist">送信履歴</th>
            </tr>
          </thead>
          <tbody id="mkRows"></tbody>
        </table>
        <p class="empty" id="mkEmpty" hidden></p>
      </div>

      <div class="campaign-box">
        <h2>キャンペーン</h2>
        <div class="toolbar">
          <select id="mkCampaign" aria-label="キャンペーン"></select>
          <button type="button" id="mkPreview" class="btn-ghost">本文プレビュー</button>
          <button type="button" id="mkDryRun" class="btn-primary">送信対象を確認（dry-run）</button>
          <button type="button" id="mkHistoryBtn" class="btn-ghost">送信履歴</button>
        </div>
        <p class="camp-desc" id="mkCampDesc"></p>
      </div>
    </section>

    <!-- ═══ タブ3: カムバック特典（無料 entitlement の付与 / メールとは別機能）═══ -->
    <section id="paneCb" hidden>
      <p class="pane-lead">
        以前 AK を離れた顧客へ<b>無料特典</b>を付与します。変更されるのは<b>特典専用フィールドだけ</b>で、
        プラン・有効期限・入金状態・三連複買い切り・Premium Plus 販売資格は一切変更しません。
        <b>この操作でメールは送信されません。</b>案内は付与後にマーケティングタブから別途送ってください。
      </p>

      <div class="sumbar" id="cbSummary"></div>
      <div class="sumsub" id="cbSummarySub"></div>
      <p class="note" id="cbGateState"></p>

      <div class="toolbar">
        <input type="search" id="cbQ" placeholder="Email で検索" autocomplete="off" aria-label="Email 検索" />
        <select id="cbContract" aria-label="契約状態">
          <option value="all">契約状態: すべて</option>
          <option value="expired">期限切れ</option>
          <option value="expiring_soon">期限間近</option>
          <option value="active">有効</option>
          <option value="unknown">不明（legacy）</option>
          <option value="none">契約なし（Free）</option>
        </select>
        <select id="cbPlan" aria-label="プラン">
          <option value="all">プラン: すべて</option>
          <option value="premium_sanrenpuku">Premium Sanrenpuku</option>
          <option value="premium">Premium</option>
          <option value="light">Light</option>
          <option value="free">Free</option>
        </select>
        <select id="cbWithdrawn" aria-label="退会履歴">
          <option value="all">退会履歴: すべて</option>
          <option value="yes">退会あり</option>
          <option value="no">退会なし</option>
        </select>
        <select id="cbPromo" aria-label="現在の特典">
          <option value="all">現在の特典: すべて</option>
          <option value="none">特典なし</option>
          <option value="any">特典あり</option>
          <option value="light_lifetime">Light 永久無料</option>
          <option value="trial_active">Premium 無料期間中</option>
          <option value="trial_expired">Premium 無料 終了</option>
          <option value="inconsistent">⚠️ 特典データ不整合</option>
        </select>
        <select id="cbGrantable" aria-label="付与可否">
          <option value="all">付与可否: すべて</option>
          <option value="grantable">付与できる</option>
          <option value="blocked">付与できない</option>
        </select>
        <select id="cbHistory" aria-label="送信履歴">
          <option value="all">送信履歴: すべて</option>
          <option value="never">未送信</option>
          <option value="recent">最近送信済み</option>
          <option value="sent">送信あり</option>
        </select>
        <button type="button" id="cbLoad" class="btn-primary">この条件で取得</button>
      </div>

      <div class="selbar">
        <button type="button" id="cbSelAll" class="btn-ghost">表示中を全選択</button>
        <button type="button" id="cbSelNone" class="btn-ghost">全解除</button>
        <span class="selcount" id="cbSelCount">0 名を選択中</span>
      </div>

      <p class="msg" id="cbMessage"></p>
      <p class="count" id="cbCount"></p>

      <div class="tablewrap">
        <table class="tbl">
          <thead>
            <tr>
              <th class="c-chk"><span class="sr">選択</span></th>
              <th class="c-cust">顧客</th>
              <th class="c-contract">契約</th>
              <th class="c-plan">プラン</th>
              <th class="c-promo">現在の特典</th>
              <th class="c-grantable">付与可否</th>
            </tr>
          </thead>
          <tbody id="cbRows"></tbody>
        </table>
        <p class="empty" id="cbEmpty" hidden></p>
      </div>

      <div class="campaign-box">
        <h2>特典の内容</h2>

        <div class="offer-row">
          <label class="offer-label" for="cbLightOffer">Light 特典（ベース）</label>
          <select id="cbLightOffer" aria-label="Light 特典"></select>
          <label class="offer-sub" for="cbLightDays" id="cbLightDaysWrap" hidden>
            日数
            <input type="number" id="cbLightDays" min="1" max="3650" step="1" value="30" />
          </label>
        </div>
        <p class="offer-note">Light は<b>メイン買い目のみ閲覧できる独立プラン</b>です（Premium 終了後の代替ではありません）。</p>

        <div class="offer-row">
          <label class="offer-label" for="cbPremiumOffer">Premium 特典（上位・任意）</label>
          <select id="cbPremiumOffer" aria-label="Premium 特典"></select>
          <label class="offer-sub" for="cbPremiumDays" id="cbPremiumDaysWrap" hidden>
            日数
            <input type="number" id="cbPremiumDays" min="1" max="3650" step="1" value="30" />
          </label>
          <label class="offer-sub" for="cbPremiumPrice" id="cbPremiumPriceWrap" hidden>
            特別価格（円）
            <input type="number" id="cbPremiumPrice" min="1000" step="100" value="24900" />
          </label>
        </div>

        <div class="price-box" id="cbPriceBox" hidden>
          <dl class="kv" id="cbPriceKv"></dl>
        </div>

        <div class="toolbar">
          <button type="button" id="cbPreviewBtn" class="btn-ghost">案内文面プレビュー</button>
          <button type="button" id="cbDryRun" class="btn-primary">変更内容を確認（dry-run）</button>
          <button type="button" id="cbRevokeBtn" class="btn-ghost">無料特典を取り消す</button>
          <button type="button" id="cbReconcileBtn" class="btn-ghost">前回操作の突合</button>
        </div>
        <p class="camp-desc" id="cbOfferDesc"></p>
      </div>
    </section>

    <!-- カムバック特典: dry-run / 取り消し 確認モーダル -->
    <div id="cbBackdrop" class="dt-backdrop" hidden>
      <aside class="dt-panel" role="dialog" aria-modal="true" aria-labelledby="cbModalTitle">
        <div class="dt-head">
          <div class="dt-head-l">
            <button type="button" id="cbModalBack" class="btn-back">← 一覧へ戻る</button>
            <h2 id="cbModalTitle">確認</h2>
          </div>
          <button type="button" id="cbModalClose" class="x" aria-label="閉じる">×</button>
        </div>
        <div id="cbModalBody" class="dt-body"></div>
      </aside>
    </div>

    <!-- マーケティング: 本文プレビュー / dry-run 確認 モーダル -->
    <div id="mkBackdrop" class="dt-backdrop" hidden>
      <aside class="dt-panel" role="dialog" aria-modal="true" aria-labelledby="mkModalTitle">
        <div class="dt-head">
          <div class="dt-head-l">
            <button type="button" id="mkModalBack" class="btn-back">← 一覧へ戻る</button>
            <h2 id="mkModalTitle">確認</h2>
          </div>
          <button type="button" id="mkModalClose" class="x" aria-label="閉じる">×</button>
        </div>
        <div id="mkModalBody" class="dt-body"></div>
      </aside>
    </div>

    <!-- 詳細・操作パネル（write はここだけ） -->
    <div id="dtBackdrop" class="dt-backdrop" hidden>
      <aside class="dt-panel" id="dtPanel" role="dialog" aria-modal="true" aria-labelledby="dtTitle">
        <div class="dt-head">
          <div class="dt-head-l">
            <button type="button" id="dtBack" class="btn-back">← 一覧へ戻る</button>
            <h2 id="dtTitle">詳細・操作</h2>
          </div>
          <button type="button" id="dtClose" class="x" aria-label="閉じる">×</button>
        </div>
        <div id="dtBody" class="dt-body"></div>
      </aside>
    </div>

    <!-- 管理者プレビュー モーダル（read-only。実顧客セッションは作らない） -->
    <div id="pvBackdrop" class="pv-backdrop" hidden>
      <div class="pv-modal" role="dialog" aria-modal="true" aria-labelledby="pvTitle">
        <div class="pv-head">
          <div class="pv-head-l">
            <button type="button" id="pvBack" class="btn-back">← 詳細へ戻る</button>
            <h2 id="pvTitle">表示プレビュー</h2>
          </div>
          <button type="button" id="pvClose" class="x" aria-label="閉じる">×</button>
        </div>
        <p class="pv-notice">管理者プレビュー / 実顧客には影響しません（読み取りのみ・ログインもメール送信もしません）</p>
        <div class="pv-controls">
          <label class="ctl-main" for="pvPhase">段階公開の表示確認（PHASE 1〜4）
            <select id="pvPhase"></select>
          </label>
          <label for="pvTime">受付時刻のシミュレーション
            <select id="pvTime"></select>
          </label>
        </div>
        <p class="pv-hint" id="pvHint" hidden></p>
        <div class="pv-scroll" id="pvScroll">
          <div id="pvBody" class="pv-body"></div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* ⚠️ is:global 必須。scoped だと JS 生成 DOM に適用されない。全セレクタを .ppe 配下へ。 */
  .ppe {
    --nv-0: #0b1120;      /* 最暗（入力欄の背景） */
    --nv-1: #0d1729;      /* パネル */
    --nv-2: #111c33;      /* カード / 既定ボタン */
    --nv-3: #1b2a47;      /* ボタン hover */
    --line: rgba(148,163,184,.18);
    --line-2: rgba(96,165,250,.28);   /* 薄いブルー系 border */
    --ink: #e6edf7;
    --ink-2: #cbd5e6;
    --muted: #93a4bd;
    --gold: #f5c451;
    --gold-2: #d99b1f;
    --green: #34d399;
    --green-dk: #05261a;
    --red: #f87171;
    max-width: 1180px; margin: 0 auto; padding: 1.4rem 1rem 5rem; color: var(--ink);
  }

  /* ── ブラウザ標準の白 UI を出さないための既定値 ──────────────
     button / select / input / textarea は必ずダークネイビー系。
     白背景へ戻さない（disabled も同様）。 */
  .ppe button,
  .ppe select,
  .ppe input,
  .ppe textarea {
    font-family: inherit;
    color: var(--ink);
    background-color: var(--nv-2);
    border: 1px solid var(--line-2);
    border-radius: 9px;
    transition: background-color .15s ease, border-color .15s ease, box-shadow .15s ease, opacity .15s ease;
  }
  .ppe button { cursor: pointer; box-shadow: 0 1px 0 rgba(255,255,255,.04) inset; }
  .ppe button:hover:not([disabled]) { background-color: var(--nv-3); border-color: rgba(96,165,250,.45); }
  .ppe button[disabled] { opacity: .42; cursor: not-allowed; background-color: var(--nv-2); box-shadow: none; }
  .ppe button:focus-visible,
  .ppe select:focus-visible,
  .ppe input:focus-visible { outline: 2px solid rgba(245,196,81,.6); outline-offset: 1px; }
  .ppe select,
  .ppe input[type=search],
  .ppe input[type=password],
  .ppe input[type=text] { background-color: var(--nv-0); }
  .ppe input::placeholder { color: #64748b; }
  /* select は標準の白い矢印を消して自前のシェブロンに差し替える */
  .ppe select {
    appearance: none; -webkit-appearance: none; -moz-appearance: none;
    padding-right: 1.9rem;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' stroke='%2393a4bd' stroke-width='1.6' fill='none' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right .65rem center;
  }
  .ppe select option { background-color: var(--nv-1); color: var(--ink); }
  /* checkbox はブラウザ実装を活かしつつ色だけ AK に寄せる */
  .ppe input[type=checkbox] { accent-color: var(--gold); background-color: transparent; border: 0; width: 15px; height: 15px; }

  /* ── ヘッダ / 管理接続 ── */
  .ppe .ppe-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; margin-bottom: 1rem; }
  .ppe .ppe-head h1 { font-size: 1.3rem; margin: 0 0 .4rem; }
  .ppe .lead { color: #93a4bd; font-size: .8rem; line-height: 1.75; margin: 0; max-width: 66ch; }
  .ppe .ppe-head-r { display: flex; align-items: center; gap: .5rem; flex: 0 0 auto; flex-wrap: wrap; }
  .ppe .conn-pill { font-size: .74rem; padding: .25rem .7rem; border-radius: 999px; background: rgba(148,163,184,.16); color: #93a4bd; white-space: nowrap; }
  .ppe .conn-pill.ok { background: rgba(52,211,153,.14); color: #34d399; }
  .ppe .btn-ghost { background-color: var(--nv-2); color: var(--ink-2); border-color: var(--line-2); padding: .42rem .85rem; font-size: .78rem; }
  .ppe .btn-primary { background: linear-gradient(180deg, #24406e, #1b2f52); color: #dbeafe; border-color: rgba(96,165,250,.5); padding: .45rem 1.05rem; font-weight: 800; font-size: .8rem; }
  .ppe .btn-primary:hover:not([disabled]) { background: linear-gradient(180deg, #2b4d84, #223a63); border-color: rgba(96,165,250,.7); }
  .ppe .conn-body { background: #111c33; border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .9rem 1rem; margin-bottom: 1rem; }
  .ppe .conn-body[hidden] { display: none; }
  .ppe .conn-body label { display: block; font-size: .74rem; color: #93a4bd; margin-bottom: .3rem; }
  .ppe .conn-body input { width: 100%; max-width: 440px; padding: .5rem .7rem; }
  .ppe .note { font-size: .72rem; color: #93a4bd; margin: .55rem 0 0; }

  /* ── サマリーバー（1 行・クリックでフィルター）── */
  .ppe .sumbar { display: flex; align-items: center; gap: .2rem; flex-wrap: wrap; background: #111c33; border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .5rem .7rem; margin-bottom: .5rem; }
  .ppe .sumbar .s { display: flex; align-items: baseline; gap: .35rem; padding: .2rem .7rem; background-color: transparent; border-color: transparent; box-shadow: none; color: inherit; }
  .ppe .sumbar .s:hover:not([disabled]) { background-color: rgba(96,165,250,.12); border-color: transparent; }
  .ppe .sumbar .s .k { font-size: .74rem; color: #93a4bd; }
  .ppe .sumbar .s .v { font-size: 1.05rem; font-weight: 900; }
  .ppe .sumbar .s.immediate .v { color: #f5c451; }
  .ppe .sumbar .s.eligible .v { color: #34d399; }
  .ppe .sumbar .s.review .v { color: #60a5fa; }
  .ppe .sumbar .s.blocked .v { color: #f87171; }
  .ppe .sumbar .sep { color: rgba(148,163,184,.35); }
  .ppe .sumsub { font-size: .74rem; color: #93a4bd; margin-bottom: 1rem; padding-left: .3rem; }

  /* ── ツールバー ── */
  .ppe .toolbar { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-bottom: .8rem; }
  .ppe .toolbar input[type=search] { flex: 1 1 260px; min-width: 200px; height: 34px; padding: 0 .7rem; font-size: .82rem; }
  .ppe .toolbar select { height: 34px; padding: 0 1.9rem 0 .7rem; font-size: .8rem; }
  .ppe .chk { display: flex; align-items: center; gap: .35rem; font-size: .76rem; color: #93a4bd; white-space: nowrap; }
  .ppe .msg { font-size: .82rem; min-height: 1.1em; margin: 0 0 .3rem; }
  .ppe .msg.ok { color: #34d399; }
  .ppe .msg.err { color: #f87171; }
  .ppe .count { font-size: .74rem; color: #93a4bd; margin: 0 0 .6rem; }

  /* ── 一覧テーブル ── */
  .ppe .tablewrap { background: #111c33; border: 1px solid rgba(148,163,184,.16); border-radius: 11px; overflow: hidden; }
  .ppe .tbl { width: 100%; border-collapse: collapse; font-size: .82rem; }
  .ppe .tbl thead th { text-align: left; font-size: .7rem; font-weight: 700; color: #93a4bd; padding: .55rem .8rem; border-bottom: 1px solid rgba(148,163,184,.2); background: rgba(13,23,41,.7); white-space: nowrap; }
  .ppe .tbl tbody td { padding: .5rem .8rem; border-bottom: 1px solid rgba(148,163,184,.1); vertical-align: middle; }
  .ppe .tbl tbody tr:last-child td { border-bottom: 0; }
  .ppe .tbl tbody tr:hover { background: rgba(148,163,184,.06); }
  .ppe .tbl td.c-ops { text-align: right; white-space: nowrap; }
  .ppe .tbl td.c-cust { max-width: 22rem; }
  .ppe .em { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 22rem; }
  .ppe .muted { color: #6f819c; }
  .ppe .btn-detail { background: linear-gradient(180deg, #1f3557, #17273f); color: #cfe0ff; border-color: rgba(96,165,250,.38); border-radius: 8px; padding: .34rem .85rem; font-size: .76rem; font-weight: 700; white-space: nowrap; }
  .ppe .btn-detail:hover:not([disabled]) { background: linear-gradient(180deg, #27436e, #1c3050); border-color: rgba(96,165,250,.6); }
  .ppe .empty { color: #93a4bd; font-size: .84rem; padding: 2rem 0; text-align: center; margin: 0; }
  .ppe .empty[hidden] { display: none; }

  /* ── 状態バッジ ── */
  .ppe .badge { display: inline-block; font-size: .72rem; font-weight: 800; padding: .18rem .6rem; border-radius: 999px; white-space: nowrap; }
  .ppe .badge.review { background-color: #16264a; color: #93c5fd; border: 1px solid rgba(96,165,250,.35); }
  .ppe .badge.staged { background-color: #0f2f26; color: #6ee7b7; border: 1px solid rgba(52,211,153,.32); }
  .ppe .badge.sale { background-color: #12463a; color: #a7f3d0; border: 1px solid rgba(52,211,153,.55); }
  .ppe .badge.immediate { background: linear-gradient(135deg, var(--gold), var(--gold-2)); color: #2a1d02; border: 1px solid rgba(245,196,81,.7); }
  .ppe .badge.blocked { background-color: #2a1416; color: #fca5a5; border: 1px solid rgba(248,113,113,.4); }

  /* ── タブ（販売 / マーケティング）── */
  .ppe .tabs { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0 0 .9rem; border-bottom: 1px solid rgba(148,163,184,.18); }
  .ppe .tab { background: transparent; border: 0; border-bottom: 2px solid transparent; color: #93a4bd;
    font-size: .84rem; font-weight: 700; padding: .55rem .9rem; cursor: pointer; border-radius: 0; }
  .ppe .tab:hover { color: #cbd5e6; }
  .ppe .tab.on { color: #e6edf7; border-bottom-color: var(--gold); }
  .ppe .pane-lead { font-size: .8rem; color: #93a4bd; line-height: 1.7; margin: 0 0 .9rem; }
  .ppe .note.off { color: #f5c451; }
  .ppe .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* ── マーケティング: 選択バー ── */
  .ppe .selbar { display: flex; align-items: center; gap: .5rem; margin: 0 0 .6rem; flex-wrap: wrap; }
  .ppe .selcount { font-size: .78rem; font-weight: 700; color: #e6edf7; margin-left: auto; }
  .ppe .tbl td.c-chk { width: 2.2rem; text-align: center; }
  .ppe .tbl td.c-chk input { width: 16px; height: 16px; accent-color: #f5c451; cursor: pointer; }
  .ppe .tbl td.c-chk input:disabled { cursor: not-allowed; opacity: .35; }
  .ppe .tbl tbody tr.row-suppressed { opacity: .62; }
  .ppe .em + .sub { display: block; font-size: .7rem; color: #6f819c; }
  .ppe .contract { font-weight: 700; font-size: .76rem; }
  .ppe .contract.active { color: #6ee7b7; }
  .ppe .contract.expiring_soon { color: #f5c451; }
  .ppe .contract.expired { color: #fca5a5; }
  .ppe .contract.unknown { color: #93a4bd; }
  .ppe .contract.none { color: #6f819c; }
  .ppe .ok-txt { color: #6ee7b7; font-size: .74rem; }
  .ppe .ng-txt { color: #fca5a5; font-size: .74rem; }
  /* 契約上の退会（課金停止）。送信可否とは別軸であることが分かるよう契約欄に置く */
  .ppe .wd-badge { display: inline-block; margin-left: .35rem; font-size: .66rem; font-weight: 700;
    padding: .1rem .4rem; border-radius: 4px; color: #cbd5e6;
    background: rgba(148,163,184,.14); border: 1px solid rgba(148,163,184,.3); }
  .ppe .strong-ok { color: #6ee7b7; font-weight: 800; }

  /* ── キャンペーン操作 ── */
  .ppe .campaign-box { background: #111c33; border: 1px solid rgba(148,163,184,.16); border-radius: 11px;
    padding: .85rem 1rem; margin-top: 1rem; }
  .ppe .campaign-box h2 { font-size: .9rem; margin: 0 0 .6rem; color: #e6edf7; }
  .ppe .offer-row { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: 0 0 .5rem; }
  .ppe .offer-label { min-width: 12rem; font-size: .78rem; color: #cbd5e6; font-weight: 700; }
  .ppe .offer-sub { display: inline-flex; align-items: center; gap: .35rem; font-size: .72rem; color: #93a4bd; }
  .ppe .offer-sub input { width: 7rem; }
  .ppe .offer-note { margin: 0 0 .8rem; font-size: .72rem; color: #93a4bd; }
  .ppe .price-box { background: #0d1626; border: 1px solid rgba(148,163,184,.16); border-radius: 9px;
    padding: .6rem .8rem; margin: 0 0 .7rem; }
  .ppe .camp-desc { font-size: .76rem; color: #93a4bd; line-height: 1.7; margin: .4rem 0 0; }
  /* 運用テスト専用キャンペーン（顧客向けと混同させない） */
  .ppe .testonly { margin: 0 0 .5rem; padding: .5rem .7rem; border-radius: 6px; font-size: .76rem; line-height: 1.6;
    background: rgba(96,165,250,.1); border-left: 3px solid rgba(96,165,250,.6); color: #bfd4f5; font-weight: 700; }
  .ppe .exlist { margin: 0; padding-left: 1.1rem; font-size: .78rem; color: #cbd5e6; line-height: 1.9; }
  .ppe .exlist strong { color: #e6edf7; }
  .ppe .exlist .sub { padding-left: .9rem; font-size: .74rem; color: #93a4bd; line-height: 1.7; }
  .ppe .prev-subject { font-size: .86rem; font-weight: 700; color: #e6edf7; margin: 0; }
  /* 実際のメール本文をそのまま出す枠。枠内の配色はメール側の HTML が決める
     （管理 UI 側のダーク配色をここへ持ち込まない） */
  .ppe .prev-frame { width: 100%; height: 22rem; border: 1px solid rgba(148,163,184,.2); border-radius: 8px; }
  .ppe .prev-body { white-space: pre-wrap; word-break: break-word; font-size: .78rem; line-height: 1.8;
    color: #dbe6f5; background: #0d1626; border: 1px solid rgba(148,163,184,.16); border-radius: 8px;
    padding: .8rem; margin: .5rem 0 0; font-family: inherit; }

  /* ── 候補区分（表示専用。販売資格ではないので badge とは別の弱い見た目にする）── */
  .ppe .kind { display: inline-block; font-size: .7rem; font-weight: 700; color: #93a4bd; white-space: nowrap; }
  .ppe .kind.waiting_30d { color: #cbd5e6; }
  .ppe .kind.anchor_missing { color: #f5c451; }
  .ppe .blocker { margin: .6rem 0 0; padding: .5rem .7rem; border-radius: 6px; font-size: .76rem; line-height: 1.5;
    background: rgba(245,196,81,.08); border-left: 3px solid rgba(245,196,81,.55); color: #f0d9a0; }

  /* ── 詳細・操作パネル ──
     z-index はサイト共通ヘッダ（position: fixed / z-index: 1000）より上。
     下だとパネル上部（タイトル・閉じる×）がヘッダに隠れ、閉じられなくなる（2026-07-30 本番で発生）。 */
  .ppe .dt-backdrop { position: fixed; inset: 0; background: rgba(3,7,18,.7); z-index: 2000; display: flex; justify-content: flex-end; }
  .ppe .dt-backdrop[hidden] { display: none; }
  .ppe .dt-panel { width: min(460px, 100%); height: 100%; overflow-y: auto; overscroll-behavior: contain; background: #0d1729; border-left: 1px solid rgba(148,163,184,.24); padding: 0 1.2rem 2.5rem; }
  /* 見出しと戻る/閉じるは常に見える位置に固定する（スクロールしても届く） */
  .ppe .dt-head { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: .8rem; margin: 0 0 .9rem; padding: .85rem 0 .7rem; background: #0d1729; border-bottom: 1px solid rgba(148,163,184,.18); }
  .ppe .dt-head-l { display: flex; align-items: center; gap: .6rem; min-width: 0; }
  .ppe .dt-head h2 { font-size: 1rem; margin: 0; }
  .ppe .btn-back { background-color: var(--nv-2); color: var(--ink-2); border-color: var(--line-2); border-radius: 9px; padding: .38rem .8rem; font-size: .76rem; font-weight: 700; white-space: nowrap; }
  .ppe .btn-back:hover:not([disabled]) { background-color: var(--nv-3); border-color: rgba(96,165,250,.5); color: var(--ink); }
  .ppe .x { background-color: transparent; border-color: transparent; box-shadow: none; color: var(--muted); font-size: 1.4rem; line-height: 1; padding: 0 .35rem; }
  .ppe .x:hover:not([disabled]) { background-color: rgba(148,163,184,.14); border-color: transparent; color: var(--ink); }
  .ppe .dt-body { display: grid; gap: .9rem; }
  .ppe .dt-email { font-weight: 700; font-size: .9rem; overflow-wrap: anywhere; margin-bottom: .4rem; }
  .ppe .dt-sec { border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .8rem .9rem; background: #111c33; }
  .ppe .dt-sec h3 { font-size: .72rem; color: #93a4bd; margin: 0 0 .55rem; font-weight: 700; }
  .ppe .dt-sec.danger { border-color: rgba(248,113,113,.32); }
  .ppe .dt-sec.danger h3 { color: #f87171; }
  .ppe .kv { display: grid; grid-template-columns: max-content 1fr; gap: .3rem .9rem; font-size: .8rem; margin: 0; }
  .ppe .kv dt { color: #93a4bd; }
  .ppe .kv dd { margin: 0; font-weight: 700; overflow-wrap: anywhere; }
  .ppe .memo-view { background: rgba(11,17,32,.6); border-left: 3px solid rgba(245,196,81,.5); border-radius: 6px; padding: .5rem .7rem; font-size: .78rem; color: #cbd5e6; margin-top: .6rem; }
  .ppe .ops { display: flex; gap: .5rem; flex-wrap: wrap; }
  .ppe .ops button { border-radius: 9px; padding: .5rem .95rem; font-weight: 700; font-size: .8rem; }
  .ppe .b-preview { background: linear-gradient(180deg, #1f3557, #17273f); color: #cfe0ff; border-color: rgba(96,165,250,.38); width: 100%; }
  .ppe .b-preview:hover:not([disabled]) { background: linear-gradient(180deg, #27436e, #1c3050); }
  .ppe .b-staged { background: linear-gradient(180deg, #1f8f6b, #177557); color: #e8fff6; border-color: rgba(52,211,153,.5); }
  .ppe .b-staged:hover:not([disabled]) { background-color: #26a87e; border-color: rgba(52,211,153,.75); }
  .ppe .b-review { background-color: #26344f; color: var(--ink-2); border-color: rgba(148,163,184,.35); }
  .ppe .b-review:hover:not([disabled]) { background-color: #31425f; }
  .ppe .b-immediate { background: linear-gradient(135deg, var(--gold), var(--gold-2)); color: #2a1d02; border-color: rgba(245,196,81,.7); box-shadow: 0 8px 20px -10px rgba(245,196,81,.85); }
  .ppe .b-immediate:hover:not([disabled]) { background: linear-gradient(135deg, #ffd77a, #e5a929); border-color: rgba(245,196,81,.9); }
  .ppe .b-blocked { background-color: #2a1416; color: #fca5a5; border-color: rgba(248,113,113,.6); }
  .ppe .b-blocked:hover:not([disabled]) { background-color: #3a1a1d; border-color: rgba(248,113,113,.85); }
  .ppe .applied { font-size: .7rem; color: #6f819c; align-self: center; }
  .ppe .memo-input { width: 100%; padding: .5rem .65rem; font-size: .8rem; }

  /* ── プレビュー モーダル ──
     共通ヘッダ（z-index: 1000）より上。見出し・戻る・PHASE 切替は固定し、本文だけを内部スクロールさせる。 */
  .ppe .pv-backdrop { position: fixed; inset: 0; background: rgba(3,7,18,.78); display: flex; align-items: center; justify-content: center; padding: 2vh 1rem; z-index: 2010; overflow: hidden; }
  .ppe .pv-backdrop[hidden] { display: none; }
  .ppe .pv-modal { background: #0d1729; border: 1px solid rgba(148,163,184,.24); border-radius: 14px; width: min(780px, 100%); max-height: 96vh; padding: 1.1rem 1.2rem 1.2rem; display: flex; flex-direction: column; overflow: hidden; }
  .ppe .pv-head { display: flex; align-items: center; justify-content: space-between; gap: .8rem; flex: 0 0 auto; }
  .ppe .pv-head-l { display: flex; align-items: center; gap: .6rem; min-width: 0; }
  .ppe .pv-head h2 { font-size: 1rem; margin: 0; }
  .ppe .pv-notice { font-size: .74rem; color: #f5c451; background: rgba(245,196,81,.08); border: 1px solid rgba(245,196,81,.26); border-radius: 8px; padding: .45rem .7rem; margin: .6rem 0 .8rem; flex: 0 0 auto; }
  .ppe .pv-controls { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: .7rem; flex: 0 0 auto; }
  .ppe .pv-controls label { font-size: .76rem; color: #93a4bd; display: flex; align-items: center; gap: .4rem; }
  .ppe .pv-controls select { height: 30px; padding: 0 1.9rem 0 .6rem; font-size: .78rem; }
  /* 段階公開の切替はプレビューの主操作。ここを見落として「404 のまま」と誤読されるため強調する */
  .ppe .pv-controls .ctl-main { color: var(--gold); font-weight: 700; }
  .ppe .pv-controls .ctl-main select { border-color: rgba(245,196,81,.55); font-weight: 700; color: var(--ink); }
  .ppe .pv-hint { font-size: .76rem; line-height: 1.65; color: #cbd5e6; background: rgba(96,165,250,.08); border: 1px solid rgba(96,165,250,.28); border-radius: 8px; padding: .5rem .7rem; margin: 0 0 .8rem; flex: 0 0 auto; }
  .ppe .pv-hint[hidden] { display: none; }
  .ppe .pv-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
  .ppe .pv-body { display: grid; gap: .8rem; }
  .ppe .pv-top { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: .5rem; }
  .ppe .pv-top .cell { background: #111c33; border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .55rem .65rem; }
  .ppe .pv-top .k { font-size: .66rem; color: #93a4bd; }
  .ppe .pv-top .v { font-size: .92rem; font-weight: 800; margin-top: .12rem; }
  .ppe .pv-sec { border: 1px solid rgba(148,163,184,.18); border-radius: 10px; padding: .8rem .9rem; background: #111c33; }
  .ppe .pv-sec h3 { font-size: .74rem; color: #93a4bd; margin: 0 0 .5rem; font-weight: 700; }
  .ppe .pv-mock { border: 1px dashed rgba(148,163,184,.35); border-radius: 10px; padding: .9rem; text-align: center; }
  .ppe .pv-intake-t { font-size: .74rem; color: #93a4bd; }
  .ppe .pv-intake-s { font-size: 1rem; font-weight: 900; margin: .2rem 0; }
  .ppe .pv-intake-n { font-size: .7rem; color: #93a4bd; }
  .ppe .pv-price { margin: .7rem 0 .45rem; font-weight: 900; color: #f5c451; }
  .ppe .pv-cta { display: inline-block; border-radius: 10px; padding: .55rem 1.3rem; font-weight: 800; background: linear-gradient(135deg,#f5c451,#d99b1f); color: #2a1d02; }
  .ppe .pv-cta.off { opacity: .45; filter: grayscale(.6); }
  .ppe .pv-none { color: #93a4bd; font-size: .82rem; }
  .ppe .pv-vis { font-size: .8rem; line-height: 1.7; margin: .7rem 0 0; }
  .ppe .yes { color: #34d399; }
  .ppe .no { color: #f87171; }

  /* ── モバイル: テーブル → 1 顧客 1 コンパクトカード（横スクロールさせない）── */
  @media (max-width: 860px) {
    .ppe .ppe-head { flex-direction: column; gap: .8rem; }
    .ppe .ppe-head-r { width: 100%; }
    .ppe .toolbar input[type=search] { flex: 1 1 100%; }
    .ppe .tablewrap { background: transparent; border: 0; border-radius: 0; overflow: visible; }
    .ppe .tbl { display: block; width: 100%; }
    .ppe .tbl tbody { display: block; width: 100%; }
    .ppe .tbl tr { display: block; width: 100%; }
    .ppe .tbl td { display: block; width: 100%; }
    .ppe .tbl thead { display: none; }
    .ppe .tbl tbody tr { background: #111c33; border: 1px solid rgba(148,163,184,.16); border-radius: 11px; margin-bottom: .6rem; padding: .7rem .85rem; }
    .ppe .tbl tbody td { border: 0; padding: .15rem 0; }
    .ppe .tbl tbody td::before { content: attr(data-label) '　'; color: #93a4bd; font-size: .7rem; }
    .ppe .tbl tbody td.c-cust::before { content: ''; }
    .ppe .tbl tbody td.c-state::before { content: ''; }
    .ppe .tbl tbody td.c-ops::before { content: ''; }
    .ppe .tbl tbody td.c-eligible { display: none; }
    .ppe .tbl tbody td.c-updated { display: none; }
    .ppe .tbl tbody td.c-chk::before { content: ''; }
    .ppe .tbl tbody td.c-chk { width: 100%; text-align: left; margin-bottom: .3rem; }
    .ppe .tab { flex: 1 1 auto; padding: .55rem .5rem; }
    .ppe .selcount { margin-left: 0; width: 100%; }
    .ppe .prev-frame { height: 60vh; }
    .ppe .tbl tbody td.c-cust { font-weight: 700; margin-bottom: .2rem; }
    .ppe .tbl td.c-cust { max-width: 100%; }
    .ppe .em { max-width: 100%; }
    .ppe .tbl tbody td.c-ops { text-align: left; margin-top: .5rem; }
    .ppe .btn-detail { width: 100%; padding: .5rem; }
    /* パネル / モーダルは全画面。上部の「戻る」に必ず届くようにする */
    .ppe .dt-panel { width: 100%; border-left: 0; }
    .ppe .pv-backdrop { padding: 0; }
    .ppe .pv-modal { width: 100%; max-height: 100%; height: 100%; border: 0; border-radius: 0; padding: .85rem .9rem 1rem; }
    .ppe .pv-controls { gap: .55rem; }
    .ppe .pv-controls label { flex: 1 1 100%; justify-content: space-between; }
    .ppe .pv-controls select { flex: 0 1 62%; }
  }
</style>

<script is:inline>
  (() => {
    const API = '/.netlify/functions/premium-plus-eligibility';
    const $ = (id) => document.getElementById(id);
    const secretEl = $('secret');

    const saved = sessionStorage.getItem('pp-admin-secret');
    if (saved) secretEl.value = saved;
    secretEl.addEventListener('change', () => {
      sessionStorage.setItem('pp-admin-secret', secretEl.value);
      setConn(false);
    });

    function setConn(ok) {
      const el = $('connState');
      el.textContent = ok ? '● 管理API 接続済み' : '● 未接続';
      el.className = 'conn-pill' + (ok ? ' ok' : '');
      if (ok) $('connBody').hidden = true;
    }
    if (!saved) $('connBody').hidden = false;
    $('connToggle').addEventListener('click', () => { $('connBody').hidden = !$('connBody').hidden; });

    function msg(text, kind) {
      const el = $('message');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function call(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { msg('管理シークレットを入力してください', 'err'); $('connBody').hidden = false; return null; }
      const res = await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { msg(data.error || ('エラー: ' + res.status), 'err'); if (res.status === 403) setConn(false); return null; }
      setConn(true);
      return data;
    }

    // ── 状態の分類（表示・並び順・フィルター用。判定そのものは Function 側の単一源）──
    function classify(r) {
      if (r.eligibility === 'blocked') return { key: 'blocked', badge: 'blocked', short: '販売対象外', order: 4 };
      if (r.eligibility !== 'eligible') return { key: 'review', badge: 'review', short: '保留', order: 1 };
      if (r.overrideApplied) return { key: 'immediate', badge: 'immediate', short: '即時販売', order: 3 };
      if (r.phase === 4) return { key: 'sale', badge: 'sale', short: '販売中', order: 2 };
      return { key: 'staged', badge: 'staged', short: 'PHASE ' + r.phase, order: 2 };
    }
    const ROUTE_SHORT = { sanrenpuku: 'A', premium_30d: 'B', none: '—' };
    const ROUTE_LABEL = { sanrenpuku: 'A（三連複）', premium_30d: 'B（Premium 30日）', none: '対象外' };

    // 候補区分（表示専用。販売資格ではない）。Function 側 premiumPlusAdminAudience.js の PP_CANDIDATE と対応。
    const KIND_SHORT = {
      route_a: 'A 成立', route_b: 'B 成立',
      waiting_30d: '待機中', anchor_missing: '加入日なし',
      explicit: '設定済み', none: '—',
    };
    function kindShort(r) {
      const k = r.candidateKind || 'none';
      if (k === 'waiting_30d' && r.daysUntilRouteB != null) return '待機中 あと' + r.daysUntilRouteB + '日';
      return KIND_SHORT[k] || k;
    }
    const fmtDate = (v) => (v ? String(v).slice(0, 10) : '—');

    let lastData = null;

    function matches(r) {
      const st = classify(r).key;
      const fs = $('fState').value;
      if (fs === 'review' && st !== 'review') return false;
      if (fs === 'eligible' && !(st === 'staged' || st === 'sale')) return false;
      if (fs === 'immediate' && st !== 'immediate') return false;
      if (fs === 'blocked' && st !== 'blocked') return false;
      const fr = $('fRoute').value;
      if (fr !== 'all' && r.route !== fr) return false;
      const fk = $('fKind').value;
      if (fk !== 'all' && r.candidateKind !== fk) return false;
      const q = $('q').value.trim().toLowerCase();
      if (q && !String(r.email || '').toLowerCase().includes(q)) return false;
      return true;
    }

    function sortRows(rows) {
      return [...rows].sort((a, b) => {
        const d = classify(a).order - classify(b).order;
        if (d !== 0) return d;
        const ua = String(a.updatedAt || ''), ub = String(b.updatedAt || '');
        if (ua !== ub) return ub.localeCompare(ua);
        return String(a.email).localeCompare(String(b.email));
      });
    }

    // ── サマリーバー（クリックでフィルター）──
    function renderSummary(c) {
      const bar = $('summary');
      bar.innerHTML = '';
      const items = [
        ['即時販売', c.immediate, 'immediate', 'immediate'],
        ['販売可', c.eligible, 'eligible', 'eligible'],
        ['保留', c.review, 'review', 'review'],
        ['販売対象外', c.blocked, 'blocked', 'blocked'],
        ['候補', c.total, '', 'all'],
      ];
      items.forEach((item, i) => {
        const k = item[0], v = item[1], cls = item[2], filter = item[3];
        if (i > 0) { const sp = document.createElement('span'); sp.className = 'sep'; sp.textContent = '|'; bar.appendChild(sp); }
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 's ' + cls;
        b.title = k + 'で絞り込む';
        const kk = document.createElement('span'); kk.className = 'k'; kk.textContent = k;
        const vv = document.createElement('span'); vv.className = 'v'; vv.textContent = String(v == null ? 0 : v);
        b.appendChild(kk); b.appendChild(vv);
        b.addEventListener('click', () => { $('fState').value = filter; render(); });
        bar.appendChild(b);
      });
      $('summarySub').textContent = 'ROUTE A（三連複） ' + (c.routeA == null ? 0 : c.routeA)
        + '　/　ROUTE B（Premium 30日） ' + (c.routeB == null ? 0 : c.routeB)
        + '　/　ROUTE B 待機中 ' + (c.waiting30d == null ? 0 : c.waiting30d)
        + '　/　加入日データなし ' + (c.anchorMissing == null ? 0 : c.anchorMissing);
    }

    // ── 一覧（テーブル。write ボタンは置かない）──
    function td(cls, label, text, extraCls) {
      const e = document.createElement('td');
      e.className = cls;
      if (label) e.setAttribute('data-label', label);
      if (text !== undefined) {
        const s = document.createElement('span');
        if (extraCls) s.className = extraCls;
        s.textContent = text;
        e.appendChild(s);
      }
      return e;
    }

    function render() {
      if (!lastData) return;
      const data = lastData;
      renderSummary(data.counts || {});
      $('writeState').textContent = (data.writeEnabled
        ? '書き込み: 有効'
        : '書き込み: 無効（Airtable に Premium Plus フィールド未作成 / PREMIUM_PLUS_FIELDS_READY 未設定）。一覧は閲覧のみ。')
        + (data.overrideEnabled ? ' / 今すぐ販売可: 利用可' : ' / 今すぐ販売可: 無効（PREMIUM_PLUS_OVERRIDE_READY 未設定）');

      const rows = sortRows((data.rows || []).filter(matches));
      const tb = $('rows');
      tb.innerHTML = '';
      for (const r of rows) {
        const st = classify(r);
        const tr = document.createElement('tr');

        const c1 = td('c-cust', '', undefined);
        const em = document.createElement('span');
        em.className = 'em';
        em.textContent = r.email || '(メール未設定)';
        em.title = r.email || '';
        c1.appendChild(em);
        tr.appendChild(c1);

        const c2 = document.createElement('td');
        c2.className = 'c-state';
        const badge = document.createElement('span');
        badge.className = 'badge ' + st.badge;
        badge.textContent = st.short;
        badge.title = r.state || st.short;
        c2.appendChild(badge);
        tr.appendChild(c2);

        tr.appendChild(td('c-plan', 'プラン', r.plan || '—', r.plan ? '' : 'muted'));
        tr.appendChild(td('c-route', 'Route', ROUTE_SHORT[r.route] || r.route));

        // 区分（表示専用。route 未成立でレビュー対象に出している理由を明示する）
        const cK = document.createElement('td');
        cK.className = 'c-kind';
        cK.setAttribute('data-label', '区分');
        const kb = document.createElement('span');
        kb.className = 'kind ' + (r.candidateKind || '');
        kb.textContent = kindShort(r);
        if (r.candidateNote) kb.title = r.candidateNote;
        cK.appendChild(kb);
        tr.appendChild(cK);
        tr.appendChild(td('c-phase', 'PHASE', String(r.phase)));
        tr.appendChild(td('c-eligible', '販売許可日', fmtDate(r.eligibleAt), r.eligibleAt ? '' : 'muted'));
        tr.appendChild(td('c-updated', '最終更新', fmtDate(r.updatedAt), r.updatedAt ? '' : 'muted'));

        const c8 = document.createElement('td');
        c8.className = 'c-ops';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-detail';
        btn.textContent = '詳細・操作';
        btn.addEventListener('click', () => openDetail(r.recordId));
        c8.appendChild(btn);
        tr.appendChild(c8);

        tb.appendChild(tr);
      }
      $('count').textContent = '表示 ' + rows.length + ' 件 / 全 ' + (data.rows || []).length + ' 件';
      const emp = $('empty');
      emp.hidden = rows.length > 0;
      emp.textContent = (data.rows || []).length ? '条件に一致する会員はいません。' : '該当する候補はありません。';
      if (data.truncated) msg('件数が多いため一部のみ表示しています', 'err');
    }

    async function load() {
      msg('読み込み中…');
      const data = await call({ action: 'list', onlyReview: $('onlyReview').checked });
      if (data) { msg(''); lastData = data; render(); }
    }

    // ── 詳細・操作パネル（write はここだけ）──
    let dtRecordId = null;

    function kvRow(dl, k, v, cls) {
      const dt = document.createElement('dt'); dt.textContent = k;
      const dd = document.createElement('dd'); dd.textContent = String(v);
      if (cls) dd.className = cls;
      dl.appendChild(dt); dl.appendChild(dd);
    }

    function renderDetail() {
      const data = lastData;
      const r = (data && (data.rows || []).find((x) => x.recordId === dtRecordId)) || null;
      const body = $('dtBody');
      body.innerHTML = '';
      if (!r) { body.textContent = '対象が見つかりません。再読み込みしてください。'; return; }
      const st = classify(r);

      const head = document.createElement('div');
      const em = document.createElement('div'); em.className = 'dt-email'; em.textContent = r.email || '(メール未設定)';
      const b = document.createElement('span'); b.className = 'badge ' + st.badge; b.textContent = r.state || st.short;
      head.appendChild(em); head.appendChild(b);
      body.appendChild(head);

      const info = document.createElement('div'); info.className = 'dt-sec';
      const h1 = document.createElement('h3'); h1.textContent = '基本情報'; info.appendChild(h1);
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, 'プラン', r.plan || '—');
      kvRow(dl, '三連複', r.hasSanrenpuku ? 'あり' : 'なし');
      kvRow(dl, 'Route', ROUTE_LABEL[r.route] || r.route);
      kvRow(dl, '候補区分', r.candidateLabel || '—');
      kvRow(dl, 'PHASE', String(r.phase));
      kvRow(dl, 'Premium経過', r.daysSincePremium == null ? '加入日（PaidAt）未記録' : r.daysSincePremium + ' 日',
        r.daysSincePremium == null ? 'muted' : '');
      kvRow(dl, '販売許可日', fmtDate(r.eligibleAt));
      kvRow(dl, '最終更新', fmtDate(r.updatedAt));
      info.appendChild(dl);
      // 一覧に出しても顧客側に出ない相手は、操作前にその理由を出す（空振りの操作をさせない）
      if (r.releaseBlockedBy && r.candidateNote) {
        const warn = document.createElement('p');
        warn.className = 'blocker';
        warn.textContent = '⚠️ ' + r.candidateNote;
        info.appendChild(warn);
      }
      if (r.reason) {
        const memo = document.createElement('div'); memo.className = 'memo-view';
        memo.textContent = '内部メモ: ' + r.reason;
        info.appendChild(memo);
      }
      body.appendChild(info);

      const pvSec = document.createElement('div'); pvSec.className = 'dt-sec';
      const h2 = document.createElement('h3'); h2.textContent = '表示確認'; pvSec.appendChild(h2);
      const pvBtn = document.createElement('button');
      pvBtn.type = 'button'; pvBtn.className = 'b-preview'; pvBtn.textContent = '表示プレビュー';
      pvBtn.addEventListener('click', () => openPreview(r.recordId));
      const ops0 = document.createElement('div'); ops0.className = 'ops'; ops0.appendChild(pvBtn);
      pvSec.appendChild(ops0);
      body.appendChild(pvSec);

      // メモ入力（write payload の reason に載せる）
      const memoInput = document.createElement('input');
      memoInput.className = 'memo-input';
      memoInput.placeholder = '内部メモ（管理者のみ・任意）';
      memoInput.value = r.reason || '';

      const buttons = [];
      const mkBtn = (plusAction, label, cls, isCurrent, extraDisabled) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = cls;
        btn.textContent = label;
        btn.dataset.action = plusAction;
        btn.disabled = !data.writeEnabled || isCurrent || !!extraDisabled;
        if (isCurrent) btn.title = '現在この状態です（適用中）';
        btn.addEventListener('click', async () => {
          if (btn.dataset.busy === '1') return; // 二重クリック防止
          if (plusAction === 'immediate') {
            const ok = window.confirm(
              'この会員は即時PHASE 4となり、価格と購入CTAが表示されます。\n\n'
              + '段階公開（PHASE 1→4）を飛ばして、いますぐ販売可能な状態にします。\n'
              + '実行してよろしいですか？'
            );
            if (!ok) return;
          }
          btn.dataset.busy = '1';
          buttons.forEach((x) => { x.disabled = true; });
          msg('更新中…');
          const out = await call({ action: 'update', recordId: r.recordId, plusAction, reason: memoInput.value });
          btn.dataset.busy = '';
          if (out) {
            msg('更新しました: ' + out.label + (out.override === 'phase4' ? '（即時販売）' : ''), 'ok');
            await load();
          }
          renderDetail(); // パネルを最新状態で再構成
        });
        buttons.push(btn);
        return btn;
      };

      const isImmediate = st.key === 'immediate';
      const isStagedNow = r.eligibility === 'eligible' && !r.overrideApplied;

      const secN = document.createElement('div'); secN.className = 'dt-sec';
      const h3 = document.createElement('h3'); h3.textContent = '通常操作'; secN.appendChild(h3);
      const opsN = document.createElement('div'); opsN.className = 'ops';
      opsN.appendChild(mkBtn('staged', '段階公開で販売可', 'b-staged', isStagedNow));
      opsN.appendChild(mkBtn('review', '保留', 'b-review', r.eligibility === 'review'));
      if (isStagedNow) { const s = document.createElement('span'); s.className = 'applied'; s.textContent = '適用中'; opsN.appendChild(s); }
      secN.appendChild(opsN);
      body.appendChild(secN);

      const secD = document.createElement('div'); secD.className = 'dt-sec danger';
      const h4 = document.createElement('h3'); h4.textContent = '強い操作（本番の販売状態が変わります）'; secD.appendChild(h4);
      const opsD = document.createElement('div'); opsD.className = 'ops';
      opsD.appendChild(mkBtn('immediate', '今すぐ販売可', 'b-immediate', isImmediate, !data.overrideEnabled));
      opsD.appendChild(mkBtn('blocked', '販売対象外', 'b-blocked', r.eligibility === 'blocked'));
      if (isImmediate) { const s = document.createElement('span'); s.className = 'applied'; s.textContent = '適用中'; opsD.appendChild(s); }
      secD.appendChild(opsD);
      body.appendChild(secD);

      const secM = document.createElement('div'); secM.className = 'dt-sec';
      const h5 = document.createElement('h3'); h5.textContent = '内部メモ'; secM.appendChild(h5);
      secM.appendChild(memoInput);
      body.appendChild(secM);
    }

    // オーバーレイ表示中は背面の一覧をスクロールさせない（閉じたら必ず元に戻す）
    function lockScroll() { document.body.style.overflow = 'hidden'; }
    function unlockScroll() { document.body.style.overflow = ''; }

    function openDetail(recordId) {
      dtRecordId = recordId;
      $('dtBackdrop').hidden = false;
      lockScroll();
      renderDetail();
      $('dtPanel').scrollTop = 0;
    }
    function closeDetail() {
      $('dtBackdrop').hidden = true;
      dtRecordId = null;
      if ($('pvBackdrop').hidden) unlockScroll();
    }
    $('dtClose').addEventListener('click', closeDetail);
    $('dtBack').addEventListener('click', closeDetail);
    $('dtBackdrop').addEventListener('click', (e) => { if (e.target === $('dtBackdrop')) closeDetail(); });

    // ── 管理者プレビュー（read-only）──
    let pvRecordId = null;
    let pvOptionsReady = false;

    function fillOptions(sel, items, valueKey, current) {
      if (sel.options.length) return;
      for (const it of items) {
        const o = document.createElement('option');
        o.value = it[valueKey] === null ? '' : String(it[valueKey]);
        o.textContent = it.label;
        sel.appendChild(o);
      }
      sel.value = current == null ? '' : current;
    }
    const yn = (b) => (b ? 'はい' : 'いいえ');
    const ynCls = (b) => (b ? 'yes' : 'no');

    // 「404 のまま」を誤読させないための説明。何を操作すれば表示されるかまで書く
    function renderPreviewHint(p) {
      const hint = $('pvHint');
      let text = '';
      if (!p.showProductPage) {
        if (p.eligibility !== 'eligible') {
          const label = p.eligibility === 'blocked' ? '販売対象外' : '保留';
          text = 'この会員は「' + label + '」のため、PHASE を切り替えても商品ページは表示されません。'
            + '先に詳細パネルで「段階公開で販売可」にする必要があります（PHASE の切替はプレビュー内だけの確認で、実データは変わりません）。';
        } else if (p.simulated.phaseDaysAgo === null) {
          text = '実データでは PHASE ' + p.phase + ' のため、会員にはまだ何も表示されません（正常です）。'
            + '段階公開が進んだあとの見え方を確認するには、上の「段階公開の表示確認」で PHASE 2〜4 を選んでください。';
        }
      }
      hint.textContent = text;
      hint.hidden = !text;
    }

    function renderPreview(data) {
      const p = data.preview;
      renderPreviewHint(p);
      const body = $('pvBody');
      body.innerHTML = '';

      const top = document.createElement('div'); top.className = 'pv-top';
      const cell = (k, v, cls) => {
        const c = document.createElement('div'); c.className = 'cell';
        const kk = document.createElement('div'); kk.className = 'k'; kk.textContent = k;
        const vv = document.createElement('div'); vv.className = 'v' + (cls ? ' ' + cls : ''); vv.textContent = v;
        c.appendChild(kk); c.appendChild(vv); top.appendChild(c);
      };
      cell('PHASE', 'PHASE ' + p.phase + (p.simulated.phaseDaysAgo === null ? '' : '（シミュ）'));
      cell('受付状態', p.intakeStatus || '（PHASE 4 未満）');
      cell('商品ページ', p.showProductPage ? '表示 (200)' : '非表示 (404)', ynCls(p.showProductPage));
      cell('価格・CTA', p.showPurchaseCta ? '表示' : '非表示', ynCls(p.showPurchaseCta));
      cell('購入可否', yn(p.purchaseEnabled), ynCls(p.purchaseEnabled));
      body.appendChild(top);

      const mk = (title) => { const s = document.createElement('div'); s.className = 'pv-sec'; const h = document.createElement('h3'); h.textContent = title; s.appendChild(h); body.appendChild(s); return s; };

      const mock = mk('会員に見える表示（Premium Plus 商品ページ 相当）');
      const box = document.createElement('div'); box.className = 'pv-mock';
      if (!p.showProductPage) {
        const n = document.createElement('p'); n.className = 'pv-none';
        n.textContent = p.showTeaser ? '商品ページ: 404（会員ページに予告カードのみ表示）' : '商品ページ: 404（予告も出ません）';
        box.appendChild(n);
      } else {
        if (p.intakeStatus) {
          const t = document.createElement('div'); t.className = 'pv-intake-t'; t.textContent = p.intakeTitle || '';
          const s2 = document.createElement('div'); s2.className = 'pv-intake-s'; s2.textContent = p.intakeStatus;
          box.appendChild(t); box.appendChild(s2);
          if (p.intakeNote) { const nt = document.createElement('div'); nt.className = 'pv-intake-n'; nt.textContent = p.intakeNote; box.appendChild(nt); }
        }
        const pr = document.createElement('div'); pr.className = 'pv-price';
        pr.textContent = p.priceVisible ? '価格ブロック: 表示される' : '価格ブロック: 非表示（受付準備中）';
        box.appendChild(pr);
        const cta = document.createElement('span');
        cta.className = 'pv-cta' + (p.ctaEnabled ? '' : ' off');
        cta.textContent = p.showPurchaseCta ? (p.ctaEnabled ? '銀行振込で購入する（操作可）' : '銀行振込で購入する（操作不可）') : '受付準備中';
        box.appendChild(cta);
      }
      mock.appendChild(box);
      const vis = document.createElement('p'); vis.className = 'pv-vis'; vis.textContent = data.visibility || '';
      mock.appendChild(vis);

      const d1 = mk('判定');
      const dl1 = document.createElement('dl'); dl1.className = 'kv';
      kvRow(dl1, '評価時刻(JST)', p.evaluatedAtJst + (p.simulated.isSimulatedTime ? '（シミュレーション）' : ''));
      kvRow(dl1, 'route', p.route);
      kvRow(dl1, 'PremiumPlusEligibility', p.eligibility);
      kvRow(dl1, 'PremiumPlusReleaseOverride', p.releaseOverride || '(空)');
      kvRow(dl1, 'overrideApplied', yn(p.overrideApplied), ynCls(p.overrideApplied));
      kvRow(dl1, '状態', p.state);
      kvRow(dl1, 'anchor(JST)', p.anchorJst || '(なし)');
      kvRow(dl1, 'intake', p.intake || '(PHASE 4 未満)');
      d1.appendChild(dl1);

      const d2 = mk('表示フラグ');
      const dl2 = document.createElement('dl'); dl2.className = 'kv';
      kvRow(dl2, 'showTeaser', yn(p.showTeaser), ynCls(p.showTeaser));
      kvRow(dl2, 'showProductPage', yn(p.showProductPage), ynCls(p.showProductPage));
      kvRow(dl2, 'showPurchaseCta', yn(p.showPurchaseCta), ynCls(p.showPurchaseCta));
      kvRow(dl2, 'purchaseEnabled', yn(p.purchaseEnabled), ynCls(p.purchaseEnabled));
      kvRow(dl2, '商品ページ HTTP', p.productPageStatus);
      if (p.canBrowseWhenClosed !== null) kvRow(dl2, 'CLOSED でも閲覧可', yn(p.canBrowseWhenClosed), ynCls(p.canBrowseWhenClosed));
      d2.appendChild(dl2);
    }

    async function refreshPreview() {
      if (!pvRecordId) return;
      $('pvHint').hidden = true;
      $('pvBody').textContent = '読み込み中…';
      const data = await call({
        action: 'preview',
        recordId: pvRecordId,
        atMin: $('pvTime').value === '' ? null : Number($('pvTime').value),
        phaseDaysAgo: $('pvPhase').value === '' ? null : Number($('pvPhase').value),
      });
      if (!data) { $('pvBody').textContent = '取得に失敗しました'; return; }
      if (!pvOptionsReady && data.options) {
        fillOptions($('pvTime'), data.options.times, 'atMin', '');
        fillOptions($('pvPhase'), data.options.phases, 'daysAgo', '');
        pvOptionsReady = true;
      }
      renderPreview(data);
    }

    function openPreview(recordId) {
      pvRecordId = recordId;
      $('pvBackdrop').hidden = false;
      lockScroll();
      $('pvScroll').scrollTop = 0;
      refreshPreview();
    }
    // 閉じると詳細パネルに戻る（詳細も閉じていれば一覧へ）
    function closePreview() {
      $('pvBackdrop').hidden = true;
      pvRecordId = null;
      if ($('dtBackdrop').hidden) unlockScroll();
    }

    $('pvClose').addEventListener('click', closePreview);
    $('pvBack').addEventListener('click', closePreview);
    $('pvBackdrop').addEventListener('click', (e) => { if (e.target === $('pvBackdrop')) closePreview(); });
    $('pvTime').addEventListener('change', refreshPreview);
    $('pvPhase').addEventListener('change', refreshPreview);
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!$('pvBackdrop').hidden) { closePreview(); return; }
      if (!$('dtBackdrop').hidden) closeDetail();
    });

    $('reload').addEventListener('click', load);
    $('q').addEventListener('input', render);
    $('fState').addEventListener('change', render);
    $('fRoute').addEventListener('change', render);
    $('fKind').addEventListener('change', render);

    // ══════════════════════════════════════════════════════════════
    //  顧客マーケティング（AK 独自 / KMA とは無関係）
    //  この領域は Premium Plus の販売資格を一切変更しない。呼ぶ API も別。
    // ══════════════════════════════════════════════════════════════
    const MKT_API = '/.netlify/functions/admin-marketing';

    function mkMsg(text, kind) {
      const el = $('mkMessage');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function mkCall(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { mkMsg('管理シークレットを入力してください', 'err'); $('connBody').hidden = false; return null; }
      const res = await fetch(MKT_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        // 503（送信無効）/ 409（対象変化）は理由をそのまま出す
        mkMsg(data.error || ('エラー: ' + res.status), 'err');
        return null;
      }
      return data;
    }

    let mkData = null;                 // 直近の customers 応答
    let mkCampaigns = [];              // カタログ
    let mkSendEnabled = false;         // live 送信が有効か（本番は既定 false）
    const mkSelected = new Set();      // 選択中の recordId

    // ── タブ切替（販売 / マーケティング / カムバック特典）──
    const TABS = [
      ['sales', 'tabSales', 'paneSales'],
      ['mkt', 'tabMkt', 'paneMkt'],
      ['comeback', 'tabCb', 'paneCb'],
    ];
    function showTab(which) {
      for (const [name, tabId, paneId] of TABS) {
        const on = name === which;
        $(paneId).hidden = !on;
        $(tabId).classList.toggle('on', on);
        $(tabId).setAttribute('aria-selected', String(on));
      }
      if (which === 'mkt' && mkCampaigns.length === 0) mkLoadCampaigns();
      if (which === 'comeback' && !cbCatalog) cbLoadOffers();
    }
    $('tabSales').addEventListener('click', () => showTab('sales'));
    $('tabMkt').addEventListener('click', () => showTab('mkt'));
    $('tabCb').addEventListener('click', () => showTab('comeback'));

    // ── キャンペーンカタログ ──
    async function mkLoadCampaigns() {
      const data = await mkCall({ action: 'campaigns' });
      if (!data) return;
      mkCampaigns = data.campaigns || [];
      mkSendEnabled = !!data.sendEnabled;
      const sel = $('mkCampaign');
      sel.innerHTML = '';
      for (const c of mkCampaigns) {
        const o = document.createElement('option');
        o.value = c.campaignId;
        // 使用可否と「運用テスト専用」を選択肢の時点で分かるようにする
        o.textContent = (c.usable ? '' : '⛔ ') + (c.testOnly ? '🧪 ' : '') + c.name + '（v' + c.version + '）'
          + (c.testOnly ? ' — 運用テスト専用' : '')
          + (c.usable ? '' : ' — 使用停止中');
        o.disabled = !c.usable;
        if (!c.usable && c.disabledReason) o.title = c.disabledReason;
        sel.appendChild(o);
      }
      // 既定選択は使用可能なものにする（停止中が先頭でも選ばれないように）
      const firstUsable = mkCampaigns.find((c) => c.usable);
      if (firstUsable) sel.value = firstUsable.campaignId;
      renderCampDesc();
      $('mkSendState').textContent = data.sendEnabled
        ? (data.dispatchEnabled
          ? '送信: 有効（キャンペーン配信も有効。実際にメールが届きます）'
          : '送信: キュー登録のみ有効（MARKETING_CAMPAIGN_DISPATCH_ENABLED が無効のため実送信されません）')
        : '送信: 無効（MARKETING_CAMPAIGN_ENABLED 未設定）。対象確認（dry-run）までは利用できます。';
      $('mkSendState').className = 'note' + (data.sendEnabled ? '' : ' off');
    }

    function currentCampaign() {
      const id = $('mkCampaign').value;
      return mkCampaigns.find((c) => c.campaignId === id) || null;
    }

    function renderCampDesc() {
      const c = currentCampaign();
      const el = $('mkCampDesc');
      el.innerHTML = '';
      if (!c) return;
      const rule = c.audienceRule || {};
      const limits = [];
      if (rule.contracts && rule.contracts.length) limits.push('契約状態: ' + rule.contracts.join(' / '));
      if (rule.plans && rule.plans.length) limits.push('プラン: ' + rule.plans.join(' / '));
      if (c.extraAudience) limits.push('追加条件: ' + c.extraAudience);

      // 運用テスト専用は顧客向けと混同しないよう最初に明示する
      if (c.testOnly) {
        const t = document.createElement('p');
        t.className = 'testonly';
        t.textContent = '🧪 運用テスト専用キャンペーンです。'
          + 'NEWSLETTER_TEST_RECIPIENTS に登録されたテスト受信者にのみ送信され、'
          + '一般顧客を選択しても送信対象になりません（対象を手動で広げることはできません）。';
        el.appendChild(t);
      }

      const line = document.createElement('span');
      line.textContent = c.description
        + (limits.length ? '　【対象条件】' + limits.join('・') + (rule.enforce ? '（条件外は自動で除外）' : '') : '');
      el.appendChild(line);

      // 使用停止中は理由を明示する（なぜ選べないのかを画面で完結させる）
      if (!c.usable) {
        const warn = document.createElement('p');
        warn.className = 'blocker';
        warn.textContent = '⛔ 使用停止中: ' + (c.disabledReason || '利用不可');
        el.appendChild(warn);
      }
    }
    $('mkCampaign').addEventListener('change', renderCampDesc);

    // ── 顧客一覧 ──
    async function mkLoad() {
      mkMsg('読み込み中…');
      const data = await mkCall({
        action: 'customers',
        contract: $('mkContract').value,
        plan: $('mkPlan').value,
        marketing: $('mkSendable').value,
        premiumPlus: $('mkPp').value,
        history: $('mkHistory').value,
      });
      if (!data) return;
      mkData = data;
      mkSendEnabled = !!data.sendEnabled;
      mkMsg('');
      mkRender();
    }

    const CONTRACT_LABEL = {
      active: '有効', expiring_soon: '期限間近', expired: '期限切れ',
      unknown: '不明', none: '契約なし',
    };
    const PLAN_LABEL = {
      premium_sanrenpuku: '三連複', premium: 'Premium', light: 'Light', free: 'Free',
    };

    function mkVisibleRows() {
      const q = $('mkQ').value.trim().toLowerCase();
      return (mkData?.rows || []).filter((r) => !q || String(r.email || '').toLowerCase().includes(q));
    }

    function mkRender() {
      if (!mkData) return;
      const seg = mkData.segments || {};
      const bar = $('mkSummary');
      bar.innerHTML = '';
      const items = [
        ['有効', seg.contract?.active || 0],
        ['期限間近', seg.contract?.expiring_soon || 0],
        ['期限切れ', seg.contract?.expired || 0],
        ['不明', seg.contract?.unknown || 0],
        ['Free', seg.contract?.none || 0],
        ['送信除外', seg.marketing?.suppressed || 0],
      ];
      items.forEach((it, i) => {
        if (i > 0) { const sp = document.createElement('span'); sp.className = 'sep'; sp.textContent = '|'; bar.appendChild(sp); }
        const b = document.createElement('span');
        b.className = 's';
        const kk = document.createElement('span'); kk.className = 'k'; kk.textContent = it[0];
        const vv = document.createElement('span'); vv.className = 'v'; vv.textContent = String(it[1]);
        b.appendChild(kk); b.appendChild(vv);
        bar.appendChild(b);
      });
      const sup = seg.suppression || {};
      const wd = seg.withdrawn || {};
      $('mkSummarySub').textContent =
        '全顧客 ' + (mkData.totalCustomers || 0) + ' 名　/　除外内訳: '
        + ['unsubscribed', 'blacklist', 'no_email', 'suspended', 'test_account']
          .map((k) => (mkData.labels?.suppression?.[k] || k) + ' ' + (sup[k] || 0)).join('・')
        // 退会は「除外」ではない。契約状態として別枠で件数を出す
        + '　/　退会（課金停止）' + (wd.total || 0) + ' 名（うち送信可能 ' + (wd.sendable || 0) + ' 名）';

      const rows = mkVisibleRows();
      const tb = $('mkRows');
      tb.innerHTML = '';
      for (const r of rows) {
        const tr = document.createElement('tr');
        if (!r.sendable) tr.className = 'row-suppressed';

        const c0 = document.createElement('td');
        c0.className = 'c-chk';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = mkSelected.has(r.recordId);
        cb.disabled = !r.sendable; // 送信できない相手は選べない（fail closed）
        cb.setAttribute('aria-label', '選択');
        cb.addEventListener('change', () => {
          if (cb.checked) mkSelected.add(r.recordId); else mkSelected.delete(r.recordId);
          mkRenderSelCount();
        });
        c0.appendChild(cb);
        tr.appendChild(c0);

        const c1 = td('c-cust', '', undefined);
        const em = document.createElement('span');
        em.className = 'em';
        em.textContent = r.email || '(メール未設定)';
        c1.appendChild(em);
        if (r.name) { const nm = document.createElement('span'); nm.className = 'sub'; nm.textContent = r.name; c1.appendChild(nm); }
        tr.appendChild(c1);

        // 契約状態と送信可否は別概念。退会（課金停止）は契約欄に履歴として出し、
        // 送信可否には影響させない。
        const cCon = td('c-contract', '契約', CONTRACT_LABEL[r.contract] || r.contract);
        cCon.firstChild.className = 'contract ' + r.contract;
        if (r.daysToExpiry != null) cCon.firstChild.title = '期限まで ' + r.daysToExpiry + ' 日';
        if (r.withdrawn) {
          const wb = document.createElement('span');
          wb.className = 'wd-badge';
          wb.textContent = '退会';
          wb.title = '課金停止（退会申請）。メール配信の可否とは別です';
          cCon.appendChild(wb);
        }
        tr.appendChild(cCon);

        tr.appendChild(td('c-plan', 'プラン', PLAN_LABEL[r.planGroup] || r.planGroup));

        const sendText = r.sendable
          ? '送信可能'
          : '除外: ' + r.suppressionReasons.map((x) => (mkData.labels?.suppression?.[x] || x)).join('・');
        tr.appendChild(td('c-send', '送信', sendText, r.sendable ? 'ok-txt' : 'ng-txt'));

        tr.appendChild(td('c-pp', 'Plus', r.premiumPlusEligibility || '未設定',
          r.premiumPlusEligibility ? '' : 'muted'));

        tr.appendChild(td('c-hist', '送信履歴',
          r.sentCount ? (r.sentCount + ' 回 / ' + fmtDate(r.lastSentAt)) : '—',
          r.sentCount ? '' : 'muted'));

        tb.appendChild(tr);
      }

      $('mkCount').textContent = '表示 ' + rows.length + ' 件 / 条件一致 ' + (mkData.matchedCount || 0) + ' 件'
        + (mkData.truncated ? '（上限を超えたため一部のみ表示）' : '');
      const emp = $('mkEmpty');
      emp.hidden = rows.length > 0;
      emp.textContent = '条件に一致する顧客はいません。';
      if (mkData.truncated) mkMsg('条件一致が多いため一部のみ表示しています。条件を絞ってください。', 'err');
      mkRenderSelCount();
    }

    function mkRenderSelCount() {
      $('mkSelCount').textContent = mkSelected.size + ' 名を選択中';
    }

    $('mkLoad').addEventListener('click', mkLoad);
    $('mkQ').addEventListener('input', mkRender);
    $('mkSelAll').addEventListener('click', () => {
      for (const r of mkVisibleRows()) if (r.sendable) mkSelected.add(r.recordId);
      mkRender();
    });
    $('mkSelNone').addEventListener('click', () => { mkSelected.clear(); mkRender(); });

    // ── モーダル（プレビュー / dry-run 確認）──
    function mkOpenModal(title) {
      $('mkModalTitle').textContent = title;
      $('mkBackdrop').hidden = false;
      lockScroll();
      $('mkModalBody').innerHTML = '';
      return $('mkModalBody');
    }
    function mkCloseModal() {
      $('mkBackdrop').hidden = true;
      if ($('dtBackdrop').hidden && $('pvBackdrop').hidden) unlockScroll();
    }
    $('mkModalClose').addEventListener('click', mkCloseModal);
    $('mkModalBack').addEventListener('click', mkCloseModal);
    $('mkBackdrop').addEventListener('click', (e) => { if (e.target === $('mkBackdrop')) mkCloseModal(); });

    // ── 本文プレビュー ──
    $('mkPreview').addEventListener('click', async () => {
      const c = currentCampaign();
      if (!c) { mkMsg('キャンペーンを選択してください', 'err'); return; }
      const data = await mkCall({ action: 'preview', campaignId: c.campaignId, sampleName: '山田' });
      if (!data) return;
      const body = mkOpenModal('本文プレビュー');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const h = document.createElement('h3'); h.textContent = '件名'; sec.appendChild(h);
      const sub = document.createElement('p'); sub.className = 'prev-subject'; sub.textContent = data.subject;
      sec.appendChild(sub);
      body.appendChild(sec);

      const sec2 = document.createElement('div'); sec2.className = 'dt-sec';
      const h2 = document.createElement('h3'); h2.textContent = '本文'; sec2.appendChild(h2);
      const frame = document.createElement('iframe');
      frame.className = 'prev-frame';
      frame.setAttribute('sandbox', ''); // スクリプト実行なし
      // 実際の受信環境に近い白地でメール本文だけを表示する（管理 UI の配色を混ぜない）
      frame.srcdoc = '<body style="margin:0;background:#fff;">' + data.html + '</body>';
      sec2.appendChild(frame);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec2.appendChild(note);
      body.appendChild(sec2);
    });

    // ── dry-run → 最終確認 → 送信 ──
    $('mkDryRun').addEventListener('click', async () => {
      const c = currentCampaign();
      if (!c) { mkMsg('キャンペーンを選択してください', 'err'); return; }
      if (!c.usable) { mkMsg('使用停止中のキャンペーンです: ' + (c.disabledReason || ''), 'err'); return; }
      if (mkSelected.size === 0) { mkMsg('送信対象を選択してください', 'err'); return; }
      mkMsg('対象を確認中…');
      const plan = await mkCall({
        action: 'dryRun', campaignId: c.campaignId, recordIds: [...mkSelected],
      });
      if (!plan) return;
      mkMsg('');
      mkRenderConfirm(c, plan);
    });

    function mkRenderConfirm(campaign, plan) {
      const body = mkOpenModal('送信内容の確認');

      const head = document.createElement('div'); head.className = 'dt-sec';
      const h = document.createElement('h3');
      h.textContent = (campaign.testOnly ? '🧪 ' : '') + campaign.name + ' v' + campaign.version;
      head.appendChild(h);
      if (campaign.testOnly) {
        const t = document.createElement('p'); t.className = 'testonly';
        t.textContent = '🧪 運用テスト専用。テスト受信者以外は自動的に除外されます。';
        head.appendChild(t);
      }
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '件名', plan.subject);
      kvRow(dl, '選択', plan.selected + ' 名');
      kvRow(dl, '除外', plan.excluded + ' 名');
      kvRow(dl, '実送信', plan.willSend + ' 名', plan.willSend > 0 ? 'strong-ok' : 'muted');
      head.appendChild(dl);
      body.appendChild(head);

      if (plan.excludedDetail && plan.excludedDetail.length) {
        const sec = document.createElement('div'); sec.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '除外の内訳'; sec.appendChild(h2);

        // 理由をグループへ束ねて出す（何がどれだけ落ちたかを分類で把握できるように）
        const GROUPS = [
          ['キャンペーン条件外', ['contract_mismatch', 'plan_mismatch', 'campaign_mismatch']],
          ['配信停止・除外リスト', ['unsubscribed', 'blacklist', 'soft_bounce', 'withdrawn', 'suspended', 'test_account', 'no_email', 'invalid_email']],
          ['最近マーケティング送信済み', ['recent_marketing_contact']],
          ['配信基盤の配信停止', ['provider_suppressed']],
          ['その他', ['already_delivered', 'duplicate', 'unknown_customer']],
        ];
        const byReason = {};
        for (const e of plan.excludedDetail) byReason[e.reason] = e;

        const ul = document.createElement('ul'); ul.className = 'exlist';
        let shown = 0;
        for (const g of GROUPS) {
          const label = g[0], reasons = g[1];
          const items = reasons.map((r) => byReason[r]).filter(Boolean);
          if (items.length === 0) continue;
          const total = items.reduce((s, e) => s + e.count, 0);
          shown += total;
          const li = document.createElement('li');
          const strong = document.createElement('strong');
          strong.textContent = label + '　' + total + ' 名';
          li.appendChild(strong);
          const sub = document.createElement('ul'); sub.className = 'exlist sub';
          for (const e of items) {
            const li2 = document.createElement('li');
            li2.textContent = e.label + '　' + e.count + ' 名';
            sub.appendChild(li2);
          }
          li.appendChild(sub);
          ul.appendChild(li);
        }
        // 分類に載らない理由が出ても件数を落とさない
        if (shown < plan.excluded) {
          const li = document.createElement('li');
          li.textContent = '未分類　' + (plan.excluded - shown) + ' 名';
          ul.appendChild(li);
        }
        sec.appendChild(ul);
        body.appendChild(sec);
      }

      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const h3 = document.createElement('h3'); h3.textContent = '送信'; sec3.appendChild(h3);
      const state = document.createElement('p'); state.className = 'note';
      state.textContent = plan.sendEnabled
        ? (plan.dispatchEnabled
          ? 'キャンペーン配信は有効です。実行すると実際にメールが配信されます。'
          : '実行するとキューに登録されますが、キャンペーン配信が無効なため実送信はされません。')
        : '送信は無効（MARKETING_CAMPAIGN_ENABLED 未設定）です。実行できません。';
      sec3.appendChild(state);

      // provider 側の配信停止をどれだけ確認できたかを明示する（確認できていないなら送らせない）
      const ps = plan.providerSuppression;
      if (ps) {
        const psNote = document.createElement('p');
        psNote.className = ps.available ? 'note' : 'blocker';
        psNote.textContent = ps.available
          ? `配信基盤の配信停止リスト ${ps.total} 件と照合済み`
          : `⚠️ 配信基盤の配信停止リストを確認できませんでした（${ps.error}）。この状態では送信できません。`;
        sec3.appendChild(psNote);
      }

      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-immediate';
      btn.textContent = plan.willSend + ' 名へ送信する';
      btn.disabled = !plan.sendEnabled || plan.willSend === 0;
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;      // 二重クリック防止
        const ok = window.confirm(
          campaign.name + ' v' + campaign.version + '\n\n'
          + '送信対象: ' + plan.selected + ' 名\n'
          + '除外: ' + plan.excluded + ' 名\n'
          + '実送信: ' + plan.willSend + ' 名\n\n'
          + 'この内容で送信しますか？'
        );
        if (!ok) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        btn.textContent = '送信登録中…';
        const out = await mkCall({
          action: 'send',
          campaignId: campaign.campaignId,
          recordIds: [...mkSelected],
          planFingerprint: plan.planFingerprint,   // 対象が変わっていたら Function 側が中止する
        });
        btn.dataset.busy = '';
        if (out) {
          mkMsg(out.notice || ('登録しました: ' + out.queued + ' 名'), 'ok');
          mkSelected.clear();
          mkCloseModal();
          await mkLoad();
        } else {
          btn.textContent = '再試行';
          btn.disabled = false;
        }
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    }

    // ── 送信履歴 ──
    $('mkHistoryBtn').addEventListener('click', async () => {
      const data = await mkCall({ action: 'history' });
      if (!data) return;
      const body = mkOpenModal('キャンペーン送信履歴');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      if (!data.runs.length) {
        sec.textContent = '送信履歴はまだありません。';
      } else {
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const r of data.runs) {
          const li = document.createElement('li');
          li.textContent = r.campaignType + '　登録 ' + r.queued + ' / 処理済 ' + r.sent
            + ' / 失敗 ' + r.failed + ' / スキップ ' + r.skipped + '　' + fmtDate(r.lastAt);
          ul.appendChild(li);
        }
        sec.appendChild(ul);
      }
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec.appendChild(note);
      body.appendChild(sec);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$('mkBackdrop').hidden) mkCloseModal();
    });

    // ══════════════════════════════════════════════════════════════
    //  カムバック特典（無料 entitlement の付与）
    //  ⚠️ メール送信とは別機能。ここから 1 通もメールを送らない。
    //  ⚠️ 変更するのは特典専用フィールドのみ。課金・契約・Plus 販売資格は触らない。
    // ══════════════════════════════════════════════════════════════
    const CB_API = '/.netlify/functions/admin-comeback-grants';

    let cbData = null;                 // 直近の customers 応答
    let cbCatalog = null;              // 特典カタログ（Light / Premium無料 / Premium割引）
    let cbWriteEnabled = false;        // 実行が有効か（本番は既定 false）
    let cbLastOperationId = '';        // 直近の dry-run / 実行の操作 ID（再開・突合用）
    const cbSelected = new Set();      // 選択中の recordId

    function cbMsg(text, kind) {
      const el = $('cbMessage');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function cbCall(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { cbMsg('管理シークレットを入力してください', 'err'); $('connBody').hidden = false; return null; }
      const res = await fetch(CB_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        // 503（gate 無効）/ 409（対象変化）/ 502（部分失敗）は理由をそのまま出す
        cbMsg((data.error || ('エラー: ' + res.status)) + (data.howToRecover ? '　' + data.howToRecover : ''), 'err');
        return null;
      }
      return data;
    }

    function cbFillSelect(id, offers, noneLabel) {
      const sel = $(id);
      sel.innerHTML = '';
      const none = document.createElement('option');
      none.value = 'none';
      none.textContent = noneLabel;
      sel.appendChild(none);
      for (const o of offers) {
        const opt = document.createElement('option');
        opt.value = o.offerId;
        opt.textContent = o.name;
        opt.dataset.customDays = o.requiresCustomDays ? '1' : '';
        opt.dataset.customPrice = o.requiresCustomPrice ? '1' : '';
        opt.dataset.kind = o.kind;
        opt.dataset.regularPrice = String(o.regularPrice);
        sel.appendChild(opt);
      }
    }

    async function cbLoadOffers() {
      const data = await cbCall({ action: 'offers' });
      if (!data) return;
      cbCatalog = data;
      cbWriteEnabled = !!data.writeEnabled;

      cbFillSelect('cbLightOffer', data.lightOffers, 'なし');
      // Premium は「無料付与」と「割引購入」を 1 つのセレクトに分けて入れる（種類は option に持たせる）
      const premium = [...data.premiumGrantOffers, ...data.premiumPurchaseOffers];
      cbFillSelect('cbPremiumOffer', premium, 'なし');

      // 主要施策を既定値に（Light 永久無料 ＋ Premium 30日無料）
      if (data.lightOffers.some((o) => o.offerId === 'light-lifetime-free')) {
        $('cbLightOffer').value = 'light-lifetime-free';
      }
      cbRenderOfferDesc();
      $('cbGateState').textContent = data.notice || '';
      $('cbGateState').className = 'note' + (data.writeEnabled ? '' : ' off');
    }

    function cbSelectedOption(id) {
      const sel = $(id);
      return sel.options[sel.selectedIndex] || null;
    }

    /** 選択内容 → API へ渡す payload（任意日数・任意価格を含む） */
    function cbSelectionPayload() {
      const light = $('cbLightOffer').value;
      const premium = $('cbPremiumOffer').value;
      const out = {};
      if (light && light !== 'none') {
        out.lightOfferId = light;
        if (cbSelectedOption('cbLightOffer').dataset.customDays) {
          out.lightCustomDays = Number($('cbLightDays').value);
        }
      }
      if (premium && premium !== 'none') {
        out.premiumOfferId = premium;
        const opt = cbSelectedOption('cbPremiumOffer');
        if (opt.dataset.customDays) out.premiumCustomDays = Number($('cbPremiumDays').value);
        if (opt.dataset.customPrice) out.premiumCustomPrice = Number($('cbPremiumPrice').value);
      }
      return out;
    }

    /** 任意入力欄の出し分け＋価格の内訳表示 */
    function cbRenderOfferDesc() {
      const lightOpt = cbSelectedOption('cbLightOffer');
      const premiumOpt = cbSelectedOption('cbPremiumOffer');
      $('cbLightDaysWrap').hidden = !(lightOpt && lightOpt.dataset.customDays);
      $('cbPremiumDaysWrap').hidden = !(premiumOpt && premiumOpt.dataset.customDays);
      $('cbPremiumPriceWrap').hidden = !(premiumOpt && premiumOpt.dataset.customPrice);

      // 価格の内訳（通常価格 / 割引 / 特別価格 / 無料）
      const box = $('cbPriceBox');
      const dl = $('cbPriceKv');
      dl.innerHTML = '';
      const isPurchase = premiumOpt && premiumOpt.dataset.kind === 'purchase_offer';
      if (isPurchase) {
        const regular = Number(premiumOpt.dataset.regularPrice) || 0;
        const price = premiumOpt.dataset.customPrice
          ? Number($('cbPremiumPrice').value)
          : null;
        kvRow(dl, '通常価格', '¥' + regular.toLocaleString());
        if (price !== null) {
          const off = regular > 0 ? Math.round((1 - price / regular) * 100) : 0;
          kvRow(dl, '特別価格', '¥' + (price || 0).toLocaleString(), 'strong-ok');
          kvRow(dl, '割引率', off + '%OFF');
        } else {
          kvRow(dl, '特別価格', 'dry-run で確定します');
        }
        kvRow(dl, '権限', '購入条件のみ（支払い完了まで権限は付与されません）');
        box.hidden = false;
      } else if (premiumOpt && premiumOpt.value !== 'none') {
        kvRow(dl, '料金', '無料（課金は発生しません）', 'strong-ok');
        box.hidden = false;
      } else {
        box.hidden = true;
      }

      const parts = [];
      if (lightOpt && lightOpt.value !== 'none') parts.push('Light: ' + lightOpt.textContent);
      if (premiumOpt && premiumOpt.value !== 'none') parts.push('Premium: ' + premiumOpt.textContent);
      $('cbOfferDesc').textContent = parts.length ? parts.join('　/　') : '特典を選択してください。';
    }
    for (const id of ['cbLightOffer', 'cbPremiumOffer', 'cbLightDays', 'cbPremiumDays', 'cbPremiumPrice']) {
      $(id).addEventListener('change', cbRenderOfferDesc);
      $(id).addEventListener('input', cbRenderOfferDesc);
    }

    async function cbLoad() {
      cbMsg('読み込み中…');
      const data = await cbCall({
        action: 'customers',
        contract: $('cbContract').value,
        plan: $('cbPlan').value,
        withdrawn: $('cbWithdrawn').value,
        promo: $('cbPromo').value,
        grantable: $('cbGrantable').value,
        history: $('cbHistory').value,
      });
      if (!data) return;
      cbData = data;
      cbWriteEnabled = !!data.writeEnabled;
      cbMsg('');
      cbRender();
    }

    function cbVisibleRows() {
      const q = $('cbQ').value.trim().toLowerCase();
      return (cbData?.rows || []).filter((r) => !q || String(r.email || '').toLowerCase().includes(q));
    }

    function cbRender() {
      if (!cbData) return;
      const s = cbData.summary || {};
      const bar = $('cbSummary');
      bar.innerHTML = '';
      const items = [
        ['期限切れ', s.contract?.expired || 0],
        ['契約なし', s.contract?.none || 0],
        ['退会あり', s.withdrawn || 0],
        ['特典あり', (s.promo?.light || 0) + (s.promo?.trialActive || 0)],
        ['付与できる', s.grantable || 0],
      ];
      items.forEach((it, i) => {
        if (i > 0) { const sp = document.createElement('span'); sp.className = 'sep'; sp.textContent = '|'; bar.appendChild(sp); }
        const b = document.createElement('span');
        b.className = 's';
        const kk = document.createElement('span'); kk.className = 'k'; kk.textContent = it[0];
        const vv = document.createElement('span'); vv.className = 'v'; vv.textContent = String(it[1]);
        b.appendChild(kk); b.appendChild(vv);
        bar.appendChild(b);
      });
      const p = s.promo || {};
      $('cbSummarySub').textContent =
        '全顧客 ' + (cbData.totalCustomers || 0) + ' 名　/　特典内訳: Light 永久無料 ' + (p.light || 0)
        + '・Premium 無料期間中 ' + (p.trialActive || 0) + '・Premium 無料 終了 ' + (p.trialExpired || 0)
        + (p.inconsistent ? '・⚠️ 不整合 ' + p.inconsistent : '');

      const rows = cbVisibleRows();
      const tb = $('cbRows');
      tb.innerHTML = '';
      for (const r of rows) {
        const tr = document.createElement('tr');
        if (!r.grantable) tr.className = 'row-suppressed';

        const c0 = document.createElement('td');
        c0.className = 'c-chk';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = cbSelected.has(r.recordId);
        cb.disabled = !r.grantable; // 付与しても使えない相手は選べない（fail closed）
        cb.setAttribute('aria-label', '選択');
        cb.addEventListener('change', () => {
          if (cb.checked) cbSelected.add(r.recordId); else cbSelected.delete(r.recordId);
          cbRenderSelCount();
        });
        c0.appendChild(cb);
        tr.appendChild(c0);

        const c1 = td('c-cust', '', undefined);
        const em = document.createElement('span');
        em.className = 'em';
        em.textContent = r.email || '(メール未設定)';
        c1.appendChild(em);
        if (r.name) { const nm = document.createElement('span'); nm.className = 'sub'; nm.textContent = r.name; c1.appendChild(nm); }
        tr.appendChild(c1);

        const cCon = td('c-contract', '契約', CONTRACT_LABEL[r.contract] || r.contract);
        cCon.firstChild.className = 'contract ' + r.contract;
        if (r.withdrawn) {
          const wb = document.createElement('span');
          wb.className = 'wd-badge';
          wb.textContent = '退会';
          wb.title = '課金停止（退会申請）。この状態ではログインできないため特典を付与しません';
          cCon.appendChild(wb);
        }
        tr.appendChild(cCon);

        tr.appendChild(td('c-plan', 'プラン', PLAN_LABEL[r.planGroup] || r.planGroup));
        tr.appendChild(td('c-promo', '現在の特典', r.promoText,
          r.promoInconsistent ? 'ng-txt' : (r.promoText === '特典なし' ? 'muted' : 'ok-txt')));
        tr.appendChild(td('c-grantable', '付与可否',
          r.grantable ? '付与できる' : ('付与不可: ' + (r.grantBlockedLabel || '')),
          r.grantable ? 'ok-txt' : 'ng-txt'));

        tb.appendChild(tr);
      }

      $('cbCount').textContent = '表示 ' + rows.length + ' 件 / 条件一致 ' + (cbData.matchedCount || 0) + ' 件'
        + (cbData.truncated ? '（上限を超えたため一部のみ表示）' : '');
      const emp = $('cbEmpty');
      emp.hidden = rows.length > 0;
      emp.textContent = '条件に一致する顧客はいません。';
      cbRenderSelCount();
    }

    function cbRenderSelCount() {
      $('cbSelCount').textContent = cbSelected.size + ' 名を選択中';
    }

    $('cbLoad').addEventListener('click', cbLoad);
    $('cbQ').addEventListener('input', cbRender);
    $('cbSelAll').addEventListener('click', () => {
      for (const r of cbVisibleRows()) if (r.grantable) cbSelected.add(r.recordId);
      cbRender();
    });
    $('cbSelNone').addEventListener('click', () => { cbSelected.clear(); cbRender(); });

    // ── モーダル ──
    function cbOpenModal(title) {
      $('cbModalTitle').textContent = title;
      $('cbBackdrop').hidden = false;
      lockScroll();
      $('cbModalBody').innerHTML = '';
      return $('cbModalBody');
    }
    function cbCloseModal() {
      $('cbBackdrop').hidden = true;
      if ($('dtBackdrop').hidden && $('pvBackdrop').hidden && $('mkBackdrop').hidden) unlockScroll();
    }
    $('cbModalClose').addEventListener('click', cbCloseModal);
    $('cbModalBack').addEventListener('click', cbCloseModal);
    $('cbBackdrop').addEventListener('click', (e) => { if (e.target === $('cbBackdrop')) cbCloseModal(); });

    // ── 文面プレビュー（送信しない）──
    $('cbPreviewBtn').addEventListener('click', async () => {
      const sel = cbSelectionPayload();
      if (!sel.lightOfferId && !sel.premiumOfferId) { cbMsg('特典を選択してください', 'err'); return; }
      const data = await cbCall({ action: 'preview', ...sel });
      if (!data) return;
      const body = cbOpenModal('案内文面プレビュー');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '特典', data.selection);
      kvRow(dl, '件名', data.subject);
      sec.appendChild(dl);
      const pre = document.createElement('pre');
      pre.className = 'prev-body';
      pre.textContent = data.body;
      sec.appendChild(pre);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec.appendChild(note);
      body.appendChild(sec);
    });

    // ── dry-run → 最終確認 → 実行 ──
    $('cbDryRun').addEventListener('click', async () => {
      const sel = cbSelectionPayload();
      if (!sel.lightOfferId && !sel.premiumOfferId) { cbMsg('特典を選択してください', 'err'); return; }
      if (cbSelected.size === 0) { cbMsg('対象を選択してください', 'err'); return; }
      cbMsg('変更内容を確認中…');
      const plan = await cbCall({
        action: 'dryRun', ...sel, recordIds: [...cbSelected],
        // 直前の操作をやり直す場合は同じ operationId を引き継ぐ（冪等な再開）
        operationId: cbLastOperationId || undefined,
      });
      if (!plan) return;
      cbLastOperationId = plan.operationId;
      cbMsg('');
      cbRenderConfirm(sel, plan);
    });

    function cbRenderConfirm(sel, plan) {
      const body = cbOpenModal('実行内容の確認');

      const head = document.createElement('div'); head.className = 'dt-sec';
      const h = document.createElement('h3'); h.textContent = plan.selection;
      head.appendChild(h);
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '選択', plan.selected + ' 名');
      kvRow(dl, '無料特典を付与', plan.willGrant + ' 名', plan.willGrant > 0 ? 'strong-ok' : 'muted');
      if (plan.purchaseOffer) {
        kvRow(dl, '割引オファーを発行', plan.willOffer + ' 名', plan.willOffer > 0 ? 'strong-ok' : 'muted');
        kvRow(dl, '価格', '通常 ¥' + plan.purchaseOffer.regularPrice.toLocaleString()
          + ' → ¥' + plan.purchaseOffer.offerPrice.toLocaleString()
          + '（' + plan.purchaseOffer.discountPercent + '%OFF）');
        kvRow(dl, '権限', '付与しません（支払い完了後に既存の入金確認フローが昇格します）');
      }
      kvRow(dl, '対象外', plan.skipped + ' 名');
      kvRow(dl, '操作 ID', plan.operationId);
      head.appendChild(dl);
      body.appendChild(head);

      // 内訳（Light 何件 / Premium 何件 / オファー何件）
      const partsSec = document.createElement('div'); partsSec.className = 'dt-sec';
      const ph = document.createElement('h3'); ph.textContent = '内訳'; partsSec.appendChild(ph);
      const pul = document.createElement('ul'); pul.className = 'exlist';
      const parts = plan.parts || {};
      for (const [label, n] of [
        ['Light 無料を新規付与', parts.lightGrant || 0],
        ['Premium 無料を新規付与', parts.premiumGrant || 0],
        ['割引オファーを発行', parts.purchaseOffer || 0],
      ]) {
        const li = document.createElement('li');
        li.textContent = label + '　' + n + ' 名';
        pul.appendChild(li);
      }
      for (const d of (plan.partSkipDetail || [])) {
        const li = document.createElement('li');
        li.textContent = d.partLabel + ' は付与しない（' + d.label + '）　' + d.count + ' 名';
        pul.appendChild(li);
      }
      partsSec.appendChild(pul);
      body.appendChild(partsSec);

      if (plan.skippedDetail && plan.skippedDetail.length) {
        const sec = document.createElement('div'); sec.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '対象外の内訳'; sec.appendChild(h2);
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const d of plan.skippedDetail) {
          const li = document.createElement('li');
          li.textContent = d.label + '　' + d.count + ' 名';
          ul.appendChild(li);
        }
        sec.appendChild(ul);
        body.appendChild(sec);
      }

      if (plan.preview && plan.preview.length) {
        const sec = document.createElement('div'); sec.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '顧客ごとの変更（現在 → 付与後）'; sec.appendChild(h2);
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const p of plan.preview) {
          const li = document.createElement('li');
          const strong = document.createElement('strong');
          strong.textContent = p.email;
          li.appendChild(strong);
          const sub = document.createElement('ul'); sub.className = 'exlist sub';
          const l1 = document.createElement('li'); l1.textContent = '現在: ' + p.before; sub.appendChild(l1);
          const l2 = document.createElement('li'); l2.textContent = '付与後: ' + p.after; sub.appendChild(l2);
          if (p.offer) {
            const l3 = document.createElement('li');
            l3.textContent = '割引オファー: ' + p.offer + '（権限は付与されません）';
            sub.appendChild(l3);
          }
          for (const part of (p.partial || [])) {
            const l4 = document.createElement('li');
            l4.textContent = '※ ' + part.part + ' は付与しません（' + part.label + '）';
            sub.appendChild(l4);
          }
          li.appendChild(sub);
          ul.appendChild(li);
        }
        sec.appendChild(ul);
        if (plan.previewTruncated) {
          const note = document.createElement('p'); note.className = 'note';
          note.textContent = '※ 表示は先頭 50 名のみです（実行は対象全員に行われます）。';
          sec.appendChild(note);
        }
        body.appendChild(sec);
      }

      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const h3 = document.createElement('h3'); h3.textContent = '実行'; sec3.appendChild(h3);
      const state = document.createElement('p'); state.className = 'note';
      state.textContent = plan.writeEnabled
        ? '実行すると無料特典は即時に反映されます。課金・入金状態・メールは変わりません。'
        : '実行は無効（COMEBACK_GRANT_FIELDS_READY / COMEBACK_OFFER_TABLE_READY / COMEBACK_GRANT_ENABLED 未設定）です。';
      sec3.appendChild(state);
      const mailNote = document.createElement('p'); mailNote.className = 'note';
      mailNote.textContent = '📪 この操作でメールは送信されません。案内はマーケティングタブから別途送ってください。';
      sec3.appendChild(mailNote);

      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-immediate';
      const total = (plan.willGrant || 0) + (plan.willOffer || 0);
      btn.textContent = '実行する（付与 ' + plan.willGrant + ' 名 / オファー ' + plan.willOffer + ' 名）';
      btn.disabled = !plan.writeEnabled || total === 0;
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;      // 二重クリック防止
        const ok = window.confirm(
          plan.selection + '\n\n'
          + '対象: ' + plan.selected + ' 名\n'
          + '無料特典を付与: ' + plan.willGrant + ' 名\n'
          + '割引オファーを発行: ' + plan.willOffer + ' 名\n'
          + '対象外: ' + plan.skipped + ' 名\n\n'
          + 'この内容で実行しますか？（メールは送信されません）'
        );
        if (!ok) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        btn.textContent = '実行中…';
        const out = await cbCall({
          action: 'apply',
          ...sel,
          recordIds: [...cbSelected],
          operationId: plan.operationId,          // 冪等性の鍵（再実行しても二重付与しない）
          planFingerprint: plan.planFingerprint,  // 対象が変わっていたら Function 側が中止する
        });
        btn.dataset.busy = '';
        if (out) {
          cbMsg(out.notice || ('実行しました: 付与 ' + out.granted + ' 名 / オファー ' + out.offersIssued + ' 名'), 'ok');
          if (out.offerTokens && out.offerTokens.length) cbRenderOfferTokens(out);
          cbSelected.clear();
          cbCloseModal();
          await cbLoad();
        } else {
          btn.textContent = '再試行（同じ操作 ID で安全に再実行できます）';
          btn.disabled = false;
        }
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    }

    /** 発行した専用 URL（生トークンはこの応答にしか無い） */
    function cbRenderOfferTokens(out) {
      const body = cbOpenModal('発行した専用 URL');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const note = document.createElement('p'); note.className = 'note';
      note.textContent = 'この URL は対象のお客様だけが利用できます（署名付き・メールアドレス一致が必要）。'
        + '台帳にはハッシュしか保存されないため、この画面を閉じると再表示できません。';
      sec.appendChild(note);
      const ul = document.createElement('ul'); ul.className = 'exlist';
      for (const t of out.offerTokens) {
        const li = document.createElement('li');
        li.textContent = t.url + '（〜' + String(t.expiresAt).slice(0, 10) + '）';
        ul.appendChild(li);
      }
      sec.appendChild(ul);
      body.appendChild(sec);
    }

    // ── 取り消し（無料権利だけ）──
    $('cbRevokeBtn').addEventListener('click', async () => {
      if (cbSelected.size === 0) { cbMsg('取り消す対象を選択してください', 'err'); return; }
      const tiers = [];
      if (window.confirm('Light の無料権利を取り消しますか？\n（キャンセルすると Premium だけを対象にします）')) {
        tiers.push('light');
      }
      if (window.confirm('Premium の無料権利を取り消しますか？')) tiers.push('premium');
      if (tiers.length === 0) { cbMsg('取り消す特典が選択されていません', 'err'); return; }
      const reason = window.prompt('取り消し理由（管理者メモ・任意）') || '';

      const plan = await cbCall({
        action: 'revokeDryRun', tiers, recordIds: [...cbSelected], reason,
      });
      if (!plan) return;

      const body = cbOpenModal('取り消し内容の確認');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '対象', (plan.tierLabels || []).join(' / '));
      kvRow(dl, '選択', plan.selected + ' 名');
      kvRow(dl, '取り消し', plan.willRevoke + ' 名', plan.willRevoke > 0 ? 'strong-ok' : 'muted');
      kvRow(dl, '対象外', plan.skipped + ' 名');
      sec.appendChild(dl);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = plan.notice || '';
      sec.appendChild(note);
      body.appendChild(sec);

      if (plan.preview && plan.preview.length) {
        const sec2 = document.createElement('div'); sec2.className = 'dt-sec';
        const h2 = document.createElement('h3'); h2.textContent = '顧客ごとの変更'; sec2.appendChild(h2);
        const ul = document.createElement('ul'); ul.className = 'exlist';
        for (const p of plan.preview) {
          const li = document.createElement('li');
          li.textContent = p.email + '　' + p.before + ' → ' + p.after;
          ul.appendChild(li);
        }
        sec2.appendChild(ul);
        body.appendChild(sec2);
      }

      const sec3 = document.createElement('div'); sec3.className = 'dt-sec danger';
      const ops = document.createElement('div'); ops.className = 'ops';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'b-blocked';
      btn.textContent = plan.willRevoke + ' 名の無料特典を取り消す';
      btn.disabled = !cbWriteEnabled || plan.willRevoke === 0;
      btn.addEventListener('click', async () => {
        if (btn.dataset.busy === '1') return;
        if (!window.confirm('無料特典を取り消します。有料契約・三連複買い切り・発行済みオファーは変わりません。よろしいですか？')) return;
        btn.dataset.busy = '1';
        btn.disabled = true;
        const out = await cbCall({
          action: 'revoke', tiers, recordIds: [...cbSelected],
          planFingerprint: plan.planFingerprint, reason,
        });
        btn.dataset.busy = '';
        if (out) {
          cbMsg('取り消しました: ' + out.revoked + ' 名', 'ok');
          cbSelected.clear();
          cbCloseModal();
          await cbLoad();
        } else {
          btn.disabled = false;
        }
      });
      ops.appendChild(btn);
      sec3.appendChild(ops);
      body.appendChild(sec3);
    });

    // ── 前回操作の突合（read-only）──
    $('cbReconcileBtn').addEventListener('click', async () => {
      const op = window.prompt('突合する操作 ID', cbLastOperationId || '') || '';
      if (!op.trim()) return;
      const data = await cbCall({
        action: 'reconcile', operationId: op.trim(),
        recordIds: cbSelected.size ? [...cbSelected] : undefined,
      });
      if (!data) return;
      const body = cbOpenModal('前回操作の突合');
      const sec = document.createElement('div'); sec.className = 'dt-sec';
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '操作 ID', data.operationId);
      kvRow(dl, '確認した顧客', data.total + ' 名');
      kvRow(dl, '適用済み', data.applied + ' 名', 'strong-ok');
      kvRow(dl, '未適用', data.missing + ' 名', data.missing > 0 ? 'ng-txt' : 'muted');
      sec.appendChild(dl);
      const note = document.createElement('p'); note.className = 'note'; note.textContent = data.notice;
      sec.appendChild(note);
      body.appendChild(sec);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$('cbBackdrop').hidden) cbCloseModal();
    });
  })();
</script>
