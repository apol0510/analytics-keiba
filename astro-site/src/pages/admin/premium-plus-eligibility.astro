    // ── 管理者プレビュー（read-only）──
    let pvRecordId = null;
    let pvOptionsReady = false;

    function fillOptions(sel, items, valueKey, current) {
      if (sel.options.length) return;
      for (const it of items) {
        const o = document.createElement('option');
        o.value = it[valueKey] === null ? '' : String(it[valueKey]);
        o.textContent = it.label;
        sel.appendChild(o);
      }
      sel.value = current == null ? '' : current;
    }
    const yn = (b) => (b ? 'はい' : 'いいえ');
    const ynCls = (b) => (b ? 'yes' : 'no');

    // 「404 のまま」を誤読させないための説明。何を操作すれば表示されるかまで書く
    function renderPreviewHint(p) {
      const hint = $('pvHint');
      let text = '';
      if (!p.showProductPage) {
        if (p.eligibility !== 'eligible') {
          const label = p.eligibility === 'blocked' ? '販売対象外' : '保留';
          text = 'この会員は「' + label + '」のため、PHASE を切り替えても商品ページは表示されません。'
            + '先に詳細パネルで「段階公開で販売可」にする必要があります（PHASE の切替はプレビュー内だけの確認で、実データは変わりません）。';
        } else if (p.simulated.phaseDaysAgo === null) {
          text = '実データでは PHASE ' + p.phase + ' のため、会員にはまだ何も表示されません（正常です）。'
            + '段階公開が進んだあとの見え方を確認するには、上の「段階公開の表示確認」で PHASE 2〜4 を選んでください。';
        }
      }
      hint.textContent = text;
      hint.hidden = !text;
    }

    function renderPreview(data) {
      const p = data.preview;
      renderPreviewHint(p);
      const body = $('pvBody');
      body.innerHTML = '';

      const top = document.createElement('div'); top.className = 'pv-top';
      const cell = (k, v, cls) => {
        const c = document.createElement('div'); c.className = 'cell';
        const kk = document.createElement('div'); kk.className = 'k'; kk.textContent = k;
        const vv = document.createElement('div'); vv.className = 'v' + (cls ? ' ' + cls : ''); vv.textContent = v;
        c.appendChild(kk); c.appendChild(vv); top.appendChild(c);
      };
      cell('PHASE', 'PHASE ' + p.phase + (p.simulated.phaseDaysAgo === null ? '' : '（シミュ）'));
      cell('受付状態', p.intakeStatus || '（PHASE 4 未満）');
      cell('商品ページ', p.showProductPage ? '表示 (200)' : '非表示 (404)', ynCls(p.showProductPage));
      cell('価格・CTA', p.showPurchaseCta ? '表示' : '非表示', ynCls(p.showPurchaseCta));
      cell('購入可否', yn(p.purchaseEnabled), ynCls(p.purchaseEnabled));
      body.appendChild(top);

      const mk = (title) => { const s = document.createElement('div'); s.className = 'pv-sec'; const h = document.createElement('h3'); h.textContent = title; s.appendChild(h); body.appendChild(s); return s; };

      const mock = mk('会員に見える表示（Premium Plus 商品ページ 相当）');
      const box = document.createElement('div'); box.className = 'pv-mock';
      if (!p.showProductPage) {
        const n = document.createElement('p'); n.className = 'pv-none';
        n.textContent = p.showTeaser ? '商品ページ: 404（会員ページに予告カードのみ表示）' : '商品ページ: 404（予告も出ません）';
        box.appendChild(n);
      } else {
        if (p.intakeStatus) {
          const t = document.createElement('div'); t.className = 'pv-intake-t'; t.textContent = p.intakeTitle || '';
          const s2 = document.createElement('div'); s2.className = 'pv-intake-s'; s2.textContent = p.intakeStatus;
          box.appendChild(t); box.appendChild(s2);
          if (p.intakeNote) { const nt = document.createElement('div'); nt.className = 'pv-intake-n'; nt.textContent = p.intakeNote; box.appendChild(nt); }
        }
        const pr = document.createElement('div'); pr.className = 'pv-price';
        pr.textContent = p.priceVisible ? '価格ブロック: 表示される' : '価格ブロック: 非表示（受付準備中）';
        box.appendChild(pr);
        const cta = document.createElement('span');
        cta.className = 'pv-cta' + (p.ctaEnabled ? '' : ' off');
        cta.textContent = p.showPurchaseCta ? (p.ctaEnabled ? '銀行振込で購入する（操作可）' : '銀行振込で購入する（操作不可）') : '受付準備中';
        box.appendChild(cta);
      }
      mock.appendChild(box);
      const vis = document.createElement('p'); vis.className = 'pv-vis'; vis.textContent = data.visibility || '';
      mock.appendChild(vis);

      const d1 = mk('判定');
      const dl1 = document.createElement('dl'); dl1.className = 'kv';
      kvRow(dl1, '評価時刻(JST)', p.evaluatedAtJst + (p.simulated.isSimulatedTime ? '（シミュレーション）' : ''));
      kvRow(dl1, 'route', p.routeLabel ? p.routeLabel + '（' + p.route + '）' : p.route);
      kvRow(dl1, '三連複', p.sanrenpukuLabel || (p.hasSanrenpuku ? '保有' : 'なし'),
        p.hasSanrenpuku ? '' : 'muted');
      kvRow(dl1, 'Premium加入からの経過', p.daysSincePremiumText || '—',
        p.daysSincePremium == null ? 'muted' : '');
      kvRow(dl1, '顧客に表示されるCTA', p.upsellChannelLabel || '—');
      kvRow(dl1, 'CTA の理由', p.upsellReasonText || p.upsellReason || '—', 'muted');
      kvRow(dl1, 'PremiumPlusEligibility', p.eligibility);
      kvRow(dl1, 'PremiumPlusReleaseOverride', p.releaseOverride || '(空)');
      kvRow(dl1, 'overrideApplied', yn(p.overrideApplied), ynCls(p.overrideApplied));
      kvRow(dl1, '状態', p.state);
      kvRow(dl1, 'anchor(JST)', p.anchorJst || '(なし)');
      kvRow(dl1, 'intake', p.intake || '(PHASE 4 未満)');
      d1.appendChild(dl1);

      const d2 = mk('表示フラグ');
      const dl2 = document.createElement('dl'); dl2.className = 'kv';
      kvRow(dl2, 'showTeaser', yn(p.showTeaser), ynCls(p.showTeaser));
      kvRow(dl2, 'showProductPage', yn(p.showProductPage), ynCls(p.showProductPage));
      kvRow(dl2, 'showPurchaseCta', yn(p.showPurchaseCta), ynCls(p.showPurchaseCta));
      kvRow(dl2, 'purchaseEnabled', yn(p.purchaseEnabled), ynCls(p.purchaseEnabled));
      kvRow(dl2, '商品ページ HTTP', p.productPageStatus);
      if (p.canBrowseWhenClosed !== null) kvRow(dl2, 'CLOSED でも閲覧可', yn(p.canBrowseWhenClosed), ynCls(p.canBrowseWhenClosed));
      d2.appendChild(dl2);
    }

    async function refreshPreview() {
      if (!pvRecordId) return;
      $('pvHint').hidden = true;
      $('pvBody').textContent = '読み込み中…';
      const data = await call({
        action: 'preview',
        recordId: pvRecordId,
        atMin: $('pvTime').value === '' ? null : Number($('pvTime').value),
        phaseDaysAgo: $('pvPhase').value === '' ? null : Number($('pvPhase').value),
      });
      if (!data) { $('pvBody').textContent = '取得に失敗しました'; return; }
      if (!pvOptionsReady && data.options) {
        fillOptions($('pvTime'), data.options.times, 'atMin', '');
        fillOptions($('pvPhase'), data.options.phases, 'daysAgo', '');
        pvOptionsReady = true;
      }
      renderPreview(data);
    }

    function openPreview(recordId) {
      pvRecordId = recordId;
      $('pvBackdrop').hidden = false;
      lockScroll();
      $('pvScroll').scrollTop = 0;
      refreshPreview();
    }
    // 閉じると詳細パネルに戻る（詳細も閉じていれば一覧へ）
    function closePreview() {
      $('pvBackdrop').hidden = true;
      pvRecordId = null;
      if ($('dtBackdrop').hidden) unlockScroll();
    }

    $('pvClose').addEventListener('click', closePreview);
    $('pvBack').addEventListener('click', closePreview);
    $('pvBackdrop').addEventListener('click', (e) => { if (e.target === $('pvBackdrop')) closePreview(); });
    $('pvTime').addEventListener('change', refreshPreview);
    $('pvPhase').addEventListener('change', refreshPreview);
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!$('pvBackdrop').hidden) { closePreview(); return; }
      if (!$('dtBackdrop').hidden) closeDetail();
    });

    $('reload').addEventListener('click', load);
    $('q').addEventListener('input', render);
    $('fState').addEventListener('change', render);
    $('fRoute').addEventListener('change', render);
    $('fUpsell').addEventListener('change', render);
    $('fKind').addEventListener('change', render);

    // ══════════════════════════════════════════════════════════════
    //  顧客マーケティング（AK 独自 / KMA とは無関係）
    //  この領域は Premium Plus の販売資格を一切変更しない。呼ぶ API も別。
    // ══════════════════════════════════════════════════════════════
    const MKT_API = '/.netlify/functions/admin-marketing';

    function mkMsg(text, kind) {
      const el = $('mkMessage');
      el.textContent = text;
      el.className = 'msg' + (kind ? ' ' + kind : '');
    }

    async function mkCall(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { mkMsg('管理シークレットを入力してください', 'err'); $('connBody').hidden = false; return null; }
      const res = await fetch(MKT_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        // 503（送信無効）/ 409（対象変化）は理由をそのまま出す
        mkMsg(data.error || ('エラー: ' + res.status), 'err');
        return null;
      }
      return data;
    }

    let mkData = null;                 // 直近の customers 応答
    let mkCampaigns = [];              // カタログ
    let mkLabels = {};                 // 除外理由などの表示名（サーバーの単一源）
    let mkSendEnabled = false;         // live 送信が有効か（本番は既定 false）
    const mkSelected = new Set();      // 選択中の recordId

    /** 画面のフィルター値をまとめて読む（dry-run 失効判定にも使う） */
    function mkCurrentFilters() {
      const q = $('mkQ') ? String($('mkQ').value || '') : '';
      const s = multiValues(MK_MULTI_IDS);
      return {
        q, contract: s.mkContract, plan: s.mkPlan, sendable: s.mkSendable,
        pp: s.mkPp, history: s.mkHistory, offer: s.mkOfferState, offerWindow: s.mkOfferWindow,
        promo: s.mkPromoState, frequency: s.mkFrequency, lastLogin: s.mkLastLogin,
      };
    }
    /** 適用中の条件数を出す（今どれだけ絞っているかを見せる） */
    function mkRenderFilterCount() {
      const el = $('mkFilterCount');
      if (!el) return;
      // チップと同じ数え方（**選んだ値の数**）にする。
      // 項目数と値の数を並べて出すと、同じ画面に違う数字が出て混乱する。
      let n = filterApi().countApplied(multiValues(MK_MULTI_IDS));
      if (($('mkQ')?.value || '').trim()) n += 1;
      el.textContent = '適用中の条件: ' + n + ' 件';
      el.classList.toggle('is-on', n > 0);
    }

    // ── タブ切替（販売 / マーケティング / カムバック特典）──
    const TABS = [
      ['sales', 'tabSales', 'paneSales'],
      ['mkt', 'tabMkt', 'paneMkt'],
      ['comeback', 'tabCb', 'paneCb'],
    ];
    function showTab(which) {
      for (const [name, tabId, paneId] of TABS) {
        const on = name === which;
        $(paneId).hidden = !on;
        $(tabId).classList.toggle('on', on);
        $(tabId).setAttribute('aria-selected', String(on));
      }
      if (which === 'mkt' && mkCampaigns.length === 0) mkLoadCampaigns();
      if (which === 'comeback' && !cbCatalog) cbLoadOffers();
    }
    $('tabSales').addEventListener('click', () => showTab('sales'));
    $('tabMkt').addEventListener('click', () => showTab('mkt'));
    $('tabCb').addEventListener('click', () => showTab('comeback'));

    // ── キャンペーンカタログ ──
    async function mkLoadCampaigns() {
      const data = await mkCall({ action: 'campaigns' });
      if (data) { mkState.sendEnabled = !!data.sendEnabled; mkState.dispatchEnabled = !!data.dispatchEnabled; }
      if (!data) return;
      mkCampaigns = data.campaigns || [];
      mkLabels = data.labels || {};
      // 連続配信のセレクトも同じカタログから埋める（画面が独自のキャンペーン表を持たない）
      try { mkSeqInit(); } catch { /* シーケンス UI が無くても一覧は出す */ }
      mkSendEnabled = !!data.sendEnabled;
      mkState.sendEnabled = !!data.sendEnabled;
      mkState.dispatchEnabled = !!data.dispatchEnabled;
      mkSyncFlow();
      const sel = $('mkCampaign');
      sel.innerHTML = '';
      for (const c of mkCampaigns) {
        const o = document.createElement('option');
        o.value = c.campaignId;
        // 使用可否と「運用テスト専用」を選択肢の時点で分かるようにする
        o.textContent = (c.usable ? '' : '⛔ ') + (c.testOnly ? '🧪 ' : '') + c.name + '（v' + c.version + '）'
          + (c.testOnly ? ' — 運用テスト専用' : '')
          + (c.usable ? '' : ' — 使用停止中');
        o.disabled = !c.usable;
        if (!c.usable && c.disabledReason) o.title = c.disabledReason;
        sel.appendChild(o);
      }
      // 既定選択は単一源が決める。
      //   - 運用テスト専用（カナリア）は**絶対に既定にしない**
      //   - 引き継ぎ中は、配った特典に対応する文面があればそれを選ぶ
      //   - 対応が無ければ既定は入れつつ「対応テンプレート未設定」と伝える
      const pick = window.__cbCampaign.pickInitialCampaign({
        campaigns: mkCampaigns, handoff: mkState.handoff,
      });
      if (pick.campaignId) sel.value = pick.campaignId;
      if (mkState.handoff && !pick.matchedGrant && pick.label) {
        mkNotify('warn', '送る文面を選んでください', pick.label);
      }
      // ⚠️ change イベントはプログラム選択では発火しない。
      //    ここで状態へ入れないと「キャンペーン未選択」と判定され、
      //    dry-run ボタンが永久に押せなくなる（2026-08-02 の不具合）。
      mkApplyCampaignSelection();
      renderCampDesc();
      $('mkSendState').textContent = data.sendEnabled
        ? (data.dispatchEnabled
          ? '送信: 有効（キャンペーン配信も有効。実際にメールが届きます）'
          : '送信: キュー登録のみ有効（MARKETING_CAMPAIGN_DISPATCH_ENABLED が無効のため実送信されません）')
        : '送信: 無効（MARKETING_CAMPAIGN_ENABLED 未設定）。対象確認（dry-run）までは利用できます。';
      $('mkSendState').className = 'note' + (data.sendEnabled ? '' : ' off');
    }

    function currentCampaign() {
      const id = $('mkCampaign').value;
      return mkCampaigns.find((c) => c.campaignId === id) || null;
    }

    function renderCampDesc() {
      const c = currentCampaign();
      const el = $('mkCampDesc');
      el.innerHTML = '';
      if (!c) return;
      const rule = c.audienceRule || {};
      const limits = [];
      if (rule.contracts && rule.contracts.length) limits.push('契約状態: ' + rule.contracts.join(' / '));
      if (rule.plans && rule.plans.length) limits.push('プラン: ' + rule.plans.join(' / '));
      if (c.extraAudience) limits.push('追加条件: ' + c.extraAudience);

      // ── CTA（本文に URL を書けない代わりに、どこへ誘導するかを必ず見せる）──
      const cta = window.__cbCampaign.describeCta(c);
      const ctaBox = document.createElement('div');
      ctaBox.className = 'cta-box';
      const ctaH = document.createElement('span'); ctaH.className = 'cta-h'; ctaH.textContent = 'CTAボタン';
      ctaBox.appendChild(ctaH);
      const ctaL = document.createElement('b'); ctaL.className = 'cta-label';
      ctaL.textContent = cta.label || '（未設定）';
      ctaBox.appendChild(ctaL);
      const ctaArrow = document.createElement('span'); ctaArrow.className = 'cta-arrow'; ctaArrow.textContent = '→';
      ctaBox.appendChild(ctaArrow);
      if (cta.url) {
        // read-only 表示。押して確認できるが、本文編集では壊れない固定値
        const a = document.createElement('a');
        a.className = 'cta-url';
        a.href = cta.url; a.textContent = cta.url;
        a.target = '_blank'; a.rel = 'noopener noreferrer';
        ctaBox.appendChild(a);
      } else {
        const sp = document.createElement('span'); sp.className = 'cta-url is-deferred';
        sp.textContent = cta.perRecipient ? 'お客様ごとの専用 URL' : '（未設定）';
        ctaBox.appendChild(sp);
      }
      const ctaNote = document.createElement('span'); ctaNote.className = 'cta-note';
      ctaNote.textContent = cta.note;
      ctaBox.appendChild(ctaNote);
      el.appendChild(ctaBox);

      // 引き継ぎ中に、配った特典と文面が対応していない場合は必ず知らせる
      if (mkState.handoff && mkState.handoff.grantOffers) {
        const rec = window.__cbCampaign.recommendCampaignForGrant(mkState.handoff.grantOffers);
        if (!rec.campaignId) {
          const w = document.createElement('p'); w.className = 'blocker';
          w.textContent = '⚠️ ' + rec.label;
          el.appendChild(w);
        } else if (rec.campaignId !== c.campaignId) {
          const w = document.createElement('p'); w.className = 'blocker';
          w.textContent = '⚠️ 引き継いだ付与内容に対応する文面は「'
            + (mkCampaigns.find((x) => x.campaignId === rec.campaignId)?.name || rec.campaignId)
            + '」です。いま選んでいる文面と違います。';
          el.appendChild(w);
        }
      }

      // 運用テスト専用は顧客向けと混同しないよう最初に明示する
      if (c.testOnly) {
        const t = document.createElement('p');
        t.className = 'testonly';
        t.textContent = '🧪 運用テスト専用キャンペーンです。'
          + 'NEWSLETTER_TEST_RECIPIENTS に登録されたテスト受信者にのみ送信され、'
          + '一般顧客を選択しても送信対象になりません（対象を手動で広げることはできません）。';
        el.appendChild(t);
      }

      const line = document.createElement('span');
      line.textContent = c.description
        + (limits.length ? '　【対象条件】' + limits.join('・') + (rule.enforce ? '（条件外は自動で除外）' : '') : '');
      el.appendChild(line);

      // 使用停止中は理由を明示する（なぜ選べないのかを画面で完結させる）
      if (!c.usable) {
        const warn = document.createElement('p');
        warn.className = 'blocker';
        warn.textContent = '⛔ 使用停止中: ' + (c.disabledReason || '利用不可');
        el.appendChild(warn);
      }
    }
    // 条件クリア（全部戻して数え直す）
    $('mkFilterClear')?.addEventListener('click', () => {
      const q = $('mkQ'); if (q) q.value = '';
      // 完全な未指定にはしない（送信できない顧客まで候補へ戻さない）
      mkApplyDefaults();
      mkRenderChips();
      mkRenderFilterCount();
      mkNotify('ok', '通常運用の条件に戻しました',
        '送信可否は「メール送信可能」、その他は指定なしです。もう一度「この条件で取得」を押してください。');
    });
    for (const id of ['mkQ', 'mkContract', 'mkPlan', 'mkSendable', 'mkPp', 'mkHistory',
      'mkOfferState', 'mkPromoState', 'mkFrequency', 'mkLastLogin']) {
      $(id)?.addEventListener('change', mkRenderFilterCount);
      $(id)?.addEventListener('input', mkRenderFilterCount);
    }

    // ══════════════════════════════════════════════════════════════
    //  文面エディタ（今回送る分だけを編集する）
    //  検証・失効判定の単一源は campaignContentDraft.js / campaignEditorState.js。
    //  ここでは「読み込む・映す・伝える」だけを行う。
    // ══════════════════════════════════════════════════════════════
    const draftApi = () => window.__mkDraft;

    /** 文面の状態。confirmed は dry-run が受理した文面（hash 付き） */
    const mkContent = {
      defaults: { subject: '', body: '' },   // テンプレートの既定文面
      loadedFor: '',                          // 既定文面を読んだ campaignId:version
      confirmed: null,                        // 確認済みの文面（サーバーの hash 付き）
      acknowledged: false,                    // 最終確認のチェック
      valid: false,
      errors: [],
      warnings: [],
    };

    /** いま編集欄にある文面 */
    function mkDraft() {
      return { subject: $('mkSubject')?.value || '', body: $('mkBody')?.value || '' };
    }

    /** 既定文面をサーバーから読む（本文の正本はコード。画面はコピーを編集する） */
    async function mkLoadDefaults(campaign, { force = false } = {}) {
      if (!campaign) return;
      const key = campaign.campaignId + ':v' + campaign.version;
      if (!force && mkContent.loadedFor === key) return;
      const data = await mkCall({ action: 'preview', campaignId: campaign.campaignId });
      if (!data || !data.defaults) return;
      mkContent.defaults = { subject: data.defaults.subject || '', body: data.defaults.body || '' };
      mkContent.loadedFor = key;
      mkSetDraft(mkContent.defaults);
      mkRenderPlaceholders(data.placeholders || draftApi().DRAFT_PLACEHOLDERS);
      mkRenderEditorMeta(campaign);
      // 読み込み前は「空欄＝エラー」の状態なので、読み込み後に必ず表示を更新する
      mkSyncFlow();
    }

    /** 編集欄へ値を入れる（拡大モーダルと同じ値を共有する） */
    function mkSetDraft(draft) {
      if ($('mkSubject')) $('mkSubject').value = draft.subject || '';
      if ($('mkBody')) $('mkBody').value = draft.body || '';
      if ($('mkSubjectBig')) $('mkSubjectBig').value = draft.subject || '';
      if ($('mkBodyBig')) $('mkBodyBig').value = draft.body || '';
      mkValidateDraft({ silent: true });
    }

    /** 使える差し込みをボタンで出す（クリックでカーソル位置へ挿入） */
    function mkRenderPlaceholders(list) {
      const box = $('mkPlaceholders');
      if (!box) return;
      box.innerHTML = '';
      for (const p of list) {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'chip'; b.textContent = p.token + '（' + p.label + '）';
        b.title = p.note || '';
        b.addEventListener('click', () => mkInsertAtCursor(p.token));
        box.appendChild(b);
      }
    }

    /** 本文のカーソル位置へ差し込みを入れる */
    function mkInsertAtCursor(token) {
      const ta = ($('mkEditorModal') && !$('mkEditorModal').hidden) ? $('mkBodyBig') : $('mkBody');
      if (!ta) return;
      const start = ta.selectionStart ?? ta.value.length;
      const end = ta.selectionEnd ?? start;
      ta.value = ta.value.slice(0, start) + token + ta.value.slice(end);
      ta.selectionStart = ta.selectionEnd = start + token.length;
      ta.focus();
      mkSyncEditors(ta);
    }

    /** 通常欄 ⇔ 拡大モーダルの値を同期する（別の状態を持たない） */
    function mkSyncEditors(source) {
      const subject = (source === $('mkSubjectBig') || source === $('mkBodyBig'))
        ? ($('mkSubjectBig')?.value || '') : ($('mkSubject')?.value || '');
      const body = (source === $('mkSubjectBig') || source === $('mkBodyBig'))
        ? ($('mkBodyBig')?.value || '') : ($('mkBody')?.value || '');
      if ($('mkSubject')) $('mkSubject').value = subject;
      if ($('mkBody')) $('mkBody').value = body;
      if ($('mkSubjectBig')) $('mkSubjectBig').value = subject;
      if ($('mkBodyBig')) $('mkBodyBig').value = body;
      mkOnDraftChanged();
    }

    /** 文面が変わったとき: 検証 → 確認結果の失効 → ボタン再判定 */
    function mkOnDraftChanged() {
      mkValidateDraft({ silent: false });
      if (mkContent.confirmed
        && !draftApi().isContentConfirmed({ draft: mkDraft(), confirmed: mkContent.confirmed })) {
        mkContent.acknowledged = false;
        mkInvalidateDryRun(draftApi().CONTENT_CHANGED_NOTICE);
      }
      mkSyncFlow();
    }

    /** 検証結果を画面へ出す（文字数・エラー・警告） */
    function mkValidateDraft({ silent = false } = {}) {
      const api = draftApi();
      if (!api) return;
      const campaign = mkState.campaign || currentCampaign();
      const draft = mkDraft();
      const v = api.validateDraft({ campaign, draft });
      mkContent.valid = v.ok;
      mkContent.errors = v.errors;
      mkContent.warnings = v.warnings;

      const len = api.describeLength(draft);
      const sc = $('mkSubjectCount');
      if (sc) {
        sc.textContent = len.subject.length + ' / ' + len.subject.max;
        sc.className = 'editor-count' + (len.subject.over ? ' is-over' : (len.subject.long ? ' is-long' : ''));
      }
      const bc = $('mkBodyCount');
      if (bc) {
        bc.textContent = len.body.length + ' / ' + len.body.max + '（' + len.body.lines + ' 行）';
        bc.className = 'editor-count' + (len.body.over ? ' is-over' : '');
      }

      const errBox = $('mkEditorErrors');
      if (errBox) {
        errBox.innerHTML = '';
        const items = [
          ...v.errors.map((t) => ['err', '⛔ ' + t]),
          ...v.warnings.map((t) => ['warn', '⚠️ ' + t]),
        ];
        for (const [kind, text] of items) {
          const p = document.createElement('p');
          p.className = 'editor-msg is-' + kind;
          p.textContent = text;
          errBox.appendChild(p);
        }
        errBox.hidden = items.length === 0;
      }

      const hint = $('mkEditorHint');
      if (hint) {
        const edited = campaign ? api.isDraftEdited(
          { subject: mkContent.defaults.subject, body: mkContent.defaults.body }, draft) : false;
        hint.textContent = edited
          ? '✏️ 既定文面から編集されています（今回送る分だけに反映されます）'
          : 'テンプレートの既定文面のままです。';
        hint.className = 'editor-hint' + (edited ? ' is-edited' : '');
      }
      if ($('mkEditorBigHint')) $('mkEditorBigHint').textContent = $('mkEditorHint')?.textContent || '';
      if (!silent && !v.ok) mkContent.acknowledged = false;
      return v;
    }

    /** キャンペーン名・version・種別を編集欄の上に出す */
    function mkRenderEditorMeta(campaign) {
      const el = $('mkCampMeta');
      if (!el) return;
      el.textContent = campaign
        ? campaign.name + '　v' + campaign.version + '　' + (campaign.testOnly ? '🧪 運用テスト専用' : '通常配信')
        : '';
      el.className = 'camp-meta' + (campaign && campaign.testOnly ? ' is-test' : '');
    }

    // 入力のたびに検証と失効判定を通す
    for (const id of ['mkSubject', 'mkBody', 'mkSubjectBig', 'mkBodyBig']) {
      $(id)?.addEventListener('input', (e) => mkSyncEditors(e.target));
    }
    // 件名に改行を貼り付けられても 1 行に保つ（検証でも弾くが、入力段でも直す）
    $('mkSubject')?.addEventListener('paste', () => setTimeout(() => {
      const el = $('mkSubject');
      if (el && /[\r\n]/.test(el.value)) { el.value = el.value.replace(/[\r\n]+/g, ' '); mkSyncEditors(el); }
    }, 0));

    $('mkEditorReset')?.addEventListener('click', () => {
      mkSetDraft(mkContent.defaults);
      mkOnDraftChanged();
      mkNotify('ok', '既定文面に戻しました', 'テンプレートの件名・本文を読み直しました。');
    });

    $('mkEditorExpand')?.addEventListener('click', () => {
      const m = $('mkEditorModal');
      if (!m) return;
      m.hidden = false;
      lockScroll();
      $('mkBodyBig')?.focus();
    });
    $('mkEditorModalClose')?.addEventListener('click', () => {
      const m = $('mkEditorModal');
      if (!m) return;
      m.hidden = true;
      unlockScroll();
      mkOnDraftChanged();
    });
    $('mkEditorModal')?.addEventListener('click', (e) => {
      if (e.target === $('mkEditorModal')) $('mkEditorModalClose').click();
    });

    /** 選択欄の値を状態へ反映する（change でもプログラム選択でも必ずここを通す） */
    function mkApplyCampaignSelection() {
      const c = currentCampaign();
      mkState.campaignId = c ? c.campaignId : '';
      mkState.campaignVersion = c ? String(c.version) : '';
      mkState.campaign = c || null;
      mkRenderCampCard(c);
      mkRenderEditorMeta(c);
      // 既定文面を編集欄へ読み込む（テンプレートは変えない。編集するのはコピー）
      mkLoadDefaults(c);
      mkSyncFlow();
    }

    $('mkCampaign').addEventListener('change', () => {
      renderCampDesc();
      const c = currentCampaign();
      mkState.campaignId = c ? c.campaignId : '';
      mkState.campaignVersion = c ? String(c.version) : '';
      mkState.campaign = c || null;
      // キャンペーンが変われば「確認した内容」は別物 → 失効させる
      mkContent.confirmed = null;
      mkContent.acknowledged = false;
      mkInvalidateDryRun('キャンペーンが変わりました。');
      mkRenderCampCard(c);
      mkRenderEditorMeta(c);
      // 別キャンペーンの既定文面を読み直す（前の編集内容は持ち越さない）
      mkLoadDefaults(c, { force: true });
      mkSyncFlow();
    });

    /** キャンペーンカード（名前・version・対象条件・種別・実績・再送可否） */
    function mkRenderCampCard(c) {
      const card = $('mkCampCard');
      if (!card) return;
      card.innerHTML = '';
      if (!c) { card.hidden = true; return; }
      card.hidden = false;
      card.className = 'camp-card' + (c.testOnly ? ' is-test' : '');
      const kind = document.createElement('span');
      kind.className = 'badge ' + (c.testOnly ? 'b-test' : 'b-normal');
      kind.textContent = c.testOnly ? '🧪 運用テスト専用' : '通常配信';
      card.appendChild(kind);
      const title = document.createElement('b');
      title.textContent = ' ' + c.name + ' v' + c.version;
      card.appendChild(title);
      const meta = document.createElement('div'); meta.className = 'camp-meta';
      const stat = mkCampStats.get(c.campaignId + ':v' + c.version) || null;
      meta.textContent = stat
        ? ('送信済み ' + stat.sent + ' 名 / 最終送信 ' + (stat.lastAt ? fmtDate(stat.lastAt) : '—')
          + ' / 同一 version の再送: 不可（version を上げれば可）')
        : 'この version の送信実績はまだありません（再送制限なし）';
      card.appendChild(meta);
    }
    /** campaignType → 実績（history から作る） */
    const mkCampStats = new Map();

    // ── 顧客一覧 ──
    async function mkLoad() {
      // 両立しない条件のまま取得しない（0 件の理由が分からなくなる）
      const defs = defsApi();
      const conflicts = defs ? defs.detectImpossibleCombination(multiValues(MK_MULTI_IDS)) : [];
      if (conflicts.length) {
        mkNotify('warn', '条件の組合せを確認してください', conflicts[0].message);
        return;
      }
      mkMsg('読み込み中…');
      // 複数選択は配列で送る（同じ項目内は OR / 未選択は条件なし）
      const sel = multiValues(MK_MULTI_IDS);
      const data = await mkCall({
        action: 'customers',
        contract: sel.mkContract,
        plan: sel.mkPlan,
        marketing: sel.mkSendable,
        premiumPlus: sel.mkPp,
        history: sel.mkHistory,
        lastLogin: sel.mkLastLogin,
        offerState: sel.mkOfferState,
        offerWindow: sel.mkOfferWindow,
        promoState: sel.mkPromoState,
        frequency: sel.mkFrequency,
      });
      if (!data) return;
      mkData = data;
      // 取得結果を状態へ反映（件数・条件・確認結果の失効）
      mkApplyCustomersLoaded(data.rows || []);
      mkSendEnabled = !!data.sendEnabled;
      mkMsg('');
      mkRender();
      renderApplied(data);
      mkRenderListSummary();
    }

    // 適用中の条件と件数を画面に出す（何で絞ったのか分からない状態を作らない）
    function renderApplied(data) {
      const f = data.appliedFilters || {};
      const LBL = { contract: '契約状態', plan: 'プラン', marketing: '送信可否', premiumPlus: 'Plus 資格',
        history: '送信履歴', lastLogin: '最終ログイン', offerState: 'オファーの状態',
        offerWindow: 'オファーの残り期間', promoState: '現在の無料付与', frequency: '送信タイミング' };
      // 内部コードではなく利用者向けの表示名を出す（単一源の定義から引く）
      const API_TO_FILTER = { contract: 'mkContract', plan: 'mkPlan', marketing: 'mkSendable',
        premiumPlus: 'mkPp', history: 'mkHistory', lastLogin: 'mkLastLogin',
        offerState: 'mkOfferState', offerWindow: 'mkOfferWindow',
        promoState: 'mkPromoState', frequency: 'mkFrequency' };
      const nameOf = (k, v) => {
        const defs = defsApi();
        const id = API_TO_FILTER[k];
        return defs && id ? defs.optionLabel(id, v) : v;
      };
      const parts = Object.entries(f)
        .map(([k, v]) => [k, (Array.isArray(v) ? v : [v]).map((x) => nameOf(k, x)).join(' / ')])
        .filter(([, v]) => v && v !== 'all')
        .map(([k, v]) => (LBL[k] || k) + '=' + v);
      $('mkApplied').textContent = '条件: ' + (parts.length ? parts.join(' AND ') : '指定なし（全件）')
        + ' → 該当 ' + (data.matchedCount || 0) + ' 名';
    }

    // 列の表示切替（狭い画面では主要列だけ）
    function setColMode(mode) {
      document.getElementById('paneMkt').dataset.colmode = mode;
      $('mkColBasic').classList.toggle('is-on', mode === 'basic');
      $('mkColAll').classList.toggle('is-on', mode === 'all');
    }
    $('mkColBasic').addEventListener('click', () => setColMode('basic'));
    $('mkColAll').addEventListener('click', () => setColMode('all'));
    setColMode('basic');

    const CONTRACT_LABEL = {
      active: '有効', expiring_soon: '期限間近', expired: '期限切れ',
      unknown: '不明', none: '契約なし',
    };
    const PLAN_LABEL = {
      premium_sanrenpuku: '三連複', premium: 'Premium', light: 'Light', free: 'Free',
    };

    /**
     * 画面に**いま出ている行**（絞り込み → 検索 → 現在ページ）。
     * 「表示中を全選択」もこの範囲だけを対象にする。
     */
    function mkVisibleRows() {
      const info = mkPageInfo();
      return mkSearchedRows().slice((info.page - 1) * mkList.pageSize, info.page * mkList.pageSize);
    }

    function mkRender() {
      if (!mkData) return;
      document.querySelector('#paneMkt .tbl')?.classList.add('is-compact');
      const seg = mkData.segments || {};
      const bar = $('mkSummary');
      bar.innerHTML = '';
      const items = [
        ['有効', seg.contract?.active || 0],
        ['期限間近', seg.contract?.expiring_soon || 0],
        ['期限切れ', seg.contract?.expired || 0],
        ['不明', seg.contract?.unknown || 0],
        ['Free', seg.contract?.none || 0],
        ['送信除外', seg.marketing?.suppressed || 0],
      ];
      items.forEach((it, i) => {
        if (i > 0) { const sp = document.createElement('span'); sp.className = 'sep'; sp.textContent = '|'; bar.appendChild(sp); }
        const b = document.createElement('span');
        b.className = 's';
        const kk = document.createElement('span'); kk.className = 'k'; kk.textContent = it[0];
        const vv = document.createElement('span'); vv.className = 'v'; vv.textContent = String(it[1]);
        b.appendChild(kk); b.appendChild(vv);
        bar.appendChild(b);
      });
      const sup = seg.suppression || {};
      const wd = seg.withdrawn || {};
      $('mkSummarySub').textContent =
        '全顧客 ' + (mkData.totalCustomers || 0) + ' 名　/　除外内訳: '
        + ['unsubscribed', 'blacklist', 'no_email', 'suspended', 'test_account']
          .map((k) => (mkData.labels?.suppression?.[k] || k) + ' ' + (sup[k] || 0)).join('・')
        // 退会は「除外」ではない。契約状態として別枠で件数を出す
        + '　/　退会（課金停止）' + (wd.total || 0) + ' 名（うち送信可能 ' + (wd.sendable || 0) + ' 名）';

      const rows = mkVisibleRows();
      const tb = $('mkRows');
      tb.innerHTML = '';
      for (const r of rows) {
        const tr = document.createElement('tr');
        if (!r.sendable) tr.className = 'row-suppressed';

        const c0 = document.createElement('td');
        c0.className = 'c-chk';
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.checked = mkSelected.has(r.recordId);
        cb.disabled = !r.sendable; // 送信できない相手は選べない（fail closed）
        cb.setAttribute('aria-label', '選択');
        if (!r.sendable) {
          // なぜ選べないのかをその場で分かるようにする（列を見に行かせない）
          const why = (r.suppressionReasons || []).map((x) => (mkData.labels?.suppression?.[x] || x)).join('・');
          cb.title = '選択できません: ' + (why || '送信除外');
          tr.classList.add('is-unsendable');
        }
        cb.addEventListener('change', () => {
          if (cb.checked) mkSelected.add(r.recordId); else mkSelected.delete(r.recordId);
          mkRenderSelCount();
        });
        c0.appendChild(cb);
        tr.appendChild(c0);

        const c1 = td('c-cust', '', undefined);
        const em = document.createElement('span');
        em.className = 'em';
        em.textContent = r.email || '(メール未設定)';
        c1.appendChild(em);
        if (r.name) { const nm = document.createElement('span'); nm.className = 'sub'; nm.textContent = r.name; c1.appendChild(nm); }
        tr.appendChild(c1);

        // 契約状態と送信可否は別概念。退会（課金停止）は契約欄に履歴として出し、
        // 送信可否には影響させない。
        const cCon = td('c-contract', '契約', CONTRACT_LABEL[r.contract] || r.contract);
        cCon.firstChild.className = 'contract ' + r.contract;
        if (r.daysToExpiry != null) cCon.firstChild.title = '期限まで ' + r.daysToExpiry + ' 日';
        if (r.withdrawn) {
          const wb = document.createElement('span');
          wb.className = 'wd-badge';
          wb.textContent = '退会';
          wb.title = '課金停止（退会申請）。メール配信の可否とは別です';
          cCon.appendChild(wb);
        }
        tr.appendChild(cCon);

        tr.appendChild(td('c-plan', 'プラン', PLAN_LABEL[r.planGroup] || r.planGroup));

        const sendText = r.sendable
          ? '送信可能'
          : '除外: ' + r.suppressionReasons.map((x) => (mkData.labels?.suppression?.[x] || x)).join('・');
        tr.appendChild(td('c-send', '送信', sendText, r.sendable ? 'ok-txt' : 'ng-txt'));

        // 最終ログイン。**どの記録由来か**を必ず併記する（旧ポイント履歴は 2026-07-08 で更新停止）
        const loginText = r.lastLoginAt
          ? fmtDate(r.lastLoginAt) + (r.daysSinceLogin != null ? '（' + r.daysSinceLogin + '日前）' : '')
          : '記録なし';
        const cLogin = td('c-login', '最終ログイン', loginText, r.lastLoginAt ? '' : 'muted');
        if (r.lastLoginSourceLabel) cLogin.firstChild.title = '出所: ' + r.lastLoginSourceLabel;
        if (r.lastLoginSource === 'legacy_points') {
          const lb = document.createElement('span');
          lb.className = 'sub';
          lb.textContent = '旧記録（〜7/8）';
          cLogin.appendChild(lb);
        }
        tr.appendChild(cLogin);

        // ── 詳細列（狭い画面では非表示。カルテで確認できる）──
        const acc = r.access || {};
        const accText = [acc.free && "無料", acc.light && "Light", acc.premium && "Premium", acc.sanrenpuku && "三連複"].filter(Boolean).join("/") || "なし";
        tr.appendChild(td("c-access col-detail", "閲覧権限", accText, acc.premium || acc.sanrenpuku ? "ok-txt" : ""));

        const promoText = r.promoActive
          ? (r.promoLifetime ? "無期限" : (r.promoUntil ? "〜" + fmtDate(r.promoUntil) : "期間不明"))
          : "—";
        tr.appendChild(td("c-promo col-detail", "現在の無料付与", promoText, r.promoActive ? "ok-txt" : "muted"));

        const offerText = r.liveOfferCount
          ? r.liveOfferCount + " 件" + (r.offerExpiresAt ? "（〜" + fmtDate(r.offerExpiresAt) + "）" : "")
          : "—";
        tr.appendChild(td("c-offer col-detail", "オファー", offerText, r.liveOfferCount ? "ok-txt" : "muted"));

        tr.appendChild(td("c-next col-detail", "次回送信可",
          r.nextSendableAt ? fmtDate(r.nextSendableAt) + " 以降" : "いま送れる",
          r.nextSendableAt ? "ng-txt" : "ok-txt"));

        tr.appendChild(td('c-pp', 'Plus', r.premiumPlusEligibility || '未設定',
          r.premiumPlusEligibility ? '' : 'muted'));

        tr.appendChild(td('c-hist', '送信履歴',
          r.sentCount ? (r.sentCount + ' 回 / ' + fmtDate(r.lastSentAt)) : '—',
          r.sentCount ? '' : 'muted'));

        const cDet = document.createElement('td');
        cDet.className = 'c-detail';
        const detBtn = document.createElement('button');
        detBtn.type = 'button';
        detBtn.className = 'btn-ghost btn-sm';
        detBtn.textContent = 'カルテ';
        detBtn.addEventListener('click', () => mkOpenDossier(r.recordId, r.email));
        cDet.appendChild(detBtn);
        tr.appendChild(cDet);

        tb.appendChild(tr);
      }

      $('mkCount').textContent = '表示 ' + rows.length + ' 件 / 条件一致 ' + (mkData.matchedCount || 0) + ' 件'
        + (mkData.truncated ? '（上限を超えたため一部のみ表示）' : '');
      const emp = $('mkEmpty');
      emp.hidden = rows.length > 0;
      emp.textContent = '条件に一致する顧客はいません。';
      if (mkData.truncated) mkMsg('条件一致が多いため一部のみ表示しています。条件を絞ってください。', 'err');
      mkRenderSelCount();
    }

    /** 顧客一覧を取得したときの状態更新（件数・条件・確認結果の失効） */
    function mkApplyCustomersLoaded(rows) {
      mkState.loadedCount = Array.isArray(rows) ? rows.length : 0;
      mkState.filters = mkCurrentFilters();
      mkInvalidateDryRun('顧客一覧を取得し直しました。');
      mkRenderFilterCount();
      mkSyncFlow();
    }

    /** 一覧の表示状態（ページ・件数・絞り込み）。変わったら dry-run を失効させる */
    const mkList = { page: 1, pageSize: 25, view: 'all' };

    /** 絞り込み（すべて / 送信可能のみ / 選択者のみ）を適用した母集合 */
    function mkScopedRows() {
      const rows = (mkData?.rows || []);
      if (mkList.view === 'selected') return rows.filter((r) => mkSelected.has(r.recordId));
      if (mkList.view === 'sendable') return rows.filter((r) => r.sendable === true);
      return rows;
    }

    /** 母集合に検索語を適用した行（ページ分割の前段） */
    function mkSearchedRows() {
      const q = $('mkQ').value.trim().toLowerCase();
      return mkScopedRows().filter((r) => !q || String(r.email || '').toLowerCase().includes(q));
    }

    /** ページ範囲（「42 件中 1〜25 件」） */
    function mkPageInfo() {
      const total = mkSearchedRows().length;
      const pages = Math.max(1, Math.ceil(total / mkList.pageSize));
      const page = Math.min(Math.max(1, mkList.page), pages);
      const from = total === 0 ? 0 : (page - 1) * mkList.pageSize + 1;
      const to = Math.min(page * mkList.pageSize, total);
      return { total, pages, page, from, to, label: total === 0 ? '0 件' : total + ' 件中 ' + from + '〜' + to + ' 件' };
    }

    /** 一覧の要約（該当 / 送信可能 / 送信不可 / 選択） */
    function mkRenderListSummary() {
      const rows = (mkData?.rows || []);   // 該当件数は取得した全件で数える
      const sendable = rows.filter((r) => r.sendable === true).length;
      const el = $('mkListSummary');
      if (el) {
        el.textContent = rows.length === 0 ? '未取得'
          : '該当 ' + rows.length + ' 名（送信可能 ' + sendable + ' / 送信不可 ' + (rows.length - sendable) + '）　選択 ' + mkSelected.size + ' 名';
      }
      const info = mkPageInfo();
      for (const id of ['mkPageLabel', 'mkPageLabelBottom']) { const x = $(id); if (x) x.textContent = info.label; }
      const prev = $('mkPrevPage'); if (prev) prev.disabled = info.page <= 1;
      const next = $('mkNextPage'); if (next) next.disabled = info.page >= info.pages;
    }

    /** 表示条件が変わったら確認結果を失効させて描画し直す */
    function mkChangeList(patch) {
      Object.assign(mkList, patch);
      mkInvalidateDryRun('一覧の表示が変わりました。');
      mkRender();
    }
    $('mkPageSize')?.addEventListener('change', () => mkChangeList({ pageSize: Number($('mkPageSize').value) || 25, page: 1 }));
    $('mkViewMode')?.addEventListener('change', () => mkChangeList({ view: $('mkViewMode').value, page: 1 }));
    $('mkPrevPage')?.addEventListener('click', () => mkChangeList({ page: Math.max(1, mkList.page - 1) }));
    $('mkNextPage')?.addEventListener('click', () => mkChangeList({ page: mkList.page + 1 }));
    $('mkSelAllBottom')?.addEventListener('click', () => $('mkSelAll').click());
    $('mkSelNoneBottom')?.addEventListener('click', () => $('mkSelNone').click());

    function mkRenderSelCount() {
      mkRenderListSummary();
      // 選択が変われば「確認した母集団」とズレる → dry-run を失効させる
      if (mkState.dryRun && flowApi().isDryRunStale({ dryRun: mkState.dryRun, current: { ...mkState, selectedIds: [...mkSelected] } })) {
        mkInvalidateDryRun('選択した顧客が変わりました。');
      }
      mkSyncFlow();
      $('mkSelCount').textContent = mkSelected.size + ' 名を選択中';
      // 絞り込みで見えなくなった選択を知らせる（見えないまま実行させない）
      const PV = window.__planView;
      const off = PV ? PV.offscreenSelection({ current: mkSelected, visibleIds: mkVisibleRows().map((r) => r.recordId) }) : [];
      $('mkSelWarn').textContent = off.length ? '⚠️ うち ' + off.length + ' 名は現在の絞り込みに表示されていません' : '';
      mkRenderRecoverBar();   // 対象 0 名になったら復旧口を出す
    }

    // ── 顧客カルテ（read-only）─────────────────────────────────────
    function dossierRow(parent, label, value, cls) {
      const dl = document.createElement('div');
      dl.className = 'd-row' + (cls ? ' ' + cls : '');
      const k = document.createElement('span'); k.className = 'd-k'; k.textContent = label;
      const v = document.createElement('span'); v.className = 'd-v'; v.textContent = value;
      dl.appendChild(k); dl.appendChild(v);
      parent.appendChild(dl);
      return dl;
    }
    function dossierSection(parent, title) {
      const sec = document.createElement('section');
      sec.className = 'd-sec';
      const h = document.createElement('h3'); h.textContent = title;
      sec.appendChild(h);
      parent.appendChild(sec);
      return sec;
    }

    async function mkOpenDossier(recordId, email) {
      const box = $('mkDossier');
      const body = $('mkDossierBody');
      box.hidden = false;
      $('mkDossierTitle').textContent = 'カルテ: ' + (email || recordId);
      body.textContent = '読み込み中…';
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      let data;
      try {
        data = await mkCall({ action: 'customerDetail', recordId });
      } catch (e) {
        body.textContent = '取得に失敗しました: ' + (e && e.message ? e.message : 'unknown');
        return;
      }
      const d = data.dossier;
      body.innerHTML = '';

      // ⓪ 推奨アクション（提案のみ。ここから自動実行はしない）
      const s0 = dossierSection(body, '★ 推奨アクション（提案のみ・自動実行しません）');
      for (const rec of (d.recommendations || [])) {
        const box = document.createElement('div');
        box.className = 'rec rec-' + (rec.severity || 'info');
        const h = document.createElement('div'); h.className = 'rec-title'; h.textContent = rec.title;
        const why = document.createElement('p'); why.className = 'rec-why'; why.textContent = rec.reason;
        box.appendChild(h); box.appendChild(why);
        const meta = document.createElement('div'); meta.className = 'rec-meta';
        const add = (k, v) => { const s = document.createElement('span'); s.textContent = k + ': ' + v; meta.appendChild(s); };
        add('使用データ', (rec.dataUsed || []).join(' / ') || '—');
        add('送信可否', rec.sendable === null ? '送信を伴わない' : (rec.sendable ? '送れる' : '送れない'));
        add('実行できる最短', rec.earliestAt ? fmtDate(rec.earliestAt) : '—');
        if (rec.campaignId) add('推奨キャンペーン', rec.campaignId);
        if (rec.offerId) add('推奨施策', rec.offerId);
        box.appendChild(meta);
        s0.appendChild(box);
      }

      // ① ログイン
      const s1 = dossierSection(body, '① ログイン');
      dossierRow(s1, 'いまログインできるか', d.login.canLogin ? 'できる' : 'できない',
        d.login.canLogin ? 'ok' : 'ng');
      dossierRow(s1, '状態', d.login.label);
      dossierRow(s1, 'ログイン方法',
        d.login.loginMethod === 'link' ? 'メールで届くリンクを開く（有料階層）' : 'メールアドレス入力だけで入れる（無料）');
      dossierRow(s1, 'セッションのプラン', d.login.sessionPlan || '—');
      dossierRow(s1, '権限の根拠',
        d.login.entitlementSource === 'promotional_grant' ? '無料特典（支払いではない）'
          : d.login.entitlementSource === 'paid_contract' ? '課金契約' : '—');
      dossierRow(s1, '最終ログイン',
        (d.login.lastLogin.at ? fmtDate(d.login.lastLogin.at) : '記録なし')
        + (d.login.daysSinceLogin != null ? '（' + d.login.daysSinceLogin + '日前）' : '')
        + ' ／ 出所: ' + d.login.lastLogin.sourceLabel);

      // ② メール到達性・送信履歴
      const s2 = dossierSection(body, '② メール到達性・送信履歴');
      dossierRow(s2, '送信可否', d.reachability.sendable ? '送信可能' : '送信除外',
        d.reachability.sendable ? 'ok' : 'ng');
      if (!d.reachability.sendable) {
        dossierRow(s2, '除外理由', (d.reachability.suppressionReasons || []).join('・') || '—');
      }
      dossierRow(s2, '配信基盤の配信停止リスト',
        d.reachability.providerSuppressed === null ? '確認できず（不明）'
          : d.reachability.providerSuppressed ? '登録あり（送れない）' : 'なし',
        d.reachability.providerSuppressed ? 'ng' : '');
      dossierRow(s2, 'AK ブラックリスト', d.reachability.blacklisted ? 'あり' : 'なし');
      dossierRow(s2, 'ソフトバウンス', d.reachability.softBounced ? 'あり' : 'なし');
      dossierRow(s2, '配信停止', d.reachability.unsubscribed ? 'あり' : 'なし');
      dossierRow(s2, 'キャンペーン送信',
        d.delivery.sentCount ? (d.delivery.sentCount + ' 回 / 最終 ' + fmtDate(d.delivery.lastSentAt)) : '未送信');
      for (const h of d.delivery.recent) {
        dossierRow(s2, '　' + fmtDate(h.at), h.campaign + '（' + h.status + '）', 'sub-row');
      }

      // ③ 特典・オファー
      const s3 = dossierSection(body, '③ 無料付与・割引オファー');
      const gl = d.grantsAndOffers.promoLight;
      const gp = d.grantsAndOffers.promoPremium;
      dossierRow(s3, 'Light 無料付与',
        gl.active ? (gl.lifetime ? '永久' : '〜' + fmtDate(gl.until)) : 'なし', gl.active ? 'ok' : '');
      dossierRow(s3, 'Premium 無料付与',
        gp.active ? (gp.lifetime ? '永久' : '〜' + fmtDate(gp.until)) : 'なし', gp.active ? 'ok' : '');
      if (d.grantsAndOffers.promoInconsistent) {
        dossierRow(s3, '⚠️ 特典データ', '矛盾あり（取消済みなのに値が残っている）', 'ng');
      }
      dossierRow(s3, '有効な割引オファー', String(d.grantsAndOffers.liveOfferCount));
      for (const o of d.grantsAndOffers.offers) {
        dossierRow(s3, '　' + o.offerId,
          '¥' + (o.regularPrice || 0).toLocaleString() + ' → ¥' + (o.offerPrice || 0).toLocaleString()
          + ' / ' + o.status + ' / 〜' + fmtDate(o.expiresAt) + (o.live ? '（有効）' : '（無効）'),
          'sub-row');
      }
      dossierRow(s3, 'Premium Plus 資格', d.grantsAndOffers.premiumPlusEligibility || '未設定');

      // ④ 契約・決済
      const s4 = dossierSection(body, '④ 契約・決済');
      dossierRow(s4, 'プラン', (d.contract.plan || '—') + (d.contract.planType ? ' / ' + d.contract.planType : ''));
      dossierRow(s4, '契約状態', CONTRACT_LABEL[d.contract.contractState] || d.contract.contractState);
      dossierRow(s4, '有効期限', d.contract.expiresAt ? fmtDate(d.contract.expiresAt) : '—');
      dossierRow(s4, '退会', d.contract.withdrawn ? ('あり ' + fmtDate(d.contract.withdrawalDate)) : 'なし');
      dossierRow(s4, '三連複 買い切り', d.contract.lifetimeSanrenpuku ? 'あり' : 'なし');
      dossierRow(s4, '入金', d.contract.paymentConfirmed ? '確認済み' : '—');
      dossierRow(s4, '入金日', d.contract.paidAt ? fmtDate(d.contract.paidAt) : '—');
      if (d.contract.requested) {
        dossierRow(s4, '申込中', d.contract.requested.plan + ' / ¥'
          + (d.contract.requested.amount || 0).toLocaleString(), 'ng');
      }
      dossierRow(s4, '登録日', d.registeredAt ? fmtDate(d.registeredAt) : '—');

      // ⑤ 閲覧できるもの
      const s5 = dossierSection(body, '⑤ いま閲覧できるもの');
      dossierRow(s5, '無料コンテンツ', d.access.canViewFree ? '閲覧可' : '不可', d.access.canViewFree ? 'ok' : '');
      dossierRow(s5, 'Light', d.access.canViewLight ? '閲覧可' : '不可', d.access.canViewLight ? 'ok' : '');
      dossierRow(s5, 'Premium', d.access.canViewPremium ? '閲覧可' : '不可', d.access.canViewPremium ? 'ok' : '');
      dossierRow(s5, '三連複', d.access.canViewSanrenpuku ? '閲覧可' : '不可', d.access.canViewSanrenpuku ? 'ok' : '');

      // ⑥ マーケティング履歴（新しい順・出所つき）
      const s6 = dossierSection(body, '⑥ マーケティング履歴（新しい順）');
      const lim = d.timelineLimits || {};
      const notes = [];
      notes.push('問い合わせ履歴: ' + (lim.inquiriesAvailable ? '取得可' : '台帳が無く取得できません'));
      if (lim.contractHistoryIsSnapshotOnly) notes.push('過去の契約は最新 1 件ぶんのみ（履歴テーブルが無いため）');
      if (lim.offerRevokeHasNoTimestamp) notes.push('オファー取消は日時が台帳に無いため末尾に表示');
      const eng = (data.engagementSource || {});
      notes.push('開封・クリック: ' + (eng.available ? eng.note : (eng.note || '取得できません')));
      const noteEl = document.createElement('p'); noteEl.className = 'tl-note'; noteEl.textContent = '⚠️ ' + notes.join(' / ');
      s6.appendChild(noteEl);

      // ⑥-2 メール反応（恒久台帳 EmailEvents）。⑥ の「直近ぶん」とは出所も期間も違うので別枠にする。
      // resolved かつ CustomerRecordId 完全一致の行だけが集計対象で、
      // 未確定（unresolved / conflict）はこの人の反応として表示しない。
      const s62 = dossierSection(body, '⑥-2 メール反応（恒久台帳）');
      const led = (data.ledgerSource || {});
      const le = d.ledgerEngagement || {};
      if (!led.available || le.available !== true) {
        dossierRow(s62, '状態', '取得不能（反応が無かったという意味ではありません）', 'ng');
      } else {
        // 計測状態で「0」を出してよいかを決める。**台帳に open 行が無いのは
        // 「開かれていない」ではなく「Webhook が open を送っていない」**ことがある
        // （2026-08-04 の配信は実際そうで、provider 側では 15 名が開封していた）。
        const meas = data.measurement || null;
        const measured = (kind) => !!meas && meas[kind] === 'enabled';
        const notMeasuredText = (kind) => (!meas || meas[kind] === 'unknown')
          ? '—（計測状態を確認できません）' : '—（計測していません）';
        // 件数の文言は API が単一源（deliveryMeasurement.measuredCount）で決めたものを使う。
        // 画面で 0 を作らない（`?? 0` を書いた瞬間に未計測が 0 に化ける）。
        const disp = data.ledgerDisplay || {};
        const countRow = (label, kind, key) => {
          const cell = disp[key] || null;
          dossierRow(s62, label,
            cell ? cell.text : notMeasuredText(kind),
            cell && cell.measured ? '' : 'ng');
        };
        const timeRow = (label, kind, at) => {
          dossierRow(s62, label,
            measured(kind) ? (at ? fmtDate(at) : '—') : notMeasuredText(kind));
        };
        // delivered / bounce / 配信停止 / 迷惑報告は open・click の設定と無関係に届いている
        dossierRow(s62, '配信済み', String(le.delivered ?? 0) + ' 件');
        countRow('開封', 'open', 'opens');
        timeRow('初回開封', 'open', le.firstOpenAt);
        timeRow('最終開封', 'open', le.lastOpenAt);
        countRow('クリック', 'click', 'clicks');
        timeRow('初回クリック', 'click', le.firstClickAt);
        timeRow('最終クリック', 'click', le.lastClickAt);
        if (measured('click') && (le.clickCategories || []).length > 0) {
          dossierRow(s62, 'クリック先', le.clickCategories.join(' / '));
        }
        if (meas && (meas.open !== 'enabled' || meas.click !== 'enabled')) {
          dossierRow(s62, '計測の状態',
            '開封: ' + meas.openLabel + ' / クリック: ' + meas.clickLabel
            + ((meas.reasons || []).length ? '（' + meas.reasons.join(' / ') + '）' : ''), 'ng');
        }
        dossierRow(s62, 'bounce / 配信停止 / 迷惑報告',
          String(le.bounced ?? 0) + ' / ' + String(le.unsubscribed ?? 0) + ' / ' + String(le.spamReported ?? 0));
      }
      // 未確定（unresolved / conflict）は**この人の反応ではない**。件数だけ参考として出す。
      // 出さないと「取りこぼしが起きていること自体」に気付けない。
      if (led.unattributedAvailable) {
        dossierRow(s62, '未確定イベント（全体・顧客未紐付）',
          String(led.unresolvedTotal ?? 0) + ' 件 / 食い違い ' + String(led.conflictTotal ?? 0) + ' 件');
      } else {
        dossierRow(s62, '未確定イベント（全体）', '取得不能', 'ng');
      }
      const ledNote = document.createElement('p'); ledNote.className = 'tl-note';
      ledNote.textContent = '⚠️ ' + (led.note || '') + '（⑥ の直近ぶんとは出所が異なります。'
        + '誰のものか確定していないイベントは、この人の反応として数えていません）';
      s62.appendChild(ledNote);

      const rows = [...(d.timeline || []), ...(d.timelineUnknownDate || [])];
      if (rows.length === 0) {
        const empty = document.createElement('p'); empty.className = 'tl-note'; empty.textContent = '記録がありません。';
        s6.appendChild(empty);
      }
      for (const e of rows) {
        const row = document.createElement('div');
        row.className = 'tl-row' + (e.atMs === null ? ' tl-unknown' : '');
        const when = document.createElement('span'); when.className = 'tl-when';
        when.textContent = e.at ? fmtDate(e.at) : '日時不明';
        const kind = document.createElement('span'); kind.className = 'tl-kind'; kind.textContent = e.label;
        const detail = document.createElement('span'); detail.className = 'tl-detail'; detail.textContent = e.detail || '';
        const src = document.createElement('span'); src.className = 'tl-src';
        src.textContent = e.source + (e.field ? '.' + e.field : '');
        row.appendChild(when); row.appendChild(kind); row.appendChild(detail); row.appendChild(src);
        s6.appendChild(row);
      }
    }

    $('mkDossierClose').addEventListener('click', () => { $('mkDossier').hidden = true; });

    // ── 施策パネル（dry-run のみ。実行系は既存フローに委ねる）───────────
    /** 施策 dry-run の実行世代。古い応答が後から届いても描かない */
    let mkActionSeq = 0;
    $('mkActionDry').addEventListener('click', async () => {
      const btn = $('mkActionDry');
      if (btn.dataset.busy === '1') return;        // 連打で結果が積み上がるのを防ぐ
      const kind = $('mkActionKind').value;
      // 引き継ぎ中は画面選択を使わず、サーバーが付与成功者を再導出する（read-only）
      const handoffOp = mkState.handoff ? mkState.handoff.operationId : '';
      const ids = handoffOp ? [] : [...mkSelected];
      const box = $('mkActionResult');
      box.innerHTML = '';
      if (!handoffOp && ids.length === 0) { $('mkActionState').textContent = '対象を選択してください。'; return; }
      const seq = ++mkActionSeq;
      btn.dataset.busy = '1'; btn.disabled = true;
      $('mkActionState').textContent = '確認中…（書き込みは行いません）';
      try {
        const PV = window.__planView;
        const rowsById = new Map((mkData && mkData.rows ? mkData.rows : []).map((r) => [r.recordId, r]));
        let result; let planKind; let campaign = null;
        const key = kind.startsWith('premium-') ? 'premiumOfferId' : 'lightOfferId';
        // 引き継ぎ中は recordId を 1 つも送らない（サーバー側で付与成功者を再導出）
        result = await cbCall(handoffOp
          ? { action: 'dryRun', [key]: kind, grantOperationId: handoffOp }
          : { action: 'dryRun', [key]: kind, recordIds: ids });
        planKind = PV.PLAN_KIND.GRANT_OFFER;
        if (seq !== mkActionSeq) return;          // 新しい確認が始まっている。古い結果は捨てる
        if (!result) { $('mkActionState').textContent = '確認できませんでした。'; return; }
        // 対象/除外の判定は API の結果をそのまま使う（画面では再判定しない）
        const resolvedIds = handoffOp && result.handoff
          ? new Array(Number(result.handoff.resolved) || 0).fill('handoff')
          : ids;
        const view = PV.buildPlanView({ kind: planKind, selectedIds: resolvedIds, rowsById, result, campaign, nowMs: Date.now() });
        box.innerHTML = '';                        // 常に最新の 1 件だけを出す
        // 引き継ぎ中は「すでに配り終えた人の下見」であることを最初に言う
        if (handoffOp) {
          const h = document.createElement('p');
          h.className = 'note';
          h.textContent = '引き継ぎ中の付与成功者 ' + ((result.handoff && result.handoff.resolved) || 0) + ' 名の下見です。'
            + 'この顧客には無料特典が付与済みで、ここでは何も書き込みません（追加のオファー発行もありません）。'
            + 'メール送信とは別の操作です。';
          box.appendChild(h);
        }
        renderPlanView(box, view);
        $('mkActionState').textContent = view.executable
          ? '確認しました。実行はカムバック特典タブの確認 → 実行から行ってください。'
          : '⛔ この内容では実行できません: ' + view.blockers.join(' / ');
      } catch (e) {
        if (seq === mkActionSeq) {
          $('mkActionState').textContent = '確認に失敗しました: ' + (e && e.message ? e.message : 'unknown');
        }
      } finally {
        if (seq === mkActionSeq) { btn.dataset.busy = ''; btn.disabled = false; }
      }
    });

    /** dry-run の結果を「実行前確認」の形で描く（タブ: 対象者 / 除外者 / 理由 / 実行内容 / rollback）*/
    function renderPlanView(box, view) {
      const head = document.createElement('div');
      head.className = 'pv-head' + (view.executable ? '' : ' pv-blocked');
      head.textContent = view.title
        + '　選択 ' + view.selectedCount + ' / 対象 ' + view.includedCount + ' / 除外 ' + view.excludedCount;
      box.appendChild(head);

      const warn = document.createElement('p'); warn.className = 'tl-note'; warn.textContent = '⚠️ ' + view.warning;
      box.appendChild(warn);
      for (const b of view.blockers) {
        const p2 = document.createElement('p'); p2.className = 'pv-blocker'; p2.textContent = '⛔ ' + b;
        box.appendChild(p2);
      }

      const tabs = document.createElement('div'); tabs.className = 'pv-tabs';
      const panes = document.createElement('div');
      const TABS = [
        ['対象者 ' + view.included.length, () => {
          const s = dossierSection(panes, view.detailComplete ? 'この人に実行されます' : '対象者を確定できません');
          if (!view.detailComplete) {
            dossierRow(s, '⛔ 未確定', '権威 API から除外者の明細を取得できないため、誰が対象かを特定できません。推測で一覧を出しません。', 'ng');
          }
          // 特典・オファーは「変更前 → 変更後」を dry-run の preview からそのまま出す
          const prevMap = new Map(((view.previews) || []).map((x) => [x.recordId, x]));
          if (view.included.length === 0) dossierRow(s, '—', '対象者はいません', 'ng');
          for (const p3 of view.included) {
            dossierRow(s, (p3.name || p3.email || p3.recordId),
              [p3.email, CONTRACT_LABEL[p3.contract] || p3.contract,
                '閲覧: ' + [p3.access && p3.access.free && '無料', p3.access && p3.access.light && 'Light',
                  p3.access && p3.access.premium && 'Premium', p3.access && p3.access.sanrenpuku && '三連複'].filter(Boolean).join('/'),
                '最終ログイン: ' + (p3.lastLoginAt ? fmtDate(p3.lastLoginAt) : '記録なし'),
                'オファー: ' + p3.liveOfferCount + ' 件',
                '特典: ' + (p3.promoActive ? (p3.promoUntil ? '〜' + fmtDate(p3.promoUntil) : 'あり') : 'なし'),
                '次回送信可: ' + (p3.nextSendableAt ? fmtDate(p3.nextSendableAt) : 'いま送れる'),
              ].join(' / '), 'ok');
            const pv = prevMap.get(p3.recordId);
            if (pv) dossierRow(s, '　変更前 → 変更後', (pv.before || '—') + ' → ' + (pv.after || '—'), 'sub-row');
          }
        }],
        ['除外者 ' + view.excluded.length, () => {
          const s = dossierSection(panes, 'この人には実行されません');
          if (!view.detailAvailable) dossierRow(s, '注意', '明細が取得できないため理由集計のみ表示します', 'ng');
          for (const p4 of view.excluded) {
            dossierRow(s, (p4.name || p4.email || p4.recordId),
              p4.reasonLabel + '（' + p4.reasonCode + '）', p4.known ? '' : 'ng');
          }
        }],
        ['除外理由', () => {
          const s = dossierSection(panes, '除外理由の集計');
          if (view.reasonSummary.length === 0) dossierRow(s, '—', '除外はありません', 'ok');
          for (const r of view.reasonSummary) {
            dossierRow(s, r.label + '（' + r.code + '）', r.count + ' 名', r.known ? '' : 'ng');
          }
        }],
        ['実行内容', () => {
          const s = dossierSection(panes, '実行すると何が起きるか');
          if (view.campaignId) {
            dossierRow(s, 'キャンペーンID', view.campaignId + ':v' + view.version);
            dossierRow(s, '件名', view.subject || '—');
          }
          if (view.offer) {
            dossierRow(s, 'オファー', (view.offer.offerId || '') + ' ¥'
              + Number(view.offer.regularPrice || 0).toLocaleString() + ' → ¥'
              + Number(view.offer.offerPrice || 0).toLocaleString());
            if (view.offer.earliestExpiresAt) dossierRow(s, '有効期限（最短）', fmtDate(view.offer.earliestExpiresAt));
          }
          if (view.grants) {
            if (view.grants.light) dossierRow(s, 'Light 特典', view.grants.light);
            if (view.grants.premium) dossierRow(s, 'Premium 特典', view.grants.premium);
          }
          dossierRow(s, 'operationId', view.operationId || view.planFingerprint || '—');
          dossierRow(s, '対象件数', view.includedCount + ' 名（除外 ' + view.excludedCount + ' 名 / 選択 ' + view.selectedCount + ' 名）');
          dossierRow(s, '対象者一覧', view.detailComplete ? '確定（対象者タブを参照）' : '⛔ 未確定（誰が対象か特定できません）', view.detailComplete ? 'ok' : 'ng');
          dossierRow(s, '取り消し方法', view.rollback.join(' / '));
          dossierRow(s, 'この操作の副作用', view.sideEffects + '（dry-run のため本番は未変更）', 'ok');
          dossierRow(s, '本番変更', 'この確認では行われません（実行は各タブの確認 → 実行）', 'ok');
        }],
        ['rollback', () => {
          const s = dossierSection(panes, '取り消し方法');
          for (const line of view.rollback) dossierRow(s, '・', line);
        }],
      ];
      TABS.forEach(([label, render], i) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn-ghost btn-sm' + (i === 0 ? ' is-on' : '');
        b.textContent = label;
        b.addEventListener('click', () => {
          panes.innerHTML = '';
          [...tabs.children].forEach((c) => c.classList.remove('is-on'));
          b.classList.add('is-on');
          render();
        });
        tabs.appendChild(b);
      });
      box.appendChild(tabs);
      box.appendChild(panes);
      TABS[0][1]();
    }

    // ── 実配信（キューを配信基盤へ渡す）────────────────────────────

    // ══════════════════════════════════════════════════════════════
    //  操作順の管理（押せる／押せないの根拠は marketingConsoleFlow.js が単一源）
    //  画面はここで判定を呼ぶだけ。判定を画面側に書き直さない。
    // ══════════════════════════════════════════════════════════════
    // 判定の単一源。module script（上の <script>）が window へ橋渡しする
    const flowApi = () => window.__mkFlow;
    /** 画面の現在状態。dry-run の指紋もここに持つ */
    const mkState = {
      loadedCount: 0, selectedIds: [], filters: {}, campaignId: '', campaignVersion: '',
      campaign: null, dryRun: null, enqueued: false, dispatch: {}, busy: false,
      sendEnabled: false, dispatchEnabled: false,
      // カムバック無料付与からの引き継ぎ（operationId と人数だけ。recordId は持たない）
      handoff: null,
    };

    /**
     * ── 無料付与の成功者を引き継ぐ（受け入れ側）─────────────────────
     * 引き継ぐのは **操作 ID と人数だけ**。誰が対象かは dry-run のたびに
     * Function が Customers を読み直して確定する（画面は recordId を持たない）。
     * ここで顧客を選び直させないことが、この導線の目的そのもの。
     */
    /**
     * 引き継ぎ判定モジュールへの橋渡し。**未定義でも例外にしない**。
     * ここで throw すると初期化の残り全部が止まり、画面のあちこちが無言で死ぬ
     * （本番で実際に起きた）。使えないときは「引き継ぎ無し」として素通りさせる。
     */
    const handoffApi = () => window.__cbHandoff || null;

    function mkHandoffAdopt(ticket) {
      const api = handoffApi();
      if (!api) {                       // bridge 未読込。黙って失敗せず、理由を出す
        mkNotify('err', '引き継げませんでした', '画面の読み込みが完了していません。再読み込みしてください。');
        return false;
      }
      if (!ticket || !ticket.operationId || !(Number(ticket.grantedCount) > 0)) {
        mkNotify('warn', '引き継げませんでした',
          api.HANDOFF_BLOCK_LABEL[api.HANDOFF_BLOCK.NO_RECIPIENTS]);
        return false;
      }
      api.saveHandoff(sessionStorage, ticket);
      mkState.handoff = {
        operationId: ticket.operationId,
        grantedCount: Number(ticket.grantedCount),
        // 何を配ったか（案内文面の自動選択に使う。offerId だけで PII は無い）
        grantOffers: ticket.grantOffers || null,
      };
      // 引き継ぎは母集団の差し替えなので、直前の確認結果は必ず捨てる
      mkState.dryRun = null;
      mkState.enqueued = false;
      mkState.dispatch = {};
      mkSelected.clear();
      mkHandoffRender(ticket);
      mkApplyHandoffCampaign();
      mkSyncFlow();
      const what = mkHandoffGrantLabel(ticket);
      mkNotify('ok', what + 'の付与成功者' + Number(ticket.grantedCount) + '名を引き継ぎました',
        '顧客を選び直す必要はありません。文面を確認して、この人数のままキュー登録・送信へ進めます。');
      return true;
    }

    /**
     * 引き継いだ付与内容に対応する文面へ選び直す。
     * 対応が無ければ選択は変えず、「対応テンプレート未設定」を知らせて手動選択させる。
     * **運用テスト専用（カナリア）へは絶対に切り替えない**（単一源がそもそも返さない）。
     */
    /**
     * 引き継いだ付与内容の表示名（「Light 30日無料」など）。
     * カタログの名前をそのまま使い、画面で文字列を組み立て直さない。
     */
    function mkHandoffGrantLabel(ticket) {
      const ids = [ticket && ticket.grantOffers && ticket.grantOffers.light,
        ticket && ticket.grantOffers && ticket.grantOffers.premium].filter(Boolean);
      if (ids.length === 0) return '無料特典';
      const names = ids.map((id) => {
        for (const selId of ['cbLightOffer', 'cbPremiumOffer']) {
          const sel = $(selId);
          const opt = sel && [...sel.options].find((o) => o.value === id);
          if (opt) return opt.textContent;
        }
        return id;
      });
      return names.join(' + ');
    }

    function mkApplyHandoffCampaign() {
      if (!mkCampaigns.length) return;               // カタログ未取得。読み込み時に再実行される
      const pick = window.__cbCampaign.pickInitialCampaign({
        campaigns: mkCampaigns, handoff: mkState.handoff,
      });
      const sel = $('mkCampaign');
      if (pick.campaignId && sel && sel.value !== pick.campaignId) {
        sel.value = pick.campaignId;
        mkApplyCampaignSelection();
        renderCampDesc();
      }
      if (mkState.handoff && !pick.matchedGrant && pick.label) {
        mkNotify('warn', '送る文面を選んでください', pick.label);
      }
    }

    /**
     * 操作 ID から引き継ぎ直す（**read-only**）。
     * サーバーが付与成功者を読み直し、件数・付与種別・付与日時を返す。
     * 画面は recordId を受け取らないし、URL にも何も載せない。
     */
    async function mkRehandoff() {
      const btn = $('mkRehandoffBtn');
      if (btn.dataset.busy === '1') return;                  // 二重クリック防止
      const op = $('mkRehandoffOp').value.trim();
      const state = $('mkRehandoffState');
      if (!op) { state.textContent = '操作 ID を入力してください。'; return; }
      btn.dataset.busy = '1'; btn.disabled = true;
      state.textContent = '付与成功者を読み直しています…（書き込みは行いません）';
      try {
        // カムバック側の read-only API（付与も取り消しもしない）
        const out = await cbCallDetailed({ action: 'handoffLookup', operationId: op });
        if (!out.ok || !out.data || !(Number(out.data.resolved) > 0)) {
          const d = out.data || {};
          state.textContent = (d.error || '引き継ぎを作れませんでした。')
            + (d.reason === handoffApi().HANDOFF_BLOCK.EXPIRED
              ? '（付与から時間が経ちすぎています）' : '');
          return;
        }
        const d = out.data;
        // 実データの付与種別から offerId を逆引きし、案内文面の自動選択に使う
        const grantOffers = window.__cbCampaign.buildGrantOffersFromKinds(d.kinds || {});
        const adopted = window.__mkHandoff.adopt({
          operationId: d.operationId,
          grantedCount: Number(d.resolved) || 0,
          grantOffers,
          notGrantedCount: 0,
          notGrantedReasons: [],
          issuedAtMs: Date.now(),
          expiresAtMs: Date.parse(d.expiresAt) || (Date.now() + handoffApi().HANDOFF_TTL_MS),
          canHandoff: true,
        });
        if (!adopted) { state.textContent = '引き継げませんでした。'; return; }
        const k = (d.kinds && (d.kinds.light || d.kinds.premium)) || {};
        const kindText = k.mixed ? '種別が混在（自動選択しません）'
          : k.lifetime === true ? '永久無料'
            : Number.isFinite(k.durationDays) ? (k.durationDays + '日無料') : '種別不明';
        state.textContent = '引き継ぎました: ' + d.resolved + ' 名 / ' + kindText
          + ' / 付与日時 ' + fmtDate(d.grantedAt) + '（付与のやり直しはしていません）';
      } catch (e) {
        state.textContent = '読み直しに失敗しました。管理シークレットと操作 ID を確認してください。';
      } finally {
        btn.dataset.busy = ''; btn.disabled = false;
      }
    }

    /**
     * 直近の付与成功者を 1 クリックで引き継ぐ（**read-only**）。
     * どの操作かはサーバーが実データから決めるので、**運用者は何も入力しない**。
     * operationId は画面にも URL にも出さない（dry-run の鍵として保持するだけ）。
     */
    async function mkRecoverLatestHandoff() {
      const btn = $('mkRecoverBtn');
      const state = $('mkRecoverState');
      if (!btn || btn.dataset.busy === '1') return;          // 二重クリック防止
      btn.dataset.busy = '1'; btn.disabled = true;
      state.textContent = '直近の付与操作を読み直しています…（書き込みは行いません）';
      try {
        const out = await cbCallDetailed({ action: 'handoffLatest' });
        if (!out.ok || !out.data || !(Number(out.data.resolved) > 0)) {
          const d = out.data || {};
          state.textContent = (d.error || '引き継げる付与操作が見つかりませんでした。')
            + (d.reason === handoffApi().HANDOFF_BLOCK.EXPIRED
              ? '（付与から時間が経ちすぎています。下の「操作 ID を指定して引き継ぎ直す」を使ってください）' : '');
          return;
        }
        const d = out.data;
        const adopted = window.__mkHandoff.adopt({
          operationId: d.operationId,
          grantedCount: Number(d.resolved) || 0,
          // 実データの付与種別から offerId を逆引きし、案内文面の自動選択に使う
          grantOffers: window.__cbCampaign.buildGrantOffersFromKinds(d.kinds || {}),
          notGrantedCount: 0,
          notGrantedReasons: [],
          issuedAtMs: Date.now(),
          expiresAtMs: Date.parse(d.expiresAt) || (Date.now() + handoffApi().HANDOFF_TTL_MS),
          canHandoff: true,
        });
        state.textContent = adopted ? '' : '引き継げませんでした。';
      } catch (e) {
        state.textContent = '読み直しに失敗しました。管理シークレットを確認してください。';
      } finally {
        btn.dataset.busy = ''; btn.disabled = false;
      }
    }

    /**
     * 復旧口の出し分け。**通常フローでは出さない**。
     * 引き継ぎ中でもなく、顧客も 1 人も選んでいない（＝対象 0 名）ときだけ見せる。
     */
    function mkRenderRecoverBar() {
      const box = $('mkRecoverBar');
      if (!box) return;
      const idle = !mkState.handoff && mkSelected.size === 0;
      box.hidden = !idle;
      if (!idle) $('mkRecoverState').textContent = '';
    }

    /** 引き継ぎを外す（通常の顧客選択へ戻す） */
    function mkHandoffRelease(quiet) {
      handoffApi().clearHandoff(sessionStorage);
      mkState.handoff = null;
      mkState.dryRun = null;
      mkState.enqueued = false;
      mkState.dispatch = {};
      mkHandoffRender(null);
      mkSyncFlow();
      if (!quiet) mkNotify('info', '引き継ぎを解除しました', '通常どおり顧客を選んで送信できます。');
    }

    /** 引き継ぎ中の帯（人数・操作 ID・期限・解除）。アドレスは出さない */
    function mkHandoffRender(ticket) {
      const box = $('mkHandoffBar');
      if (!box) return;
      box.innerHTML = '';
      if (!ticket || !mkState.handoff) { box.hidden = true; mkRenderRecoverBar(); return; }
      box.hidden = false;
      const t = document.createElement('b');
      t.textContent = '🎁 カムバック無料付与の成功者を引き継ぎ中';
      box.appendChild(t);
      const d = document.createElement('span');
      d.className = 'hb-d';
      d.textContent = handoffApi() ? handoffApi().describeHandoff(ticket, Date.now()) : '';
      box.appendChild(d);
      const note = document.createElement('span');
      note.className = 'hb-note';
      note.textContent = '対象は送信のたびにサーバーが確定します（付与できなかった顧客は含まれません）。';
      box.appendChild(note);
      const off = document.createElement('button');
      off.type = 'button'; off.className = 'btn-ghost btn-sm';
      off.textContent = '引き継ぎを解除';
      off.addEventListener('click', () => mkHandoffRelease(false));
      box.appendChild(off);
      mkRenderRecoverBar();
    }

    /** 保存済みの引き継ぎを復元する（**同じタブの再読み込みに耐える**） */
    function mkHandoffRestore() {
      const api = handoffApi();
      if (!api) {                       // bridge 未読込。復元はできないが画面は生かす
        mkState.handoff = null;
        mkHandoffRender(null);
        return;
      }
      const r = api.loadHandoff(sessionStorage, Date.now());
      if (r.ok) {
        mkState.handoff = {
          operationId: r.handoff.operationId,
          grantedCount: Number(r.handoff.grantedCount),
          grantOffers: r.handoff.grantOffers || null,
        };
        mkHandoffRender(r.handoff);
        mkApplyHandoffCampaign();
        return;
      }
      mkState.handoff = null;
      mkHandoffRender(null);
      // 期限切れ・使用済みは黙って消さず、理由を 1 度だけ知らせてから捨てる
      const B = api.HANDOFF_BLOCK;
      if (r.reason === B.EXPIRED || r.reason === B.ALREADY_QUEUED || r.reason === B.MALFORMED) {
        mkNotify('warn', '引き継ぎを使えません', api.HANDOFF_BLOCK_LABEL[r.reason]);
        api.clearHandoff(sessionStorage);
      }
    }

    /** 画面から Function へ渡す対象指定。引き継ぎ中は recordId を 1 つも送らない */
    function mkTargetPayload() {
      return mkState.handoff
        ? { grantOperationId: mkState.handoff.operationId }
        : { recordIds: [...mkSelected] };
    }

    // カムバック特典タブから呼ばれる入口（**マーケ側の関数をタブ越しに直接呼ばせない**）
    window.__mkHandoff = {
      adopt(ticket) {
        const adopted = mkHandoffAdopt(ticket);
        if (adopted) showTab('mkt');
        return adopted;
      },
      open() { showTab('mkt'); },
    };

    // ══ 大規模セグメントの下見（read-only）══════════════════════════
    // **13,000 件規模を DOM へ描画しない**。件数と除外理由だけを受け取って出す。
    // 個別に顧客を選ぶ既存の一覧（Step 1〜2）とは別物として扱う。

    let mkSegLoaded = false;

    /** セグメント一覧を埋める（初回だけ。サーバーが持つ定義をそのまま出す） */
    async function mkSegInit() {
      const sel = $('mkSegSelect');
      if (!sel || mkSegLoaded) return;
      const out = await mkCall({ action: 'segments', sampleSize: 0 });
      if (!out || !Array.isArray(out.segments)) return;
      sel.innerHTML = '';
      for (const s of out.segments) {
        const o = document.createElement('option');
        o.value = s.segmentId;
        o.textContent = s.segmentName + '（' + s.sendable + ' 名）';
        o.title = s.description || '';
        sel.appendChild(o);
      }
      mkSegLoaded = true;
      mkRenderMeasurement(out.measurement);
      mkRenderEngagement(out.engagement, null);
    }

    /** 選んだセグメントの件数を数える（送信もキュー登録もしない） */
    async function mkSegPreview() {
      const btn = $('mkSegLoad');
      const state = $('mkSegState');
      if (!btn || btn.dataset.busy === '1') return;
      btn.dataset.busy = '1'; btn.disabled = true;
      state.textContent = '数えています…（送信もキュー登録もしません）';
      try {
        const out = await mkCall({
          action: 'segments', segmentId: $('mkSegSelect').value, sampleSize: 5,
        });
        if (!out || !Array.isArray(out.segments) || !out.segments[0]) {
          state.textContent = '数えられませんでした。管理シークレットを確認してください。';
          return;
        }
        mkRenderSegment(out.segments[0], out);
        mkRenderMeasurement(out.measurement);
        mkRenderEngagement(out.engagement, out.segments[0]);
        state.textContent = '';
      } finally {
        btn.dataset.busy = ''; btn.disabled = false;
      }
    }

    /** 件数だけを描く。**顧客 1 件も DOM へ出さない** */
    function mkRenderSegment(seg, out) {
      const box = $('mkSegResult');
      if (!box) return;
      box.innerHTML = '';
      box.hidden = false;
      const row = (k, v, cls) => {
        const d = document.createElement('div'); d.className = 'dp-row ' + (cls || '');
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); box.appendChild(d);
      };
      row('セグメント', seg.segmentName);
      row('母数', seg.total + ' 名');
      row('送信できる人数', seg.sendable + ' 名', seg.sendable > 0 ? 'is-ok' : 'is-ng');
      row('除外', seg.excluded + ' 名');
      const reasons = Object.entries(seg.byReasonLabeled || {});
      row('除外理由', reasons.length
        ? reasons.map(([k, n]) => k + ' ' + n + ' 名').join(' / ') : '—');
      row('対象条件', seg.description || '—');
      row('条件のハッシュ', String(seg.conditionHash || '—'));
      row('最終計算日時', out.evaluatedAt || '—');
      if (seg.balanced !== true) {
        row('⚠️ 検算', '母数と内訳が一致しません（数え方を確認してください）', 'is-ng');
      }
      if (seg.ignoredRecords && (seg.ignoredRecords.duplicateEmail || seg.ignoredRecords.noEmail)) {
        row('母数に入れなかった行',
          '重複アドレス ' + (seg.ignoredRecords.duplicateEmail || 0) + ' 行 / アドレス無し '
          + (seg.ignoredRecords.noEmail || 0) + ' 行');
      }
      // 検証用サンプルは**属性だけ**（アドレス・氏名・recordId は受け取っていない）
      if (Array.isArray(seg.sample) && seg.sample.length) {
        const p = document.createElement('p');
        p.className = 'seg-sample';
        p.textContent = '検証用サンプル（匿名・属性のみ）: '
          + seg.sample.map((s) => `${s.plan}/${s.contract}/${s.segment}`).join('、');
        box.appendChild(p);
      }
      const notice = document.createElement('p');
      notice.className = 'blocker';
      notice.textContent = out.notice || 'まだ送信対象は固定されていません。';
      box.appendChild(notice);
      if (out.providerSuppression && out.providerSuppression.available === false) {
        const w = document.createElement('p');
        w.className = 'blocker';
        w.textContent = out.providerSuppression.note;
        box.appendChild(w);
      }
    }

    /**
     * 計測状態。**「0 件」と「計測していない」を必ず区別して出す**。
     * 2026-08-04 の配信では、実際は 9 名開封していたのに台帳は 0 だった。
     */
    function mkRenderMeasurement(m) {
      const box = $('mkMeasureBox');
      if (!box || !m) return;
      const lines = [
        '開封の計測: ' + m.openLabel,
        'クリックの計測: ' + m.clickLabel,
      ];
      if (Array.isArray(m.reasons) && m.reasons.length) {
        lines.push('理由: ' + m.reasons.join(' / '));
      }
      if (m.open !== 'enabled' || m.click !== 'enabled') {
        lines.push('※ 計測していない指標は「0」ではなく「—」と表示します。0 と未計測を混同しません。');
      }
      if (m.providerOnly) {
        lines.push('※ 配信基盤側だけで確認できた数値は「参考値」として扱います。');
      }
      box.textContent = lines.join('\n');
      box.className = 'measure-box' + (m.open === 'enabled' && m.click === 'enabled' ? ' ok' : '');
      box.hidden = false;
    }

    /**
     * 反応（engagement）の状況を出す。
     *
     * **「送信対象人数」と「反応なしで除外される人数」を送信前に必ず並べて見せる。**
     * 適用できない状態（開封を計測していない・集計を読めない等）では、区分の人数を
     * **参考値**と断り、「除外は適用していません」と明示する。
     * サーバーが `applied` と理由を返すので、画面側で判定し直さない。
     */
    function mkRenderEngagement(eng, seg) {
      const box = $('mkEngBox');
      if (!box) return;
      if (!eng) { box.hidden = true; return; }
      box.innerHTML = '';
      box.hidden = false;

      const row = (k, v, cls) => {
        const d = document.createElement('div'); d.className = 'dp-row ' + (cls || '');
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); box.appendChild(d);
      };

      const c = eng.counts || {};
      const t = eng.thresholds || {};
      const applied = eng.applied === true;

      row('反応なし除外', applied ? '適用中' : '適用していません', applied ? 'is-ok' : 'is-ng');
      if (!applied) row('適用しない理由', eng.reasonLabel || eng.reason || '—');

      if (seg) {
        row('このセグメントの送信対象', seg.sendable + ' 名', seg.sendable > 0 ? 'is-ok' : 'is-ng');
        const blocked = (eng.blockedBySegment || {})[seg.segmentId];
        row('うち 反応なしで除外',
          applied ? (Number(blocked || 0) + ' 名') : '0 名（適用していないため除外していません）');
      }

      row('閾値', '観察のみ ' + (t.lowEngagementSends ?? '—') + ' 通 / 除外 '
        + (t.inactiveDelivered ?? '—') + ' 通 / 強い除外 ' + (t.hardInactiveDelivered ?? '—') + ' 通');
      row('区分' + (applied ? '' : '（参考値）'),
        '反応あり ' + (c.active || 0) + ' 名 / 観察中 ' + (c.lowEngagement || 0)
        + ' 名 / 除外 ' + (c.inactive || 0) + ' 名 / 強い除外 ' + (c.hardInactive || 0)
        + ' 名 / 判断材料なし ' + (c.unknown || 0) + ' 名');

      const cov = eng.coverage || {};
      row('数えている期間', cov.since ? (cov.since + ' 以降の配信のみ') : '—（記録開始前は数えません）');
      row('開封を記録できている人数', (cov.openRecorded || 0) + ' 名');
      row('最後に反応を受信', cov.lastEventAt || '—');
      if (eng.clickTracking && eng.clickTracking !== 'enabled') {
        row('⚠️ クリック計測', '無効（クリックは常に 0。反応なしの根拠にしません）');
      }

      const p = document.createElement('p');
      p.className = 'blocker';
      p.textContent = eng.note || '';
      box.appendChild(p);
    }


    // ══ 連続配信（シーケンス）══════════════════════════════════════
    // **判定はすべてサーバー**（sequenceProgress.js）。画面は返ってきた数字を出すだけ。
    // ここから送信もキュー登録もしない（dry-run へは対象 recordId を渡して従来経路に乗せる）。

    let mkSeqLoaded = false;
    let mkSeqLast = null;   // 直近の status 応答（Preview / dry-run 引き渡しに使う）

    /** シーケンスを持つキャンペーンだけをセレクトに出す */
    function mkSeqInit() {
      const sel = $('mkSeqSelect');
      if (!sel || mkSeqLoaded) return;
      const seqs = (mkCampaigns || []).filter((c) => c && c.sequence);
      sel.innerHTML = '';
      if (seqs.length === 0) {
        const o = document.createElement('option');
        o.value = ''; o.textContent = '（連続配信のキャンペーンがありません）';
        sel.appendChild(o);
        return;
      }
      for (const c of seqs) {
        const o = document.createElement('option');
        o.value = c.campaignId;
        o.textContent = c.name + '（全' + c.sequence.maxSends + '通）';
        sel.appendChild(o);
      }
      mkSeqLoaded = true;
    }

    async function mkSeqStatus() {
      const btn = $('mkSeqLoad');
      const state = $('mkSeqState');
      const id = $('mkSeqSelect')?.value;
      if (!btn || !id || btn.dataset.busy === '1') return;
      btn.dataset.busy = '1'; btn.disabled = true;
      state.textContent = '数えています…（送信もキュー登録もしません）';
      try {
        const out = await mkCall({ action: 'sequence', campaignId: id });
        if (!out) { state.textContent = '取得できませんでした。'; return; }
        mkSeqLast = out;
        mkSeqRender(out);
        state.textContent = '';
      } finally {
        btn.dataset.busy = ''; btn.disabled = false;
      }
    }

    /** 件数と各ステップの件名を出す。**顧客は 1 件も DOM へ出さない** */
    function mkSeqRender(out) {
      const box = $('mkSeqResult');
      if (!box) return;
      box.innerHTML = '';
      box.hidden = false;
      const row = (k, v, cls) => {
        const d = document.createElement('div'); d.className = 'dp-row ' + (cls || '');
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); box.appendChild(d);
        return d;
      };

      const sum = out.summary || {};
      const stops = sum.byStopReason || {};
      const labels = out.stopLabels || {};
      const auto = out.auto || {};

      row('キャンペーン', out.campaignName + '（' + out.campaignId + ' v' + out.version + '）');
      row('自動配信', auto.enabled ? 'ON' : 'OFF（管理画面から手動で確認・登録します）', auto.enabled ? 'is-ok' : '');
      if (!auto.enabled && Array.isArray(auto.missing) && auto.missing.length) {
        row('　自動配信に必要な設定', auto.missing.join(' / '));
      }
      row('最大配信回数', out.maxSends + ' 通');
      row('対象人数（母数）', (sum.total || 0) + ' 名');
      row('次に送れる人数',
        (out.next && out.next.step ? 'ステップ' + out.next.step + ' へ ' + out.next.recipients + ' 名' : '0 名（いま送れる相手はいません）'),
        out.next && out.next.recipients > 0 ? 'is-ok' : '');
      row('待機中（間隔待ち）', (sum.waiting || 0) + ' 名');
      row('次回予定', out.nextScheduledAt ? String(out.nextScheduledAt).replace('T', ' ').slice(0, 16) : '—');
      row('配信完了', (sum.completed || 0) + ' 名');
      row('自動停止', (sum.stopped || 0) + ' 名');
      row('　うち 購入・契約成立', (stops.purchased || 0) + ' 名', 'is-ok');
      row('　うち 無料体験がまだ（付与が必要）', (stops.grant_required || 0) + ' 名');
      row('　うち 無料体験の期間終了', (stops.grant_expired || 0) + ' 名');
      row('　うち 付与の取り消し', (stops.grant_revoked || 0) + ' 名');
      row('　うち 期限なし付与（30日体験の対象外）', (stops.grant_lifetime || 0) + ' 名');
      row('　うち 対象コホート外（CSV 取り込みでない）', (stops.not_in_cohort || 0) + ' 名');
      row('　うち 反応なしで除外', (stops.engagement_blocked || 0) + ' 名');
      row('　うち 配信停止・バウンス等', ((stops.not_sendable || 0) + (stops.provider_suppressed || 0) + (stops.soft_bounce || 0)) + ' 名');
      row('　うち 対象条件から外れた', (stops.audience_mismatch || 0) + ' 名');
      if (sum.balanced !== true) row('⚠️ 検算', '母数と内訳が一致しません', 'is-ng');

      // ステップ別（件名 / 間隔 / 送信済み / いま送れる）＋ 実際に届く HTML の確認
      const seq = out.sequence || { steps: [] };
      const sent = sum.sentByStep || {};
      const due = sum.dueByStep || {};
      for (const st of seq.steps) {
        const d = row(
          'ステップ' + st.stepNumber + '（' + (st.delayDays === 0 ? '開始時' : '前回から' + st.delayDays + '日後') + '）',
          st.subject,
        );
        const meta = document.createElement('div');
        meta.className = 'dp-row sub-row';
        const mk = document.createElement('span'); mk.className = 'dp-k'; mk.textContent = '　queue 済み / いま送れる';
        const mv = document.createElement('span'); mv.className = 'dp-v';
        mv.textContent = (sent[st.stepNumber] || 0) + ' 名 / ' + (due[st.stepNumber] || 0) + ' 名';
        meta.appendChild(mk); meta.appendChild(mv);
        box.appendChild(meta);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-ghost btn-sm';
        btn.textContent = '文面を見る（実際に届く HTML）';
        btn.addEventListener('click', () => mkSeqPreview(out.campaignId, st.stepNumber));
        d.appendChild(btn);
      }

      const note = document.createElement('p');
      note.className = 'blocker';
      note.textContent = out.notice || 'まだ何も送っていません。';
      box.appendChild(note);
    }

    /** 実際に届く HTML をそのまま出す（サンプル氏名・プレビュー用配信停止 URL） */
    async function mkSeqPreview(campaignId, step) {
      const out = await mkCall({ action: 'preview', campaignId, step });
      if (!out) return;
      const body = mkOpenModal('ステップ' + step + ' の文面（送信しません）');
      const dl = document.createElement('dl'); dl.className = 'kv';
      kvRow(dl, '件名', out.subject);
      kvRow(dl, 'プリヘッダー', (out.preview && out.preview.preheader) || '—');
      kvRow(dl, 'CTA', ((out.preview && out.preview.ctaLabel) || '') + ' → ' + ((out.preview && out.preview.ctaKind) || ''));
      kvRow(dl, '内容 hash', String(out.contentHash || '').slice(0, 12));
      body.appendChild(dl);

      const frame = document.createElement('iframe');
      frame.className = 'prev-frame';
      frame.setAttribute('sandbox', '');
      frame.srcdoc = '<body style="margin:0;background:#fff;">' + out.html + '</body>';
      body.appendChild(frame);

      const pre = document.createElement('pre');
      pre.className = 'mail-text';
      pre.textContent = out.text || '';
      body.appendChild(pre);
    }

    // ══ 無料体験の入口（自動付与）の下見 ═══════════════════════════
    // **判定はサーバー**（lightTrialAutoGrant.js）。画面は返ってきた件数を出すだけ。
    // ここから付与もキュー登録もしない。

    async function mkTrialPreview() {
      const btn = $('mkTrialLoad');
      const state = $('mkTrialState');
      if (!btn || btn.dataset.busy === '1') return;
      btn.dataset.busy = '1'; btn.disabled = true;
      state.textContent = '数えています…（付与もキュー登録もしません）';
      try {
        const out = await mkCall({ action: 'trialGrant' });
        if (!out) { state.textContent = '取得できませんでした。'; return; }
        mkTrialRender(out);
        state.textContent = '';
      } finally {
        btn.dataset.busy = ''; btn.disabled = false;
      }
    }

    /** 件数だけを描く。**顧客は 1 件も DOM へ出さない** */
    function mkTrialRender(out) {
      const box = $('mkTrialResult');
      if (!box) return;
      box.innerHTML = '';
      box.hidden = false;
      const row = (k, v, cls) => {
        const d = document.createElement('div'); d.className = 'dp-row ' + (cls || '');
        const a = document.createElement('span'); a.className = 'dp-k'; a.textContent = k;
        const b = document.createElement('span'); b.className = 'dp-v'; b.textContent = v;
        d.appendChild(a); d.appendChild(b); box.appendChild(d);
      };
      const c = out.cohort || {};
      const auto = out.auto || {};
      row('自動付与', auto.enabled ? 'ON' : 'OFF（管理画面から手動で付与します）', auto.enabled ? 'is-ok' : '');
      if (!auto.enabled && Array.isArray(auto.missing) && auto.missing.length) {
        row('　自動付与に必要な設定', auto.missing.join(' / '));
      }
      if (out.abort && !out.operationId) {
        row('⚠️ 下見を確定できません', String(out.abort) + '（取得の上限に達しました。付与もしていません）', 'is-ng');
      }
      row('読んだ顧客', (out.recordsFetched || 0) + ' 名 / ' + (out.pagesFetched || 0) + ' ページ');
      row('　うち CSV 取り込み', (c.observed || 0) + ' 名'
        + (c.partial ? '（**全体数ではありません**）' : ''), (c.observed || 0) > 0 ? 'is-ok' : 'is-ng');
      const batches = Object.entries(c.byBatch || {});
      row('　バッチ別（読んだ範囲）', batches.length ? batches.map(([k, n]) => k + ' ' + n + ' 名').join(' / ') : '—');
      row('今回処理予定', (out.batch || 0) + ' 名（1 回の上限 ' + (out.batchSize || 0) + ' 名'
        + (out.batchSizeSource === 'env' ? '・env 指定'
          : (out.batchSizeSource === 'request-preview' ? '・下見だけの仮指定' : '・既定')) + '）');
      // 全件走査をやめたので**正確な残数は出さない**。嘘の数字より「まだ有る／無い」を出す
      row('残り（正確な数）', '未算出（全件走査を廃止したため）');
      row('まだ候補があるか', out.moreAvailable === true ? 'あり（次回以降の実行で順に処理）'
        : (out.moreAvailable === false ? 'なし（読んだ範囲で打ち止め）' : '—'));
      const bar = out.barrier || {};
      row('次バッチ可否', bar.nextBatchAllowed ? '進めます' : '⛔ 待機中（Step1 未処理があるため付与しません）',
        bar.nextBatchAllowed ? 'is-ok' : 'is-ng');
      row('　付与済み（自動付与ぶん）', (bar.granted || 0) + ' 名');
      row('　Step1 未処理（outstanding）', (bar.outstandingStep1 || 0) + ' 名',
        (bar.outstandingStep1 || 0) > 0 ? 'is-ng' : '');
      row('　片付いた（resolved）', (bar.resolved || 0) + ' 名');
      const brs = Object.entries(bar.byReason || {});
      if (brs.length) row('　片付いた内訳', brs.map(([k, n]) => k + ' ' + n + ' 名').join(' / '));
      row('上限の絶対値（hard max）', (out.hardMax || 0) + ' 名（これを超える指定は実行しません）');
      row('計画の指紋', String(out.planFingerprint || '—').slice(0, 16));
      if (out.abort) row('⚠️ 実行できない理由', out.abort + (out.abortReason ? '（' + out.abortReason + '）' : ''), 'is-ng');
      const ex = Object.entries(out.excludedByReason || {});
      row('除外理由', ex.length ? ex.map(([k, n]) => k + ' ' + n + ' 名').join(' / ') : '—');
      if (c.observable === false) {
        const w = document.createElement('p'); w.className = 'blocker'; w.textContent = c.note;
        box.appendChild(w);
      }
      const p = document.createElement('p'); p.className = 'blocker'; p.textContent = out.notice || '';
      box.appendChild(p);
    }

    $('mkTrialLoad')?.addEventListener('click', mkTrialPreview);

    $('mkSeqLoad')?.addEventListener('click', mkSeqStatus);

    $('mkSegLoad')?.addEventListener('click', mkSegPreview);

    // ── 外部顧客リストの取り込み（下見だけ）────────────────────────
    // ⚠️ ここから書き込みは一切行わない。API 側にも取り込みの実行経路は無い。
    // ⚠️ 13,000 行を DOM へ描かない。**件数と理由コードだけ**を表に出す。
    //    CSV の中身（アドレス・氏名）はブラウザのメモリから出さず、API へは
    //    base64 のまま渡して、返ってくるのは件数だけ。
    const IMPORT_API = '/.netlify/functions/admin-customer-import';

    async function impCall(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { $('connBody').hidden = false; throw new Error('管理シークレットを入力してください'); }
      const res = await fetch(IMPORT_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
      return data;
    }

    /** ファイル → base64（中身は画面に出さない） */
    function impReadBase64(file) {
      return new Promise((resolve, reject) => {
        const fr = new FileReader();
        fr.onerror = () => reject(new Error('ファイルを読み取れませんでした'));
        fr.onload = () => {
          const buf = new Uint8Array(fr.result);
          let bin = '';
          const CHUNK = 0x8000;
          for (let i = 0; i < buf.length; i += CHUNK) {
            bin += String.fromCharCode.apply(null, buf.subarray(i, i + CHUNK));
          }
          resolve(btoa(bin));
        };
        fr.readAsArrayBuffer(file);
      });
    }

    function impRow(tbody, label, value, cls) {
      const tr = document.createElement('tr');
      const th = document.createElement('th'); th.textContent = label;
      const td = document.createElement('td'); td.className = 'n' + (cls ? ' ' + cls : '');
      td.textContent = value;
      tr.appendChild(th); tr.appendChild(td); tbody.appendChild(tr);
    }

    function impRender(out) {
      const box = $('impResult');
      if (!box) return;
      box.innerHTML = '';
      box.hidden = false;

      const c = out.counts || {};
      const table = document.createElement('table');
      table.className = 'imp-table';
      const tbody = document.createElement('tbody');
      impRow(tbody, '総行数', String(c.総行数 ?? 0));
      impRow(tbody, '新規追加の候補', String(c.新規追加候補 ?? 0));
      impRow(tbody, '既存更新の候補', String(c.既存更新候補 ?? 0));
      impRow(tbody, '除外', String(c.除外 ?? 0));
      impRow(tbody, '要確認', String(c.要確認 ?? 0));
      table.appendChild(tbody);
      box.appendChild(table);

      if (c.balanced === false) {
        const w = document.createElement('p');
        w.className = 'blocker';
        w.textContent = '⚠️ 母数と内訳の合計が一致しません。この下見は使えません。';
        box.appendChild(w);
      }

      // 理由別（**コードとラベルだけ**。行の中身は出さない）
      const reasons = out.reasonCounts || {};
      const labels = out.reasonLabels || {};
      const keys = Object.keys(reasons).sort((a, b) => reasons[b] - reasons[a]);
      if (keys.length) {
        const h = document.createElement('p');
        h.className = 'imp-meta'; h.textContent = '除外・要確認の理由';
        box.appendChild(h);
        const t2 = document.createElement('table');
        t2.className = 'imp-table';
        const tb2 = document.createElement('tbody');
        for (const k of keys) impRow(tb2, (labels[k] || k) + '（' + k + '）', String(reasons[k]));
        t2.appendChild(tb2);
        box.appendChild(t2);
      }

      const p = out.preview || {};
      const ak = out.akSnapshot || {};
      const meta = document.createElement('p');
      meta.className = 'imp-meta';
      meta.textContent = [
        '文字コード: ' + (p.encoding || '不明'),
        '読み取った列: ' + ((p.detectedColumns || []).join(' / ') || 'なし'),
        '取り込まない列: ' + ((p.ignoredColumns || []).join(' / ') || 'なし'),
        'AK 既存: ' + (ak.uniqueEmails ?? '—') + ' 件（重複 ' + (ak.duplicateEmails ?? '—') + ' 件）',
        '下見 ID: ' + (p.importPreviewId || '—'),
        '有効期限: ' + (p.expiresAt || '—'),
        '指紋: ' + (p.summaryHash || '—'),
        '書き込み: ' + (p.written || 'なし'),
      ].join('\n');
      box.appendChild(meta);

      if (ak.providerSuppressionAvailable === false && ak.providerNote) {
        const w = document.createElement('p');
        w.className = 'blocker';
        w.textContent = ak.providerNote;
        box.appendChild(w);
      }
    }

    $('impPreview')?.addEventListener('click', async () => {
      const input = $('impFile');
      const state = $('impState');
      const file = input && input.files && input.files[0];
      if (!file) { if (state) state.textContent = 'CSV ファイルを選んでください'; return; }
      if (state) state.textContent = '読み取り中…（取り込みはしません）';
      try {
        const contentBase64 = await impReadBase64(file);
        const out = await impCall({ action: 'previewCsv', contentBase64 });
        if (out.ok === false) {
          if (state) state.textContent = out.error || '読み取れませんでした';
          const box = $('impResult');
          if (box) {
            box.hidden = false;
            box.innerHTML = '';
            const p = document.createElement('p');
            p.className = 'blocker';
            p.textContent = (out.error || '読み取れませんでした')
              + ((out.missingColumns || []).length ? '（不足: ' + out.missingColumns.join(', ') + '）' : '');
            box.appendChild(p);
          }
          return;
        }
        impRender(out);
        if (state) state.textContent = '下見が終わりました（まだ取り込まれていません）';
      } catch (e) {
        if (state) state.textContent = e.message || '下見に失敗しました';
      }
    });

    $('impSpec')?.addEventListener('click', async () => {
      const state = $('impState');
      try {
        const spec = await impCall({ action: 'spec' });
        const box = $('impResult');
        if (!box) return;
        box.hidden = false;
        box.innerHTML = '';
        const pre = document.createElement('p');
        pre.className = 'imp-meta';
        pre.textContent = [
          '対応文字コード: ' + (spec.encodings || []).join(' / '),
          '改行: ' + (spec.newlines || []).join(' / '),
          '引用符: ' + (spec.quoting || ''),
          '必須列: ' + (spec.requiredColumns || []).join(', '),
          '任意列: ' + (spec.optionalColumns || []).map((o) => o.column).join(', '),
          '知らない列: ' + (spec.unknownColumns || ''),
          '上限: ' + Math.floor((spec.limits?.maxBytes || 0) / 1024 / 1024) + 'MB / '
            + (spec.limits?.maxRows || 0).toLocaleString() + ' 行',
          '下見の有効期間: ' + (spec.previewTtlMinutes || 0) + ' 分',
          spec.notice || '',
        ].join('\n');
        box.appendChild(pre);
        if (state) state.textContent = '受け入れ仕様を表示しました';
      } catch (e) {
        if (state) state.textContent = e.message || '仕様を取得できませんでした';
      }
    });

    // ── 取り込みジョブ（親ジョブ + 子バッチ）──────────────────────
    // ⚠️ 1 呼び出し = 子バッチ 1 つ。**必ず逐次**（await で直列）に呼ぶ。
    //    並行に走らせると同じアドレスを同時に「まだ無い」と読む危険がある。
    // ⚠️ 画面へ出すのは件数と状態だけ。アドレス・氏名は出さない。
    const IMPORT_JOB_API = '/.netlify/functions/admin-customer-import-job';
    let impJobFiles = [];       // { name, contentBase64 } … 画面には出さない
    let impJobRunning = false;  // 逐次実行中フラグ（二重起動を止める）

    async function impJobCall(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { $('connBody').hidden = false; throw new Error('管理シークレットを入力してください'); }
      const res = await fetch(IMPORT_JOB_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) { const e = new Error(data.error || ('HTTP ' + res.status)); e.code = data.code; e.data = data; throw e; }
      return data;
    }

    async function impJobLoadFiles() {
      const input = $('impJobFile');
      const list = (input && input.files) ? Array.from(input.files) : [];
      if (!list.length) throw new Error('CSV ファイルを選んでください');
      const out = [];
      for (const f of list) out.push({ name: f.name, contentBase64: await impReadBase64(f) });
      impJobFiles = out;
      return out;
    }

    const impJobBatchId = () => ($('impJobBatchId')?.value || '').trim();

    function impJobSetButtons({ canStart, canResume, canCancel }) {
      for (const [id, on] of [['impJobStart', canStart], ['impJobResume', canResume], ['impJobCancel', canCancel]]) {
        const b = $(id);
        if (!b) continue;
        b.disabled = !on;
        b.setAttribute('aria-disabled', String(!on));
      }
    }

    /** 進捗を描く。**件数と状態だけ** */
    function impJobRenderProgress(job, rollback) {
      const box = $('impJobProgress');
      if (!box || !job) return;
      box.hidden = false;
      const set = (id, v) => { const el = $(id); if (el) el.textContent = String(v ?? '-'); };
      set('impJobIdV', job.jobId);
      set('impJobBatchV', job.ImportBatchId);
      set('impJobSourceV', job.Source);
      set('impJobStatusV', job.status);
      set('impJobTotalV', (job['対象総数'] || 0).toLocaleString());
      set('impJobAttemptedV', (job['処理済み'] || 0).toLocaleString());
      set('impJobCreatedV', (job['作成済み'] || 0).toLocaleString());
      set('impJobSkippedV', (job['既存スキップ'] || 0).toLocaleString());
      set('impJobFailedV', (job['失敗'] || 0).toLocaleString());
      set('impJobRemainingV', (job['残件数'] || 0).toLocaleString());
      set('impJobPctV', (job['進捗率'] ?? 0) + '%');
      set('impJobChildV', job['現在の子バッチ'] ?? ('完了 ' + (job['完了した子バッチ'] || 0) + ' / ' + (job['子バッチ数'] || 0)));
      set('impJobUpdatedV', job['最終更新'] || '-');
      const fill = $('impJobBarFill');
      if (fill) fill.style.width = Math.min(100, Number(job['進捗率'] || 0)) + '%';
      if (rollback) {
        const r = $('impJobRollback');
        if (r) r.textContent = '戻すとき: ' + (rollback.steps || []).join(' / ');
      }
      // **完了後は再実行不可**。取消・失敗も同じ
      const finished = !job['再実行可能'];
      impJobSetButtons({ canStart: false, canResume: !finished, canCancel: !finished });
    }

    // 下見（read-only・書き込み 0）
    $('impJobPlan')?.addEventListener('click', async () => {
      const state = $('impJobState');
      try {
        if (!impJobBatchId()) throw new Error('ImportBatchId を入力してください');
        if (state) state.textContent = '下見中…（取り込みはしません）';
        await impJobLoadFiles();
        const out = await impJobCall({ action: 'plan', files: impJobFiles, batchId: impJobBatchId() });
        const box = $('impJobPlanResult');
        if (box) {
          box.hidden = false;
          box.innerHTML = '';
          const pre = document.createElement('p');
          pre.className = 'imp-meta';
          const p = out.plan || {};
          pre.textContent = [
            'jobId: ' + p.jobId,
            'ImportBatchId: ' + p.ImportBatchId,
            'Source: ' + p.Source,
            '対象総数: ' + (p['対象総数'] || 0).toLocaleString() + ' 件',
            '子バッチ数: ' + p['子バッチ数'] + '（1 バッチ最大 ' + p['子バッチ上限'] + ' 件 / まとめ書き ' + p['まとめ書き（1リクエスト）'] + ' 件）',
            '書き込む列: ' + (p['書き込む列'] || []).join(', '),
            '停止リスト: ' + p['停止リスト取得'],
            '確認文字列: ' + out.confirmationPhrase,
            out.notice || '',
          ].join('\n');
          box.appendChild(pre);
        }
        // 書き込みゲートが閉じていれば**開始させない**
        const warn = $('impJobGateWarn');
        if (warn) warn.hidden = out.writeEnabled === true;
        impJobSetButtons({ canStart: out.writeEnabled === true, canResume: false, canCancel: false });
        if (state) state.textContent = out.writeEnabled === true
          ? '下見が終わりました（まだ 1 件も作成していません）'
          : '下見が終わりました。書き込みゲートが閉じているため開始できません。';
      } catch (e) {
        if (state) state.textContent = e.message || '下見に失敗しました';
      }
    });

    /** 完了まで子バッチを**逐次**進める */
    async function impJobDrive() {
      const state = $('impJobState');
      if (impJobRunning) { if (state) state.textContent = 'すでに実行中です'; return; }
      impJobRunning = true;
      impJobSetButtons({ canStart: false, canResume: false, canCancel: true });
      try {
        for (;;) {
          const out = await impJobCall({ action: 'step', files: impJobFiles, batchId: impJobBatchId() });
          impJobRenderProgress(out.job, out.rollback);
          const j = out.job || {};
          if (state) {
            state.textContent = '子バッチ完了: 作成 ' + (j['作成済み'] || 0).toLocaleString()
              + ' / 残り ' + (j['残件数'] || 0).toLocaleString();
          }
          if (out['完了'] === true || !j['再実行可能']) break;
          if ((out.child && out.child.failed > 0)) {
            if (state) state.textContent += '（失敗が出たので止めました。内容を確認してください）';
            break;
          }
        }
      } catch (e) {
        if (state) state.textContent = e.message || '子バッチに失敗しました（続きから再開できます）';
        try {
          const s = await impJobCall({ action: 'status', batchId: impJobBatchId() });
          impJobRenderProgress(s.job, s.rollback);
        } catch { /* 状態取得に失敗しても実行は止める */ }
      } finally {
        impJobRunning = false;
      }
    }

    $('impJobStart')?.addEventListener('click', async () => {
      const state = $('impJobState');
      try {
        const confirmation = ($('impJobConfirm')?.value || '').trim();
        if (!confirmation) throw new Error('確認文字列を入力してください');
        if (state) state.textContent = 'ジョブを開始しています…';
        const out = await impJobCall({
          action: 'start', files: impJobFiles, batchId: impJobBatchId(), confirmation,
        });
        impJobRenderProgress(out.job, out.rollback);
        if (state) state.textContent = 'ジョブを開始しました。子バッチを進めます…';
        await impJobDrive();
      } catch (e) {
        if (state) state.textContent = e.message || '開始できませんでした';
      }
    });

    $('impJobResume')?.addEventListener('click', async () => {
      const state = $('impJobState');
      try {
        if (!impJobFiles.length) await impJobLoadFiles();
        if (state) state.textContent = '続きから再開します…';
        await impJobDrive();
      } catch (e) {
        if (state) state.textContent = e.message || '再開できませんでした';
      }
    });

    $('impJobCancel')?.addEventListener('click', async () => {
      const state = $('impJobState');
      try {
        const out = await impJobCall({ action: 'cancel', batchId: impJobBatchId() });
        impJobRenderProgress(out.job, out.rollback);
        if (state) state.textContent = out.note || '取り消しました（作成済みの行は残ります）';
      } catch (e) {
        if (state) state.textContent = e.message || '取り消せませんでした';
      }
    });

    // ── 自動配信（AK 専用メルマガ自動化・Phase A は下見のみ）──────
    // ⚠️ この経路は **1 通も送らない**。API 側にも送信コードが無い。
    // ⚠️ 画面へ出すのは件数と理由コードだけ。アドレス・氏名は出さない。
    const AUTO_API = '/.netlify/functions/admin-marketing-automation';

    async function autoCall(payload) {
      const secret = secretEl.value.trim();
      if (!secret) { $('connBody').hidden = false; throw new Error('管理シークレットを入力してください'); }
      const res = await fetch(AUTO_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      // ⚠️ **どの応答でも** write ゲートの状態を反映し直す（一覧を読んだ直後だけにしない）
      if (typeof data.writeEnabled === 'boolean') autoApplyWriteGate(data.writeEnabled);
      if (!res.ok) {
        // 拒否されたら即座に閉じる（開いたままの見た目を残さない）
        if (data.code === 'write_blocked') autoApplyWriteGate(false);
        const e = new Error(data.error || ('HTTP ' + res.status)); e.data = data; throw e;
      }
      return data;
    }

    /** write ゲートが開いているかを反映する（**UI で隠すだけにしない**） */
    function autoApplyWriteGate(enabled) {
      for (const id of ['autoSave', 'autoActivate', 'autoPause', 'autoCancel']) {
        const b = $(id);
        if (!b) continue;
        b.disabled = !enabled;
        b.setAttribute('aria-disabled', String(!enabled));
      }
      const note = $('autoBlockedNote');
      if (note) note.hidden = !!enabled;
    }

    let autoSnapshot = null;   // 直近 dry-run の指紋（ACTIVE 化に必要）
    let autoVersion = null;    // 保存済みの configVersion（**固定値を送らない**）

    /**
     * ⚠️ 設定を触ったら **dry-run の指紋を捨てる**。
     * 残すと「変更前に確かめた対象」で ACTIVE 化を申請してしまう
     * （API 側も再計算して照合するので通らないが、UI で誤解を作らない）。
     */
    function autoInvalidateSnapshot() {
      if (autoSnapshot === null) return;
      autoSnapshot = null;
      const el = $('autoSnapFpV');
      if (el) el.textContent = '-（設定を変更したため再度 下見してください）';
      const state = $('autoState');
      if (state) state.textContent = '設定が変わりました。もう一度 下見してから ACTIVE 化してください。';
    }
    for (const id of ['autoName', 'autoCampaign', 'autoSchedule', 'autoMax', 'autoQuietStart', 'autoQuietEnd']) {
      $(id)?.addEventListener('input', autoInvalidateSnapshot);
      $(id)?.addEventListener('change', autoInvalidateSnapshot);
    }

    $('autoList')?.addEventListener('click', async () => {
      const state = $('autoState');
      try {
        if (state) state.textContent = '読み込み中…（送信しません）';
        const out = await autoCall({ action: 'list' });
        autoApplyWriteGate(out.writeEnabled === true);
        const sel = $('autoPick');
        if (sel) {
          sel.innerHTML = '<option value="">自動化を選択…</option>';
          for (const p of (out.presets || [])) {
            const o = document.createElement('option');
            o.value = p.automationId; o.textContent = p.name;
            sel.appendChild(o);
          }
        }
        const box = $('autoListResult');
        if (box) {
          box.hidden = false; box.innerHTML = '';
          const pre = document.createElement('p');
          pre.className = 'imp-meta';
          pre.textContent = [
            '自動化: ' + (out.presets || []).length + ' 件（すべて初期 OFF）',
            ...(out.presets || []).map((p) => '  - ' + p.name + ' / ' + JSON.stringify(p.trigger)
              + ' / 上限 ' + p['既定']['1回の上限'] + ' / ' + p['既定'].quietHours),
            '設計候補（現行 schema では実装しない）: ' + (out['設計候補'] || []).map((d) => d.id).join(', '),
            '保存先: ' + (out.保存先 && out.保存先.ok ? '接続できました' : '接続できません（表示できる保存済み設定はありません）'),
            '本番書き込み: ' + (out.writeEnabled ? '有効' : '未有効'),
          ].join('\n');
          box.appendChild(pre);
        }
        if (state) state.textContent = '読み込みました';
      } catch (e) {
        if (state) state.textContent = e.message || '読み込みに失敗しました';
      }
    });

    // プリセットを選んだら設定フォームへ反映する
    $('autoPick')?.addEventListener('change', async () => {
      const id = ($('autoPick')?.value || '').trim();
      if (!id) return;
      try {
        const out = await autoCall({ action: 'preview', automationId: id });
        const set = (k, v) => { const el = $(k); if (el) el.textContent = String(v ?? '-'); };
        const val = (k, v) => { const el = $(k); if (el) el.value = v ?? ''; };
        set('autoPresetV', id);
        set('autoTriggerV', JSON.stringify(out.campaign ? out.campaign : {}) === '{}' ? '-' : '');
        set('autoTriggerV', JSON.stringify((out && out.trigger) || {}));
        val('autoName', id);
        val('autoSchedule', 'daily');
        val('autoQuietStart', out.quietHours?.start ?? 21);
        val('autoQuietEnd', out.quietHours?.end ?? 8);
        val('autoMax', out['上限'] ?? 200);
        const camp = $('autoCampaign');
        if (camp && out.campaign) {
          camp.innerHTML = '';
          const o = document.createElement('option');
          o.value = out.campaign.campaignId; o.textContent = out.campaign.campaignId;
          camp.appendChild(o);
        }
        set('autoCampVerV', out.campaign?.campaignVersion ?? '-');
        set('autoHashV', String(out.campaign?.contentHash || '-').slice(0, 16) + '…');
      } catch { /* 一覧の読み込み前は無視する */ }
    });

    $('autoPreview')?.addEventListener('click', async () => {
      const state = $('autoState');
      const id = ($('autoPick')?.value || '').trim();
      try {
        if (!id) throw new Error('自動化を選んでください');
        if (state) state.textContent = '下見中…（送信しません）';
        const out = await autoCall({ action: 'preview', automationId: id });
        autoSnapshot = out.snapshotFingerprint || null;
        autoVersion = out.configVersion ?? null;
        const set = (k, v) => { const el = $(k); if (el) el.textContent = String(v ?? '-'); };
        const c = out['件数'] || {};
        $('autoPreviewResult').hidden = false;
        set('autoStatusV', (out.status || 'DRAFT') + (out['基準'] === 'saved' ? '（保存済み設定で下見）' : '（未保存・雛形で下見）'));
        set('autoNextV', out.occurrenceDate);
        set('autoSnapCountV', (out.snapshotCount ?? 0).toLocaleString());
        set('autoSnapFpV', String(out.snapshotFingerprint || '-').slice(0, 16) + '…');
        set('autoTargetV', (c['対象'] ?? 0).toLocaleString());
        set('autoTotalV', (c['母数'] ?? 0).toLocaleString());
        set('autoSkipV', (c['除外'] ?? 0).toLocaleString());
        set('autoLastV', '実行履歴なし');
        for (const k of ['autoQueuedV', 'autoExcludedV', 'autoFailedV', 'autoBlockedV']) set(k, '0（未実行）');
        set('autoReconV', '-（未実行）');
        const reasons = out['除外理由'] || {};
        const r = $('autoSkipReasons');
        if (r) {
          const parts = Object.entries(reasons).map(([k, v]) => k + ': ' + v);
          r.textContent = parts.length ? '除外理由の内訳 — ' + parts.join(' / ') : '除外はありません。';
        }
        const w = $('autoWouldRun');
        if (w) w.textContent = out['静音時間帯か'] ? '現在は静音時間帯です（実行されません）。' : '';
        if (state) state.textContent = '下見が終わりました（1 通も送っていません）';
      } catch (e) {
        if (state) state.textContent = e.message || '下見に失敗しました';
      }
    });

    // 保存系。**未有効なら API が 403 を返す**ので、その内容をそのまま表示する
    async function autoWrite(action, extra) {
      const state = $('autoState');
      const id = ($('autoPick')?.value || '').trim();
      try {
        if (!id) throw new Error('自動化を選んでください');
        const out = await autoCall({ action, automationId: id, presetId: id, ...(extra || {}) });
        if (state) state.textContent = action + ' を実行しました';
        return out;
      } catch (e) {
        const d = e.data || {};
        if (state) {
          state.textContent = d.code === 'write_blocked'
            ? '本番自動配信は未有効のため拒否されました（API 403）'
            : (e.message || action + ' に失敗しました');
        }
        return null;
      }
    }

    $('autoSave')?.addEventListener('click', () => autoWrite('create', {
      overrides: {
        name: ($('autoName')?.value || '').trim(),
        campaignId: ($('autoCampaign')?.value || '').trim() || undefined,
        schedule: ($('autoSchedule')?.value || '').trim(),
        maxRecipients: Number($('autoMax')?.value || 0),
        quietHours: { start: Number($('autoQuietStart')?.value || 21), end: Number($('autoQuietEnd')?.value || 8) },
      },
    }));
    /** ⚠️ configVersion を固定値で送らない（更新のたびに増えるので必ず衝突する） */
    const autoExpected = () => String(autoVersion ?? '');
    $('autoActivate')?.addEventListener('click', () => {
      if (!autoSnapshot) {
        const state = $('autoState');
        if (state) state.textContent = '先に 下見 を実行して対象を確定してください。';
        return;
      }
      autoWrite('activate', { expectedVersion: autoExpected(), snapshotFingerprint: autoSnapshot });
    });
    $('autoPause')?.addEventListener('click', () => autoWrite('pause', { expectedVersion: autoExpected() }));
    $('autoCancel')?.addEventListener('click', () => autoWrite('cancel', { expectedVersion: autoExpected() }));


    // ── 見込み客プール ────────────────────────────────────────
    const PR_API = '/.netlify/functions/admin-marketing-prospect';
    async function prCall(payload) {
      const secret = (($('secret') || {}).value || '').trim();
      if (!secret) throw new Error('管理シークレットを入力してください');
      const res = await fetch(PR_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-secret': secret },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      // write ゲートの状態はどの応答でも反映し直す
      if (typeof data.writeEnabled === 'boolean') prApplyGate(data.writeEnabled);
      if (!res.ok) {
        if (data.code === 'prospect_write_blocked') prApplyGate(false);
        const e = new Error(data.error || ('HTTP ' + res.status)); e.data = data; throw e;
      }
      return data;
    }
    function prApplyGate(enabled) {
      for (const id of ['prIntake', 'prPromote', 'prSuppress', 'prPurge']) {
        const b = $(id);
        if (!b) continue;
        b.disabled = !enabled;
        b.setAttribute('aria-disabled', String(!enabled));
      }
    }
    const prSay = (t) => { const el = $('prState'); if (el) el.textContent = t; };
    const prShow = (o) => {
      const box = $('prResult');
      if (!box) return;
      box.hidden = false;
      box.textContent = JSON.stringify(o, null, 1);
    };
    /** CSV を行に割る（ヘッダ email があれば飛ばす） */
    function prParseCsv(text) {
      return String(text || '').split(/\r?\n/)
        .map((l) => l.split(',')[0].trim())
        .filter((e) => e && e.toLowerCase() !== 'email')
        .map((email) => ({ email }));
    }

    $('prStatus')?.addEventListener('click', async () => {
