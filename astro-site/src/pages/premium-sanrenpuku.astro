    /* モバイル対応 */
    @media (max-width: 768px) {
        .order-container {
            padding: 30px 20px;
        }

        .order-title {
            font-size: 2rem;
        }

        .order-subtitle {
            font-size: 1rem;
        }

        .order-features {
            grid-template-columns: 1fr;
        }

        .price-value {
            font-size: 3rem;
        }

        .order-btn {
            font-size: 1.1rem;
            padding: 15px 40px;
        }
    }

    /* ==== レース単位アコーディオン（予想ページ premium-prediction/nankan と同型・衝突回避のためヘッダー配下にスコープ）==== */
    [class*="race-"][class*="r-accordion"] {
        background: rgba(16, 185, 129, 0.05);
        border-radius: 12px;
        border: 1px solid rgba(16, 185, 129, 0.2);
        margin-bottom: 25px;
        overflow: hidden;
    }
    .race-accordion-header {
        padding: 20px 25px;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(16, 185, 129, 0.05) 100%);
        transition: all 0.3s ease;
        border-bottom: 1px solid rgba(16, 185, 129, 0.2);
    }
    .race-accordion-header:hover {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(16, 185, 129, 0.08) 100%);
    }
    .race-accordion-header .race-basic-info {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }
    .race-accordion-header .race-number {
        background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        color: white;
        padding: 8px 15px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 1.1rem;
    }
    .race-accordion-header .race-name {
        color: #e2e8f0;
        font-weight: 600;
        font-size: 1.1rem;
    }
    .race-accordion-header .race-tier-badge {
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 600;
    }
    .race-accordion-header .race-preview .toggle-icon {
        font-size: 1.2rem;
        color: #10b981;
        transition: transform 0.3s ease;
    }
    .race-accordion-content {
        overflow: hidden;
        transition: all 0.3s ease;
        background: rgba(15, 23, 42, 0.95);
    }
</style>

<script is:inline>
    // 会場切替（南関同時開催・nankan premium の selectNankanVenue と同一挙動）
    function selectSanrenpukuVenue(btn) {
        const idx = btn.getAttribute('data-venue-index');
        document.querySelectorAll('.venue-btn').forEach((b) => b.classList.toggle('active', b.getAttribute('data-venue-index') === idx));
        document.querySelectorAll('.venue-content').forEach((c) => c.classList.toggle('active', c.getAttribute('data-venue-index') === idx));
        // 会場切替時に開いているレース選択メニューを閉じる
        document.querySelectorAll('.floating-selector-menu').forEach((m) => { m.style.display = 'none'; });
    }
    window.selectSanrenpukuVenue = selectSanrenpukuVenue;

    // ==== レース単位アコーディオン（予想ページ toggleNankanRace と同型 / srp- プレフィックスでID衝突回避）====
    // 開いているレースアコーディオンの固定 max-height を、内側の開閉に追従して再計算（クリップ防止）
    function _srpRecalcFrom(el) {
        const content = el && el.closest && el.closest('.race-accordion-content');
        if (!content) return;
        const mh = content.style.maxHeight;
        if (mh === '0px' || mh === '') return; // 閉じているレースは触らない
        requestAnimationFrame(() => { content.style.maxHeight = content.scrollHeight + 'px'; });
    }
    window._srpRecalcFrom = _srpRecalcFrom;

    function toggleSanrenpukuRace(venueIndex, raceNumber) {
        const content = document.getElementById(`srp-race-v${venueIndex}-${raceNumber}r`);
        const icon = document.getElementById(`srp-toggle-v${venueIndex}-${raceNumber}r`);
        if (!content || !icon) return;
        // 同じ会場の他アコーディオンを閉じる（1レースのみ展開）
        for (let i = 1; i <= 12; i++) {
            if (i !== raceNumber) {
                const oc = document.getElementById(`srp-race-v${venueIndex}-${i}r`);
                const oi = document.getElementById(`srp-toggle-v${venueIndex}-${i}r`);
                if (oc && oi) { oc.style.maxHeight = '0px'; oc.style.opacity = '0'; oi.textContent = '▼'; oi.style.transform = 'rotate(0deg)'; }
            }
        }
        if (content.style.maxHeight === '0px' || content.style.maxHeight === '') {
            content.style.maxHeight = content.scrollHeight + 'px';
            content.style.opacity = '1';
            icon.textContent = '◎';
            icon.style.transform = 'rotate(180deg)';
        } else {
            content.style.maxHeight = '0px';
            content.style.opacity = '0';
            icon.textContent = '▼';
            icon.style.transform = 'rotate(0deg)';
        }
    }
    window.toggleSanrenpukuRace = toggleSanrenpukuRace;

    // フローティングレース選択から呼ぶ: 必ず開いてスクロール
    function openSanrenpukuRace(venueIndex, raceNumber) {
        const content = document.getElementById(`srp-race-v${venueIndex}-${raceNumber}r`);
        if (!content) return;
        const isClosed = content.style.maxHeight === '0px' || content.style.maxHeight === '';
        if (isClosed) toggleSanrenpukuRace(venueIndex, raceNumber);
        content.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    window.openSanrenpukuRace = openSanrenpukuRace;

    // 内側 details（過去走/近走詳細）の開閉で親レースアコーディオンの max-height を再計算
    function bindSrpNestedDetailsRecalc() {
        document.querySelectorAll('.race-accordion-content details').forEach((d) => {
            if (d.dataset.srpScrollBound === '1') return;
            d.dataset.srpScrollBound = '1';
            d.addEventListener('toggle', () => { _srpRecalcFrom(d); });
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindSrpNestedDetailsRecalc);
    } else {
        bindSrpNestedDetailsRecalc();
    }

    document.addEventListener('DOMContentLoaded', function() {
        // フローティングレースセレクターのトグル（会場ごとに複数存在しうるため class ベース）
        document.querySelectorAll('.floating-selector-toggle').forEach(function(toggle) {
            const menu = toggle.parentElement.querySelector('.floating-selector-menu');
            if (!menu) return;
            toggle.addEventListener('click', function(e) {
                e.stopPropagation();
                menu.style.display = (menu.style.display === 'none' || !menu.style.display) ? 'block' : 'none';
            });
        });

        // メニュー外クリックで全メニューを閉じる
        document.addEventListener('click', function(event) {
            if (!event.target.closest('.floating-race-selector')) {
                document.querySelectorAll('.floating-selector-menu').forEach(function(m) { m.style.display = 'none'; });
            }
        });

        // Premium Sanrenpuku絞り込みボタン（3段階アニメーション）
        const filterBtns = document.querySelectorAll('.premium-select-filter-btn');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const raceIndex = this.getAttribute('data-race-index');
                const content = document.querySelector(`[data-race-content="${raceIndex}"]`);
                const filterText = this.querySelector('.filter-text');

                if (content) {
                    if (content.style.display === 'none') {
                        // 段階1: 絞り込む → 絞り込み中（青・pulse）
                        this.classList.add('filtering');
                        filterText.textContent = 'Premium Sanrenpuku 絞り込み中';

                        // 段階2: 1.6秒後に 絞り込み中 → 絞り込み完了（緑）
                        setTimeout(() => {
                            this.classList.remove('filtering');
                            this.classList.add('filtered');
                            filterText.textContent = 'Premium Sanrenpuku 絞り込み完了';

                            // コンテンツ表示
                            content.style.display = 'block';
                            // 買い目表示ぶん親レースアコーディオンの高さを再計算（クリップ防止）
                            if (window._srpRecalcFrom) window._srpRecalcFrom(content);
                        }, 1600);
                    } else {
                        // コンテンツ非表示 → 初期状態に戻す
                        content.style.display = 'none';
                        this.classList.remove('filtered');
                        filterText.textContent = 'Premium Sanrenpuku 絞り込む';
                        if (window._srpRecalcFrom) window._srpRecalcFrom(content);
                    }
                }
            });
        });
    });
</script>
