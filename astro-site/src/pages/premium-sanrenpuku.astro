    .horse-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
    }

    .horse-mark-main {
        font-size: 1.5rem;
        color: rgb(16, 185, 129);
    }

    .horse-mark-sub {
        font-size: 1.3rem;
        color: rgb(236, 72, 153);
    }

    .horse-mark-hole {
        font-size: 1.2rem;
        color: rgb(251, 191, 36);
    }

    .horse-mark-renka {
        font-size: 1.2rem;
        color: rgb(139, 92, 246);
    }

    .horse-mark-minor {
        font-size: 1.2rem;
        color: rgb(148, 163, 184);
    }

    .horse-number-main {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(5, 150, 105, 0.25) 100%);
        color: rgb(16, 185, 129);
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .horse-number-sub {
        background: linear-gradient(135deg, rgba(236, 72, 153, 0.15) 0%, rgba(219, 39, 119, 0.25) 100%);
