    .minor-title {
        font-size: 0.95rem;
        font-weight: 600;
    }

    .title-hole {
        color: rgb(251, 191, 36);
    }

    .title-renka {
        color: rgb(139, 92, 246);
    }

    .title-minor {
        color: #94a3b8;
    }

    .horse-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 10px;
        margin-top: 10px;
    }

    .horse-grid-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .horse-number-small {
        background: rgba(255, 255, 255, 0.1);
