        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        padding: 10px 24px;
        background: transparent;
        color: #cbd5e1;
        border: none;
        border-radius: 999px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .venue-btn:hover { background: rgba(139, 92, 246, 0.12); color: #e2e8f0; }
    .venue-btn.active {
        background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
        color: white;
        box-shadow: 0 4px 14px rgba(139, 92, 246, 0.45);
    }
    .venue-label { font-size: 1.05rem; font-weight: 800; letter-spacing: 0.02em; }
    .venue-race-count { font-size: 0.78rem; opacity: 0.85; font-weight: 700; }
    @media (max-width: 768px) {
        .venue-selector { max-width: 100%; gap: 4px; padding: 6px; }
