        padding-left: 30px;
    }

    .recommend-list li:last-child {
        border-bottom: none;
    }

    .recommend-list li::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: #10b981;
        font-weight: 700;
        font-size: 1.3rem;
