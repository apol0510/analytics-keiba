    /* 申し込みセクションスタイル */
    .order-section {
        min-height: 100vh;
        padding: 40px 20px;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    }

    .order-container {
        max-width: 900px;
        margin: 0 auto;
        background: rgba(30, 41, 59, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 20px;
        padding: 50px 40px;
