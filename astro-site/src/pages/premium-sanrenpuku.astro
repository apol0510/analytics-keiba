    .upgrade-notice {
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.15) 0%, rgba(245, 158, 11, 0.2) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 16px;
        padding: 30px;
        text-align: center;
        box-shadow:
            inset 0 0 0 0.5px rgba(251, 191, 36, 0.5),
