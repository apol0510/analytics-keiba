---
/**
 * 【2026-07-15】申込セクション (#sanrenpuku-order) と専用の銀行振込モーダル・openBankModal を削除した。
 *
 * 理由（復活させないこと）:
 * - 画面表示は「Premium Sanrenpuku ¥19,820/月」なのに、送信値は openBankModal('Premium Plus', 68000, 'lifetime')
 *   で商品名・金額・PlanType がすべて不整合だった。
 * - bank-transfer-application.js は productName に 'Premium Plus' を含む申込を Airtable 登録スキップ扱いにするため
 *   （`if (!productName.includes('Premium Plus'))`）、RequestedPlan / RequestedPlanType / RequestedAmount が保存されず、
 *   PaymentConfirmed を押しても confirm-bank-payment が昇格できない（fail closed）状態だった。
 * - 三連複商品の正しい銀行振込価格・PlanType がコード上に存在しない（pricing.astro に三連複プランの記載なし）ため、
 *   推測で修正して有効化するのは危険。使われていない壊れた導線として除去する。
 * - 副次効果として、生成 HTML から商品名 'Premium Plus' / 68,000 / 口座情報が消える（存在秘匿にも寄与）。
 *
 * 申込導線を再度作る場合は、正しい商品名・価格・PlanType を確定し、bank-transfer-application の
 * Airtable 登録分岐に載る productName を使うこと。
 */
// ⚠️ SSR。有料本文を組み立てる前にサーバー側で認可を確定させる（2026-08-08）。
//    prerender=true のままだと静的 HTML に有料本文が入り、localStorage の書き換えだけで読めてしまう。
export const prerender = false;
import AcquisitionRaceList from '../components/acquisition/AcquisitionRaceList.astro';
import AcquisitionUsagePanel from '../components/acquisition/AcquisitionUsagePanel.astro';
import SrpRecommendedRaces from '../components/acquisition/SrpRecommendedRaces.astro';
import { buildListModel } from '../lib/acquisition/listModel.js';
import { loadMemberAcquisitions } from '../lib/acquisition/acquisitionServer.js';
import { summarizeUsage } from '../lib/acquisition/usageStats.js';
import { canAcquire } from '../lib/acquisition/acquisitionPolicy.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionKeepAlive from '../components/SessionKeepAlive.astro';
import { gatePaidPage, PAID_PAGE_HEADERS } from '../lib/auth/paidPageGate.js';
import AccessControl from '../components/AccessControl.astro';
import BettingSelectionQA from '../components/BettingSelectionQA.astro';
import RaceHorseSection from '../components/RaceHorseSection.astro';
import AccordionClickClose from '../components/AccordionClickClose.astro';
import RaceAccordionClickClose from '../components/RaceAccordionClickClose.astro';
// 【一時非表示 2026-07-15】Premium Plus CTA は存在秘匿が完成するまで出さない（下部の設置箇所を参照）
// import PremiumPlusCta from '../components/PremiumPlusCta.astro';
// 段階公開 PHASE 2 の予告枠（文言は SSR エンドポイントから取得。静的 HTML には出さない）
import PremiumPlusStageTeaser from '../components/PremiumPlusStageTeaser.astro';
import { processRaceData, generateSanrenpukuBets, getHorseConfidenceFromMark, normalizeHorseData } from '../lib/shared-prediction-logic.js';
import { pickLatestNankanVenuesAndAdapt } from '../lib/adaptLatestPrediction.js';

// ── サーバー側認可（この行より前で有料データを組み立てない）──
// 判定は既存の単一源に委譲: ak_session（本人特定）+ resolveEntitlements（権利）。
// 未認可ならここで応答を返すので、有料本文は HTML に一切含まれない。
const gate = await gatePaidPage({
  request: Astro.request,
  requiredPlan: 'Premium Sanrenpuku',
  env: process.env, // 認可ライブラリは env を直接参照しない方針のため、ページ側で注入する
});
if (gate.response) return gate.response;
for (const [k, v] of Object.entries(PAID_PAGE_HEADERS)) Astro.response.headers.set(k, v);

// ── 三連複で狙うレースの選別（推奨度・見送り・理由）と取得状態。買い目は一覧に渡さない ──
const acqList = await loadMemberAcquisitions({ recordId: gate.subject, env: process.env });
const srpModel = buildListModel({ cat: 'nankan', product: 'srp', requestedDate: Astro.url.searchParams.get('date'), acquisitions: acqList || [] });
const acqUsage = acqList ? summarizeUsage(acqList) : null;
const srpCan = canAcquire(gate.entitlements, { product: 'srp', cat: 'nankan' });

// src/data/predictions/*.json から最新日付の全会場を取得（南関同時開催対応）
const predictionModules = import.meta.glob('/src/data/predictions/*.json', { eager: true });
const multiVenueData = pickLatestNankanVenuesAndAdapt(predictionModules);
if (!multiVenueData || multiVenueData.venues.length === 0) {
    throw new Error('予想データが見つかりません。src/data/predictions/ を確認してください。');
}

// 会場ごとに三連複買い目を生成（generateSanrenpukuBets は会場非依存・各レースへ適用）
const venuesProcessed = multiVenueData.venues.map((venueRaw) => {
    const { sortedRaces } = processRaceData(venueRaw);
    const sanrenpukuRaces = sortedRaces.map(raceData => ({
        ...raceData,
        sanrenpuku: generateSanrenpukuBets(raceData.horses)
    }));
    return {
        venueSlug: venueRaw.venueSlug,
        track: venueRaw.track,
        raceDate: venueRaw.raceDate,
        totalRaces: venueRaw.totalRaces || (venueRaw.races ? venueRaw.races.length : sanrenpukuRaces.length),
        sanrenpukuRaces,
    };
});

const isMultiVenue = venuesProcessed.length > 1;
const firstVenue = venuesProcessed[0];

// タイトル・SEO 用に最初の会場を代表採用
const raceDate = firstVenue.raceDate;
const track = firstVenue.track;
const totalRaces = firstVenue.totalRaces;

// 日付を日本語形式に変換
const [year, month, day] = raceDate.split('-');
const formattedDate = `${year}年${parseInt(month)}月${parseInt(day)}日`;
---

<BaseLayout
    title={`プレミアム三連複予想 | ${track} ${formattedDate}`}
    description={`南関競馬で、今日、三連複で狙うべきレースを AI が選別。推奨度・見送り判定・選別理由と、推奨レースの予想を取得できます。`}
>
  {/* ak_session の idle TTL 延長（会員確定ページのみ）*/}
  <SessionKeepAlive />
    <AccessControl requiredPlan="Premium Sanrenpuku">

        <!-- 三連複予想コンテンツ（Premium Sanrenpuku / Premium Full会員向け） -->
        <div id="sanrenpuku-content" class="page-container">
            <!-- ヘッダーセクション -->
            <div class="header-section">
                <div class="ai-badge premium-select-badge">
                    <span class="pulse"></span>
                    <span class="ai-status">✨ Premium Sanrenpuku</span>
                </div>
                <h1 class="race-title">南関 三連複で狙うべきレースを AI が選別</h1>
            </div>

            {/* 2026-10-03 MK 確定: Premium Sanrenpuku は「三連複で参加すべきレースを AI が選別する」商品。
                 一覧では推奨度・見送り・理由だけを出し、買い目（通常・中心）は取得後の本文ページで出す。
                 旧「絞り込む」ボタン（買い目削減の演出）は廃止。docs/PREDICTION_ACQUISITION.md */}
            <div class="acq-layout">
                <div class="acq-main">
                    <SrpRecommendedRaces day={srpModel.day} canAcquire={srpCan} />
                    <h2 class="acq-heading">全レースの判定</h2>
                    <AcquisitionRaceList product="srp" basePath="/premium-sanrenpuku/" date={srpModel.date} dates={srpModel.dates} venues={srpModel.venues} canAcquire={srpCan} acquiredUnknown={acqList === null} />
                </div>
                <AcquisitionUsagePanel usage={acqUsage} />
            </div>

            {/* 【一時非表示 2026-07-15】Premium Plus CTA
                このページは prerender=true + クライアント側 AccessControl のため、CTA を置くと
                商品名・キャッチコピー・/premium-plus/ へのリンクが未ログイン者の HTML にも載る。
                存在秘匿（サーバー側認可）が完成するまで出さない。
                コンポーネント（src/components/PremiumPlusCta.astro）は削除せず保持する。
                <PremiumPlusCta /> */}

            {/* 段階公開 PHASE 2 の予告枠。静的 HTML には文言もリンクも出さず、
                SSR の /api/premium-plus-stage.json（三連複会員のみ 200）から取得して描画する。
                非会員 / PHASE 1 は 404 で何も描画されない。 */}
            <PremiumPlusStageTeaser />
        </div>

        {/* 予想ページと同じアコーディオン挙動（過去走 details の開閉／レース折りたたみ） */}
        <AccordionClickClose />
        <RaceAccordionClickClose />

        {/* 2026-09-02: クライアント側のプラン判定スクリプトを削除した（復活させないこと）。

            事故: 三連複を買い切りで購入した会員（`プラン=Premium` + `LifetimeSanrenpuku=true`）が
            このページを開くと、localStorage の `plan` が 'Premium' のため
            「未購入の Premium 会員」と誤判定され、無料体験ページへリダイレクトされていた。
            購入済みの方に無料体験を見せる状態で、中央（JRA）側は同じスクリプトを持たないため
            正常に表示されていた（＝南関だけが壊れていた）。

            このページの認可は 2 層で確定している:
              1. サーバー: frontmatter の gatePaidPage（ak_session + resolveEntitlements）
                 → 権利が無ければ有料本文を 1 バイトも返さない
              2. クライアント: AccessControl requiredPlan="Premium Sanrenpuku"
                 → lifetimeSanrenpuku を見る単一源
            localStorage の `plan` 文字列だけを見る 3 つ目の判定を足さない。
            構造は中央版 premium-sanrenpuku-jra.astro と同じに保つ。 */}
    </AccessControl>
</BaseLayout>


<style is:global>
