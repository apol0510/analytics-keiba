        .venue-label { font-size: 0.95rem; }
    }
    .venue-content { display: none; }
    .venue-content.active { display: block; }
    .venue-header-inline {
        text-align: center;
        margin: 0 0 24px;
        padding: 16px;
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(167, 139, 250, 0.15) 100%);
        border-radius: 12px;
        border: 2px solid rgba(139, 92, 246, 0.3);
    }
    .venue-header-inline .venue-title { margin: 0; font-size: 1.4rem; font-weight: 800; color: #e9d5ff; }
    .venue-header-inline .venue-subtitle { margin: 4px 0 0; font-size: 0.9rem; color: #cbd5e1; }

