    .order-header {
        text-align: center;
        margin-bottom: 50px;
    }

    .order-icon {
        font-size: 4rem;
        margin-bottom: 20px;
    }

    .order-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #f1f5f9;
        margin-bottom: 15px;
        background: linear-gradient(to right, #3b82f6, #8b5cf6);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
