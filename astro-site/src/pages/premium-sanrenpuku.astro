---
/**
 * 【2026-07-15】申込セクション (#sanrenpuku-order) と専用の銀行振込モーダル・openBankModal を削除した。
 *
 * 理由（復活させないこと）:
 * - 画面表示は「Premium Sanrenpuku ¥19,820/月」なのに、送信値は openBankModal('Premium Plus', 68000, 'lifetime')
 *   で商品名・金額・PlanType がすべて不整合だった。
 * - bank-transfer-application.js は productName に 'Premium Plus' を含む申込を Airtable 登録スキップ扱いにするため
 *   （`if (!productName.includes('Premium Plus'))`）、RequestedPlan / RequestedPlanType / RequestedAmount が保存されず、
 *   PaymentConfirmed を押しても confirm-bank-payment が昇格できない（fail closed）状態だった。
 * - 三連複商品の正しい銀行振込価格・PlanType がコード上に存在しない（pricing.astro に三連複プランの記載なし）ため、
 *   推測で修正して有効化するのは危険。使われていない壊れた導線として除去する。
 * - 副次効果として、生成 HTML から商品名 'Premium Plus' / 68,000 / 口座情報が消える（存在秘匿にも寄与）。
 *
 * 申込導線を再度作る場合は、正しい商品名・価格・PlanType を確定し、bank-transfer-application の
 * Airtable 登録分岐に載る productName を使うこと。
 */
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import AccessControl from '../components/AccessControl.astro';
import BettingSelectionQA from '../components/BettingSelectionQA.astro';
import RaceHorseSection from '../components/RaceHorseSection.astro';
import AccordionClickClose from '../components/AccordionClickClose.astro';
import RaceAccordionClickClose from '../components/RaceAccordionClickClose.astro';
// 【一時非表示 2026-07-15】Premium Plus CTA は存在秘匿が完成するまで出さない（下部の設置箇所を参照）
// import PremiumPlusCta from '../components/PremiumPlusCta.astro';
// 段階公開 PHASE 2 の予告枠（文言は SSR エンドポイントから取得。静的 HTML には出さない）
import PremiumPlusStageTeaser from '../components/PremiumPlusStageTeaser.astro';
import { processRaceData, generateSanrenpukuBets, getHorseConfidenceFromMark, normalizeHorseData } from '../lib/shared-prediction-logic.js';
import { pickLatestNankanVenuesAndAdapt } from '../lib/adaptLatestPrediction.js';

// src/data/predictions/*.json から最新日付の全会場を取得（南関同時開催対応）
const predictionModules = import.meta.glob('/src/data/predictions/*.json', { eager: true });
const multiVenueData = pickLatestNankanVenuesAndAdapt(predictionModules);
if (!multiVenueData || multiVenueData.venues.length === 0) {
    throw new Error('予想データが見つかりません。src/data/predictions/ を確認してください。');
}

// 会場ごとに三連複買い目を生成（generateSanrenpukuBets は会場非依存・各レースへ適用）
const venuesProcessed = multiVenueData.venues.map((venueRaw) => {
    const { sortedRaces } = processRaceData(venueRaw);
    const sanrenpukuRaces = sortedRaces.map(raceData => ({
        ...raceData,
        sanrenpuku: generateSanrenpukuBets(raceData.horses)
    }));
    return {
        venueSlug: venueRaw.venueSlug,
        track: venueRaw.track,
        raceDate: venueRaw.raceDate,
        totalRaces: venueRaw.totalRaces || (venueRaw.races ? venueRaw.races.length : sanrenpukuRaces.length),
        sanrenpukuRaces,
    };
});

const isMultiVenue = venuesProcessed.length > 1;
const firstVenue = venuesProcessed[0];

// タイトル・SEO 用に最初の会場を代表採用
const raceDate = firstVenue.raceDate;
const track = firstVenue.track;
const totalRaces = firstVenue.totalRaces;

// 日付を日本語形式に変換
const [year, month, day] = raceDate.split('-');
const formattedDate = `${year}年${parseInt(month)}月${parseInt(day)}日`;
---

<BaseLayout
    title={`プレミアム三連複予想 | ${track} ${formattedDate}`}
    description={`AI技術による${track}競馬の超厳選三連複予想。累積スコアに基づく少点数買い目で最適な組み合わせのみを提供。`}
>
    <AccessControl requiredPlan="Premium Sanrenpuku">

        <!-- 三連複予想コンテンツ（Premium Sanrenpuku / Premium Full会員向け） -->
        <div id="sanrenpuku-content" class="page-container" style="display: none;">
            <!-- ヘッダーセクション -->
            <div class="header-section">
                <div class="ai-badge premium-select-badge">
                    <span class="pulse"></span>
                    <span class="ai-status">✨ Premium Sanrenpuku</span>
                </div>
                <h1 class="race-title">{formattedDate} {track} - Premium 三連複厳選予想</h1>
            </div>

            <!-- 会場タブ（南関同時開催の場合のみ表示・nankan premium と同一パターン） -->
            {isMultiVenue && (
                <div class="venue-selector">
                    {venuesProcessed.map((v, i) => (
                        <button
                            class={`venue-btn ${i === 0 ? 'active' : ''}`}
                            data-venue-index={i}
                            type="button"
                            onclick="selectSanrenpukuVenue(this)"
                        >
                            <span class="venue-label">{v.track}</span>
                            <span class="venue-race-count">{v.sanrenpukuRaces.length}R</span>
                        </button>
                    ))}
                </div>
            )}

            {venuesProcessed.map((venue, venueIndex) => (
            <div class={`venue-content ${venueIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex}>
                {isMultiVenue && (
                    <div class="venue-header-inline">
                        <h2 class="venue-title">{venue.track}</h2>
                        <p class="venue-subtitle">{venue.totalRaces}レース - Premium 三連複厳選予想</p>
                    </div>
                )}

            <!-- フローティングレースセレクター（右下固定・会場ごと） -->
            <div class="floating-race-selector">
                <button class="floating-selector-toggle" type="button">
                    <span class="toggle-icon">🏇</span>
                    <span class="toggle-text">レース選択</span>
                </button>
                <div class="floating-selector-menu" style="display: none;">
                    <div class="selector-header">📍 レースを選択</div>
                    <div class="selector-grid">
                        {venue.sanrenpukuRaces.map((raceData) => (
                            <button
                                class="selector-race-btn"
                                data-race-number={raceData.raceNumber}
                                onclick={`openSanrenpukuRace(${venueIndex}, ${String(raceData.raceNumber).replace('R','')}); this.closest('.floating-selector-menu').style.display = 'none';`}
                            >
                                {raceData.raceNumber}
                            </button>
                        ))}
                    </div>
                </div>
            </div>

            <!-- 全レース予想 -->
            <div class="races-container">
                {venue.sanrenpukuRaces.map((raceData, index) => {
                    const sanrenpuku = raceData.sanrenpuku;
                    const horses = raceData.horses;
                    const strategies = raceData.strategies;
                    // 予想ページ(premium-prediction/nankan)と同一の馬表示へ寄せる。
                    // role 付き配列に正規化して共有部品 RaceHorseSection に渡す（AI総合指数＋過去走が基準どおり出る）。
                    const raceHorses = normalizeHorseData(raceData) || [];
                    // 予想ページと同じ「レース単位アコーディオン」用の値
                    const raceNum = String(raceData.raceNumber).replace('R', '');
                    const cleanRaceName = (raceData.raceName || '競走名')
                        .replace(/\s*[ダ芝]\d+[,.]?\d*m.*$/, '')
                        .replace(/\s*（\d+頭）.*$/, '')
                        .replace(/\s*発走時刻.*$/, '');

                    return (
                        <div class={`race-${raceNum}r-accordion`}>
                            <!-- レース単位アコーディオン ヘッダー（予想ページ premium-prediction/nankan と同型） -->
                            <div class="race-accordion-header" onclick={`toggleSanrenpukuRace(${venueIndex}, ${raceNum})`}>
                                <div class="race-basic-info">
                                    <span class="race-number">{raceData.raceNumber}</span>
                                    <span class="race-name">{cleanRaceName}</span>
                                    <span class="race-tier-badge">{`第${raceNum}レース`}</span>
                                </div>
                                <div class="race-preview">
                                    <span class="toggle-icon" id={`srp-toggle-v${venueIndex}-${raceNum}r`}>▼</span>
                                </div>
                            </div>

                            <!-- アコーディオン中身（初期は畳む。max-height はトグルJSで制御） -->
                            <div class="race-accordion-content" id={`srp-race-v${venueIndex}-${raceNum}r`} style="max-height: 0; opacity: 0;">

                            <!-- AI選出馬分析（最初に配置）— 予想ページと同一の共有部品で描画 -->
                            <div class="analysis-section">
                                <h4 class="section-title">🤖 AIモデル選出馬 - 詳細分析</h4>

                                {/* 本命/対抗/単穴の rich カード + 連下/抑えミニカード + AI総合指数 + 過去走を
                                    予想ページ(premium-prediction/nankan)と完全同型で描画する共有部品 */}
                                <RaceHorseSection raceHorses={raceHorses} />
                            </div>

                            <!-- Premium Sanrenpuku絞り込みボタン -->
                            <button class="premium-select-filter-btn" data-race-index={`v${venueIndex}-${index}`}>
                                <span class="filter-icon">🎯</span>
                                <span class="filter-text">Premium Sanrenpuku 絞り込む</span>
                                <span class="filter-arrow">▼</span>
                            </button>

                            <!-- Premium Sanrenpuku厳選買い目（初期非表示・絞り込み後表示） -->
                            <div class="premium-select-highlight" data-race-content={`v${venueIndex}-${index}`} style="display: none;">
                                <div class="select-header">
                                    <div class="select-badge">✨ Premium Sanrenpuku 厳選買い目</div>
                                </div>

                                <div class="select-bets-list">
                                    {sanrenpuku.narrowed && sanrenpuku.narrowed.map((bet, i) => {
                                        // 各買い目の点数を計算（カンマで区切られた馬番号の数）
                                        const parts = bet.split('-');
                                        const thirdHorses = parts[2] ? parts[2].split(',') : [];
                                        const points = thirdHorses.length;

                                        return (
                                            <div class="select-bet-item">
                                                <span class="bet-number">{i + 1}</span>
                                                <span class="bet-display">三連複 {bet}</span>
                                                <span class="bet-score">{points}点</span>
                                            </div>
                                        );
                                    })}
                                </div>

                                <div class="total-points-display">
                                    💰 合計: {sanrenpuku.total || 0}点
                                </div>

                                <!-- 枠外コンパクト表示 -->
                                {sanrenpuku.compact && (
                                    <div class="compact-display-section">
                                        <h5 class="compact-title">📋 全買い目詳細</h5>

                                        <!-- 1段目：本命ブロック -->
                                        {sanrenpuku.compact.main && (
                                            <div class="compact-block">
                                                <div class="compact-horse-number">{sanrenpuku.compact.main.number}</div>
                                                <div class="compact-content">
                                                    <div class="compact-axis">{sanrenpuku.compact.main.axis}</div>
                                                    <div class="compact-targets">
                                                        {sanrenpuku.compact.main.targets}
                                                        {sanrenpuku.compact.main.osaeNumbers && sanrenpuku.compact.main.osaeNumbers.length > 0 && (
                                                            <span class="osae-note">({sanrenpuku.compact.main.osaeNumbers.join('.')}は抑え)</span>
                                                        )}
                                                    </div>
                                                </div>
                                            </div>
                                        )}

                                        <!-- 2段目：対抗ブロック -->
                                        {sanrenpuku.compact.sub && (
                                            <div class="compact-block">
                                                <div class="compact-horse-number">{sanrenpuku.compact.sub.number}</div>
                                                <div class="compact-content">
                                                    <div class="compact-axis">{sanrenpuku.compact.sub.axis}</div>
                                                    <div class="compact-targets">
                                                        {sanrenpuku.compact.sub.targets}
                                                        {sanrenpuku.compact.sub.osaeNumbers && sanrenpuku.compact.sub.osaeNumbers.length > 0 && (
                                                            <span class="osae-note">({sanrenpuku.compact.sub.osaeNumbers.join('.')}は抑え)</span>
                                                        )}
                                                    </div>
                                                </div>
                                            </div>
                                        )}
                                    </div>
                                )}
                            </div>

                            </div>
                        </div>
                    );
                })}
            </div>
            </div>
            ))}

            {/* 【一時非表示 2026-07-15】Premium Plus CTA
                このページは prerender=true + クライアント側 AccessControl のため、CTA を置くと
                商品名・キャッチコピー・/premium-plus/ へのリンクが未ログイン者の HTML にも載る。
                存在秘匿（サーバー側認可）が完成するまで出さない。
                コンポーネント（src/components/PremiumPlusCta.astro）は削除せず保持する。
                <PremiumPlusCta /> */}

            {/* 段階公開 PHASE 2 の予告枠。静的 HTML には文言もリンクも出さず、
                SSR の /api/premium-plus-stage.json（三連複会員のみ 200）から取得して描画する。
                非会員 / PHASE 1 は 404 で何も描画されない。 */}
            <PremiumPlusStageTeaser />
        </div>

        {/* 予想ページと同じアコーディオン挙動（過去走 details の開閉／レース折りたたみ） */}
        <AccordionClickClose />
        <RaceAccordionClickClose />

        <!-- プラン判定スクリプト -->
        <script is:inline>
            (function() {
                console.log('🔍 Premium Sanrenpuku - プラン判定開始');

                // プラン情報取得
                function getCurrentUserPlan() {
                    // 3. user-plan
                    const userPlanData = localStorage.getItem('user-plan');
                    if (userPlanData) {
                        try {
                            const userData = JSON.parse(userPlanData);
                            return userData.plan || 'free';
                        } catch (error) {
                            console.error('User plan parsing error:', error);
                        }
                    }

                    return null;
                }

                // プラン判定と表示切り替え
                function checkPlanAndDisplay() {
                    const userPlan = getCurrentUserPlan();
                    console.log('📋 現在のプラン:', userPlan);

                    const contentSection = document.getElementById('sanrenpuku-content');

                    if (!contentSection) {
                        console.error('❌ セクション要素が見つかりません');
                        return;
                    }

                    // Premium Sanrenpuku または Premium Combo または Premium Full 会員の場合 → 予想表示
                    if (userPlan === 'Premium Sanrenpuku' || userPlan === 'Premium Combo' || userPlan === 'Premium Full') {
                        console.log('✅ Premium Sanrenpuku/Combo/Full会員 → 三連複予想表示');
                        contentSection.style.display = 'block';
                    }
                    // Premium Predictions または Premium 会員の場合 → sanrenpuku-demoへリダイレクト
                    else if (userPlan === 'Premium Predictions' || userPlan === 'Premium' || userPlan === 'premium') {
                        console.log('🎯 Premium会員 → sanrenpuku-demoへリダイレクト');
                        window.location.href = '/sanrenpuku-demo/';
                    }
                    // その他（プラン不明）→ 何も表示しない（判定は AccessControl に委ねる）
                    // ※ この分岐の経緯は frontmatter のコメント参照。is:inline のコメントは HTML に出力されるため、
                    //    商品名・金額を含む説明をここに書かないこと。
                    else {
                        console.log('❌ プラン不明 → 予想は表示しない');
                        contentSection.style.display = 'none';
                    }
                }

                // DOM読み込み完了後に実行
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', checkPlanAndDisplay);
                } else {
                    checkPlanAndDisplay();
                }
            })();
        </script>
    </AccessControl>
</BaseLayout>


<style is:global>
    .page-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    /* 会場切り替え（南関同時開催対応・premium-prediction/nankan.astro と同一パターン） */
    .venue-selector {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin: 0 auto 28px;
        padding: 8px;
        background: rgba(15, 23, 42, 0.5);
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, 0.2);
        flex-wrap: wrap;
        max-width: max-content;
        backdrop-filter: blur(8px);
    }
    .venue-btn {
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        padding: 10px 24px;
        background: transparent;
        color: #cbd5e1;
        border: none;
        border-radius: 999px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .venue-btn:hover { background: rgba(139, 92, 246, 0.12); color: #e2e8f0; }
    .venue-btn.active {
        background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
        color: white;
        box-shadow: 0 4px 14px rgba(139, 92, 246, 0.45);
    }
    .venue-label { font-size: 1.05rem; font-weight: 800; letter-spacing: 0.02em; }
    .venue-race-count { font-size: 0.78rem; opacity: 0.85; font-weight: 700; }
    @media (max-width: 768px) {
        .venue-selector { max-width: 100%; gap: 4px; padding: 6px; }
        .venue-btn { padding: 8px 16px; }
        .venue-label { font-size: 0.95rem; }
    }
    .venue-content { display: none; }
    .venue-content.active { display: block; }
    .venue-header-inline {
        text-align: center;
        margin: 0 0 24px;
        padding: 16px;
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(167, 139, 250, 0.15) 100%);
        border-radius: 12px;
        border: 2px solid rgba(139, 92, 246, 0.3);
    }
    .venue-header-inline .venue-title { margin: 0; font-size: 1.4rem; font-weight: 800; color: #e9d5ff; }
    .venue-header-inline .venue-subtitle { margin: 4px 0 0; font-size: 0.9rem; color: #cbd5e1; }

    /* 背景パターン強化（ガラスモーフィズム効果を可視化） */
    body {
        background:
            linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, transparent 50%),
            linear-gradient(45deg, rgba(251, 191, 36, 0.05) 0%, transparent 50%),
            linear-gradient(225deg, rgba(16, 185, 129, 0.05) 0%, transparent 50%),
            radial-gradient(circle at 20% 50%, rgba(139, 92, 246, 0.1) 0%, transparent 50%),
            radial-gradient(circle at 80% 50%, rgba(239, 68, 68, 0.1) 0%, transparent 50%),
            #0f172a;
        background-attachment: fixed;
    }

    /* ヘッダーセクション */
    .header-section {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border-radius: 16px;
        padding: 40px;
        margin-bottom: 30px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .premium-select-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.15) 0%, rgba(245, 158, 11, 0.25) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: rgb(251, 191, 36);
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 400;
        margin-bottom: 20px;
        box-shadow:
            inset 0 0 0 0.5px rgba(251, 191, 36, 0.5),
            0 2px 8px rgba(251, 191, 36, 0.15);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .race-title {
        font-size: 2rem;
        margin-bottom: 20px;
        color: #fff;
    }

    .premium-select-description {
        background: rgba(251, 191, 36, 0.1);
        border-left: 4px solid #fbbf24;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
    }

    .select-intro {
        color: #e2e8f0;
        font-size: 1.1rem;
        line-height: 1.8;
    }

    .ai-metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .metric {
        text-align: center;
    }

    .metric-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: #fbbf24;
        margin-bottom: 8px;
    }

    .metric-label {
        font-size: 0.9rem;
        color: #94a3b8;
    }

    /* 特徴説明セクション */
    .feature-explanation {
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.15) 0%, rgba(15, 23, 42, 0.2) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 16px;
        padding: 30px;
        margin-bottom: 30px;
        box-shadow:
            inset 0 0 0 0.5px rgba(251, 191, 36, 0.5),
            0 4px 16px rgba(0, 0, 0, 0.1);
    }

    .feature-title {
        font-size: 1.5rem;
        margin-bottom: 20px;
        color: #fbbf24;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .feature-card {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.15) 0%, rgba(30, 41, 59, 0.2) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 12px;
        padding: 20px;
        box-shadow:
            inset 0 0 0 0.5px rgba(251, 191, 36, 0.4),
            0 2px 12px rgba(0, 0, 0, 0.1);
    }

    .feature-icon {
        font-size: 2rem;
        display: block;
        margin-bottom: 15px;
    }

    .feature-card h4 {
        font-size: 1.1rem;
        margin-bottom: 10px;
        color: #fbbf24;
    }

    .feature-card p {
        color: #cbd5e1;
        font-size: 0.9rem;
        line-height: 1.6;
    }

    /* フローティングレースセレクター */
    .floating-race-selector {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 1000;
    }

    .floating-selector-toggle {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: #000;
        border: none;
        border-radius: 50px;
        padding: 15px 25px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 4px 20px rgba(251, 191, 36, 0.4);
        transition: all 0.3s ease;
    }

    .floating-selector-toggle:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 25px rgba(245, 158, 11, 0.5);
    }

    .toggle-icon {
        font-size: 1.3rem;
    }

    .floating-selector-menu {
        position: absolute;
        bottom: 70px;
        right: 0;
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.95) 0%, rgba(15, 23, 42, 0.98) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 16px;
        padding: 20px;
        min-width: 250px;
        box-shadow:
            inset 0 0 0 0.5px rgba(96, 165, 250, 0.4),
            0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .selector-header {
        color: #60a5fa;
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 15px;
        text-align: center;
    }

    .selector-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .selector-race-btn {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(37, 99, 235, 0.25) 100%);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: rgb(96, 165, 250);
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow:
            inset 0 0 0 0.5px rgba(96, 165, 250, 0.4),
            0 2px 8px rgba(96, 165, 250, 0.15);
        transition: all 0.2s ease;
    }

    .selector-race-btn:hover {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.25) 0%, rgba(37, 99, 235, 0.35) 100%);
        transform: scale(1.05);
        box-shadow:
            inset 0 0 0 0.5px rgba(96, 165, 250, 0.6),
            0 4px 12px rgba(96, 165, 250, 0.3);
    }

    /* レースカード */
    .races-container {
        display: flex;
        flex-direction: column;
        /* レース間隔はアコーディオンwrapperの margin-bottom:25px に一本化（基準 premium-prediction/nankan と同一）。
           旧 .race-card レイアウト由来の gap:25px を残すと wrapper margin と二重(50px)になり閉状態の余白が過大になる。 */
        gap: 0;
    }

    .race-card {
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.15) 0%, rgba(15, 23, 42, 0.2) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 16px;
        padding: 30px;
        box-shadow:
            inset 0 0 0 0.5px rgba(59, 130, 246, 0.4),
            0 4px 16px rgba(0, 0, 0, 0.1);
    }

    .race-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
    }

    .race-number {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(37, 99, 235, 0.25) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        color: rgb(96, 165, 250);
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 400;
        font-size: 1.2rem;
        box-shadow:
            inset 0 0 0 0.5px rgba(96, 165, 250, 0.5),
            0 2px 8px rgba(96, 165, 250, 0.15);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .race-name {
        color: #e2e8f0;
        font-size: 1.1rem;
    }

    /* AI選出馬分析セクション */
    .analysis-section {
        margin-bottom: 25px;
    }

    .section-title {
        color: #fbbf24;
        font-size: 1.1rem;
        margin-bottom: 15px;
        font-weight: 600;
    }

    /* 馬カード */
    .horse-card {
        background: linear-gradient(135deg, rgba(96, 165, 250, 0.15) 0%, rgba(59, 130, 246, 0.2) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 15px;
        box-shadow:
            inset 0 0 0 0.5px rgba(96, 165, 250, 0.4),
