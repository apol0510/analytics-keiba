---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout
  title="ログイン | KEIBA Analytics"
  description="KEIBA Analyticsへのログイン。メールアドレス宛に届くリンクをクリックしてログインします。"
>
  <section class="login-section">
    <div class="container">
      <div class="login-card">
        <div class="login-header">
          <h1>ログイン</h1>
          <p>登録済みのメールアドレスを入力してください。<br>無料会員はそのままログイン、有料会員にはログイン用リンクをメールでお送りします。</p>
        </div>

        <form id="loginForm" class="login-form">
          <div class="form-group">
            <label for="email">メールアドレス</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="your@email.com"
              required
              autocomplete="email"
            />
          </div>

          <button type="submit" class="btn-primary" id="submitBtn">
            <span class="btn-text">ログインリンクを送信</span>
            <span class="btn-loading" style="display: none;"><span class="inline-spinner" aria-hidden="true"></span>送信中...</span>
          </button>

          <div id="message" class="message" style="display: none;"></div>
        </form>

        <div class="login-footer">
          <p>アカウントをお持ちでない方は、<a href="/pricing/">料金プラン</a>からご登録ください。</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .login-section {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    padding: 80px 0;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .login-card {
    max-width: 480px;
    margin: 0 auto;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 16px;
    padding: 48px;
    backdrop-filter: blur(10px);
  }

  .login-header {
    text-align: center;
    margin-bottom: 40px;

    h1 {
      font-size: 32px;
      font-weight: 700;
      background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 16px;
    }

    p {
      color: #94a3b8;
      font-size: 16px;
      line-height: 1.6;
    }
  }

  .login-form {
    .form-group {
      margin-bottom: 24px;

      label {
        display: block;
        margin-bottom: 8px;
        color: #e2e8f0;
        font-weight: 600;
        font-size: 14px;
      }

      input {
        width: 100%;
        padding: 14px 16px;
        background: rgba(30, 41, 59, 0.8);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 8px;
        color: #f1f5f9;
        font-size: 16px;
        transition: all 0.3s ease;

        &:focus {
          outline: none;
          border-color: #3b82f6;
          box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
        &::placeholder { color: #64748b; }
      }
    }

    .btn-primary {
      width: 100%;
      padding: 16px;
      background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
      color: white;
      font-size: 16px;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;

      &:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 8px 16px rgba(59, 130, 246, 0.3);
      }
      &:disabled { opacity: 0.6; cursor: not-allowed; }
      &.loading {
        .btn-text { display: none; }
        .btn-loading { display: inline-flex; align-items: center; gap: 0; }
      }
    }
  }

  .inline-spinner {
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-right: 8px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #ffffff;
    border-radius: 50%;
    vertical-align: -2px;
    animation: inline-spin 0.7s linear infinite;
  }
  @keyframes inline-spin { to { transform: rotate(360deg); } }

  .message {
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.5;

    &.success {
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #6ee7b7;
    }
    &.error {
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
    }
  }

  .login-footer {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(59, 130, 246, 0.1);
    text-align: center;

    p {
      color: #94a3b8;
      font-size: 14px;
    }
    a { color: #3b82f6; text-decoration: none; &:hover { text-decoration: underline; } }
  }

  @media (max-width: 600px) {
    .login-card { padding: 32px 24px; }
    .login-header h1 { font-size: 26px; }
  }
</style>

<script>
  const form = document.getElementById('loginForm') as HTMLFormElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const messageDiv = document.getElementById('message') as HTMLDivElement;

  function showMessage(text: string, type: 'success' | 'error') {
    messageDiv.textContent = text;
    messageDiv.className = `message ${type}`;
    messageDiv.style.display = 'block';
  }

  // PR-B: まず auth-user で無料/有料/拒否を判定。
  //  - 無料会員: そのまま無料状態でログイン（マジックリンク不要）
  //  - 有料会員: send-magic-link を呼び「メールのリンクを開いてください」
  //  - 未登録: /free-signup/ へ誘導
  //  - 判定不能/拒否: 即時ログインさせない
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    if (!email) { showMessage('メールアドレスを入力してください。', 'error'); return; }

    submitBtn.disabled = true;
    submitBtn.classList.add('loading');
    messageDiv.style.display = 'none';

    try {
      const authRes = await fetch('/.netlify/functions/auth-user', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await authRes.json().catch(() => ({}));

      // 未登録 → 新規無料登録へ
      if (authRes.status === 401 && data.redirectTo) {
        showMessage('このメールアドレスは未登録です。新規登録ページへ移動します。', 'error');
        setTimeout(() => { window.location.href = data.redirectTo; }, 2500);
        return;
      }
      // 拒否（退会/停止/期限切れ/判定不能）
      if (authRes.status === 403 || data.denied) {
        showMessage(data.message || 'このアカウントではログインできません。サポートにお問い合わせください。', 'error');
        return;
      }
      // 有料会員 → マジックリンク送信。送信失敗（HTTP 5xx / 通信断 / SendGrid 失敗）は
      // 成功表示せず、必ずエラーを出す（「送信しました」の誤表示を防ぐ）。
      if (data.requiresMagicLink) {
        let sendRes: Response;
        try {
          sendRes = await fetch('/.netlify/functions/send-magic-link', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
        } catch (sendErr) {
          console.error('send-magic-link error:', sendErr);
          showMessage('ログインリンクの送信中に通信エラーが発生しました。時間をおいて再度お試しください。', 'error');
          return;
        }
        if (!sendRes.ok) {
          showMessage('ログインリンクの送信に失敗しました。時間をおいて再度お試しください。', 'error');
          return;
        }
        emailInput.value = '';
        // ⚠️ これは成功メッセージ。エラーに読める文言にしない（2026-07-22 の問い合わせ事例）。
        //    件名 / 有効時間 / 最新の1通 / 迷惑メール まで書かないと、古いリンクを開いて詰まる。
        showMessage('✉️ ログインリンクを送信しました。件名「【KEIBA Analytics】ログインリンク」のメールを 15分以内 にお開きください。必ず最新の1通をご利用ください（届かない場合は迷惑メールフォルダもご確認ください）。', 'success');
        return;
      }
      // 無料会員 → 即時無料ログイン（plan は固定 'free' のみ保存・有料 Cookie とは分離）
      if (data.success && data.user && data.memberType === 'free') {
        try {
          localStorage.setItem('user-plan', JSON.stringify({ email, plan: 'free', nonAuthoritative: true }));
          localStorage.setItem('isLoggedIn', 'true');
          localStorage.setItem('userPlan', 'free');
          localStorage.setItem('userEmail', email);
        } catch (_) {}
        showMessage('ログインしました。マイページへ移動します。', 'success');
        setTimeout(() => { window.location.href = '/dashboard/'; }, 1500);
        return;
      }
      showMessage('エラーが発生しました。もう一度お試しください。', 'error');
    } catch (err) {
      console.error('Login error:', err);
      showMessage('通信エラーが発生しました。もう一度お試しください。', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
    }
  });
</script>
