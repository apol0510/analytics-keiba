---
/**
 * /predictions/view/?key=… — 取得済み予想の本文（docs/PREDICTION_ACQUISITION.md §5）
 *
 * 本文はサーバーが「この会員（ak_session）が取得済み」と確認したときだけ描画する。
 * 未取得・他会員のキー・形式外は本文を作らない（取得ボタンか一覧への案内だけ）。
 */
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SessionKeepAlive from '../../components/SessionKeepAlive.astro';
import AcquiredPredictionBody from '../../components/acquisition/AcquiredPredictionBody.astro';
import '../../styles/acquisitionGlass.css';
import { loadAcquiredView, ACQUISITION_DOOR_PLANS } from '../../lib/acquisition/acquisitionServer.js';
import { gatePaidPage, PAID_PAGE_HEADERS } from '../../lib/auth/paidPageGate.js';
import { findRace } from '../../lib/acquisition/raceSource.js';
import { buildPredictionContent } from '../../lib/acquisition/predictionContent.js';
import { judgeAcquired, loadResultIndex } from '../../lib/acquisition/acquiredResults.js';

// ── サーバー側認可（この行より前で本文を組み立てない）──
const gate = await gatePaidPage({ request: Astro.request, requiredPlan: ACQUISITION_DOOR_PLANS, env: process.env });
if (gate.response) return gate.response;
const rawKey = Astro.url.searchParams.get('key') || '';
const v = await loadAcquiredView({ gate, rawKey, env: process.env });
if (v.status === 'denied') return new Response('Forbidden', { status: 403 });
for (const [k, val] of Object.entries(PAID_PAGE_HEADERS)) Astro.response.headers.set(k, val);
if (v.status === 'invalid') Astro.response.status = 404;
if (v.status === 'unavailable') Astro.response.status = 503;

const p = v.parsed;
const listPath = p ? (p.product === 'srp'
  ? (p.cat === 'jra' ? '/premium-sanrenpuku-jra/' : '/premium-sanrenpuku/')
  : `/premium-prediction/${p.cat}/`) + `?date=${p.date}` : '/dashboard/';
let c = v.status === 'ok' ? v.content : null;
// v1（初版）の保存データ: Premium に三連複が入っていて過去走が無い。三連複は描画しない（部品側）。
// 過去走は、予想データがまだ残っていれば今の取り出し方で補う（買い目・印・指数は保存時のまま変えない）。
let pastUnavailable = false;
if (c && c.product === 'premium' && !c.horses.some((h) => Array.isArray(h.recent))) {
  const found = findRace(p.cat, p.date, p.venue, p.raceNumber);
  if (found) {
    const live = buildPredictionContent({ product: 'premium', cat: p.cat, venueName: p.venueName, race: found.race, venueTotalRaces: found.venue.totalRaces });
    const byNum = new Map(live.horses.map((h) => [h.number, h]));
    c = { ...c, horses: c.horses.map((h) => ({ ...h, recent: byNum.get(h.number)?.recent || [], record: byNum.get(h.number)?.record || null })) };
  } else {
    pastUnavailable = true;
  }
}
// 結果（2026-10-05 MK・§2-5）: 取得時点の買い目×結果アーカイブ。読めなければ結果欄を出さない
let result = null;
if (c && v.entry) { try { result = judgeAcquired({ entry: v.entry, content: c, index: loadResultIndex() }); } catch { result = null; } }
const yen = (n) => `¥${Number(n).toLocaleString('ja-JP')}`;
const wd = ['日', '月', '火', '水', '木', '金', '土'];
const dateBlock = (ymd) => { const t = new Date(`${ymd}T00:00:00Z`); return Number.isNaN(t.getTime()) ? { md: '', wd: '' } : { md: `${t.getUTCMonth() + 1}/${t.getUTCDate()}`, wd: wd[t.getUTCDay()] }; };
const jstFull = (iso) => { const t = new Date(Date.parse(iso) + 9 * 3600e3); return `${t.getUTCFullYear()}/${String(t.getUTCMonth() + 1).padStart(2, '0')}/${String(t.getUTCDate()).padStart(2, '0')} ${String(t.getUTCHours()).padStart(2, '0')}:${String(t.getUTCMinutes()).padStart(2, '0')}`; };
const distanceText = (d) => { const s = String(d || ''); return /^\d+$/.test(s) ? `${s}m` : s; };
const jst = (iso) => { const t = new Date(Date.parse(iso) + 9 * 3600e3); return `${t.getUTCMonth() + 1}/${t.getUTCDate()} ${String(t.getUTCHours()).padStart(2, '0')}:${String(t.getUTCMinutes()).padStart(2, '0')}`; };
const productName = p?.product === 'srp' ? 'Premium Sanrenpuku' : 'Premium';
---
<BaseLayout title={c ? `${c.venueName}${c.raceNumber}R 取得済みの予想` : '予想'} noindex>
  <SessionKeepAlive />
  <div class="ag-scene acq-view-bg">
  <main class="acq-view-page">
    <a class="acq-back" href={listPath}>‹ レース一覧に戻る</a>
    {c ? (
      <>
        <header class="ag-glass ag-tint-blue acq-hero" aria-label="レース情報">
          <div class="acq-hero-top">
            <div class="acq-date ag-inset"><strong>{dateBlock(c.date).md}</strong><span>({dateBlock(c.date).wd})</span></div>
            <div class="acq-hero-main">
              <p class="ag-kicker">{c.venueName} {c.raceNumber}R{c.isMainRace ? ' ・ メインレース' : ''}</p>
              <h1>{c.raceName || `${c.venueName} ${c.raceNumber}R`}</h1>
            </div>
          </div>
          <ul class="acq-meta">
            {c.startTime && <li class="ag-pill">{c.startTime} 発走</li>}
            {c.distance && <li class="ag-pill">{distanceText(c.distance)}</li>}
            {c.horseCount > 0 && <li class="ag-pill">{c.horseCount}頭</li>}
            <li class={`ag-pill ${c.product === 'srp' ? 'violet' : 'gold'}`}>{c.product === 'srp' ? 'PREMIUM SANRENPUKU' : 'PREMIUM'}</li>
          </ul>
          <div class="acq-hero-state">
            <span class="ag-done">✓ 取得済み</span>
            <small>取得日時 {jstFull(v.entry.at)}</small>
          </div>
        </header>
        {result && result.status !== 'none' && (
          <section class={`ag-glass ag-tint-blue acq-result-card is-${result.status}`} aria-label="レース結果" data-result={result.status}>
            <h2>レース結果</h2>
            {result.status === 'pending' ? (
              <p class="acq-result-wait"><b>結果待ち</b><span>レースの結果が取り込まれると、ここに着順と的中が表示されます。</span></p>
            ) : (
              <div class="acq-result-body">
                <ol class="acq-order">
                  {result.order.map((n, i) => <li><span>{i + 1}着</span><b class={`ag-num rk rk-${i + 1}`}>{n}</b></li>)}
                </ol>
                <div class="acq-verdict">
                  {result.status === 'hit' ? (
                    <><span class="acq-verdict-chip is-hit">✓ 的中</span><span class="acq-verdict-line">{`${result.betType} ${result.combination}`}</span>{result.payout ? <span class="acq-verdict-pay">払戻 <b>{yen(result.payout)}</b><small>（100円あたり）</small></span> : null}</>
                  ) : <span class="acq-verdict-chip is-miss">不的中</span>}
                </div>
              </div>
            )}
          </section>
        )}
        <AcquiredPredictionBody content={c} pastUnavailable={pastUnavailable} result={result} />
        <nav class="ag-glass ag-tint-blue acq-foot" aria-label="取得済みの予想">
          <p>取得した予想は「取得済みの予想」に保存され、いつでも見返せます。</p>
          <div class="acq-foot-actions">
            <a class="ag-cta" href="/predictions/history/">取得済みの予想を見る</a>
            <a class="ag-btn-ghost" href={listPath}>レース一覧に戻る</a>
          </div>
        </nav>
      </>
    ) : v.status === 'not_acquired' ? (
      <section class="ag-glass ag-tint-blue acq-view-empty">
        <h1>{p.venueName} {p.raceNumber}R の予想はまだ取得していません</h1>
        <p>予想の内容は、取得したあとに表示されます。</p>
        {v.canAcquire ? (
          <form method="post" action="/api/predictions/acquire/">
            <input type="hidden" name="key" value={p.key} />
            <button type="submit" class="ag-cta">{p.product === 'srp' ? '推奨レースの予想を取得する' : '予想を取得する'}</button>
          </form>
        ) : <p>この予想はご契約のプランでは取得できません。</p>}
      </section>
    ) : v.status === 'unavailable' ? (
      <section class="ag-glass ag-tint-blue acq-view-empty"><h1>ただいま予想を表示できません</h1><p>時間をおいてもう一度お試しください。</p></section>
    ) : (
      <section class="ag-glass ag-tint-blue acq-view-empty"><h1>予想が見つかりませんでした</h1></section>
    )}
  </main>
  </div>
</BaseLayout>

<style>
  .acq-view-page { max-width: 1200px; margin: 0 auto; padding: 16px 14px 56px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .acq-view-page > * { min-width: 0; }
  .acq-back { color: #bae6fd; text-decoration: none; font-weight: 700; width: fit-content; min-height: 40px; display: inline-flex; align-items: center; }
  .acq-hero { display: grid; gap: 12px; padding: 16px; }
  /* レース結果（正本 GLASS_DESIGN_RULES.md: 緑=的中・金=払戻・赤=不的中・黄=結果待ち／着順は金・銀・銅） */
  .acq-result-card { padding: 16px; display: grid; gap: 10px; }
  .acq-result-card h2 { margin: 0; font-size: 1rem; }
  .acq-result-card.is-hit { border-color: rgba(74,222,128,0.6); box-shadow: 0 14px 34px rgba(10,16,48,0.32), 0 0 26px rgba(74,222,128,0.2); }
  .acq-result-card.is-pending { border-color: rgba(250,204,21,0.45); }
  .acq-result-body { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .acq-order { list-style: none; margin: 0; padding: 0; display: flex; gap: 10px; }
  .acq-order li { display: grid; justify-items: center; gap: 4px; }
  .acq-order li span { font-size: 0.74rem; color: var(--ag-text-2); }
  .acq-order .ag-num { min-width: 44px; height: 44px; font-size: 1.2rem; }
  .acq-verdict { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; }
  .acq-verdict-chip { display: inline-flex; padding: 4px 14px; border-radius: 999px; border: 1px solid; font-weight: 900; }
  .acq-verdict-chip.is-hit { color: #86efac; border-color: rgba(74,222,128,0.6); background: rgba(34,197,94,0.14); box-shadow: 0 0 16px rgba(74,222,128,0.25); }
  .acq-verdict-chip.is-miss { color: #fca5a5; border-color: rgba(248,113,113,0.45); background: rgba(239,68,68,0.08); }
  .acq-verdict-line { font-weight: 800; color: #bbf7d0; }
  .acq-verdict-pay { color: var(--ag-text-2); font-size: 0.85rem; }
  .acq-verdict-pay b { color: #fcd34d; font-size: 1.3rem; font-weight: 900; }
  .acq-verdict-pay small { margin-left: 2px; }
  .acq-result-wait { margin: 0; display: grid; gap: 4px; }
  .acq-result-wait b { justify-self: start; padding: 3px 12px; border-radius: 999px; border: 1px solid rgba(250,204,21,0.5); background: rgba(250,204,21,0.08); color: #fde047; }
  .acq-result-wait span { font-size: 0.84rem; color: var(--ag-text-2); }
  .acq-hero-top { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: center; }
  .acq-date { display: grid; justify-items: center; padding: 8px 12px; }
  .acq-date strong { font-size: 1.35rem; line-height: 1.1; }
  .acq-date span { color: var(--ag-text-2); font-size: 0.8rem; }
  .acq-hero h1 { margin: 2px 0 0; font-size: clamp(1.2rem, 4.8vw, 1.9rem); line-height: 1.3; letter-spacing: 0.02em; overflow-wrap: anywhere; }
  .acq-meta { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .acq-meta .ag-pill { font-weight: 700; font-size: 0.8rem; color: var(--ag-text); }
  .acq-meta .ag-pill.gold { color: var(--ag-gold); }
  .acq-meta .ag-pill.violet { color: #ddd6fe; }
  .acq-hero-state { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .acq-hero-state small { color: var(--ag-text-2); font-size: 0.78rem; }
  .acq-foot { padding: 18px 16px; display: grid; gap: 12px; text-align: center; }
  .acq-foot p { margin: 0; color: var(--ag-text-2); font-size: 0.88rem; }
  .acq-foot-actions { display: grid; gap: 10px; }
  .acq-view-empty { padding: 22px 18px; display: grid; gap: 10px; }
  .acq-view-empty h1 { margin: 0; font-size: 1.15rem; }
  @media (min-width: 760px) {
    .acq-view-page { padding: 22px 20px 64px; gap: 18px; }
    .acq-hero { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "top state" "meta state"; padding: 22px 24px; }
    .acq-hero-top { grid-area: top; }
    .acq-meta { grid-area: meta; }
    .acq-hero-state { grid-area: state; display: grid; justify-items: end; align-self: center; }
    .acq-foot-actions { grid-auto-flow: column; justify-content: center; }
  }
</style>
