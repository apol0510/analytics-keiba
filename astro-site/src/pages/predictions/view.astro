---
/**
 * /predictions/view/?key=… — 取得済み予想の本文（docs/PREDICTION_ACQUISITION.md §5）
 *
 * 本文はサーバーが「この会員（ak_session）が取得済み」と確認したときだけ描画する。
 * 未取得・他会員のキー・形式外は本文を作らない（取得ボタンか一覧への案内だけ）。
 */
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import SessionKeepAlive from '../../components/SessionKeepAlive.astro';
import AcquiredPredictionBody from '../../components/acquisition/AcquiredPredictionBody.astro';
import { loadAcquiredView, ACQUISITION_DOOR_PLANS } from '../../lib/acquisition/acquisitionServer.js';
import { gatePaidPage, PAID_PAGE_HEADERS } from '../../lib/auth/paidPageGate.js';

// ── サーバー側認可（この行より前で本文を組み立てない）──
const gate = await gatePaidPage({ request: Astro.request, requiredPlan: ACQUISITION_DOOR_PLANS, env: process.env });
if (gate.response) return gate.response;
const rawKey = Astro.url.searchParams.get('key') || '';
const v = await loadAcquiredView({ gate, rawKey, env: process.env });
if (v.status === 'denied') return new Response('Forbidden', { status: 403 });
for (const [k, val] of Object.entries(PAID_PAGE_HEADERS)) Astro.response.headers.set(k, val);
if (v.status === 'invalid') Astro.response.status = 404;
if (v.status === 'unavailable') Astro.response.status = 503;

const p = v.parsed;
const listPath = p ? (p.product === 'srp'
  ? (p.cat === 'jra' ? '/premium-sanrenpuku-jra/' : '/premium-sanrenpuku/')
  : `/premium-prediction/${p.cat}/`) + `?date=${p.date}` : '/dashboard/';
const c = v.status === 'ok' ? v.content : null;
const jst = (iso) => { const t = new Date(Date.parse(iso) + 9 * 3600e3); return `${t.getUTCMonth() + 1}/${t.getUTCDate()} ${String(t.getUTCHours()).padStart(2, '0')}:${String(t.getUTCMinutes()).padStart(2, '0')}`; };
const productName = p?.product === 'srp' ? 'Premium Sanrenpuku' : 'Premium';
---
<BaseLayout title={c ? `${c.venueName}${c.raceNumber}R 取得済みの予想` : '予想'} noindex>
  <SessionKeepAlive />
  <main class="acq-view-page">
    <a class="acq-back" href={listPath}>← 一覧へ戻る</a>
    {c ? (
      <>
        <header class="acq-view-head">
          <div class="acq-view-no"><strong>{c.raceNumber}R</strong><span>{c.startTime}</span></div>
          <div>
            <h1>{c.venueName} {c.raceNumber}R {c.raceName}</h1>
            <p>{c.date} ・ {[c.distance, c.horseCount ? `${c.horseCount}頭` : ''].filter(Boolean).join(' ・ ')} ・ {productName}</p>
          </div>
          <div class="acq-view-done">✓ 取得済み<small>取得 {jst(v.entry.at)}</small></div>
        </header>
        <AcquiredPredictionBody content={c} />
        <p class="acq-view-note">取得した予想は「<a href="/predictions/history/">取得済みの予想</a>」からいつでも見返せます。</p>
      </>
    ) : v.status === 'not_acquired' ? (
      <section class="acq-view-empty">
        <h1>{p.venueName} {p.raceNumber}R の予想はまだ取得していません</h1>
        <p>予想の内容は、取得したあとに表示されます。</p>
        {v.canAcquire ? (
          <form method="post" action="/api/predictions/acquire/">
            <input type="hidden" name="key" value={p.key} />
            <button type="submit" class="acq-btn">{p.product === 'srp' ? '推奨レースの予想を取得する' : '予想を取得する'}</button>
          </form>
        ) : <p>この予想はご契約のプランでは取得できません。</p>}
      </section>
    ) : v.status === 'unavailable' ? (
      <section class="acq-view-empty"><h1>ただいま予想を表示できません</h1><p>時間をおいてもう一度お試しください。</p></section>
    ) : (
      <section class="acq-view-empty"><h1>予想が見つかりませんでした</h1></section>
    )}
  </main>
</BaseLayout>

<style>
  .acq-view-page { max-width: 820px; margin: 0 auto; padding: 24px 16px 60px; display: grid; gap: 16px; }
  .acq-back { color: #818cf8; text-decoration: none; }
  .acq-view-head { display: grid; grid-template-columns: 64px 1fr auto; gap: 12px; align-items: center; }
  .acq-view-head h1 { margin: 0; font-size: 1.25rem; }
  .acq-view-head p { margin: 2px 0 0; color: #94a3b8; font-size: 0.85rem; }
  .acq-view-no { display: grid; justify-items: center; padding: 8px; border-radius: 10px; background: rgba(15,23,42,0.6); }
  .acq-view-no strong { font-size: 1.2rem; }
  .acq-view-no span { color: #94a3b8; font-size: 0.8rem; }
  .acq-view-done { display: grid; justify-items: center; padding: 6px 12px; border-radius: 8px; background: rgba(34,197,94,0.18); color: #4ade80; font-weight: 800; }
  .acq-view-done small { color: #94a3b8; font-weight: 400; font-size: 0.72rem; }
  .acq-view-empty { padding: 24px; border-radius: 12px; background: rgba(255,255,255,0.06); display: grid; gap: 8px; }
  .acq-view-empty h1 { margin: 0; font-size: 1.15rem; }
  .acq-btn { border: 0; cursor: pointer; padding: 12px 18px; border-radius: 10px; background: #4f46e5; color: #fff; font-weight: 800; }
  .acq-view-note { color: #94a3b8; font-size: 0.85rem; }
  .acq-view-note a { color: #818cf8; }
  @media (max-width: 560px) { .acq-view-head { grid-template-columns: 56px 1fr; } .acq-view-done { grid-column: 1 / -1; } }
</style>
