---
import { MAGIC_LINK_TTL_MINUTES } from '../../lib/auth/constants.js';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout
  title="認証中... | KEIBA Analytics"
  description="ログイン処理中"
>
  <section class="verify-section">
    <div class="container">
      <div class="verify-card">
        <!--
          ⚠️ **ページを開いただけでトークンを消費してはいけない**（2026-09-10 MK 指摘）。
             iOS はリンクを長押ししただけでプレビューを描画し、その中で JS を実行する。
             以前はここで自動的に検証していたため、**コピーしようとしただけでリンクが
             「使用済み」**になり、貼り付けた先で必ず認証エラーになっていた。
             メールのリンク検査ボット・先読みでも同じことが起きる。
             検証は「ログインする」を**押したときだけ**行う。

          ⚠️ **画面に出すのは「今すること」と「結果」だけ**（2026-09-10 MK 確定方針）。
             トークンの消費・ブラウザ差・長押し・先読み・セッションといった内部事情は
             ユーザー向け画面／メールに書かない。理由の説明はこのコメントに置く。
        -->
        <div id="verify-state" class="verify-content">
          <div class="spinner" id="spinner" hidden></div>
          <h1 id="status">ログイン</h1>
          <p id="message">ログインするには、下のボタンを押してください。</p>
          <button type="button" id="login-btn" class="login-btn">ログインする</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .verify-section {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    padding: 80px 0;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  .verify-card {
    max-width: 480px; margin: 0 auto;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 16px; padding: 48px; text-align: center;
  }
  .verify-content {
    h1 {
      font-size: 28px; font-weight: 700; margin: 24px 0 12px;
      background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    p { color: #94a3b8; font-size: 15px; line-height: 1.6; }
    a { color: #3b82f6; text-decoration: none; &:hover { text-decoration: underline; } }
  }
  .spinner {
    width: 48px; height: 48px; margin: 0 auto;
    border: 4px solid rgba(59, 130, 246, 0.2);
    border-top-color: #3b82f6;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .login-btn {
    display: inline-block; margin: 8px 0 0;
    background: linear-gradient(135deg, #0ea5e9, #2563eb);
    color: #fff; border: 0; border-radius: 10px;
    padding: 16px 40px; font-size: 18px; font-weight: 700; cursor: pointer;
  }
  .login-btn:hover { filter: brightness(1.08); }
  .login-btn[disabled] { opacity: .5; cursor: default; }
  .verify-content.error h1 { background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .verify-content.success h1 { background: linear-gradient(135deg, #059669 0%, #10b981 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .verify-content.error .spinner, .verify-content.success .spinner { display: none; }
</style>

{/*
  ⚠️ このスクリプトは **素の JavaScript で書くこと。TypeScript 構文を書いてはいけない。**
     `define:vars` は `is:inline` を含意するため、Astro はこのブロックを
     **トランスパイルもバンドルもせず、そのまま HTML に埋め込む**。
     型注釈（型アサーションや引数の型）を書くと、ブラウザが SyntaxError で
     **スクリプト全体を 1 行も実行しない** → 画面は
     「認証中... トークンを確認しています」のまま永久に止まり、有料会員が
     **誰もログインできなくなる**（2026-08-09 14:11 JST 〜 2026-08-10 の本番障害の真因）。
     再発は `src/lib/auth/inlineScriptNoTs.guard.test.mjs` が検知する。
*/}
<script define:vars={{ TTL_MIN: MAGIC_LINK_TTL_MINUTES }}>
  (() => {
    const params = new URLSearchParams(window.location.search);
    const token = params.get('token');
    const root = document.getElementById('verify-state');
    const status = document.getElementById('status');
    const msg = document.getElementById('message');
    const btn = document.getElementById('login-btn');
    const spinner = document.getElementById('spinner');

    function fail(text) {
      root.classList.add('error');
      spinner.hidden = true;
      btn.hidden = true;
      status.textContent = 'ログインできませんでした';
      msg.innerHTML = `${text}<br><br><a href="/login/" style="display:inline-block;background:linear-gradient(135deg,#0ea5e9,#2563eb);color:#fff;text-decoration:none;font-weight:700;padding:12px 28px;border-radius:8px;">ログインリンクを再送する</a>`;
    }
    // ⚠️ 画面に出すのは「**結果**」だけ（2026-09-10 MK 確定方針）。
    //    セッション・Cookie・ブラウザ差・トークンといった内部事情は出さない。
    //    読ませる文章が無くなったので、自動遷移は短くする。
    const REDIRECT_DELAY_MS = 2500;
    function ok(redirectTo) {
      root.classList.add('success');
      spinner.hidden = true;
      btn.hidden = true;
      status.textContent = 'ログインしました';
      msg.textContent = 'まもなくマイページへ移動します。';
      setTimeout(() => { window.location.replace(redirectTo); }, REDIRECT_DELAY_MS);
    }

    if (!token) { fail('このリンクは使用できません。'); return; }

    // ⚠️ ここから先（＝トークンを消費する通信）は **クリックの中でしか呼ばない**。
    //    読み込み時に自動実行してはいけない（長押しプレビュー・リンク検査で消費される）。
    let busy = false;
    async function verify() {
      if (busy) return;
      busy = true;
      btn.disabled = true;
      btn.hidden = true;
      spinner.hidden = false;
      status.textContent = 'ログインしています';
      msg.textContent = 'そのままお待ちください。';

      try {
        const res = await fetch(`/.netlify/functions/verify-magic-link?token=${encodeURIComponent(token)}`, {
          method: 'GET',
          credentials: 'include',
        });
        const data = await res.json();

        if (!res.ok) {
          fail(data.error === 'Token expired' ? `リンクの有効期限（${TTL_MIN}分）が切れています。<br>下のボタンから、もう一度ログインリンクを受け取ってください。<br><strong>届いた最新の1通</strong>を ${TTL_MIN}分以内 にお開きください。`
            : data.error === 'Token already used' ? 'このリンクは既に使用済みです。<br>お手数ですが、もう一度ログインリンクを受け取ってください（<strong>最新の1通</strong>をご利用ください）。'
            : data.error === 'Token not found' ? 'このリンクは使用できません。'
            : data.error === 'Customer not found' ? 'アカウントが見つかりません。'
            : 'エラーが発生しました。');
          return;
        }

        // PR-B: 認可の真実源はサーバーが発行した HttpOnly Cookie `ak_session`
        // （このfetchは credentials:'include' で受け取る）。以下の localStorage 保存は
        // 既存 AccessControl の UI 互換のための **非権威**情報で、PR-C/PR-D で Cookie ベースへ
        // 移行後に削除予定。ここではサーバー判定済みの userPlan をそのまま保存するだけ
        // （クライアントでプランを推定・改変しない）。
        if (data.userPlan) {
          try {
            localStorage.setItem('user-plan', JSON.stringify(data.userPlan));
            // ⚠️ 古い「期限切れ」フラグを必ず消す。
            //    AccessControl は localStorage の isExpired / validUntil を見て
            //    プランを強制的に Free に落とす（AccessControl.astro の有効期限チェック）。
            //    サーバーが今この瞬間に「有料階層のセッションを発行してよい」と判定した以上、
            //    過去に書かれた期限フラグでそれを上書きさせない。
            //    これを消さないと、カムバック無料特典を付けた**期限切れ顧客**が
            //    ログインできても画面上は Free のままになる（特典が機能しない）。
            //    有効期限の表示値は、サーバー由来の user-plan から再度書かれる。
            for (const k of ['isExpired', 'originalPlan', 'validUntil', 'expiryDate']) {
              localStorage.removeItem(k);
            }
          } catch (e) {
            console.warn('localStorage write failed', e);
          }
        }
        ok(data.redirectTo || '/dashboard/');
      } catch (e) {
        console.error(e);
        // 通信エラーはトークンを消費していない可能性が高い。もう一度押せるようにする。
        busy = false;
        btn.disabled = false;
        btn.hidden = false;
        spinner.hidden = true;
        status.textContent = 'ログイン';
        msg.textContent = '通信できませんでした。もう一度ボタンを押してください。';
      }
    }

    // ⚠️ **明示操作でだけ検証する**。読み込み時・可視化時・フォーカス時などに
    //    自動で呼ばないこと（プレビュー／リンク検査／先読みで消費される）。
    btn.addEventListener('click', verify);
  })();
</script>
