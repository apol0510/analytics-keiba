---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readdirSync, readFileSync, existsSync } from 'fs';
import { join } from 'path';
import DateArchiveHub from '../../../components/DateArchiveHub.astro';
import { loadResultsByDate, weekdayJa } from '../../../lib/dayResultsView.js';

export const prerender = true;

const jraDir = join(process.cwd(), 'src', 'data', 'predictions', 'jra');
const files = [];

if (existsSync(jraDir)) {
  const years = readdirSync(jraDir).filter(d => /^\d{4}$/.test(d));
  for (const year of years) {
    const yearDir = join(jraDir, year);
    const months = readdirSync(yearDir).filter(d => /^\d{2}$/.test(d));
    for (const month of months) {
      const monthDir = join(yearDir, month);
      const jsons = readdirSync(monthDir).filter(f => /^\d{4}-\d{2}-\d{2}\.json$/.test(f));
      for (const f of jsons) {
        const date = f.replace('.json', '');
        const [y, m, d] = date.split('-');
        let totalRaces = 0;
        let venueNames = [];
        try {
          const data = JSON.parse(readFileSync(join(monthDir, f), 'utf-8'));
          totalRaces = data.totalRaces || 0;
          venueNames = (data.venues || []).map(v => v.venue);
        } catch {}
        files.push({ date, year: y, month: m, day: d, totalRaces, venues: venueNames });
      }
    }
  }
}
files.sort((a, b) => b.date.localeCompare(a.date));
// 2026-09-28: 南関の一覧と同じく、各開催日の的中数を出す（結果アーカイブが単一源）
const resultsByDate = loadResultsByDate('jra');
for (const f of files) {
  const e = resultsByDate.get(f.date);
  f.hasResult = !!e;
  f.hitStat = e ? `的中 ${e.races.filter((r) => r.isHit).length}/${e.races.length}R` : '結果待ち';
}

const byMonth = {};
files.forEach(f => {
  const key = `${f.year}-${f.month}`;
  if (!byMonth[key]) byMonth[key] = [];
  byMonth[key].push(f);
});
const months = Object.keys(byMonth).sort().reverse();
// 2026-09-28: 表示は中央・南関 共通の DateArchiveHub（ガラスモーフィズム）
const hubMonths = months.map((monthKey) => {
  const [y, m] = monthKey.split('-');
  return {
    label: `${y}年${parseInt(m)}月`,
    count: byMonth[monthKey].length,
    items: byMonth[monthKey].map((item) => ({
      href: `/free-prediction/jra/${item.date}/`,
      dateLabel: `${parseInt(item.month)}/${parseInt(item.day)}`,
      weekday: weekdayJa(item.date),
      venue: item.venues.join('・') || 'JRA',
      races: `${item.totalRaces}R`,
      stat: item.hitStat,
      hasResult: item.hasResult,
    })),
  };
});
---

<BaseLayout
  title="中央競馬 AI予想と結果 開催日一覧"
  description={`中央競馬（JRA）のAI予想と結果（着順・的中）を開催日ごとに掲載。全${files.length}開催日。`}
>
  <DateArchiveHub
    title="中央競馬（JRA） AI予想と結果 開催日一覧"
    crumb="中央 予想と結果 一覧"
    lead={`全${files.length}開催日分のAI予想と結果（着順・的中）。日付を選ぶと、その日の予想と結果を見られます。`}
    links={[
      { href: '/free-prediction/jra/', label: '最新の予想' },
      { href: '/free/jra/', label: '今日の中央 無料予想' },
      { href: '/archive/jra/', label: '中央 的中実績アーカイブ' },
      { href: '/free-prediction/nankan/archive/', label: '南関競馬の予想と結果 →' },
    ]}
    months={hubMonths}
  />
</BaseLayout>
