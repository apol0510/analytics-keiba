---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AIRaceComment from '../../../components/AIRaceComment.astro';
import AIBettingSection from '../../../components/AIBettingSection.astro';
import { readdirSync, readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { generateAdvancedMetrics } from '../../../utils/featureScores.js';
import { injectHorseHistoriesIntoVenues } from '../../../lib/loadHorseHistoriesJra.js';
import { parseSexAge, parseDistanceMeters } from '../../../lib/horseEnrichment.js';

// 過去走データアコーディオン用: 条件別成績の文字列を組み立てる。
// JSX 内のテンプレートリテラル + 三項演算子だと Astro 5.13 パーサーが
// 比較演算子を JSX タグと誤認識することがあるため、フロントマッター側に外出ししている。
function fmtHistoryCondStat(s) {
  let out = s.n + '戦 ' + s.w + '-' + s.p2 + '-' + s.p3;
  if (s.n > 0) {
    const ratio = Math.round(((s.w + s.p2 + s.p3) / s.n) * 100);
    out += ' (3着内' + ratio + '%)';
  }
  return out;
}

// 過去走データアコーディオンの集計を1関数に集約。
// 各馬カードの JSX 内に書いていた IIFE が Astro 5.13 のパーサーで
// 比較演算子をJSXタグ開始と誤認識してビルドが落ちるため、
// 集計をすべてフロントマッター側で実行し、JSX 内は値の参照のみに留める。
// AI 指数・印・買い目・特徴量重要度・予想ロジックには一切関与しない（表示専用）。
function buildHistoryAccordionContext(horse, race) {
  if (!horse || !Array.isArray(horse.historyForDetails) || horse.historyForDetails.length === 0) return null;
  const hist = horse.historyForDetails;
  const ranked = hist.filter((r) => r && Number.isFinite(Number(r.rank)));
  const totalRanked = ranked.length;
  const cnt = (pred) => ranked.filter(pred).length;
  const w = cnt((r) => Number(r.rank) === 1);
  const p2 = cnt((r) => Number(r.rank) === 2);
  const p3 = cnt((r) => Number(r.rank) === 3);
  const others = totalRanked - w - p2 - p3;
  const hasRanked = totalRanked > 0;
  const pct = (n) => hasRanked ? Math.round((n / totalRanked) * 100) : 0;
  const winPct = pct(w);
  const placePct = pct(w + p2);
  const showPct = pct(w + p2 + p3);
  const condCount = (arr) => ({
    n: arr.length,
    w: arr.filter((r) => Number(r.rank) === 1).length,
    p2: arr.filter((r) => Number(r.rank) === 2).length,
    p3: arr.filter((r) => Number(r.rank) === 3).length,
  });
  const turfStat = condCount(ranked.filter((r) => r.surface === '芝'));
  const dirtStat = condCount(ranked.filter((r) => r.surface === 'ダ'));
  const _rawRaceDist = race && race.raceInfo && race.raceInfo.distance != null ? race.raceInfo.distance : null;
  const _parsedRaceDist = _rawRaceDist != null ? parseDistanceMeters(_rawRaceDist) : null;
  const raceDist = Number.isFinite(_parsedRaceDist) ? _parsedRaceDist : null;
  const raceVenue = race && race.raceInfo && race.raceInfo.venue ? race.raceInfo.venue : null;
  const sameDist = raceDist != null
    ? condCount(ranked.filter((r) => Number.isFinite(Number(r.distanceMeters)) && Math.abs(Number(r.distanceMeters) - raceDist) <= 200))
    : null;
  const sameVenue = raceVenue ? condCount(ranked.filter((r) => r.venue === raceVenue)) : null;
  const _weight = (horse.weight != null && horse.weight !== '' && Number.isFinite(Number(horse.weight)))
    ? (horse.weight + 'kg')
    : null;
  const _sex = parseSexAge(horse.age);
  const _ageGenderDisplay = (_sex.ageNum != null && _sex.gender)
    ? (_sex.ageNum + '歳' + _sex.gender)
    : (horse.age || null);
  const profileItems = [
    _ageGenderDisplay && { label: '性齢', value: _ageGenderDisplay },
    horse.sire && { label: '父', value: horse.sire },
    horse.jockey && { label: '騎手', value: horse.jockey },
    _weight && { label: '斤量', value: _weight },
    horse.trainer && { label: '調教師', value: horse.trainer },
  ].filter(Boolean);
  const condRows = [
    turfStat.n > 0 && { label: '芝', stat: turfStat },
    dirtStat.n > 0 && { label: 'ダート', stat: dirtStat },
    sameDist && sameDist.n > 0 && { label: '同距離±200m(' + raceDist + 'm基準)', stat: sameDist },
    sameVenue && sameVenue.n > 0 && { label: '同会場(' + raceVenue + ')', stat: sameVenue },
  ].filter(Boolean);
  const display = hist.slice(0, 10);
  const overflow = hist.length - display.length;
  const hasOverflow = overflow > 0;
  const sectionLabel = hist.length > 10 ? '競走成績（直近10走）' : '競走成績';
  const summaryCount = '（' + hist.length + '走）';
  const recordValue = w + '-' + p2 + '-' + p3 + '-' + others;
  const winPctStr = winPct + '%';
  const placePctStr = placePct + '%';
  const showPctStr = showPct + '%';
  const rows = display.map((r) => {
    const rankNum = Number(r.rank);
    const isWin = rankNum === 1;
    const isGood = Number.isFinite(rankNum) && rankNum < 4;
    const rankClass = isWin ? 'hh-rank win' : (isGood ? 'hh-rank good' : 'hh-rank');
    const hasFinishStatus = !!r.finishStatus;
    const hasRank = r.rank != null && !hasFinishStatus;
    const hasPopularity = r.popularity !== '' && r.popularity != null;
    return {
      r,
      rankClass,
      hasFinishStatus,
      hasRank,
      hasPopularity,
    };
  });
  return {
    hist,
    totalRanked,
    hasRanked,
    hasProfile: profileItems.length > 0,
    hasCondRows: condRows.length > 0,
    w, p2, p3, others,
    profileItems,
    condRows,
    rows,
    overflow,
    hasOverflow,
    sectionLabel,
    summaryCount,
    recordValue,
    winPctStr,
    placePctStr,
    showPctStr,
  };
}

export const prerender = true;

export function getStaticPaths() {
  const predictionsDir = join(process.cwd(), 'src', 'data', 'predictions', 'jra');
  const paths = [];

  if (!existsSync(predictionsDir)) {
    return paths;
  }

  const years = readdirSync(predictionsDir).filter(name => /^\d{4}$/.test(name));

  for (const year of years) {
    const yearPath = join(predictionsDir, year);
    if (!existsSync(yearPath)) continue;

    const months = readdirSync(yearPath).filter(name => /^\d{2}$/.test(name));

    for (const month of months) {
      const monthPath = join(yearPath, month);
      if (!existsSync(monthPath)) continue;

      const files = readdirSync(monthPath).filter(
        file => file.endsWith('.json') && /^\d{4}-\d{2}-\d{2}\.json$/.test(file)
      );

      for (const file of files) {
        const dateMatch = file.match(/^(\d{4}-\d{2}-\d{2})\.json$/);
        if (dateMatch) {
          const filePath = join(monthPath, file);
          try {
            const content = readFileSync(filePath, 'utf-8');
            const data = JSON.parse(content);
            paths.push({
              params: { date: dateMatch[1] },
              props: { jraData: data }
            });
          } catch (e) {
            // Skip invalid JSON files
          }
        }
      }
    }
  }

  return paths;
}

const { date } = Astro.params;
const { jraData } = Astro.props;

// Normalize data structure
let venues = [];
let isMultiVenue = false;

if (jraData.venues && Array.isArray(jraData.venues)) {
  isMultiVenue = true;
  venues = jraData.venues;
} else if (jraData.eventInfo && jraData.predictions) {
  isMultiVenue = false;
  venues = [{
    venue: jraData.eventInfo.venue,
    eventInfo: jraData.eventInfo,
    predictions: jraData.predictions
  }];
}

const venueNames = venues.map(v => v.venue || v.eventInfo?.venue).join(' / ');

// 表示専用: horseHistories から historyForDetails を venues 内の各 horse に注入する。
// 既存 horse.recentRaces は触らない（loader 設計どおり）。
// horseHistories JSON が未同期の過去日では何もしない（サイレントフォールバック）。
try {
  injectHorseHistoriesIntoVenues(venues, date, process.cwd());
} catch (_e) {
  // 注入失敗時は既存表示にフォールバック。ビルドは止めない。
}

// generateAdvancedMetrics imported from featureScores.js
---

<BaseLayout
  title={`${date} 中央競馬 AI予想 - KEIBA Intelligence`}
  description={`${date} 中央競馬（JRA）${venueNames} のAI予想アーカイブ。KEIBA Intelligence の過去予想データを閲覧できます。`}
>
  <section class="prediction-section">
    <div class="container">

      <!-- アーカイブバナー -->
      <div class="archive-banner">
        <span class="archive-icon">&#128218;</span>
        <span class="archive-text">この予想は過去のアーカイブです</span>
      </div>

      <!-- ページヘッダー -->
      <div class="page-header">
        <div class="ai-badge">
          <span class="badge-pulse"></span>
          <span class="badge-text">DEEP LEARNING PREDICTION SYSTEM / 深層学習予測システム</span>
        </div>
        <h1 class="page-title">
          {date} 中央競馬（JRA）{isMultiVenue && venues.length > 1 ? ` - ${venueNames}` : ` - ${venueNames}`}
        </h1>
        <p class="page-subtitle">
          Ensemble Neural Network Analysis / アンサンブル型ニューラルネットワーク分析
        </p>
        <div class="scan-line"></div>
      </div>

      <!-- 会場タブ（複数会場の場合のみ表示）-->
      {isMultiVenue && venues.length > 1 && (
        <div class="venue-selector">
          {venues.map((venueData, venueIndex) => (
            <button
              class={`venue-btn ${venueIndex === 0 ? 'active' : ''}`}
              data-venue-index={venueIndex}
              onclick="selectVenue(event, this)"
            >
              <span class="venue-label">{venueData.venue}</span>
              <span class="venue-race-count">{venueData.eventInfo.totalRaces}R</span>
            </button>
          ))}
        </div>
      )}

      <!-- 会場ごとの表示エリア -->
      {venues.map((venueData, venueIndex) => {
        const venuePredictions = venueData.predictions;
        const venueInfo = venueData.eventInfo;

        return (
          <div class={`venue-content ${venueIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex}>
            {/* 会場名（複数会場の場合のみ表示）*/}
            {isMultiVenue && (
              <div class="venue-header">
                <h2 class="venue-title">{venueInfo.venue}</h2>
                <p class="venue-info">{venueInfo.date} - {venueInfo.totalRaces}レース</p>
              </div>
            )}

            <!-- レース選択ボタン -->
            <div class="race-selector">
              {venuePredictions.map((race, raceIndex) => (
                <button
                  class={`race-btn ${raceIndex === 0 ? 'active' : ''}`}
                  data-venue-index={venueIndex}
                  data-race-index={raceIndex}
                  onclick="selectRace(event, this)"
                  title={race.raceInfo.raceName || `第${race.raceInfo.raceNumber}レース`}
                >
                  <span class="race-label">{race.raceInfo.raceNumber}R</span>
                  <span class="race-indicator"></span>
                </button>
              ))}
            </div>

            <!-- レース表示エリア -->
            <div class="race-display-area">
              {venuePredictions.map((race, raceIndex) => {
                const allHorses = race.horses;
                const horsesWithMetrics = allHorses.map(horse => ({
                  ...horse,
                  metrics: generateAdvancedMetrics(horse, allHorses, race.raceInfo)
                }));

                // PT値順にソートして上位5頭
                const sortedTop5 = horsesWithMetrics
                  .sort((a, b) => b.pt - a.pt)
                  .slice(0, 5);

                return (
                  <div class={`race-content ${raceIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex} data-race-index={raceIndex}>
                    {/* レース名ヘッダー */}
                    <div class="race-name-header">
                      <h2 class="race-name-title">{race.raceInfo.raceNumber}R {race.raceInfo.raceName}</h2>
                      <div class="race-details">
                        {race.raceInfo.startTime && <span class="race-detail-item">&#128336; {race.raceInfo.startTime}発走</span>}
                        {race.raceInfo.distance && <span class="race-detail-item">&#128207; {race.raceInfo.distance}m</span>}
                        {race.raceInfo.horseCount && <span class="race-detail-item">&#128014; {race.raceInfo.horseCount}頭</span>}
                      </div>
                    </div>

                    {/* AI予想解説 */}
                    <AIRaceComment
                      type="prediction"
                      masked={true}
                      raceData={JSON.stringify({
                        venue: venueData.venue,
                        date: jraData.date,
                        raceNumber: race.raceInfo.raceNumber,
                        raceName: race.raceInfo.raceName,
                        distance: race.raceInfo.distance,
                        horseCount: race.raceInfo.horseCount,
                        topHorses: allHorses.sort((a, b) => b.pt - a.pt).slice(0, 5).map(h => ({
                          horseNumber: h.horseNumber,
                          horseName: h.horseName,
                          pt: h.pt,
                          role: h.role,
                          jockey: h.jockey,
                          trainer: h.trainer,
                          age: h.age,
                          weight: h.weight,
                          recentRaces: h.recentRaces || []
                        }))
                      })}
                    />

                    {/* AI買い目（無料版マスク）*/}
                    <AIBettingSection masked={true} />

                    {/* 詳細分析テーブル（上位5頭）*/}
                    <div class="analysis-section">
                      <div class="section-header">
                        <div class="header-icon">&#128202;</div>
                        <h2>Multi-Dimensional Performance Analysis / 多次元パフォーマンス分析（上位5頭）</h2>
                      </div>

                      {sortedTop5.map((horse, index) => {
                        const m = horse.metrics;
                        const isTopTwo = index < 2;

                        return (
                          <div class={`detailed-horse-card ${isTopTwo ? 'top-horse-detailed' : 'top-horse-simple'}`}>
                            <div class="dhc-header">
                              <div class="rank-badge-large">{index + 1}位</div>
                              <div class="dhc-main-info">
                                <div class="dhc-info-card">
                                  <div class="dhc-title-line">
                                    <span class="dhc-number">{horse.horseNumber}</span>
                                    <span class="dhc-name">{horse.horseName}</span>
                                    {horse.role && <span class={`dhc-role role-${horse.role}`}>{horse.role}</span>}
                                  </div>
                                  {(horse.jockey || horse.trainer || horse.age || horse.weight) && (
                                    <div class="dhc-jockey-trainer">
                                      {horse.age && <span class="dhc-age">&#127874; {horse.age}</span>}
                                      {horse.weight && <span class="dhc-weight">&#9878;&#65039; {horse.weight}kg</span>}
                                      {horse.jockey && <span class="dhc-jockey">&#127943; {horse.jockey}</span>}
                                      {horse.trainer && <span class="dhc-trainer">&#127968; {horse.trainer}</span>}
                                    </div>
                                  )}
                                  <div class="dhc-quick-metrics">
                                    <div class="qm-item">
                                      <span class="qm-label">PT値</span>
                                      <span class="qm-value">{Number(horse.pt).toFixed(2)}</span>
                                    </div>
                                    <div class="qm-item">
                                      <span class="qm-label">Win Prob. / 勝率</span>
                                      <span class="qm-value">{m.winProbability}%</span>
                                    </div>
                                    <div class="qm-item">
                                      <span class="qm-label">Model Certainty / 確信度</span>
                                      <span class="qm-value">{m.modelCertainty}%</span>
                                    </div>
                                    <div class="qm-item">
                                      <span class="qm-label">Expected Value / 期待値</span>
                                      <span class={`qm-value ${m.expectedValue.startsWith('+') ? 'positive' : 'negative'}`}>
                                        {m.expectedValue}
                                      </span>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>

                            {/* Feature Importance Analysis（1位・2位のみ詳細表示）*/}
                            {isTopTwo && (
                              <div class="dhc-features">
                                <div class="feature-title">Feature Importance Analysis / 特徴量重要度分析</div>
                                <div class="feature-grid">
                                  <div class="feature-item">
                                    <div class="feature-label">
                                      <span class="feature-icon">&#9889;</span>
                                      <span>Speed Index / スピード指数</span>
                                    </div>
                                    <div class="feature-bar-container">
                                      <div class="feature-bar" style={`width: ${m.speedIndex}%`}></div>
                                    </div>
                                    <div class="feature-value">{m.speedIndex}</div>
                                  </div>

                                  <div class="feature-item">
                                    <div class="feature-label">
                                      <span class="feature-icon">&#128170;</span>
                                      <span>Stamina Rating / スタミナ評価</span>
                                    </div>
                                    <div class="feature-bar-container">
                                      <div class="feature-bar" style={`width: ${m.staminaRating}%`}></div>
                                    </div>
                                    <div class="feature-value">{m.staminaRating}</div>
                                  </div>

                                  <div class="feature-item">
                                    <div class="feature-label">
                                      <span class="feature-icon">&#128200;</span>
                                      <span>Form Trend / 調子傾向</span>
                                    </div>
                                    <div class="feature-bar-container trend">
                                      <div class="feature-bar-center"></div>
                                      <div class="feature-bar trend" style={`width: ${Math.abs(parseFloat(m.formTrend))}%; ${parseFloat(m.formTrend) >= 0 ? 'left: 50%;' : 'right: 50%;'}`}></div>
                                    </div>
                                    <div class="feature-value">{m.formTrend}</div>
                                  </div>

                                  <div class="feature-item">
                                    <div class="feature-label">
                                      <span class="feature-icon">&#127937;</span>
                                      <span>Track Compatibility / コース適性</span>
                                    </div>
                                    <div class="feature-bar-container">
                                      <div class="feature-bar" style={`width: ${m.trackCompatibility}%`}></div>
                                    </div>
                                    <div class="feature-value">{m.trackCompatibility}</div>
                                  </div>

                                  <div class="feature-item">
                                    <div class="feature-label">
                                      <span class="feature-icon">&#128207;</span>
                                      <span>Distance Fitness / 距離適性</span>
                                    </div>
                                    <div class="feature-bar-container">
                                      <div class="feature-bar" style={`width: ${m.distanceFitness}%`}></div>
                                    </div>
                                    <div class="feature-value">{m.distanceFitness}</div>
                                  </div>

                                  <div class="feature-item">
                                    <div class="feature-label">
                                      <span class="feature-icon">&#128100;</span>
                                      <span>Jockey Factor / 騎手要因</span>
                                    </div>
                                    <div class="feature-bar-container">
                                      <div class="feature-bar" style={`width: ${m.jockeyFactor}%`}></div>
                                    </div>
                                    <div class="feature-value">{m.jockeyFactor}</div>
                                  </div>
                                </div>
                              </div>
                            )}

                            {/* 近走成績（あれば表示）*/}
                            {horse.recentRaces && horse.recentRaces.length > 0 && (
                              <div class="recent-races">
                                <div class="recent-races-title">Recent Races / 近走成績</div>
                                <div class="recent-races-grid">
                                  {horse.recentRaces.map((recent, rIdx) => (
                                    <div class="recent-race-item">
                                      <div class="recent-race-label">{recent.label || `${rIdx + 1}走前`}</div>
                                      <div class="recent-race-details">
                                        {recent.venue && <span class="rr-venue">{recent.venue}</span>}
                                        {recent.result && <span class={`rr-result ${parseInt(recent.result) <= 3 ? 'top3' : ''}`}>{recent.result}着</span>}
                                        {recent.distance && <span class="rr-distance">{recent.distance}m</span>}
                                        {recent.condition && <span class="rr-condition">{recent.condition}</span>}
                                      </div>
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}

                            {/* 過去走データ（horseHistories.history 由来・表示専用アコーディオン）
                                集計は buildHistoryAccordionContext で実行。
                                horse.historyForDetails が無い馬は何も出さない。
                                計算系・印・買い目・特徴量重要度には一切関与しない。 */}
                            {(() => {
                              const ctx = buildHistoryAccordionContext(horse, race);
                              if (!ctx) return null;
                              return (
                                <details class="history-details">
                                  <summary class="history-summary">
                                    <span class="history-summary-text">過去走データ</span>
                                    <span class="history-summary-count">{ctx.summaryCount}</span>
                                    <span class="history-summary-chevron" aria-hidden="true">▾</span>
                                  </summary>
                                  <div class="history-content">
                                    {ctx.hasProfile && (
                                      <div class="history-section">
                                        <div class="history-section-label">プロフィール</div>
                                        <div class="history-profile-grid">
                                          {ctx.profileItems.map((p) => (
                                            <div class="history-profile-item">
                                              <span class="history-profile-label">{p.label}</span>
                                              <span class="history-profile-value">{p.value}</span>
                                            </div>
                                          ))}
                                        </div>
                                      </div>
                                    )}
                                    {ctx.hasRanked && (
                                      <div class="history-section">
                                        <div class="history-section-label">通算成績</div>
                                        <div class="history-record-grid">
                                          <div class="history-rec-card">
                                            <div class="history-rec-label">通算</div>
                                            <div class="history-rec-value">{ctx.recordValue}</div>
                                          </div>
                                          <div class="history-rec-card">
                                            <div class="history-rec-label">勝率</div>
                                            <div class="history-rec-value">{ctx.winPctStr}</div>
                                          </div>
                                          <div class="history-rec-card">
                                            <div class="history-rec-label">連対率</div>
                                            <div class="history-rec-value">{ctx.placePctStr}</div>
                                          </div>
                                          <div class="history-rec-card">
                                            <div class="history-rec-label">3着内率</div>
                                            <div class="history-rec-value">{ctx.showPctStr}</div>
                                          </div>
                                        </div>
                                      </div>
                                    )}
                                    {ctx.hasCondRows && (
                                      <div class="history-section">
                                        <div class="history-section-label">条件別成績</div>
                                        <div class="history-cond-list">
                                          {ctx.condRows.map((row) => (
                                            <div class="history-cond-row">
                                              <span class="history-cond-label">{row.label}</span>
                                              <span class="history-cond-stat">{fmtHistoryCondStat(row.stat)}</span>
                                            </div>
                                          ))}
                                        </div>
                                      </div>
                                    )}
                                    <div class="history-section">
                                      <div class="history-section-label">{ctx.sectionLabel}</div>
                                      <div class="history-list">
                                        {ctx.rows.map((row) => (
                                          <div class="history-row">
                                            <div class="hh-line hh-line-primary">
                                              {row.r._dateStr && <span class="hh-date">{row.r._dateStr}</span>}
                                              {row.r.venue && <span class="hh-venue">{row.r.venue}</span>}
                                              {row.r._displayDistance && <span class="hh-dist">{row.r._displayDistance}</span>}
                                              {row.hasFinishStatus && <span class="hh-status">[{row.r.finishStatus}]</span>}
                                              {row.hasRank && <span class={row.rankClass}>{row.r.rank}着</span>}
                                              {row.hasPopularity && <span class="hh-pop">{row.r.popularity}人気</span>}
                                            </div>
                                            <div class="hh-line hh-line-secondary">
                                              {row.r.raceName && <span class="hh-race-name">{row.r.raceName}</span>}
                                              {row.r.jockey && <span class="hh-jockey">🏇 {row.r.jockey}</span>}
                                              {row.r.bodyWeight && <span class="hh-bw">{row.r.bodyWeight}kg</span>}
                                              {row.r.time && <span class="hh-time">{row.r.time}</span>}
                                              {row.r.winnerName && <span class="hh-winner">勝: {row.r.winnerName}</span>}
                                            </div>
                                          </div>
                                        ))}
                                        {ctx.hasOverflow && (
                                          <div class="hh-overflow">他{ctx.overflow}走あり</div>
                                        )}
                                      </div>
                                    </div>
                                  </div>
                                </details>
                              );
                            })()}
                          </div>
                        );
                      })}
                    </div>

                  </div>
                );
              })}
            </div>
          </div>
        );
      })}

