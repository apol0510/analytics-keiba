---
export const prerender = true; // 静的サイト生成用に戻す
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgressBarConfidence from '../../components/ProgressBarConfidence.astro';
import { processRaceData, processUnifiedRaceData, normalizeHorseData, getRoleDisplayConfig, validateDataIntegrity, getHorseConfidenceFromMark, calculateMarkBasedConfidence, convertToStarRating, getRecommendationStars, generateStandardizedBets, calculateScoreBasedStats, getPredictionDataWithStrategies, isOsaeCandidate, isIneligibleHorse, sortOsaeCandidates, getDisplayComputerIndex, getHorseAiIndex } from '../../lib/shared-prediction-logic.js';
import { pickLatestNankanVenuesAndAdapt } from '../../lib/adaptLatestPrediction.js';
import { getDisplayRecentRacesForNankan } from '../../lib/getDisplayRecentRacesForNankan.js';
import { loadFeatureScores, getHorseFeatures, venueCodeFromName } from '../../lib/loadFeatureScores.js';
import { deriveAkImportance } from '../../lib/akFeatureSummary.js';
import NankanHorseStatsPanel from '../../components/NankanHorseStatsPanel.astro';
import { buildFreePublicRows } from '../../lib/freePublicView.js';
import AccordionClickClose from '../../components/AccordionClickClose.astro';
import RaceAccordionClickClose from '../../components/RaceAccordionClickClose.astro';

// 南関 featureScores → AK 3項目（安定性/能力上位性/展開利）。
// shared featureScores がある馬のみ返す。無ければ null → 呼び出し側で既存 horse.importance に fallback。
// deriveAkImportance の値は 0〜100。既存 importance(0〜1) と揃えるため /100 に正規化。一部軸が欠ける馬は fallback。
function fsImportanceFor(featureScoresData, raceNumber, horseNumber) {
  if (!featureScoresData) return null;
  const fs6 = getHorseFeatures(featureScoresData, raceNumber, horseNumber);
  if (!fs6) return null;
  const akImp = deriveAkImportance(fs6);
  if (!akImp) return null;
  // 一部の軸が欠ける馬（少走・新馬など）は信頼できる3項目にならないため既存表示に fallback。
  if (akImp.some((it) => it.value == null)) return null;
  return akImp.map((it) => ({ label: it.label, value: it.value / 100 }));
}

// 過去走表示用ラベル (index 連動、表示専用)。
// 南関は horseHistories 対象外のため、既存 horse.recentRaces をそのまま使う。
const RECENT_LABELS = ['前走', '2走前', '3走前', '4走前', '5走前'];

// src/data/predictions/*.json を自動スキャンし、最新日付の全会場を取得（同時開催対応）
const predictionModules = import.meta.glob('/src/data/predictions/*.json', { eager: true });
const multiVenueData = pickLatestNankanVenuesAndAdapt(predictionModules);

if (!multiVenueData || multiVenueData.venues.length === 0) {
    throw new Error('予想データが見つかりません。src/data/predictions/ に有効な JSON がありません。');
}

// 各会場ごとに必要な派生データを構築
const venuesProcessed = multiVenueData.venues.map((venueRaw) => {
    const { mainRace } = processRaceData(venueRaw);
    if (!mainRace) {
        throw new Error(`メインレースが見つかりません。source=${venueRaw._sourceFile}`);
    }
    const raceData = processUnifiedRaceData(mainRace);
    return {
        allRacesData: venueRaw,
        venueSlug: venueRaw.venueSlug,
        track: venueRaw.track,
        raceDate: venueRaw.raceDate,
        mainRace,
        raceInfo: mainRace.raceInfo,
        normalizedHorses: normalizeHorseData(mainRace),
        strategies: {
            safe: raceData.strategies.safe,
            balance: raceData.strategies.balance,
            aggressive: raceData.strategies.aggressive,
        },
        mainHorseScore: getHorseConfidenceFromMark(mainRace.horses.main),
        subHorseScore: getHorseConfidenceFromMark(mainRace.horses.sub),
    };
});

const isMultiVenue = venuesProcessed.length > 1;
const firstVenue = venuesProcessed[0];

// ページ全体の日付情報（会場共通）
const raceDate = multiVenueData.raceDate;
const [year, month, day] = raceDate.split('-');
const formattedDate = `${parseInt(month)}月${parseInt(day)}日`;

// SEO・サマリー用に最初の会場のメインレース情報を採用
const { raceInfo } = firstVenue;
const analysis = firstVenue.mainRace.analysis;
---

<BaseLayout title={`AI予想分析 | ${raceInfo.title}`} description={`AI技術による${raceInfo.track}競馬${raceInfo.raceName}の詳細分析。機械学習モデルによる高精度予想を無料で提供中。`}>
    <div class="container">
        <!-- ヘッダーセクション -->
        <div class="header-section">
            <div class="ai-badge">
                <span class="pulse"></span>
                <span class="ai-status">AI分析完了</span>
            </div>
            <h1 class="race-title">
                {isMultiVenue
                    ? `${formattedDate} 南関競馬 ${venuesProcessed.length}会場`
                    : `${formattedDate}${firstVenue.track}${raceInfo.raceName}`}
            </h1>
            <!-- 余計な詳細指標を削除し、シンプルに -->
        </div>

        <!-- 会場タブ（同時開催の場合のみ表示） -->
        {isMultiVenue && (
            <div class="venue-selector">
                {venuesProcessed.map((v, i) => (
                    <button
                        class={`venue-btn ${i === 0 ? 'active' : ''}`}
                        data-venue-index={i}
                        type="button"
                        onclick="selectNankanVenue(this)"
                    >
                        <span class="venue-label">{v.track}</span>
                        <span class="venue-race-count">{v.allRacesData.races.length}R</span>
                    </button>
                ))}
            </div>
        )}

        <!-- 穴馬ページリンク -->
        <div class="dark-horse-link-section">
            <a href="/dark-horse-picks/?category=nankan" class="dark-horse-link-btn">
                <span class="dark-horse-icon">🐎</span>
                <div class="dark-horse-text">
                    <span class="dark-horse-title">本日の穴馬抽出ツール</span>
                    <span class="dark-horse-subtitle">AI予想から狙い目の穴馬を自動抽出</span>
                </div>
                <span class="dark-horse-arrow">→</span>
            </a>
        </div>

        <!-- プレミアムと100%同じアコーディオンシステム -->
        {venuesProcessed.map((venueData, venueIndex) => (
        <section class={`venue-content ${venueIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex} style="margin-bottom: 60px;">
            {isMultiVenue && (
                <div class="venue-header-inline">
                    <h2 class="venue-title-inline">{venueData.track}（{venueData.allRacesData.races.length}R）</h2>
                </div>
            )}
            <div class="analysis-section">
                <h2 style="font-size: 2.5rem; font-weight: 800; color: var(--primary-color); text-align: center; margin-bottom: 15px;">
                    👀 全レースプレビュー
                </h2>
                <p style="text-align: center; color: var(--body-text-color); font-size: 1.1rem; margin-bottom: 40px; opacity: 0.9;">
                    全レースの注目馬を一目でチェック
                </p>

                <!-- 全レースアコーディオン（1R-12R順番通り） -->
                <div style="display: grid; gap: 10px;">
                    {venueData.allRacesData.races.map((raceData) => {
                        const raceNum = raceData.raceNumber.replace('R', '');
                        const isMainRace = raceData.isMainRace;

                        // 南関 featureScores（この会場・日付分）。馬単位で getHorseFeatures が引く。無ければ既存表示に fallback。
                        const fsVenueCode = venueCodeFromName('nankan', (venueData.track || '').replace('競馬', '').trim());
                        const featureScoresData = loadFeatureScores('nankan', venueData.raceDate, fsVenueCode);

                        // データ正規化
                        const normalizedHorses = normalizeHorseData(raceData);
                        const raceHorses = normalizedHorses;

                        // 戦略データ取得（Free会員用は制限あり）
                        let raceStrategies;
                        if (raceData.strategies) {
                            raceStrategies = raceData.strategies;
                        } else {
                            const processedData = getPredictionDataWithStrategies(raceData.horses);
                            raceStrategies = processedData.strategies;
                        }

                        const accordionId = `race-v${venueIndex}-${raceNum}r`;
                        const toggleId = `toggle-v${venueIndex}-${raceNum}r`;
                        return (
                            <div class={`race-${raceNum}r-accordion`}>
                                <div class="race-accordion-header" onclick={`toggleNankanRace(${venueIndex}, ${raceNum})`}>
                                    <div class="race-basic-info">
                                        <span class="race-number">{raceData.raceNumber}</span>
                                        <span class="race-name">{(raceData.raceName || '競走名').replace(/\s*[ダ芝]\d+[,.]?\d*m.*$/, '').replace(/\s*（\d+頭）.*$/, '').replace(/\s*発走時刻.*$/, '')}</span>
                                        <span class="race-tier-badge">{`第${raceNum}レース`}</span>
                                        {isMainRace && <span class="main-race-badge">メインレース</span>}
                                    </div>
                                    <div class="race-preview">
                                        <span class="toggle-icon" id={toggleId}>▼</span>
                                    </div>
                                </div>

                                <div class="race-accordion-content" id={accordionId} style="max-height: 0; opacity: 0;">
                                    <div class={`race-content-${raceNum}r`}>

                                        <!-- レース詳細情報 -->
                                        <div class="race-details-info">
                                            {(() => {
                                                const raceName = raceData.raceName || '競走名';
                                                const distanceMatch = raceName.match(/[ダ芝]\s?(\d+[,.]?\d*)\s?m/);
                                                const horseCountMatch = raceName.match(/[（(](\d+)頭[）)]/);
                                                const startTimeMatch = raceName.match(/発走時刻\s?(\d+:\d+)/);

                                                const rawDistance = distanceMatch ? distanceMatch[0] : (raceData.raceInfo?.distance || null);
                                                const distance = (() => {
                                                    if (rawDistance == null || rawDistance === '') return null;
                                                    const s = String(rawDistance).replace(/㍍|メートル|ｍ|Ｍ/g, 'm').trim();
                                                    return /m$/i.test(s) ? s.replace(/M$/, 'm') : `${s}m`;
                                                })();
                                                const horseCount = horseCountMatch ? horseCountMatch[1] : (raceData.raceInfo?.horseCount || null);
                                                const startTime = startTimeMatch ? startTimeMatch[1] : (raceData.raceInfo?.startTime || null);

                                                let cleanRaceName = raceName
                                                    .replace(/\s*[ダ芝]\d+[,.]?\d*m.*$/, '')
                                                    .replace(/\s*[（(]\d+頭[）)].*$/, '')
                                                    .replace(/\s*発走時刻.*$/, '');

                                                return (
                                                    <>
                                                        <h3 class="race-detail-title">{raceData.raceNumber} {cleanRaceName}</h3>
                                                        <div class="race-detail-meta">
                                                            {distance && <span class="meta-item">📏 {distance}</span>}
                                                            {horseCount && <span class="meta-item">🐎 {horseCount}頭</span>}
                                                            {startTime && <span class="meta-item">🕐 発走時刻 {startTime}</span>}
                                                        </div>
                                                    </>
                                                );
                                            })()}
                                        </div>

                                        {/* 買い目セクション（開くとすぐ見える誘導。ダミー1本のモザイク・実データではない） */}
                                        <div class="betting-teaser">
                                            <div class="betting-teaser-head">
                                                <span class="betting-teaser-title">🎯 AI予測買い目</span>
                                                <span class="betting-teaser-lock">🔒 有料</span>
                                            </div>
                                            <div class="betting-teaser-line"><span class="betting-teaser-type">馬単</span><span class="betting-teaser-nums masked-eval">● → ●.●.●.●.●</span></div>
                                            <a href="/pricing/" class="unlock-btn unlock-btn-paid betting-teaser-btn">🚀 高性能AIの買い目を見る</a>
                                        </div>

                                        <!-- AI選出馬分析 -->
                                        <div class="analysis-section">
                                            <h2 class="section-title">
                                                <span>🤖</span>
                                                <span>AIモデル選出馬 - XGBoost×LSTM統合分析</span>
                                            </h2>

                                            {/* 無料表示: 全馬を馬番順で表示。本命◎/対抗○のみ実印。
                                                pt/AI総合指数/特徴量/役割はダミーモザイク（有料で解放）。抑え・不要馬も同列。 */}
                                            {(() => {
                                                const freeRows = buildFreePublicRows(raceHorses, {
                                                    resolveRecent: (h) => ((Array.isArray(h.recentRacesFromEntriesNankan) && h.recentRacesFromEntriesNankan.length > 0) ? h.recentRacesFromEntriesNankan : getDisplayRecentRacesForNankan(h)),
                                                });
                                                const renderCardBody = (row) => (
                                                    <>

                                                        <div class="horse-stats-row">
                                                            <div class="stat-block stat-score-block">
                                                                <div class="stat-label">累積スコア</div>
                                                                <div class="stat-value stat-score"><span class="masked-eval masked-num" aria-hidden="true">88</span><span class="stat-unit">pt</span></div>
                                                            </div>
                                                            <div class="stat-block stat-index-block">
                                                                <div class="stat-label">AI総合指数</div>
                                                                <div class="stat-value stat-index"><span class="masked-eval masked-num" aria-hidden="true">88</span></div>
                                                            </div>
                                                        </div>

                                                        {(row.ageGender || row.weight || row.jockey || row.trainer || row.frame != null || row.sire) && (
                                                            <div class="basic-info">
                                                                <h4>基本情報</h4>
                                                                <div class="info-grid">
                                                                    {(row.ageGender || row.weight) && (
                                                                        <div class="info-line info-line-primary">
                                                                            {row.ageGender && <span class="info-chip">{row.ageGender}</span>}
                                                                            {row.weight && <span class="info-chip">{row.weight}</span>}
                                                                        </div>
                                                                    )}
                                                                    {row.jockey && <div class="info-line"><span class="info-key">騎手</span><span class="info-val">{row.jockey}</span></div>}
                                                                    {row.trainer && <div class="info-line"><span class="info-key">調教師</span><span class="info-val">{row.trainer}</span></div>}
                                                                    {row.frame != null && <div class="info-line"><span class="info-key">枠番</span><span class="info-val">{row.frame}枠</span></div>}
                                                                    {row.sire && <div class="info-line"><span class="info-key">父</span><span class="info-val">{row.sire}</span></div>}
                                                                </div>
                                                            </div>
                                                        )}

                                                        {/* 評価ポイントは無料では非表示（有料限定） */}

                                                        <div class="feature-importance">
                                                            <h4>特徴量重要度</h4>
                                                            <div class="importance-list">
                                                                {['安定性', '能力上位性', '展開利'].map((label) => (
                                                                    <div class="importance-item">
                                                                        <span class="importance-label">{label}</span>
                                                                        <div class="importance-bar"><div class="importance-fill masked-eval" style="width: 62%"></div></div>
                                                                        <span class="importance-percent masked-eval" aria-hidden="true">88%</span>
                                                                    </div>
                                                                ))}
                                                            </div>
                                                        </div>

                                                        {row.recent.length > 0 && (
                                                            <details class="recent-races recent-races-compact" data-click-close="true">
                                                                <summary>過去{Math.min(5, row.recent.length)}走</summary>
                                                                <div class="recent-races-list">
                                                                    {row.recent.slice(-5).reverse().map((r, i) => {
                                                                        const rankRaw = r?.rank ?? r?.finish; const rank = (rankRaw != null && Number.isFinite(Number(rankRaw))) ? `${rankRaw}着` : (r?.finishStatus || '');
                                                                        return (
                                                                            <div class="recent-race-row recent-race-row-detail"><div class="recent-race-line recent-race-line-main">
                                                                                <span class="recent-race-label">{RECENT_LABELS[i]}</span>{r?.date && <span class="recent-race-meta">{r.date}</span>}
                                                                                <span class="recent-race-venue">{r?.venue || ''}</span>
                                                                                <span class="recent-race-distance">{r?.distance || ''}</span>{r?.trackCondition && <span class="recent-race-meta">{r.trackCondition}</span>}
                                                                                <span class="recent-race-rank">{rank}</span>{r?.popularity && <span class="recent-race-meta">{r.popularity}人気</span>}
                                                                                </div><div class="recent-race-line recent-race-line-performance">{r?.time && <span class="recent-race-meta">タイム{r.time}</span>}
                                                                                {r?.last3f && <span class="recent-race-meta recent-race-last3f">上がり{r.last3f}</span>}{r?.margin && <span class="recent-race-meta recent-race-margin">着差{r.margin}</span>}{r?.passingOrder && <span class="recent-race-meta recent-race-passing">通過{r.passingOrder}</span>}{r?.bodyWeight && <span class="recent-race-meta">馬体{r.bodyWeight}kg</span>}</div><div class="recent-race-line recent-race-line-meta">{r?.jockey && <span class="recent-race-meta">騎手:{r.jockey}</span>}{r?.carriedWeight && <span class="recent-race-meta">斤量{r.carriedWeight}</span>}{r?.raceName && <span class="recent-race-meta recent-race-name">{r.raceName}</span>}{r?.headCount && <span class="recent-race-meta">{r.headCount}頭</span>}</div>
                                                                            </div>
                                                                        );
                                                                    })}
                                                                </div>
                                                            </details>
                                                        )}
                                                        <NankanHorseStatsPanel horse={row._horse} />
                                                    </>
                                                );
                                                // 上位4頭=開いたカード。5番手以降=馬番＋馬名だけ見える折りたたみ。
                                                const renderFreeRow = (row) => (
                                                    <div class={`horse-card free-flat-card ${row.isHeadline ? 'free-flat-headline free-flat-' + row.headlineKind : ''}`}>
                                                        {row.headlineKind === 'main' && <div class="main-glow" aria-hidden="true"></div>}
                                                        <div class="horse-header">
                                                            <div class="horse-identity">
                                                                {row.isHeadline
                                                                    ? <span class={row.markClass}>{row.headlineMark}</span>
                                                                    : <span class="masked-eval masked-mark" aria-hidden="true">◦</span>}
                                                                <span class="horse-number">{row.number}</span>
                                                                <span class="horse-name">{row.name}</span>
                                                            </div>
                                                            <span class="masked-eval masked-role-badge" aria-label="役割は有料会員で公開">役割</span>
                                                        </div>
                                                        {renderCardBody(row)}
                                                    </div>
                                                );
                                                const renderCollapsedRow = (row) => (
                                                    <details class="horse-card free-flat-card free-flat-collapsed">
                                                        <summary class="free-flat-summary">
                                                            <span class="masked-eval masked-mark" aria-hidden="true">◦</span>
                                                            <span class="horse-number">{row.number}</span>
                                                            <span class="horse-name">{row.name}</span>
                                                            <span class="free-flat-chevron" aria-hidden="true">▾</span>
                                                        </summary>
                                                        <div class="free-flat-collapsed-body">
                                                            {renderCardBody(row)}
                                                        </div>
                                                    </details>
                                                );
                                                // 無登録は本命◎のみ表示。対抗○以下は無料登録で公開（unlock-content）。
                                                const headlineRows = freeRows.filter((r) => r.headlineKind === 'main');
                                                const restRows = freeRows.filter((r) => r.headlineKind !== 'main');
                                                return (
                                                    <>
                                                        {headlineRows.map(renderFreeRow)}
                                                        <div class="free-member-unlock-content" style="display: none;">
                                                            {restRows.map((row) => (row.isHeadline ? renderFreeRow(row) : renderCollapsedRow(row)))}
                                                        </div>
                                                    </>
                                                );
                                            })()}

                                            <!-- Free会員用アクセス制御（レース別） -->
                                            <div class="access-control-section">
                                                {/* 全頭解放 - 無料登録で本命◎以外も出走全頭を表示 */}
                                                <div class="locked-content">
                                                    <div class="lock-icon">🔐</div>
                                                    <h3>出走全頭を表示</h3>
                                                    {isMainRace ? (
                                                        <p>メインレース：登録ユーザーは全頭表示済み</p>
                                                    ) : (
                                                        <p>無料登録で本命◎以外の出走全頭も表示</p>
                                                    )}
                                                    <a href="/free-signup/" class="unlock-btn unlock-btn-free">無料登録で全頭解放</a>
                                                </div>

                                                {/* 買い目は全レース共通で有料会員で解放 */}
                                                <div class="locked-content">
                                                    <div class="lock-icon">🔐</div>
                                                    <h3>AI予測買い目</h3>
                                                    {isMainRace ? (
                                                        <p>メインレース戦略別買い目とAI予測値</p>
                                                    ) : (
                                                        <p>戦略別の具体的な買い目とAI予測値を提供</p>
                                                    )}
                                                    <a href="/pricing/" class="unlock-btn unlock-btn-paid">有料会員で解放</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>
        </section>
        ))}

        <!-- アーカイブリンク -->
        <div class="archive-link-section">
            <a href="/archive/nankan/" class="archive-link">
                <span class="archive-icon">📚</span>
                <span class="archive-text">過去の的中実績アーカイブを見る</span>
                <span class="archive-arrow">→</span>
            </a>
        </div>

        <!-- AI分析サマリー -->
        <div class="analysis-summary">
            <h4 style="color: #3b82f6; margin-bottom: 20px; margin-top: 30px; font-size: 1.2rem;">📊 重要指標</h4>
            <div class="key-indicators-grid">
                <div class="indicator-card">
                    <div class="indicator-icon">🎯</div>
                    <div class="indicator-label">展開予測精度</div>
                    <div class="indicator-value">{analysis?.keyIndicators?.accuracy || '85'}%</div>
                </div>
                <div class="indicator-card">
                    <div class="indicator-icon">📈</div>
                    <div class="indicator-label">過去類似レース</div>
                    <div class="indicator-value">{analysis?.keyIndicators?.similarRaces || '1,000以上'}</div>
                </div>
                <div class="indicator-card">
                    <div class="indicator-icon">🔒</div>
                    <div class="indicator-label">信頼区間</div>
                    <div class="indicator-value">{analysis?.keyIndicators?.confidenceInterval || '92'}%</div>
                </div>
                <div class="indicator-card">
                    <div class="indicator-icon">📊</div>
                    <div class="indicator-label">特徴量数</div>
                    <div class="indicator-value">{analysis?.keyIndicators?.featureCount || '150+'}</div>
                </div>
            </div>
        </div>

        <!-- AI予想の技術的背景 -->
        <div class="analysis-section" style="opacity: 1; transform: translateY(0px); transition: opacity 0.6s ease 0s, transform 0.6s ease 0s;">
            <h2 class="section-title">
                <span>🔬</span>
                <span>AI予想の技術的背景</span>
            </h2>

            <h3 style="color:#8b5cf6;margin-bottom:15px">使用モデル</h3>

            <div style="margin-bottom:20px">
