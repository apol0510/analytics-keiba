---
/**
 * /free-prediction/nankan/ — Premium の体験プレビュー（ショールーム）
 *
 * 2026-10-04 MK 確定（docs/PREDICTION_ACQUISITION.md §2-4）:
 *   /free/ = 無料の日常利用 ／ /free-prediction/ = Premium 体験 ／ /predictions/ = Premium 本利用
 *   Premium と同一デザイン・同一部品（PremiumRaceBoard mode="preview"）。違いは権限状態と CTA だけ。
 *   一覧には出走情報しか渡さない（買い目・AI 総合指数・役割は描画しない）。
 *   公開ページ（Cookie・会員判定を使わない）なので SSR ＋ CDN 5 分キャッシュ（/free/ と同じ）。
 */
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import PremiumRaceBoard from '../../components/acquisition/PremiumRaceBoard.astro';
import ResultsShowcaseBanner from '../../components/ResultsShowcaseBanner.astro';
import '../../styles/acquisitionGlass.css';
import { buildListModel } from '../../lib/acquisition/listModel.js';
import { setPublicCdnCache } from '../../lib/cdnCache.mjs';

let model = { date: null, dates: [], venues: [] };
try {
  model = buildListModel({ cat: 'nankan', product: 'premium', requestedDate: Astro.url.searchParams.get('date'), acquisitions: [] });
} catch (error) {
  console.error('[free-prediction/nankan] build error:', error);
}
setPublicCdnCache(Astro);
---
<BaseLayout
  title="南関競馬 AI予想プレビュー - KEIBA Analytics"
  description="KEIBA Analytics 南関東競馬の Premium 予想プレビュー。Premium ではこの画面から気になるレースの予想を 1 件ずつ取得できます。AI予測買い目・AI総合指数・役割は Premium で公開しています。"
>
  <div class="fp-page">
    <PremiumRaceBoard mode="preview" venue="nankan" model={model} basePath="/free-prediction/nankan/" />
    <!-- 穴馬ページリンク（旧プレビューから継続） -->
    <div class="dark-horse-link-section">
      <a href="/dark-horse-picks/?category=nankan" class="dark-horse-link-btn">
        <span class="dark-horse-icon">🐎</span>
        <div class="dark-horse-text">
          <span class="dark-horse-title">本日の穴馬抽出ツール</span>
          <span class="dark-horse-subtitle">AI予想から狙い目の穴馬を自動抽出</span>
        </div>
        <span class="dark-horse-arrow">→</span>
      </a>
    </div>
    <nav class="ag-glass fp-links" aria-label="関連ページ">
      <a href="/free-prediction/nankan/archive/">過去の予想と結果（南関）</a>
      <a href="/pricing/">Premium のプランを見る</a>
      <a href="/free/nankan/">無料予想（毎日の AI 印）を見る</a>
    </nav>
    <ResultsShowcaseBanner category="nankan" />
  </div>
</BaseLayout>

<style>
  .fp-page { max-width: 1240px; margin: 0 auto; padding: 0 12px 48px; display: grid; gap: 16px; }
  .fp-links { display: flex; flex-wrap: wrap; gap: 8px 18px; padding: 14px 16px; }
  .fp-links a { color: #bae6fd; font-weight: 700; text-decoration: none; min-height: 40px; display: inline-flex; align-items: center; }
    .dark-horse-link-section {
      margin-bottom: 30px;
    }

    .dark-horse-link-btn {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(245, 158, 11, .08);
      border: 1px solid rgba(245, 158, 11, .28);
      border-radius: 12px;
      padding: 14px 18px;
      text-decoration: none;
      transition: background .2s ease, border-color .2s ease;
      cursor: pointer;
    }

    .dark-horse-link-btn:hover {
      background: rgba(245, 158, 11, .14);
      border-color: rgba(245, 158, 11, .45);
    }

    .dark-horse-icon {
      font-size: 1.35rem;
      flex-shrink: 0;
    }

    .dark-horse-text {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }

    .dark-horse-title {
      color: #fbbf24;
      font-size: .95rem;
      font-weight: 600;
      line-height: 1.2;
    }

    .dark-horse-subtitle {
      color: rgba(226, 232, 240, .65);
      font-size: .8rem;
      line-height: 1.3;
    }

    .dark-horse-arrow {
      color: rgba(251, 191, 36, .85);
      font-size: 1.05rem;
      font-weight: 600;
      transition: transform 0.3s ease;
      flex-shrink: 0;
    }

    .dark-horse-link-btn:hover .dark-horse-arrow {
      transform: translateX(5px);
    }
    @media (max-width: 768px) {
      .dark-horse-link-btn {
        padding: 12px 14px;
        gap: 12px;
      }

      .dark-horse-icon {
        font-size: 1.15rem;
      }

      .dark-horse-title {
        font-size: .9rem;
      }

      .dark-horse-subtitle {
        font-size: .78rem;
      }

      .dark-horse-arrow {
        font-size: 1.3rem;
      }
    }

</style>
