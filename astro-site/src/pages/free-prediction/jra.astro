    .ineligible-summary::-webkit-details-marker { display: none; }
    .ineligible-summary::before {
      content: '▶';
      display: inline-block;
      color: #94a3b8;
      font-size: 0.85rem;
      transition: transform 0.2s ease;
    }
    details.minor-group-ineligible[open] > .ineligible-summary::before { transform: rotate(90deg); }
    .ineligible-summary-icon {
      display: inline-block;
      width: 26px;
      height: 26px;
      line-height: 26px;
      text-align: center;
      border-radius: 50%;
