      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
    }

    .race-btn.active {
      background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
      border-color: var(--primary-end);
      color: white;
      box-shadow: 0 4px 16px rgba(59, 130, 246, 0.4);
    }

    .race-label {
      font-size: 1rem;
      font-weight: 800;
    }

    .race-indicator {
      width: 20px;
      height: 2px;
      background: var(--border-color);
      border-radius: 1px;
      transition: all 0.3s;
    }

    .race-btn.active .race-indicator {
      background: white;
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
    }

    /* レース表示 */
    .race-display-area {
      position: relative;
      min-height: 500px;
    }

    .race-content {
      display: none;
    }

    .race-content.active {
      display: block;
      animation: fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .race-name-header {
      text-align: center;
      margin-bottom: var(--spacing-xl);
      padding: var(--spacing-lg);
      background: linear-gradient(135deg,
        rgba(139, 92, 246, 0.15) 0%,
        rgba(59, 130, 246, 0.15) 100%);
      border-radius: var(--radius-lg);
      border: 2px solid rgba(139, 92, 246, 0.3);
    }

    .race-name-title {
      font-size: 1.5rem;
      font-weight: 800;
      color: #a78bfa;
      margin: 0 0 var(--spacing-md) 0;
      text-shadow: 0 0 10px rgba(167, 139, 250, 0.3);
      letter-spacing: 0.5px;
    }

    .race-details {
      display: flex;
      justify-content: center;
      gap: var(--spacing-lg);
      flex-wrap: wrap;
      margin-top: var(--spacing-md);
    }

    .race-detail-item {
      font-size: 0.95rem;
      color: #94a3b8;
      font-weight: 600;
      padding: var(--spacing-xs) var(--spacing-md);
      background: rgba(30, 41, 59, 0.5);
      border-radius: var(--radius-md);
      border: 1px solid rgba(139, 92, 246, 0.2);
    }

    .analysis-section {
      background: var(--bg-secondary);
      padding: var(--spacing-xl);
      border-radius: var(--radius-lg);
      margin-bottom: var(--spacing-xl);
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
      margin-bottom: var(--spacing-lg);
    }

    .header-icon {
      font-size: 1.5rem;
      filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.5));
    }

    .section-header h2 {
      font-size: 1.25rem;
      color: #60a5fa;
      font-weight: 800;
    }

    /* 旧 KI 風カード・metrics・特徴量バー系の dead CSS は PR-F1 で完全削除。
       JSX で参照する要素は存在しなかったため画面影響なし。
       詳細: astro-site/docs/FREE_JRA_RULES.md / scripts/check-no-ki-relics-free-jra.mjs */
    .candidate-badge {
      position: absolute;
      top: var(--spacing-md);
      left: var(--spacing-md);
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.3) 0%, rgba(167, 139, 250, 0.3) 100%);
      color: #a78bfa;
      font-weight: 600;
      font-size: 0.95rem;
      padding: var(--spacing-xs) var(--spacing-md);
      border-radius: var(--radius-md);
      border: 1px solid rgba(139, 92, 246, 0.5);
      z-index: 1;
    }

    /* アップグレードCTAボックス */
    .upgrade-cta-box {
      background: linear-gradient(135deg, rgba(251, 191, 36, 0.1) 0%, rgba(245, 158, 11, 0.1) 100%);
      border: 2px solid #fbbf24;
      border-radius: var(--radius-lg);
      padding: var(--spacing-xl);
      text-align: center;
      margin: var(--spacing-xl) 0;
      box-shadow: 0 0 20px rgba(251, 191, 36, 0.2);
    }

    .upgrade-icon {
      font-size: 3rem;
      margin-bottom: var(--spacing-md);
      filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.5));
    }

    .upgrade-cta-box h3 {
      font-size: 1.5rem;
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: var(--spacing-md);
      font-weight: 800;
    }

    .upgrade-cta-box p {
      color: var(--text-secondary);
      margin-bottom: var(--spacing-lg);
      line-height: 1.6;
      font-size: 1.05rem;
    }

    .upgrade-benefits-mini {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: var(--spacing-lg);
    }

    .upgrade-benefits-mini span {
      padding: var(--spacing-xs) var(--spacing-md);
      background: rgba(251, 191, 36, 0.15);
      border: 1px solid rgba(251, 191, 36, 0.3);
      border-radius: var(--radius-md);
      font-size: 0.9rem;
      font-weight: 600;
      color: #fbbf24;
    }

    /* 無料マスク（ダミーモザイク: うっすら見えそうで読めない）。有料で解放される演出。 */
    /* 5番手以降: 馬番＋馬名だけ見える折りたたみカード */
    .free-flat-collapsed { padding: 0; overflow: hidden; }
    .free-flat-collapsed > .free-flat-summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 10px; padding: 12px 14px; }
    .free-flat-collapsed > .free-flat-summary::-webkit-details-marker { display: none; }
    .free-flat-summary .horse-number { font-weight: 700; min-width: 1.6em; text-align: center; }
    .free-flat-summary .horse-name { font-weight: 700; flex: 1; }
    .free-flat-chevron { color: #94a3b8; transition: transform 0.2s ease; }
    .free-flat-collapsed[open] .free-flat-chevron { transform: rotate(180deg); }
    .free-flat-collapsed-body { padding: 0 14px 14px; }

    .masked-eval {
      filter: blur(3px);
      opacity: 0.6;
      -webkit-user-select: none;
      user-select: none;
      pointer-events: none;
      letter-spacing: 1px;
      color: #cbd5e1;
    }
    .masked-num {
      /* stat-score/stat-index の gradient text(transparent) を上書きして「うっすら見える」ようにする */
      -webkit-text-fill-color: #e2e8f0 !important;
      color: #e2e8f0;
      background: none;
      -webkit-background-clip: initial;
      background-clip: initial;
      font-weight: 800;
    }
    /* 🛡️ モザイクを無効化しないための必須ルール（2026-07-31 本番不具合の恒久対策）
       .stat-score / .stat-index は `background-clip: text` + `-webkit-text-fill-color: transparent`
       で gradient 文字を描く。この**親が同じ文字をクリップして描画する**ため、子 span に
       filter: blur() を掛けても「ぼけた文字の下に鮮明な gradient 文字が残り」マスクが破れる。
       子側の -webkit-text-fill-color 上書き（.masked-num）だけでは親の描画は消せない。
       → マスク表示のときは親の gradient 文字を使わず、通常のテキスト描画へ戻す。
       ⚠️ .stat-score/.stat-index と同じ詳細度だと定義順に依存するため、
          必ず 2 クラス（.stat-value.stat-value-masked）で上書きすること。 */
    .stat-value.stat-value-masked {
      background: none;
      -webkit-background-clip: initial;
      background-clip: initial;
      -webkit-text-fill-color: currentColor;
      color: #cbd5e1;
    }
    .masked-role-badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.18);
    }
    .importance-fill.masked-eval {
      filter: blur(3px);
      opacity: 0.3;
      background: linear-gradient(90deg, #34d399, #6366f1);
    }
    .importance-percent.masked-eval { color: #94a3b8; }

    /* 買い目ロック（ブラープレビュー版） */
    .locked-section {
      position: relative;
      background: linear-gradient(135deg,
        rgba(245, 158, 11, 0.05) 0%,
        rgba(251, 191, 36, 0.05) 100%);
      padding: var(--spacing-lg) var(--spacing-xl);
      border-radius: var(--radius-lg);
      min-height: 300px;
      border: 2px solid rgba(245, 158, 11, 0.3);
      box-shadow:
        0 4px 6px rgba(0, 0, 0, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
      overflow: hidden;
      margin-bottom: var(--spacing-xl);
    }

    /* ブラーされたコンテンツ */
    .blurred-preview .blurred-content {
      filter: blur(8px);
      opacity: 0.6;
      user-select: none;
      pointer-events: none;
    }

    .betting-preview-card {
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid rgba(100, 116, 139, 0.3);
      border-radius: var(--radius-md);
      padding: var(--spacing-lg);
    }

    .betting-preview-card h4 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: var(--spacing-md);
      color: var(--text-primary);
    }

    .betting-formula-preview {
      margin-bottom: var(--spacing-lg);
    }

    .betting-formula-preview .main-line,
    .betting-formula-preview .backup-line {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
      padding: var(--spacing-md);
      background: rgba(59, 130, 246, 0.1);
      border-radius: var(--radius-sm);
      margin-bottom: var(--spacing-sm);
    }

    .betting-formula-preview .label {
      font-weight: 700;
      color: var(--color-accent);
      min-width: 60px;
    }

    .betting-formula-preview .formula {
      font-family: 'Courier New', monospace;
      font-size: 1.125rem;
      color: var(--text-primary);
      font-weight: 700;
    }

    .betting-info-preview {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-md);
    }

    .betting-info-preview .info-item {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .betting-info-preview .label {
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    .betting-info-preview .value {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-accent);
    }

    .lock-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(10px) saturate(180%);
      -webkit-backdrop-filter: blur(10px) saturate(180%);
      text-align: center;
      padding: var(--spacing-xl);
      max-width: 600px;
      margin: 0 auto;
      padding: var(--spacing-lg);
    }

    .lock-icon {
      font-size: 2.5rem;
      margin-bottom: var(--spacing-md);
      opacity: 0.7;
      filter: drop-shadow(0 0 10px rgba(245, 158, 11, 0.3));
    }

    .lock-overlay h3 {
      font-size: 1.25rem;
      font-weight: 800;
      color: #fbbf24;
      margin-bottom: var(--spacing-sm);
      text-shadow: 0 0 10px rgba(251, 191, 36, 0.3);
    }

    .lock-overlay p {
      color: var(--text-secondary);
      margin-bottom: var(--spacing-lg);
      line-height: 1.5;
      font-size: 0.9375rem;
    }

    .lock-buttons {
      display: flex;
      gap: var(--spacing-md);
      justify-content: center;
      flex-wrap: wrap;
      z-index: 10;
      position: relative;
    }

    .lock-buttons .btn {
      min-width: 160px;
    }

    /* CTA */
    .error-card {
      text-align: center;
      padding: var(--spacing-2xl);
      background: var(--bg-secondary);
      border-radius: var(--radius-lg);
      border: 1px solid rgba(239, 68, 68, 0.5);
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* レスポンシブ */
    @media (max-width: 1024px) {
      .upgrade-benefits {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .page-title {
        font-size: 1.5rem;
      }

      .cta-buttons {
        flex-direction: column;
      }

      .upgrade-benefits {
        grid-template-columns: 1fr;
      }

      .upgrade-benefits-mini {
        gap: var(--spacing-sm);
      }

      .upgrade-benefits-mini span {
        font-size: 0.8rem;
        padding: 4px var(--spacing-sm);
      }
    }

    /* ======================================================
       JRA レースアコーディオン（南関版相当の縦一覧）
       ====================================================== */
    .jra-race-accordion-list {
      display: grid;
      gap: 10px;
      margin-top: 8px;
    }
    .jra-race-accordion {
      background: rgba(16, 185, 129, 0.05);
      border-radius: 14px;
      border: 1px solid rgba(16, 185, 129, 0.22);
      overflow: hidden;
      transition: border-color 0.25s ease, transform 0.25s ease;
    }
    .jra-race-accordion:hover {
      border-color: rgba(16, 185, 129, 0.4);
    }
    .jra-race-accordion-header {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.10) 0%, rgba(16, 185, 129, 0.04) 100%);
      border: none;
      cursor: pointer;
      text-align: left;
      color: inherit;
      font: inherit;
      transition: background 0.25s ease;
    }
    .jra-race-accordion-header:hover {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.18) 0%, rgba(16, 185, 129, 0.08) 100%);
    }
    .jra-race-accordion-header[aria-expanded="true"] {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.22) 0%, rgba(59, 130, 246, 0.10) 100%);
      border-bottom: 1px solid rgba(16, 185, 129, 0.25);
    }
    .jra-race-head-left {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
      flex: 1;
    }
    .jra-race-num {
      flex-shrink: 0;
      background: linear-gradient(135deg, #8b5cf6, #7c3aed);
      color: white;
      padding: 8px 14px;
      border-radius: 10px;
      font-weight: 800;
      font-size: 1.05rem;
      letter-spacing: 0.02em;
      box-shadow: 0 2px 8px rgba(139, 92, 246, 0.35);
    }
    .jra-race-meta {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }
    .jra-race-name {
      color: #e2e8f0;
      font-weight: 700;
      font-size: 1.05rem;
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .jra-race-meta-line {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      color: #94a3b8;
      font-size: 0.82rem;
    }
    .jra-race-meta-item {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .jra-race-toggle {
      flex-shrink: 0;
      font-size: 1.1rem;
      color: #10b981;
      transition: transform 0.3s ease;
      width: 24px;
      text-align: center;
    }
    .jra-race-accordion-content {
      overflow: hidden;
      transition: max-height 0.4s ease, opacity 0.3s ease;
      background: rgba(15, 23, 42, 0.95);
    }
    .jra-race-accordion-body {
      padding: 18px 16px 20px;
    }
    @media (max-width: 768px) {
      .jra-race-accordion-header {
        padding: 12px 14px;
        gap: 10px;
      }
      .jra-race-head-left { gap: 10px; }
      .jra-race-num { padding: 6px 10px; font-size: 0.95rem; }
      .jra-race-name { font-size: 0.98rem; white-space: normal; }
      .jra-race-meta-line { font-size: 0.78rem; gap: 4px 10px; }
      .jra-race-accordion-body { padding: 14px 12px 16px; }
    }

    /* ======================================================
       南関版と統一: ヘッダー & アクセス制御
       ====================================================== */
    .header-section {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%);
      padding: 30px;
      border-radius: 12px;
      margin-bottom: 30px;
      border: 1px solid rgba(59, 130, 246, 0.2);
      text-align: center;
    }
    .race-title {
      font-size: 2rem;
      font-weight: 800;
      background: linear-gradient(135deg, #8b5cf6 0%, #3b82f6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin: 0;
    }
    .header-section .ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(16, 185, 129, 0.3) 100%);
      padding: 6px 16px;
      border-radius: 20px;
      border: 1px solid rgba(16, 185, 129, 0.3);
      margin-bottom: 15px;
    }
    .header-section .pulse {
      width: 8px;
      height: 8px;
      background: #ef4444;
      border-radius: 50%;
      animation: jra-header-pulse 2s infinite;
    }
    @keyframes jra-header-pulse {
      0%, 100% { opacity: 1; }
      50%      { opacity: 0.5; }
    }
    .header-section .ai-status {
      color: #10b981;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .access-control-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 30px;
      padding: 20px;
      background: rgba(30, 41, 59, 0.3);
      border-radius: 12px;
      border: 1px solid rgba(100, 116, 139, 0.2);
    }
    .locked-content {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(236, 72, 153, 0.1) 100%);
      border: 2px solid rgba(139, 92, 246, 0.3);
      border-radius: 12px;
      padding: 25px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
    }

    /* CTA は有料 1 枚のみ（2026-08-20: 無料登録解放 CTA を撤廃） */
    .locked-content { position: relative; gap: 12px; padding: 26px 22px 22px; }
    .cta-badge { position: absolute; top: -11px; left: 50%; transform: translateX(-50%); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.5px; padding: 4px 14px; border-radius: 999px; white-space: nowrap; }
    .cta-badge-paid { background: linear-gradient(135deg, #fbbf24, #f59e0b); color: #3a2400; box-shadow: 0 2px 10px rgba(245,158,11,0.4); }
    .cta-icon { font-size: 2.1rem; line-height: 1; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.4)); }
    .cta-benefits { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; width: 100%; text-align: left; }
    .cta-benefits li { position: relative; padding-left: 24px; font-size: 0.86rem; color: #e2e8f0; line-height: 1.4; }
    .cta-benefits li::before { content: '✓'; position: absolute; left: 4px; top: 0; font-weight: 900; }
    .locked-paid { background: linear-gradient(160deg, rgba(139,92,246,0.16) 0%, rgba(245,158,11,0.06) 60%, rgba(15,23,42,0.6) 100%); border-color: rgba(245,158,11,0.4); box-shadow: 0 0 24px rgba(139,92,246,0.12); }
    .locked-paid h3 { color: #c4b5fd; font-size: 1.18rem; font-weight: 800; }
    .locked-paid .cta-benefits li::before { color: #fbbf24; }
    .unlock-btn { padding: 12px 22px; font-weight: 700; font-size: 0.95rem; margin-top: 4px; }
    .unlock-btn-free { box-shadow: 0 3px 12px rgba(16,185,129,0.35); }
    .unlock-btn-paid { box-shadow: 0 3px 14px rgba(139,92,246,0.4); }

    /* 連下・抑え（minor-horse-card 系） — premium-prediction 共通CSSと統一 */
    .horse-card-minor {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(30, 41, 59, 0.9) 100%);
      border-radius: 14px;
      padding: 18px 18px;
      border: 1px solid rgba(148, 163, 184, 0.2);
      margin-top: 16px;
    }
    .horse-mark-minor {
      font-size: 1.3rem;
      color: #f59e0b;
      font-weight: 900;
      margin-right: 10px;
    }
    .minor-group-title { margin-left: 10px; font-weight: 600; }
    .minor-group-title-renka { color: #f59e0b; }
    .minor-group-title-osae { color: #94a3b8; }
    .minor-group-osae .horse-mark-minor { color: #94a3b8; }

    .minor-horse-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 12px;
      margin-top: 8px;
    }
    .minor-horse-card {
      background: rgba(15, 23, 42, 0.7);
      border-radius: 10px;
      padding: 12px 14px;
      border: 1px solid rgba(100, 116, 139, 0.25);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .minor-horse-card-renka {
      border-color: rgba(245, 158, 11, 0.35);
      background: linear-gradient(180deg, rgba(245, 158, 11, 0.04), rgba(15, 23, 42, 0.7));
    }
    .minor-horse-card-osae { border-color: rgba(100, 116, 139, 0.3); }

    /* 不要馬セクション — 南関 premium ineligible-section と同様の折りたたみ表示
       horse-card 系の派手な背景は継承させず、視認できるグレー枠で独立表示する */
    details.minor-group-ineligible {
      margin-top: 24px;
      background: rgba(15, 23, 42, 0.75);
      border: 1px solid rgba(148, 163, 184, 0.35);
      border-radius: 14px;
      padding: 14px 18px;
    }
    .ineligible-summary {
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      gap: 10px;
      color: #e2e8f0;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 4px 0;
