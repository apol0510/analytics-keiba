      color: #cbd5e1;
      font-weight: 700;
      font-size: 0.85rem;
    }
    .ineligible-summary-title { color: #e2e8f0; }
    details.minor-group-ineligible[open] .minor-horse-grid { margin-top: 12px; }
    .minor-horse-card-ineligible {
      border-color: rgba(100, 116, 139, 0.3);
      background: rgba(15, 23, 42, 0.55);
      opacity: 0.9;
    }
    .minor-horse-card-ineligible .minor-horse-mark { color: #94a3b8; font-weight: 600; }
    .minor-horse-card-ineligible .minor-horse-score {
      color: #94a3b8;
      background: rgba(100, 116, 139, 0.15);
      border-color: rgba(100, 116, 139, 0.3);
