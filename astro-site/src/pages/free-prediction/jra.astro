    .minor-horse-head {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .minor-horse-mark { color: #f59e0b; font-weight: 700; font-size: 1rem; }
    .minor-horse-card-osae .minor-horse-mark { color: #94a3b8; }
    .minor-horse-number {
      background: linear-gradient(135deg, #6b7280, #4b5563);
      color: white;
      padding: 2px 8px;
      border-radius: 5px;
      font-weight: 700;
      font-size: 0.85rem;
      min-width: 26px;
      text-align: center;
    }
    .minor-horse-name {
      color: #e2e8f0;
      font-weight: 600;
      font-size: 0.95rem;
      flex: 1;
    }
    .minor-horse-score {
      color: #10b981;
      font-weight: 700;
      background: rgba(16, 185, 129, 0.1);
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid rgba(16, 185, 129, 0.3);
      font-size: 0.8rem;
    }
    .minor-horse-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 12px;
      color: #cbd5e1;
      font-size: 0.82rem;
    }
    .minor-horse-meta .meta-key { color: #64748b; margin-right: 4px; font-size: 0.75rem; }
    .minor-horse-evals { display: flex; flex-wrap: wrap; gap: 5px; }
    .eval-tag-small {
      background: rgba(59, 130, 246, 0.12);
      color: #93c5fd;
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 999px;
      padding: 2px 8px;
      font-size: 0.72rem;
    }
    .minor-horse-importance { color: #94a3b8; font-size: 0.78rem; }

    /* 過去走（折りたたみ） */
    .recent-races {
      margin-top: 12px;
      background: rgba(15, 23, 42, 0.5);
      border-radius: 8px;
      padding: 8px 12px;
      border: 1px solid rgba(100, 116, 139, 0.2);
    }
    .recent-races > summary {
      cursor: pointer;
      color: #cbd5e1;
      font-weight: 600;
      font-size: 0.88rem;
      list-style: none;
    }
    .recent-races > summary::-webkit-details-marker { display: none; }
    .recent-races > summary::before {
      content: '▶';
      display: inline-block;
      margin-right: 8px;
      color: #64748b;
      font-size: 0.7rem;
      transition: transform 0.2s ease;
    }
    .recent-races[open] > summary::before { transform: rotate(90deg); }
    .recent-races-list {
      margin-top: 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .recent-race-row {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 12px;
      align-items: baseline;
      font-size: 0.78rem;
      color: #cbd5e1;
      padding: 4px 6px;
      background: rgba(30, 41, 59, 0.4);
      border-radius: 4px;
    }
    .recent-race-label { color: #94a3b8; font-size: 0.7rem; min-width: 3em; }
    .recent-race-venue { color: #e2e8f0; font-weight: 600; }
    .recent-race-distance { color: #cbd5e1; }
    .recent-race-rank { color: #10b981; font-weight: 700; }
    .recent-race-meta { color: #94a3b8; font-size: 0.75rem; }
    .recent-races-compact .recent-race-row { font-size: 0.72rem; }
    @media (max-width: 640px) {
      .minor-horse-grid { grid-template-columns: 1fr; }
    }
    .lock-icon { font-size: 2rem; opacity: 0.8; }
    .locked-content h3 {
      color: #8b5cf6;
      font-weight: 600;
      font-size: 1.1rem;
      margin: 0;
    }
    .locked-content p {
      color: #cbd5e1;
      font-size: 0.9rem;
      margin: 0;
      opacity: 0.8;
    }
    .unlock-btn {
      padding: 10px 20px;
      border-radius: 20px;
      text-decoration: none;
      font-weight: 500;
      font-size: 0.9rem;
      transition: all 0.3s ease;
      display: inline-block;
    }
    .unlock-btn-free {
      background: linear-gradient(135deg, #10b981, #22c55e);
      color: white;
    }
    .unlock-btn-free:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }
    /* 買い目セクション誘導（開くとすぐ見える。ダミー1本をモザイク＝実データではない） */
    .betting-teaser { margin: 4px 0 14px; padding: 12px 14px; border: 1px solid rgba(99, 102, 241, 0.35); border-radius: 12px; background: linear-gradient(135deg, rgba(99, 102, 241, 0.10), rgba(139, 92, 246, 0.06)); }
    .betting-teaser-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
    .betting-teaser-title { font-size: 1rem; font-weight: 800; color: #c7d2fe; }
    .betting-teaser-lock { font-size: 0.72rem; font-weight: 700; color: #a5b4fc; }
    .betting-teaser-line { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 10px; }
    .betting-teaser-type { font-size: 0.75rem; font-weight: 700; padding: 2px 10px; border-radius: 4px; background: rgba(99, 102, 241, 0.28); color: #c7d2fe; }
    .betting-teaser-nums { font-size: 1.2rem; font-weight: 800; letter-spacing: 2px; color: #e2e8f0; }
    .betting-teaser-btn { display: block; text-align: center; }

    .unlock-btn-paid {
      background: linear-gradient(135deg, #8b5cf6, #ec4899);
      color: white;
    }
    .unlock-btn-paid:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
    }
    @media (max-width: 768px) {
      .access-control-section {
        grid-template-columns: 1fr;
        gap: 15px;
      }
      .race-title { font-size: 1.5rem; }
    }

    /* ======================================================
       南関版と統一: 馬カードデザイン
       ====================================================== */
    .analysis-section .section-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: #3b82f6;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .horse-card {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, rgba(139, 92, 246, 0.05) 100%);
      padding: 20px;
      border-radius: 14px;
      margin-bottom: 18px;
      border: 1px solid rgba(59, 130, 246, 0.2);
      position: relative;
      overflow: hidden;
    }
    .horse-card-tana {
      padding: 22px;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.06) 0%, rgba(139, 92, 246, 0.06) 100%);
      border: 1.5px solid rgba(245, 158, 11, 0.28);
    }
    .horse-card-main {
      padding: 28px;
      background: linear-gradient(135deg,
        rgba(16, 185, 129, 0.18) 0%,
        rgba(34, 197, 94, 0.14) 45%,
        rgba(59, 130, 246, 0.16) 100%);
      border: 2px solid transparent;
      background-clip: padding-box;
      box-shadow:
        0 0 0 1.5px rgba(16, 185, 129, 0.55),
        0 8px 28px rgba(16, 185, 129, 0.28),
        0 0 60px rgba(16, 185, 129, 0.18) inset;
      position: relative;
    }
    .horse-card-main::before {
      content: "";
      position: absolute;
      inset: -2px;
      border-radius: 16px;
      padding: 2px;
      background: linear-gradient(135deg, #10b981 0%, #22c55e 35%, #3b82f6 70%, #8b5cf6 100%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
              mask-composite: exclude;
      pointer-events: none;
      z-index: 0;
    }
    .horse-card-main > * { position: relative; z-index: 1; }

    .main-glow {
      position: absolute;
      top: -40%;
      left: -10%;
      width: 60%;
      height: 180%;
      background: radial-gradient(closest-side, rgba(16, 185, 129, 0.28), transparent 70%);
      filter: blur(20px);
      pointer-events: none;
      z-index: 0;
      animation: jra-main-glow-pulse 3.6s ease-in-out infinite;
    }
    @keyframes jra-main-glow-pulse {
      0%, 100% { opacity: 0.55; transform: translateX(0); }
      50%      { opacity: 0.95; transform: translateX(8%); }
    }

    .horse-card-sub {
      padding: 24px;
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.12) 0%, rgba(139, 92, 246, 0.12) 100%);
      border: 1.5px solid rgba(59, 130, 246, 0.45);
      box-shadow: 0 4px 18px rgba(59, 130, 246, 0.18);
    }

    .horse-mark-main {
      display: inline-block;
      font-size: 2.4rem;
      color: #10b981;
      font-weight: 900;
      margin-right: 12px;
      text-shadow:
        0 0 10px rgba(16, 185, 129, 0.7),
        0 0 22px rgba(16, 185, 129, 0.45);
      line-height: 1;
      vertical-align: middle;
    }
    .horse-mark-sub {
      display: inline-block;
      font-size: 1.7rem;
      color: #3b82f6;
      font-weight: 800;
      margin-right: 10px;
      text-shadow: 0 0 8px rgba(59, 130, 246, 0.45);
      line-height: 1;
      vertical-align: middle;
    }
    .horse-mark-tana {
      display: inline-block;
      font-size: 1.55rem;
      color: #f59e0b;
      font-weight: 800;
      margin-right: 10px;
      text-shadow: 0 0 8px rgba(245, 158, 11, 0.45);
      line-height: 1;
      vertical-align: middle;
    }

    .horse-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
      gap: 10px;
    }
    .horse-identity {
      display: flex;
      align-items: center;
      gap: 4px;
      flex-wrap: wrap;
    }
    .horse-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      background: linear-gradient(135deg, #8b5cf6, #6366f1);
      color: white;
      border-radius: 50%;
      font-weight: 800;
      font-size: 1rem;
      margin-right: 10px;
      box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
    }
    .horse-card-main .horse-number {
      width: 40px;
      height: 40px;
      font-size: 1.15rem;
      background: linear-gradient(135deg, #10b981, #22c55e);
      box-shadow:
        0 0 0 2px rgba(255, 255, 255, 0.08),
        0 4px 14px rgba(16, 185, 129, 0.55);
    }
    .horse-card-sub .horse-number {
      width: 36px;
      height: 36px;
    }
    .horse-name {
      font-size: 1.2rem;
      font-weight: 700;
      color: #e2e8f0;
    }
    .horse-card-main .horse-name {
      font-size: 1.45rem;
      font-weight: 900;
      color: #f0fdf4;
      text-shadow: 0 1px 6px rgba(16, 185, 129, 0.35);
    }

    .role-badge {
      display: inline-block;
      padding: 5px 14px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    .role-badge-main {
      background: linear-gradient(135deg, #10b981 0%, #22c55e 100%);
      color: #052e1a;
      box-shadow: 0 2px 10px rgba(16, 185, 129, 0.45);
    }
    .role-badge-sub {
      background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
      color: white;
      box-shadow: 0 2px 8px rgba(59, 130, 246, 0.35);
    }
    .role-badge-tana {
      background: linear-gradient(135deg, #f59e0b 0%, #fb923c 100%);
      color: #2a1500;
      box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);
    }

    .horse-stats-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 18px;
      margin-bottom: 18px;
    }
    .stat-block {
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 10px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .horse-card-main .stat-block {
      background: rgba(15, 23, 42, 0.6);
      border-color: rgba(16, 185, 129, 0.35);
    }
    .horse-card-sub .stat-block {
      border-color: rgba(59, 130, 246, 0.3);
    }
    .stat-label {
      font-size: 0.78rem;
      color: #94a3b8;
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .stat-value {
      font-size: 1.6rem;
      font-weight: 900;
      line-height: 1;
      color: #e2e8f0;
    }
    .stat-score {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .stat-index {
      background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .stat-unit {
      font-size: 0.8rem;
      font-weight: 700;
      margin-left: 4px;
      -webkit-text-fill-color: #f59e0b;
    }

    .star-rating {
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
      line-height: 1;
      flex-wrap: wrap;
    }
    .star-row {
      display: inline-flex;
      align-items: center;
      gap: 2px;
      line-height: 1;
    }
    .star {
      font-size: 1.6rem;
      line-height: 1;
    }
    .star-filled {
      color: #fbbf24;
      text-shadow: 0 0 10px rgba(251, 191, 36, 0.55);
    }
    .star-empty {
      color: rgba(148, 163, 184, 0.35);
    }
    .confidence-num {
      font-size: 0.95rem;
      font-weight: 700;
      color: #cbd5e1;
      letter-spacing: 0.02em;
      opacity: 0.85;
    }
    .horse-card-main .confidence-num {
      color: #d1fae5;
      opacity: 1;
    }

    /* 基本情報 */
    .basic-info {
      margin-top: 18px;
      padding: 14px 16px;
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 10px;
    }
    .basic-info h4,
    .eval-points h4,
    .feature-importance h4 {
      color: #cbd5e1;
      font-size: 0.9rem;
      font-weight: 700;
      margin: 0 0 10px;
      letter-spacing: 0.04em;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .basic-info h4::before { content: "📋"; }
    .eval-points h4::before { content: "🎯"; }
    .feature-importance h4::before { content: "📊"; }
    .horse-card-main .basic-info {
      background: rgba(15, 23, 42, 0.55);
      border-color: rgba(16, 185, 129, 0.28);
    }
    .info-grid {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .info-line {
      display: flex;
      align-items: baseline;
      gap: 8px;
      font-size: 0.92rem;
      color: #e2e8f0;
      line-height: 1.4;
    }
    .info-line-primary {
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 4px;
    }
    .info-chip {
      display: inline-block;
      background: rgba(59, 130, 246, 0.18);
      color: #bfdbfe;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      border: 1px solid rgba(59, 130, 246, 0.3);
    }
    .horse-card-main .info-chip {
      background: rgba(16, 185, 129, 0.2);
      color: #d1fae5;
      border-color: rgba(16, 185, 129, 0.4);
    }
    .info-key {
      color: #94a3b8;
      font-size: 0.82rem;
      font-weight: 600;
      min-width: 48px;
      flex-shrink: 0;
    }
    .info-val {
      color: #e2e8f0;
      font-weight: 600;
    }
    .info-val-strong {
      background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 800;
      font-size: 1rem;
    }

    /* 評価ポイント */
    .eval-points {
      margin-top: 14px;
      padding: 14px 16px;
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 10px;
    }
    .horse-card-main .eval-points {
      background: rgba(15, 23, 42, 0.55);
      border-color: rgba(16, 185, 129, 0.28);
    }
    .eval-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .eval-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 5px 12px;
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.18) 0%, rgba(59, 130, 246, 0.18) 100%);
      border: 1px solid rgba(16, 185, 129, 0.4);
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #d1fae5;
    }
    .eval-tag::before {
      content: "✓";
      color: #10b981;
      font-weight: 900;
    }
    .horse-card-main .eval-tag {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(34, 197, 94, 0.2) 100%);
      border-color: rgba(16, 185, 129, 0.55);
      box-shadow: 0 2px 8px rgba(16, 185, 129, 0.2);
    }

    /* 特徴量重要度 */
    .feature-importance {
      margin-top: 14px;
      padding: 14px 16px;
      background: rgba(15, 23, 42, 0.45);
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 10px;
    }
    .horse-card-main .feature-importance {
      background: rgba(15, 23, 42, 0.55);
      border-color: rgba(16, 185, 129, 0.28);
    }
    .importance-list {
      display: grid;
      gap: 10px;
    }
    .importance-item {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .importance-label {
      min-width: 92px;
      color: #94a3b8;
      font-size: 0.85rem;
      font-weight: 600;
    }
    .importance-bar {
      flex: 1;
      height: 14px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 7px;
      overflow: hidden;
      border: 1px solid rgba(148, 163, 184, 0.18);
    }
    .importance-fill {
      height: 100%;
      background: linear-gradient(90deg, #10b981 0%, #3b82f6 50%, #8b5cf6 100%);
      border-radius: 7px;
      transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      position: relative;
      box-shadow:
        0 0 8px rgba(59, 130, 246, 0.5) inset,
        0 0 12px rgba(139, 92, 246, 0.3);
    }
    .importance-fill::after {
      content: "";
      position: absolute;
      top: 0; right: 0; bottom: 0;
      width: 18px;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45));
      border-top-right-radius: 7px;
      border-bottom-right-radius: 7px;
    }
    .horse-card-main .importance-fill {
      background: linear-gradient(90deg, #22c55e 0%, #10b981 45%, #3b82f6 100%);
      box-shadow:
        0 0 10px rgba(16, 185, 129, 0.55) inset,
        0 0 14px rgba(16, 185, 129, 0.35);
    }
    .importance-percent {
      min-width: 42px;
      text-align: right;
      color: #e2e8f0;
      font-weight: 700;
      font-size: 0.85rem;
    }

    @media (max-width: 768px) {
      .horse-stats-row {
        grid-template-columns: 1fr;
        gap: 8px;
        margin-top: 14px;
        margin-bottom: 14px;
      }
      .stat-value { font-size: 1.4rem; }
      .star { font-size: 1.4rem; }
      .horse-mark-main { font-size: 2rem; }
      .importance-label { min-width: 70px; font-size: 0.8rem; }
      .importance-bar { height: 12px; }
      .importance-percent { min-width: 36px; font-size: 0.78rem; }
    }

    /* 過去走データアコーディオン（horseHistories.history 由来・表示専用） */
