// Force rebuild: 2026-02-27
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccordionClickClose from '../../components/AccordionClickClose.astro';
import RaceAccordionClickClose from '../../components/RaceAccordionClickClose.astro';
import { readdirSync, readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { enrichHorse, formatRecentVenue, parseSexAge, parseDistanceMeters } from '../../lib/horseEnrichment.js';
import { isOsaeCandidate, sortOsaeCandidates, isIneligibleHorse, getDisplayComputerIndex, getHorseAiIndex } from '../../lib/shared-prediction-logic.js';
import { buildFreePublicRows } from '../../lib/freePublicView.js';
import { injectHorseHistoriesIntoVenues } from '../../lib/loadHorseHistoriesJra.js';
import ResultsShowcaseBanner from '../../components/ResultsShowcaseBanner.astro';
// AK専用: shared featureScores（正本素材）を読むだけ → AK専用3項目へ要約派生（premium と同じ）。
// KIは6項目詳細 / AKは3項目要約（docs/feature-scores-site-differentiation.md）。
import { loadFeatureScores, getHorseFeatures, venueCodeFromName } from '../../lib/loadFeatureScores.js';
import { deriveAkImportance } from '../../lib/akFeatureSummary.js';

// 表示専用フォールバック: horseHistories 由来があれば優先、なければ既存 recentRaces。
// 既存 horse.recentRaces は温存するため、計算系 (AI総合指数 / 印 / 買い目 / darkHorses /
// 特徴量重要度) に副作用なし。
function _displayRecentOf(horse) {
  if (Array.isArray(horse?.recentRacesFromHistories) && horse.recentRacesFromHistories.length > 0) {
    return horse.recentRacesFromHistories;
  }
  return Array.isArray(horse?.recentRaces) ? horse.recentRaces : [];
}

// 過去走データアコーディオン用: 条件別成績の文字列を組み立てる。
// JSX 内のテンプレートリテラル + 三項演算子だと Astro 5.13 パーサーが
// 比較演算子を JSX タグと誤認識することがあるため、フロントマッター側に外出ししている。
function fmtHistoryCondStat(s) {
  let out = s.n + '戦 ' + s.w + '-' + s.p2 + '-' + s.p3;
  if (s.n > 0) {
    const ratio = Math.round(((s.w + s.p2 + s.p3) / s.n) * 100);
    out += ' (3着内' + ratio + '%)';
  }
  return out;
}

// 過去走データアコーディオンの集計を1関数に集約。
// 各馬カードの JSX 内に書いていた IIFE が Astro 5.13 のパーサーで
// 比較演算子をJSXタグ開始と誤認識してビルドが落ちるため、
// 集計をすべてフロントマッター側で実行し、JSX 内は値の参照のみに留める。
// AI 指数・印・買い目・特徴量重要度・予想ロジックには一切関与しない（表示専用）。
function buildHistoryAccordionContext(horse, race) {
  if (!horse || !Array.isArray(horse.historyForDetails) || horse.historyForDetails.length === 0) return null;
  const hist = horse.historyForDetails;
  const ranked = hist.filter((r) => r && Number.isFinite(Number(r.rank)));
  const totalRanked = ranked.length;
  const cnt = (pred) => ranked.filter(pred).length;
  const w = cnt((r) => Number(r.rank) === 1);
  const p2 = cnt((r) => Number(r.rank) === 2);
  const p3 = cnt((r) => Number(r.rank) === 3);
  const others = totalRanked - w - p2 - p3;
  const hasRanked = totalRanked > 0;
  const pct = (n) => hasRanked ? Math.round((n / totalRanked) * 100) : 0;
  const winPct = pct(w);
  const placePct = pct(w + p2);
  const showPct = pct(w + p2 + p3);
  const condCount = (arr) => ({
    n: arr.length,
    w: arr.filter((r) => Number(r.rank) === 1).length,
    p2: arr.filter((r) => Number(r.rank) === 2).length,
    p3: arr.filter((r) => Number(r.rank) === 3).length,
  });
  const turfStat = condCount(ranked.filter((r) => r.surface === '芝'));
  const dirtStat = condCount(ranked.filter((r) => r.surface === 'ダ'));
  const _rawRaceDist = race && race.raceInfo && race.raceInfo.distance != null ? race.raceInfo.distance : null;
  const _parsedRaceDist = _rawRaceDist != null ? parseDistanceMeters(_rawRaceDist) : null;
  const raceDist = Number.isFinite(_parsedRaceDist) ? _parsedRaceDist : null;
  const raceVenue = race && race.raceInfo && race.raceInfo.venue ? race.raceInfo.venue : null;
  const sameDist = raceDist != null
    ? condCount(ranked.filter((r) => Number.isFinite(Number(r.distanceMeters)) && Math.abs(Number(r.distanceMeters) - raceDist) <= 200))
    : null;
  const sameVenue = raceVenue ? condCount(ranked.filter((r) => r.venue === raceVenue)) : null;
  const _weight = (horse.weight != null && horse.weight !== '' && Number.isFinite(Number(horse.weight)))
    ? (horse.weight + 'kg')
    : null;
  const _sex = parseSexAge(horse.age);
  const _ageGenderDisplay = (_sex.ageNum != null && _sex.gender)
    ? (_sex.ageNum + '歳' + _sex.gender)
    : (horse.age || null);
  const profileItems = [
    _ageGenderDisplay && { label: '性齢', value: _ageGenderDisplay },
    horse.sire && { label: '父', value: horse.sire },
    horse.jockey && { label: '騎手', value: horse.jockey },
    _weight && { label: '斤量', value: _weight },
    horse.trainer && { label: '調教師', value: horse.trainer },
  ].filter(Boolean);
  const condRows = [
    turfStat.n > 0 && { label: '芝', stat: turfStat },
    dirtStat.n > 0 && { label: 'ダート', stat: dirtStat },
    sameDist && sameDist.n > 0 && { label: '同距離±200m(' + raceDist + 'm基準)', stat: sameDist },
    sameVenue && sameVenue.n > 0 && { label: '同会場(' + raceVenue + ')', stat: sameVenue },
  ].filter(Boolean);
  const display = hist.slice(0, 10);
  const overflow = hist.length - display.length;
  const hasOverflow = overflow > 0;
  const sectionLabel = hist.length > 10 ? '競走成績（直近10走）' : '競走成績';
  const summaryCount = '（' + hist.length + '走）';
  const recordValue = w + '-' + p2 + '-' + p3 + '-' + others;
  const winPctStr = winPct + '%';
  const placePctStr = placePct + '%';
  const showPctStr = showPct + '%';
  const rows = display.map((r) => {
    const rankNum = Number(r.rank);
    const isWin = rankNum === 1;
    const isGood = Number.isFinite(rankNum) && rankNum < 4;
    const rankClass = isWin ? 'hh-rank win' : (isGood ? 'hh-rank good' : 'hh-rank');
    const hasFinishStatus = !!r.finishStatus;
    const hasRank = r.rank != null && !hasFinishStatus;
    const hasPopularity = r.popularity !== '' && r.popularity != null;
    return {
      r,
      rankClass,
      hasFinishStatus,
      hasRank,
      hasPopularity,
    };
  });
  return {
    hist,
    totalRanked,
    hasRanked,
    hasProfile: profileItems.length > 0,
    hasCondRows: condRows.length > 0,
    w, p2, p3, others,
    profileItems,
    condRows,
    rows,
    overflow,
    hasOverflow,
    sectionLabel,
    summaryCount,
    recordValue,
    winPctStr,
    placePctStr,
    showPctStr,
  };
}

const RECENT_LABELS = ['前走', '2走前', '3走前', '4走前', '5走前'];

// AI総合指数の取得は 4 領域共通の getHorseAiIndex に集約 (2026-05-24)。
// pt / totalScore / displayScore / rawScore はスケールが違うため使わない。
const getDisplayIndex = (horse, enriched) => getHorseAiIndex(horse) ?? getHorseAiIndex(enriched);

export const prerender = true;

// 最新の中央競馬予想JSONファイルを取得
const predictionsDir = join(process.cwd(), 'src', 'data', 'predictions', 'jra');
let predictionData = null;
let venues = [];
let isMultiVenue = false;
let error = null;

try {
  if (existsSync(predictionsDir)) {
    // 階層構造（jra/YYYY/MM/YYYY-MM-DD.json）から最新ファイルを検索
    const years = readdirSync(predictionsDir).filter(name => /^\d{4}$/.test(name));
    let latestFile = null;
    let latestPath = null;

    // 全ファイルを収集して日付でソート
    let allFiles = [];

    for (const year of years) {
      const yearPath = join(predictionsDir, year);
      const months = readdirSync(yearPath).filter(name => /^\d{2}$/.test(name));

      for (const month of months) {
        const monthPath = join(yearPath, month);
        const files = readdirSync(monthPath).filter(file => file.endsWith('.json') && /^\d{4}-\d{2}-\d{2}\.json$/.test(file));

        for (const file of files) {
          // ファイル名から日付を抽出（YYYY-MM-DD.json）
          const dateMatch = file.match(/^(\d{4}-\d{2}-\d{2})\.json$/);
          if (dateMatch) {
            allFiles.push({
              date: dateMatch[1],
              path: join(monthPath, file),
              timestamp: new Date(dateMatch[1]).getTime()
            });
          }
        }
      }
    }

    // 日付でソート（最新が先頭）
    allFiles.sort((a, b) => b.timestamp - a.timestamp);

    if (allFiles.length > 0) {
      latestFile = allFiles[0].date + '.json';
      latestPath = allFiles[0].path;
    }

    if (latestPath) {
      const fileContent = readFileSync(latestPath, 'utf-8');
      const rawData = JSON.parse(fileContent);

      // データ構造の判定（venues配列があるか）
      if (rawData.venues && Array.isArray(rawData.venues)) {
        // 複数会場フォーマット
        isMultiVenue = true;
        venues = rawData.venues;
        predictionData = rawData;
      } else if (rawData.eventInfo && rawData.predictions) {
        // 単一会場フォーマット（従来互換）
        isMultiVenue = false;
        venues = [{
          venue: rawData.eventInfo.venue,
          eventInfo: rawData.eventInfo,
          predictions: rawData.predictions
        }];
        predictionData = rawData;
      } else {
        throw new Error('予想データのフォーマットが不正です');
      }
    } else {
      throw new Error('中央競馬の予想データがありません');
    }
  } else {
    throw new Error('中央競馬の予想データフォルダが見つかりません');
  }
} catch (err) {
  error = err.message;
}

// horseHistories 由来の表示専用注入 (失敗時は既存 recentRaces にフォールバック)
if (!error && Array.isArray(venues) && venues.length > 0) {
  try {
    const targetDate = predictionData?.date || null;
    if (targetDate) {
      injectHorseHistoriesIntoVenues(venues, targetDate, process.cwd());
    }
  } catch (_e) {
    // 表示専用フォールバック。失敗時は既存 recentRaces のまま表示。
  }
}

// generateAdvancedMetrics imported from featureScores.js
---

<BaseLayout
  title="中央競馬 AI予想プレビュー - KEIBA Analytics"
  description="KEIBA Analytics 中央競馬（JRA）の AI 予想プレビュー。全レースの出走馬と印を公開。AI予測買い目・AI総合指数・累積スコア・役割は有料プランで公開しています。"
>
  <section class="prediction-section">
    <div class="container">
      {error && (
        <div class="error-card">
          <h1>エラー</h1>
          <p>{error}</p>
        </div>
      )}

      {predictionData && (
        <>
          <!-- ページヘッダー（南関版と統一） -->
          <div class="header-section">
            <div class="ai-badge">
              <span class="pulse"></span>
              <span class="ai-status">AI分析完了</span>
            </div>
            <h1 class="race-title">
              {isMultiVenue ? (
                <>{predictionData.date} 中央競馬（JRA） {venues.length}会場</>
              ) : (
                <>{predictionData.eventInfo.date} {predictionData.eventInfo.venue}</>
              )}
            </h1>
          </div>

        <!-- 2026-08-20: このページが「有料版のプレビュー」であることを最上部で伝える -->
        <div class="preview-banner">
            <span class="preview-banner-badge">PREVIEW</span>
            <div class="preview-banner-text">
                <p class="preview-banner-title">このページは<strong>有料版のプレビュー</strong>です</p>
                <p class="preview-banner-desc">
                    出走全頭と印は<strong>どなたでもそのまま</strong>ご覧いただけます。
                    <strong>AI予測買い目・AI総合指数・累積スコア・役割</strong>は伏せてあり、有料版で公開しています。
                </p>
            </div>
            <a class="preview-banner-cta" href="/pricing/">プランを見る →</a>
        </div>

          <!-- 会場タブ（複数会場の場合のみ表示）-->
          {isMultiVenue && venues.length > 1 && (
            <div class="venue-selector">
              {venues.map((venueData, venueIndex) => (
                <button
                  class={`venue-btn ${venueIndex === 0 ? 'active' : ''}`}
                  data-venue-index={venueIndex}
                  onclick="selectVenue(event, this)"
                >
                  <span class="venue-label">{venueData.venue}</span>
                  <span class="venue-race-count">{venueData.eventInfo.totalRaces}R</span>
                </button>
              ))}
            </div>
          )}

          <!-- 有料版 実績ショーケースへの導線 -->
          <ResultsShowcaseBanner category="jra" />

          <!-- 穴馬ページリンク -->
          <div class="dark-horse-link-section">
            <a href="/dark-horse-picks/?category=jra" class="dark-horse-link-btn">
              <span class="dark-horse-icon">🐎</span>
              <div class="dark-horse-text">
                <span class="dark-horse-title">本日の穴馬抽出ツール</span>
                <span class="dark-horse-subtitle">AI予想から狙い目の穴馬を自動抽出</span>
              </div>
              <span class="dark-horse-arrow">→</span>
            </a>
          </div>

          <!-- 会場ごとの表示エリア -->
          {venues.map((venueData, venueIndex) => {
            const venuePredictions = venueData.predictions;
            const venueInfo = venueData.eventInfo;

            // AK専用3項目の素材: shared featureScores を会場単位で1回ロード（読むだけ）。
            // 無ければ null → 各馬は既存 e.importance fallback。
            const fsDate = venueInfo?.date || predictionData?.date || predictionData?.eventInfo?.date || null;
            const featureScoresData = loadFeatureScores('jra', fsDate, venueCodeFromName('jra', venueInfo?.venue));

            return (
              <div class={`venue-content ${venueIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex}>
                {/* 会場名（複数会場の場合のみ表示）*/}
                {isMultiVenue && (
                  <div class="venue-header">
                    <h2 class="venue-title">{venueInfo.venue}</h2>
                    <p class="venue-info">{venueInfo.date} - {venueInfo.totalRaces}レース（無料公開）</p>
                  </div>
                )}

                <!-- 全レースアコーディオン（南関版と同じ縦一覧形式） -->
                <div class="jra-race-accordion-list">
                  {venuePredictions.map((race, raceIndex) => {
                    const allHorses = race.horses;
                    // 役割で絞り込み（南関版と統一: 本命・対抗・単穴）
                    const roleHorses = ['本命', '対抗', '単穴']
                      .flatMap(r => allHorses.filter(h => h.role === r));
                    const accordionId = `jra-race-v${venueIndex}-r${raceIndex}`;
                    const distance = race.raceInfo.distance;
                    const distanceLabel = (() => {
                      if (distance == null || distance === '') return null;
                      const s = String(distance).replace(/㍍|メートル|ｍ|Ｍ/g, 'm').trim();
                      return /m$/i.test(s) ? s.replace(/M$/, 'm') : `${s}m`;
                    })();

                    return (
                      <div class="jra-race-accordion" data-venue-index={venueIndex}>
                        <button
                          type="button"
                          class="jra-race-accordion-header"
                          data-target={accordionId}
                          aria-expanded="false"
                          aria-controls={accordionId}
                          onclick="toggleJraAccordion(this)"
                        >
                          <div class="jra-race-head-left">
                            <span class="jra-race-num">{race.raceInfo.raceNumber}R</span>
                            <div class="jra-race-meta">
                              {race.raceInfo.raceName && (
                                <span class="jra-race-name">{race.raceInfo.raceName}</span>
                              )}
                              <div class="jra-race-meta-line">
                                {race.raceInfo.startTime && <span class="jra-race-meta-item">🕐 {race.raceInfo.startTime}発走</span>}
                                {distanceLabel && <span class="jra-race-meta-item">📏 {distanceLabel}</span>}
                                {race.raceInfo.horseCount && <span class="jra-race-meta-item">🐴 {race.raceInfo.horseCount}頭</span>}
                              </div>
                            </div>
                          </div>
                          <span class="jra-race-toggle" aria-hidden="true">▼</span>
                        </button>

                        <div class="jra-race-accordion-content" id={accordionId} style="max-height:0;opacity:0">
                          <div class="jra-race-accordion-body">
                        {/* 買い目セクション（開くとすぐ見える誘導。ダミー1本のモザイク・実データではない） */}
                        <div class="betting-teaser">
                          <div class="betting-teaser-head">
                            <span class="betting-teaser-title">🎯 AI予測買い目</span>
                            <span class="betting-teaser-lock">🔒 有料</span>
                          </div>
                          <div class="betting-teaser-line"><span class="betting-teaser-type">馬単</span><span class="betting-teaser-nums masked-eval">● → ●.●.●.●.●</span></div>
                          <a href="/pricing/" class="unlock-btn unlock-btn-paid betting-teaser-btn">🚀 高性能AIの買い目を見る</a>
                        </div>

                        {/* AI選出馬カード（南関版と統一デザイン） */}
                        <div class="analysis-section">
                          <h2 class="section-title">
                            <span>🤖</span>
                            <span>AIモデル選出馬</span>
                          </h2>

                          {/* 無料表示: 全馬を馬番順で表示。本命◎/対抗○のみ実印。
                              pt/AI総合指数/特徴量/役割はダミーモザイク（有料で解放）。抑え・不要馬も同列。 */}
                          {(() => {
                            const _enriched = allHorses.map((h) => {
                              const e = enrichHorse(h, allHorses, race.raceInfo?.distance);
                              return { ...h, ageNum: e?.ageNum ?? h.ageNum, gender: e?.gender ?? h.gender };
                            });
                            const freeRows = buildFreePublicRows(_enriched, { resolveRecent: (h) => _displayRecentOf(h) });
                            const renderCardBody = (row) => (
                              <>

                                <div class="horse-stats-row">
                                  <div class="stat-block stat-score-block">
                                    <div class="stat-label">累積スコア</div>
                                    <div class="stat-value stat-score stat-value-masked"><span class="masked-eval masked-num" aria-hidden="true">88</span><span class="stat-unit">pt</span></div>
                                  </div>
                                  <div class="stat-block stat-index-block">
                                    <div class="stat-label">AI総合指数</div>
                                    <div class="stat-value stat-index stat-value-masked"><span class="masked-eval masked-num" aria-hidden="true">88</span></div>
                                  </div>
                                </div>

                                {(row.ageGender || row.weight || row.jockey || row.trainer || row.frame != null || row.sire) && (
                                  <div class="basic-info">
                                    <h4>基本情報</h4>
                                    <div class="info-grid">
                                      {(row.ageGender || row.weight) && (
                                        <div class="info-line info-line-primary">
                                          {row.ageGender && <span class="info-chip">{row.ageGender}</span>}
                                          {row.weight && <span class="info-chip">{row.weight}</span>}
                                        </div>
                                      )}
                                      {row.jockey && <div class="info-line"><span class="info-key">騎手</span><span class="info-val">{row.jockey}</span></div>}
                                      {row.trainer && <div class="info-line"><span class="info-key">厩舎</span><span class="info-val">{row.trainer}</span></div>}
                                      {row.frame != null && <div class="info-line"><span class="info-key">枠番</span><span class="info-val">{row.frame}枠</span></div>}
                                      {row.sire && <div class="info-line"><span class="info-key">父</span><span class="info-val">{row.sire}</span></div>}
                                    </div>
                                  </div>
                                )}

                                {/* 評価ポイントは無料では非表示（有料限定） */}

                                <div class="feature-importance">
                                  <h4>特徴量重要度</h4>
                                  <div class="importance-list">
                                    {['安定性', '能力上位性', '展開利'].map((label) => (
                                      <div class="importance-item">
                                        <span class="importance-label">{label}</span>
                                        <div class="importance-bar"><div class="importance-fill masked-eval" style="width: 62%"></div></div>
                                        <span class="importance-percent masked-eval" aria-hidden="true">88%</span>
                                      </div>
                                    ))}
                                  </div>
                                </div>

                                {row.recent.length > 0 && (
                                  <details class="recent-races recent-races-compact" data-click-close="true">
                                    <summary>過去{Math.min(5, row.recent.length)}走</summary>
                                    <div class="recent-races-list">
                                      {row.recent.slice(0, 5).map((r, i) => {
                                        const rank = (r?.rank != null && Number.isFinite(Number(r.rank))) ? `${r.rank}着` : '';
                                        return (
                                          <div class="recent-race-row">
                                            <span class="recent-race-label">{RECENT_LABELS[i]}</span>
                                            <span class="recent-race-venue">{formatRecentVenue(r?.venue) || ''}</span>
                                            <span class="recent-race-distance">{r?.distance || ''}</span>
                                            <span class="recent-race-rank">{rank}</span>
                                            {r?.time && <span class="recent-race-meta">タイム{r.time}</span>}
                                            {r?.last3f && <span class="recent-race-meta">上がり{r.last3f}</span>}
                                            {r?.bodyWeight && <span class="recent-race-meta">{r.bodyWeight}kg</span>}
                                          </div>
                                        );
                                      })}
                                    </div>
                                  </details>
                                )}
                                {/* 過去走データ（表示専用・過去走由来の集計のみ。pt/CI/役割は出さない） */}
                                {(() => {
                                  const ctx = buildHistoryAccordionContext(row._horse, race);
                                  if (!ctx) return null;
                                  return (
                                    <details class="history-details" data-click-close="true">
                                      <summary class="history-summary">
                                        <span class="history-summary-text">過去走データ</span>
                                        <span class="history-summary-count">{ctx.summaryCount}</span>
                                        <span class="history-summary-chevron" aria-hidden="true">▾</span>
                                      </summary>
                                      <div class="history-content">
                                        {ctx.hasProfile && (
                                          <div class="history-section">
