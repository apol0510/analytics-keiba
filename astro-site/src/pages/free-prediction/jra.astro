  <script is:inline>
    function selectVenue(event, button) {
      event.preventDefault();

      const venueIndex = button.getAttribute('data-venue-index');

      // 会場タブの切り替え
      document.querySelectorAll('.venue-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      button.classList.add('active');

      // 会場コンテンツの切り替え
      document.querySelectorAll('.venue-content').forEach(content => {
        content.classList.remove('active');
      });

      const selectedVenue = document.querySelector(`.venue-content[data-venue-index="${venueIndex}"]`);
      if (selectedVenue) {
        selectedVenue.classList.add('active');
      }
      // 会場タブ切替では active 切替のみ。ページ最上部へスクロールしない（スクロール位置を維持）。
    }

    // アコーディオン: 同じ会場内で他を閉じてからトグル
    function toggleJraAccordion(headerEl) {
      const targetId = headerEl.getAttribute('data-target');
      const target = document.getElementById(targetId);
      if (!target) return;

      const venue = headerEl.closest('.venue-content');
      const isOpen = headerEl.getAttribute('aria-expanded') === 'true';

      // 同会場内の他アコーディオンを閉じる
      if (venue) {
        venue.querySelectorAll('.jra-race-accordion-header').forEach(h => {
          if (h !== headerEl) {
            const tid = h.getAttribute('data-target');
            const t = tid ? document.getElementById(tid) : null;
            if (t) {
              t.style.maxHeight = '0px';
              t.style.opacity = '0';
            }
            h.setAttribute('aria-expanded', 'false');
            const ic = h.querySelector('.jra-race-toggle');
            if (ic) {
              ic.textContent = '▼';
              ic.style.transform = 'rotate(0deg)';
            }
          }
        });
      }

      // 自身をトグル
      const icon = headerEl.querySelector('.jra-race-toggle');
      if (isOpen) {
        // none の場合は一旦実 px に固定してから 0 へ畳むと滑らかに閉じる
        if (target.style.maxHeight === 'none') {
          target.style.maxHeight = target.scrollHeight + 'px';
          requestAnimationFrame(() => {
            target.style.maxHeight = '0px';
            target.style.opacity = '0';
          });
        } else {
          target.style.maxHeight = '0px';
          target.style.opacity = '0';
        }
        headerEl.setAttribute('aria-expanded', 'false');
        if (icon) {
          icon.textContent = '▼';
          icon.style.transform = 'rotate(0deg)';
        }
      } else {
        target.style.maxHeight = target.scrollHeight + 'px';
        target.style.opacity = '1';
        headerEl.setAttribute('aria-expanded', 'true');
        if (icon) {
          icon.textContent = '◎';
          icon.style.transform = 'rotate(180deg)';
        }
        // 開アニメ完了後に max-height:none 化（内側 details=過去5走/過去走データ/不要馬 を
        // 開いてもクリップしないようにする。閉じ状態に戻った場合は none 化しない）
        const onEnd = (e) => {
          if (e.propertyName !== 'max-height') return;
          target.removeEventListener('transitionend', onEnd);
          if (target.style.maxHeight !== '0px') target.style.maxHeight = 'none';
        };
        target.addEventListener('transitionend', onEnd);
      }
    }
    window.toggleJraAccordion = toggleJraAccordion;

    // 無料会員アクセス制御
    // 登録済みユーザー（プラン期限切れ含む）には連下・押さえデータを解放する
    // 判定はダッシュボード isAuthenticated() と完全統一（5キー OR 判定）+ 互換キー
    function checkFreeMemberAccess() {
      function isRegisteredUser() {
        // ダッシュボード isAuthenticated() と同一の 5 キー OR 判定
        const userPlanData = localStorage.getItem('user-plan');
        const isLoggedIn = localStorage.getItem('isLoggedIn') === 'true';
        const userPlan = localStorage.getItem('userPlan');
        const userPlanUnderscore = localStorage.getItem('user_plan');
        const userEmail = localStorage.getItem('user_email');
        if (userPlanData || isLoggedIn || userPlan || userPlanUnderscore || userEmail) {
          return true;
        }
        // 互換: 他ページで使われている userEmail (camelCase) / auth_data
        if (localStorage.getItem('userEmail')) return true;
        if (localStorage.getItem('auth_data')) return true;
        return false;
      }

      const isRegistered = isRegisteredUser();

      console.log('🔍 JRA無料 - 連下・押さえアクセス制御:', {
        isRegistered,
        'user-plan': !!localStorage.getItem('user-plan'),
        isLoggedIn: localStorage.getItem('isLoggedIn'),
        userPlan: localStorage.getItem('userPlan'),
        user_plan: !!localStorage.getItem('user_plan'),
        user_email: !!localStorage.getItem('user_email'),
        userEmail: !!localStorage.getItem('userEmail')
      });

      // 2026-08-20: /free-prediction/ は「有料版のプレビュー」へ位置づけ変更。
      // 無料登録による全頭解放ゲートは撤廃し、出走全頭と ○▲△ は誰でも見える。
      // 有料項目（pt / AI総合指数 / 役割 / 買い目）のマスクは従来どおり維持する。
      document.querySelectorAll('.access-control-section').forEach(section => {
        // 有料鍵（AI予測買い目）は常に表示
        section.querySelectorAll('.locked-content').forEach(c => { c.style.display = 'flex'; });
      });

      // 開いているアコーディオンの maxHeight を再計算（コンテンツが伸びるため）
      // none（内容量追従・クリップなし）はそのまま維持する
      document.querySelectorAll('.jra-race-accordion-content').forEach(content => {
        if (content.style.maxHeight && content.style.maxHeight !== '0px' && content.style.maxHeight !== 'none') {
          content.style.maxHeight = content.scrollHeight + 'px';
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      checkFreeMemberAccess();
      window.addEventListener('storage', () => setTimeout(checkFreeMemberAccess, 100));
    });
    window.addEventListener('load', () => setTimeout(checkFreeMemberAccess, 300));
  </script>
