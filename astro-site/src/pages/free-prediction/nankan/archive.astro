---
/**
 * 南関「日付 × 競馬場 × 予想・結果」恒久ページの一覧（2026-09-28）
 * 単一源 `src/lib/nankanDateArchive.js`。各日付ページへの内部リンクの起点（ハブ）。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DateArchiveHub from '../../../components/DateArchiveHub.astro';
import { buildAllNankanDatePages, formatJpDate, nankanDatePath } from '../../../lib/nankanDateArchive.js';
import { weekdayJa } from '../../../lib/dayResultsView.js';

export const prerender = true;

const pages = buildAllNankanDatePages();
const byMonth = new Map();
for (const p of pages) {
  const key = p.date.slice(0, 7);
  if (!byMonth.has(key)) byMonth.set(key, []);
  byMonth.get(key).push(p);
}
const months = [...byMonth.entries()];
const monthLabel = (ym) => { const [y, m] = ym.split('-').map(Number); return `${y}年${m}月`; };
const first = pages[pages.length - 1];
const last = pages[0];
const description = pages.length
  ? `南関競馬（大井・船橋・川崎・浦和）のAI予想の印と結果を開催日ごとに掲載。${formatJpDate(first.date)}〜${formatJpDate(last.date)}の${pages.length}開催日。`
  : '南関競馬のAI予想の印と結果を開催日ごとに掲載。';
// 2026-09-28: 表示は中央・南関 共通の DateArchiveHub（ガラスモーフィズム）
const hubMonths = months.map(([ym, list]) => ({
  label: monthLabel(ym),
  count: list.length,
  items: list.map((p) => ({
    href: nankanDatePath(p.date),
    dateLabel: `${Number(p.date.slice(5, 7))}/${Number(p.date.slice(8, 10))}`,
    weekday: weekdayJa(p.date),
    venue: p.summary.venueLabel,
    races: `${p.summary.totalRaces}R`,
    stat: p.summary.hasResults ? `的中 ${p.summary.hitRaces}/${p.summary.resultRaces}R` : '結果待ち',
    hasResult: p.summary.hasResults,
  })),
}));
---

<BaseLayout title="南関競馬 AI予想と結果 開催日一覧" description={description}>
  <DateArchiveHub
    title="南関競馬 AI予想と結果 開催日一覧"
    crumb="南関 予想と結果 一覧"
    lead={`大井・船橋・川崎・浦和の${pages.length}開催日について、当日公開したAIの印（◎○▲△）と着順・的中をまとめています。`}
    links={[
      { href: '/free-prediction/nankan/', label: '最新の予想' },
      { href: '/free/nankan/', label: '今日の南関 無料予想' },
      { href: '/archive/nankan/', label: '南関 的中実績アーカイブ' },
      { href: '/free-prediction/jra/archive/', label: '中央競馬の予想と結果 →' },
    ]}
    months={hubMonths}
  />
</BaseLayout>

