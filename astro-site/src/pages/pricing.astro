---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CampaignBanner from '../components/CampaignBanner.astro';
import { buildPlanTierByToken } from '../lib/pricing/planTiers.js';
import { LIGHT_SWITCH_GRACE_DAYS } from '../lib/pricing/pricingEligibility.js';

// 正規化済みプラン名 → tier。インライン script へ焼き込む（別名表の単一源は planNormalization.js）
const planTierByToken = buildPlanTierByToken();
---

<BaseLayout title="料金プラン" heroPreload={{ pc: "/images/ak-pricing-pc.webp", mobile: "/images/ak-pricing-mobile.webp" }}>
    <!-- 期間限定のご優待。文言・金額・期限・行き先はサーバーが返す（ここには書かない）-->
    <CampaignBanner />
    <!-- プラン出し分け: カードが描画される前に <html> へ現在プランの tier を付ける。
         判定は CSS 側（下位カードの display:none）で行うため、ちらつきなく確定する。
         define:vars は is:inline を含意するので、この script はパース時に同期実行される。

         ⚠️ ここで出し分ける「Light 会員向け乗り換え特典価格」は **課金契約に紐づく価格資格**。
            無料特典（promotional grant）で Light / Premium が見られるようになった顧客には
            出さない。無料特典の顧客へ特別価格を出したいときは PromotionalOffer で
            明示的に発行する（/offer/ 経路）。判定の単一源は
            src/lib/pricing/pricingEligibility.js（サーバーで算出して user-plan.pricingTier に渡す）。 -->
    <script define:vars={{ planTierByToken, graceDays: LIGHT_SWITCH_GRACE_DAYS }}>
      (function () {
        try {
          // 退会申請は無料相当。出し分けせず全プランを見せる（fail-open）
          if (localStorage.getItem('isWithdrawalRequested') === 'true') return;
          // 2026-09-29 MK 確定: 有効期限の終わり + graceDays（30）日を過ぎたら会員向け価格は出さない
          // （サーバー判定 pricingEligibility.js の LIGHT_SWITCH_GRACE_DAYS と同じ値。古いセッションの tier を使い続けない）
          const validUntil = localStorage.getItem('validUntil');
          const vuMs = validUntil && validUntil !== 'null'
            ? (/^\d{4}-\d{2}-\d{2}$/.test(validUntil) ? Date.parse(validUntil + 'T23:59:59.999+09:00') : Date.parse(validUntil))
            : NaN;
          if (Number.isFinite(vuMs) && Date.now() > vuMs + graceDays * 86400000) return;

          // dashboard.astro / AccessControl.astro と同じ取得順
          let raw = '';
          let up = null;
          const stored = localStorage.getItem('user-plan');
          if (stored) {
            try { up = JSON.parse(stored) || null; } catch (_) {}
            raw = (up && up.plan) || '';
          }

          // 🔒 価格資格はサーバーが課金契約だけから決めた pricingTier を最優先で使う。
          //    無料特典しか無い顧客は 0 になり、会員向け価格は出ない。
          if (up && typeof up.pricingTier === 'number') {
            if (up.pricingTier > 0) {
              document.documentElement.setAttribute('data-plan-tier', String(up.pricingTier));
            }
            return; // サーバー判定があるならプラン名からの推測はしない
          }
          // サーバー判定が無い古いセッション: 期限切れは従来どおり出し分けない
          if (localStorage.getItem('isExpired') === 'true') return;
          if (Number.isFinite(vuMs) && vuMs < Date.now()) return;
          // 🔒 pricingTier が無い応答でも、根拠が無料特典と分かっているなら出し分けない
          if (up && up.entitlementSource === 'promotional_grant') return;

          if (!raw) raw = localStorage.getItem('user_plan') || localStorage.getItem('userPlan') || '';
          if (!raw) return;

          // normalizePlanToken(src/lib/auth/planNormalization.js) と同一の正規化。変更時は両方直すこと
          const token = String(raw).normalize('NFKC').trim().toLowerCase().replace(/[\s_]+/g, '-');
          const tier = planTierByToken[token];
          if (typeof tier !== 'number') return; // 未知プランは fail-open

          document.documentElement.setAttribute('data-plan-tier', String(tier));
        } catch (_) {}
      })();
    </script>

    <div class="pricing-page">
        <!-- ヒーロー画像（購買後押し） -->
        <div class="pricing-hero">
            <picture>
                <source media="(max-width: 768px)" srcset="/images/ak-pricing-mobile.webp" type="image/webp" />
                <source media="(max-width: 768px)" srcset="/images/ak-pricing-mobile.png" />
                <source srcset="/images/ak-pricing-pc.webp" type="image/webp" />
                <img
                    src="/images/ak-pricing-pc.png"
                    alt="勝負を変える、AI分析。中央・南関どちらも対応。"
                    class="pricing-hero-img"
                    width="1672"
                    height="941"
                    fetchpriority="high"
                    decoding="async"
                />
            </picture>
        </div>

        <!-- ヘッダー -->
        <div class="pricing-header">
            <h1 class="pricing-title">
                🚀 <span class="gradient-text">AI予想で勝つ</span>
            </h1>
            <p class="pricing-subtitle">
                中央だけ・南関だけでも始められます。両方なら Premium がお得です。
            </p>
            <!-- Light 会員のときだけ CSS で表示（上位プランのみに絞っている旨の説明） -->
            <p class="pricing-upgrade-note">
                <strong>Light</strong> 会員さま（有効期限の終了から30日以内の方を含む）向けの表示です。<br>
                <strong>Light の更新・再開</strong>のほか、Premium（月額）や、Light会員さま限定の<strong>乗り換え特典 ¥4,980 OFF</strong>を適用した Premium 年払い（下の「銀行振込」）をお選びいただけます。
            </p>
        </div>

        <!-- プラン比較カード（2026-10-02〜 Stripe 定期購読が主導線）
             金額の正本は src/lib/billing/stripePlans.js（請求は Stripe の Price）。
             ボタンは data-checkout="<planId>" → 下の startCheckout() → stripe-create-checkout。 -->
        <p class="plans-lead">中央と南関、どちらで勝負しますか？<br><span>両方なら Premium がお得です。</span></p>
        <div class="plans-container plans-container--stripe">
            <!-- Premium（中央＋南関）月額 ¥4,980 -->
            <div class="plan-card plan-card-recommended" data-plan-tier="2" data-stripe-plan="premium">
                <div class="recommended-badge">
                    <span>✨ 両方ならお得</span>
                </div>
                <div class="plan-header">
                    <h3 class="plan-name">Premium</h3>
                    <div class="plan-price">
                        <span class="price-amount">¥4,980</span>
                        <span class="price-period">/月</span>
                    </div>
                    <p class="plan-description">中央版＋南関版を別々に契約するより<strong>月 ¥980 お得</strong></p>
                </div>

                <div class="plan-venues" aria-label="対応会場">
                    <span class="plan-venue-pill plan-venue-pill--jra">🏇 中央<small>JRA</small></span>
                    <span class="plan-venue-pill plan-venue-pill--nankan">🏁 南関</span>
                    <span class="plan-venue-note">両方</span>
                </div>

                <ul class="plan-features">
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span><strong>中央・南関 全レース（1R〜12R）の買い目</strong></span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>高精度AI予想・詳細な投資戦略</span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>平日（南関）も週末（中央）も</span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>優先サポート</span>
                    </li>
                </ul>

                <button type="button" class="plan-button plan-button-annual" data-checkout="premium">
                    💳 Premium を申し込む
                </button>
                <p class="plan-billing-note">クレジットカード決済の月額プラン</p>
            </div>

            <!-- Premium 中央版 月額 ¥2,980 -->
            <div class="plan-card" data-plan-tier="2" data-stripe-plan="premium-jra">
                <div class="plan-header">
                    <h3 class="plan-name">Premium 中央版</h3>
                    <div class="plan-price">
                        <span class="price-amount">¥2,980</span>
                        <span class="price-period">/月</span>
                    </div>
                    <p class="plan-description">週末の中央競馬だけで勝負したい方に</p>
                </div>

                <div class="plan-venues" aria-label="対応会場">
                    <span class="plan-venue-pill plan-venue-pill--jra">🏇 中央<small>JRA</small></span>
                    <span class="plan-venue-note">中央のみ</span>
                </div>

                <ul class="plan-features">
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span><strong>中央 全レースの買い目</strong></span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>Premium と同じAI予想・投資戦略</span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>あとから Premium へ変更できます</span>
                    </li>
                </ul>

                <button type="button" class="plan-button plan-button-monthly" data-checkout="premium-jra">
                    💳 中央版を申し込む
                </button>
                <p class="plan-billing-note">クレジットカード決済の月額プラン</p>
            </div>

            <!-- Premium 南関版 月額 ¥2,980 -->
            <div class="plan-card" data-plan-tier="2" data-stripe-plan="premium-nankan">
                <div class="plan-header">
                    <h3 class="plan-name">Premium 南関版</h3>
                    <div class="plan-price">
                        <span class="price-amount">¥2,980</span>
                        <span class="price-period">/月</span>
                    </div>
                    <p class="plan-description">平日の南関競馬だけで勝負したい方に</p>
                </div>

                <div class="plan-venues" aria-label="対応会場">
                    <span class="plan-venue-pill plan-venue-pill--nankan">🏁 南関</span>
                    <span class="plan-venue-note">南関のみ</span>
                </div>

                <ul class="plan-features">
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span><strong>南関 全レースの買い目</strong></span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>Premium と同じAI予想・投資戦略</span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>あとから Premium へ変更できます</span>
                    </li>
                </ul>

                <button type="button" class="plan-button plan-button-monthly" data-checkout="premium-nankan">
                    💳 南関版を申し込む
                </button>
                <p class="plan-billing-note">クレジットカード決済の月額プラン</p>
            </div>

            <!-- Lightプラン（2026-10-02〜 新規募集停止。既存の有料 Light 会員の更新・再開だけ CSS で表示）-->
            <div class="plan-card" data-plan-tier="1" data-only-for="light">
                <div class="plan-header">
                    <h3 class="plan-name">Light</h3>
                    <div class="plan-price">
                        <span class="price-amount">¥4,980</span>
                        <span class="price-period">/30日</span>
                    </div>
                    <p class="plan-description">Light 会員さまの更新・再開</p>
                </div>

                <div class="plan-venues" aria-label="対応会場">
                    <span class="plan-venue-pill plan-venue-pill--jra">🏇 中央<small>JRA</small></span>
                    <span class="plan-venue-pill plan-venue-pill--nankan">🏁 南関</span>
                    <span class="plan-venue-note">両方対応</span>
                </div>

                <ul class="plan-features">
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span><strong>メインレースの買い目</strong></span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>無料予想</span>
                    </li>
                </ul>

                <button class="plan-button plan-button-standard" onclick="openBankModal('Light', 4980, 'monthly')">
                    🏦 銀行振込で更新する
                </button>
            </div>

            <!-- 無料プラン -->
            <div class="plan-card" data-plan-tier="0">
                <div class="plan-header">
                    <h3 class="plan-name">無料プラン</h3>
                    <div class="plan-price">
                        <span class="price-amount">¥0</span>
                    </div>
                    <p class="plan-description">お試ししたい方に</p>
                </div>

                <div class="plan-venues" aria-label="対応会場">
                    <span class="plan-venue-pill plan-venue-pill--jra">🏇 中央<small>JRA</small></span>
                    <span class="plan-venue-pill plan-venue-pill--nankan">🏁 南関</span>
                    <span class="plan-venue-note">両方対応</span>
                </div>

                <ul class="plan-features">
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>無料予想</span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>予想結果の確認</span>
                    </li>
                </ul>

                <a href="/free-signup/" class="plan-button plan-button-free">
                    無料会員登録
                </a>
            </div>
        </div>

        <!-- 申込前の確認（Stripe へ進む前のメール入力・エラー表示） -->
        <div class="checkout-panel" id="checkoutPanel" hidden>
            <div class="checkout-panel-inner">
                <p class="checkout-panel-title" id="checkoutPanelTitle">お申し込み</p>
                <form id="checkoutEmailForm" class="checkout-email-form" novalidate>
                    <label for="checkoutEmail" class="form-label">ご利用になるメールアドレス</label>
                    <input type="email" id="checkoutEmail" class="form-input" autocomplete="email" required placeholder="example@email.com">
                    <p class="checkout-hint">お支払い後、このアドレスにログイン用のリンクをお送りします。</p>
                    <button type="submit" class="plan-button plan-button-annual" id="checkoutSubmit">お支払いへ進む</button>
                </form>
                <p class="checkout-message" id="checkoutMessage" role="status" hidden></p>
                <button type="button" class="checkout-panel-close" id="checkoutPanelClose">閉じる</button>
            </div>
        </div>

        <!-- その他のお支払い方法（銀行振込の年払い・買い切り）。主導線ではないので控えめに出す -->
        <details class="other-payments" id="otherPayments">
            <summary>銀行振込（年払い・買い切り）をご希望の方</summary>
            <div class="other-payments-body">
                <div class="other-plan" data-plan-tier="2">
                    <div class="other-plan-head">
                        <span class="other-plan-name">Premium 年払い（中央＋南関）</span>
                        <span class="other-plan-price" data-hide-for="light">¥49,800<small>/年</small></span>
                        <span class="other-plan-price" data-only-for="light"><s>¥49,800</s> ¥44,820<small>/年・Light会員さま乗り換え特典</small></span>
                    </div>
                    <button class="other-plan-button" data-hide-for="light" onclick="openBankModal('Premium Annual', 49800, 'annual')">🏦 銀行振込で申し込む</button>
                    <!-- 「- Campaign」は bank-transfer-application.js が除去して planName='Premium' /
                         planType='Annual' に正規化する既存パターン。別の接尾辞にすると Airtable の
                         Single select が不正値になり登録が落ちる（エラーは握りつぶされる） -->
                    <button class="other-plan-button" data-only-for="light" onclick="openBankModal('Premium Annual - Campaign', 44820, 'annual')">🏦 乗り換え特典価格で申し込む</button>
                </div>
                <div class="other-plan" data-plan-tier="2">
                    <div class="other-plan-head">
                        <span class="other-plan-name">Premium 買い切り（中央＋南関・期限なし）</span>
                        <span class="other-plan-price">¥78,000<small>/一度きり</small></span>
                    </div>
                    <button class="other-plan-button" onclick="openBankModal('Premium Lifetime', 78000, 'lifetime')">🏦 銀行振込で申し込む</button>
                </div>
                <p class="other-payments-note">銀行振込は、お振込み後に報告フォームをご送信いただき、入金確認後にご利用開始となります。</p>
            </div>
        </details>

        <!-- FAQ -->
        <div class="faq-section">
            <h2 class="faq-title">よくある質問</h2>
            
            <div class="faq-container">
                <!-- FAQ の出し分け（プラン別）:
                     data-hide-for="light" … Light 会員には不要な話題（現在プラン以下の説明）
                     data-only-for="light" … Light 会員にだけ出す話題（アップグレード比較・手順）
                     属性なし … 全員に出す。未ログイン / 無料 / プレミアムは全項目表示 -->
                <div class="faq-item" data-hide-for="light">
                    <h3 class="faq-question">Q: 無料プランでも予想は見れますか？</h3>
                    <p class="faq-answer">
                        はい。無料プランでも全レースの無料予想（AI指数・印・分析）をご覧いただけます。<br>
                        買い目は有料プランでのご提供ですが、前日の有料メインレース買い目とその結果は「昨日の買い目」ページで公開しています。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: Premium では何が見られますか？</h3>
                    <p class="faq-answer">
                        全レース（1R〜12R）の買い目をご覧いただけます。加えて、詳細な投資戦略と優先サポートをご利用いただけます。<br>
                        Premium は中央（JRA）・南関の両方、中央版・南関版はそれぞれの会場のすべてのレースが対象です。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 中央版・南関版と Premium の違いは？</h3>
                    <p class="faq-answer">
                        内容は同じで、見られる会場だけが違います。中央版は中央（JRA）だけ、南関版は南関だけ、Premium は両方です。<br>
                        中央は主に土日、南関は主に平日の開催です。両方ご覧になるなら、中央版と南関版を別々に契約するより <strong>Premium（¥4,980/月）の方が月 ¥980 お得</strong>です。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 買い目は何点ですか？</h3>
                    <p class="faq-answer">
                        買い目は<a href="/results-showcase/nankan/">昨日の買い目（南関）</a>・<a href="/results-showcase/jra/">昨日の買い目（中央）</a>で公開しています。ご購入前にご確認ください。
                    </p>
                </div>

                <div class="faq-item" data-only-for="light">
                    <h3 class="faq-question">Q: 乗り換え特典とは何ですか？</h3>
                    <p class="faq-answer">
                        Light会員さまがプレミアム年払いへ切り替える際、<strong>無条件で ¥4,980 割引</strong>する特典です。<br>
                        通常 ¥49,800/年 のところ <strong>¥44,820/年</strong>（月額換算 ¥3,735）でご利用いただけます。残り日数の申告は不要です。
                    </p>
                </div>

                <div class="faq-item" data-only-for="light">
                    <h3 class="faq-question">Q: Lightを続けるのと、プレミアム年払いはどちらがお得ですか？</h3>
                    <p class="faq-answer">
                        Light は ¥4,980/30日のため、1年間（12回）継続すると <strong>¥59,760</strong> になります。<br>
                        乗り換え特典価格のプレミアム年払いは <strong>¥44,820/年</strong>（月額換算 ¥3,735）で、<strong>¥14,940 お得</strong>な上に、買い目がメインレースのみから全レースへ広がります。
                    </p>
                </div>

                <div class="faq-item" data-only-for="light">
                    <h3 class="faq-question">Q: Lightからプレミアム年払いへの切り替え手順は？</h3>
                    <p class="faq-answer">
                        上の「銀行振込（年払い・買い切り）をご希望の方」を開き、「🏦 乗り換え特典価格で申し込む」で口座情報をご確認のうえ <strong>¥44,820</strong> をお振込みいただき、振込完了後に報告フォームをご送信ください。入金確認取れ次第、プレミアムのご利用を開始いただけます。<br>
                        ご不明な点はお気軽にお問い合わせください。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 支払い方法は何が利用できますか？</h3>
                    <p class="faq-answer">
                        月額プラン（Premium・中央版・南関版）はクレジットカードでのお支払いです（決済は Stripe を利用しています）。<br>
                        Premium の年払い・買い切りは銀行振込でお申し込みいただけます。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 解約はできますか？</h3>
                    <p class="faq-answer">
                        ログイン後、マイページの「お支払い管理」から手続きいただけます。<br>
                        解約すると次回以降の更新が停止し、お支払い済みの期間の終わりまではご利用いただけます。最低利用期間はなく、日割りでの返金は行っておりません。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 年払い・買い切りはありますか？</h3>
                    <p class="faq-answer">
                        銀行振込でお申し込みいただけます（上の「銀行振込（年払い・買い切り）をご希望の方」）。<br>
                        年払いは ¥49,800/年（1年間）、買い切りは ¥78,000 の一度きりのお支払いで期限なくご利用いただけます。どちらも中央・南関の両方が対象です。
                    </p>
                </div>

                <!-- 銀行振込の手順は銀行振込モーダル内の .bank-steps と必ず一致させること（振込が先） -->
                <div class="faq-item">
                    <h3 class="faq-question">Q: 利用開始までの流れは？</h3>
                    <p class="faq-answer">
                        <strong>【月額プラン】</strong>カード決済が完了するとすぐにご利用いただけます。ご登録のメールアドレスにログイン用のリンクをお送りします。<br>
                        <strong>【銀行振込】</strong>①お振込み → ②振込完了後、報告フォームをご送信 → ③入金確認後、ご利用開始です。フォームは<strong>お振込みが済んでから</strong>ご送信ください。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 更新や有効期限はどうなりますか？</h3>
                    <p class="faq-answer">
                        月額プランは毎月自動で更新されます（お手続きは不要です）。<br>
                        銀行振込の年払いは、有効期限が近づきましたらメールでお知らせいたします。継続をご希望の場合は、再度お振込みいただくことで延長できます。
                    </p>
                </div>

                <!-- Light 会員には上の「切り替え手順」FAQ が同じ役割を果たすため出さない -->
                <div class="faq-item" data-hide-for="light">
                    <h3 class="faq-question">Q: プランの変更はできますか？</h3>
                    <p class="faq-answer">
                        はい。月額プランは、マイページの「お支払い管理」から中央版・南関版と Premium を切り替えられます（差額は日割りで調整されます）。<br>
                        その他のご相談はお気軽にお問い合わせください。
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- 銀行振込モーダル -->
    <div class="bank-modal" id="bankModal">
      <div class="bank-modal-content">
        <button class="bank-modal-close" onclick="closeBankModal()">×</button>

        <h2 class="bank-modal-title">🏦 銀行振込でのお申し込み</h2>
        <p class="modal-plan-info" id="modalPlanInfo"></p>

        <div class="bank-info-box">
          <div class="bank-info-item">
            <span class="bank-info-label">振込先銀行</span>
            <span class="bank-info-value">PayPay銀行
              <button class="copy-button" onclick="copyToClipboard('PayPay銀行')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">支店名</span>
            <span class="bank-info-value">本店営業部
              <button class="copy-button" onclick="copyToClipboard('本店営業部')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">口座種別</span>
            <span class="bank-info-value">普通</span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">口座番号</span>
            <span class="bank-info-value">8307337
              <button class="copy-button" onclick="copyToClipboard('8307337')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">口座名義</span>
            <span class="bank-info-value">ｳｴﾌﾞｹｲﾊﾞ
              <button class="copy-button" onclick="copyToClipboard('ｳｴﾌﾞｹｲﾊﾞ')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3);">
            <span class="bank-info-label">振込金額</span>
            <span class="bank-info-value" style="color: #10b981; font-size: 1.3rem;" id="modalAmount">¥5,980</span>
          </div>
        </div>

        <div class="bank-steps">
          <div class="bank-steps-title">📝 お申し込み手順</div>
          <div class="bank-step">
            <span class="bank-step-number">1</span>
            <span>上記の口座情報に振込金額をお振込みください</span>
          </div>
          <div class="bank-step">
            <span class="bank-step-number">2</span>
            <span>振込完了後、下記のフォームから必要情報をご送信ください</span>
          </div>
          <div class="bank-step">
            <span class="bank-step-number">3</span>
            <span>入金確認取れ次第、即時にログイン情報をメールでお送りいたします</span>
          </div>
        </div>

        <!-- 銀行振込申し込みフォーム -->
        <div class="bank-form-section">
          <div class="bank-form-title">💳 銀行振込完了の報告フォーム</div>
          <div class="bank-form-note">
            ※ こちらは <strong>銀行振込完了後</strong> にご送信いただくフォームです。<br>
            事前予約や <strong>未入金状態での申し込みフォームではありません</strong>。<br>
            必ず銀行振込を済ませてから送信してください。
          </div>

          <form id="bankTransferForm" class="bank-form">
            <div class="form-group">
              <label for="fullName" class="form-label">お名前 <span class="required">*</span></label>
              <input type="text" id="fullName" name="fullName" class="form-input" required placeholder="山田 太郎">
            </div>

            <div class="form-group">
              <label for="email" class="form-label">メールアドレス <span class="required">*</span></label>
              <input type="email" id="email" name="email" class="form-input" required placeholder="example@email.com">
            </div>


            <div class="form-group">
                <label for="transferDate" class="form-label">振込完了日 <span class="required">*</span></label>
                <input type="date" id="transferDate" name="transferDate" class="form-input" required>
                <div class="form-hint">※ 未来の日付は選択できません。実際に振込が完了した日をご入力ください。</div>
              </div>


            <div class="form-group">
              <label for="transferAmount" class="form-label">振込金額 <span class="required">*</span></label>
              <input type="number" id="transferAmount" name="transferAmount" class="form-input" required readonly>
            </div>

            <div class="form-group">
              <label for="remarks" class="form-label">備考・ご要望</label>
              <textarea id="remarks" name="remarks" class="form-input" rows="3" placeholder="何かご要望がありましたらご記入ください（任意）"></textarea>
            </div>

            <div class="form-group form-confirm-group">
              <label class="form-confirm-label">
                <input type="checkbox" id="paymentCompletedConfirm" name="paymentCompletedConfirm" class="form-confirm-checkbox" required>
                <span class="form-confirm-text">
                  銀行振込を完了済みです。このフォームは入金後の報告専用であることを確認しました。
                  <span class="required">*</span>
                </span>
              </label>
            </div>

            <button type="submit" class="form-submit-button" id="submitButton">
              <span class="submit-text">📨 入金完了を報告する</span>
              <span class="submit-loading" style="display: none;">送信中...</span>
            </button>

            <div class="form-message" id="formMessage" style="display: none;"></div>
          </form>
        </div>

        <div class="bank-warning">
          <div class="bank-warning-title">⚠️ ご注意事項</div>
          <div class="bank-warning-text">
            ・<strong>本フォームは振込完了の報告用です</strong>。送信前に必ず銀行振込を完了してください<br>
            ・<strong>振込完了日は未来の日付では送信できません</strong><br>
            ・振込手数料はお客様負担となります<br>
            ・土日祝日の場合、確認が翌営業日となる場合がございます<br>
            ・<strong>お名前と同じ名義で振込をお願いします</strong><br>
            ・名義が異なる場合は、備考欄にその旨をご記入ください<br>
            ・ご入金後のキャンセル・返金は承っておりません
          </div>
        </div>
      </div>
    </div>
</BaseLayout>

<script is:inline>
  // ── Stripe 月額の申込（2026-10-02〜）────────────────────────────
  // 金額はサーバー（Stripe の Price）が決める。ここから送るのはプラン ID とメールだけ。
  (function () {
    var PLAN_NAMES = { 'premium': 'Premium（中央＋南関）', 'premium-jra': 'Premium 中央版', 'premium-nankan': 'Premium 南関版' };
    var panel = document.getElementById('checkoutPanel');
    var form = document.getElementById('checkoutEmailForm');
    var emailInput = document.getElementById('checkoutEmail');
    var msg = document.getElementById('checkoutMessage');
    var title = document.getElementById('checkoutPanelTitle');
    var submitBtn = document.getElementById('checkoutSubmit');
    var pendingPlan = '';
    var busy = false;

    function knownEmail() {
      try {
        var up = JSON.parse(localStorage.getItem('user-plan') || 'null');
        return (up && typeof up.email === 'string') ? up.email : '';
      } catch (_) { return ''; }
    }

    function showPanel(planId, withForm) {
      pendingPlan = planId;
      title.textContent = (PLAN_NAMES[planId] || 'お申し込み') + ' のお申し込み';
      form.hidden = !withForm;
      msg.hidden = true;
      msg.innerHTML = '';
      if (withForm && !emailInput.value) emailInput.value = knownEmail();
      panel.hidden = false;
      if (withForm) setTimeout(function () { emailInput.focus(); }, 0);
    }

    function showMessage(html) {
      form.hidden = true;
      msg.innerHTML = html;
      msg.hidden = false;
      panel.hidden = false;
    }

    async function openPortal() {
      try {
        var res = await fetch('/.netlify/functions/stripe-portal', { method: 'POST', credentials: 'include' });
        var data = await res.json().catch(function () { return {}; });
        if (res.ok && data.url) { location.href = data.url; return; }
      } catch (_) {}
      showMessage('お支払い管理を開けませんでした。<a href="/dashboard/">マイページ</a>からお試しください。');
    }
    window.akOpenStripePortal = openPortal;

    async function startCheckout(planId, email) {
      if (busy) return;
      busy = true;
      if (submitBtn) submitBtn.disabled = true;
      try {
        var res = await fetch('/.netlify/functions/stripe-create-checkout', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(email ? { plan: planId, email: email } : { plan: planId }),
        });
        var data = await res.json().catch(function () { return {}; });
        if (res.ok && data.url) {
          if (window.AkFunnel && window.AkFunnel.checkoutStart) window.AkFunnel.checkoutStart(planId);
          location.href = data.url;
          return;
        }
        var err = data.error || '';
        if (err === 'email_required') { showPanel(planId, true); return; }
        if (err === 'already_subscribed' && data.next === 'portal') {
          showMessage('すでに月額プランをご契約中です。プランの変更（中央版・南関版 ⇄ Premium）や解約は「お支払い管理」から行えます。<br><br><button type="button" class="plan-button plan-button-annual" onclick="akOpenStripePortal()">お支払い管理を開く</button>');
          return;
        }
        if (err === 'already_subscribed') {
          showMessage('このメールアドレスは、すでに月額プランをご契約中です。<a href="/login/?next=/pricing/">ログイン</a>のうえ、マイページの「お支払い管理」からプランの変更・解約を行えます。');
          return;
        }
        if (err === 'already_premium') {
          showMessage('すでに Premium（中央＋南関）をご利用中のため、お申し込みは不要です。ご不明な点は<a href="/contact/">お問い合わせ</a>ください。');
          return;
        }
        if (err === 'account_conflict') {
          showMessage('お客様の登録情報を確認できませんでした。お手数ですが<a href="/contact/">お問い合わせ</a>ください。');
          return;
        }
        if (err === 'billing_not_configured' || err === 'plan_not_configured') {
          showMessage('ただいまカード決済の準備中です。しばらくしてから再度お試しください。');
          return;
        }
        showMessage('お申し込みを開始できませんでした。時間をおいて再度お試しください。');
      } catch (_) {
        showMessage('通信に失敗しました。時間をおいて再度お試しください。');
      } finally {
        busy = false;
        if (submitBtn) submitBtn.disabled = false;
      }
    }

    document.querySelectorAll('[data-checkout]').forEach(function (btn) {
      btn.addEventListener('click', function () { startCheckout(btn.getAttribute('data-checkout')); });
    });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = String(emailInput.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.textContent = 'メールアドレスをご確認ください。';
        msg.hidden = false;
        return;
      }
      startCheckout(pendingPlan, email);
    });
    document.getElementById('checkoutPanelClose').addEventListener('click', function () { panel.hidden = true; });
    panel.addEventListener('click', function (e) { if (e.target === panel) panel.hidden = true; });
  })();

  let currentPlan = '';
  let currentAmount = 0;
  let currentPlanType = 'monthly';

  function openBankModal(planName, amount, planType = 'monthly') {
    currentPlan = planName;
    currentAmount = amount;
    currentPlanType = planType;

    let periodText = '';
    if (planType === 'lifetime') {
      periodText = '（永久アクセス）';
    } else if (planType === 'annual') {
      periodText = '/年';
    } else {
      periodText = '/30日';
    }

    document.getElementById('modalPlanInfo').textContent = `プラン: ${planName} (¥${amount.toLocaleString()}${periodText})`;
    document.getElementById('modalAmount').textContent = `¥${amount.toLocaleString()}`;
    document.getElementById('transferAmount').value = amount;
    document.getElementById('bankModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeBankModal() {
    document.getElementById('bankModal').classList.remove('active');
    document.body.style.overflow = 'auto';
  }

  function copyToClipboard(text) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();

    try {
      document.execCommand('copy');
      alert('コピーしました: ' + text);
    } catch (err) {
      console.error('コピーに失敗しました:', err);
    }

    document.body.removeChild(textarea);
  }

  // DOMContentLoaded後にフォーム処理を登録
  document.addEventListener('DOMContentLoaded', () => {
    // モーダル外クリックで閉じる
    document.addEventListener('click', (e) => {
      const bankModal = document.getElementById('bankModal');
      if (e.target === bankModal) {
        closeBankModal();
      }
    });

    // Escapeキーで閉じる
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeBankModal();
      }
    });

    // 振込完了日: JST 今日を最大値に設定（未来日を選択不可にする）
    const getJstToday = () => {
      const now = new Date();
      const jstMs = now.getTime() + 9 * 60 * 60 * 1000;
      return new Date(jstMs).toISOString().slice(0, 10);
    };
    const transferDateInput = document.getElementById('transferDate');
    if (transferDateInput) {
      const jstToday = getJstToday();
      transferDateInput.max = jstToday;
      // 入力時に未来日が入った場合は即時警告
      transferDateInput.addEventListener('change', () => {
        if (transferDateInput.value && transferDateInput.value > jstToday) {
          alert('⚠️ 振込完了日に未来の日付は指定できません。\n本フォームは振込完了後の報告用です。実際に振込を完了してからご送信ください。');
          transferDateInput.value = '';
        }
      });
    }

    // 銀行振込フォーム送信処理
    const bankTransferForm = document.getElementById('bankTransferForm');
    if (bankTransferForm) {
      bankTransferForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitButton = document.getElementById('submitButton');
        const submitText = submitButton.querySelector('.submit-text');
        const submitLoading = submitButton.querySelector('.submit-loading');
        const formMessage = document.getElementById('formMessage');

        // 送信前バリデーション: 入金済み確認チェック
        const paymentCompletedCheckbox = document.getElementById('paymentCompletedConfirm');
        if (!paymentCompletedCheckbox || !paymentCompletedCheckbox.checked) {
          formMessage.textContent = '⚠️ 銀行振込完了後にチェックを入れてから送信してください。';
          formMessage.className = 'form-message error';
          formMessage.style.display = 'block';
          return;
        }

        // 送信前バリデーション: 未来日ブロック
        const jstToday = getJstToday();
        const transferDateValue = document.getElementById('transferDate').value;
        if (transferDateValue && transferDateValue > jstToday) {
          formMessage.textContent = '⚠️ 振込完了日に未来の日付は指定できません。実際に振込を完了してからご送信ください。';
          formMessage.className = 'form-message error';
          formMessage.style.display = 'block';
          return;
        }

        submitButton.disabled = true;
        submitText.style.display = 'none';
        submitLoading.style.display = 'inline';
        formMessage.style.display = 'none';

        let periodText = '';
        if (currentPlanType === 'lifetime') {
          periodText = '（永久アクセス）';
        } else if (currentPlanType === 'annual') {
          periodText = '/年';
        } else {
          periodText = '/30日';
        }

        const formData = {
          fullName: document.getElementById('fullName').value,
          email: document.getElementById('email').value,
          transferDate: document.getElementById('transferDate').value,
          transferTime: "00:00",  // デフォルト値
          transferAmount: document.getElementById('transferAmount').value,
          transferName: document.getElementById('fullName').value,  // お名前と同じ
          remarks: document.getElementById('remarks').value,
          productName: `${currentPlan} (¥${currentAmount.toLocaleString()}${periodText})`,
          paymentCompletedConfirm: paymentCompletedCheckbox.checked,
          timestamp: new Date().toISOString()
        };

        try {
          const response = await fetch('/.netlify/functions/bank-transfer-application', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData)
          });

          const result = await response.json();

          if (result.success) {
            document.getElementById('bankTransferForm').reset();
            window.SubmissionResult && window.SubmissionResult.showSuccessScreen({
              formEl: bankTransferForm,
              messageEl: formMessage,
              options: {
                title: '入金完了のご報告を受け付けました',
                message: `${formData.productName} のご報告を受け付けました。`,
                subMessage: '確認メールをお送りしましたのでご確認ください。マイページから申請状況も確認できます。'
              },
              history: {
                type: 'bank-transfer',
                label: `銀行振込お申し込み: ${formData.productName}`,
                status: 'pending',
                details: { email: formData.email, transferAmount: formData.transferAmount, transferDate: formData.transferDate, productName: formData.productName }
              }
            });
          } else {
            throw new Error(result.error || '送信に失敗しました');
          }
        } catch (error) {
          formMessage.textContent = '❌ エラーが発生しました: ' + error.message;
          formMessage.className = 'form-message error';
          formMessage.style.display = 'block';
          submitButton.disabled = false;
          submitText.style.display = 'inline';
          submitLoading.style.display = 'none';
        }
      });
    }
  });
</script>

<style>
    .pricing-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #e2e8f0;
        padding: 2rem 1rem;
    }

    /* ヒーロー画像 */
    .pricing-hero {
        max-width: 1100px;
        margin: 0 auto 2.5rem;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(2, 6, 23, 0.55), 0 0 0 1px rgba(59, 130, 246, 0.18);
    }

    .pricing-hero-img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1672 / 941; /* PC: 横長。CLS防止のため領域を予約 */
    }

    @media (max-width: 768px) {
        .pricing-hero {
            border-radius: 14px;
            margin-bottom: 2rem;
        }
        .pricing-hero-img {
            aspect-ratio: 941 / 1672; /* モバイル: 縦長 */
        }
    }

    /* ヘッダー */
    .pricing-header {
        text-align: center;
        margin-bottom: 4rem;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    .pricing-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .gradient-text {
        background: linear-gradient(to right, #3b82f6, #8b5cf6);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
    }

    .pricing-subtitle {
        font-size: 1.25rem;
        color: #94a3b8;
        line-height: 1.6;
    }

    /* ===== プラン出し分け（Light 会員のみ） =====
       Light 会員には現在プラン(tier 1)と下位(tier 0 = 無料)を出さない。
       プレミアム系(tier 2 以上)は上位プランが存在しないため、意図的に全プランを表示する。
       未ログイン / 無料会員 / 未知プランは data-plan-tier が付かず全プラン表示（fail-open）。 */
    .pricing-upgrade-note {
        display: none;
        margin-top: 1.25rem;
        padding: 0.75rem 1.25rem;
        border: 1px solid rgba(59, 130, 246, 0.4);
        border-radius: 0.75rem;
        background: rgba(59, 130, 246, 0.08);
        color: #cbd5e1;
        font-size: 0.95rem;
    }

    :global(:root[data-plan-tier="1"]) .pricing-upgrade-note {
        display: block;
    }

    /* 2026-09-29 MK 確定: Light 会員にも Light カードを出す（Light の更新・再開を実行できるように）。
       隠すのは無料カードだけ。 */
    :global(:root[data-plan-tier="1"]) .plan-card[data-plan-tier="0"] {
        display: none;
    }

    /* 要素単位のプラン別出し分け（カード内の価格・ボタン・FAQ 等）。
       data-only-for はデフォルト非表示なので、対象プラン以外へは決して漏れない。
       Light 会員以外（未ログイン / 無料 / プレミアム）は data-hide-for 側だけが見える。

       !important は必須。.plan-button など「display を持つクラス」は同じ詳細度で
       後に定義されるため、!important 無しだと乗り換え価格のボタンが全員に見えてしまう。 */
    [data-only-for] {
        display: none !important;
    }

    :global(:root[data-plan-tier="1"]) [data-hide-for="light"] {
        display: none !important;
    }

    /* display の既定値は要素ごとに違うため、復帰値を明示する */
    :global(:root[data-plan-tier="1"]) .faq-item[data-only-for="light"],
    :global(:root[data-plan-tier="1"]) .plan-price[data-only-for="light"],
    :global(:root[data-plan-tier="1"]) .plan-button[data-only-for="light"],
    :global(:root[data-plan-tier="1"]) .recommended-badge[data-only-for="light"] {
        display: block !important;
    }

    :global(:root[data-plan-tier="1"]) .feature-item[data-only-for="light"] {
        display: flex !important;
    }

    /* Light カードは 2026-10-02 に新規募集を停止。有料 Light 会員（tier 1）の更新・再開にだけ出す */
    :global(:root[data-plan-tier="1"]) .plan-card[data-only-for="light"] {
        display: block !important;
    }

    :global(:root[data-plan-tier="1"]) .other-plan-price[data-only-for="light"],
    :global(:root[data-plan-tier="1"]) .other-plan-button[data-only-for="light"] {
        display: inline-block !important;
    }

    /* ===== Stripe 月額（主導線） ===== */
    .plans-lead {
        text-align: center;
        color: #e2e8f0;
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0 0 1.5rem;
        line-height: 1.6;
    }

    .plans-lead span {
        color: #34d399;
        font-size: 1rem;
    }

    .plan-card-recommended .recommended-badge {
        white-space: nowrap;
    }

    .plan-billing-note {
        margin: 0.6rem 0 0;
        text-align: center;
        color: #94a3b8;
        font-size: 0.8rem;
    }

    .plan-description strong {
        color: #34d399;
    }

    .checkout-panel {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(2, 6, 23, 0.75);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .checkout-panel[hidden] {
        display: none;
    }

    .checkout-panel-inner {
        box-sizing: border-box;
        width: 100%;
        max-width: 420px;
        background: #0f172a;
        border: 1px solid rgba(59, 130, 246, 0.4);
        border-radius: 1rem;
        padding: 1.5rem;
    }

    .checkout-panel-title {
        color: #f8fafc;
        font-weight: 700;
        font-size: 1.1rem;
        margin: 0 0 1rem;
    }

    .checkout-email-form .form-input {
        box-sizing: border-box;
        width: 100%;
        margin: 0.4rem 0;
    }

    .checkout-hint {
        color: #94a3b8;
        font-size: 0.85rem;
        margin: 0 0 1rem;
    }

    .checkout-message {
        color: #fbbf24;
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 1rem 0 0;
    }

    .checkout-message a {
        color: #60a5fa;
    }

    .checkout-panel-close {
        margin-top: 1rem;
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        width: 100%;
    }

    /* 銀行振込（年払い・買い切り）は控えめに */
    .other-payments {
        max-width: 760px;
        margin: 2.5rem auto 0;
        border: 1px solid rgba(51, 65, 85, 0.5);
        border-radius: 0.75rem;
        background: rgba(15, 23, 42, 0.5);
        color: #94a3b8;
    }

    .other-payments summary {
        cursor: pointer;
        padding: 0.9rem 1.2rem;
        font-size: 0.9rem;
    }

    .other-payments-body {
        padding: 0 1.2rem 1.2rem;
    }

    .other-plan {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        padding: 0.9rem 0;
        border-top: 1px solid rgba(51, 65, 85, 0.5);
    }

    .other-plan-head {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .other-plan-name {
        color: #cbd5e1;
        font-size: 0.95rem;
    }

    .other-plan-price {
        color: #e2e8f0;
        font-weight: 700;
    }

    .other-plan-price small {
        color: #94a3b8;
        font-weight: 400;
        margin-left: 0.2rem;
    }

    .other-plan-button {
        background: transparent;
        border: 1px solid rgba(148, 163, 184, 0.5);
        color: #cbd5e1;
        border-radius: 0.5rem;
        padding: 0.5rem 0.9rem;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .other-payments-note {
        font-size: 0.8rem;
        margin: 0.6rem 0 0;
    }

    /* 残り 1 枚になっても 4 カラムに引き伸ばされないよう中央寄せ
       （min() で狭い端末でも横溢れさせない） */
    :global(:root[data-plan-tier="1"]) .plans-container {
        grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 380px));
        justify-content: center;
    }

    /* プランカード */
    .plans-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
        max-width: 1400px;
        margin: 0 auto 5rem auto;
    }

    @media (max-width: 1200px) {
        .plans-container {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .plan-card {
        background: rgba(30, 41, 59, 0.8);
        border-radius: 1.5rem;
        padding: 2rem;
        border: 1px solid rgba(51, 65, 85, 0.5);
        position: relative;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .plan-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        border-color: rgba(59, 130, 246, 0.5);
    }

    .plan-card-recommended {
        border: 2px solid #3b82f6;
        transform: scale(1.05);
        background: rgba(59, 130, 246, 0.1);
    }

    .recommended-badge {
        position: absolute;
        top: -1rem;
        left: 50%;
        transform: translateX(-50%);
        background: #3b82f6;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    /* プランヘッダー */
    .plan-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .plan-name {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .plan-price {
        margin-bottom: 1rem;
    }

    .price-amount {
        font-size: 2.5rem;
        font-weight: 700;
        color: #f1f5f9;
    }

    .price-strike {
        font-size: 1.2rem;
        color: #94a3b8;
        text-decoration: line-through;
        margin-bottom: 0.5rem;
    }

    .price-period {
        color: #94a3b8;
        font-size: 1rem;
    }

    .price-period-lifetime {
        color: #10b981;
        font-size: 1.2rem;
        font-weight: 600;
        margin-top: 0.5rem;
    }

    .plan-description {
        color: #94a3b8;
        font-size: 1rem;
    }

    /* 対応会場バッジ */
    .plan-venues {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin: 0 0 1.5rem;
        padding: 0.75rem;
        background: rgba(15, 23, 42, 0.5);
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 12px;
    }

    .plan-venue-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .plan-venue-pill small {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        opacity: 0.85;
        margin-left: 2px;
    }

    .plan-venue-pill--jra {
        background: rgba(16, 185, 129, 0.18);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.4);
    }

    .plan-venue-pill--nankan {
        background: rgba(239, 68, 68, 0.16);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.4);
    }

    .plan-venue-note {
        color: #cbd5e1;
        font-size: 0.78rem;
        font-weight: 600;
        opacity: 0.8;
    }

    /* 機能リスト */
    .plan-features {
        list-style: none;
        margin: 0 0 2rem 0;
        padding: 0;
    }

    .feature-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 1rem;
        gap: 0.75rem;
    }

    .check-icon {
        color: #10b981;
        font-weight: 700;
        flex-shrink: 0;
        margin-top: 0.125rem;
    }

    /* ボタン */
    .plan-button {
        /* 2026-09-27: 幅に余白・枠を含める。<button> は既定で border-box だが、
           無料プランの <a> は content-box のため「100% ＋ 余白 ＋ 枠」でカードからはみ出し、
           スマホで /pricing/ が 401px（390px 画面）まで横に広がっていた。 */
        box-sizing: border-box;
        width: 100%;
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: block;
        text-align: center;
        border: none;
    }

    .plan-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
    }

    .plan-button-free {
        background: #475569;
        color: #e2e8f0;
        border: 2px solid #64748b;
        box-shadow: 0 4px 15px rgba(71, 85, 105, 0.4);
    }

    .plan-button-free:hover {
        background: #64748b;
        border-color: #74859a;
        box-shadow: 0 8px 25px rgba(71, 85, 105, 0.6);
    }

    .plan-button-standard {
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        color: white;
        border: 2px solid #3b82f6;
        box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
    }

    .plan-button-standard:hover {
        background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
        border-color: #1d4ed8;
        box-shadow: 0 8px 25px rgba(59, 130, 246, 0.6);
    }

    .plan-button-premium {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
        border: 2px solid #8b5cf6;
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);
    }

    .plan-button-premium:hover {
        background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
        border-color: #7c3aed;
        box-shadow: 0 8px 25px rgba(139, 92, 246, 0.6);
    }

    .plan-button-lifetime {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        border: 2px solid #f59e0b;
        box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
        animation: glow 2s ease-in-out infinite alternate;
    }

    .plan-button-lifetime:hover {
        background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
        border-color: #d97706;
        box-shadow: 0 8px 25px rgba(245, 158, 11, 0.6);
    }

    @keyframes glow {
        from {
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
        }
        to {
            box-shadow: 0 8px 30px rgba(245, 158, 11, 0.8);
        }
    }

    .plan-button-annual {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        border: 2px solid #10b981;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    }

    .plan-button-annual:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%);
        border-color: #059669;
        box-shadow: 0 8px 25px rgba(16, 185, 129, 0.6);
    }

    .plan-button-monthly {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
        border: 2px solid #8b5cf6;
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);
    }

    .plan-button-monthly:hover {
        background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
        border-color: #7c3aed;
        box-shadow: 0 8px 25px rgba(139, 92, 246, 0.6);
    }

    /* FAQ */
    .faq-section {
        max-width: 800px;
        margin: 0 auto;
    }

    .faq-title {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 3rem;
    }

    .faq-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .faq-item {
        background: rgba(30, 41, 59, 0.6);
        border-radius: 0.75rem;
        padding: 1.5rem;
        border: 1px solid rgba(51, 65, 85, 0.3);
    }

    .faq-question {
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: #f1f5f9;
    }

    .faq-answer {
        color: #94a3b8;
        line-height: 1.6;
        margin: 0;
    }

    .faq-answer a {
        color: #60a5fa;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .faq-answer a:hover {
        color: #93c5fd;
    }

    /* レスポンシブ */
    @media (max-width: 768px) {
        .pricing-title {
            font-size: 2rem;
        }

        .pricing-subtitle {
            font-size: 1.125rem;
        }

        .plan-card-recommended {
            transform: scale(1);
        }

        .plans-container {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .plan-card {
            padding: 1.5rem;
        }

        .price-amount {
            font-size: 2rem;
        }
    }

    @media (max-width: 480px) {
        .pricing-page {
            padding: 1rem 0.5rem;
        }

        .pricing-header {
            margin-bottom: 2rem;
        }

        .pricing-title {
            font-size: 1.75rem;
        }

        .pricing-subtitle {
            font-size: 1rem;
        }

        /* モバイルでのボタン視認性強化 */
        .plan-button {
            padding: 1rem 1.5rem;
            font-size: 1.1rem;
            font-weight: 700;
        }

        .plan-button-free {
            border-width: 3px;
        }

        .plan-button-standard {
            border-width: 3px;
        }

        .plan-button-premium {
            border-width: 3px;
        }
    }

    /* 銀行振込モーダル */
    .bank-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.8);
      z-index: 10000;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .bank-modal.active {
      display: flex;
    }

    .bank-modal-content {
      background: linear-gradient(135deg, #1e293b, #0f172a);
      border: 2px solid rgba(59, 130, 246, 0.5);
      border-radius: 16px;
      padding: 2.5rem;
      max-width: 600px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
    }

    .bank-modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(239, 68, 68, 0.2);
      border: 1px solid rgba(239, 68, 68, 0.5);
      color: #ef4444;
      font-size: 1.5rem;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s;
    }

    .bank-modal-close:hover {
      background: rgba(239, 68, 68, 0.3);
      transform: rotate(90deg);
    }

    .bank-modal-title {
      font-size: 1.8rem;
      font-weight: bold;
      color: #60a5fa;
      margin-bottom: 1rem;
      text-align: center;
    }

    .modal-plan-info {
      text-align: center;
      color: #10b981;
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .bank-info-box {
      background: rgba(59, 130, 246, 0.1);
      border: 2px solid rgba(59, 130, 246, 0.3);
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 2rem;
    }

    .bank-info-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      background: rgba(15, 23, 42, 0.6);
      border-radius: 8px;
      margin-bottom: 1rem;
    }

    .bank-info-item:last-child {
      margin-bottom: 0;
    }

    .bank-info-label {
      color: #94a3b8;
      font-size: 0.95rem;
      font-weight: 500;
    }

    .bank-info-value {
      color: #e2e8f0;
      font-size: 1.1rem;
      font-weight: 600;
      text-align: right;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .copy-button {
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: white;
      border: none;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.3s;
      white-space: nowrap;
    }

    .copy-button:hover {
      background: linear-gradient(135deg, #2563eb, #1e40af);
      transform: translateY(-2px);
    }

    .bank-steps {
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .bank-steps-title {
      font-size: 1.2rem;
      font-weight: bold;
      color: #10b981;
      margin-bottom: 1rem;
    }

    .bank-step {
      display: flex;
      gap: 12px;
      margin-bottom: 1rem;
      color: #cbd5e1;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .bank-step:last-child {
      margin-bottom: 0;
    }

    .bank-step-number {
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 0.9rem;
      flex-shrink: 0;
    }

    .bank-form-section {
      background: rgba(16, 185, 129, 0.05);
      border: 2px solid rgba(16, 185, 129, 0.3);
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 2rem;
    }

    .bank-form-title {
      font-size: 1.3rem;
      font-weight: bold;
      color: #10b981;
      margin-bottom: 0.8rem;
      text-align: center;
    }

    .bank-form-note {
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.3);
      border-radius: 8px;
      padding: 0.8rem 1rem;
      margin-bottom: 1.5rem;
      color: #fbbf24;
      font-size: 0.9rem;
      line-height: 1.6;
      text-align: center;
    }

    .bank-form {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .form-label {
      color: #cbd5e1;
      font-size: 0.95rem;
      font-weight: 600;
    }

    .required {
      color: #ef4444;
      margin-left: 4px;
    }

    .form-input {
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(51, 65, 85, 0.5);
      color: #e2e8f0;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      font-size: 1rem;
      transition: all 0.3s;
    }

    .form-input:focus {
