---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import CampaignBanner from '../components/CampaignBanner.astro';
import { buildPlanTierByToken } from '../lib/pricing/planTiers.js';
import { LIGHT_SWITCH_GRACE_DAYS } from '../lib/pricing/pricingEligibility.js';
import { SUBSCRIPTION_SALES_OPEN, ACTIVE_SUBSCRIPTION_PROVIDER } from '../lib/billing/cardSales.js';
import { STRIPE_PLANS } from '../lib/billing/stripePlans.js';
import { PAYPAL_PLAN_IDS, ANNUAL_SUBSCRIPTION_PLANS } from '../lib/billing/paypal/paypalSubscriptionCore.js';

// 正規化済みプラン名 → tier。インライン script へ焼き込む（別名表の単一源は planNormalization.js）
const planTierByToken = buildPlanTierByToken();

// 月額（PayPal の定期課金・2026-10-15 MK 決定）。本番は SUBSCRIPTION_SALES_OPEN を true にする PR だけで表示する。
// Deploy Preview（Sandbox 検証）では表示する（申込はサーバー側で Sandbox 鍵のときだけ通る）。
const showMonthly = SUBSCRIPTION_SALES_OPEN[ACTIVE_SUBSCRIPTION_PROVIDER] === true || process.env.CONTEXT === 'deploy-preview';
const MONTHLY_COPY = {
  'premium': { name: 'Premium 中央＋南関', desc: '中央版＋南関版のセットなら<strong>¥980 お得</strong>', scope: '中央・南関', pills: ['jra', 'nankan'], note: '両方', recommended: true },
  'premium-jra': { name: 'Premium 中央版', desc: '週末の中央競馬だけで勝負したい方に', scope: '中央', pills: ['jra'], note: '中央のみ' },
  'premium-nankan': { name: 'Premium 南関版', desc: '平日の南関競馬だけで勝負したい方に', scope: '南関', pills: ['nankan'], note: '南関のみ' },
};
// 年払いの PayPal 年額定期課金（12 か月ごと自動更新・2026-10-20 MK 決定）。買い切りは銀行振込だけ（カード・PayPal の入口を置かない）。
// 本番は月額と同じ受付（SUBSCRIPTION_SALES_OPEN）かつ Live の年額 Plan ID が登録済みのときだけ表示する（未登録の間は出さない＝押しても申し込めない状態を作らない）。
const annualLivePlans = ANNUAL_SUBSCRIPTION_PLANS.every((p) => Boolean(PAYPAL_PLAN_IDS.live?.[p.id]));
const showAnnualSub = (SUBSCRIPTION_SALES_OPEN[ACTIVE_SUBSCRIPTION_PROVIDER] === true && annualLivePlans) || process.env.CONTEXT === 'deploy-preview';
const monthlyPlans = STRIPE_PLANS.map((p) => ({ ...p, copy: MONTHLY_COPY[p.id] }));
---

<BaseLayout title="料金プラン">
    <!-- 期間限定のご優待。文言・金額・期限・行き先はサーバーが返す（ここには書かない）-->
    <CampaignBanner />
    <!-- プラン出し分け: カードが描画される前に <html> へ現在プランの tier を付ける。
         判定は CSS 側（下位カードの display:none）で行うため、ちらつきなく確定する。
         define:vars は is:inline を含意するので、この script はパース時に同期実行される。

         ⚠️ ここで出し分ける「Light 会員向け乗り換え特典価格」は **課金契約に紐づく価格資格**。
            無料特典（promotional grant）で Light / Premium が見られるようになった顧客には
            出さない。無料特典の顧客へ特別価格を出したいときは PromotionalOffer で
            明示的に発行する（/offer/ 経路）。判定の単一源は
            src/lib/pricing/pricingEligibility.js（サーバーで算出して user-plan.pricingTier に渡す）。 -->
    <script define:vars={{ planTierByToken, graceDays: LIGHT_SWITCH_GRACE_DAYS }}>
      (function () {
        try {
          // 退会申請は無料相当。出し分けせず全プランを見せる（fail-open）
          if (localStorage.getItem('isWithdrawalRequested') === 'true') return;
          // 2026-09-29 MK 確定: 有効期限の終わり + graceDays（30）日を過ぎたら会員向け価格は出さない
          // （サーバー判定 pricingEligibility.js の LIGHT_SWITCH_GRACE_DAYS と同じ値。古いセッションの tier を使い続けない）
          const validUntil = localStorage.getItem('validUntil');
          const vuMs = validUntil && validUntil !== 'null'
            ? (/^\d{4}-\d{2}-\d{2}$/.test(validUntil) ? Date.parse(validUntil + 'T23:59:59.999+09:00') : Date.parse(validUntil))
            : NaN;
          if (Number.isFinite(vuMs) && Date.now() > vuMs + graceDays * 86400000) return;

          // dashboard.astro / AccessControl.astro と同じ取得順
          let raw = '';
          let up = null;
          const stored = localStorage.getItem('user-plan');
          if (stored) {
            try { up = JSON.parse(stored) || null; } catch (_) {}
            raw = (up && up.plan) || '';
          }

          // Premium（両会場）を**いま**ご契約中の方には、同じプランの購入ボタンを出さない（2026-10-02）。
          // 期限が読めて過去なら出す＝再契約できる状態を壊さない。
          if (up && typeof up.pricingTier === 'number' && up.pricingTier >= 2
            && !(Number.isFinite(vuMs) && vuMs < Date.now())) {
            document.documentElement.setAttribute('data-premium-active', '1');
          }

          // 🔒 価格資格はサーバーが課金契約だけから決めた pricingTier を最優先で使う。
          //    無料特典しか無い顧客は 0 になり、会員向け価格は出ない。
          if (up && typeof up.pricingTier === 'number') {
            if (up.pricingTier > 0) {
              document.documentElement.setAttribute('data-plan-tier', String(up.pricingTier));
            }
            return; // サーバー判定があるならプラン名からの推測はしない
          }
          // サーバー判定が無い古いセッション: 期限切れは従来どおり出し分けない
          if (localStorage.getItem('isExpired') === 'true') return;
          if (Number.isFinite(vuMs) && vuMs < Date.now()) return;
          // 🔒 pricingTier が無い応答でも、根拠が無料特典と分かっているなら出し分けない
          if (up && up.entitlementSource === 'promotional_grant') return;

          if (!raw) raw = localStorage.getItem('user_plan') || localStorage.getItem('userPlan') || '';
          if (!raw) return;

          // normalizePlanToken(src/lib/auth/planNormalization.js) と同一の正規化。変更時は両方直すこと
          const token = String(raw).normalize('NFKC').trim().toLowerCase().replace(/[\s_]+/g, '-');
          const tier = planTierByToken[token];
          if (typeof tier !== 'number') return; // 未知プランは fail-open

          document.documentElement.setAttribute('data-plan-tier', String(tier));
        } catch (_) {}
      })();
    </script>

    <div class="pricing-page">
        <!-- ヘッダー -->
        <div class="pricing-header">
            <h1 class="pricing-title">
                🚀 <span class="gradient-text">AI予想で勝つ</span>
            </h1>
            <p class="pricing-subtitle">
                Premium（中央＋南関）は、年払い・買い切りの銀行振込でお申し込みいただけます。
            </p>
            <!-- Light 会員のときだけ CSS で表示（上位プランのみに絞っている旨の説明） -->
            <p class="pricing-upgrade-note">
                <strong>Light 会員さまへ：</strong><strong>中央＋南関の全レース</strong>の買い目が見られる <strong>Premium 年払い</strong>を、Light会員さま限定の乗り換え特典価格（<strong>¥44,820/年</strong>）でお申し込みいただけます。
            </p>
        </div>

        <!-- プラン比較カード（2026-10-11 MK 確定: 新規の月払いは全面停止。販売は銀行振込の年払い・買い切りだけ）
             月払いの再開は MK の次回明示決定まで行わない（stripePlans.js の MONTHLY_SALES_OPEN）。
             金額・商品・販売条件は従来どおり（年払い ¥49,800／Light 会員 ¥44,820・買い切り ¥78,000）。 -->
        <p class="plans-lead">中央＋南関の全レースを、<br><span>年払い・買い切りで。</span></p>
        <!-- Premium（両会場）をご契約中の方にだけ CSS で表示（同じプランの購入ボタンの代わり）-->
        <div class="premium-member-note">
            <p>Premium をご利用中です。ご契約内容はマイページでご確認いただけます。</p>
            <p class="premium-member-links">
                <a href="/sanrenpuku-demo/" class="plan-button plan-button-annual">次は三連複を見る</a>
                <a href="/dashboard/" class="plan-button plan-button-free">マイページへ</a>
            </p>
        </div>
        <div class="plans-container plans-container--stripe">
            <!-- Premium 年払い（銀行振込）-->
            <div class="plan-card plan-card-recommended" data-plan-tier="2" data-bank-plan="annual">
                <div class="recommended-badge" data-only-for="light">
                    <span>⬆️ Light会員さま乗り換え特典</span>
                </div>
                <div class="plan-header">
                    <h3 class="plan-name">Premium 年払い</h3>
                    <div class="plan-price" data-hide-for="light">
                        <span class="price-amount">¥49,800</span>
                        <span class="price-period">/年</span>
                    </div>
                    <div class="plan-price" data-only-for="light">
                        <span class="price-amount">¥44,820</span>
                        <span class="price-period">/年</span>
                    </div>
                    <p class="plan-description">中央＋南関の全レースを 1 年間</p>
                </div>

                <div class="plan-venues" aria-label="対応会場">
                    <span class="plan-venue-pill plan-venue-pill--jra">🏇 中央<small>JRA</small></span>
                    <span class="plan-venue-pill plan-venue-pill--nankan">🏁 南関</span>
                    <span class="plan-venue-note">両方</span>
                </div>

                <ul class="plan-features">
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span><strong>中央・南関の全レース、予想を取得し放題</strong></span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>高精度AI予想・詳細な投資戦略</span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>平日（南関）も週末（中央）も</span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>優先サポート</span>
                    </li>
                </ul>

                <button type="button" class="plan-button plan-button-annual" data-hide-for="light" onclick="openBankModal('Premium Annual', 49800, 'annual')">
                    🏦 銀行振込で申し込む
                </button>
                <!-- 「- Campaign」は bank-transfer-application.js が除去して planName='Premium' /
                     planType='Annual' に正規化する既存パターン。別の接尾辞にすると Airtable の
                     Single select が不正値になり登録が落ちる（エラーは握りつぶされる） -->
                <button type="button" class="plan-button plan-button-annual" data-only-for="light" onclick="openBankModal('Premium Annual - Campaign', 44820, 'annual')">
                    🏦 乗り換え特典価格で申し込む
                </button>
                <p class="plan-billing-note">銀行振込・1 年ごとのお支払い</p>
                {showAnnualSub && (
                    <>
                        {/* 年額の定期課金（PayPal）。送るのは商品 ID だけ（金額・Light 特典の資格はサーバーが決める）。 */}
                        <button type="button" class="plan-button plan-button-credit" data-hide-for="light" data-subscription="premium-annual">
                            💳 クレジットカードで申し込む（自動更新）
                        </button>
                        <button type="button" class="plan-button plan-button-credit" data-only-for="light" data-subscription="premium-annual-light">
                            💳 乗り換え特典価格をカードで申し込む（自動更新）
                        </button>
                        <div class="annual-renewal-terms" data-annual-terms>
                            <p><strong>カード（PayPal）の年払いは自動更新です。</strong></p>
                            <ul>
                                <li>12 か月ごとに、お申し込み時と同じ金額で自動的に更新・請求されます（決済代行：PayPal）。</li>
                                <li>更新を止めるには、PayPal のアカウントで自動支払いを停止してください。次回から請求されず、支払い済みの 12 か月が終わるまでご利用いただけます。</li>
                                <li>マイページ「アカウント管理」の「退会する」でも止められます。退会はその時点でご利用終了となり、残りの期間の返金はありません。</li>
                            </ul>
                        </div>
                    </>
                )}
            </div>

            <!-- Premium 買い切り（銀行振込）-->
            <div class="plan-card" data-plan-tier="2" data-bank-plan="lifetime">
                <div class="plan-header">
                    <h3 class="plan-name">Premium 買い切り</h3>
                    <div class="plan-price">
                        <span class="price-amount">¥78,000</span>
                        <span class="price-period">/一度きり</span>
                    </div>
                    <p class="plan-description">中央＋南関の全レースを期限なく</p>
                </div>

                <div class="plan-venues" aria-label="対応会場">
                    <span class="plan-venue-pill plan-venue-pill--jra">🏇 中央<small>JRA</small></span>
                    <span class="plan-venue-pill plan-venue-pill--nankan">🏁 南関</span>
                    <span class="plan-venue-note">両方</span>
                </div>

                <ul class="plan-features">
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span><strong>中央・南関の全レース、予想を取得し放題</strong></span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>高精度AI予想・詳細な投資戦略</span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>更新のお手続き不要</span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>優先サポート</span>
                    </li>
                </ul>

                <button type="button" class="plan-button plan-button-monthly" onclick="openBankModal('Premium Lifetime', 78000, 'lifetime')">
                    🏦 銀行振込で申し込む
                </button>
                <p class="plan-billing-note">銀行振込・一度きりのお支払い</p>
            </div>

            <!-- 無料プラン -->
            <div class="plan-card" data-plan-tier="0">
                <div class="plan-header">
                    <h3 class="plan-name">無料プラン</h3>
                    <div class="plan-price">
                        <span class="price-amount">¥0</span>
                    </div>
                    <p class="plan-description">お試ししたい方に</p>
                </div>

                <div class="plan-venues" aria-label="対応会場">
                    <span class="plan-venue-pill plan-venue-pill--jra">🏇 中央<small>JRA</small></span>
                    <span class="plan-venue-pill plan-venue-pill--nankan">🏁 南関</span>
                    <span class="plan-venue-note">両方対応</span>
                </div>

                <ul class="plan-features">
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>無料予想</span>
                    </li>
                    <li class="feature-item">
                        <span class="check-icon">✓</span>
                        <span>予想結果の確認</span>
                    </li>
                </ul>

                <a href="/free-signup/" class="plan-button plan-button-free">
                    無料会員登録
                </a>
            </div>
        </div>


        {showMonthly && (
            <section class="monthly-section" aria-label="クレジット決済">
                {/* 月額（PayPal の定期課金・2026-10-15 MK 決定）。金額の正本は stripePlans.STRIPE_PLANS（請求は PayPal の Plan）。
                     2026-10-15 MK 指示: 主役は年払い・買い切り（銀行振込）。ここは「銀行振込が難しい方」向けの控えめな選択肢。
                     「月額で始める」「毎月自動更新」「PayPal」を前面に出さない（見出し・ボタンは「クレジット決済」）。
                     自動で継続する支払いであること・決済代行は、ボタン下の注記と FAQ に事実として残す（隠さない）。
                     ボタンは data-monthly="<planId>" → 下の startMonthly() → monthly-create-checkout（決済会社は選ばせない）。 */}
                <p class="plans-lead plans-lead--sub">クレジット決済<br><span>クレジットカード決済はこちら</span></p>
                <div class="plans-container plans-container--stripe">
                    {monthlyPlans.map((p) => (
                        <div class="plan-card" data-plan-tier="2" data-monthly-plan={p.id}>
                            <div class="plan-header">
                                <h3 class="plan-name">{p.copy.name}</h3>
                                <div class="plan-price">
                                    <span class="price-amount">¥{p.amountYen.toLocaleString('ja-JP')}</span>
                                    <span class="price-period">/月</span>
                                </div>
                                <p class="plan-description" set:html={p.copy.desc} />
                            </div>
                            <div class="plan-venues" aria-label="対応会場">
                                {p.copy.pills.includes('jra') && <span class="plan-venue-pill plan-venue-pill--jra">🏇 中央<small>JRA</small></span>}
                                {p.copy.pills.includes('nankan') && <span class="plan-venue-pill plan-venue-pill--nankan">🏁 南関</span>}
                                <span class="plan-venue-note">{p.copy.note}</span>
                            </div>
                            <ul class="plan-features">
                                <li class="feature-item"><span class="check-icon">✓</span><span><strong>{p.copy.scope}の全レース、予想を取得し放題</strong></span></li>
                                <li class="feature-item"><span class="check-icon">✓</span><span>高精度AI予想・詳細な投資戦略</span></li>
                                <li class="feature-item"><span class="check-icon">✓</span><span>優先サポート</span></li>
                            </ul>
                            <button type="button" class="plan-button plan-button-credit" data-monthly={p.id}>
                                クレジットカードで申し込む
                            </button>
                            <p class="plan-billing-note">※自動継続のお支払い（決済代行：PayPal）</p>
                        </div>
                    ))}
                </div>
                <div class="checkout-message" id="monthlyMessage" role="status" hidden></div>
            </section>
        )}

        <!-- 使い方（2026-10-05 MK: 取得し放題の趣旨を申込前に伝える） -->
        <section class="howto" aria-label="ご利用の流れ">
            <h2 class="howto-title">ご利用の流れ</h2>
            <ol class="howto-steps">
                <li><span class="howto-num">1</span><b>レースを選ぶ</b><small>今日の中央・南関のレース一覧から、気になるレースを選びます</small></li>
                <li><span class="howto-num">2</span><b>予想を取得</b><small>ボタンひとつで、そのレースの予想（買い目・印・AI 総合指数・過去走）を取得。何件でも取得できます</small></li>
                <li><span class="howto-num">3</span><b>結果で答え合わせ</b><small>レース後は、取得した予想の的中・不的中と払戻をマイページで確認できます</small></li>
            </ol>
        </section>

        <!-- Light の更新・再開（既存の有料 Light 会員だけ。新規募集は 2026-10-02 停止）-->
        <details class="other-payments" id="otherPayments" data-only-for="light">
            <summary>Light の更新・再開をご希望の方</summary>
            <div class="other-payments-body">
                <!-- Light の更新・再開（2026-10-02〜 新規募集停止。既存の有料 Light 会員だけに表示する補助導線。
                     主に案内するのは Premium 年払い（乗り換え特典 ¥44,820/年）への変更）-->
                <div class="other-plan" data-only-for="light">
                    <div class="other-plan-head">
                        <span class="other-plan-name">Light の更新・再開（Light 会員さま）</span>
                        <span class="other-plan-price">¥4,980<small>/30日・メインレースのみ</small></span>
                    </div>
                    <button class="other-plan-button" onclick="openBankModal('Light', 4980, 'monthly')">🏦 銀行振込で更新する</button>
                </div>
                <p class="other-payments-note">銀行振込は、お振込み後に報告フォームをご送信いただき、入金確認後にご利用開始となります。</p>
            </div>
        </details>

        <!-- FAQ -->
        <div class="faq-section">
            <h2 class="faq-title">よくある質問</h2>
            
            <div class="faq-container">
                <!-- FAQ の出し分け（プラン別）:
                     data-hide-for="light" … Light 会員には不要な話題（現在プラン以下の説明）
                     data-only-for="light" … Light 会員にだけ出す話題（アップグレード比較・手順）
                     属性なし … 全員に出す。未ログイン / 無料 / プレミアムは全項目表示 -->
                <div class="faq-item" data-hide-for="light">
                    <h3 class="faq-question">Q: 無料プランでも予想は見れますか？</h3>
                    <p class="faq-answer">
                        はい。無料プランでも全レースの無料予想（AI指数・印・分析）をご覧いただけます。<br>
                        買い目は有料プランでのご提供ですが、前日の有料メインレース買い目とその結果は「昨日の買い目」ページで公開しています。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: Premium では何が見られますか？</h3>
                    <p class="faq-answer">
                        全レース（1R〜12R）の中から、気になるレースの予想（買い目・印・AI 総合指数・過去走）を 1 件ずつ取得できます。取得できる回数に上限はありません。加えて、詳細な投資戦略と優先サポートをご利用いただけます。<br>
                        中央（JRA）・南関の両方のすべてのレースが対象です。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 取得できる回数に上限はありますか？</h3>
                    <p class="faq-answer">
                        ありません。追加料金なしで、対象のレースの予想を何件でも取得できます。取得した予想はマイページの「取得済みの予想」に残り、レース後の結果（的中・不的中）もそこで確認できます。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 買い目は何点ですか？</h3>
                    <p class="faq-answer">
                        買い目は<a href="/results-showcase/nankan/">昨日の買い目（南関）</a>・<a href="/results-showcase/jra/">昨日の買い目（中央）</a>で公開しています。ご購入前にご確認ください。
                    </p>
                </div>

                <div class="faq-item" data-only-for="light">
                    <h3 class="faq-question">Q: 乗り換え特典とは何ですか？</h3>
                    <p class="faq-answer">
                        Light会員さまがプレミアム年払いへ切り替える際、<strong>無条件で ¥4,980 割引</strong>する特典です。<br>
                        通常 ¥49,800/年 のところ <strong>¥44,820/年</strong>（月額換算 ¥3,735）でご利用いただけます。残り日数の申告は不要です。
                    </p>
                </div>

                <div class="faq-item" data-only-for="light">
                    <h3 class="faq-question">Q: Light から Premium への変更手順は？</h3>
                    <p class="faq-answer">
                        上の「Premium 年払い」の「🏦 乗り換え特典価格で申し込む」から銀行振込でお申し込みください。入金確認後に Premium をご利用いただけます。Light は更新のお手続きをしなければ、有効期限で終了します。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 支払い方法は何が利用できますか？</h3>
                    <p class="faq-answer">
                        Premium の年払い・買い切りは銀行振込でお申し込みいただけます。<br>
                        銀行振込が難しい方は、クレジット決済（Premium・中央版・南関版）もご利用いただけます。決済代行は PayPal で、お支払いは自動で継続されます。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: クレジット決済の解約（退会）は？</h3>
                    <p class="faq-answer">
                        退会のお手続きは、ログイン後のマイページの「アカウント管理」の「退会する」からだけ行えます（確認画面のあとに確定します）。以降のお支払いはその時点で止まります。<br>
                        退会すると、現在の利用期限を待たずにすぐにご利用いただけなくなり、以降の請求はありません。残りの期間のご利用を希望される場合は、退会せずにそのままご利用ください。最低利用期間はなく、日割りでの返金は行っておりません。退会後もログインして無料予想をご利用いただけます。再びご利用の場合は新しくお申し込みいただけます。<br>
                        銀行振込のプラン（年払い・買い切り）は自動更新・継続課金がないため、退会のお手続きはありません。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 年払い・買い切りはありますか？</h3>
                    <p class="faq-answer">
                        はい。上の「Premium 年払い」「Premium 買い切り」から銀行振込でお申し込みいただけます。<br>
                        年払いは ¥49,800/年（1年間）、買い切りは ¥78,000 の一度きりのお支払いで期限なくご利用いただけます。どちらも中央・南関の両方が対象です。
                    </p>
                </div>

                <!-- 銀行振込の手順は銀行振込モーダル内の .bank-steps と必ず一致させること（振込が先） -->
                <div class="faq-item">
                    <h3 class="faq-question">Q: 利用開始までの流れは？</h3>
                    <p class="faq-answer">
                        <strong>【銀行振込】</strong>①お振込み → ②振込完了後、報告フォームをご送信 → ③入金確認後、ご利用開始です。フォームは<strong>お振込みが済んでから</strong>ご送信ください。<br>
                        <strong>【クレジット決済】</strong>①ログイン（無料会員登録） → ②「クレジットカードで申し込む」 → ③決済画面（PayPal）でお支払いを承認 → ④すぐにご利用開始です。
                    </p>
                </div>

                <div class="faq-item">
                    <h3 class="faq-question">Q: 更新や有効期限はどうなりますか？</h3>
                    <p class="faq-answer">
                        銀行振込の年払いは、有効期限が近づきましたらメールでお知らせいたします。継続をご希望の場合は、再度お振込みいただくことで延長できます。<br>
                        クレジット決済は毎月同じ日に自動で継続され、お支払いが確認できるたびに利用期限が延びます。お支払いが止まった場合は、支払い済みの期間が終わるとご利用いただけなくなります。
                    </p>
                </div>

            </div>
        </div>
    </div>

    <!-- 銀行振込モーダル -->
    <div class="bank-modal" id="bankModal">
      <div class="bank-modal-content">
        <button class="bank-modal-close" onclick="closeBankModal()">×</button>

        <h2 class="bank-modal-title">🏦 銀行振込でのお申し込み</h2>
        <p class="modal-plan-info" id="modalPlanInfo"></p>

        <div class="bank-info-box">
          <div class="bank-info-item">
            <span class="bank-info-label">振込先銀行</span>
            <span class="bank-info-value">PayPay銀行
              <button class="copy-button" onclick="copyToClipboard('PayPay銀行')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">支店名</span>
            <span class="bank-info-value">本店営業部
              <button class="copy-button" onclick="copyToClipboard('本店営業部')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">口座種別</span>
            <span class="bank-info-value">普通</span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">口座番号</span>
            <span class="bank-info-value">8307337
              <button class="copy-button" onclick="copyToClipboard('8307337')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item">
            <span class="bank-info-label">口座名義</span>
            <span class="bank-info-value">ｳｴﾌﾞｹｲﾊﾞ
              <button class="copy-button" onclick="copyToClipboard('ｳｴﾌﾞｹｲﾊﾞ')">コピー</button>
            </span>
          </div>
          <div class="bank-info-item" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3);">
            <span class="bank-info-label">振込金額</span>
            <span class="bank-info-value" style="color: #10b981; font-size: 1.3rem;" id="modalAmount">¥5,980</span>
          </div>
        </div>

        <div class="bank-steps">
          <div class="bank-steps-title">📝 お申し込み手順</div>
          <div class="bank-step">
            <span class="bank-step-number">1</span>
            <span>上記の口座情報に振込金額をお振込みください</span>
          </div>
          <div class="bank-step">
            <span class="bank-step-number">2</span>
            <span>振込完了後、下記のフォームから必要情報をご送信ください</span>
          </div>
          <div class="bank-step">
            <span class="bank-step-number">3</span>
            <span>入金確認取れ次第、即時にログイン情報をメールでお送りいたします</span>
          </div>
        </div>

        <!-- 銀行振込申し込みフォーム -->
        <div class="bank-form-section">
          <div class="bank-form-title">💳 銀行振込完了の報告フォーム</div>
          <div class="bank-form-note">
            ※ こちらは <strong>銀行振込完了後</strong> にご送信いただくフォームです。<br>
            事前予約や <strong>未入金状態での申し込みフォームではありません</strong>。<br>
            必ず銀行振込を済ませてから送信してください。
          </div>

          <form id="bankTransferForm" class="bank-form">
            <div class="form-group">
              <label for="fullName" class="form-label">お名前 <span class="required">*</span></label>
              <input type="text" id="fullName" name="fullName" class="form-input" required placeholder="山田 太郎">
            </div>

            <div class="form-group">
              <label for="email" class="form-label">メールアドレス <span class="required">*</span></label>
              <input type="email" id="email" name="email" class="form-input" required placeholder="example@email.com">
            </div>


            <div class="form-group">
                <label for="transferDate" class="form-label">振込完了日 <span class="required">*</span></label>
                <input type="date" id="transferDate" name="transferDate" class="form-input" required>
                <div class="form-hint">※ 未来の日付は選択できません。実際に振込が完了した日をご入力ください。</div>
              </div>


            <div class="form-group">
              <label for="transferAmount" class="form-label">振込金額 <span class="required">*</span></label>
              <input type="number" id="transferAmount" name="transferAmount" class="form-input" required readonly>
            </div>

            <div class="form-group">
              <label for="remarks" class="form-label">備考・ご要望</label>
              <textarea id="remarks" name="remarks" class="form-input" rows="3" placeholder="何かご要望がありましたらご記入ください（任意）"></textarea>
            </div>

            <div class="form-group form-confirm-group">
              <label class="form-confirm-label">
                <input type="checkbox" id="paymentCompletedConfirm" name="paymentCompletedConfirm" class="form-confirm-checkbox" required>
                <span class="form-confirm-text">
                  銀行振込を完了済みです。このフォームは入金後の報告専用であることを確認しました。
                  <span class="required">*</span>
                </span>
              </label>
            </div>

            <button type="submit" class="form-submit-button" id="submitButton">
              <span class="submit-text">📨 入金完了を報告する</span>
              <span class="submit-loading" style="display: none;">送信中...</span>
            </button>

            <div class="form-message" id="formMessage" style="display: none;"></div>
          </form>
        </div>

        <div class="bank-warning">
          <div class="bank-warning-title">⚠️ ご注意事項</div>
          <div class="bank-warning-text">
            ・<strong>本フォームは振込完了の報告用です</strong>。送信前に必ず銀行振込を完了してください<br>
            ・<strong>振込完了日は未来の日付では送信できません</strong><br>
            ・振込手数料はお客様負担となります<br>
            ・土日祝日の場合、確認が翌営業日となる場合がございます<br>
            ・<strong>お名前と同じ名義で振込をお願いします</strong><br>
            ・名義が異なる場合は、備考欄にその旨をご記入ください<br>
            ・ご入金後のキャンセル・返金は承っておりません
          </div>
        </div>
      </div>
    </div>
</BaseLayout>

<script is:inline>
  // ── 月額（PayPal の定期課金・2026-10-15 MK 決定）の申込 ─────────────
  // 金額はサーバー（PayPal の Plan）が決める。送るのはプラン ID（と未ログインのときだけメールアドレス）。
  // 2026-10-21: 無料会員はセッションを持たないため、ログイン必須だと無料会員・初めての方が申し込めなかった。
  // 未ログインはサーバーが email_required を返す → 押したカードの下でメールアドレスを入力して進む（旧 Stripe 月額と同じ）。
  (function () {
    var msg = document.getElementById('monthlyMessage');
    if (!msg) return;
    var busy = false;
    // 押したボタンのすぐ下に出す（3 枚の下にまとめて出すと、画面の端に隠れて「押しても何も起きない」に見えた）
    function show(html, btn) {
      msg.innerHTML = html; msg.hidden = false;
      var card = btn && btn.closest('.plan-card');
      if (card) card.appendChild(msg);
      msg.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
    function esc(v) { return String(v).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; }); }
    // 無料会員としてログイン中なら、そのメールアドレスを入れておく（確認して進める。自動では送らない）
    function savedEmail() {
      try { var e = localStorage.getItem('isLoggedIn') === 'true' ? (localStorage.getItem('userEmail') || '') : ''; return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e) ? e : ''; } catch (_) { return ''; }
    }
    function askEmail(planId, btn, note, value) {
      show((note ? '<span class="checkout-email-note">' + note + '</span>' : '')
        + '<form class="checkout-email-form" novalidate>'
        + '<label class="form-label" for="monthlyEmail">ご利用になるメールアドレス</label>'
        + '<input type="email" id="monthlyEmail" class="form-input" required autocomplete="email" placeholder="example@email.com" value="' + esc(value || savedEmail()) + '">'
        + '<small>お申し込み後のログインに使います（ログインリンクをこのアドレスへお送りします）。</small>'
        + '<button type="submit">決済へ進む</button>'
        + '</form>', btn);
      var form = msg.querySelector('form');
      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var v = String(form.querySelector('input').value || '').trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return askEmail(planId, btn, 'メールアドレスをご確認ください。', v);
        startMonthly(planId, btn, v);
      });
      var input = form.querySelector('input');
      if (input && !input.value) input.focus();
    }
    async function startMonthly(planId, btn, email) {
      if (busy) return;
      busy = true; btn.disabled = true;
      var label = btn.textContent;
      btn.textContent = '決済画面へ移動しています…';
      msg.hidden = true;
      var leaving = false;
      try {
        var res = await fetch('/.netlify/functions/monthly-create-checkout', {
          method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(email ? { plan: planId, email: email } : { plan: planId }),
        });
        var data = await res.json().catch(function () { return {}; });
        if (res.ok && data.url) { leaving = true; location.href = data.url; return; }
        var err = data.error || '';
        // 未ログインはそのままログインへ（ログイン後はこのページへ戻る）
        if (err === 'login_required') { leaving = true; btn.textContent = 'ログイン画面へ移動しています…'; location.href = '/login/?next=/pricing/'; return; }
        // 未ログイン: メールアドレスで申し込む（無料会員・初めての方）
        if (err === 'email_required') return askEmail(planId, btn);
        if (err === 'invalid_email') return askEmail(planId, btn, 'メールアドレスをご確認ください。', email);
        if (err === 'account_conflict' || err === 'account_unavailable') return show('このメールアドレスではお申し込みを受け付けられませんでした。お手数ですが<a href="/contact/">お問い合わせ</a>ください。', btn);
        if (err === 'lifetime_bank_transfer_only') return show('買い切りは銀行振込でお申し込みいただけます。', btn);
        if (err === 'already_subscribed') return show('すでにクレジット決済でご契約中です。ご契約内容はマイページの「アカウント管理」でご確認いただけます。<a href="/dashboard/">マイページへ</a>', btn);
        if (err === 'not_eligible') return show('乗り換え特典価格は Light 会員さま限定です。通常価格でお申し込みいただけます。', btn);
        if (err === 'already_premium') return show('すでに Premium（中央＋南関）をご利用中のため、お申し込みは不要です。ご不明な点は<a href="/contact/">お問い合わせ</a>ください。', btn);
        if (err === 'card_sales_not_open' || /_key_missing$/.test(err) || err === 'plan_not_configured') return show('ただいまクレジット決済のお申し込みを準備中です。銀行振込（年払い・買い切り）は通常どおりお申し込みいただけます。', btn);
        show('お申し込みを開始できませんでした。時間をおいて再度お試しください。', btn);
      } catch (_) {
        show('通信に失敗しました。時間をおいて再度お試しください。', btn);
      } finally {
        if (!leaving) { busy = false; btn.disabled = false; btn.textContent = label; }
      }
    }
    // 月額（data-monthly）と年額の定期課金（data-subscription・2026-10-20〜）は同じ共通入口・同じ判定
    var buttons = document.querySelectorAll('[data-monthly], [data-subscription]');
    buttons.forEach(function (btn) {
      btn.dataset.label = btn.textContent;
      btn.addEventListener('click', function () { startMonthly(btn.getAttribute('data-monthly') || btn.getAttribute('data-subscription'), btn); });
    });
    // ログイン等から ?plan=<商品> 付きで戻ったら、その商品の申込をそのまま始める（表示中のボタンがあるときだけ）
    try {
      var want = new URLSearchParams(location.search).get('plan') || '';
      if (/^[a-z-]{3,40}$/.test(want)) {
        var target = Array.prototype.find.call(buttons, function (b) { return (b.getAttribute('data-monthly') || b.getAttribute('data-subscription')) === want && b.offsetParent !== null; });
        if (target) startMonthly(want, target);
      }
    } catch (_) { /* 自動で始めなくても、ボタンは押せる */ }
    // PayPal・ログインから「戻る」で帰ってきたとき（bfcache）に「移動しています…」のまま押せなくならないように
    window.addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      busy = false;
      buttons.forEach(function (btn) { btn.disabled = false; btn.textContent = btn.dataset.label; });
    });
  })();

  // 2026-10-11 MK 確定: 新規の月払い（Stripe 月額）は全面停止。ここから Stripe Checkout を呼ぶ処理は置かない
  // （サーバー側も stripe-create-checkout が 410 monthly_sales_ended で拒否する）。

  let currentPlan = '';
  let currentAmount = 0;
  let currentPlanType = 'monthly';

  function openBankModal(planName, amount, planType = 'monthly') {
    currentPlan = planName;
    currentAmount = amount;
    currentPlanType = planType;

    let periodText = '';
    if (planType === 'lifetime') {
      periodText = '（永久アクセス）';
    } else if (planType === 'annual') {
      periodText = '/年';
    } else {
      periodText = '/30日';
    }

    document.getElementById('modalPlanInfo').textContent = `プラン: ${planName} (¥${amount.toLocaleString()}${periodText})`;
    document.getElementById('modalAmount').textContent = `¥${amount.toLocaleString()}`;
    document.getElementById('transferAmount').value = amount;
    document.getElementById('bankModal').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeBankModal() {
    document.getElementById('bankModal').classList.remove('active');
    document.body.style.overflow = 'auto';
  }

  function copyToClipboard(text) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();

    try {
      document.execCommand('copy');
      alert('コピーしました: ' + text);
    } catch (err) {
      console.error('コピーに失敗しました:', err);
    }

    document.body.removeChild(textarea);
  }

  // DOMContentLoaded後にフォーム処理を登録
  document.addEventListener('DOMContentLoaded', () => {
    // モーダル外クリックで閉じる
    document.addEventListener('click', (e) => {
      const bankModal = document.getElementById('bankModal');
      if (e.target === bankModal) {
        closeBankModal();
      }
    });

    // Escapeキーで閉じる
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeBankModal();
      }
    });

    // 振込完了日: JST 今日を最大値に設定（未来日を選択不可にする）
    const getJstToday = () => {
      const now = new Date();
      const jstMs = now.getTime() + 9 * 60 * 60 * 1000;
      return new Date(jstMs).toISOString().slice(0, 10);
    };
    const transferDateInput = document.getElementById('transferDate');
    if (transferDateInput) {
      const jstToday = getJstToday();
      transferDateInput.max = jstToday;
      // 入力時に未来日が入った場合は即時警告
      transferDateInput.addEventListener('change', () => {
        if (transferDateInput.value && transferDateInput.value > jstToday) {
          alert('⚠️ 振込完了日に未来の日付は指定できません。\n本フォームは振込完了後の報告用です。実際に振込を完了してからご送信ください。');
          transferDateInput.value = '';
        }
      });
    }

    // 銀行振込フォーム送信処理
    const bankTransferForm = document.getElementById('bankTransferForm');
    if (bankTransferForm) {
      bankTransferForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitButton = document.getElementById('submitButton');
        const submitText = submitButton.querySelector('.submit-text');
        const submitLoading = submitButton.querySelector('.submit-loading');
        const formMessage = document.getElementById('formMessage');

        // 送信前バリデーション: 入金済み確認チェック
        const paymentCompletedCheckbox = document.getElementById('paymentCompletedConfirm');
        if (!paymentCompletedCheckbox || !paymentCompletedCheckbox.checked) {
          formMessage.textContent = '⚠️ 銀行振込完了後にチェックを入れてから送信してください。';
          formMessage.className = 'form-message error';
          formMessage.style.display = 'block';
          return;
        }

        // 送信前バリデーション: 未来日ブロック
        const jstToday = getJstToday();
        const transferDateValue = document.getElementById('transferDate').value;
        if (transferDateValue && transferDateValue > jstToday) {
          formMessage.textContent = '⚠️ 振込完了日に未来の日付は指定できません。実際に振込を完了してからご送信ください。';
          formMessage.className = 'form-message error';
          formMessage.style.display = 'block';
          return;
        }

        submitButton.disabled = true;
        submitText.style.display = 'none';
        submitLoading.style.display = 'inline';
        formMessage.style.display = 'none';

        let periodText = '';
        if (currentPlanType === 'lifetime') {
          periodText = '（永久アクセス）';
        } else if (currentPlanType === 'annual') {
          periodText = '/年';
        } else {
          periodText = '/30日';
        }

        const formData = {
          fullName: document.getElementById('fullName').value,
          email: document.getElementById('email').value,
          transferDate: document.getElementById('transferDate').value,
          transferTime: "00:00",  // デフォルト値
          transferAmount: document.getElementById('transferAmount').value,
          transferName: document.getElementById('fullName').value,  // お名前と同じ
          remarks: document.getElementById('remarks').value,
          productName: `${currentPlan} (¥${currentAmount.toLocaleString()}${periodText})`,
          paymentCompletedConfirm: paymentCompletedCheckbox.checked,
          timestamp: new Date().toISOString()
        };

        try {
          const response = await fetch('/.netlify/functions/bank-transfer-application', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData)
          });

          const result = await response.json();

          if (result.success) {
            document.getElementById('bankTransferForm').reset();
            window.SubmissionResult && window.SubmissionResult.showSuccessScreen({
              formEl: bankTransferForm,
              messageEl: formMessage,
              options: {
                title: '入金完了のご報告を受け付けました',
                message: `${formData.productName} のご報告を受け付けました。`,
                subMessage: '確認メールをお送りしましたのでご確認ください。マイページから申請状況も確認できます。'
              },
              history: {
                type: 'bank-transfer',
                label: `銀行振込お申し込み: ${formData.productName}`,
                status: 'pending',
                details: { email: formData.email, transferAmount: formData.transferAmount, transferDate: formData.transferDate, productName: formData.productName }
              }
            });
          } else {
            throw new Error(result.error || '送信に失敗しました');
          }
        } catch (error) {
          formMessage.textContent = '❌ エラーが発生しました: ' + error.message;
          formMessage.className = 'form-message error';
          formMessage.style.display = 'block';
          submitButton.disabled = false;
          submitText.style.display = 'inline';
          submitLoading.style.display = 'none';
        }
      });
    }
  });
</script>

