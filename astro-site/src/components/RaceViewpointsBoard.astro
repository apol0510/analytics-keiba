---
/**
 * RaceViewpointsBoard.astro — 無料「レースの見どころ」ボード（表示専用）
 *
 * 出すもの:
 *   一覧  … 発走時刻 / R / レース名 / 距離 / 頭数 / 絶対タグ or 中立 or 状態
 *   詳細  … タグの根拠（該当頭数）＋**出走馬と無料公開可能な印**＋馬単位の条件変化
 *   会場別… 当日相対（その日その会場の中での順位。絶対タグとは別レイヤー）
 *
 * 出さないもの: 買い目 / pt / AI総合指数 / 役割 / 特徴量。
 *   印は `freePublicView.js` の公開 DTO 由来（上位 4 頭ぶん）で、有料項目は含まれない。
 *
 * 設計上の約束:
 *   - **色だけに意味を持たせない**。すべてのタグ・状態・チップは記号＋文字を伴う
 *   - `<details>` は開くと `.is-open` が付き、背景・border・アイコンが変わる
 *
 * ⚠️ 色番号・文言・名称・URL は仮。MK 目視確認が必要。
 */
import { RACE_STATE } from '../lib/freeViewpoints/raceViewpoints.js';
import {
  TAG_LABEL, TAG_SENTENCE, TAG_ICON, STATE_LABEL, STATE_SENTENCE, STATE_ICON,
  HIGHLIGHT_LABEL, HORSE_CHANGE_CHIP, PAID_CTA, HORSE_SECTION, MEMBER_EXTRAS, coverageNote,
  TERM_HELP, CHIP_HELP, INTERVAL_HELP, HOW_TO_USE, HELP_TOGGLE, LAYOFF_LABEL,
} from '../lib/freeViewpoints/copy.js';

interface Props { view: any; categoryLabel: string; freeUrl: string; }
const { view, categoryLabel, freeUrl } = Astro.props;

const fmtDate = (d: string) => {
  const [y, m, day] = String(d).split('-');
  return `${y}年${parseInt(m, 10)}月${parseInt(day, 10)}日`;
};
const stateClass = (s: string) =>
  s === RACE_STATE.TAGGED ? 'is-tagged'
  : s === RACE_STATE.NEUTRAL ? 'is-neutral'
  : s === RACE_STATE.NO_HISTORY ? 'is-nohistory'
  : 'is-pending';

// タグ → 色分けキー（意味別の多色。色だけに頼らず記号も出す）
const TAG_KIND: Record<string, string> = {
  'distance-change': 'distance',
  'first-course': 'course',
  'jockey-change': 'jockey',
  'easy-compare': 'compare',
  'hard-compare': 'contrast',
};

// タグの根拠になった頭数（情報密度。公開事実の集計のみ）
const tagEvidence = (tag: string, c: any) => {
  if (!c) return null;
  if (tag === 'distance-change') return { n: c.distanceChange, of: c.distanceBase };
  if (tag === 'first-course') return { n: c.firstCourse, of: c.withHistory };
  if (tag === 'jockey-change') return { n: c.jockeyChange, of: c.jockeyBase };
  if (tag === 'easy-compare' || tag === 'hard-compare') return { n: c.easyCompare, of: c.distanceBase };
  return null;
};

const CHIP_ORDER = ['distanceChanged', 'firstCourse', 'jockeyChanged', 'easyCompare'] as const;

// 凡例。**説明は本文として常に出す**（title 属性はマウスを止めないと出ず、スマホでは出ないため）
// 「何走前か」の呼び方。5 走まで出す
const RACE_AGO = ['前走', '2走前', '3走前', '4走前', '5走前'];

const LEGEND = [
  { kind: 'distance', icon: '⇔', label: '距離替わり', desc: '前回とちがう距離を走る馬がいる' },
  { kind: 'course', icon: '◇', label: '初コース', desc: 'この競馬場を走るのが初めての馬がいる' },
  { kind: 'jockey', icon: '⇄', label: '乗り替わり', desc: '前回とちがう騎手が乗る馬がいる' },
  { kind: 'compare', icon: '≡', label: '前走と近い条件', desc: '前回と似た条件なので見比べやすい' },
  { kind: 'contrast', icon: '≠', label: '比べにくい', desc: '条件がちがい、前回の着順を並べても比べにくい' },
  { kind: 'neutral', icon: '＝', label: '目立つ変化なし', desc: '確認したが、大きく変わった点はなかった' },
  { kind: 'nodata', icon: '—', label: '近走なし', desc: '出走馬に前回のレースの記録がない（新馬戦など）' },
  { kind: 'pending', icon: '⏳', label: '準備中', desc: '出走馬の近走をまだ全頭ぶん確認できていない' },
];
---

<section class="rvb">
  <header class="rvb-head">
    {/* H1 は nav の文字（無料予想）と一致させる。押した先に来たことを確定させるため。
        「今日のレースの見どころ」は内容の説明として直下に残す（情報は落とさない）。
        ⚠️「無料予想」は買い目を期待させる語なので、説明行と「買い目は有料版」の案内を
           必ず一緒に出すこと。単独で置かない。 */}
    <h1 class="rvb-title">無料予想<span class="rvb-cat">{categoryLabel}</span></h1>
    <p class="rvb-subtitle">今日のレースの見どころ</p>
    <p class="rvb-date">{fmtDate(view.date)}</p>
    <p class="rvb-lead">
      出走馬の<strong>近走（前走の会場・距離・騎手）</strong>だけを数えて、レースごとに
      「何が替わったか」「近走を見比べやすいか」を出しています。
      各レースを開くと、<strong>出走馬と、その馬の条件がどう変わったか</strong>まで確認できます。
    </p>
    <details class="rvb-howto" id="rvb-howto">
      <summary class="rvb-howto-sum">
        <span aria-hidden="true">💡</span><span class="rvb-howto-sum-txt">{HOW_TO_USE.toggleOpen}</span>
      </summary>
      <div class="rvb-howto-body">
        <p class="rvb-howto-lead">{HOW_TO_USE.lead}</p>
        <ol class="rvb-howto-steps">
          {HOW_TO_USE.steps.map((st: any, i: number) => (
            <li class="rvb-howto-step">
              <span class="rvb-howto-no">{i + 1}</span>
              <span class="rvb-howto-txt"><b>{st.title}</b>{st.body}</span>
            </li>
          ))}
        </ol>
        <p class="rvb-howto-note">{HOW_TO_USE.note}</p>
      </div>
    </details>

    <div class="rvb-helpbar">
      <button type="button" class="rvb-helpbtn" id="rvb-help-toggle" aria-pressed="true">
        <span aria-hidden="true">🔎</span><span class="rvb-helpbtn-txt">{HELP_TOGGLE.on}</span>
      </button>
      <span class="rvb-helphint">{HELP_TOGGLE.hint}</span>
    </div>

    <ul class="rvb-legend">
      {LEGEND.map((l) => (
        <li class={`lg lg-${l.kind}`}>
          <span class="lg-chip"><span class="lg-ic">{l.icon}</span>{l.label}</span>
          <span class="lg-desc" data-help>{l.desc}</span>
        </li>
      ))}
    </ul>

    {/* ページ冒頭の常設バナー。未登録には CTA、登録済みには「何が増えたか」を出す。
        アコーディオンを開かないと登録案内が見えなかった問題への対応（2026-08-20）。 */}
    <div class="rvb-topgate" data-guest-only>
      <p class="rvb-topgate-head"><span aria-hidden="true">🔓</span>{MEMBER_EXTRAS.topLockedHeading}</p>
      <p class="rvb-topgate-body">{MEMBER_EXTRAS.topLockedBody}</p>
      <ul class="rvb-topgate-list">
        {MEMBER_EXTRAS.benefits.map((b: string) => <li>{b}</li>)}
      </ul>
      <a class="rvb-topgate-cta" href="/free-signup/">{MEMBER_EXTRAS.topCtaLabel}</a>
      <p class="rvb-topgate-note">{MEMBER_EXTRAS.topLockedNote}</p>
    </div>

    <div class="rvb-topmember" data-member-only>
      <p class="rvb-topmember-head"><span aria-hidden="true">✅</span>{MEMBER_EXTRAS.topMemberHeading}</p>
      <p class="rvb-topmember-body">{MEMBER_EXTRAS.topMemberBody}</p>
    </div>
  </header>

  {/* 会場タブ。複数開催（JRA 3 場 / 南関 2 場）で全会場を縦に並べると 10 画面ぶんになるため、
      1 会場ずつ出す。**JS が動かない環境ではタブを出さず、全会場を縦に並べたまま**にする
      （情報を落とさない）。有効化は下の venueTabs() が :root[data-rvb-venuetabs="on"] を付けたとき。 */}
  {view.venues.length > 1 && (
    <div class="rvb-venuebar" role="tablist" aria-label="会場を切り替える">
      {view.venues.map((venue: any, vi: number) => (
        <button
          type="button"
          class="rvb-venuetab"
          role="tab"
          id={`rvb-venuetab-${vi}`}
          aria-controls={`rvb-venue-${vi}`}
          aria-selected={vi === 0 ? 'true' : 'false'}
        >
          <span class="rvb-venuetab-name">{venue.venue}</span>
          <span class="rvb-venuetab-count">{venue.races.length}R</span>
        </button>
      ))}
    </div>
  )}

  {view.venues.map((venue: any, vi: number) => (
    <div
      class="rvb-venue"
      id={`rvb-venue-${vi}`}
      data-active={vi === 0 ? 'true' : 'false'}
      role={view.venues.length > 1 ? 'tabpanel' : undefined}
      aria-labelledby={view.venues.length > 1 ? `rvb-venuetab-${vi}` : undefined}
    >
      <h2 class="rvb-venue-name">{venue.venue}<span class="rvb-venue-count">{venue.races.length}R</span></h2>

      <div class="rvb-highlight">
        <span class="rvb-highlight-head">今日の{venue.venue}では</span>
        <ul class="rvb-highlight-list">
          {(['mostChanged', 'easiest', 'hardest'] as const).map((k) => (
            venue.highlights[k] ? (
              <li class={`hl hl-${k}`}>
                <span class="hl-key">{HIGHLIGHT_LABEL[k]}</span>
                <span class="hl-val">{venue.highlights[k]}R</span>
              </li>
            ) : null
          ))}
        </ul>
        <p class="rvb-highlight-note">
          ※ ここは<strong>今日のこの会場だけを見くらべた結果</strong>です。
          各レースに付いている印は「いつもと比べてどうか」なので、別の見かたになります。
        </p>
      </div>

      <ol class="rvb-list">
        {venue.races.map((race: any) => (
          <li class={`rvb-row ${stateClass(race.result.state)}`}>
            <div class="rvb-row-main">
              <span class="rvb-time">{race.startTime || '--:--'}</span>
              <span class="rvb-r">{race.raceNumber}R</span>
              <span class="rvb-name">{race.raceName || '　'}</span>
              <span class="rvb-meta">
                {race.distanceMeters ? `${race.distanceMeters}m` : '距離未取得'} ・ {race.entryCount}頭
              </span>
            </div>

            <div class="rvb-row-tags">
              {race.result.state === RACE_STATE.TAGGED
                ? race.result.tags.map((t: string) => {
                    const ev = tagEvidence(t, race.result.counts);
                    return (
                      <span class={`rvb-tag tag-${TAG_KIND[t] || 'other'}`}>
                        <span class="rvb-tag-ic">{TAG_ICON[t]}</span>{TAG_LABEL[t]}
                        {ev && ev.of ? <span class="rvb-tag-n">{ev.of}頭中{ev.n}頭</span> : null}
                      </span>
                    );
                  })
                : (
                  <span class={`rvb-state st-${stateClass(race.result.state).replace('is-', '')}`}>
                    <span class="rvb-tag-ic">{STATE_ICON[race.result.state]}</span>{STATE_LABEL[race.result.state]}
                  </span>
                )}
            </div>

            {race.result.state === RACE_STATE.TAGGED && (
              <p class="rvb-tag-help" data-help>
                {race.result.tags.map((t: string) => TERM_HELP[t]).filter(Boolean).join(' ')}
              </p>
            )}

            <details class="rvb-detail" data-race={race.raceNumber}>
              <summary class="rvb-detail-sum">
                <span class="rvb-detail-ic" aria-hidden="true">＋</span>
                <span class="rvb-detail-txt">このレースの見かたと出走馬</span>
              </summary>
              <div class="rvb-detail-body">
                {race.result.state === RACE_STATE.TAGGED
                  ? race.result.tags.map((t: string) => (
                    <p class={`rvb-sentence sn-${TAG_KIND[t] || 'other'}`}>
                      {TAG_SENTENCE[t]}
                      {TERM_HELP[t] && <span class="rvb-help" data-help>{TERM_HELP[t]}</span>}
                    </p>
                  ))
                  : <p class={`rvb-sentence sn-${stateClass(race.result.state).replace('is-', '')}`}>{STATE_SENTENCE[race.result.state]}</p>}

                {race.result.degraded.length > 0 && race.result.state !== RACE_STATE.UNMATCHED && (
                  <p class="rvb-degraded">
                    <span aria-hidden="true">⚠ </span>
                    {race.result.degraded.includes('distance') && '今日の距離が取得できていないため、距離に関する見どころは出していません。'}
                    {race.result.degraded.includes('jockey') && '騎手を照合できない馬があるため、乗り替わりの見どころは出していません。'}
                  </p>
                )}

                <p class="rvb-cov">{coverageNote(race.result)}</p>

                {race.horseRows && race.horseRows.length > 0 && (
                  <div class="rvb-horses">
                    <h3 class="rvb-horses-head">{HORSE_SECTION.heading}</h3>
                    <p class="rvb-horses-note">{HORSE_SECTION.note}</p>
                    <ul class="rvb-horse-list">
                      {race.horseRows.map((h: any) => (
                        <li class={`rvb-horse ${h.isHeadline ? `hm-${h.headlineKind}` : 'hm-plain'}`}>
                          <span class="rvb-horse-mark" aria-label={h.isHeadline ? '印あり' : '印なし'}>{h.headlineMark || '・'}</span>
                          <span class="rvb-horse-num">{h.number}</span>
                          <span class="rvb-horse-name">{h.name}</span>
                          {/* 性齢・騎手・斤量。いずれも公開事実で、欠けている項目は詰めて出す
                              （空欄や「—」を並べてデータがある風に見せない）。 */}
                          <span class="rvb-horse-sub">
                            {[h.ageGender, h.jockey ? `騎手 ${h.jockey}` : null, h.weight].filter(Boolean).join(' / ')}
                          </span>
                          {/* 父（血統）と厩舎。公開 DTO に元からある事実で、有料項目は含まない。
                              ⚠️ ここに「◯◯産駒は道悪巧者」のような評価は書かない（copy ガードの方針）。 */}
                          {(h.sire || h.trainer) && (
                            <span class="rvb-horse-meta">
                              {[h.sire ? `父 ${h.sire}` : null, h.trainer ? `厩舎 ${h.trainer}` : null].filter(Boolean).join(' ・ ')}
                            </span>
                          )}
                          <span class="rvb-horse-prev">
                            {h.prev ? `前走 ${h.prev.venue ?? ''}${h.prev.distance ? ` ${h.prev.distance}m` : ''}` : '前走データなし'}
                          </span>
                          <span class="rvb-horse-chips">
                            {h.changes
                              ? CHIP_ORDER.filter((k) => h.changes[k]).map((k) => (
                                  <span class={`rvb-chip chip-${HORSE_CHANGE_CHIP[k].kind}`}>
                                    <span aria-hidden="true">{HORSE_CHANGE_CHIP[k].icon}</span>{HORSE_CHANGE_CHIP[k].label}
                                  </span>
                                ))
                              : <span class="rvb-chip chip-none">{HORSE_SECTION.noChanges}</span>}
                          </span>

                          {h.extras && (
                            <span class="rvb-member-row" data-member-only>
                              <span class="rvb-member-rowbadge">{MEMBER_EXTRAS.memberBadge}</span>
                              <span class="rvb-member-chips">
                                {h.extras.layoffRun && (
                                  <span class={`rvb-mchip mchip-${h.extras.layoffRun.kind === 'layoff' ? 'layoff' : 'run'}`}>
                                    <span aria-hidden="true">{h.extras.layoffRun.kind === 'layoff' ? LAYOFF_LABEL.layoff.icon : LAYOFF_LABEL.runAfterLayoff.icon}</span>
                                    {h.extras.layoffRun.kind === 'layoff' ? LAYOFF_LABEL.layoff.label : `叩き${h.extras.layoffRun.nth}戦目`}
                                  </span>
                                )}
                                {h.extras.interval && (
                                  <span class="rvb-mchip mchip-interval">
                                    <span aria-hidden="true">🗓</span>前走から{h.extras.interval.days}日ぶり
                                    <span class="rvb-mchip-sub">{h.extras.interval.label}</span>
                                  </span>
                                )}
                                {h.extras.bodyWeight && (
                                  <span class="rvb-mchip mchip-weight">
                                    <span aria-hidden="true">⚖</span>前走の体重 {h.extras.bodyWeight.latest}kg
                                    {h.extras.bodyWeight.diff !== null && (
                                      <span class="rvb-mchip-sub">{h.extras.bodyWeight.diff > 0 ? '+' : ''}{h.extras.bodyWeight.diff}</span>
                                    )}
                                  </span>
                                )}
                              </span>
                              {h.extras.layoffRun && (
                                <span class="rvb-mchip-help" data-help>
                                  {h.extras.layoffRun.kind === 'layoff' ? CHIP_HELP.layoff : CHIP_HELP.runAfterLayoff}
                                </span>
                              )}
                              {h.extras.history.length > 0 && (
                                <span class="rvb-mhist">
                                  <span class="rvb-mhist-label">{MEMBER_EXTRAS.historyHeading}</span>
                                  <span class="rvb-mhist-help" data-help>{MEMBER_EXTRAS.historyHelp}</span>
                                  <span class="rvb-mhist-rows">
                                    {h.extras.history.map((p, i) => (
                                      <span class="rvb-mhist-row">
                                        <span class="mh-when">{RACE_AGO[i] || `${i + 1}走前`}</span>
                                        <span class="mh-where">{p.venue || '—'}{p.distance ? ` ${p.distance}m` : ''}</span>
                                        <span class="mh-rank">{p.finish != null && p.finish !== '' ? `${p.finish}着` : '—'}</span>
                                        <span class="mh-chg">
                                          {p.venueChanged && <span class="mh-badge mh-v">コースが変わった</span>}
                                          {p.distanceChanged && <span class="mh-badge mh-d">距離が変わった</span>}
                                        </span>
                                      </span>
                                    ))}
                                  </span>
                                </span>
                              )}
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {race.result.state !== RACE_STATE.UNMATCHED && race.horseRows && race.horseRows.length > 0 && (
                  <>
                    <div class="rvb-member" data-member-only>
                      <h4 class="rvb-member-head">
                        <span class="rvb-member-badge">{MEMBER_EXTRAS.memberBadge}</span>
                        {MEMBER_EXTRAS.unlockedHeading}
                      </h4>
                      <div class="rvb-samecond">
                        <span class="rvb-samecond-head">{MEMBER_EXTRAS.sameConditionHeading}</span>
                        {race.sameCondition && race.sameCondition.length > 0
                          ? (
                            <ul class="rvb-samecond-list">
                              {race.sameCondition.map((r: any) => (
                                <li class="rvb-samecond-item">
                                  <span class="sc-num">{r.number}</span>
                                  <span class="sc-name">{r.name}</span>
                                  <span class="sc-finish">前走 {r.finish != null && r.finish !== '' ? `${r.finish}着` : '—'}</span>
                                  <span class="sc-meta">{r.distance ? `${r.distance}m` : ''}{r.bodyWeight ? ` / ${r.bodyWeight}kg` : ''}</span>
                                </li>
                              ))}
                            </ul>
                          )
                          : <p class="rvb-samecond-empty">{MEMBER_EXTRAS.sameConditionEmpty}</p>}
                      </div>
                    </div>

                    <div class="rvb-signup" data-guest-only>
                      <p class="rvb-signup-head">{MEMBER_EXTRAS.lockedHeading}</p>
                      <p class="rvb-signup-body">{MEMBER_EXTRAS.lockedBody}</p>
                      <ul class="rvb-signup-list">
                        {MEMBER_EXTRAS.benefits.map((b: string) => <li>{b}</li>)}
                      </ul>
                      <a class="rvb-signup-cta" href="/free-signup/">{MEMBER_EXTRAS.ctaLabel}</a>
                      <p class="rvb-signup-note">{MEMBER_EXTRAS.note}</p>
                    </div>
                  </>
                )}

                <div class="rvb-cta">
                  <p class="rvb-cta-head">{PAID_CTA.heading}</p>
                  <p class="rvb-cta-body">{PAID_CTA.body}</p>
                  <div class="rvb-cta-links">
                    <a class="rvb-cta-a" href={freeUrl}>{PAID_CTA.linkLabel}</a>
                    <a class="rvb-cta-b" href="/pricing/">{PAID_CTA.planLabel}</a>
                  </div>
                </div>

                <div class="rvb-closebar">
                  <button type="button" class="rvb-closebtn" data-close-race={race.raceNumber}>
                    <span aria-hidden="true">✕</span>{race.raceNumber}R を閉じる
                  </button>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  ))}

  <p class="rvb-foot">
    近走の集計元は、南関は出走各馬の近走詳細データ、中央は JRA 公式の競走成績です。
    まだ確認できていないレースは、無理に傾向を出さず「近走データ準備中」と表示しています。
  </p>
</section>

<script is:inline>
  // ── 初めての人向けの補助 ──────────────────────────────────────
  // ① 使い方: 初回訪問だけ開いて見せる（一度閉じたら次からは閉じたまま）
  // ② かんたん表示: 用語のやさしい説明を出し入れする。既定はオン
  (function applyBeginnerHelp() {
    const HOWTO_KEY = 'rvb-howto-seen';
    const HELP_KEY = 'rvb-help-off';
    function init() {
      const howto = document.getElementById('rvb-howto');
      if (howto) {
        let seen = false;
        try { seen = localStorage.getItem(HOWTO_KEY) === '1'; } catch { seen = false; }
        howto.open = !seen;
        howto.addEventListener('toggle', () => {
          const txt = howto.querySelector('.rvb-howto-sum-txt');
          if (txt) txt.textContent = howto.open ? '使い方を閉じる' : '使い方を見る';
          if (!howto.open) { try { localStorage.setItem(HOWTO_KEY, '1'); } catch { /* 保存できなくても表示は動く */ } }
        });
        const txt = howto.querySelector('.rvb-howto-sum-txt');
        if (txt) txt.textContent = howto.open ? '使い方を閉じる' : '使い方を見る';
      }

      const btn = document.getElementById('rvb-help-toggle');
      if (!btn) return;
      function paint(on) {
        document.documentElement.setAttribute('data-rvb-help', on ? 'on' : 'off');
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        const t = btn.querySelector('.rvb-helpbtn-txt');
        if (t) t.textContent = on ? 'かんたん表示：オン' : 'かんたん表示：オフ';
      }
      let on = true;
      try { on = localStorage.getItem(HELP_KEY) !== '1'; } catch { on = true; }
      paint(on);
      btn.addEventListener('click', () => {
        on = !on;
        paint(on);
        try { localStorage.setItem(HELP_KEY, on ? '0' : '1'); } catch { /* 保存できなくても切替は効く */ }
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();

  // ── 会場タブ（複数開催）──────────────────────────────────────
  // JRA は 1 日 3 場、南関も 2 場開催の日がある。全会場を縦に連結すると
  // 36 レース = デスクトップで 10 画面ぶんになり、目的のレースに辿り着けない。
  //   ① 会場ごとに 1 つだけ表示し、タブで切り替える
  //   ② タブはスクロール追従（sticky）。どの会場を見ているか常に分かる
  //   ③ **JS が動かない環境ではタブを出さず、全会場が縦に並んだまま**（情報は落とさない）
  (function venueTabs() {
    function init() {
      const bar = document.querySelector('.rvb-venuebar');
      const venues = Array.from(document.querySelectorAll('.rvb-venue'));
      if (!bar || venues.length < 2) return;
      const tabs = Array.from(bar.querySelectorAll('.rvb-venuetab'));
      if (tabs.length !== venues.length) return;

      // サイトヘッダーは position: fixed。その実高さを sticky の基準にする
      // （固定値だと画面幅でヘッダー高が変わったときに潜り込む）
      function syncStickyTop() {
        const hdr = document.querySelector('.header');
        const h = hdr ? Math.round(hdr.getBoundingClientRect().height) : 0;
        document.documentElement.style.setProperty('--rvb-sticky-top', (h || 92) + 'px');
      }
      syncStickyTop();
      window.addEventListener('resize', syncStickyTop);

      function stickyTopPx() {
        const v = getComputedStyle(document.documentElement).getPropertyValue('--rvb-sticky-top');
        return parseInt(v, 10) || 92;
      }

      function select(index, scroll) {
        venues.forEach((v, n) => {
          v.setAttribute('data-active', n === index ? 'true' : 'false');
          // 隠れる会場のレースを開いたままにしない（戻ったとき開きっぱなしで迷子になる）
          if (n !== index) {
            v.querySelectorAll('details.rvb-detail[open]').forEach((d) => { d.open = false; });
          }
        });
        tabs.forEach((t, n) => t.setAttribute('aria-selected', n === index ? 'true' : 'false'));
        if (scroll) {
          const top = bar.getBoundingClientRect().top + window.scrollY - stickyTopPx() - 8;
          window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
        }
      }

      document.documentElement.setAttribute('data-rvb-venuetabs', 'on');
      select(0, false);

      bar.addEventListener('click', (e) => {
        const btn = e.target instanceof Element ? e.target.closest('.rvb-venuetab') : null;
        if (!btn) return;
        const i = tabs.indexOf(btn);
        if (i >= 0) select(i, true);
      });

      // 左右キーで切り替え（tablist の作法）。
      // ⚠️ このファイルでは**キー既定動作の抑止を一切書かない**。summary の既定トグルが
      //    生きていることを accordionClose.guard.test.mjs がファイル全体の文字列検査で
      //    確かめており、抑止の呼び出し名が 1 か所でもあると落ちる（意図した厳しさ）。
      //    矢印キーの既定動作は横スクロールだけなので、抑止しなくても実害が無い。
      bar.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        const cur = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
        const next = e.key === 'ArrowRight'
          ? (cur + 1) % tabs.length
          : (cur - 1 + tabs.length) % tabs.length;
        select(next, false);
        tabs[next].focus();
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();

  // ── 無料会員向け拡張表示の出し分け ────────────────────────────
  // 既定は「未登録」の見え方（拡張は隠す / 登録 CTA を出す）。JS で登録済みなら入れ替える。
  //
  // ⚠️ これは**クライアント側の soft gate** で、開発者ツールがあれば回避できる。
  //    ここで隠しているのは**公開事実だけ**（出走間隔・馬体重・過去走の推移）なので、
  //    回避されても買い目 / pt / AI総合指数 / 役割 / 特徴量は一切漏れない。
  //    有料情報のゲートには絶対に使わないこと。
  (function applyMemberGate() {
    function isRegisteredUser() {
      // 他ページ（free-prediction / dashboard）と同じ 5 キー OR 判定にそろえる
      for (const key of ['user-plan', 'userPlan', 'user_plan', 'user_email', 'userEmail', 'auth_data']) {
        if (localStorage.getItem(key)) return true;
      }
      return localStorage.getItem('isLoggedIn') === 'true';
    }
    function apply() {
      let registered = false;
      try { registered = isRegisteredUser(); } catch { registered = false; }
      document.querySelectorAll('[data-member-only]').forEach((el) => {
        el.classList.toggle('is-unlocked', registered);
      });
      document.querySelectorAll('[data-guest-only]').forEach((el) => {
        el.classList.toggle('is-hidden', registered);
      });
      document.documentElement.setAttribute('data-rvb-member', registered ? 'true' : 'false');
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply);
    else apply();
  })();

  // ── アコーディオンを閉じやすくする ────────────────────────────
  // 開くと中身が長くなる（1 レースで出走馬 10 数頭 × 過去 5 走）ため、
  //   ① 中身の末尾に「閉じる」ボタンを置き、スクロール中も押せるよう sticky にする
  //   ② 閉じたらそのレースの見出しへ戻す（どこにいるか分からなくならないように）
  //   ③ 別のレースを開いたら前のレースは自動で閉じる（同時に開くのは 1 つ）
  (function raceAccordionClose() {
    function closeRace(details) {
      const row = details.closest('.rvb-row') || details;
      details.open = false;
      // 閉じた直後に見出しが画面外だと迷子になるので、必要なときだけ戻す
      const top = row.getBoundingClientRect().top;
      if (top < 0 || top > window.innerHeight) {
        row.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
    }
    document.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest('[data-close-race]') : null;
      if (!btn) return;
      const details = btn.closest('details.rvb-detail');
      if (details) closeRace(details);
    });
    // 同時に開くのは 1 つだけ
    document.addEventListener('toggle', (e) => {
      const el = e.target;
      if (!(el instanceof HTMLDetailsElement) || !el.classList.contains('rvb-detail') || !el.open) return;
      document.querySelectorAll('details.rvb-detail[open]').forEach((other) => {
        if (other !== el) other.open = false;
      });
    }, true);
  })();

  // details の開閉状態を class でも持たせる（CSS だけでなく状態として識別できるように）
  document.addEventListener('toggle', (e) => {
    const el = e.target;
    if (el instanceof HTMLDetailsElement && el.classList.contains('rvb-detail')) {
      el.classList.toggle('is-open', el.open);
      el.setAttribute('data-open', el.open ? 'true' : 'false');
    }
  }, true);
</script>

