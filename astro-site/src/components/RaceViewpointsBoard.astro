---
/**
 * RaceViewpointsBoard.astro — 無料「レースの見どころ」ボード（表示専用）
 *
 * 出すもの:
 *   一覧  … 発走時刻 / R / レース名 / 距離 / 頭数 / 絶対タグ or 中立 or 状態
 *   詳細  … タグの根拠（該当頭数）＋**出走馬と無料公開可能な印**＋馬単位の条件変化
 *   会場別… 当日相対（その日その会場の中での順位。絶対タグとは別レイヤー）
 *
 * 出さないもの: 買い目 / pt / AI総合指数 / 役割 / 特徴量。
 *   印は `freePublicView.js` の公開 DTO 由来（上位 4 頭ぶん）で、有料項目は含まれない。
 *
 * 設計上の約束:
 *   - **色だけに意味を持たせない**。すべてのタグ・状態・チップは記号＋文字を伴う
 *   - `<details>` は開くと `.is-open` が付き、背景・border・アイコンが変わる
 *
 * ⚠️ 色番号・文言・名称・URL は仮。MK 目視確認が必要。
 */
import { RACE_STATE } from '../lib/freeViewpoints/raceViewpoints.js';
import {
  TAG_LABEL, TAG_SENTENCE, TAG_ICON, STATE_LABEL, STATE_SENTENCE, STATE_ICON,
  HIGHLIGHT_LABEL, HORSE_CHANGE_CHIP, PAID_CTA, HORSE_SECTION, coverageNote,
} from '../lib/freeViewpoints/copy.js';

interface Props { view: any; categoryLabel: string; freeUrl: string; }
const { view, categoryLabel, freeUrl } = Astro.props;

const fmtDate = (d: string) => {
  const [y, m, day] = String(d).split('-');
  return `${y}年${parseInt(m, 10)}月${parseInt(day, 10)}日`;
};
const stateClass = (s: string) =>
  s === RACE_STATE.TAGGED ? 'is-tagged'
  : s === RACE_STATE.NEUTRAL ? 'is-neutral'
  : s === RACE_STATE.NO_HISTORY ? 'is-nohistory'
  : 'is-pending';

// タグ → 色分けキー（意味別の多色。色だけに頼らず記号も出す）
const TAG_KIND: Record<string, string> = {
  'distance-change': 'distance',
  'first-course': 'course',
  'jockey-change': 'jockey',
  'easy-compare': 'compare',
  'hard-compare': 'contrast',
};

// タグの根拠になった頭数（情報密度。公開事実の集計のみ）
const tagEvidence = (tag: string, c: any) => {
  if (!c) return null;
  if (tag === 'distance-change') return { n: c.distanceChange, of: c.distanceBase };
  if (tag === 'first-course') return { n: c.firstCourse, of: c.withHistory };
  if (tag === 'jockey-change') return { n: c.jockeyChange, of: c.jockeyBase };
  if (tag === 'easy-compare' || tag === 'hard-compare') return { n: c.easyCompare, of: c.distanceBase };
  return null;
};

const CHIP_ORDER = ['distanceChanged', 'firstCourse', 'jockeyChanged', 'easyCompare'] as const;
---

<section class="rvb">
  <header class="rvb-head">
    <h1 class="rvb-title">今日のレースの見どころ<span class="rvb-cat">{categoryLabel}</span></h1>
    <p class="rvb-date">{fmtDate(view.date)}</p>
    <p class="rvb-lead">
      出走馬の<strong>近走（前走の会場・距離・騎手）</strong>だけを数えて、レースごとに
      「何が替わったか」「近走を見比べやすいか」を出しています。
      各レースを開くと、<strong>出走馬と、その馬の条件がどう変わったか</strong>まで確認できます。
    </p>
    <ul class="rvb-legend">
      <li class="lg lg-distance"><span class="lg-ic">⇔</span>距離替わり</li>
      <li class="lg lg-course"><span class="lg-ic">◇</span>初コース</li>
      <li class="lg lg-jockey"><span class="lg-ic">⇄</span>乗り替わり</li>
      <li class="lg lg-compare"><span class="lg-ic">≡</span>前走と近い条件</li>
      <li class="lg lg-contrast"><span class="lg-ic">≠</span>比べにくい</li>
      <li class="lg lg-neutral"><span class="lg-ic">＝</span>目立つ変化なし</li>
      <li class="lg lg-nodata"><span class="lg-ic">—</span>近走なし</li>
      <li class="lg lg-pending"><span class="lg-ic">⏳</span>準備中</li>
    </ul>
  </header>

  {view.venues.map((venue: any) => (
    <div class="rvb-venue">
      <h2 class="rvb-venue-name">{venue.venue}<span class="rvb-venue-count">{venue.races.length}R</span></h2>

      <div class="rvb-highlight">
        <span class="rvb-highlight-head">今日の{venue.venue}では</span>
        <ul class="rvb-highlight-list">
          {(['mostChanged', 'easiest', 'hardest'] as const).map((k) => (
            venue.highlights[k] ? (
              <li class={`hl hl-${k}`}>
                <span class="hl-key">{HIGHLIGHT_LABEL[k]}</span>
                <span class="hl-val">{venue.highlights[k]}R</span>
              </li>
            ) : null
          ))}
        </ul>
        <p class="rvb-highlight-note">
          ※ この 3 つは<strong>今日のこの会場の中での比較</strong>です。
          各レースのタグ（{categoryLabel}全体の基準）とは別の見かたです。
        </p>
      </div>

      <ol class="rvb-list">
        {venue.races.map((race: any) => (
          <li class={`rvb-row ${stateClass(race.result.state)}`}>
            <div class="rvb-row-main">
              <span class="rvb-time">{race.startTime || '--:--'}</span>
              <span class="rvb-r">{race.raceNumber}R</span>
              <span class="rvb-name">{race.raceName || '　'}</span>
              <span class="rvb-meta">
                {race.distanceMeters ? `${race.distanceMeters}m` : '距離未取得'} ・ {race.entryCount}頭
              </span>
            </div>

            <div class="rvb-row-tags">
              {race.result.state === RACE_STATE.TAGGED
                ? race.result.tags.map((t: string) => {
                    const ev = tagEvidence(t, race.result.counts);
                    return (
                      <span class={`rvb-tag tag-${TAG_KIND[t] || 'other'}`}>
                        <span class="rvb-tag-ic">{TAG_ICON[t]}</span>{TAG_LABEL[t]}
                        {ev && ev.of ? <span class="rvb-tag-n">{ev.n}/{ev.of}頭</span> : null}
                      </span>
                    );
                  })
                : (
                  <span class={`rvb-state st-${stateClass(race.result.state).replace('is-', '')}`}>
                    <span class="rvb-tag-ic">{STATE_ICON[race.result.state]}</span>{STATE_LABEL[race.result.state]}
                  </span>
                )}
            </div>

            <details class="rvb-detail" data-race={race.raceNumber}>
              <summary class="rvb-detail-sum">
                <span class="rvb-detail-ic" aria-hidden="true">＋</span>
                <span class="rvb-detail-txt">このレースの見かたと出走馬</span>
              </summary>
              <div class="rvb-detail-body">
                {race.result.state === RACE_STATE.TAGGED
                  ? race.result.tags.map((t: string) => <p class={`rvb-sentence sn-${TAG_KIND[t] || 'other'}`}>{TAG_SENTENCE[t]}</p>)
                  : <p class={`rvb-sentence sn-${stateClass(race.result.state).replace('is-', '')}`}>{STATE_SENTENCE[race.result.state]}</p>}

                {race.result.degraded.length > 0 && race.result.state !== RACE_STATE.UNMATCHED && (
                  <p class="rvb-degraded">
                    <span aria-hidden="true">⚠ </span>
                    {race.result.degraded.includes('distance') && '今日の距離が取得できていないため、距離に関する見どころは出していません。'}
                    {race.result.degraded.includes('jockey') && '騎手を照合できない馬があるため、乗り替わりの見どころは出していません。'}
                  </p>
                )}

                <p class="rvb-cov">{coverageNote(race.result)}</p>

                {race.horseRows && race.horseRows.length > 0 && (
                  <div class="rvb-horses">
                    <h3 class="rvb-horses-head">{HORSE_SECTION.heading}</h3>
                    <p class="rvb-horses-note">{HORSE_SECTION.note}</p>
                    <ul class="rvb-horse-list">
                      {race.horseRows.map((h: any) => (
                        <li class={`rvb-horse ${h.isHeadline ? `hm-${h.headlineKind}` : 'hm-plain'}`}>
                          <span class="rvb-horse-mark" aria-label={h.isHeadline ? '印あり' : '印なし'}>{h.headlineMark || '・'}</span>
                          <span class="rvb-horse-num">{h.number}</span>
                          <span class="rvb-horse-name">{h.name}</span>
                          <span class="rvb-horse-sub">
                            {h.jockey ? `騎手 ${h.jockey}` : ''}{h.weight ? ` / ${h.weight}` : ''}
                          </span>
                          <span class="rvb-horse-prev">
                            {h.prev ? `前走 ${h.prev.venue ?? ''}${h.prev.distance ? ` ${h.prev.distance}m` : ''}` : '前走データなし'}
                          </span>
                          <span class="rvb-horse-chips">
                            {h.changes
                              ? CHIP_ORDER.filter((k) => h.changes[k]).map((k) => (
                                  <span class={`rvb-chip chip-${HORSE_CHANGE_CHIP[k].kind}`}>
                                    <span aria-hidden="true">{HORSE_CHANGE_CHIP[k].icon}</span>{HORSE_CHANGE_CHIP[k].label}
                                  </span>
                                ))
                              : <span class="rvb-chip chip-none">{HORSE_SECTION.noChanges}</span>}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                <div class="rvb-cta">
                  <p class="rvb-cta-head">{PAID_CTA.heading}</p>
                  <p class="rvb-cta-body">{PAID_CTA.body}</p>
                  <div class="rvb-cta-links">
                    <a class="rvb-cta-a" href={freeUrl}>{PAID_CTA.linkLabel}</a>
                    <a class="rvb-cta-b" href="/pricing/">{PAID_CTA.planLabel}</a>
                  </div>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  ))}

  <p class="rvb-foot">
    近走の集計元は、南関は出走各馬の近走詳細データ、中央は JRA 公式の競走成績です。
    まだ確認できていないレースは、無理に傾向を出さず「近走データ準備中」と表示しています。
  </p>
</section>

<script is:inline>
  // details の開閉状態を class でも持たせる（CSS だけでなく状態として識別できるように）
  document.addEventListener('toggle', (e) => {
    const el = e.target;
    if (el instanceof HTMLDetailsElement && el.classList.contains('rvb-detail')) {
      el.classList.toggle('is-open', el.open);
      el.setAttribute('data-open', el.open ? 'true' : 'false');
    }
  }, true);
</script>

<style>
  .rvb { max-width: 1040px; margin: 0 auto; padding: 24px 16px 64px; color: #e2e8f0; }
  .rvb-head { text-align: center; margin-bottom: 24px; }
  .rvb-title { font-size: 1.9rem; font-weight: 800; color: #f8fafc; margin: 0 0 6px; line-height: 1.3; }
  .rvb-cat { display: inline-block; margin-left: 10px; padding: 3px 10px; border-radius: 999px; background: #7c3aed; color: #fff; font-size: .78rem; vertical-align: middle; }
  .rvb-date { color: #cbd5e1; margin: 0 0 12px; font-size: .95rem; }
  .rvb-lead { color: #e2e8f0; font-size: .92rem; line-height: 1.85; max-width: 660px; margin: 0 auto 14px; }

  /* 凡例: 色 + 記号 + 文字 で意味を示す */
  .rvb-legend { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 0; padding: 0; }
  .lg { font-size: .74rem; padding: 3px 9px; border-radius: 999px; border: 1px solid; display: inline-flex; align-items: center; gap: 4px; }
  .lg-ic { font-weight: 700; }
  .lg-distance { color: #fde68a; border-color: #f59e0b; background: rgba(245,158,11,.16); }
  .lg-course   { color: #bbf7d0; border-color: #22c55e; background: rgba(34,197,94,.16); }
  .lg-jockey   { color: #ddd6fe; border-color: #8b5cf6; background: rgba(139,92,246,.18); }
  .lg-compare  { color: #bae6fd; border-color: #0ea5e9; background: rgba(14,165,233,.16); }
  .lg-contrast { color: #fecaca; border-color: #ef4444; background: rgba(239,68,68,.16); }
  .lg-neutral  { color: #e2e8f0; border-color: #94a3b8; background: rgba(148,163,184,.16); }
  .lg-nodata   { color: #e5e7eb; border-color: #6b7280; background: rgba(107,114,128,.2); }
  .lg-pending  { color: #fed7aa; border-color: #fb923c; background: rgba(251,146,60,.16); }

  .rvb-venue { margin-top: 34px; }
  .rvb-venue-name { font-size: 1.3rem; font-weight: 800; color: #f8fafc; border-left: 5px solid #7c3aed; padding-left: 10px; margin: 0 0 12px; }
  .rvb-venue-count { color: #c4b5fd; font-size: .8rem; margin-left: 8px; }

  /* 当日相対: 絶対タグと視覚的に別物にする（紫の枠・破線） */
  .rvb-highlight { border: 2px dashed #a855f7; border-radius: 12px; padding: 12px 14px; background: rgba(168,85,247,.10); margin-bottom: 14px; }
  .rvb-highlight-head { font-weight: 800; color: #e9d5ff; font-size: .92rem; }
  .rvb-highlight-list { list-style: none; margin: 8px 0 6px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .hl { display: flex; gap: 6px; align-items: baseline; padding: 4px 10px; border-radius: 8px; background: rgba(168,85,247,.16); border: 1px solid rgba(168,85,247,.45); }
  .hl-key { color: #f3e8ff; font-size: .82rem; }
  .hl-val { font-weight: 800; color: #fff; }
  .rvb-highlight-note { margin: 0; font-size: .74rem; color: #ddd6fe; line-height: 1.7; }

  .rvb-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .rvb-row { border-left: 5px solid #64748b; border-radius: 10px; background: rgba(15,23,42,.6); padding: 10px 12px; border-top: 1px solid rgba(148,163,184,.2); border-right: 1px solid rgba(148,163,184,.2); border-bottom: 1px solid rgba(148,163,184,.2); }
  .rvb-row.is-tagged { border-left-color: #0ea5e9; }
  .rvb-row.is-neutral { border-left-color: #94a3b8; }
  .rvb-row.is-nohistory { border-left-color: #6b7280; background: rgba(15,23,42,.4); }
  .rvb-row.is-pending { border-left-color: #fb923c; background: rgba(251,146,60,.07); }

  .rvb-row-main { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .rvb-time { color: #cbd5e1; font-variant-numeric: tabular-nums; font-size: .85rem; }
  .rvb-r { font-weight: 800; color: #38bdf8; min-width: 2.6em; }
  .rvb-name { font-weight: 700; color: #f1f5f9; }
  .rvb-meta { color: #cbd5e1; font-size: .82rem; margin-left: auto; }

  .rvb-row-tags { margin-top: 7px; display: flex; flex-wrap: wrap; gap: 6px; }
  .rvb-tag, .rvb-state { border-radius: 7px; padding: 3px 9px; font-size: .8rem; border: 1px solid; display: inline-flex; align-items: center; gap: 5px; font-weight: 600; }
  .rvb-tag-ic { font-weight: 800; }
  .rvb-tag-n { font-size: .72rem; opacity: .95; font-weight: 500; }
  .tag-distance { color: #fde68a; border-color: #f59e0b; background: rgba(245,158,11,.18); }
  .tag-course   { color: #bbf7d0; border-color: #22c55e; background: rgba(34,197,94,.18); }
  .tag-jockey   { color: #ddd6fe; border-color: #8b5cf6; background: rgba(139,92,246,.2); }
  .tag-compare  { color: #bae6fd; border-color: #0ea5e9; background: rgba(14,165,233,.18); }
  .tag-contrast { color: #fecaca; border-color: #ef4444; background: rgba(239,68,68,.18); }
  .st-neutral   { color: #e2e8f0; border-color: #94a3b8; background: rgba(148,163,184,.16); }
  .st-nohistory { color: #e5e7eb; border-color: #6b7280; background: rgba(107,114,128,.22); }
  .st-pending   { color: #fed7aa; border-color: #fb923c; background: rgba(251,146,60,.18); }

  /* details: 開いていることが一目で分かる */
  .rvb-detail { margin-top: 9px; border: 1px solid rgba(148,163,184,.28); border-radius: 10px; background: rgba(2,6,23,.35); }
  .rvb-detail[open], .rvb-detail.is-open { border-color: #22d3ee; background: rgba(8,47,73,.55); box-shadow: 0 0 0 2px rgba(34,211,238,.18) inset; }
  .rvb-detail-sum { cursor: pointer; color: #7dd3fc; font-size: .84rem; list-style: none; padding: 8px 12px; display: flex; align-items: center; gap: 8px; font-weight: 700; }
  .rvb-detail-sum::-webkit-details-marker { display: none; }
  .rvb-detail-ic { display: inline-flex; width: 20px; height: 20px; align-items: center; justify-content: center; border-radius: 6px; background: rgba(56,189,248,.2); border: 1px solid rgba(56,189,248,.5); font-weight: 800; }
  .rvb-detail[open] .rvb-detail-sum { color: #ecfeff; }
  .rvb-detail[open] .rvb-detail-ic { background: #22d3ee; color: #082f49; border-color: #22d3ee; }
  .rvb-detail[open] .rvb-detail-ic::after { content: ''; }
  .rvb-detail[open] .rvb-detail-txt::after { content: '（開いています）'; font-size: .72rem; color: #a5f3fc; margin-left: 6px; font-weight: 500; }
  .rvb-detail-body { padding: 4px 12px 14px; border-top: 1px solid rgba(34,211,238,.3); }

  .rvb-sentence { margin: 8px 0 0; font-size: .88rem; line-height: 1.8; color: #f1f5f9; border-left: 3px solid #64748b; padding-left: 9px; }
  .sn-distance { border-left-color: #f59e0b; }
  .sn-course { border-left-color: #22c55e; }
  .sn-jockey { border-left-color: #8b5cf6; }
  .sn-compare { border-left-color: #0ea5e9; }
  .sn-contrast { border-left-color: #ef4444; }
  .sn-neutral { border-left-color: #94a3b8; }
  .sn-nohistory { border-left-color: #6b7280; }
  .sn-pending { border-left-color: #fb923c; }
  .rvb-degraded { margin: 8px 0 0; font-size: .8rem; color: #fdba74; }
  .rvb-cov { margin: 8px 0 0; font-size: .76rem; color: #cbd5e1; }

  /* 出走馬 */
  .rvb-horses { margin-top: 12px; border-top: 1px dashed rgba(148,163,184,.35); padding-top: 10px; }
  .rvb-horses-head { font-size: .88rem; font-weight: 800; color: #f8fafc; margin: 0 0 3px; }
  .rvb-horses-note { font-size: .72rem; color: #cbd5e1; margin: 0 0 8px; }
  .rvb-horse-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; }
  .rvb-horse { display: grid; grid-template-columns: 26px 30px minmax(6.5em, 1fr) auto; grid-template-areas: 'mark num name sub' 'chips chips chips chips' 'prev prev prev prev'; gap: 2px 8px; align-items: baseline; padding: 6px 8px; border-radius: 8px; background: rgba(30,41,59,.55); border-left: 3px solid transparent; }
  .rvb-horse.hm-main { border-left-color: #ef4444; background: rgba(239,68,68,.12); }
  .rvb-horse.hm-sub { border-left-color: #f59e0b; background: rgba(245,158,11,.1); }
  .rvb-horse.hm-tana { border-left-color: #22c55e; background: rgba(34,197,94,.1); }
  .rvb-horse.hm-ren { border-left-color: #0ea5e9; background: rgba(14,165,233,.1); }
  .rvb-horse-mark { grid-area: mark; font-weight: 800; font-size: 1rem; color: #f8fafc; text-align: center; }
  .rvb-horse-num { grid-area: num; font-variant-numeric: tabular-nums; color: #e2e8f0; font-weight: 700; text-align: right; }
  .rvb-horse-name { grid-area: name; font-weight: 700; color: #f8fafc; font-size: .9rem; }
  .rvb-horse-sub { grid-area: sub; font-size: .74rem; color: #cbd5e1; text-align: right; }
  .rvb-horse-prev { grid-area: prev; font-size: .74rem; color: #94a3b8; }
  .rvb-horse-chips { grid-area: chips; display: flex; flex-wrap: wrap; gap: 4px; }
  .rvb-chip { font-size: .7rem; padding: 2px 7px; border-radius: 999px; border: 1px solid; display: inline-flex; gap: 3px; align-items: center; }
  .chip-distance { color: #fde68a; border-color: #f59e0b; background: rgba(245,158,11,.18); }
  .chip-course   { color: #bbf7d0; border-color: #22c55e; background: rgba(34,197,94,.18); }
  .chip-jockey   { color: #ddd6fe; border-color: #8b5cf6; background: rgba(139,92,246,.2); }
  .chip-compare  { color: #bae6fd; border-color: #0ea5e9; background: rgba(14,165,233,.18); }
  .chip-none     { color: #cbd5e1; border-color: #64748b; background: rgba(100,116,139,.2); }

  /* CTA: 買い目は有料版で */
  .rvb-cta { margin-top: 14px; border: 1px solid #f59e0b; border-radius: 10px; background: linear-gradient(180deg, rgba(245,158,11,.14), rgba(245,158,11,.05)); padding: 11px 12px; }
  .rvb-cta-head { margin: 0 0 5px; font-weight: 800; color: #fde68a; font-size: .88rem; }
  .rvb-cta-body { margin: 0 0 9px; font-size: .8rem; line-height: 1.75; color: #f1f5f9; }
  .rvb-cta-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .rvb-cta-a, .rvb-cta-b { font-size: .82rem; font-weight: 700; text-decoration: none; padding: 7px 12px; border-radius: 8px; }
  .rvb-cta-a { background: #f59e0b; color: #1c1917; }
  .rvb-cta-b { border: 1px solid #f59e0b; color: #fde68a; }
  .rvb-cta-a:hover { background: #fbbf24; }
