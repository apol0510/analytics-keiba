---
// JRA 1会場描画 component（候補A: scoped <style>）。active会場と非選択会場フラグメントを同一生成。
import RaceAccordionClickClose from './RaceAccordionClickClose.astro';
import { enrichHorse, formatRecentVenue, parseSexAge, parseDistanceMeters } from '../lib/horseEnrichment.js';
import { isOsaeCandidate, sortOsaeCandidates, isIneligibleHorse, getDisplayComputerIndex, getHorseAiIndex } from '../lib/shared-prediction-logic.js';
import { loadFeatureScores, getHorseFeatures, venueCodeFromName } from '../lib/loadFeatureScores.js';
import { deriveAkImportance } from '../lib/akFeatureSummary.js';
const RECENT_LABELS = ['前走', '2走前', '3走前', '4走前', '5走前'];
const getDisplayIndex = (horse, enriched) => getHorseAiIndex(horse) ?? getHorseAiIndex(enriched);
function _displayRecentOf(horse) {
  if (Array.isArray(horse?.recentRacesFromHistories) && horse.recentRacesFromHistories.length > 0) {
    return horse.recentRacesFromHistories;
  }
  return Array.isArray(horse?.recentRaces) ? horse.recentRaces : [];
}

// 過去走データアコーディオン用: 条件別成績の文字列を組み立てる。
// JSX 内のテンプレートリテラル + 三項演算子だと Astro 5.13 パーサーが
// 比較演算子を JSX タグと誤認識することがあるため、フロントマッター側に外出ししている。
function fmtHistoryCondStat(s) {
  let out = s.n + '戦 ' + s.w + '-' + s.p2 + '-' + s.p3;
  if (s.n > 0) {
    const ratio = Math.round(((s.w + s.p2 + s.p3) / s.n) * 100);
    out += ' (3着内' + ratio + '%)';
  }
  return out;
}

// 過去走データアコーディオンの集計を1関数に集約。
// 各馬カードの JSX 内に書いていた IIFE が Astro 5.13 のパーサーで
// 比較演算子をJSXタグ開始と誤認識してビルドが落ちるため、
// 集計をすべてフロントマッター側で実行し、JSX 内は値の参照のみに留める。
// AI 指数・印・買い目・特徴量重要度・予想ロジックには一切関与しない（表示専用）。
function buildHistoryAccordionContext(horse, race) {
  if (!horse || !Array.isArray(horse.historyForDetails) || horse.historyForDetails.length === 0) return null;
  const hist = horse.historyForDetails;
  const ranked = hist.filter((r) => r && Number.isFinite(Number(r.rank)));
  const totalRanked = ranked.length;
  const cnt = (pred) => ranked.filter(pred).length;
  const w = cnt((r) => Number(r.rank) === 1);
  const p2 = cnt((r) => Number(r.rank) === 2);
  const p3 = cnt((r) => Number(r.rank) === 3);
  const others = totalRanked - w - p2 - p3;
  const hasRanked = totalRanked > 0;
  const pct = (n) => hasRanked ? Math.round((n / totalRanked) * 100) : 0;
  const winPct = pct(w);
  const placePct = pct(w + p2);
  const showPct = pct(w + p2 + p3);
  const condCount = (arr) => ({
    n: arr.length,
    w: arr.filter((r) => Number(r.rank) === 1).length,
    p2: arr.filter((r) => Number(r.rank) === 2).length,
    p3: arr.filter((r) => Number(r.rank) === 3).length,
  });
  const turfStat = condCount(ranked.filter((r) => r.surface === '芝'));
  const dirtStat = condCount(ranked.filter((r) => r.surface === 'ダ'));
  const _rawRaceDist = race && race.raceInfo && race.raceInfo.distance != null ? race.raceInfo.distance : null;
  const _parsedRaceDist = _rawRaceDist != null ? parseDistanceMeters(_rawRaceDist) : null;
  const raceDist = Number.isFinite(_parsedRaceDist) ? _parsedRaceDist : null;
  const raceVenue = race && race.raceInfo && race.raceInfo.venue ? race.raceInfo.venue : null;
  const sameDist = raceDist != null
    ? condCount(ranked.filter((r) => Number.isFinite(Number(r.distanceMeters)) && Math.abs(Number(r.distanceMeters) - raceDist) <= 200))
    : null;
  const sameVenue = raceVenue ? condCount(ranked.filter((r) => r.venue === raceVenue)) : null;
  const _weight = (horse.weight != null && horse.weight !== '' && Number.isFinite(Number(horse.weight)))
    ? (horse.weight + 'kg')
    : null;
  const _sex = parseSexAge(horse.age);
  const _ageGenderDisplay = (_sex.ageNum != null && _sex.gender)
    ? (_sex.ageNum + '歳' + _sex.gender)
    : (horse.age || null);
  const profileItems = [
    _ageGenderDisplay && { label: '性齢', value: _ageGenderDisplay },
    horse.sire && { label: '父', value: horse.sire },
    horse.jockey && { label: '騎手', value: horse.jockey },
    _weight && { label: '斤量', value: _weight },
    horse.trainer && { label: '調教師', value: horse.trainer },
  ].filter(Boolean);
  const condRows = [
    turfStat.n > 0 && { label: '芝', stat: turfStat },
    dirtStat.n > 0 && { label: 'ダート', stat: dirtStat },
    sameDist && sameDist.n > 0 && { label: '同距離±200m(' + raceDist + 'm基準)', stat: sameDist },
    sameVenue && sameVenue.n > 0 && { label: '同会場(' + raceVenue + ')', stat: sameVenue },
  ].filter(Boolean);
  const display = hist.slice(0, 10);
  const overflow = hist.length - display.length;
  const hasOverflow = overflow > 0;
  const sectionLabel = hist.length > 10 ? '競走成績（直近10走）' : '競走成績';
  const summaryCount = '（' + hist.length + '走）';
  const recordValue = w + '-' + p2 + '-' + p3 + '-' + others;
  const winPctStr = winPct + '%';
  const placePctStr = placePct + '%';
  const showPctStr = showPct + '%';
  const rows = display.map((r) => {
    const rankNum = Number(r.rank);
    const isWin = rankNum === 1;
    const isGood = Number.isFinite(rankNum) && rankNum < 4;
    const rankClass = isWin ? 'hh-rank win' : (isGood ? 'hh-rank good' : 'hh-rank');
    const hasFinishStatus = !!r.finishStatus;
    const hasRank = r.rank != null && !hasFinishStatus;
    const hasPopularity = r.popularity !== '' && r.popularity != null;
    return {
      r,
      rankClass,
      hasFinishStatus,
      hasRank,
      hasPopularity,
    };
  });
  return {
    hist,
    totalRanked,
    hasRanked,
    hasProfile: profileItems.length > 0,
    hasCondRows: condRows.length > 0,
    w, p2, p3, others,
    profileItems,
    condRows,
    rows,
    overflow,
    hasOverflow,
    sectionLabel,
    summaryCount,
    recordValue,
    winPctStr,
    placePctStr,
    showPctStr,
  };
}
const { venueData, venueIndex, isMultiVenue, predictionData } = Astro.props;
            const venuePredictions = venueData.predictions;
            const venueInfo = venueData.eventInfo;

            // AK専用3項目の素材: shared featureScores を会場単位で1回ロード（読むだけ）。
            // 無ければ null → 各馬は既存 e.importance fallback。
            const fsDate = venueInfo?.date || predictionData?.date || predictionData?.eventInfo?.date || null;
            const featureScoresData = loadFeatureScores('jra', fsDate, venueCodeFromName('jra', venueInfo?.venue));

---
              <div class={`venue-content ${venueIndex === 0 ? 'active' : ''}`} data-venue-index={venueIndex}>
                {/* 会場名（複数会場の場合のみ表示）*/}
                {isMultiVenue && (
                  <div class="venue-header">
                    <h2 class="venue-title">{venueInfo.venue}</h2>
                    <p class="venue-info">{venueInfo.date} - {venueInfo.totalRaces}レース（無料公開）</p>
                  </div>
                )}

                <!-- 全レースアコーディオン（南関版と同じ縦一覧形式） -->
                <div class="jra-race-accordion-list">
                  {venuePredictions.map((race, raceIndex) => {
                    const allHorses = race.horses;
                    // 役割で絞り込み（南関版と統一: 本命・対抗・単穴）
                    const roleHorses = ['本命', '対抗', '単穴']
                      .flatMap(r => allHorses.filter(h => h.role === r));
                    const accordionId = `jra-race-v${venueIndex}-r${raceIndex}`;
                    const distance = race.raceInfo.distance;
                    const distanceLabel = distance
                      ? (typeof distance === 'number' ? `${distance}m` : `${distance}`)
                      : null;

                    return (
                      <div class="jra-race-accordion" data-venue-index={venueIndex}>
                        <button
                          type="button"
                          class="jra-race-accordion-header"
                          data-target={accordionId}
                          aria-expanded="false"
                          aria-controls={accordionId}
                          onclick="toggleJraAccordion(this)"
                        >
                          <div class="jra-race-head-left">
                            <span class="jra-race-num">{race.raceInfo.raceNumber}R</span>
                            <div class="jra-race-meta">
                              {race.raceInfo.raceName && (
                                <span class="jra-race-name">{race.raceInfo.raceName}</span>
                              )}
                              <div class="jra-race-meta-line">
                                {race.raceInfo.startTime && <span class="jra-race-meta-item">🕐 {race.raceInfo.startTime}発走</span>}
                                {distanceLabel && <span class="jra-race-meta-item">📏 {distanceLabel}</span>}
                                {race.raceInfo.horseCount && <span class="jra-race-meta-item">🐴 {race.raceInfo.horseCount}頭</span>}
                              </div>
                            </div>
                          </div>
                          <span class="jra-race-toggle" aria-hidden="true">▼</span>
                        </button>

                        <div class="jra-race-accordion-content" id={accordionId} style="max-height:0;opacity:0">
                          <div class="jra-race-accordion-body">
                        {/* AI選出馬カード（南関版と統一デザイン） */}
                        <div class="analysis-section">
                          <h2 class="section-title">
                            <span>🤖</span>
                            <span>AIモデル選出馬</span>
                          </h2>

                          {roleHorses.map((horse) => {
                            const e = enrichHorse(horse, allHorses, race.raceInfo?.distance);
                            const role = horse.role;
                            const cardClass = role === '本命' ? 'horse-card horse-card-main'
                              : role === '対抗' ? 'horse-card horse-card-sub'
                              : 'horse-card horse-card-tana';
                            const mark = role === '本命' ? '◎' : role === '対抗' ? '○' : '▲';
                            const markClass = role === '本命' ? 'horse-mark-main'
                              : role === '対抗' ? 'horse-mark-sub'
                              : 'horse-mark-tana';
                            const ageGenderStr = (e.ageNum != null && e.gender)
                              ? `${e.ageNum}歳${e.gender}`
                              : (horse.age || null);
                            const weightStr = (horse.weight != null && horse.weight !== '' && Number.isFinite(Number(horse.weight)))
                              ? `${horse.weight}kg`
                              : null;
                            const displayIndex = getDisplayIndex(horse, e);
                            const hasBasicInfo = ageGenderStr || weightStr || horse.jockey || horse.trainer || horse.frame != null || horse.sire;
                            const recentRaces = _displayRecentOf(horse);
                            return (
                              <div class={cardClass}>
                                {role === '本命' && <div class="main-glow" aria-hidden="true"></div>}
                                <div class="horse-header">
                                  <div class="horse-identity">
                                    <span class={markClass}>{mark}</span>
                                    <span class="horse-number">{horse.horseNumber}</span>
                                    <span class="horse-name">{horse.horseName}</span>
                                  </div>
                                  <span class={`role-badge role-badge-${role === '本命' ? 'main' : role === '対抗' ? 'sub' : 'tana'}`}>{role}</span>
                                </div>

                                <div class="horse-stats-row">
                                  <div class="stat-block stat-score-block">
                                    <div class="stat-label">累積スコア</div>
                                    <div class="stat-value stat-score">{e.pt}<span class="stat-unit">pt</span></div>
                                  </div>
                                  {displayIndex != null && (
                                    <div class="stat-block stat-index-block">
                                      <div class="stat-label">AI総合指数</div>
                                      <div class="stat-value stat-index">{displayIndex}</div>
                                    </div>
                                  )}
                                </div>

                                {hasBasicInfo && (
                                  <div class="basic-info">
                                    <h4>基本情報</h4>
                                    <div class="info-grid">
                                      {(ageGenderStr || weightStr) && (
                                        <div class="info-line info-line-primary">
                                          {ageGenderStr && <span class="info-chip">{ageGenderStr}</span>}
                                          {weightStr && <span class="info-chip">{weightStr}</span>}
                                        </div>
                                      )}
                                      {horse.jockey && (
                                        <div class="info-line"><span class="info-key">騎手</span><span class="info-val">{horse.jockey}</span></div>
                                      )}
                                      {horse.trainer && (
                                        <div class="info-line"><span class="info-key">調教師</span><span class="info-val">{horse.trainer}</span></div>
                                      )}
                                      {horse.frame != null && (
                                        <div class="info-line"><span class="info-key">枠番</span><span class="info-val">{horse.frame}枠</span></div>
                                      )}
                                      {horse.sire && (
                                        <div class="info-line"><span class="info-key">父</span><span class="info-val">{horse.sire}</span></div>
                                      )}
                                    </div>
                                  </div>
                                )}

                                {e.evalPoints.length > 0 && (
                                  <div class="eval-points">
                                    <h4>評価ポイント</h4>
                                    <div class="eval-tags">
                                      {e.evalPoints.map((p) => (
                                        <span class="eval-tag">{p}</span>
                                      ))}
                                    </div>
                                  </div>
                                )}

                                {/* 特徴量重要度: shared featureScores 由来の AK専用3項目を優先。
                                    無い/算出不能なら既存 e.importance(computeImportance 由来) に fallback。
                                    両者は排他（二重表示しない）。AK では6項目名・個別値はそのまま出さない。 */}
                                {(() => {
                                  const fs6 = featureScoresData
                                    ? getHorseFeatures(featureScoresData, race.raceInfo.raceNumber, horse.horseNumber)
                                    : null;
                                  const akImp = fs6 ? deriveAkImportance(fs6) : null;
                                  if (akImp) {
                                    return (
                                      <div class="feature-importance">
                                        <h4>特徴量重要度</h4>
                                        <div class="importance-list">
                                          {akImp.map((item) => (
                                            <div class="importance-item">
                                              <span class="importance-label">{item.label}</span>
                                              <div class="importance-bar">
                                                <div class="importance-fill" style={`width: ${item.value == null ? 0 : item.value}%`}></div>
                                              </div>
                                              <span class="importance-percent">{item.value == null ? '—' : `${item.value}%`}</span>
                                            </div>
                                          ))}
                                        </div>
                                      </div>
                                    );
                                  }
                                  if (e.importance && e.importance.length > 0) {
                                    return (
                                      <div class="feature-importance">
                                        <h4>特徴量重要度</h4>
                                        <div class="importance-list">
                                          {e.importance.map((item) => (
                                            <div class="importance-item">
                                              <span class="importance-label">{item.label}</span>
                                              <div class="importance-bar">
                                                <div class="importance-fill" style={`width: ${item.value * 100}%`}></div>
                                              </div>
                                              <span class="importance-percent">{Math.round(item.value * 100)}%</span>
                                            </div>
                                          ))}
                                        </div>
                                      </div>
                                    );
                                  }
                                  return null;
                                })()}

                                {recentRaces.length > 0 && (
                                  <details class="recent-races recent-races-compact" data-click-close="true">
                                    <summary>過去{Math.min(5, recentRaces.length)}走</summary>
                                    <div class="recent-races-list">
                                      {recentRaces.slice(0, 5).map((r, i) => {
                                        const rank = (r?.rank != null && Number.isFinite(Number(r.rank))) ? `${r.rank}着` : '';
                                        return (
                                          <div class="recent-race-row">
                                            <span class="recent-race-label">{RECENT_LABELS[i]}</span>
                                            <span class="recent-race-venue">{formatRecentVenue(r?.venue) || ''}</span>
                                            <span class="recent-race-distance">{r?.distance || ''}</span>
                                            <span class="recent-race-rank">{rank}</span>
                                            {r?.time && <span class="recent-race-meta">タイム{r.time}</span>}
                                            {r?.last3f && <span class="recent-race-meta">上がり{r.last3f}</span>}
                                            {r?.bodyWeight && <span class="recent-race-meta">{r.bodyWeight}kg</span>}
                                          </div>
                                        );
                                      })}
                                    </div>
                                  </details>
                                )}
                                {/* 過去走データ（メイン馬カード用・表示専用） */}
                                {(() => {
                                  const ctx = buildHistoryAccordionContext(horse, race);
                                  if (!ctx) return null;
                                  return (
                                    <details class="history-details" data-click-close="true">
                                      <summary class="history-summary">
                                        <span class="history-summary-text">過去走データ</span>
                                        <span class="history-summary-count">{ctx.summaryCount}</span>
                                        <span class="history-summary-chevron" aria-hidden="true">▾</span>
                                      </summary>
                                      <div class="history-content">
                                        {ctx.hasProfile && (
                                          <div class="history-section">
                                            <div class="history-section-label">プロフィール</div>
                                            <div class="history-profile-grid">
                                              {ctx.profileItems.map((p) => (
                                                <div class="history-profile-item">
                                                  <span class="history-profile-label">{p.label}</span>
                                                  <span class="history-profile-value">{p.value}</span>
                                                </div>
                                              ))}
                                            </div>
                                          </div>
                                        )}
                                        {ctx.hasRanked && (
                                          <div class="history-section">
                                            <div class="history-section-label">通算成績</div>
                                            <div class="history-record-grid">
                                              <div class="history-rec-card">
                                                <div class="history-rec-label">通算</div>
                                                <div class="history-rec-value">{ctx.recordValue}</div>
                                              </div>
                                              <div class="history-rec-card">
                                                <div class="history-rec-label">勝率</div>
                                                <div class="history-rec-value">{ctx.winPctStr}</div>
                                              </div>
                                              <div class="history-rec-card">
                                                <div class="history-rec-label">連対率</div>
                                                <div class="history-rec-value">{ctx.placePctStr}</div>
                                              </div>
                                              <div class="history-rec-card">
                                                <div class="history-rec-label">3着内率</div>
                                                <div class="history-rec-value">{ctx.showPctStr}</div>
                                              </div>
                                            </div>
                                          </div>
                                        )}
                                        {ctx.hasCondRows && (
                                          <div class="history-section">
                                            <div class="history-section-label">条件別成績</div>
                                            <div class="history-cond-list">
                                              {ctx.condRows.map((row) => (
                                                <div class="history-cond-row">
                                                  <span class="history-cond-label">{row.label}</span>
                                                  <span class="history-cond-stat">{fmtHistoryCondStat(row.stat)}</span>
                                                </div>
                                              ))}
                                            </div>
                                          </div>
                                        )}
                                        <div class="history-section">
                                          <div class="history-section-label">{ctx.sectionLabel}</div>
                                          <div class="history-list">
                                            {ctx.rows.map((row) => (
                                              <div class="history-row">
                                                <div class="hh-line hh-line-primary">
                                                  {row.r._dateStr && <span class="hh-date">{row.r._dateStr}</span>}
                                                  {row.r.venue && <span class="hh-venue">{row.r.venue}</span>}
                                                  {row.r._displayDistance && <span class="hh-dist">{row.r._displayDistance}</span>}
                                                  {row.hasFinishStatus && <span class="hh-status">[{row.r.finishStatus}]</span>}
                                                  {row.hasRank && <span class={row.rankClass}>{row.r.rank}着</span>}
                                                  {row.hasPopularity && <span class="hh-pop">{row.r.popularity}人気</span>}
                                                </div>
                                                <div class="hh-line hh-line-secondary">
                                                  {row.r.raceName && <span class="hh-race-name">{row.r.raceName}</span>}
                                                  {row.r.jockey && <span class="hh-jockey">🏇 {row.r.jockey}</span>}
                                                  {row.r.bodyWeight && <span class="hh-bw">{row.r.bodyWeight}kg</span>}
                                                  {row.r.time && <span class="hh-time">{row.r.time}</span>}
                                                  {row.r.winnerName && <span class="hh-winner">勝: {row.r.winnerName}</span>}
                                                </div>
                                              </div>
                                            ))}
                                            {ctx.hasOverflow && (
                                              <div class="hh-overflow">他{ctx.overflow}走あり</div>
                                            )}
                                          </div>
                                        </div>
                                      </div>
                                    </details>
                                  );
                                })()}
                              </div>
                            );
                          })}

                          {/* 連下・抑えの実データ（登録済みユーザーのみ表示・デフォルト非表示）
                              premium-prediction/jra.astro と同じ minor-horse-card 構造 */}
                          <div class="free-member-unlock-content" style="display: none;">
                            {allHorses.filter(h => h.role === '連下最上位' || h.role === '連下').length > 0 && (
                              <div class="horse-card horse-card-minor minor-group-renka">
                                <div class="horse-header">
                                  <div>
                                    <span class="horse-mark-minor">△</span>
                                    <span class="minor-group-title minor-group-title-renka">連下候補馬</span>
                                  </div>
                                </div>
                                <div class="minor-horse-grid">
                                  {allHorses
                                    .filter(h => h.role === '連下最上位' || h.role === '連下')
                                    .map((horse) => {
                                      const eMinor = enrichHorse(horse, allHorses, race.raceInfo?.distance);
                                      const evalPoints = Array.isArray(eMinor.evalPoints) ? eMinor.evalPoints : [];
                                      const importance = Array.isArray(eMinor.importance) && eMinor.importance.length >= 3 ? eMinor.importance : null;
                                      const recentRaces = _displayRecentOf(horse);
                                      const weightStr = (horse.weight != null && Number.isFinite(Number(horse.weight))) ? `${horse.weight}kg` : null;
                                      const idx = getDisplayIndex(horse, eMinor);
                                      return (
                                        <div class="minor-horse-card minor-horse-card-renka">
                                          <div class="minor-horse-head">
                                            <span class="minor-horse-mark">△</span>
                                            <span class="minor-horse-number">{horse.horseNumber}</span>
                                            <span class="minor-horse-name">{horse.horseName}</span>
                                            <span class="minor-horse-score">{eMinor.pt ?? 0}pt</span>
                                          </div>
                                          <div class="minor-horse-meta">
                                            {horse.jockey && <span><span class="meta-key">騎手</span>{horse.jockey}</span>}
                                            {horse.trainer && <span><span class="meta-key">厩舎</span>{horse.trainer}</span>}
                                            {weightStr && <span><span class="meta-key">斤量</span>{weightStr}</span>}
                                            {idx != null && <span><span class="meta-key">指数</span>{idx}</span>}
                                          </div>
                                          {evalPoints.length > 0 && (
                                            <div class="minor-horse-evals">
                                              {evalPoints.slice(0, 3).map((p) => (<span class="eval-tag-small">{p}</span>))}
                                            </div>
                                          )}
                                          {importance && (
