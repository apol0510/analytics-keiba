---
// 本命・対抗・単穴 共通の rich 馬カード
//
// 🎯 単一ソース: このコンポーネントが Premium / Light 両方の主力馬表示を担当する。
//   ・admin が src/data/predictions/*.json を更新すれば自動的に両ページで同じ表示になる
//   ・スタイル変更は HorseMainCard.astro 一箇所だけで全ページに反映
//   ・横展開: free-prediction / premium-prediction も将来このコンポーネントに移行可能
//
// 必要なデータ: normalizeHorseData() で正規化済みの horse オブジェクト
//   - role, displayMark, number, name
//   - pt, stars, confidence
//   - jockey, trainer, weight, age, ageNum, gender, frame, computerIndex, sire/_sire
//   - importance (オプション), evalPoints (オプション), recentRaces (オプション)

import { getRoleDisplayConfig, getDisplayComputerIndex, getHorseAiIndex } from '../lib/shared-prediction-logic.js';
import { getDisplayRecentRacesForNankan } from '../lib/getDisplayRecentRacesForNankan.js';
import NankanHorseStatsPanel from './NankanHorseStatsPanel.astro';

interface HorseLike {
    role?: string;
    displayMark?: string;
    number?: number | string;
    name?: string;
    pt?: number;
    stars?: string;
    confidence?: number | null;
    jockey?: string;
    trainer?: string;
    weight?: number | string | null;
    age?: string;
    ageNum?: number;
    gender?: string;
    frame?: number;
    computerIndex?: number;
    sire?: string;
    _sire?: string;
    importance?: { label: string; value: number }[];
    evalPoints?: string[];
    recentRaces?: any[];
}

interface Props {
    horse: HorseLike;
}

const { horse } = Astro.props as Props;
const roleConfig = getRoleDisplayConfig(horse.role);
const cardClass = horse.role === '本命'
    ? 'horse-card horse-card-main'
    : horse.role === '対抗'
        ? 'horse-card horse-card-sub'
        : 'horse-card horse-card-tana';
const pt = horse.pt ?? 0;
const importance = horse.importance && horse.importance.length > 0 ? horse.importance : null;
const evalPoints = Array.isArray(horse.evalPoints) ? horse.evalPoints : [];
const recentRaces = (Array.isArray(horse?.recentRacesFromEntriesNankan) && horse.recentRacesFromEntriesNankan.length > 0)
    ? horse.recentRacesFromEntriesNankan
    : getDisplayRecentRacesForNankan(horse);
// JRA light の horseHistories 由来馬のみ: 過去5走を premium 風 compact 行 ＋ 過去走データ accordion に切替。
// 南関 light（フラグ無し）は既存の3行カードのまま影響しない。
const isJraHist = horse?.isJraHistoryEnriched === true;
const jraHistory = (isJraHist && Array.isArray(horse.historyForDetails) && horse.historyForDetails.length > 0)
    ? horse.historyForDetails
    : null;
const jraHistoryCtx = (() => {
    if (!jraHistory) return null;
    const ranked = jraHistory.filter((r) => r && Number.isFinite(Number(r.rank)));
    const total = ranked.length;
    const c = (n) => ranked.filter((r) => Number(r.rank) === n).length;
    const w = c(1), p2 = c(2), p3 = c(3);
    const others = total - w - p2 - p3;
    const pct = (n) => total > 0 ? Math.round((n / total) * 100) : 0;
    const wStr = (horse.weight != null && horse.weight !== '' && Number.isFinite(Number(horse.weight))) ? `${horse.weight}kg` : null;
    const ageGender = (horse.ageNum != null && horse.gender) ? `${horse.ageNum}歳${horse.gender}` : (horse.age || null);
    const profileItems = [
        ageGender && { label: '性齢', value: ageGender },
        (horse.sire || horse._sire) && { label: '父', value: horse.sire || horse._sire },
        horse.jockey && { label: '騎手', value: horse.jockey },
        wStr && { label: '斤量', value: wStr },
        horse.trainer && { label: '調教師', value: horse.trainer },
    ].filter(Boolean);
    // 条件別成績（premium JRA 同方式）: 芝 / ダート / 同距離±200m / 同会場。rank 数値の走のみ集計。
    const condCount = (arr) => ({
        n: arr.length,
        w: arr.filter((r) => Number(r.rank) === 1).length,
        p2: arr.filter((r) => Number(r.rank) === 2).length,
        p3: arr.filter((r) => Number(r.rank) === 3).length,
    });
    const fmtCond = (s) => {
        let out = `${s.n}戦 ${s.w}-${s.p2}-${s.p3}`;
        if (s.n > 0) out += `（3着内${Math.round(((s.w + s.p2 + s.p3) / s.n) * 100)}%）`;
        return out;
    };
    const turf = condCount(ranked.filter((r) => r.surface === '芝'));
    const dirt = condCount(ranked.filter((r) => r.surface === 'ダ'));
    const raceDist = Number.isFinite(Number(horse._raceDistanceMeters)) ? Number(horse._raceDistanceMeters) : null;
    const raceVenue = horse._raceVenueName || null;
    const sameDist = raceDist != null
        ? condCount(ranked.filter((r) => Number.isFinite(Number(r.distanceMeters)) && Math.abs(Number(r.distanceMeters) - raceDist) <= 200))
        : null;
    const sameVenue = raceVenue ? condCount(ranked.filter((r) => r.venue === raceVenue)) : null;
    const condRows = [
        turf.n > 0 && { label: '芝', stat: fmtCond(turf) },
        dirt.n > 0 && { label: 'ダート', stat: fmtCond(dirt) },
        sameDist && sameDist.n > 0 && { label: `同距離±200m（${raceDist}m基準）`, stat: fmtCond(sameDist) },
        sameVenue && sameVenue.n > 0 && { label: `同会場（${raceVenue}）`, stat: fmtCond(sameVenue) },
    ].filter(Boolean);
    // 競走成績（最大10走）: rank は finish 由来（order は使わない）。非数値は finishStatus 単独。
    const display = jraHistory.slice(0, 10);
    const overflow = jraHistory.length - display.length;
    const rows = display.map((r) => {
        const rankNum = Number(r.rank);
        const hasFinishStatus = !!r.finishStatus;
        const hasRank = r.rank != null && Number.isFinite(rankNum) && !hasFinishStatus;
        const isGood = Number.isFinite(rankNum) && rankNum < 4;
        return {
            dateStr: r._dateStr || '',
            venue: r.venue || '',
            dist: r._displayDistance || '',
            hasRank,
            rank: rankNum,
            isGood,
            hasFinishStatus,
            finishStatus: r.finishStatus || '',
            hasPop: r.popularity !== '' && r.popularity != null,
            popularity: r.popularity,
            raceName: r.raceName || '',
            jockey: r.jockey || '',
            bodyWeight: r.bodyWeight ?? '',
            time: r.time || '',
        };
    });
    return {
        count: jraHistory.length,
        hasRanked: total > 0,
        hasProfile: profileItems.length > 0,
        profileItems,
        recordValue: `${w}-${p2}-${p3}-${others}`,
        winPctStr: `${pct(w)}%`,
        placePctStr: `${pct(w + p2)}%`,
        showPctStr: `${pct(w + p2 + p3)}%`,
        hasCondRows: condRows.length > 0,
        condRows,
        sectionLabel: jraHistory.length > 10 ? '競走成績（直近10走）' : '競走成績',
        rows,
        hasOverflow: overflow > 0,
        overflow,
    };
})();
const weightStr = (horse.weight != null && horse.weight !== '' && Number.isFinite(Number(horse.weight)))
    ? `${horse.weight}kg`
    : null;
const ageGenderStr = (horse.ageNum != null && horse.gender)
    ? `${horse.ageNum}歳${horse.gender}`
    : (horse.age || null);
const hasBasicInfo = !!(ageGenderStr || weightStr || horse.jockey || horse.trainer || horse.frame != null || (horse.computerIndex != null && horse.computerIndex !== 0) || horse.sire || horse._sire);
const roleBadgeKey = horse.role === '本命' ? 'main' : horse.role === '対抗' ? 'sub' : 'tana';
---

<div class={cardClass}>
    {horse.role === '本命' && <div class="main-glow" aria-hidden="true"></div>}
    <div class="horse-header">
        <div class="horse-identity">
            <span class={roleConfig.markClass}>{horse.displayMark}</span>
            <span class="horse-number">{horse.number}</span>
            <span class="horse-name">{horse.name}</span>
        </div>
        <span class={`role-badge role-badge-${roleBadgeKey}`}>{horse.role}</span>
    </div>

    <div class="horse-stats-row">
        <div class="stat-block stat-score-block">
            <div class="stat-label">累積スコア</div>
            <div class="stat-value stat-score">{pt}<span class="stat-unit">pt</span></div>
        </div>
        {getHorseAiIndex(horse) != null && (
            <div class="stat-block stat-index-block">
                <div class="stat-label">AI総合指数</div>
                <div class="stat-value stat-index">{getHorseAiIndex(horse)}</div>
            </div>
        )}
    </div>

    {hasBasicInfo && (
        <div class="basic-info">
            <h4>基本情報</h4>
            <div class="info-grid">
                {(ageGenderStr || weightStr) && (
                    <div class="info-line info-line-primary">
                        {ageGenderStr && <span class="info-chip">{ageGenderStr}</span>}
                        {weightStr && <span class="info-chip">{weightStr}</span>}
                    </div>
                )}
                {horse.jockey && (
                    <div class="info-line"><span class="info-key">騎手</span><span class="info-val">{horse.jockey}</span></div>
                )}
                {horse.trainer && (
                    <div class="info-line"><span class="info-key">調教師</span><span class="info-val">{horse.trainer}</span></div>
                )}
                {horse.frame != null && (
                    <div class="info-line"><span class="info-key">枠番</span><span class="info-val">{horse.frame}枠</span></div>
                )}
                {(horse.sire || horse._sire) && (
                    <div class="info-line"><span class="info-key">父</span><span class="info-val">{horse.sire || horse._sire}</span></div>
                )}
            </div>
        </div>
    )}

    {evalPoints.length > 0 && (
        <div class="eval-points">
            <h4>評価ポイント</h4>
            <div class="eval-tags">
                {evalPoints.map((p) => (
                    <span class="eval-tag">{p}</span>
                ))}
            </div>
        </div>
    )}

    {importance && (
        <div class="feature-importance">
            <h4>特徴量重要度</h4>
            <div class="importance-list">
                {importance.map((item) => {
                    const pct = Math.max(0, Math.min(100, Math.round((Number(item.value) || 0) * 100)));
                    return (
                        <div class="importance-item">
                            <span class="importance-label">{item.label}</span>
                            <div class="importance-bar">
                                <div class="importance-fill" style={`width: ${pct}%`}></div>
                            </div>
                            <span class="importance-percent">{pct}%</span>
                        </div>
                    );
                })}
            </div>
        </div>
    )}

    {recentRaces.length > 0 && (
        <details class="recent-races" data-click-close="true">
            <summary>過去5走</summary>
            <div class="recent-races-list">
                {recentRaces.slice(0, 5).map((r, i) => {
                    const rankRaw = r?.rank ?? r?.finish;
                    const isNum = (rankRaw != null && Number.isFinite(Number(rankRaw)));
                    const rank = isNum ? `${rankRaw}着` : (r?.finishStatus || '');
                    const label = i === 0 ? '前走' : `${i + 1}走前`;
                    if (isJraHist) {
                        // JRA light: premium 風の compact 1行表示（騎手等の詳細は過去走データへ分離）。
                        return (
                            <div class="recent-race-compact">
                                {r?.venue && <span class="recent-race-venue">{r.venue}</span>}
                                {r?.distance && <span class="recent-race-distance">{r.distance}</span>}
                                {rank && <span class="recent-race-rank">{rank}</span>}
                                {r?.time && <span class="recent-race-meta">タイム{r.time}</span>}
                                {r?.bodyWeight && <span class="recent-race-meta">{r.bodyWeight}kg</span>}
                            </div>
                        );
                    }
                    const hasPerf = r?.time || r?.last3f || r?.margin || r?.passingOrder || r?.bodyWeight;
                    const hasMeta = r?.jockey || r?.carriedWeight || r?.raceName || r?.headCount;
                    return (
                        <div class="recent-race-card">
                            <div class="recent-race-line recent-race-line-main">
                                <span class="recent-race-tag">{label}</span>
                                {r?.date && <span class="recent-race-meta">{r.date}</span>}
                                {r?.venue && <span class="recent-race-venue">{r.venue}</span>}
                                {r?.distance && <span class="recent-race-distance">{r.distance}</span>}
                                {r?.trackCondition && <span class="recent-race-meta">{r.trackCondition}</span>}
                                {rank && <span class="recent-race-rank">{rank}</span>}
                                {r?.popularity && <span class="recent-race-meta">{r.popularity}人気</span>}
                            </div>
                            {hasPerf && (
                                <div class="recent-race-line recent-race-line-perf">
                                    {r?.time && <span class="recent-race-meta">タイム{r.time}</span>}
                                    {r?.last3f && <span class="recent-race-meta recent-race-last3f">上がり{r.last3f}</span>}
                                    {r?.margin && <span class="recent-race-meta recent-race-margin">着差{r.margin}</span>}
                                    {r?.passingOrder && <span class="recent-race-meta recent-race-passing">通過{r.passingOrder}</span>}
                                    {r?.bodyWeight && <span class="recent-race-meta">馬体{r.bodyWeight}kg</span>}
                                </div>
                            )}
                            {hasMeta && (
                                <div class="recent-race-line recent-race-line-meta">
                                    {r?.jockey && <span class="recent-race-meta">騎手:{r.jockey}</span>}
                                    {r?.carriedWeight && <span class="recent-race-meta">斤量{r.carriedWeight}</span>}
                                    {r?.raceName && <span class="recent-race-meta recent-race-name">{r.raceName}</span>}
                                    {r?.headCount && <span class="recent-race-meta">{r.headCount}頭</span>}
                                </div>
                            )}
                        </div>
                    );
                })}
            </div>
        </details>
    )}

    {/* 南関のみ: 近走詳細データ（条件別成績・回収率）。adapt が注入する horse.horseStatsNankan を
        既存 NankanHorseStatsPanel で表示（premium/free 南関と同一 component・正本を再利用）。
        horseStatsNankan が無い馬・JRA 馬では panel 側 show 判定で何も描画しない。過去5走とは別 accordion。 */}
    <NankanHorseStatsPanel horse={horse} />

    {/* JRA light のみ: 過去走データ accordion（horseHistories.history 由来・表示専用・初期 close）。
        南関 light は jraHistoryCtx=null のため出さない。 */}
    {jraHistoryCtx && (
        <details class="jra-history-details" data-click-close="true">
            <summary class="jra-history-summary"><span class="jra-history-summary-text">過去走データ</span><span class="jra-history-count">（{jraHistoryCtx.count}走）</span></summary>
            <div class="jra-history-content">
                {jraHistoryCtx.hasProfile && (
                    <div class="jra-history-section">
                        <div class="jra-history-section-label">プロフィール</div>
                        <div class="jra-history-profile">
                            {jraHistoryCtx.profileItems.map((p) => (
                                <div class="jra-history-profile-item"><span class="jra-history-profile-label">{p.label}</span><span class="jra-history-profile-value">{p.value}</span></div>
                            ))}
                        </div>
                    </div>
                )}
                {jraHistoryCtx.hasRanked && (
                    <div class="jra-history-section">
                        <div class="jra-history-section-label">通算成績</div>
                        <div class="jra-history-record">
                            <div class="jra-history-rec"><span class="jra-history-rec-label">通算</span><span class="jra-history-rec-value">{jraHistoryCtx.recordValue}</span></div>
                            <div class="jra-history-rec"><span class="jra-history-rec-label">勝率</span><span class="jra-history-rec-value">{jraHistoryCtx.winPctStr}</span></div>
                            <div class="jra-history-rec"><span class="jra-history-rec-label">連対率</span><span class="jra-history-rec-value">{jraHistoryCtx.placePctStr}</span></div>
                            <div class="jra-history-rec"><span class="jra-history-rec-label">3着内率</span><span class="jra-history-rec-value">{jraHistoryCtx.showPctStr}</span></div>
                        </div>
                    </div>
                )}
                {jraHistoryCtx.hasCondRows && (
                    <div class="jra-history-section">
                        <div class="jra-history-section-label">条件別成績</div>
                        <div class="jra-history-cond-list">
                            {jraHistoryCtx.condRows.map((row) => (
                                <div class="jra-history-cond-row"><span class="jra-history-cond-label">{row.label}</span><span class="jra-history-cond-stat">{row.stat}</span></div>
                            ))}
                        </div>
                    </div>
                )}
                {jraHistoryCtx.rows.length > 0 && (
                    <div class="jra-history-section">
                        <div class="jra-history-section-label">{jraHistoryCtx.sectionLabel}</div>
                        <div class="jra-history-list">
                            {jraHistoryCtx.rows.map((row) => (
                                <div class="jra-history-row">
                                    <div class="jra-hh-line jra-hh-primary">
                                        {row.dateStr && <span class="jra-hh-date">{row.dateStr}</span>}
                                        {row.venue && <span class="jra-hh-venue">{row.venue}</span>}
                                        {row.dist && <span class="jra-hh-dist">{row.dist}</span>}
                                        {row.hasFinishStatus && <span class="jra-hh-status">{row.finishStatus}</span>}
                                        {row.hasRank && <span class={`jra-hh-rank ${row.isGood ? 'good' : ''}`}>{row.rank}着</span>}
                                        {row.hasPop && <span class="jra-hh-pop">{row.popularity}人気</span>}
                                    </div>
                                    <div class="jra-hh-line jra-hh-secondary">
                                        {row.raceName && <span class="jra-hh-name">{row.raceName}</span>}
                                        {row.jockey && <span class="jra-hh-jk">{row.jockey}</span>}
                                        {row.bodyWeight && <span class="jra-hh-bw">{row.bodyWeight}kg</span>}
                                        {row.time && <span class="jra-hh-time">{row.time}</span>}
                                    </div>
                                </div>
                            ))}
                            {jraHistoryCtx.hasOverflow && (
                                <div class="jra-hh-overflow">他{jraHistoryCtx.overflow}走あり</div>
                            )}
                        </div>
                    </div>
                )}
            </div>
        </details>
    )}
</div>

<style is:global>
    /* HorseMainCard 共通スタイル（is:global で他ページからも参照可能） */

    .horse-card {
        position: relative;
        background: rgba(15, 23, 42, 0.7);
        border-radius: 14px;
        padding: 18px 20px;
        margin-bottom: 20px;
        border: 1px solid rgba(100, 116, 139, 0.25);
    }
    .horse-card-main {
        background: linear-gradient(180deg, rgba(16, 185, 129, 0.06) 0%, rgba(15, 23, 42, 0.75) 100%);
        border-color: rgba(16, 185, 129, 0.45);
        box-shadow: 0 8px 24px rgba(16, 185, 129, 0.12);
    }
    .horse-card-sub {
        border-color: rgba(59, 130, 246, 0.4);
    }
    .horse-card-tana {
        border-color: rgba(245, 158, 11, 0.35);
    }
    .main-glow {
        position: absolute;
        inset: -2px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.3), rgba(59, 130, 246, 0.2));
        opacity: 0.4;
        z-index: -1;
        filter: blur(8px);
        pointer-events: none;
    }

    .horse-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }
    .horse-identity {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .horse-number {
        background: linear-gradient(135deg, #10b981, #3b82f6);
        color: white;
        padding: 4px 12px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 1rem;
        min-width: 36px;
        text-align: center;
    }
    .horse-name {
        color: #e2e8f0;
        font-weight: 700;
        font-size: 1.25rem;
    }
    .horse-card-main .horse-name { font-size: 1.4rem; color: #f0fdf4; }
    .role-badge {
        font-size: 0.8rem;
        font-weight: 800;
        padding: 5px 14px;
        border-radius: 999px;
        letter-spacing: 0.05em;
    }
    .role-badge-main {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
    }
    .role-badge-sub {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }
    .role-badge-tana {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
    }

    /* 累積スコア + AI総合指数 を横並び stat-block で表示 */
    .horse-stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        margin-bottom: 16px;
    }
    .stat-block {
        background: rgba(30, 41, 59, 0.55);
        border: 1px solid rgba(100, 116, 139, 0.25);
        border-radius: 10px;
        padding: 12px 14px;
    }
    .horse-card-main .stat-block {
        background: rgba(16, 185, 129, 0.08);
        border-color: rgba(16, 185, 129, 0.35);
    }
    .stat-label {
        color: #94a3b8;
        font-size: 0.78rem;
        font-weight: 600;
        margin-bottom: 4px;
        letter-spacing: 0.04em;
    }
    .stat-value {
        font-weight: 800;
        font-size: 1.6rem;
        color: #e2e8f0;
        line-height: 1.1;
    }
    .stat-score {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .stat-unit {
        font-size: 0.9rem;
        margin-left: 2px;
        opacity: 0.9;
    }
    .stat-index {
        background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* 基本情報 */
    .basic-info {
        margin-top: 18px;
        padding: 14px 16px;
        background: rgba(15, 23, 42, 0.45);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 10px;
    }
    .basic-info h4 {
        color: #cbd5e1;
        font-size: 0.9rem;
        font-weight: 700;
