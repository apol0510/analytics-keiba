---
/**
 * PremiumPlusStageTeaser — Premium Plus 段階公開 PHASE 2 の「予告」枠
 *
 * ⚠️ 静的 HTML に Premium Plus の文言・商品名・価格・リンクを **一切書かない**。
 *    三連複会員ページ（premium-sanrenpuku*.astro）は prerender=true の静的 HTML であり、
 *    ここに予告文を直接書くと非会員がソースを見るだけで存在を知れてしまう。
 *    そのため空のスロットだけを置き、文言は SSR の /api/premium-plus-stage.json から取得する
 *    （非会員 / PHASE 1 は 404 → 何も描画されない）。
 *
 * この枠は「予告」だけを担当する:
 *   - 金額を出さない
 *   - 購入ボタンを出さない
 *   - PHASE 2 では商品ページへのリンクも出さない（強制誘導しない）
 *   - PHASE 3 以降のみ、控えめな導線リンクを 1 本だけ出す
 *
 * 文言（タイトル / 本文 / リンクラベル）は phase 別に SSR が決める。PHASE 4（開通済み）でも
 * この枠は予告枠のままで、営業的な強調表現やスタイル変更は持ち込まない。
 * 差し替わるのは文字列だけ（正本は premiumPlusRelease.js の PP_RELEASE_COPY）。
 */
---

<div id="ppStageSlot" class="pp-stage-slot" hidden></div>

<style is:global>
  .pp-stage-slot[hidden] { display: none; }

  .pp-stage-card {
    margin: 2.5rem auto 1rem;
    max-width: 720px;
    background: linear-gradient(180deg, #111c33, #0d1729);
    border: 1px solid rgba(245, 196, 81, 0.28);
    border-radius: 16px;
    padding: 1.6rem 1.4rem;
    color: #e6edf7;
  }

  .pp-stage-eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #f5c451;
    background: rgba(245, 196, 81, 0.08);
    border: 1px solid rgba(245, 196, 81, 0.26);
    border-radius: 999px;
    padding: 4px 12px;
    margin-bottom: 0.9rem;
  }

  .pp-stage-title {
    font-size: 1.05rem;
    font-weight: 800;
    margin: 0 0 0.6rem;
    color: #f5c451;
  }

  .pp-stage-body {
    font-size: 0.92rem;
    line-height: 1.9;
    color: #cbd5e6;
    margin: 0;
  }

  .pp-stage-link {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: #f5c451;
    text-decoration: none;
    border-bottom: 1px solid rgba(245, 196, 81, 0.5);
    padding-bottom: 2px;
  }

  /* 販売停止中に「押したその場」で開く案内。見た目はカードの続きに揃える */
  .pp-stage-notice {
    margin-top: 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(245, 196, 81, 0.22);
  }
  .pp-stage-notice-title { font-size: 0.98rem; font-weight: 700; margin: 0 0 0.6rem; color: #f5c451; }
  .pp-stage-notice p { font-size: 0.82rem; line-height: 1.9; color: #cbd5e6; margin: 0 0 0.5rem; }
  .pp-stage-claim {
    display: inline-block; margin-top: 0.7rem; padding: 0.7rem 1.4rem;
    font-size: 0.86rem; font-weight: 700; color: #12203a; cursor: pointer;
    background: linear-gradient(135deg, #f5c451, #e0a92e);
    border: 0; border-radius: 999px;
  }
  .pp-stage-claim[disabled] { opacity: 0.6; cursor: default; }

  @media (max-width: 640px) {
    .pp-stage-card { padding: 1.3rem 1.05rem; border-radius: 14px; }
  }
</style>

<script is:inline>
  (async () => {
    const slot = document.getElementById('ppStageSlot');
    if (!slot) return;

    // ⚠️ この script は is:inline。**コメントごと未ログイン者の HTML に載る**ので、
    //    商品名・状態・条件を表す語を 1 つも書かない（構造 guard が検査する）。
    //    文言はすべてサーバー（n）が持つ。ここは組み立てるだけ。
    function openNotice(card, n) {
      if (card.querySelector('.pp-stage-notice')) return;   // 二度開かない
      const box = document.createElement('div');
      box.className = 'pp-stage-notice';

      const h = document.createElement('p');
      h.className = 'pp-stage-notice-title';
      h.textContent = n.title || '';
      box.appendChild(h);

      for (const t of [n.body, n.couponLead, n.discountText, n.priceText, n.couponAsk]) {
        if (!t) continue;
        const p = document.createElement('p');
        p.textContent = t;
        box.appendChild(p);
      }

      if (n.claimed === true) {
        const a = document.createElement('a');
        a.className = 'pp-stage-link';
        a.href = n.claimedHref || '#';
        a.textContent = n.claimedHrefLabel || '';
        box.appendChild(a);
      } else if (n.canClaim === true) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'pp-stage-claim';
        btn.textContent = n.claimLabel || '';
        btn.addEventListener('click', async () => {
          btn.disabled = true;
          try {
            const r = await fetch('/api/premium-plus-coupon.json', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ source: 'sanrenpuku-cta' }),
            });
            // 成否はサーバーの応答だけで決める
            if (!r.ok) throw new Error('claim failed');
            const j = await r.json();
            if (!j || j.claimed !== true) throw new Error('claim failed');
            btn.textContent = n.thanksLabel || '';
          } catch {
            btn.textContent = n.errorLabel || '';
            btn.disabled = false;
          }
        });
        box.appendChild(btn);
      }

      card.appendChild(box);
    }
    try {
      const res = await fetch('/api/premium-plus-stage.json', { credentials: 'same-origin' });
      if (!res.ok) return; // 404 = 非会員 / PHASE 1 → 何も出さない
      const data = await res.json();
      if (!data || !data.teaser) return;

      const card = document.createElement('div');
      card.className = 'pp-stage-card';

      const eyebrow = document.createElement('span');
      eyebrow.className = 'pp-stage-eyebrow';
      eyebrow.textContent = '◆ 三連複会員の方へ';
      card.appendChild(eyebrow);

      const title = document.createElement('h3');
      title.className = 'pp-stage-title';
      title.textContent = data.teaser.title || '';
      card.appendChild(title);

      const body = document.createElement('p');
      body.className = 'pp-stage-body';
      body.textContent = data.teaser.body || '';
      card.appendChild(body);

      // PHASE 3 以降のみ導線リンク（PHASE 2 は productHref が null で出さない）。
      // ラベルも SSR 由来。ここに文言をベタ書きしない（この script は is:inline のため
      // コメントごと未ログイン者の HTML に載る）。ラベルが無ければリンクごと出さない。
      const linkLabel = typeof data.teaser.linkLabel === 'string' ? data.teaser.linkLabel.trim() : '';
      if (data.productHref && linkLabel) {
        const link = document.createElement('a');
        link.className = 'pp-stage-link';
        // 商品ページ到達側でも導線が分かるようにする（サーバーが allow-list で検証する）
        link.href = data.productHref + (data.productHref.indexOf('?') >= 0 ? '&' : '?') + 'from=sanrenpuku';
        link.textContent = linkLabel;
        card.appendChild(link);

        // 押す前の見た目は変えない。サーバーが data.paused を立てたときだけ、
        // 遷移させずにサーバー由来の内容をこの場へ開く。判定はサーバーのみ。
        if (data.paused === true && data.pausedNotice) {
          link.addEventListener('click', (ev) => {
            ev.preventDefault();
            openNotice(card, data.pausedNotice);
          });
        }
      }

      slot.appendChild(card);
      slot.hidden = false;

      // 実閲覧の計測。**この inline script は送信条件を持たない**（送るかどうかは
      // premiumPlusFunnelClient.js の 1 か所が決める）。ここは積むだけ。
      // card を渡すと「画面に入ったとき」だけ表示として数える（DOM に足しただけでは数えない）。
      // ⚠️ この script は is:inline で未ログイン者の HTML にも載る。イベント名以外は書かない。
      const q = (window.__akPpFunnelQueue = window.__akPpFunnelQueue || []);
      // 導線（クリック元）を添える。**値の採否はサーバーの allow-list**が決める。
      // ここは三連複会員ページの予告枠なので 'sanrenpuku'。
      q.push({ event: 'cta_view', el: card, source: 'sanrenpuku' });
      card.addEventListener('click', (ev) => {
        if (ev.target && ev.target.closest && ev.target.closest('a')) {
          window.__akPpFunnelQueue.push({ event: 'cta_click', source: 'sanrenpuku' });
        }
      });
    } catch {
      // 取得失敗時は何も出さない（fail closed）
    }
  })();
</script>

<!-- 送信本体（バンドルされる module）。inline 側が先に push しても取りこぼさない。 -->
<script>
  import { installPlusFunnel } from '../lib/premiumPlus/premiumPlusFunnelClient.js';
  installPlusFunnel(window);
</script>
