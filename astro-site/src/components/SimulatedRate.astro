---
/**
 * 事後シミュレーション算定値の表示。説明文と必ず一緒に出す（lib/results/simulatedRateDisplay.js）。
 * items: [{ label, value }]。値が null の項目は出さず、全部 null なら何も出さない。
 */
import { SIMULATED_RATE_LABEL, SIMULATED_RATE_NOTE } from '../lib/results/simulatedRateDisplay.js';

const { items = [], period = '' } = Astro.props;
const shown = items.filter((i) => i.value != null);
---

{shown.length > 0 && (
  <section class="sim-rate" aria-label={SIMULATED_RATE_LABEL}>
    <div class="sim-title">{SIMULATED_RATE_LABEL}</div>
    {period && <div class="sim-period">{period}</div>}
    <div class="sim-grid">
      {shown.map((i) => (
        <div class="sim-item">
          <div class="sim-value">{i.value}%</div>
          <div class="sim-label">{i.label}</div>
        </div>
      ))}
    </div>
    <p class="sim-note">※ {SIMULATED_RATE_NOTE}</p>
  </section>
)}

<style>
  .sim-rate {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(100, 116, 139, 0.3);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin: 1rem auto;
    text-align: center;
  }
  .sim-title { font-size: 0.95rem; font-weight: 700; color: #e2e8f0; }
  .sim-period { font-size: 0.78rem; color: #94a3b8; margin-top: 0.15rem; }
  .sim-grid { display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .sim-value { font-size: 1.4rem; font-weight: 700; color: #e2e8f0; line-height: 1.2; }
  .sim-label { font-size: 0.75rem; color: #cbd5e1; margin-top: 0.15rem; }
  .sim-note { font-size: 0.8rem; color: #cbd5e1; line-height: 1.6; margin: 0.6rem 0 0; }
</style>
