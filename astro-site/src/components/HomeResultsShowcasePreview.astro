---
// HomeResultsShowcasePreview.astro
// トップページ Hero Key Visual 直下に置く「有料版で実際に配信した買い目」プレビュー。
//
// - 表示データは単一源 lib/resultsShowcase.js の buildLatestShowcase() から
//   lib/resultsShowcasePreview.js が【選ぶだけ】。新しい結果 JSON も独自集計も作らない。
// - 公開範囲（メインのみ / 抑え非公開 / 旧 ↔ 裏目的中の畳み込み）は単一源に従う。
//   詳細は astro-site/docs/RESULTS_SHOWCASE.md。
// - データが無いカテゴリはカードごと非表示。両方無ければセクション自体を描画しない。
//
// 構成（2026-08-18 改訂）:
//   ① 当日の全体実績（的中数/総レース数・回収率）を最初に置く
//   ② 全会場・全レースの ✅/✗ 一覧（JRA の 3 会場開催も全会場ぶん）
//   ③ その下に代表メインレースの実際の配信買い目（詳細）
//   メイン不的中の日に全体実績まで悪く見えないよう、先に当日全体を認識させる。
//
// props:
//   nankanArchive / jraArchive: archiveResults{,Jra}.json の中身（呼び出し側から渡す）
import { buildShowcasePreview } from '../lib/resultsShowcasePreview.js';

interface Props {
  jraArchive?: unknown;
  nankanArchive?: unknown;
}

const { jraArchive, nankanArchive } = Astro.props as Props;

const cards = [
  buildShowcasePreview(jraArchive as any[], 'jra'),
  buildShowcasePreview(nankanArchive as any[], 'nankan'),
].filter(Boolean) as any[];
---

{cards.length > 0 && (
  <section class="rsp" aria-labelledby="rsp-title">
    <div class="rsp__inner">
      <header class="rsp__header">
        <h2 class="rsp__title" id="rsp-title">💎 有料版で実際に配信した買い目と結果</h2>
        <p class="rsp__lead">
          メインレースの買い目を、結果とあわせてそのまま公開しています（毎日自動更新）
        </p>
      </header>

      <div class={`rsp__grid ${cards.length === 1 ? 'is-single' : ''}`}>
        {cards.map((c) => (
          <a class={`rsp__card ${c.mainRace.isHit ? 'is-hit' : 'is-miss'}`} href={c.href}>
            <div class="rsp__card-head">
              <span class="rsp__tag">{c.categoryTag}</span>
              <span class="rsp__cat">{c.categoryLabel}</span>
              <span class="rsp__meta">{c.dateLabel}・{c.venueLabel}</span>
            </div>

            {/* ① 当日の全体実績（先に見せる） */}
            <div class="rsp__summary">
              <span class="rsp__sum">
                <b class="rsp__sum-value">{c.hitRaces}<i>/{c.totalRaces}</i></b>
                <i class="rsp__sum-label">当日の的中レース</i>
              </span>
              {c.recoveryRate != null && (
                <span class={`rsp__sum ${c.recoveryRate >= 100 ? 'is-profit' : ''}`}>
                  <b class="rsp__sum-value">{c.recoveryRate}<i>%</i></b>
                  <i class="rsp__sum-label">回収率</i>
                </span>
              )}
            </div>

            {/* ② 全会場・全レースの ✅/✗（非メインは的中の有無のみ） */}
            <div class="rsp__races">
              {c.venueGroups.map((g: any) => (
                <div class="rsp__venue">
                  <span class="rsp__venue-name">{g.venue}<i>全{g.totalRaces}R</i></span>
                  <div class="rsp__strip">
                    {g.races.map((r: any) => (
                      <span
                        class={`rsp__chip ${r.isHit ? 'is-hit' : 'is-miss'} ${r.isMain ? 'is-main' : ''}`}
                        title={`${r.raceNumber}R${r.isMain ? '（メイン）' : ''} ${r.isHit ? '的中' : '不的中'}`}
                      >
                        <i class="rsp__chip-r">{r.raceNumber}R</i>
                        <i class="rsp__chip-mark">{r.isHit ? '✅' : '✗'}</i>
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>

            {/* ③ 代表メインレースの実際の配信買い目（詳細） */}
            <div class="rsp__main">
              <div class="rsp__race">
                🎯 {c.mainVenue} {c.mainRace.raceNumber}R メイン
                {c.mainRace.raceName && <span class="rsp__race-name">{c.mainRace.raceName}</span>}
              </div>

              <div class="rsp__bet">
                <span class="rsp__bet-label">配信買い目<span class="rsp__bet-type">馬単{c.mainRace.betPoints}点</span></span>
                <div class="rsp__line">
                  <span class="rsp__num rsp__num--honmei">{c.mainRace.honmei}</span>
                  <span class="rsp__arrow">{c.mainRace.displayArrow}</span>
                  {c.mainRace.displayPartners.map((p: string) => (
                    <span class="rsp__num">{p}</span>
                  ))}
                </div>
              </div>

              <div class="rsp__result">
                {c.mainRace.isHit ? (
                  <>
                    <span class="rsp__badge rsp__badge--hit">✅ 的中</span>
                    {c.mainRace.combination && (
                      <span class="rsp__combo">{c.mainRace.combination}</span>
                    )}
                    {c.mainRace.payout && (
                      <span class="rsp__payout">¥{c.mainRace.payout.toLocaleString()}</span>
                    )}
                  </>
                ) : (
                  <span class="rsp__badge rsp__badge--miss">✗ 不的中</span>
                )}
                {c.otherVenueCount > 0 && (
                  <span class="rsp__note">他{c.otherVenueCount}会場のメインも公開</span>
                )}
              </div>
            </div>

            <span class="rsp__cta">{c.categoryLabel}の実績を詳しく見る →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .rsp {
    padding: 28px 16px 8px;
  }
  .rsp__inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .rsp__header {
    text-align: center;
    margin-bottom: 18px;
  }
  .rsp__title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #f1f5f9;
    margin: 0 0 6px;
    line-height: 1.35;
  }
  .rsp__lead {
    margin: 0;
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .rsp__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 900px) {
    .rsp__grid {
      grid-template-columns: 1fr 1fr;
    }
    .rsp__grid.is-single {
      grid-template-columns: minmax(0, 560px);
      justify-content: center;
    }
  }

  .rsp__card {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 18px 20px 16px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.55) 0%, rgba(15, 23, 42, 0.65) 100%);
    border: 1px solid rgba(139, 92, 246, 0.35);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    box-shadow:
      0 8px 28px rgba(0, 0, 0, 0.25),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .rsp__card:hover {
    transform: translateY(-3px);
    border-color: rgba(139, 92, 246, 0.6);
    box-shadow:
      0 14px 40px rgba(139, 92, 246, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }
  .rsp__card.is-hit {
    border-color: rgba(16, 185, 129, 0.45);
  }
  .rsp__card.is-hit:hover {
    border-color: rgba(16, 185, 129, 0.65);
    box-shadow:
      0 14px 40px rgba(16, 185, 129, 0.26),
      inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }

  .rsp__card-head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }
  .rsp__tag {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 3px 9px;
    border-radius: 999px;
    color: #2a1a00;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
  }
  .rsp__cat {
    font-size: 0.95rem;
    font-weight: 700;
    color: #f1f5f9;
  }
  .rsp__meta {
    margin-left: auto;
    font-size: 0.78rem;
    color: #94a3b8;
  }

  /* ① 当日の全体実績 */
  .rsp__summary {
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
  }
  .rsp__sum {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px 6px;
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .rsp__sum-value {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.1;
    color: #f1f5f9;
    font-style: normal;
  }
  .rsp__sum-value i {
    font-size: 0.95rem;
    font-style: normal;
    color: #94a3b8;
  }
  .rsp__sum.is-profit .rsp__sum-value {
    color: #10b981;
  }
  .rsp__sum-label {
    font-size: 0.68rem;
    font-style: normal;
    color: #94a3b8;
  }

  /* ② 全会場・全レースの ✅/✗ */
  .rsp__races {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 12px;
  }
  .rsp__venue-name {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    color: #cbd5e1;
    margin-bottom: 4px;
  }
  .rsp__venue-name i {
    margin-left: 6px;
    font-style: normal;
    font-weight: 500;
    color: #94a3b8;
  }
  .rsp__strip {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .rsp__chip {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 2px 5px;
    border-radius: 6px;
    background: rgba(51, 65, 85, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.07);
    white-space: nowrap;
  }
  .rsp__chip-r {
    font-size: 0.6rem;
    font-style: normal;
    color: #94a3b8;
  }
  .rsp__chip-mark {
    font-size: 0.62rem;
    font-style: normal;
    line-height: 1;
  }
  .rsp__chip.is-hit {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(16, 185, 129, 0.3);
  }
  .rsp__chip.is-hit .rsp__chip-r {
    color: #6ee7b7;
  }
  .rsp__chip.is-miss .rsp__chip-mark {
    color: #94a3b8;
    font-weight: 700;
  }
  .rsp__chip.is-main {
    border-color: rgba(251, 191, 36, 0.55);
  }
  .rsp__chip.is-main .rsp__chip-r {
    color: #fbbf24;
    font-weight: 700;
  }

  /* ③ 代表メインの詳細 */
  .rsp__main {
    padding-top: 10px;
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
  }
  .rsp__race {
    font-size: 0.85rem;
    font-weight: 700;
    color: #cbd5e1;
    margin-bottom: 8px;
  }
  .rsp__race-name {
    margin-left: 6px;
    font-weight: 500;
    color: #94a3b8;
  }

  .rsp__bet {
    padding: 10px 12px;
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .rsp__bet-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    color: #94a3b8;
    margin-bottom: 8px;
  }
  .rsp__bet-type {
    padding: 2px 8px;
    border-radius: 999px;
    font-weight: 700;
    color: #c4b5fd;
    background: rgba(139, 92, 246, 0.18);
    border: 1px solid rgba(139, 92, 246, 0.3);
  }
  .rsp__line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .rsp__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    padding: 0 6px;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.95rem;
    color: #e2e8f0;
    background: rgba(51, 65, 85, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .rsp__num--honmei {
    color: #0f172a;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    border-color: rgba(251, 191, 36, 0.6);
  }
  .rsp__arrow {
    font-weight: 800;
    color: #94a3b8;
  }

  .rsp__result {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
  }
  .rsp__badge {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 8px;
  }
  .rsp__badge--hit {
    color: #10b981;
    background: rgba(16, 185, 129, 0.16);
    border: 1px solid rgba(16, 185, 129, 0.35);
  }
  .rsp__badge--miss {
    color: #94a3b8;
    background: rgba(148, 163, 184, 0.12);
    border: 1px solid rgba(148, 163, 184, 0.28);
  }
  .rsp__combo {
    font-size: 0.85rem;
    font-weight: 700;
    color: #cbd5e1;
  }
  .rsp__payout {
    font-size: 1.05rem;
    font-weight: 800;
    color: #fbbf24;
  }

  .rsp__note {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .rsp__cta {
    display: inline-block;
    margin-top: 14px;
    font-size: 0.88rem;
    font-weight: 700;
    color: #93c5fd;
  }
  .rsp__card:hover .rsp__cta {
    color: #ffffff;
  }

  @media (max-width: 600px) {
    .rsp {
      padding: 20px 12px 4px;
    }
    .rsp__title {
      font-size: 1.15rem;
    }
    .rsp__card {
      padding: 16px 14px 14px;
    }
    .rsp__meta {
      margin-left: 0;
      width: 100%;
    }
    /* 本命 + 相手5頭 = 6 個が 1 行に収まるよう詰める（折り返すと買い目が読みにくい） */
    .rsp__bet {
      padding: 10px;
    }
    .rsp__line {
      gap: 4px;
    }
    .rsp__num {
      min-width: 26px;
      height: 28px;
      padding: 0 4px;
      font-size: 0.88rem;
    }
    /* 全レース一覧は 12R でも 2 行に収まるよう詰める */
    .rsp__sum {
      padding: 6px 4px;
    }
    .rsp__sum-value {
      font-size: 1.3rem;
    }
    .rsp__chip {
      gap: 1px;
      padding: 2px 4px;
    }
    .rsp__chip-r {
      font-size: 0.56rem;
    }
    .rsp__chip-mark {
      font-size: 0.58rem;
    }
    /* 会場名を一覧の左に回り込ませ、1 会場につき 1 行ぶん縦を詰める */
    .rsp__venue {
      display: flex;
      align-items: flex-start;
      gap: 6px;
    }
    .rsp__venue-name {
      flex: 0 0 auto;
      margin: 2px 0 0;
      min-width: 3.2em;
    }
    .rsp__venue-name i {
      display: block;
      margin: 0;
      font-size: 0.62rem;
    }
    .rsp__races {
      gap: 6px;
      margin-bottom: 10px;
    }
  }
</style>
