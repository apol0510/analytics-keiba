---
/**
 * NankanHorseStatsPanel.astro (analytics-keiba)
 *
 * horse.horseStatsNankan（uma_info 元表統計）を「近走詳細データ」として表示（表示専用）。
 * AK 方針: 実務的・データ表寄り（青〜シアン）。recentRacesDetailed は表示しない
 * （既存「過去走」欄と重複するため・統計/条件別/回収率に寄せる）。
 *
 * 厳守: featureScores / AI指数 / 印 / 買い目 / EV 非接続。空/null/全0ブロックは非表示。
 * 表示名「近走詳細データ」固定（過去走データ/最大5走/5走は使わない）。
 */
const { horse } = Astro.props;
const s = horse?.horseStatsNankan || null;

const ne = (v) => v !== null && v !== undefined && String(v).trim() !== '';
const arr = (x) => Array.isArray(x) && x.length > 0;
const chaku = (r) => `${r?.first ?? 0}-${r?.second ?? 0}-${r?.third ?? 0}-${r?.out ?? 0}`;
const starts = (r) => (Number(r?.first) || 0) + (Number(r?.second) || 0) + (Number(r?.third) || 0) + (Number(r?.out) || 0);
const pctStr = (raw, val) => (ne(raw) ? raw : (val != null ? `${val}%` : ''));
// 勝率/連対率行: 値がある側だけ表示（空の「連」「勝」を出さない）
const fmtPctRow = (r) => {
  const w = pctStr(r.winRateRaw, r.winRate);
  const q = pctStr(r.quinellaRateRaw, r.quinellaRate);
  return [(ne(r.label) ? r.label : ''), (ne(w) ? `勝${w}` : ''), (ne(q) ? `連${q}` : '')].filter(ne).join(' ');
};
const hasPct = (r) => ne(pctStr(r.winRateRaw, r.winRate)) || ne(pctStr(r.quinellaRateRaw, r.quinellaRate));

// ---- 基本情報 ----
const p = (s && s.profile) || {};
const sexAge = `${ne(p.sex) ? p.sex : ''}${p.age != null ? p.age : ''}`;
const profileItems = [
  ne(sexAge) && { k: '性齢', v: sexAge },
  ne(p.sire) && { k: '父', v: p.sire },
  ne(p.dam) && { k: '母', v: p.dam },
  ne(p.damsire) && { k: '母父', v: p.damsire },
  ne(p.color) && { k: '毛色', v: p.color },
  ne(p.jockey) && { k: '騎手', v: p.jockey + (ne(p.jockeyAffiliation) ? `(${p.jockeyAffiliation})` : '') },
  ne(p.carriedWeight) && { k: '斤量', v: String(p.carriedWeight) },
  ne(p.trainer) && { k: '調教師', v: p.trainer + (ne(p.trainerAffiliation) ? `(${p.trainerAffiliation})` : '') },
  ne(p.owner) && { k: '馬主', v: p.owner },
  ne(p.breeder) && { k: '生産', v: p.breeder },
].filter(Boolean);

// ---- 統計セクション（recentRacesDetailed は出さない）----
const sections = [];
const pushChips = (title, chips, opts = {}) => { const c = (chips || []).filter(ne); if (c.length) sections.push({ title, chips: c, accent: !!opts.accent }); };
const chakuRows = (rows) => (arr(rows) ? rows.filter((r) => starts(r) > 0) : []);

// 1. 持時計
if (arr(s && s.bestTimes)) {
  pushChips('持時計', s.bestTimes.map((b) => [b.venue, (ne(b.time) ? b.time : b.raw), b.trackCondition, b.surface, (b.finish != null ? `${b.finish}着` : '')].filter(ne).join(' ')));
}
// 2-6. 着別（距離別/場別/馬場状態別/出走間隔別/季節別）
for (const [title, rows] of [
  ['距離別成績', s && s.finishStatsByDistance],
  ['場別成績', s && s.finishStatsByVenue],
  ['馬場状態別成績', s && s.trackConditionStats],
  ['出走間隔別成績', s && s.intervalStats],
  ['季節別成績', s && s.seasonStats],
]) {
  const r = chakuRows(rows);
  if (r.length) pushChips(title, r.map((x) => `${ne(x.label) ? x.label + ' ' : ''}${chaku(x)}`));
}
// 7-8. % 系（種牡馬/騎手コース）
for (const [title, rows] of [
  ['種牡馬分析', s && s.sireStats],
  ['騎手コース別成績', s && s.jockeyCourseStats],
]) {
  if (arr(rows)) {
    const c = rows.filter(hasPct).map(fmtPctRow);
    pushChips(title, c);
  }
}
// 9. 騎手別（今回/前回/全）
if (s && s.jockeyStats) {
  const jkLabel = { current: '今回騎手', previous: '前回騎手', all: '全成績' };
  const jkChips = ['current', 'previous', 'all'].map((k) => {
    const j = s.jockeyStats[k];
    if (!j || (starts(j) === 0 && j.winRate == null)) return '';
    const rate = [(ne(j.winRateRaw) ? `勝${j.winRateRaw}` : ''), (ne(j.quinellaRateRaw) ? `連${j.quinellaRateRaw}` : '')].filter(ne).join(' ');
    return `${jkLabel[k]} ${chaku(j)}${rate ? ' ' + rate : ''}`;
  });
  pushChips('騎手別成績', jkChips);
}
// 10. 回収率（強調）
const rr = s && s.returnRates;
const rrChips = [];
if (rr && rr.horse && rr.horse.win) rrChips.push(`競走馬 単${rr.horse.win.raw} 複${rr.horse.place ? rr.horse.place.raw : ''}`);
if (rr && rr.jockey && rr.jockey.win) rrChips.push(`騎手 単${rr.jockey.win.raw} 複${rr.jockey.place ? rr.jockey.place.raw : ''}`);
if (rrChips.length) sections.push({ title: '回収率', chips: rrChips, accent: true });

const show = !!s && (profileItems.length > 0 || sections.length > 0);
---
{show && (
  <details class="aknhs">
    <summary class="aknhs-sum"><span class="aknhs-title">近走詳細データ</span><span class="aknhs-sub">条件別成績・回収率</span></summary>
    <div class="aknhs-body">
      {profileItems.length > 0 && (
        <div class="aknhs-sec">
          <div class="aknhs-h">基本情報</div>
          <div class="aknhs-kvwrap">
            {profileItems.map((it) => (<span class="aknhs-kv"><span class="aknhs-k">{it.k}</span>{it.v}</span>))}
          </div>
        </div>
      )}
      {sections.map((sec) => (
        <div class={sec.accent ? 'aknhs-sec aknhs-sec-accent' : 'aknhs-sec'}>
          <div class="aknhs-h">{sec.title}</div>
          <div class="aknhs-chips">{sec.chips.map((c) => (<span class="aknhs-chip">{c}</span>))}</div>
        </div>
      ))}
    </div>
  </details>
)}

<style>
  .aknhs { margin-top: 10px; border: 1px solid rgba(56,189,248,0.30); border-radius: 8px; background: rgba(15,23,42,0.6); overflow: hidden; }
  .aknhs-sum { cursor: pointer; padding: 9px 12px; list-style: none; display: flex; align-items: baseline; gap: 8px; }
  .aknhs-sum::-webkit-details-marker { display: none; }
  .aknhs-sum::before { content: '▸'; color: #38bdf8; font-size: 0.7rem; }
  .aknhs[open] .aknhs-sum::before { content: '▾'; }
  .aknhs-title { font-weight: 700; color: #e2e8f0; font-size: 0.84rem; }
  .aknhs-sub { color: #67e8f9; font-size: 0.72rem; }
  .aknhs-body { padding: 4px 12px 14px; }
  .aknhs-sec { border-top: 1px solid rgba(148,163,184,0.22); padding-top: 0.7rem; margin-top: 0.7rem; }
  .aknhs-sec:first-child { border-top: none; margin-top: 0.2rem; }
  .aknhs-h { color: #38bdf8; font-weight: 700; font-size: 0.74rem; border-left: 3px solid #38bdf8; padding-left: 0.45rem; margin-bottom: 0.5rem; letter-spacing: 0.02em; }
  .aknhs-kvwrap { display: flex; flex-wrap: wrap; gap: 6px 14px; line-height: 1.7; }
  .aknhs-kv { font-size: 0.8rem; color: #e2e8f0; }
  .aknhs-k { color: #94a3b8; margin-right: 4px; }
  .aknhs-chips { display: flex; flex-wrap: wrap; gap: 6px 8px; line-height: 1.7; }
  .aknhs-chip { font-size: 0.76rem; color: #e2e8f0; background: rgba(15,23,42,0.62); border: 1px solid rgba(148,163,184,0.20); border-radius: 999px; padding: 0.25rem 0.6rem; }
  .aknhs-sec-accent .aknhs-h { color: #fbbf24; border-left-color: #fbbf24; }
  .aknhs-sec-accent .aknhs-chip { color: #fde68a; border-color: rgba(251,191,36,0.45); background: rgba(120,53,15,0.35); }
</style>
