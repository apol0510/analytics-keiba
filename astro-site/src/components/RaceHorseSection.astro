---
// レース1件分の rich 馬カード一括レンダーコンポーネント
//
// 🎯 単一ソース: メインレース / 非メインレース問わず同じ表示を出すための共通部品
//   - HorseMainCard で 本命・対抗・単穴 を rich 表示
//   - 連下候補馬・抑え候補馬の minor-horse-card
//   - 不要馬・見送り馬の ineligible-section
//
// このコンポーネントを呼び出すだけで、メインレースと同じ horse 系セクションが揃う。
// 買い目（betting）はレース種別ごとに異なるためページ側で別途レンダーする。
//
// 必要なデータ:
//   raceHorses: normalizeHorseData(raceData) で正規化済みの配列

import HorseMainCard from './HorseMainCard.astro';
import NankanHorseStatsPanel from './NankanHorseStatsPanel.astro';
import { generateMinorHorseComment } from '../lib/horseEnrichment.js';
import { isOsaeCandidate, isIneligibleHorse, sortOsaeCandidates, getDisplayComputerIndex, getHorseAiIndex } from '../lib/shared-prediction-logic.js';
import { getDisplayRecentRacesForNankan } from '../lib/getDisplayRecentRacesForNankan.js';

interface Props {
    raceHorses: any[];
}

const { raceHorses = [] } = Astro.props as Props;
const safeHorses = Array.isArray(raceHorses) ? raceHorses : [];

// 馬の分類は shared-prediction-logic.js に集約。
// 「補欠ロールを全部抑え候補に移す」と「pt > 70 ハードカット」の両極端を避け、
// pt > 70 または computerIndex >= 10 の補欠だけを抑え候補に救出し、
// それ以外の評価弱い補欠は「不要馬・見送り馬」に残す。
const honmei = safeHorses.find(h => h?.role === '本命');
const honmeiPt = Number(honmei?.pt) || 0;

const ineligible = safeHorses
    .filter(isIneligibleHorse)
    .sort((a, b) => (Number(b?.pt) || 0) - (Number(a?.pt) || 0));

// 2026-05-14: 不要馬の理由表記を「買い目基準未満」系に統一。
// 旧 "指数不足" は prediction 側 computerIndex (printedの racebook 指数ではない)
// に対するラベルでユーザーに誤解を与えるため変更。
function reasonFor(h: any) {
    const pt = Number(h?.pt) || 0;
    if (!(pt > 0)) return '評価対象外';
    return '買い目基準未満';
}

const renkaHorses = safeHorses.filter(h => h?.role === '連下' || h?.role === '連下最上位');
const osaeHorses = sortOsaeCandidates(safeHorses.filter(isOsaeCandidate));
const renkaMark = safeHorses.find(h => h?.role === '連下')?.displayMark || '△';
const osaeMark = safeHorses.find(h => h?.role === '押さえ')?.displayMark || '×';
---

{/* 本命・対抗・単穴 — 共有 HorseMainCard で描画 */}
{safeHorses
    .filter(h => h?.role === '本命' || h?.role === '対抗' || h?.role === '単穴')
    .map((horse) => (
        <HorseMainCard horse={horse} />
    ))
}

{/* 連下候補馬 — rich minor-horse-card */}
{renkaHorses.length > 0 && (
    <div class="horse-card horse-card-minor minor-group-renka">
        <div class="horse-header">
            <div>
                <span class="horse-mark-minor">{renkaMark}</span>
                <span class="minor-group-title minor-group-title-renka">連下候補馬</span>
            </div>
        </div>
        <div class="minor-horse-grid">
            {renkaHorses.map((horse) => {
                const gap = honmeiPt - (Number(horse?.pt) || 0);
                const comment = generateMinorHorseComment(horse.role, gap);
                const importance = Array.isArray(horse.importance) && horse.importance.length > 0 ? horse.importance : null;
                const evalPoints = Array.isArray(horse.evalPoints) ? horse.evalPoints : [];
                const recentRaces = (Array.isArray(horse?.recentRacesFromEntriesNankan) && horse.recentRacesFromEntriesNankan.length > 0)
                    ? horse.recentRacesFromEntriesNankan
                    : getDisplayRecentRacesForNankan(horse);
                const weightStr = (horse.weight != null && Number.isFinite(Number(horse.weight))) ? `${horse.weight}kg` : null;
                return (
                    <div class="minor-horse-card minor-horse-card-renka">
                        <div class="minor-horse-head">
                            <span class="minor-horse-mark">{horse.displayMark || '△'}</span>
                            <span class="minor-horse-number">{horse.number}</span>
                            <span class="minor-horse-name">{horse.name}</span>
                            <span class="minor-horse-score">{horse.pt ?? 0}pt</span>
                        </div>
                        <div class="minor-horse-meta">
                            {horse.jockey && <span><span class="meta-key">騎手</span>{horse.jockey}</span>}
                            {horse.trainer && <span><span class="meta-key">厩舎</span>{horse.trainer}</span>}
                            {weightStr && <span><span class="meta-key">斤量</span>{weightStr}</span>}
                            {getHorseAiIndex(horse) != null && <span><span class="meta-key">指数</span>{getHorseAiIndex(horse)}</span>}
                        </div>
                        {evalPoints.length > 0 && (
                            <div class="minor-horse-evals">
                                {evalPoints.slice(0, 3).map((p: string) => (<span class="eval-tag-small">{p}</span>))}
                            </div>
                        )}
                        {importance && importance.length >= 3 && (
                            <div class="minor-horse-importance">
                                安定{Math.round(importance[0].value * 100)} / 能力{Math.round(importance[1].value * 100)} / 展開{Math.round(importance[2].value * 100)}
                            </div>
                        )}
                        {comment && <p class="minor-horse-comment">{comment}</p>}
                        {recentRaces.length > 0 && (
                            <details class="recent-races recent-races-compact" data-click-close="true">
                                <summary>過去{Math.min(5, recentRaces.length)}走</summary>
                                <div class="recent-races-list">
                                    {recentRaces.slice(0, 5).map((r: any, i: number) => {
                                        const rankRaw = r?.rank ?? r?.finish;
                                        const isNum = (rankRaw != null && Number.isFinite(Number(rankRaw)));
                                        const rank = isNum ? `${rankRaw}着` : (r?.finishStatus || '');
                                        const label = i === 0 ? '前走' : `${i + 1}走前`;
                                        if (horse?.isJraHistoryEnriched === true) {
                                            return (
                                                <div class="recent-race-compact">
                                                    {r?.venue && <span class="recent-race-venue">{r.venue}</span>}
                                                    {r?.distance && <span class="recent-race-distance">{r.distance}</span>}
                                                    {rank && <span class="recent-race-rank">{rank}</span>}
                                                    {r?.time && <span class="recent-race-meta">タイム{r.time}</span>}
                                                    {r?.bodyWeight && <span class="recent-race-meta">{r.bodyWeight}kg</span>}
                                                </div>
                                            );
                                        }
                                        const hasPerf = r?.time || r?.last3f || r?.margin || r?.passingOrder || r?.bodyWeight;
                                        const hasMeta = r?.jockey || r?.carriedWeight || r?.raceName || r?.headCount;
                                        return (
                                            <div class="recent-race-card">
                                                <div class="recent-race-line recent-race-line-main">
                                                    <span class="recent-race-tag">{label}</span>
                                                    {r?.date && <span class="recent-race-meta">{r.date}</span>}
                                                    {r?.venue && <span class="recent-race-venue">{r.venue}</span>}
                                                    {r?.distance && <span class="recent-race-distance">{r.distance}</span>}
                                                    {r?.trackCondition && <span class="recent-race-meta">{r.trackCondition}</span>}
                                                    {rank && <span class="recent-race-rank">{rank}</span>}
                                                    {r?.popularity && <span class="recent-race-meta">{r.popularity}人気</span>}
                                                </div>
                                                {hasPerf && (
                                                    <div class="recent-race-line recent-race-line-perf">
                                                        {r?.time && <span class="recent-race-meta">タイム{r.time}</span>}
                                                        {r?.last3f && <span class="recent-race-meta recent-race-last3f">上がり{r.last3f}</span>}
                                                        {r?.margin && <span class="recent-race-meta recent-race-margin">着差{r.margin}</span>}
                                                        {r?.passingOrder && <span class="recent-race-meta recent-race-passing">通過{r.passingOrder}</span>}
                                                        {r?.bodyWeight && <span class="recent-race-meta">馬体{r.bodyWeight}kg</span>}
                                                    </div>
                                                )}
                                                {hasMeta && (
                                                    <div class="recent-race-line recent-race-line-meta">
                                                        {r?.jockey && <span class="recent-race-meta">騎手:{r.jockey}</span>}
                                                        {r?.carriedWeight && <span class="recent-race-meta">斤量{r.carriedWeight}</span>}
                                                        {r?.raceName && <span class="recent-race-meta recent-race-name">{r.raceName}</span>}
                                                        {r?.headCount && <span class="recent-race-meta">{r.headCount}頭</span>}
                                                    </div>
                                                )}
                                            </div>
                                        );
                                    })}
                                </div>
                            </details>
                        )}
                        {/* 南関のみ: 近走詳細データ（条件別成績・回収率）。premium 南関 連下ミニカードと同一の
                            既存 NankanHorseStatsPanel を再利用。horseStatsNankan が無い馬・JRA 馬では panel 側
                            show 判定で何も描画しない。compact 過去走とは別 accordion・初期 close。 */}
                        <NankanHorseStatsPanel horse={horse} />
                    </div>
                );
            })}
        </div>
    </div>
)}

{/* 抑え候補馬 — rich minor-horse-card-osae */}
{osaeHorses.length > 0 && (
    <div class="horse-card horse-card-minor minor-group-osae">
        <div class="horse-header">
            <div>
                <span class="horse-mark-minor">{osaeMark}</span>
                <span class="minor-group-title minor-group-title-osae">抑え候補馬</span>
            </div>
        </div>
        <div class="minor-horse-grid">
            {osaeHorses.map((horse) => {
                const gap = honmeiPt - (Number(horse?.pt) || 0);
                const comment = generateMinorHorseComment(horse.role, gap);
                const evalPoints = Array.isArray(horse.evalPoints) ? horse.evalPoints : [];
                const recentRaces = (Array.isArray(horse?.recentRacesFromEntriesNankan) && horse.recentRacesFromEntriesNankan.length > 0)
                    ? horse.recentRacesFromEntriesNankan
                    : getDisplayRecentRacesForNankan(horse);
                const weightStr = (horse.weight != null && Number.isFinite(Number(horse.weight))) ? `${horse.weight}kg` : null;
                return (
                    <div class="minor-horse-card minor-horse-card-osae">
                        <div class="minor-horse-head">
                            <span class="minor-horse-mark">{horse.displayMark || '×'}</span>
                            <span class="minor-horse-number">{horse.number}</span>
                            <span class="minor-horse-name">{horse.name}</span>
                            <span class="minor-horse-score">{horse.pt ?? 0}pt</span>
                        </div>
                        <div class="minor-horse-meta">
                            {horse.jockey && <span><span class="meta-key">騎手</span>{horse.jockey}</span>}
                            {horse.trainer && <span><span class="meta-key">厩舎</span>{horse.trainer}</span>}
                            {weightStr && <span><span class="meta-key">斤量</span>{weightStr}</span>}
                            {getHorseAiIndex(horse) != null && <span><span class="meta-key">指数</span>{getHorseAiIndex(horse)}</span>}
                        </div>
                        {evalPoints.length > 0 && (
                            <div class="minor-horse-evals">
                                {evalPoints.slice(0, 3).map((p: string) => (<span class="eval-tag-small">{p}</span>))}
                            </div>
                        )}
                        {comment && <p class="minor-horse-comment">{comment}</p>}
                        {recentRaces.length > 0 && (
                            <details class="recent-races recent-races-compact" data-click-close="true">
                                <summary>過去{Math.min(5, recentRaces.length)}走</summary>
                                <div class="recent-races-list">
                                    {recentRaces.slice(0, 5).map((r: any, i: number) => {
                                        const rankRaw = r?.rank ?? r?.finish;
                                        const isNum = (rankRaw != null && Number.isFinite(Number(rankRaw)));
                                        const rank = isNum ? `${rankRaw}着` : (r?.finishStatus || '');
                                        const label = i === 0 ? '前走' : `${i + 1}走前`;
                                        if (horse?.isJraHistoryEnriched === true) {
                                            return (
                                                <div class="recent-race-compact">
                                                    {r?.venue && <span class="recent-race-venue">{r.venue}</span>}
                                                    {r?.distance && <span class="recent-race-distance">{r.distance}</span>}
                                                    {rank && <span class="recent-race-rank">{rank}</span>}
                                                    {r?.time && <span class="recent-race-meta">タイム{r.time}</span>}
                                                    {r?.bodyWeight && <span class="recent-race-meta">{r.bodyWeight}kg</span>}
                                                </div>
                                            );
                                        }
                                        const hasPerf = r?.time || r?.last3f || r?.margin || r?.passingOrder || r?.bodyWeight;
                                        const hasMeta = r?.jockey || r?.carriedWeight || r?.raceName || r?.headCount;
                                        return (
                                            <div class="recent-race-card">
                                                <div class="recent-race-line recent-race-line-main">
                                                    <span class="recent-race-tag">{label}</span>
                                                    {r?.date && <span class="recent-race-meta">{r.date}</span>}
                                                    {r?.venue && <span class="recent-race-venue">{r.venue}</span>}
                                                    {r?.distance && <span class="recent-race-distance">{r.distance}</span>}
                                                    {r?.trackCondition && <span class="recent-race-meta">{r.trackCondition}</span>}
                                                    {rank && <span class="recent-race-rank">{rank}</span>}
                                                    {r?.popularity && <span class="recent-race-meta">{r.popularity}人気</span>}
                                                </div>
                                                {hasPerf && (
                                                    <div class="recent-race-line recent-race-line-perf">
                                                        {r?.time && <span class="recent-race-meta">タイム{r.time}</span>}
                                                        {r?.last3f && <span class="recent-race-meta recent-race-last3f">上がり{r.last3f}</span>}
                                                        {r?.margin && <span class="recent-race-meta recent-race-margin">着差{r.margin}</span>}
                                                        {r?.passingOrder && <span class="recent-race-meta recent-race-passing">通過{r.passingOrder}</span>}
                                                        {r?.bodyWeight && <span class="recent-race-meta">馬体{r.bodyWeight}kg</span>}
                                                    </div>
                                                )}
                                                {hasMeta && (
                                                    <div class="recent-race-line recent-race-line-meta">
                                                        {r?.jockey && <span class="recent-race-meta">騎手:{r.jockey}</span>}
                                                        {r?.carriedWeight && <span class="recent-race-meta">斤量{r.carriedWeight}</span>}
                                                        {r?.raceName && <span class="recent-race-meta recent-race-name">{r.raceName}</span>}
                                                        {r?.headCount && <span class="recent-race-meta">{r.headCount}頭</span>}
                                                    </div>
                                                )}
                                            </div>
                                        );
                                    })}
                                </div>
                            </details>
                        )}
                        {/* 南関のみ: 近走詳細データ（条件別成績・回収率）。premium 南関 抑えミニカードと同一の
                            既存 NankanHorseStatsPanel を再利用。horseStatsNankan が無い馬・JRA 馬では panel 側
                            show 判定で何も描画しない。compact 過去走とは別 accordion・初期 close。 */}
                        <NankanHorseStatsPanel horse={horse} />
                    </div>
                );
            })}
        </div>
    </div>
)}

{/* 不要馬・見送り馬 — Premium と同一ロジック */}
{ineligible.length > 0 && (
    <details class="ineligible-section" data-click-close="true">
        <summary>不要馬・見送り馬 {ineligible.length}頭</summary>
        <ul class="ineligible-list">
            {ineligible.map((h: any) => {
                const gap = honmeiPt - (Number(h.pt) || 0);
                const comment = generateMinorHorseComment('無', gap);
                return (
                    <li class="ineligible-row">
                        <div class="ineligible-row-top">
                            <span class="ineligible-num">{h.number}</span>
                            <span class="ineligible-name">{h.name}</span>
                            {/* 2026-05-14: pt=70 は importPrediction.js の未評価フォールバック値で
                                「高評価の70点」ではないため、不要馬カードでは「見送り」ラベルに置換。
                                pt=0 の馬は「評価対象外」、それ以外で実際の点を持つ馬のみ {pt}pt 表示。
                                内部 pt はそのまま、ここは表示文言だけ。 */}
                            {(Number(h.pt) || 0) > 70 ? (
                                <span class="ineligible-pt">{h.pt}pt</span>
                            ) : (
                                <span class="ineligible-pt ineligible-pt-skip">見送り</span>
                            )}
                            {h.jockey && <span class="ineligible-meta">騎手:{h.jockey}</span>}
                            <span class="ineligible-reason">{reasonFor(h)}</span>
                        </div>
                        {comment && (
                            <div class="ineligible-comment">{comment}</div>
                        )}
                        {/* 南関のみ: 近走詳細データ（条件別成績・回収率）。premium 南関 不要馬行と同一の
                            既存 NankanHorseStatsPanel を再利用。horseStatsNankan が無い馬・JRA 馬では panel 側
                            show 判定で何も描画しない。初期 close・本文クリックで内側 details だけ閉じる。 */}
                        <NankanHorseStatsPanel horse={h} />
                    </li>
                );
            })}
        </ul>
    </details>
)}

<style is:global>
    /* 連下・抑え（minor-horse-card 系）— 全 Light/Premium ページで共通利用 */
    .horse-card-minor {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(30, 41, 59, 0.9) 100%);
        border-radius: 14px;
        padding: 18px 18px;
        border: 1px solid rgba(148, 163, 184, 0.2);
        margin-top: 16px;
    }
    .horse-mark-minor {
        font-size: 1.3rem;
        color: #f59e0b;
        font-weight: 900;
        margin-right: 10px;
    }
    .minor-group-title {
        margin-left: 10px;
        font-weight: 600;
    }
    .minor-group-title-renka { color: #f59e0b; }
    .minor-group-title-osae { color: #94a3b8; }
    .minor-group-osae .horse-mark-minor { color: #94a3b8; }

    .minor-horse-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 12px;
        margin-top: 8px;
    }
    .minor-horse-card {
        background: rgba(15, 23, 42, 0.7);
        border-radius: 10px;
        padding: 12px 14px;
        border: 1px solid rgba(100, 116, 139, 0.25);
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .minor-horse-card-renka {
        border-color: rgba(245, 158, 11, 0.35);
        background: linear-gradient(180deg, rgba(245, 158, 11, 0.04), rgba(15, 23, 42, 0.7));
    }
    .minor-horse-card-osae {
        border-color: rgba(100, 116, 139, 0.3);
    }
    .minor-horse-head {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .minor-horse-mark {
        color: #f59e0b;
        font-weight: 700;
        font-size: 1rem;
    }
    .minor-horse-card-osae .minor-horse-mark { color: #94a3b8; }
    .minor-horse-number {
        background: linear-gradient(135deg, #6b7280, #4b5563);
        color: white;
        padding: 2px 8px;
        border-radius: 5px;
        font-weight: 700;
        font-size: 0.85rem;
        min-width: 26px;
        text-align: center;
    }
    .minor-horse-name {
        color: #e2e8f0;
        font-weight: 600;
        font-size: 0.95rem;
        flex: 1;
    }
    .minor-horse-score {
        color: #10b981;
        font-weight: 700;
        background: rgba(16, 185, 129, 0.1);
        padding: 2px 8px;
        border-radius: 999px;
        border: 1px solid rgba(16, 185, 129, 0.3);
        font-size: 0.8rem;
    }
    .minor-horse-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 12px;
        color: #cbd5e1;
        font-size: 0.82rem;
    }
    .minor-horse-meta .meta-key {
        color: #64748b;
        margin-right: 4px;
        font-size: 0.75rem;
    }
    .minor-horse-evals {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }
    .eval-tag-small {
        background: rgba(59, 130, 246, 0.12);
        color: #93c5fd;
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 0.72rem;
    }
    .minor-horse-importance {
        color: #94a3b8;
        font-size: 0.78rem;
    }
    .minor-horse-comment {
        margin: 0;
        color: #e2e8f0;
        font-size: 0.85rem;
        line-height: 1.5;
        padding: 6px 8px;
        background: rgba(30, 41, 59, 0.5);
        border-radius: 6px;
        border-left: 3px solid rgba(245, 158, 11, 0.4);
    }
    .minor-horse-card-osae .minor-horse-comment {
        border-left-color: rgba(100, 116, 139, 0.4);
    }

    /* 過去走（折りたたみ・共通） */
    .recent-races {
        margin-top: 12px;
        background: rgba(15, 23, 42, 0.5);
        border-radius: 8px;
        padding: 8px 12px;
        border: 1px solid rgba(100, 116, 139, 0.2);
    }
    .recent-races > summary {
        cursor: pointer;
        color: #cbd5e1;
        font-weight: 600;
        font-size: 0.88rem;
        list-style: none;
    }
    .recent-races > summary::-webkit-details-marker { display: none; }
    .recent-races > summary::before {
        content: '▶';
        display: inline-block;
        margin-right: 8px;
        color: #64748b;
        font-size: 0.7rem;
        transition: transform 0.2s ease;
    }
    .recent-races[open] > summary::before { transform: rotate(90deg); }
    .recent-races-list {
        margin-top: 10px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    /* 1走 = 1カード（3行構成: main / performance / meta） */
    .recent-race-card {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 8px 10px;
        background: rgba(15, 23, 42, 0.32);
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 8px;
        font-size: 0.78rem;
        color: #cbd5e1;
    }
    .recent-race-line {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 12px;
        align-items: baseline;
    }
    .recent-race-line-perf,
