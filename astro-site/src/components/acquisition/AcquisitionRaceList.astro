---
/**
 * 「予想を取得」一覧（取得前は本文を出さない）。
 * 渡すのは出走情報（buildRaceListing）と取得状態・選別結果だけ。買い目・印・指数は渡さない／描画しない。
 */
import '../../styles/acquisitionGlass.css';
import { viewUrlFor } from '../../lib/acquisition/acquisitionServer.js';

interface Props {
  product: 'premium' | 'srp';
  basePath: string;
  date: string;
  dates: string[];
  venues: Array<{ venueName: string; venueId: string; races: Array<{ key: string; listing: any; acquired: any; selection?: any; canAcquire?: boolean }> }>;
  canAcquire: boolean;
  acquiredUnknown?: boolean;
  /** premium = 本利用（取得できる）/ preview = 体験（同じカード・同じ位置に Premium への CTA）*/
  mode?: 'premium' | 'preview';
}
const { product, basePath, date, dates, venues, canAcquire, acquiredUnknown = false, mode = 'premium' } = Astro.props;
const isPreview = mode === 'preview';
const wd = ['日', '月', '火', '水', '木', '金', '土'];
const dateLabel = (d: string) => { const t = new Date(`${d}T00:00:00Z`); return `${t.getUTCMonth() + 1}/${t.getUTCDate()}(${wd[t.getUTCDay()]})`; };
const jstTime = (iso: string) => { const t = new Date(Date.parse(iso) + 9 * 3600e3); return `${t.getUTCMonth() + 1}/${t.getUTCDate()} ${String(t.getUTCHours()).padStart(2, '0')}:${String(t.getUTCMinutes()).padStart(2, '0')}`; };
const gradeLabel = { A: '推奨度 A', B: '推奨度 B', skip: '見送り候補' };
const productLabel = product === 'srp' ? 'Premium Sanrenpuku' : 'Premium予想';
const ctaLabel = product === 'srp' ? '推奨レースの予想を取得する' : '予想を取得する';
// レースごとの取得可否（会場別の契約）。無ければ一覧全体の canAcquire
const can = (r) => (typeof r.canAcquire === 'boolean' ? r.canAcquire : canAcquire);
// 「次のレースの予想を取得する」の飛び先＝最初の未取得で取得できるレース
const nextKey = isPreview ? null : (venues.flatMap((v) => v.races).find((r) => !r.acquired && can(r))?.key || null);
const previewUrl = (key) => `/free-prediction/view/?key=${encodeURIComponent(key)}`;
---
<div class="acq-list" data-product={product}>
  {dates.length > 1 && (
    <nav class="acq-dates" aria-label="日付">
      {dates.map((d) => <a href={`${basePath}?date=${d}`} class={d === date ? 'is-active' : ''} aria-current={d === date ? 'date' : undefined}>{dateLabel(d)}</a>)}
    </nav>
  )}
  {acquiredUnknown && <p class="acq-warn">取得状況を確認できませんでした。取得済みの予想は「取得済みの予想」からご覧ください。</p>}
  {venues.length === 0 && <p class="acq-empty">この日の予想はまだありません。</p>}
  {venues.map((v) => (
    <section class="acq-venue">
      <h2 class="acq-venue-title">{v.venueName}<small>{v.races.length}レース</small></h2>
      {v.races.map((r) => (
        <article class={`ag-glass acq-race${r.acquired ? ' is-acquired' : ''}`} data-key={r.key} id={r.key === nextKey ? 'acq-next' : undefined}>
          <div class="acq-race-no ag-inset"><strong>{r.listing.raceNumber}R</strong><span>{r.listing.startTime}</span></div>
          <div class="acq-race-info">
            <h3>{r.listing.raceName || `${r.listing.raceNumber}R`}{r.listing.isMainRace && <span class="acq-tag main">メイン</span>}</h3>
            <p>{[r.listing.distance, r.listing.horseCount ? `${r.listing.horseCount}頭` : ''].filter(Boolean).join(' ・ ')}</p>
            {r.selection && (
              <div class={`acq-sel grade-${r.selection.grade}`}>
                <span class="acq-sel-badge">{gradeLabel[r.selection.grade]}</span>
                <span class="acq-sel-reason">{r.selection.reasons[0]}</span>
              </div>
            )}
          </div>
          <div class="acq-race-cta">
            {isPreview ? (
              <>
                <a class="ag-cta ag-cta-premium acq-btn" href="/pricing/">Premiumで予想を取得</a>
                <small>この予想を取得するにはPremium ・ <a class="acq-preview-link" href={previewUrl(r.key)}>取得後の画面を見る</a></small>
              </>
            ) : r.acquired ? (
              <>
                <span class="ag-done">✓ 取得済み</span>
                <a class="ag-btn-ghost acq-view" href={viewUrlFor(r.key)}>予想を見る</a>
                <small>取得 {jstTime(r.acquired.at)}</small>
              </>
            ) : can(r) ? (
              <form method="post" action="/api/predictions/acquire/">
                <input type="hidden" name="key" value={r.key} />
                <button type="submit" class="ag-cta acq-btn">{ctaLabel}</button>
                <small>{productLabel}</small>
              </form>
            ) : (
              <small class="acq-locked">この予想はご契約のプランでは取得できません</small>
            )}
          </div>
        </article>
      ))}
    </section>
  ))}
</div>

<style>
  .acq-list { display: grid; gap: 16px; min-width: 0; }
  .acq-dates { display: flex; gap: 8px; overflow-x: auto; padding: 2px 2px 6px; scrollbar-width: none; }
  .acq-dates::-webkit-scrollbar { display: none; }
  .acq-dates a { flex: 0 0 auto; display: inline-flex; align-items: center; min-height: 42px; padding: 0 16px; border-radius: 12px; color: var(--ag-text); text-decoration: none; font-weight: 800; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.16); box-shadow: inset 0 1px 0 rgba(255,255,255,0.12); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .acq-dates a.is-active { background: var(--ag-cta); border-color: rgba(255,255,255,0.35); box-shadow: 0 6px 18px rgba(99,102,241,0.45), inset 0 1px 0 rgba(255,255,255,0.35); }
  .acq-venue { display: grid; gap: 10px; min-width: 0; }
  .acq-venue-title { display: flex; align-items: baseline; gap: 8px; margin: 6px 0 0; padding-left: 10px; border-left: 4px solid; border-image: linear-gradient(180deg, #22d3ee, #8b5cf6) 1; font-size: 1.15rem; }
  .acq-venue-title small { font-size: 0.78rem; color: var(--ag-text-2); font-weight: 600; }
  .acq-race { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 10px 12px; align-items: center; padding: 12px; min-width: 0; }
  .acq-race[id="acq-next"] { scroll-margin-top: 90px; }
  .acq-race.is-acquired { border-color: rgba(74,222,128,0.42); box-shadow: var(--ag-shadow), 0 0 22px rgba(74,222,128,0.12), var(--ag-hi); }
  .acq-race-no { display: grid; justify-items: center; padding: 8px 4px; }
  .acq-race-no strong { font-size: 1.2rem; line-height: 1.1; }
  .acq-race-no span { font-size: 0.76rem; color: var(--ag-text-2); }
  .acq-race-info { min-width: 0; }
  .acq-race-info h3 { margin: 0; font-size: 1rem; line-height: 1.35; overflow-wrap: anywhere; }
  .acq-race-info p { margin: 3px 0 0; color: var(--ag-text-2); font-size: 0.82rem; }
  .acq-tag.main { margin-left: 6px; font-size: 0.68rem; padding: 1px 8px; border-radius: 999px; color: var(--ag-gold); border: 1px solid rgba(252,211,77,0.5); background: rgba(252,211,77,0.10); vertical-align: middle; }
  .acq-sel { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px; align-items: baseline; font-size: 0.82rem; }
  .acq-sel-badge { font-weight: 900; padding: 1px 9px; border-radius: 999px; background: rgba(148,163,184,0.25); border: 1px solid rgba(255,255,255,0.18); }
  .acq-sel.grade-A .acq-sel-badge { background: linear-gradient(135deg, #f43f5e, #e11d48); box-shadow: 0 0 12px rgba(244,63,94,0.45); }
  .acq-sel.grade-B .acq-sel-badge { background: linear-gradient(135deg, #f59e0b, #d97706); }
  .acq-sel-reason { color: var(--ag-text-2); }
  .acq-race-cta { grid-column: 1 / -1; display: grid; gap: 6px; }
  .acq-race-cta form { display: grid; gap: 4px; margin: 0; }
  .acq-race-cta .acq-btn, .acq-race-cta .acq-view { width: 100%; }
  .acq-race-cta small { color: var(--ag-text-3); font-size: 0.72rem; text-align: center; }
  .acq-race.is-acquired .acq-race-cta { grid-template-columns: auto minmax(0, 1fr); align-items: center; }
  .acq-race.is-acquired .acq-race-cta small { grid-column: 1 / -1; }
  .acq-warn, .acq-empty, .acq-locked { color: var(--ag-text-2); }
  .acq-preview-link { color: #bae6fd; font-weight: 700; }
  @media (min-width: 640px) {
    .acq-race { grid-template-columns: 64px minmax(0, 1fr) 230px; padding: 14px 16px; }
    .acq-race-cta .acq-btn { white-space: nowrap; }
    .acq-race-cta { grid-column: auto; }
    .acq-race.is-acquired .acq-race-cta { grid-template-columns: 1fr; justify-items: center; }
  }
</style>
