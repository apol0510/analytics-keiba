---
/**
 * 取得済み予想の本文（スナップショットから描画・ガラスモーフィズム・mobile-first）。
 * ⚠️ 取得済みと確認したページ（/predictions/view/）からだけ使う。一覧や取得前の画面で使わない。
 * 指数は保存時点で raw−1（getHorseAiIndex）済みの aiIndex だけを出す。
 *
 * 2026-10-03 MK 確定（docs/PREDICTION_ACQUISITION.md §2-1・§2-2）:
 *   - Premium は馬単専用（通常＋点数を絞った買い目）。三連複の買い目は出さない（v1 の保存データに残っていても描画しない）
 *   - 過去走は全馬ぶん出す（無料ページで見られる情報を減らさない）。PC は表、mobile は馬ごと・走ごとのカード
 *   - 連下／抑え／評価外は 1 頭ずつ独立したチップ（「/」区切りの文字列にしない）
 *   - Premium Sanrenpuku は推奨度・理由・三連複 通常／中心
 */
import '../../styles/acquisitionGlass.css';
import { umatanLineHits, sanrenpukuLineHits } from '../../lib/acquisition/acquiredResults.js';
interface Props { content: any; pastUnavailable?: boolean; result?: any }
const { content: c, pastUnavailable = false, result = null } = Astro.props;
// 結果（2026-10-05 MK・§2-5）: 当たった買い目の行を緑で示し、その行の 1・2 着の馬番を着順色にする（外れた行には付けない）
const order = Array.isArray(result?.order) ? result.order : null;
const umHit = (line) => !!(order && order.length >= 2 && umatanLineHits(line, order[0], order[1]));
const srpHit = (line) => !!(order && order.length === 3 && sanrenpukuLineHits(line, order));
const numRank = (hit, n) => { if (!hit || !order) return ''; const i = order.slice(0, isSrp ? 3 : 2).indexOf(Number(n)); return i === 0 ? ' rk-1' : i === 1 ? ' rk-2' : i === 2 ? ' rk-3' : ''; };
const isSrp = c.product === 'srp';
// Preview（/free-prediction/view/）: 公開してよい範囲だけ（buildPreviewContent）。買い目・指数・役割分類は描画しない
const isPreview = c.preview === true;
const ROLE_CLASS = {
  '本命': 'ag-role-honmei', '対抗': 'ag-role-taikou', '単穴': 'ag-role-tana',
  '連下最上位': 'ag-role-renka', '連下': 'ag-role-renka', '抑え': 'ag-role-osae', '不要': 'ag-role-out',
};
const ROLE_LABEL = { '連下最上位': '連下', '不要': '評価外' };
const ROLE_ORDER = { '本命': 0, '対抗': 1, '単穴': 2, '連下最上位': 3, '連下': 4, '抑え': 5, '不要': 6 };
const main = c.horses.filter((h) => ['本命', '対抗', '単穴'].includes(h.role)).sort((a, b) => ROLE_ORDER[a.role] - ROLE_ORDER[b.role]);
const groups = isPreview ? [
  { key: 'renka', label: '△ 連下（最上位）', horses: c.horses.filter((h) => h.role === '連下最上位'), cls: 'minor-group-renka' },
  { key: 'others', label: 'その他の出走馬', horses: c.horses.filter((h) => !h.role), cls: 'acq-preview-others' },
].filter((g) => g.horses.length > 0) : [
  { key: 'renka', label: '連下', horses: c.horses.filter((h) => h.role === '連下最上位' || h.role === '連下'), cls: 'minor-group-renka' },
  { key: 'osae', label: '抑え', horses: c.horses.filter((h) => h.role === '抑え'), cls: 'minor-group-osae' },
  { key: 'out', label: '評価外', horses: c.horses.filter((h) => h.role === '不要'), cls: 'ineligible-section' },
].filter((g) => g.horses.length > 0);
const gradeLabel = { A: '推奨度 A', B: '推奨度 B', skip: '見送り' };
const LABELS = ['前走', '2走前', '3走前', '4走前', '5走前'];
const byRole = c.horses.slice().sort((a, b) => (ROLE_ORDER[a.role] - ROLE_ORDER[b.role]) || (a.number - b.number));
const hasPast = c.horses.some((h) => Array.isArray(h.recent));
/** "6↔4.8.10" → { axis, arrow, partners[] } */
function splitLine(line) {
  const m = /^(\d+)\s*(↔|⇔|→|-)\s*(.+)$/.exec(String(line || ''));
  if (!m) return { axis: null, arrow: '', partners: [String(line || '')] };
  return { axis: m[1], arrow: m[2] === '→' ? '→' : '⇔', partners: m[3].split('.').filter(Boolean) };
}
const rankClass = (rank) => { const n = Number(rank); return n === 1 ? 'rk rk-1' : n === 2 ? 'rk rk-2' : n === 3 ? 'rk rk-3' : 'rk'; };
const umatanTotal = (isSrp || isPreview) ? 0 : c.umatan.normal.reduce((s, l) => s + l.points, 0);
/** 過去走の列（値のある列だけ出す。データ元によって日付・レース名・上り等が無いため）*/
const PAST_COLS = [
  { key: 'date', label: '日付' }, { key: 'venue', label: '開催' }, { key: 'raceName', label: 'レース名', cls: 'race' },
  { key: 'rank', label: '着順', cls: 'num' }, { key: 'distance', label: '距離・馬場' }, { key: 'jockey', label: '騎手' },
  { key: 'passingOrder', label: '通過' }, { key: 'last3f', label: '上り', cls: 'num' }, { key: 'time', label: 'タイム' },
  { key: 'bodyWeight', label: '馬体重' },
];
const colsFor = (rows) => PAST_COLS.filter((col) => rows.some((r) => col.key === 'rank' ? (r.rank || r.finishStatus) : col.key === 'distance' ? (r.distance || r.trackCondition) : r[col.key]));
const cellFor = (r, key) => key === 'distance' ? [r.distance, r.trackCondition].filter(Boolean).join(' ') : key === 'bodyWeight' ? (r.bodyWeight ? `${r.bodyWeight}kg` : '') : (r[key] || '');
/** mobile カードの補足行（ラベル付き・値のあるものだけ） */
const metaFor = (r) => [
  r.jockey && ['騎手', r.jockey], r.passingOrder && ['通過', r.passingOrder], r.last3f && ['上り', r.last3f],
  r.time && ['タイム', r.time], r.bodyWeight && ['馬体重', `${r.bodyWeight}kg`], r.headCount && ['頭数', `${r.headCount}頭`],
].filter(Boolean);
---
<div class="acq-body" data-product={c.product}>
  {isSrp && (
    <section class={`ag-glass acq-sec acq-selection grade-${c.selection.grade}${c.selection.grade === "A" || c.selection.grade === "B" ? "" : " ag-tint-blue"}`} aria-label="レース選別">
      <div class="acq-grade">{gradeLabel[c.selection.grade] || '見送り'}</div>
      <ul class="acq-reasons">{c.selection.reasons.map((r) => <li>{r}</li>)}</ul>
    </section>
  )}

  <div class="acq-grid">
    <section class="recommendation-section acq-col-bets" aria-label="買い目">
      <div class="unified-bet-card">
        {isPreview ? (
          <>
            {/* 2026-10-04 MK 確定: 有料版のプレビューなので買い目カードは 1 枚（馬単買い目）だけ */}
            <article class="ag-glass ag-tint-blue acq-sec acq-bet acq-locked-bet" data-kind="umatan-preview">
              <header class="acq-head"><h3>馬単買い目</h3><span class="ag-pill violet">Premium</span></header>
              <p class="acq-note">Premium では、通常の買い目と点数を絞った買い目を表示します。</p>
              <div class="betting-teaser ag-inset" aria-hidden="true">
                <span class="acq-axis"><span class="acq-axis-label">軸</span><span class="ag-num lg acq-axis-num">●</span></span>
                <span class="acq-arrow">⇔</span>
                <span class="acq-partners">{[1, 2, 3, 4, 5].map(() => <span class="acq-pnum">●</span>)}</span>
              </div>
              <a class="ag-cta ag-cta-premium acq-unlock" href="/pricing/">この予想を取得するにはPremium</a>
            </article>
          </>
        ) : !isSrp ? (
          <>
            <article class="ag-glass ag-tint-blue acq-sec acq-bet" data-kind="umatan-normal">
              <header class="acq-head">
                <h3>馬単 通常の買い目</h3>
                <span class="ag-pill">{umatanTotal}点</span>
              </header>
              <p class="acq-note">{c.isMainRace ? '本命から相手 5 頭への馬単（一方向）です。' : '本命・対抗を軸に、相手との組み合わせ（表裏）で購入する買い目です。'}</p>
              <ul class="bet-list">
                {c.umatan.normal.map((l) => { const p = splitLine(l.line); const hit = umHit(l.line); return (
                  <li class={`bet-item ag-inset${hit ? ' is-hit-line' : ''}`} data-hit={hit ? 'true' : undefined}>
                    <span class="acq-axis"><span class="acq-axis-label">軸</span>{p.axis && <span class={`ag-num lg acq-axis-num${numRank(hit, p.axis)}`}>{p.axis}</span>}</span>
                    <span class="acq-arrow" aria-hidden="true">{p.arrow}</span>
                    <span class="acq-partners">{p.partners.map((n) => <span class={`acq-pnum${numRank(hit, n)}`}>{n}</span>)}</span>
                    <span class={`ag-pill acq-line-pts${hit ? ' acq-hit-pill' : ''}`}>{hit ? `✓ 的中・${l.points}点` : `${l.points}点`}</span>
                  </li>
                ); })}
              </ul>
            </article>
            {c.umatan.narrowed && (() => { const p = splitLine(c.umatan.narrowed.line); const hit = umHit(c.umatan.narrowed.line); return (
              <article class="ag-glass ag-tint-blue acq-sec acq-bet" data-kind="umatan-narrowed">
                <header class="acq-head">
                  <h3>馬単 点数を絞った買い目</h3>
                  <span class="ag-pill">{c.umatan.narrowed.points}点</span>
                </header>
                <p class="acq-note">本命を軸に、相手を評価上位 3 頭に絞った買い目です。</p>
                <ul class="bet-list">
                  <li class={`bet-item ag-inset${hit ? ' is-hit-line' : ''}`} data-hit={hit ? 'true' : undefined}>
                    <span class="acq-axis"><span class="acq-axis-label">軸</span>{p.axis && <span class={`ag-num lg acq-axis-num${numRank(hit, p.axis)}`}>{p.axis}</span>}</span>
                    <span class="acq-arrow" aria-hidden="true">{p.arrow}</span>
                    <span class="acq-partners">{p.partners.map((n) => <span class={`acq-pnum${numRank(hit, n)}`}>{n}</span>)}</span>
                    <span class={`ag-pill acq-line-pts${hit ? ' acq-hit-pill' : ''}`}>{hit ? `✓ 的中・${c.umatan.narrowed.points}点` : `${c.umatan.narrowed.points}点`}</span>
                  </li>
                </ul>
              </article>
            ); })()}
          </>
        ) : (
          <>
            <article class="ag-glass ag-tint-blue acq-sec acq-bet" data-kind="sanrenpuku-normal">
              <header class="acq-head">
                <h3>三連複 通常の買い目</h3>
                <span class="ag-pill">{c.sanrenpuku.normal.reduce((s, l) => s + l.points, 0)}点</span>
              </header>
              {c.sanrenpuku.normal.length === 0 && <p class="acq-note">このレースは三連複の買い目を組めません。</p>}
              <ul class="bet-list">{c.sanrenpuku.normal.map((l) => { const hit = srpHit(l.line); return <li class={`bet-item ag-inset${hit ? ' is-hit-line' : ''}`} data-hit={hit ? 'true' : undefined}><span class="acq-srp-line">{l.line}</span><span class={`ag-pill acq-line-pts${hit ? ' acq-hit-pill' : ''}`}>{hit ? `✓ 的中・${l.points}点` : `${l.points}点`}</span></li>; })}</ul>
            </article>
            {c.sanrenpuku.center && (
              <article class="ag-glass acq-sec acq-bet narrowed" data-kind="sanrenpuku-center">
                <header class="acq-head">
                  <h3>三連複 中心買い目</h3>
                  <span class="ag-pill gold">{c.sanrenpuku.center.points}点</span>
                </header>
                <p class="acq-note">本命を軸に、評価上位の相手で組んだ中心の買い目です。</p>
                <ul class="bet-list"><li class={`bet-item ag-inset${srpHit(c.sanrenpuku.center.line) ? ' is-hit-line' : ''}`} data-hit={srpHit(c.sanrenpuku.center.line) ? 'true' : undefined}><span class="acq-srp-line">{c.sanrenpuku.center.line}</span><span class={`ag-pill acq-line-pts${srpHit(c.sanrenpuku.center.line) ? ' acq-hit-pill' : ' gold'}`}>{srpHit(c.sanrenpuku.center.line) ? `✓ 的中・${c.sanrenpuku.center.points}点` : `${c.sanrenpuku.center.points}点`}</span></li></ul>
              </article>
            )}
          </>
        )}
      </div>
    </section>

    <div class="acq-col-marks">
      <section class="ag-glass ag-tint-blue acq-sec acq-marks" aria-label="印とAI総合指数">
        <header class="acq-head"><h3>印と AI 総合指数</h3></header>
        <ul class="acq-mark-list">
          {main.map((h) => (
            <li class={`acq-mark ag-inset ${ROLE_CLASS[h.role]}`}>
              <span class="acq-mark-role">{h.role}</span>
              <span class="ag-num lg">{h.number}</span>
              <span class="acq-mark-name"><strong>{h.name}</strong>{h.jockey && <small>{h.jockey}</small>}</span>
              {isPreview
                ? <span class="acq-mark-index acq-masked"><small>AI総合指数</small><strong aria-label="Premiumで表示">●●</strong></span>
                : <span class="acq-mark-index"><small>AI総合指数</small><strong>{h.aiIndex ?? '—'}</strong></span>}
            </li>
          ))}
        </ul>
      </section>

      {groups.length > 0 && (
        <section class="ag-glass ag-tint-blue acq-sec acq-groups" aria-label="連下・抑え・評価外">
          {isPreview && <p class="acq-note acq-preview-note">連下・抑え・評価外の分類は Premium で表示されます。</p>}
          {groups.map((g) => (
            <div class={`acq-group ${g.cls}`} data-group={g.key}>
              <h4><span>{g.label}</span><small>{g.horses.length}頭</small></h4>
              <ul class="ag-chips">
                {g.horses.map((h) => (
                  <li class={`ag-chip ${ROLE_CLASS[h.role]}`}><span class="ag-num">{h.number}</span><span class="ag-chip-name">{h.name}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )}
    </div>
  </div>

  <section class="ag-glass ag-tint-blue acq-sec acq-past" aria-label="過去走" id="past-races">
    <header class="acq-head"><h3>過去走 <small>全頭の直近のレース成績</small></h3></header>
    {pastUnavailable && <p class="acq-note">この予想の過去走は、現在表示できません。</p>}
    {!pastUnavailable && !hasPast && <p class="acq-note">過去走データはありません。</p>}
    {hasPast && (
      <div class="acq-past-list">
        {byRole.map((h) => (
          <details class={`acq-past-horse ag-inset ${ROLE_CLASS[h.role]}`} open={['本命', '対抗', '単穴'].includes(h.role)}>
            <summary>
              <span class="ag-num">{h.number}</span>
              <span class="acq-past-name">{h.name}</span>
              <span class="acq-past-role">{ROLE_LABEL[h.role] || h.role}</span>
              <span class="acq-past-count">{(h.recent || []).length ? `過去${(h.recent || []).length}走` : '過去走なし'}</span>
            </summary>
            {(h.recent || []).length > 0 && (
              <>
                <div class="acq-table-wrap acq-only-wide">
                  <table class="acq-table">
                    <thead><tr><th></th>{colsFor(h.recent).map((col) => <th>{col.label}</th>)}</tr></thead>
                    <tbody>
                      {h.recent.map((r, i) => (
                        <tr>
                          <td class="lbl">{LABELS[i]}</td>
                          {colsFor(h.recent).map((col) => col.key === 'rank' ? (
                            <td class="num">{r.rank ? <span class={rankClass(r.rank)}>{r.rank}着</span> : (r.finishStatus || '—')}{r.popularity && <small class="pop">{r.popularity}人気</small>}</td>
                          ) : (
                            <td class={col.cls || ''}>{cellFor(r, col.key) || '—'}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <ol class="acq-race-cards acq-only-narrow">
                  {h.recent.map((r, i) => (
                    <li class="acq-race-card">
                      <div class="acq-rc-top">
                        <span class="acq-rc-label">{LABELS[i]}</span>
                        {r.rank ? <span class={rankClass(r.rank)}>{r.rank}着</span> : (r.finishStatus && <span class="rk">{r.finishStatus}</span>)}
                        {r.popularity && <span class="acq-rc-pop">{r.popularity}人気</span>}
                        <span class="acq-rc-when">{[r.date, r.venue].filter(Boolean).join(' ')}</span>
                      </div>
                      {(r.raceName || r.distance) && <div class="acq-rc-race">{[r.raceName, [r.distance, r.trackCondition].filter(Boolean).join(' ')].filter(Boolean).join(' ・ ')}</div>}
                      {metaFor(r).length > 0 && <dl class="acq-rc-meta">{metaFor(r).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
                    </li>
                  ))}
                </ol>
              </>
            )}
            {h.record && (
              <div class="acq-record">
                <div class="acq-record-cards">
                  <div><span>通算</span><strong>{h.record.record}</strong></div>
                  <div><span>勝率</span><strong>{h.record.winPct}</strong></div>
                  <div><span>連対率</span><strong>{h.record.placePct}</strong></div>
                  <div><span>3着内率</span><strong>{h.record.showPct}</strong></div>
                </div>
                {h.record.conds.length > 0 && <ul class="acq-conds">{h.record.conds.map((x) => <li><span>{x.label}</span><strong>{x.text}</strong></li>)}</ul>}
                {h.record.rows.length > 0 && (
                  <details class="acq-history">
                    <summary>競走成績（直近{h.record.rows.length}走）{h.record.more > 0 && `・他${h.record.more}走あり`}</summary>
                    <ol>{h.record.rows.map((r) => (
                      <li>
                        <div class="acq-rc-top">
                          {r.rank ? <span class={rankClass(r.rank)}>{r.rank}着</span> : (r.finishStatus && <span class="rk">{r.finishStatus}</span>)}
                          {r.popularity && <span class="acq-rc-pop">{r.popularity}人気</span>}
                          <span class="acq-rc-when">{[r.date, r.venue].filter(Boolean).join(' ')}</span>
                        </div>
                        <div class="acq-rc-race">{[r.raceName, r.distance, r.jockey, r.time, r.winner && `勝: ${r.winner}`].filter(Boolean).join(' ・ ')}</div>
                      </li>
                    ))}</ol>
                  </details>
                )}
              </div>
            )}
          </details>
        ))}
      </div>
    )}
  </section>
</div>

<style>
  .acq-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .acq-body > *, .acq-grid > *, .unified-bet-card > *, .acq-past-list > *, .acq-col-marks > * { min-width: 0; }
  .acq-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .unified-bet-card, .acq-col-marks { display: grid; gap: 14px; }
  .acq-sec { padding: 16px; }
  .acq-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 6px; }
  .acq-head h3 { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin: 0; font-size: 1.05rem; letter-spacing: 0.02em; }
  .acq-head h3 small { font-size: 0.78rem; font-weight: 500; color: var(--ag-text-2); }
  .acq-note { margin: 0 0 12px; color: var(--ag-text-2); font-size: 0.85rem; line-height: 1.6; }

  /* 買い目 */
  .bet-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .bet-item { display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 12px; border-left: 3px solid var(--ag-blue); }
  .narrowed .bet-item { border-left-color: var(--ag-gold); box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 22px rgba(252,211,77,0.10); }
  .narrowed { border-color: rgba(252, 211, 77, 0.45); background: linear-gradient(155deg, rgba(252,211,77,0.10), rgba(245,158,11,0.04)); }
  .narrowed h3 { color: #fcd34d; }
  .acq-axis { display: inline-flex; align-items: center; gap: 6px; }
  .acq-axis-label { color: #bae6fd; font-weight: 800; font-size: 0.82rem; }
  .acq-axis-num { background: linear-gradient(135deg, #6366f1, #3b82f6); box-shadow: 0 0 14px rgba(99,102,241,0.55), inset 0 1px 0 rgba(255,255,255,0.35); }
  .acq-arrow { color: #e0e7ff; font-size: 1.15rem; font-weight: 700; }
  .acq-partners { display: flex; flex-wrap: wrap; gap: 6px; }
  /* 当たった買い目の行（緑）。1・2（・3）着の馬番は着順色（rk-1 金／rk-2 銀／rk-3 銅） */
  .bet-item.is-hit-line { border-color: rgba(74,222,128,0.6) !important; background: rgba(34,197,94,0.10) !important; box-shadow: 0 0 18px rgba(74,222,128,0.22); }
  .ag-pill.acq-hit-pill { color: #86efac; border-color: rgba(74,222,128,0.6); background: rgba(34,197,94,0.14); font-weight: 900; }
  .acq-pnum { display: inline-grid; place-items: center; min-width: 30px; height: 30px; padding: 0 6px; border-radius: 8px; font-weight: 800; background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.18); }
  .narrowed .acq-pnum { border-color: rgba(252,211,77,0.45); color: #fef3c7; }
