---
/**
 * 今月の利用状況と、最近取得した予想（summarizeUsage の結果を描画するだけ）。
 * usage が null のときは「確認できない」と表示する（0 件と区別する）。
 */
import { viewUrlFor } from '../../lib/acquisition/acquisitionServer.js';
interface Props { usage: any | null; compact?: boolean }
const { usage, compact = false } = Astro.props;
const jst = (iso: string) => { const t = new Date(Date.parse(iso) + 9 * 3600e3); return `${t.getUTCMonth() + 1}/${t.getUTCDate()} ${String(t.getUTCHours()).padStart(2, '0')}:${String(t.getUTCMinutes()).padStart(2, '0')}`; };
const productLabel = { premium: 'Premium', srp: '三連複 選別' };
---
<aside class={`acq-usage${compact ? ' compact' : ''}`} aria-label="今月の利用状況">
  <div class="acq-usage-card">
    <h2>今月の利用状況</h2>
    {usage ? (
      <>
        <div class="acq-usage-nums">
          <div><span>今月の取得数</span><strong data-usage="month-count">{usage.monthCount}</strong><em>件</em></div>
          <div><span>利用日数</span><strong data-usage="active-days">{usage.activeDays}</strong><em>日</em></div>
        </div>
        <dl class="acq-usage-cat">
          <div><dt>中央競馬</dt><dd data-usage="jra">{usage.byCategory.jra} 件</dd></div>
          <div><dt>南関東競馬</dt><dd data-usage="nankan">{usage.byCategory.nankan} 件</dd></div>
        </dl>
      </>
    ) : (
      <p class="acq-usage-unknown">利用状況を確認できませんでした。</p>
    )}
  </div>
  {usage && (
    <div class="acq-usage-card">
      <h2>取得済みの予想（直近{usage.recent.length}件）<a href="/predictions/history/">すべて見る</a></h2>
      {usage.recent.length === 0 ? <p class="acq-usage-unknown">まだ取得した予想はありません。</p> : (
        <ul class="acq-recent">
          {usage.recent.map((e) => (
            <li><a href={viewUrlFor(e.key)}>
              <span class="acq-recent-when">{jst(e.at)}</span>
              <span class="acq-recent-race">{e.venueName} {e.raceNumber}R <small>{productLabel[e.product] || ''}</small></span>
              <span class="acq-recent-name">{e.raceName}</span>
            </a></li>
          ))}
        </ul>
      )}
    </div>
  )}
</aside>

<style>
  .acq-usage { display: grid; gap: 14px; align-content: start; }
  .acq-usage-card { padding: 16px; border-radius: 12px; background: rgba(255,255,255,0.06); border: 1px solid rgba(148,163,184,0.2); }
  .acq-usage-card h2 { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin: 0 0 10px; font-size: 1rem; }
  .acq-usage-card h2 a { font-size: 0.8rem; color: #818cf8; }
  .acq-usage-nums { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .acq-usage-nums span { display: block; color: #94a3b8; font-size: 0.8rem; }
  .acq-usage-nums strong { font-size: 2rem; }
  .acq-usage-nums em { font-style: normal; margin-left: 4px; color: #94a3b8; }
  .acq-usage-cat { margin: 10px 0 0; display: grid; gap: 4px; }
  .acq-usage-cat div { display: flex; justify-content: space-between; }
  .acq-usage-cat dt { color: #cbd5e1; }
  .acq-usage-cat dd { margin: 0; font-weight: 700; }
  .acq-usage-unknown { margin: 0; color: #94a3b8; }
  .acq-recent { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .acq-recent a { display: grid; grid-template-columns: auto 1fr; gap: 2px 10px; padding: 8px; border-radius: 8px; color: inherit; text-decoration: none; background: rgba(15,23,42,0.5); }
  .acq-recent-when { grid-row: span 2; color: #94a3b8; font-size: 0.8rem; }
  .acq-recent-race { font-weight: 700; }
  .acq-recent-race small { color: #94a3b8; font-weight: 400; }
  .acq-recent-name { color: #cbd5e1; font-size: 0.85rem; }
</style>
