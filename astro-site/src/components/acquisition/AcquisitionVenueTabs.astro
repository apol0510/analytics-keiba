---
/**
 * Premium 取得一覧の会場タブ（すべて / 中央競馬 / 南関東競馬）。日付タブとは別軸（2026-10-03 MK 確定）。
 */
import '../../styles/acquisitionGlass.css';
interface Props { active: 'all' | 'jra' | 'nankan'; mode?: 'premium' | 'preview' }
const { active, mode = 'premium' } = Astro.props;
// Premium（本利用）と Preview（体験）で同じタブ。違いはリンク先だけ（2026-10-04 MK 確定）
const HREF = {
  premium: { all: '/predictions/', jra: '/premium-prediction/jra/', nankan: '/premium-prediction/nankan/' },
  preview: { all: '/free-prediction/all/', jra: '/free-prediction/jra/', nankan: '/free-prediction/nankan/' },
};
const TABS = [
  { key: 'all', label: 'すべて', href: HREF[mode].all },
  { key: 'jra', label: '中央競馬', href: HREF[mode].jra },
  { key: 'nankan', label: '南関東競馬', href: HREF[mode].nankan },
];
---
<nav class="ag-glass acq-venue-tabs" aria-label="会場">
  {TABS.map((t) => (
    <a href={t.href} class={t.key === active ? 'is-active' : ''} aria-current={t.key === active ? 'page' : undefined} data-venue-tab={t.key}>{t.label}</a>
  ))}
</nav>

<style>
  .acq-venue-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; padding: 4px; border-radius: 16px; }
  /* 2026-10-04 MK 確定: 会場タブはイエロー系のガラス。文字もイエローの同系色 */
  .acq-venue-tabs a { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 8px; border-radius: 12px; color: #fde68a; text-decoration: none; font-weight: 800; font-size: 0.92rem; white-space: nowrap; transition: background 0.15s ease, color 0.15s ease; }
  .acq-venue-tabs a:hover { color: #fef3c7; background: rgba(253, 224, 71, 0.12); }
  .acq-venue-tabs a.is-active {
    color: #713f12;
    background: linear-gradient(135deg, rgba(254, 249, 195, 0.92) 0%, rgba(253, 224, 71, 0.82) 55%, rgba(250, 204, 21, 0.72) 100%);
    border: 1px solid rgba(255, 251, 235, 0.85);
    box-shadow: 0 6px 20px rgba(250, 204, 21, 0.35), 0 0 22px rgba(253, 224, 71, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.75);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
  }
  .acq-venue-tabs a:focus-visible { outline: 3px solid #fef9c3; outline-offset: 2px; }
</style>
