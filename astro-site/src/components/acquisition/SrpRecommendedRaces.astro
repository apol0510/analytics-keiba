---
/**
 * Premium Sanrenpuku: 本日の三連複 推奨レース（上位 3）と見送り候補の件数。
 * 出すのは選別結果（推奨度・理由）だけ。買い目は取得後の本文ページで出す。
 */
import '../../styles/acquisitionGlass.css';
import { viewUrlFor } from '../../lib/acquisition/acquisitionServer.js';
interface Props { day: any; canAcquire: boolean }
const { day, canAcquire } = Astro.props;
const top3 = day?.top3 || [];
const gradeLabel = { A: '推奨度 A', B: '推奨度 B' };
---
<section class="ag-glass ag-tint-gold srp-today" aria-label="本日の三連複 推奨レース">
  <header class="srp-today-head">
    <h2>👑 本日の三連複 推奨レース</h2>
    <p>{day ? `${day.recommended.length}レースを推奨（全${day.total}レース中）` : ''}</p>
  </header>
  <p class="srp-today-lead">AI がその日のレースから、三連複で狙うべきレースを選別します。買い目を減らすのではなく、「買うレースを選ぶ」ための判定です。</p>
  {top3.length === 0 ? <p class="srp-muted">この日は推奨レースがありません（すべて見送り判定）。</p> : (
    <ol class="srp-top3">
      {top3.map((r) => (
        <li class={`ag-inset grade-${r.selection.grade}`}>
          <div class="srp-top-meta"><span class="srp-venue">{r.venueName} {r.listing.raceNumber}R</span><span class="srp-badge">{gradeLabel[r.selection.grade]}</span></div>
          <h3>{r.listing.raceName}</h3>
          <p class="srp-sub">{[r.listing.startTime, r.listing.distance].filter(Boolean).join(' ・ ')}</p>
          <p class="srp-reason">{r.selection.reasons.join(' ')}</p>
          {r.acquired ? <a class="ag-btn-ghost srp-view" href={viewUrlFor(r.key)}><span class="ag-done">✓ 取得済み</span>予想を見る</a> : canAcquire && (
            <form method="post" action="/api/predictions/acquire/">
              <input type="hidden" name="key" value={r.key} />
              <button type="submit" class="ag-cta srp-btn">推奨レースの予想を取得する</button>
            </form>
          )}
        </li>
      ))}
    </ol>
  )}
  {day && day.skipped.length > 0 && (
    <p class="srp-skip">見送り候補 {day.skipped.length}レース — 混戦・軸が不安定などの理由で、三連複では見送りと判定したレースです（下の一覧で理由を確認できます）。</p>
  )}
</section>

<style>
  .srp-today { padding: 16px; display: grid; gap: 10px; border-color: rgba(167,139,250,0.40); box-shadow: var(--ag-shadow), 0 0 32px rgba(139,92,246,0.18), var(--ag-hi); }
  .srp-today-head { display: flex; justify-content: space-between; align-items: baseline; gap: 6px 10px; flex-wrap: wrap; }
  .srp-today-head h2 { margin: 0; font-size: 1.2rem; background: linear-gradient(90deg, #f5f3ff, #c4b5fd 55%, #a5f3fc); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .srp-today-head p, .srp-today-lead, .srp-muted, .srp-skip { margin: 0; color: var(--ag-text-2); font-size: 0.88rem; line-height: 1.6; }
  .srp-top3 { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .srp-top3 li { padding: 14px; display: grid; gap: 6px; min-width: 0; }
  .srp-top3 li.grade-A { border-color: rgba(251,113,133,0.5); box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 22px rgba(244,63,94,0.16); }
  .srp-top3 li.grade-B { border-color: rgba(251,191,36,0.45); }
  .srp-top-meta { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .srp-venue { font-weight: 900; color: #c7d2fe; }
  .srp-badge { font-size: 0.76rem; font-weight: 900; padding: 1px 9px; border-radius: 999px; color: #fff; background: linear-gradient(135deg, #f59e0b, #d97706); }
  .grade-A .srp-badge { background: linear-gradient(135deg, #f43f5e, #e11d48); box-shadow: 0 0 12px rgba(244,63,94,0.5); }
  .srp-top3 h3 { margin: 0; font-size: 1.05rem; overflow-wrap: anywhere; }
  .srp-sub { margin: 0; color: var(--ag-text-2); font-size: 0.8rem; }
  .srp-reason { margin: 2px 0; padding: 8px 10px; border-radius: 10px; background: rgba(167,139,250,0.12); border: 1px solid rgba(167,139,250,0.25); font-size: 0.86rem; line-height: 1.6; }
  .srp-top3 form { margin: 0; }
  .srp-btn, .srp-view { width: 100%; }
  .srp-view { gap: 10px; }
  @media (min-width: 760px) { .srp-top3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } .srp-today { padding: 20px; } }
</style>
