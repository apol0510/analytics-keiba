---
/**
 * Premium Sanrenpuku: 本日の三連複 推奨レース（上位 3）と見送り候補の件数。
 * 出すのは選別結果（推奨度・理由）だけ。買い目は取得後の本文ページで出す。
 */
import { viewUrlFor } from '../../lib/acquisition/acquisitionServer.js';
interface Props { day: any; canAcquire: boolean }
const { day, canAcquire } = Astro.props;
const top3 = day?.top3 || [];
const gradeLabel = { A: '推奨度 A', B: '推奨度 B' };
---
<section class="srp-today" aria-label="本日の三連複 推奨レース">
  <header class="srp-today-head">
    <h2>👑 本日の三連複 推奨レース</h2>
    <p>{day ? `${day.recommended.length}レースを推奨（全${day.total}レース中）` : ''}</p>
  </header>
  <p class="srp-today-lead">AI がその日のレースから、三連複で狙うべきレースを選別します。買い目を減らすのではなく、「買うレースを選ぶ」ための判定です。</p>
  {top3.length === 0 ? <p class="srp-muted">この日は推奨レースがありません（すべて見送り判定）。</p> : (
    <ol class="srp-top3">
      {top3.map((r) => (
        <li class={`grade-${r.selection.grade}`}>
          <div class="srp-top-meta"><span class="srp-venue">{r.venueName} {r.listing.raceNumber}R</span><span class="srp-badge">{gradeLabel[r.selection.grade]}</span></div>
          <h3>{r.listing.raceName}</h3>
          <p class="srp-sub">{[r.listing.startTime, r.listing.distance].filter(Boolean).join(' ・ ')}</p>
          <p class="srp-reason">{r.selection.reasons.join(' ')}</p>
          {r.acquired ? <a class="srp-view" href={viewUrlFor(r.key)}>✓ 取得済み・予想を見る</a> : canAcquire && (
            <form method="post" action="/api/predictions/acquire/">
              <input type="hidden" name="key" value={r.key} />
              <button type="submit" class="srp-btn">推奨レースの予想を取得する</button>
            </form>
          )}
        </li>
      ))}
    </ol>
  )}
  {day && day.skipped.length > 0 && (
    <p class="srp-skip">見送り候補 {day.skipped.length}レース — 混戦・軸が不安定などの理由で、三連複では見送りと判定したレースです（下の一覧で理由を確認できます）。</p>
  )}
</section>

<style>
  .srp-today { padding: 18px; border-radius: 14px; background: linear-gradient(135deg, rgba(79,70,229,0.35), rgba(30,27,75,0.6)); border: 1px solid rgba(129,140,248,0.5); display: grid; gap: 10px; }
  .srp-today-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .srp-today-head h2 { margin: 0; font-size: 1.25rem; }
  .srp-today-head p, .srp-today-lead, .srp-muted, .srp-skip { margin: 0; color: #cbd5e1; font-size: 0.9rem; }
  .srp-top3 { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .srp-top3 li { padding: 14px; border-radius: 12px; background: rgba(15,23,42,0.7); border: 1px solid rgba(148,163,184,0.25); display: grid; gap: 4px; }
  .srp-top3 li.grade-A { border-color: rgba(239,68,68,0.6); }
  .srp-top-meta { display: flex; gap: 8px; align-items: center; }
  .srp-venue { font-weight: 800; color: #a5b4fc; }
  .srp-badge { font-size: 0.78rem; font-weight: 800; padding: 1px 8px; border-radius: 999px; background: #d97706; color: #fff; }
  .grade-A .srp-badge { background: #dc2626; }
  .srp-top3 h3 { margin: 0; font-size: 1.05rem; }
  .srp-sub { margin: 0; color: #94a3b8; font-size: 0.82rem; }
  .srp-reason { margin: 4px 0; padding: 8px 10px; border-radius: 8px; background: rgba(129,140,248,0.15); font-size: 0.88rem; line-height: 1.6; }
  .srp-top3 form { margin: 0; }
  .srp-btn { border: 0; cursor: pointer; padding: 10px 16px; border-radius: 10px; background: #4f46e5; color: #fff; font-weight: 800; width: 100%; }
  .srp-view { display: block; text-align: center; padding: 9px; border-radius: 10px; border: 1px solid rgba(74,222,128,0.6); color: #4ade80; text-decoration: none; font-weight: 800; }
</style>
