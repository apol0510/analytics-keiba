    "test:shared-checkers": "node --test scripts/lib/sharedCheckerSupport.test.mjs",
    "test:workflow-transient": "node --test scripts/lib/workflowTransientContract.test.mjs",
    "test:archive-coverage": "node --test scripts/checkArchiveCoverage.test.mjs",
    "test:free-viewpoints": "node --test src/lib/freeViewpoints/*.test.mjs",
    "test:jra-history-join": "node --test src/lib/jra/*.test.mjs",
