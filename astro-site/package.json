    "check:ssr-runtime-data": "node scripts/check-ssr-runtime-data.mjs",
    "test:ssr-retention": "node --test src/lib/ssr/runtimeDataRetention.test.mjs",
    "test:auth-security": "node --test src/lib/auth/authSecurity.guard.test.mjs src/lib/auth/paidPageGate.test.mjs",
    "test:dark-horse": "node --test src/lib/darkHorse/*.test.mjs",
