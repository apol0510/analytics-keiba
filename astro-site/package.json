  "dependencies": {
    "@astrojs/netlify": "^6.5.8",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.5.0",
    "@google/generative-ai": "^0.24.1",
    "@netlify/blobs": "^10.7.9",
    "@sendgrid/mail": "^8.1.6",
    "airtable": "^0.12.2",
    "astro": "^5.13.2",
    "sass": "^1.90.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "netlify-cli": "^23.5.0"
  }
}
