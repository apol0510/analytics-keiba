{
  "name": "analytics-keiba",
  "type": "module",
  "version": "1.0.0",
  "description": "AI-Powered Analytics for 南関競馬 + 中央競馬 (analytics.keiba.link)",
  "scripts": {
    "dev": "astro dev",
    "validate": "node scripts/validate-archive-data.js",
    "build": "npm run validate:archive && astro build",
    "build:skip-validation": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rm -rf dist",
    "typecheck": "astro check",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "validate:archive": "node scripts/validate-archive-json.cjs",
    "validate:prediction": "node scripts/validate-prediction-json.cjs",
    "verify:sync": "node scripts/verifyArchiveSync.js",
    "verify:jra:roles": "node scripts/verify-jra-role-score-consistency.mjs",
    "verify:nankan:roles": "node scripts/verify-jra-role-score-consistency.mjs --nankan",
    "verify:all:roles": "node scripts/verify-jra-role-score-consistency.mjs --all",
    "import:prediction": "node scripts/importPrediction.js",
    "import:prediction:jra": "node scripts/importPredictionJra.js",
    "import:results": "node scripts/importResults.js",
    "import:results:jra": "node scripts/importResultsJra.js",
    "import:horse-histories:jra": "node scripts/importHorseHistoriesJra.js",
    "import:recent-horse-histories:nankan": "node scripts/importRecentHorseHistoriesNankan.js",
    "import:entries:nankan": "node scripts/importEntriesNankan.js",
    "import:feature-scores": "node scripts/importFeatureScores.js",
    "import:computer": "node scripts/importComputer.js",
    "sync:archive": "node scripts/syncArchiveResults.js",
    "check:display-index": "node scripts/check-display-computer-index.mjs",
    "check:horse-sections": "node scripts/check-free-prediction-horse-sections.mjs",
    "check:no-raw-index": "node scripts/check-no-raw-computer-index-display.mjs",
    "check:differentiation": "node src/utils/adjustPrediction.differentiation.test.js",
    "check:ki-relics:jra": "node scripts/check-no-ki-relics-premium-jra.mjs",
    "check:ki-relics:free-jra-date": "node scripts/check-no-ki-relics-free-jra-date.mjs",
    "check:ki-relics:free-jra": "node scripts/check-no-ki-relics-free-jra.mjs",
    "check:jra-nankan-parity": "node scripts/check-jra-nankan-structure-parity.mjs",
    "check:prediction-integrity": "node scripts/check-prediction-data-integrity.mjs",
    "check:prediction-scope": "node scripts/lib/predictionFileScope.test.js",
    "check:jra-join": "node scripts/lib/computerIndexMatch.test.mjs",
    "audit:jra-ineligible": "node scripts/audit-jra-ineligible-invariant.mjs",
    "check:jra-ineligible-6paths": "node scripts/check-jra-ineligible-6paths.mjs",
    "test:nankan-recent-races": "node src/lib/getDisplayRecentRacesForNankan.test.js",
    "test:nankan-injection": "node src/lib/nankanHorseStatsInjection.guard.test.js",
    "test:nankan": "npm run test:nankan-recent-races && npm run test:nankan-injection",
    "check:safety": "npm run check:no-raw-index && npm run check:display-index && npm run check:horse-sections && npm run check:differentiation && npm run check:ki-relics:jra && npm run check:ki-relics:free-jra-date && npm run check:ki-relics:free-jra && npm run check:jra-nankan-parity && npm run check:prediction-scope && npm run check:prediction-integrity && npm run check:jra-join && npm run test:nankan",
    "verify:safety": "npm run build && npm run check:safety"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.5.8",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.5.0",
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.6",
    "airtable": "^0.12.2",
    "astro": "^5.13.2",
    "sass": "^1.90.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "netlify-cli": "^23.5.0"
  }
}
